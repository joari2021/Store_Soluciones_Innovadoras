<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Clientes</h1>
        <p class="mt-1 text-sm text-slate-500">Administra datos de contacto y el historial de ventas.</p>
      </div>
      <%= link_to new_cliente_path, class: "w-full md:w-auto bg-slate-900 text-white px-6 py-3 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-slate-800 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M12 4.5a.75.75 0 0 1 .75.75v6h6a.75.75 0 0 1 0 1.5h-6v6a.75.75 0 0 1-1.5 0v-6h-6a.75.75 0 0 1 0-1.5h6v-6a.75.75 0 0 1 .75-.75Z" />
        </svg>
        Nuevo cliente
      <% end %>
    </div>
  </div>
  <% if @clientes.any? %>
    <div class="relative w-full md:w-[28rem]">
      <input id="client-search-input" type="text" placeholder="Buscar cliente..." class="w-full rounded-2xl border border-slate-300 bg-white py-2.5 pl-4 pr-10 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500">
      <button id="client-search-clear" type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-700" aria-label="Limpiar busqueda" title="Limpiar busqueda">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
          <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
    <div class="grid gap-3 md:hidden">
      <%= turbo_frame_tag "clientes-mobile-#{@pagy.page}", class: "contents" do %>
        <% @clientes.each do |cliente| %>
          <% client_query = [cliente.name, cliente.document_label, cliente.phone].map { |val| val.to_s }.join(' ').downcase %>
          <article data-client-query="<%= client_query %>" class="client-mobile-card rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-all duration-200 hover:border-sky-200 hover:shadow-md hover:shadow-sky-100/50">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <h3 class="truncate text-base font-bold text-slate-800"><%= cliente.name %></h3>
                <p class="mt-1 inline-flex items-center rounded-lg bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">Documento: <span class="ml-1 font-medium text-slate-700"><%= cliente.document_label.presence || '-' %></span></p>
              </div>
              <div class="flex items-center gap-1.5">
                <%= link_to cliente_path(cliente), class: 'inline-flex items-center justify-center rounded-lg bg-emerald-50 p-2 text-emerald-600 hover:bg-emerald-100 transition-colors', title: 'Ver', 'aria-label': 'Ver', data: { turbo_frame: '_top' } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M12 4.5c-5 0-9.27 3.11-11 7.5 1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5Zm0 12a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
                    <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                  </svg>
                <% end %>
                <%= link_to edit_cliente_path(cliente), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors', title: 'Editar', 'aria-label': 'Editar', data: { turbo_frame: '_top' } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
                  </svg>
                <% end %>
                <% if current_user_admin? %>
                  <%= link_to cliente_path(cliente), method: :delete, data: { swal_delete: 'cliente', turbo_frame: '_top' }, class: 'inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 hover:bg-red-100 transition-colors', title: 'Eliminar', 'aria-label': 'Eliminar' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                      <path fill-rule="evenodd" d="M16.5 4.5V6h3a.75.75 0 0 1 0 1.5h-.638l-1.02 11.214A2.25 2.25 0 0 1 15.603 21H8.397a2.25 2.25 0 0 1-2.24-2.286L5.138 7.5H4.5a.75.75 0 0 1 0-1.5h3V4.5A1.5 1.5 0 0 1 9 3h6a1.5 1.5 0 0 1 1.5 1.5Zm-7.5 0V6h6V4.5h-6Z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </div>
            <div class="mt-3 grid grid-cols-1 gap-1.5 text-sm text-slate-600">
              <p><span class="font-semibold text-slate-700">Telefono:</span> <%= cliente.phone.presence || '-' %></p>
              <p class="truncate"><span class="font-semibold text-slate-700">Direccion:</span> <%= cliente.address.presence || '-' %></p>
            </div>
          </article>
        <% end %>
        <% if @pagy.next %>
          <%= turbo_frame_tag "clientes-mobile-#{@pagy.next}", src: pagy_url_for(@pagy, @pagy.next), loading: :lazy, class: "col-span-full" do %>
            <div class="flex items-center justify-center gap-3 py-6 text-sm text-slate-500">
              <span class="h-5 w-5 animate-spin rounded-full border-2 border-slate-200 border-t-slate-500"></span>
              Cargando mas clientes...
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:block">
      <div class="grid grid-cols-[minmax(0,1.4fr)_minmax(0,0.8fr)_minmax(0,0.8fr)_minmax(0,1.6fr)_minmax(0,0.7fr)] gap-4 bg-slate-50 px-6 py-4 text-xs uppercase tracking-wider text-slate-500 font-bold">
        <div>Cliente</div>
        <div>Documento</div>
        <div>Telefono</div>
        <div>Direccion</div>
        <div class="text-right">Acciones</div>
      </div>
      <div class="divide-y divide-slate-100">
        <%= turbo_frame_tag "clientes-table-#{@pagy.page}", class: "contents" do %>
          <% @clientes.each_with_index do |cliente, index| %>
            <% client_query = [cliente.name, cliente.document_label, cliente.phone].map { |val| val.to_s }.join(' ').downcase %>
            <div data-client-query="<%= client_query %>" class="client-table-row grid grid-cols-[minmax(0,1.4fr)_minmax(0,0.8fr)_minmax(0,0.8fr)_minmax(0,1.6fr)_minmax(0,0.7fr)] items-center gap-4 px-6 py-4 transition-all duration-150 <%= index.even? ? 'bg-white' : 'bg-slate-50/50' %> hover:bg-sky-50/70">
              <div>
                <div class="flex items-center gap-3">
                  <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-sky-100 text-sm font-bold text-sky-700">
                    <%= cliente.name.to_s.first&.upcase || 'C' %>
                  </div>
                  <div class="min-w-0">
                    <p class="truncate font-semibold text-slate-800"><%= cliente.name %></p>
                    <p class="text-xs text-slate-500">Cliente registrado</p>
                  </div>
                </div>
              </div>
              <div>
                <span class="inline-flex items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= cliente.document_label.presence || '-' %></span>
              </div>
              <div><%= cliente.phone.presence || '-' %></div>
              <div>
                <span class="text-slate-600"><%= cliente.address.presence || '-' %></span>
              </div>
              <div class="flex items-center justify-end gap-2">
                <%= link_to cliente_path(cliente), class: 'inline-flex items-center justify-center rounded-lg bg-emerald-50 p-2 text-emerald-600 hover:bg-emerald-100 transition-colors', title: 'Ver', 'aria-label': 'Ver', data: { turbo_frame: '_top' } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M12 4.5c-5 0-9.27 3.11-11 7.5 1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5Zm0 12a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
                    <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                  </svg>
                <% end %>
                <%= link_to edit_cliente_path(cliente), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors', title: 'Editar', 'aria-label': 'Editar', data: { turbo_frame: '_top' } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
                  </svg>
                <% end %>
                <% if current_user_admin? %>
                  <%= link_to cliente_path(cliente), method: :delete, data: { swal_delete: 'cliente', turbo_frame: '_top' }, class: 'inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 hover:bg-red-100 transition-colors', title: 'Eliminar', 'aria-label': 'Eliminar' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                      <path fill-rule="evenodd" d="M16.5 4.5V6h3a.75.75 0 0 1 0 1.5h-.638l-1.02 11.214A2.25 2.25 0 0 1 15.603 21H8.397a2.25 2.25 0 0 1-2.24-2.286L5.138 7.5H4.5a.75.75 0 0 1 0-1.5h3V4.5A1.5 1.5 0 0 1 9 3h6a1.5 1.5 0 0 1 1.5 1.5Zm-7.5 0V6h6V4.5h-6Z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if @pagy.next %>
            <%= turbo_frame_tag "clientes-table-#{@pagy.next}", src: pagy_url_for(@pagy, @pagy.next), loading: :lazy do %>
              <div class="flex items-center justify-center gap-3 px-6 py-6 text-sm text-slate-500">
                <span class="h-5 w-5 animate-spin rounded-full border-2 border-slate-200 border-t-slate-500"></span>
                Cargando mas clientes...
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
        <i data-lucide="users" class="h-6 w-6"></i>
      </div>
      <h3 class="text-base font-semibold text-slate-700">No hay clientes registrados</h3>
      <p class="mt-1 text-sm text-slate-500">Crea tu primer cliente para asociar ventas y pagos.</p>
    </div>
  <% end %>
</div>
<script>
  document.addEventListener('turbo:load', () => {
    const searchInput = document.getElementById('client-search-input');
    const clearButton = document.getElementById('client-search-clear');
    if (!searchInput || !clearButton) return;
    if (searchInput.dataset.bound === 'true') return;
    searchInput.dataset.bound = 'true';

    const normalize = (value) =>
      String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();

    const getTableRows = () => Array.from(document.querySelectorAll('.client-table-row'));
    const getMobileCards = () => Array.from(document.querySelectorAll('.client-mobile-card'));

    const applyFilter = () => {
      const query = normalize(searchInput.value);
      clearButton.classList.toggle('hidden', query.length === 0);

      getTableRows().forEach((row) => {
        const rowValue = normalize(row.dataset.clientQuery);
        row.classList.toggle('hidden', query.length > 0 && !rowValue.includes(query));
      });

      getMobileCards().forEach((card) => {
        const cardValue = normalize(card.dataset.clientQuery);
        card.classList.toggle('hidden', query.length > 0 && !cardValue.includes(query));
      });
    };

    searchInput.addEventListener('input', applyFilter);

    clearButton.addEventListener('click', () => {
      searchInput.value = '';
      applyFilter();
      searchInput.focus();
    });

    if (searchInput.dataset.frameBound !== 'true') {
      const handleFrameLoad = (event) => {
        if (!event.target?.id?.startsWith('clientes-')) return;
        if (searchInput.value.trim().length === 0) return;
        applyFilter();
      };

      document.addEventListener('turbo:frame-load', handleFrameLoad);
      searchInput.dataset.frameBound = 'true';
    }
  });
</script>
