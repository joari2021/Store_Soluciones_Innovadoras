<% expense = payment.expense %>
<% currency_code = payment.currency.presence || expense&.currency || "USD" %>
<% currency_symbol = Account::CURRENCIES.dig(currency_code, :symbol) || currency_code %>
<article class="rounded-2xl border border-cyan-200 bg-white p-4 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-cyan-700">Pago registrado</p>
      <h3 class="mt-1 truncate text-base font-bold text-slate-800"><%= expense&.name || 'Gasto eliminado' %></h3>
      <p class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-sky-700"><%= expense&.category_label || 'Sin categoria' %></p>
    </div>
    <span class="rounded-full bg-cyan-100 px-2.5 py-1 text-[11px] font-semibold text-cyan-700">
      <%= payment.occurred_at.in_time_zone.strftime('%d/%m/%Y') %>
    </span>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3 text-xs text-slate-500">
    <div>
      <p class="uppercase tracking-wider">Monto pagado</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= number_to_currency(payment.amount, unit: "#{currency_symbol} ") %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Cuenta</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= payment.account&.name || 'Sin cuenta' %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Metodo</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= payment.payment_method.presence || 'No especificado' %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Referencia</p>
      <p class="mt-1 truncate text-sm font-semibold text-slate-700"><%= payment.reference.presence || 'Sin referencia' %></p>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <% if expense.present? %>
      <%= link_to expense_path(expense), class: 'inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer', data: { turbo_frame: '_top' } do %>
        <i data-lucide="eye" class="h-4 w-4"></i>
        Ver gasto
      <% end %>
    <% end %>
  </div>
</article>
