<% expense_sections = [
  { key: 'fixed', title: 'Gastos fijos', active: @fixed_expenses, finalized: @fixed_finalized_expenses, history_groups: @fixed_history_groups },
  { key: 'variable', title: 'Gastos variables', active: @variable_expenses, finalized: @variable_finalized_expenses, history_groups: @variable_history_groups }
] %>
<div class="space-y-6 fade-in" data-expense-index="true">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Gastos</h1>
        <p class="mt-1 text-sm text-slate-500">Registra gastos fijos y variables con control de pagos.</p>
      </div>
      <div class="flex w-full flex-col gap-2 md:w-auto md:flex-row">
        <%= link_to expense_categories_path, class: "w-full md:w-auto border border-slate-300 bg-white text-slate-700 px-6 py-3 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-slate-50 transition-all font-medium cursor-pointer", data: { turbo_frame: "_top" } do %>
          <i data-lucide="tags" class="h-5 w-5"></i>
          Categorias
        <% end %>
        <%= link_to new_expense_path, class: "w-full md:w-auto bg-slate-900 text-white px-6 py-3 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-slate-800 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium cursor-pointer", data: { turbo_frame: "_top" } do %>
          <i data-lucide="plus" class="h-5 w-5"></i>
          Nuevo gasto
        <% end %>
      </div>
    </div>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Proximo pago</p>
      <p class="mt-2 text-lg font-bold text-slate-800"><%= @next_due_on ? @next_due_on.strftime('%d/%m/%Y') : 'Sin fecha' %></p>
      <p class="mt-1 text-xs text-slate-500">Basado en los gastos activos.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pagos vencidos</p>
      <p class="mt-2 text-lg font-bold text-amber-600"><%= @overdue_total %></p>
      <p class="mt-1 text-xs text-slate-500">Cuotas pendientes por registrar.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Gastos registrados</p>
      <p class="mt-2 text-lg font-bold text-slate-800"><%= @expenses_count %></p>
      <p class="mt-1 text-xs text-slate-500">Incluye fijos y variables.</p>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: expenses_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-4 md:items-end" do |form| %>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Desde</label>
        <%= form.text_field :from,
                            value: @filter_from&.strftime('%d-%m-%Y'),
                            placeholder: 'dd-mm-aaaa',
                            autocomplete: 'off',
                            class: "js-materialize-datepicker materialize-datepicker-input mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Hasta</label>
        <%= form.text_field :to,
                            value: @filter_to&.strftime('%d-%m-%Y'),
                            placeholder: 'dd-mm-aaaa',
                            autocomplete: 'off',
                            class: "js-materialize-datepicker materialize-datepicker-input mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Categoria</label>
        <%= form.select :expense_category_id,
                        options_for_select([['Todas', '']] + @expense_categories.map { |category| [category.name, category.id] }, @filter_category_id),
                        {},
                        class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
      </div>
      <div class="flex gap-2">
        <%= form.submit "Filtrar", class: "inline-flex cursor-pointer items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
        <%= link_to expenses_path, class: "inline-flex cursor-pointer items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" do %>
          Limpiar
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="grid gap-6 lg:grid-cols-2">
    <% expense_sections.each do |section| %>
      <section class="rounded-2xl border border-slate-200 bg-slate-50/40 p-4 shadow-sm sm:p-5">
        <div class="mb-4 flex items-end justify-between gap-2">
          <div>
            <h2 class="text-lg font-bold text-slate-800"><%= section[:title] %></h2>
            <p class="mt-1 text-xs text-slate-500">
              <%= pluralize(section[:active].size, 'activo', 'activos') %>
              <% if section[:finalized].any? %>
                · <%= pluralize(section[:finalized].size, 'finalizado', 'finalizados') %>
              <% end %>
            </p>
          </div>
        </div>
        <div class="mb-3 flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-wider">
          <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-emerald-700">Activo</span>
          <span class="rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-amber-700">Finalizado</span>
          <span class="rounded-full border border-cyan-200 bg-cyan-50 px-2.5 py-1 text-cyan-700">Pago de gasto activo</span>
        </div>
        <% if section[:active].any? %>
          <div class="space-y-3">
            <% section[:active].each do |expense| %>
              <%= render 'expense_card', expense: expense, state: :active %>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-6 text-center text-sm text-slate-500">
            No hay gastos activos en esta seccion.
          </div>
        <% end %>
        <div class="my-5 h-px bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>
        <div class="rounded-2xl border border-cyan-300 bg-cyan-50/60 p-3">
          <% history_total = section[:history_groups].to_a.sum { |(_date, items)| items.size } %>
          <p class="text-xs font-semibold uppercase tracking-widest text-cyan-800">Historial de gastos realizados · <%= history_total %></p>
          <div class="mt-3 space-y-4">
            <% if section[:history_groups].present? %>
              <% section[:history_groups].each do |history_date, items| %>
                <div class="rounded-2xl border border-cyan-200 bg-white/80 p-3">
                  <div class="mb-3 flex items-center gap-3 rounded-xl border border-cyan-100 bg-cyan-50 px-3 py-2">
                    <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-cyan-600 text-lg font-extrabold text-white">
                      <%= history_date.strftime('%d') %>
                    </div>
                    <div>
                      <p class="text-sm font-bold tracking-wide text-cyan-900"><%= I18n.l(history_date, format: '%A').to_s.capitalize %></p>
                      <p class="text-xs font-semibold uppercase tracking-wider text-cyan-700"><%= I18n.l(history_date, format: '%B %Y').to_s.capitalize %></p>
                    </div>
                  </div>
                  <div class="space-y-3">
                    <% items.each do |entry| %>
                      <% if entry[:kind] == :payment %>
                        <%= render 'expense_payment_history_card', payment: entry[:payment], from_active_expense: entry[:payment].expense&.next_due_on.present? %>
                      <% else %>
                        <%= render 'expense_card', expense: entry[:expense], state: :finalized %>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="rounded-xl border border-dashed border-cyan-300 bg-white px-4 py-6 text-center text-sm text-slate-500">
                No hay historial de gastos realizados en esta seccion.
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
