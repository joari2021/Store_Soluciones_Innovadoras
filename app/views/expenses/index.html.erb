<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Gastos</h1>
        <p class="mt-1 text-sm text-slate-500">Registra gastos fijos y variables con control de pagos.</p>
      </div>
      <%= link_to new_expense_path, class: "w-full md:w-auto bg-slate-900 text-white px-6 py-3 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-slate-800 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium", data: { turbo_frame: "_top" } do %>
        <i data-lucide="plus" class="h-5 w-5"></i>
        Nuevo gasto
      <% end %>
    </div>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Proximo pago</p>
      <p class="mt-2 text-lg font-bold text-slate-800"><%= @next_due_on ? @next_due_on.strftime("%d/%m/%Y") : "Sin fecha" %></p>
      <p class="mt-1 text-xs text-slate-500">Basado en los gastos activos.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pagos vencidos</p>
      <p class="mt-2 text-lg font-bold text-amber-600"><%= @overdue_total %></p>
      <p class="mt-1 text-xs text-slate-500">Cuotas pendientes por registrar.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Gastos registrados</p>
      <p class="mt-2 text-lg font-bold text-slate-800"><%= @expenses.count %></p>
      <p class="mt-1 text-xs text-slate-500">Incluye fijos y variables.</p>
    </div>
  </div>
  <% if @expenses.any? %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <% @expenses.each do |expense| %>
        <% currency_symbol = Account::CURRENCIES.dig(expense.currency, :symbol) || expense.currency %>
        <% overdue = expense.overdue_count %>
        <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= expense.expense_type_label %></p>
              <h3 class="mt-1 truncate text-base font-bold text-slate-800"><%= expense.name %></h3>
              <% if expense.description.present? %>
                <p class="mt-1 text-xs text-slate-500"><%= expense.description %></p>
              <% end %>
            </div>
            <span class="rounded-full px-2.5 py-1 text-[11px] font-semibold <%= overdue.positive? ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %>">
              <%= expense.status_label %>
            </span>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 text-xs text-slate-500">
            <div>
              <p class="uppercase tracking-wider">Frecuencia</p>
              <p class="mt-1 text-sm font-semibold text-slate-700"><%= expense.frequency_label %></p>
            </div>
            <div>
              <p class="uppercase tracking-wider">Proximo pago</p>
              <p class="mt-1 text-sm font-semibold text-slate-700"><%= expense.next_due_on ? expense.next_due_on.strftime("%d/%m/%Y") : "Sin fecha" %></p>
            </div>
            <div>
              <p class="uppercase tracking-wider">Monto</p>
              <p class="mt-1 text-sm font-semibold text-slate-700">
                <%= expense.amount.present? ? number_to_currency(expense.amount, unit: "#{currency_symbol} ") : "Monto libre" %>
              </p>
            </div>
            <div>
              <p class="uppercase tracking-wider">Vencidos</p>
              <p class="mt-1 text-sm font-semibold <%= overdue.positive? ? 'text-amber-600' : 'text-slate-700' %>"><%= overdue %></p>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <%= link_to new_expense_expense_payment_path(expense), class: "inline-flex items-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-800", data: { turbo_frame: "_top" } do %>
              <i data-lucide="credit-card" class="h-4 w-4"></i>
              Registrar pago
            <% end %>
            <%= link_to expense_path(expense), class: "inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
              <i data-lucide="eye" class="h-4 w-4"></i>
              Ver
            <% end %>
            <%= link_to edit_expense_path(expense), class: "inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
              <i data-lucide="pencil" class="h-4 w-4"></i>
              Editar
            <% end %>
            <%= link_to expense_path(expense), class: "inline-flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100", data: { turbo_method: :delete, swal_delete: "expense" } do %>
              <i data-lucide="trash" class="h-4 w-4"></i>
              Eliminar
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
        <i data-lucide="receipt" class="h-6 w-6"></i>
      </div>
      <h3 class="text-base font-semibold text-slate-700">No hay gastos registrados</h3>
      <p class="mt-1 text-sm text-slate-500">Crea tu primer gasto para llevar el control.</p>
    </div>
  <% end %>
</div>
