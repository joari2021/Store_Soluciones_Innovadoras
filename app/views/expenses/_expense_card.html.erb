<% currency_symbol = Account::CURRENCIES.dig(expense.currency, :symbol) || expense.currency %>
<% overdue = expense.overdue_count %>
<article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= expense.expense_type_label %></p>
      <h3 class="mt-1 truncate text-base font-bold text-slate-800"><%= expense.name %></h3>
      <% if expense.description.present? %>
        <p class="mt-1 text-xs text-slate-500"><%= expense.description %></p>
      <% end %>
    </div>
    <span class="rounded-full px-2.5 py-1 text-[11px] font-semibold <%= overdue.positive? ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %>">
      <%= expense.status_label %>
    </span>
  </div>
  <div class="mt-4 grid grid-cols-2 gap-3 text-xs text-slate-500">
    <div>
      <p class="uppercase tracking-wider">Frecuencia</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= expense.frequency_label %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Proximo pago</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= expense.next_due_on ? expense.next_due_on.strftime('%d/%m/%Y') : 'Sin fecha' %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Monto</p>
      <p class="mt-1 text-sm font-semibold text-slate-700">
        <%= expense.amount.present? ? number_to_currency(expense.amount, unit: "#{currency_symbol} ") : 'Monto libre' %>
      </p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Vencidos</p>
      <p class="mt-1 text-sm font-semibold <%= overdue.positive? ? 'text-amber-600' : 'text-slate-700' %>"><%= overdue %></p>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <%= link_to new_expense_expense_payment_path(expense), class: 'inline-flex items-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer', data: { turbo_frame: '_top' } do %>
      <i data-lucide="credit-card" class="h-4 w-4"></i>
      Registrar pago
    <% end %>
    <%= link_to expense_path(expense), class: 'inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer', data: { turbo_frame: '_top' } do %>
      <i data-lucide="eye" class="h-4 w-4"></i>
      Ver
    <% end %>
    <%= link_to edit_expense_path(expense), class: 'inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer', data: { turbo_frame: '_top' } do %>
      <i data-lucide="pencil" class="h-4 w-4"></i>
      Editar
    <% end %>
    <%= link_to expense_path(expense), class: 'inline-flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100 cursor-pointer', data: { turbo_method: :delete, swal_delete: 'expense' } do %>
      <i data-lucide="trash" class="h-4 w-4"></i>
      Eliminar
    <% end %>
  </div>
</article>
