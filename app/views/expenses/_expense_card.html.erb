<% overdue = expense.overdue_count %>
<% amount_usd_bcv = @expense_amount_usd_bcv_by_id.to_h[expense.id] %>
<% display_type_label = local_assigns.fetch(:display_type_label, expense.expense_type_label) %>
<% card_state = local_assigns.fetch(:state, expense.next_due_on.present? ? :active : :finalized).to_sym %>
<% return_to_key = local_assigns.fetch(:return_to, 'index').to_s == 'history' ? 'history' : 'index' %>
<% last_payment = expense.expense_payments.max_by { |payment| [payment.occurred_at || Time.zone.at(0), payment.id.to_i] } %>
<% last_payment_date = last_payment&.occurred_at&.in_time_zone&.strftime('%d/%m/%Y') || expense.last_paid_on&.strftime('%d/%m/%Y') %>
<% display_amount = expense.amount %>
<% display_currency = expense.currency %>
<% commission_expense = expense.commission_expense? %>
<% if expense.expense_type.to_s == 'variable' && last_payment.present? %>
  <% display_amount = last_payment.amount %>
  <% display_currency = last_payment.currency %>
<% end %>
<% currency_symbol = Account::CURRENCIES.dig(display_currency, :symbol) || display_currency %>
<% card_classes = if card_state == :finalized
  'border-amber-200 bg-amber-50/30'
else
  'border-emerald-200 bg-emerald-50/20'
end %>
<article class="rounded-2xl border p-4 shadow-sm <%= card_classes %>">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= display_type_label %></p>
      <h3 class="mt-1 truncate text-base font-bold text-slate-800"><%= expense.name %></h3>
      <p class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-sky-700"><%= expense.category_label %></p>
      <% if expense.description.present? %>
        <p class="mt-1 text-xs text-slate-500"><%= expense.description %></p>
      <% end %>
    </div>
    <span class="rounded-full px-2.5 py-1 text-[11px] font-semibold <%= overdue.positive? ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %>">
      <%= expense.status_label %>
    </span>
  </div>
  <div class="mt-4 grid grid-cols-2 gap-3 text-xs text-slate-500">
    <div>
      <p class="uppercase tracking-wider">Frecuencia</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= expense.frequency_label %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider"><%= card_state == :finalized ? 'Fecha pago' : 'Proximo pago' %></p>
      <p class="mt-1 text-sm font-semibold text-slate-700">
        <%= if card_state == :finalized
              last_payment_date.presence || 'Sin registro'
            else
              expense.next_due_on ? expense.next_due_on.strftime('%d/%m/%Y') : 'Sin fecha'
            end %>
      </p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Monto</p>
      <p class="mt-1 text-sm font-semibold text-slate-700">
        <%= display_amount.present? ? number_to_currency(display_amount, unit: "#{currency_symbol} ") : 'Monto libre' %>
        <% if amount_usd_bcv.present? && amount_usd_bcv.positive? %>
          <span class="text-xs font-medium text-slate-500">| $ <%= number_with_precision(amount_usd_bcv, precision: 2, delimiter: '.', separator: ',') %> BCV</span>
        <% end %>
      </p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Vencidos</p>
      <p class="mt-1 text-sm font-semibold <%= overdue.positive? ? 'text-amber-600' : 'text-slate-700' %>"><%= overdue %></p>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <%= link_to new_expense_expense_payment_path(expense), class: 'inline-flex items-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer', data: { turbo_frame: '_top' } do %>
      <i data-lucide="credit-card" class="h-4 w-4"></i>
      Registrar pago
    <% end %>
    <%= link_to expense_path(expense), class: 'inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer', data: { turbo_frame: '_top' } do %>
      <i data-lucide="eye" class="h-4 w-4"></i>
      Ver
    <% end %>
    <%= link_to edit_expense_path(expense), class: 'inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer', data: { turbo_frame: '_top' } do %>
      <i data-lucide="pencil" class="h-4 w-4"></i>
      Editar
    <% end %>
    <% unless commission_expense %>
      <%= link_to expense_path(expense, return_to: return_to_key), class: 'inline-flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100 cursor-pointer', data: { turbo_method: :delete, swal_delete: 'expense' } do %>
        <i data-lucide="trash" class="h-4 w-4"></i>
        Eliminar
      <% end %>
    <% end %>
  </div>
</article>
