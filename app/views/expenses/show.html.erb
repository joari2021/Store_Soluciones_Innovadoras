<% currency_symbol = Account::CURRENCIES.dig(@expense.currency, :symbol) || @expense.currency %>
<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Detalle</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl"><%= @expense.name %></h1>
        <p class="mt-1 text-sm text-slate-500"><%= @expense.description.presence || "Sin descripcion" %></p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to new_expense_expense_payment_path(@expense), class: "inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800", data: { turbo_frame: "_top" } do %>
          <i data-lucide="credit-card" class="h-4 w-4"></i>
          Registrar pago
        <% end %>
        <%= link_to edit_expense_path(@expense), class: "inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
          <i data-lucide="pencil" class="h-4 w-4"></i>
          Editar
        <% end %>
        <%= link_to expenses_path, class: "inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
          Volver
        <% end %>
      </div>
    </div>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Informacion</p>
      <dl class="mt-4 grid gap-3 text-sm text-slate-600">
        <div class="flex items-center justify-between">
          <dt>Tipo</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.expense_type_label %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Frecuencia</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.frequency_label %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Monto</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.amount.present? ? number_to_currency(@expense.amount, unit: "#{currency_symbol} ") : "Monto libre" %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Proximo pago</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.next_due_on ? @expense.next_due_on.strftime("%d/%m/%Y") : "Sin fecha" %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Ultimo pago</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.last_paid_on ? @expense.last_paid_on.strftime("%d/%m/%Y") : "Sin pagos" %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Vencidos</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.overdue_count %></dd>
        </div>
      </dl>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Programacion</p>
      <dl class="mt-4 grid gap-3 text-sm text-slate-600">
        <div class="flex items-center justify-between">
          <dt>Inicio</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.start_date ? @expense.start_date.strftime("%d/%m/%Y") : "-" %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Fin</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.end_date ? @expense.end_date.strftime("%d/%m/%Y") : "-" %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Pagos realizados</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.payments_count %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Estado</dt>
          <dd class="font-semibold text-slate-800"><%= @expense.status_label %></dd>
        </div>
      </dl>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Pagos registrados</p>
      <span class="text-xs font-semibold text-slate-500"><%= @payments.count %> pagos</span>
    </div>
    <% if @payments.any? %>
      <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
        <table class="min-w-full text-sm text-slate-700">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-4 py-3 text-left">Fecha</th>
              <th class="px-4 py-3 text-left">Cuenta</th>
              <th class="px-4 py-3 text-left">Metodo</th>
              <th class="px-4 py-3 text-left">Referencia</th>
              <th class="px-4 py-3 text-right">Monto</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @payments.each do |payment| %>
              <tr>
                <td class="px-4 py-3"><%= payment.occurred_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td class="px-4 py-3"><%= payment.account.name %></td>
                <td class="px-4 py-3"><%= payment.payment_method_label.presence || '-' %></td>
                <td class="px-4 py-3"><%= payment.reference.presence || '-' %></td>
                <td class="px-4 py-3 text-right"><%= number_to_currency(payment.amount, unit: "#{payment.currency} ") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-slate-500">Aun no hay pagos registrados.</p>
    <% end %>
  </div>
</div>
