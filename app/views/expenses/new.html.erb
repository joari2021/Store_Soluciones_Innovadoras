<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Nuevo registro</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl">Nuevo gasto</h1>
        <p class="mt-1 text-sm text-slate-500">Define el tipo, la frecuencia y el pago inicial si aplica.</p>
      </div>
      <%= link_to expenses_path, class: "inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50" do %>
        Volver
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form" %>
  </div>
</div>
