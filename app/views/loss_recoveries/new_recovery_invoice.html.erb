<div class="space-y-6">
  <div class="rounded-3xl border border-cyan-100 bg-gradient-to-r from-cyan-50 via-white to-sky-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Recuperacion de perdidas</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl">Facturar pérdida</h1>
        <p class="mt-1 text-sm text-slate-500">Crea una factura de recuperación y deduce del saldo de recuperación.</p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:justify-end">
        <%= link_to replenishments_loss_recoveries_path,
                    class: "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 sm:w-auto" do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Volver a reposicion
        <% end %>
        <%= link_to recovery_invoices_loss_recoveries_path,
                    class: "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-sm font-semibold text-emerald-700 shadow-sm transition hover:bg-emerald-100 sm:w-auto" do %>
          <i data-lucide="history" class="h-4 w-4"></i>
          Ver facturas
        <% end %>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="mb-3 flex items-center justify-between">
        <div class="w-1/2">
          <input id="recovery-product-search" value="<%= @query_text %>" placeholder="Buscar producto..." type="text" class="block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div class="text-xs text-slate-500" id="recovery-products-meta"
             data-page="<%= @products_page %>"
             data-total-pages="<%= @products_total_pages %>"
             data-total-count="<%= @products_total_count %>"
             data-per-page="<%= normalized_products_per_page %>">
          Mostrando página <span data-products-page><%= @products_page %></span> de <span data-products-total-pages><%= @products_total_pages %></span>
          (<span data-products-total-count><%= @products_total_count %></span> productos)
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-slate-700" id="recovery-products-table" data-products-url="<%= new_recovery_invoice_loss_recoveries_path(format: :json) %>">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/80 text-xs uppercase tracking-wide text-slate-500">
              <th class="px-4 py-3 text-left">Producto</th>
              <th class="px-4 py-3 text-left">Variaciones</th>
              <th class="px-4 py-3 text-right">Existencia</th>
              <th class="px-4 py-3 text-right">Accion</th>
            </tr>
          </thead>
          <tbody>
            <% @productos.each do |producto| %>
              <% product_payload = recovery_invoice_product_payload(producto) %>
              <tr class="border-b border-slate-100" data-product-row data-product-id="<%= producto.id %>" data-product-name="<%= product_payload[:name] %>" data-variations="<%= json_escape(product_payload[:variations].to_json) %>">
                <td class="px-4 py-3"><%= product_payload[:name] %></td>
                <td class="px-4 py-3 text-xs text-slate-500"><%= product_payload[:variations_label] %></td>
                <td class="px-4 py-3 text-right font-semibold text-slate-700"><%= number_with_precision(product_payload[:total_quantity].to_d, precision: 3, strip_insignificant_zeros: true) %></td>
                <td class="px-4 py-3 text-right"><button type="button" class="inline-flex items-center rounded-xl bg-cyan-600 px-3 py-1 text-xs text-white" data-add-to-invoice>Agregar</button></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-3 flex items-center justify-end gap-2">
        <button type="button" id="recovery-products-prev" class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">Anterior</button>
        <button type="button" id="recovery-products-next" class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">Siguiente</button>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <h3 class="text-sm font-semibold text-slate-700">Factura de recuperación</h3>
      <div class="mt-3">
        <table class="w-full text-sm text-slate-700" id="invoice-items">
          <thead>
            <tr class="text-xs text-slate-500">
              <th>Producto</th>
              <th class="text-right">Cant</th>
              <th class="text-right">Precio USD</th>
              <th class="text-right">Total USD</th>
              <th></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
        <div class="mt-4 border-t pt-3">
          <div class="flex justify-between items-center"><span class="text-sm text-slate-600">Subtotal</span><strong id="invoice-subtotal" class="text-lg">$ 0,00</strong></div>
          <div class="mt-3">
            <form id="recovery-invoice-form" action="<%= create_recovery_invoice_loss_recoveries_path %>" method="post">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="hidden" name="items_json" id="items_json" />
              <div class="flex gap-2 mt-4">
                <a href="#" class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" id="cancel-invoice">Cancelar</a>
                <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white" id="save-invoice">Guardar factura</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Modal to choose variation and quantity -->
<div id="recovery-add-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/55 px-3">
  <div class="w-full max-w-md rounded-2xl border border-cyan-100 bg-white p-5 shadow-2xl">
    <h3 class="text-lg font-bold" id="modal-product-title">Añadir producto</h3>
    <div class="mt-3 space-y-3">
      <div>
        <label class="block text-sm">Variación</label>
        <select id="modal-variation-select" class="mt-1 block w-full rounded-xl border px-3 py-2"></select>
      </div>
      <div>
        <label class="block text-sm">Cantidad</label>
        <input id="modal-quantity" type="number" min="0.001" step="0.001" value="1" class="mt-1 block w-full rounded-xl border px-3 py-2" />
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" class="rounded-xl border px-4 py-2" id="modal-cancel">Cancelar</button>
        <button type="button" class="rounded-xl bg-cyan-600 px-4 py-2 text-white" id="modal-add">Agregar</button>
      </div>
    </div>
  </div>
</div>
<script>
  (function(){
    const productsTable = document.getElementById('recovery-products-table');
    const productsTbody = productsTable?.querySelector('tbody');
    const productsMeta = document.getElementById('recovery-products-meta');
    const prevPageBtn = document.getElementById('recovery-products-prev');
    const nextPageBtn = document.getElementById('recovery-products-next');
    const productsUrl = productsTable?.dataset?.productsUrl;
    const productSearchInput = document.getElementById('recovery-product-search');
    const addModal = document.getElementById('recovery-add-modal');
    const modalTitle = document.getElementById('modal-product-title');
    const variationSelect = document.getElementById('modal-variation-select');
    const quantityInput = document.getElementById('modal-quantity');
    const modalCancel = document.getElementById('modal-cancel');
    const modalAdd = document.getElementById('modal-add');
    const invoiceTbody = document.querySelector('#invoice-items tbody');
    const itemsJsonInput = document.getElementById('items_json');
    const invoiceForm = document.getElementById('recovery-invoice-form');
    const subtotalEl = document.getElementById('invoice-subtotal');

    let currentProduct = null;
    let items = [];
    // Reservas provisionales en memoria (DOM-only). Key: "productId::variationId" -> cantidad reservada
    const provisionalReservations = new Map();
    let currentPage = Number(productsMeta?.dataset?.page || 1);
    let totalPages = Number(productsMeta?.dataset?.totalPages || 1);
    let totalCount = Number(productsMeta?.dataset?.totalCount || 0);
    const perPage = Number(productsMeta?.dataset?.perPage || 40);
    let searchDebounceTimer = null;

    function normalizeSearchText(value){
      return String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function escapeHtml(value){
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatQuantity(value){
      const amount = Number(value || 0);
      if (!Number.isFinite(amount)) return '0';
      return amount.toLocaleString('es-VE', { minimumFractionDigits: 0, maximumFractionDigits: 3 });
    }

    const reservationKey = (productId, variationId) => `${String(productId)}::${String(variationId || 'none')}`;
    const reservedFor = (productId, variationId) => {
      const key = reservationKey(productId, variationId);
      return Number(provisionalReservations.get(key) || 0);
    };
    const addReservation = (productId, variationId, qty) => {
      const key = reservationKey(productId, variationId);
      const prev = Number(provisionalReservations.get(key) || 0);
      provisionalReservations.set(key, prev + Number(qty || 0));
    };
    const removeReservation = (productId, variationId, qty) => {
      const key = reservationKey(productId, variationId);
      const prev = Number(provisionalReservations.get(key) || 0);
      const next = Math.max(0, prev - Number(qty || 0));
      if (next <= 0) provisionalReservations.delete(key);
      else provisionalReservations.set(key, next);
    };
    const reservedTotalForProduct = (productId) => {
      let total = 0;
      provisionalReservations.forEach((v, k) => {
        if (String(k).startsWith(String(productId) + '::')) total += Number(v || 0);
      });
      return total;
    };
    const updateRowAvailabilityByProductId = (productId, originalTotal) => {
      const row = productsTbody?.querySelector(`tr[data-product-id="${String(productId)}"]`);
      if (!row) return;
      const cell = row.querySelector('td:nth-child(3)');
      if (!cell) return;
      const orig = Number(originalTotal || 0);
      const remaining = Math.max(0, orig - reservedTotalForProduct(productId));
      cell.textContent = formatQuantity(remaining);
    };

    function renderProductsRows(products){
      if (!productsTbody) return;

      productsTbody.innerHTML = '';

      if (!Array.isArray(products) || products.length === 0) {
        const emptyRow = document.createElement('tr');
        emptyRow.innerHTML = '<td colspan="4" class="px-4 py-6 text-center text-sm text-slate-500">No se encontraron productos.</td>';
        productsTbody.appendChild(emptyRow);
        return;
      }

      products.forEach((product) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-slate-100';
        tr.dataset.productRow = 'true';
        tr.dataset.productId = String(product.id);
        tr.dataset.productName = String(product.name || '');
        tr.dataset.variations = JSON.stringify(Array.isArray(product.variations) ? product.variations : []);
        // Guardar total original para poder recalcular existencia provisional
        tr.dataset.originalTotal = String(Number(product.total_quantity) || 0);

        const originalTotal = Number(product.total_quantity) || 0;
        const remainingTotal = Math.max(0, originalTotal - reservedTotalForProduct(product.id));

        tr.innerHTML = `
          <td class="px-4 py-3">${escapeHtml(product.name)}</td>
          <td class="px-4 py-3 text-xs text-slate-500">${escapeHtml(product.variations_label || '')}</td>
          <td class="px-4 py-3 text-right font-semibold text-slate-700">${escapeHtml(formatQuantity(remainingTotal))}</td>
          <td class="px-4 py-3 text-right"><button type="button" class="inline-flex items-center rounded-xl bg-cyan-600 px-3 py-1 text-xs text-white" data-add-to-invoice>Agregar</button></td>
        `;

        productsTbody.appendChild(tr);
      });
    }

    function updatePaginationUi(){
      if (productsMeta) {
        const pageEl = productsMeta.querySelector('[data-products-page]');
        const totalPagesEl = productsMeta.querySelector('[data-products-total-pages]');
        const totalCountEl = productsMeta.querySelector('[data-products-total-count]');
        if (pageEl) pageEl.textContent = String(currentPage);
        if (totalPagesEl) totalPagesEl.textContent = String(totalPages);
        if (totalCountEl) totalCountEl.textContent = String(totalCount);
      }

      if (prevPageBtn) prevPageBtn.disabled = currentPage <= 1;
      if (nextPageBtn) nextPageBtn.disabled = currentPage >= totalPages;
    }

    async function loadProducts(page = 1){
      if (!productsUrl) return;

      const queryText = String(productSearchInput?.value || '').trim();
      const params = new URLSearchParams({
        page: String(page),
        per_page: String(perPage),
      });
      if (queryText.length > 0) {
        params.set('query_text', queryText);
      }

      const response = await fetch(`${productsUrl}?${params.toString()}`, {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      });

      if (!response.ok) {
        throw new Error('No se pudieron cargar los productos.');
      }

      const payload = await response.json();
      const products = Array.isArray(payload?.products) ? payload.products : [];
      const meta = payload?.meta || {};

      currentPage = Number(meta.page || page || 1);
      totalPages = Number(meta.total_pages || 1);
      totalCount = Number(meta.total_count || 0);

      renderProductsRows(products);
      updatePaginationUi();
    }

    function queueProductsSearch(){
      if (searchDebounceTimer) {
        window.clearTimeout(searchDebounceTimer);
      }

      searchDebounceTimer = window.setTimeout(() => {
        loadProducts(1).catch((error) => {
          window.alert(error?.message || 'No se pudo filtrar el listado de productos.');
        });
      }, 250);
    }

    function formatUsd(value){
      const amount = Number(value || 0);
      const safe = Number.isFinite(amount) ? amount : 0;
      return `$ ${safe.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function openModalForRow(row){
      const prodId = row.dataset.productId;
      const prodName = row.dataset.productName;
      const variations = JSON.parse(row.dataset.variations || '[]');
      currentProduct = { id: prodId, name: prodName, variations };
      modalTitle.textContent = `Agregar: ${prodName}`;
      variationSelect.innerHTML = '';
      variations.forEach(v => {
        const opt = document.createElement('option');
        opt.value = v.id;
        const originalAvail = Number(v.available) || 0;
        const adjustedAvail = Math.max(0, originalAvail - reservedFor(prodId, v.id));
        opt.textContent = `${v.name} — ${adjustedAvail} uds — ${formatUsd(v.price_value)}`;
        opt.dataset.priceValue = v.price_value;
        opt.dataset.available = String(adjustedAvail);
        opt.dataset.originalAvailable = String(originalAvail);
        variationSelect.appendChild(opt);
      });

      // Ajustar el input de cantidad según la variación seleccionada
      const syncQuantityInputToSelected = () => {
        const sel = variationSelect.options[variationSelect.selectedIndex];
        const avail = Number(sel?.dataset?.available || '0') || 0;
        const orig = Number(sel?.dataset?.originalAvailable || '0') || 0;
        // si disponibilidad < 1, usar paso fino (kg), si >=1 usar paso entero
        if (avail < 1 && avail > 0) {
          quantityInput.step = '0.001';
          quantityInput.min = '0.001';
        } else {
          quantityInput.step = '1';
          quantityInput.min = '1';
        }
        quantityInput.max = String(avail);
        // ajustar valor actual si excede la disponibilidad
        const cur = parseFloat(quantityInput.value) || 0;
        if (avail <= 0) {
          quantityInput.value = quantityInput.min || '0';
        } else if (cur <= 0) {
          // dejar 1 por defecto si disponible
          quantityInput.value = avail >= 1 ? '1' : String(Math.min(avail, 1));
        } else if (cur > avail) {
          quantityInput.value = String(avail);
        }
      };

      variationSelect.addEventListener('change', syncQuantityInputToSelected);
      // inicializar
      syncQuantityInputToSelected();
      quantityInput.value = 1;
      addModal.classList.remove('hidden'); addModal.classList.add('flex');
    }

    function closeModal(){ addModal.classList.add('hidden'); addModal.classList.remove('flex'); }

    productsTable.addEventListener('click', function(e){
      const btn = e.target.closest('[data-add-to-invoice]');
      if(!btn) return;
      const row = btn.closest('tr[data-product-row]');
      if(!row) return;
      openModalForRow(row);
    });

    modalCancel.addEventListener('click', closeModal);

    if (productSearchInput) {
      productSearchInput.addEventListener('input', queueProductsSearch);
      productSearchInput.addEventListener('keyup', queueProductsSearch);
    }

    if (prevPageBtn) {
      prevPageBtn.addEventListener('click', () => {
        if (currentPage <= 1) return;
        loadProducts(currentPage - 1).catch((error) => {
          window.alert(error?.message || 'No se pudo cargar la página anterior.');
        });
      });
    }

    if (nextPageBtn) {
      nextPageBtn.addEventListener('click', () => {
        if (currentPage >= totalPages) return;
        loadProducts(currentPage + 1).catch((error) => {
          window.alert(error?.message || 'No se pudo cargar la siguiente página.');
        });
      });
    }

    updatePaginationUi();

    modalAdd.addEventListener('click', function(){
      if(!currentProduct) return;
      const variationId = variationSelect.value;
      const selectedOption = variationSelect.options[variationSelect.selectedIndex];
      const variationText = selectedOption?.textContent || '';
      const unitPrice = parseFloat(selectedOption?.dataset.priceValue || '0') || 0;
      const available = Number(selectedOption?.dataset.available || '0') || 0;
      const origAvailable = Number(selectedOption?.dataset.originalAvailable || '0') || 0;
      const qty = parseFloat(quantityInput.value) || 0;
      if(qty <= 0) return alert('Cantidad inválida');
      if(qty > available) return alert(`Stock insuficiente. Disponible: ${formatQuantity(available)}`);
      const lineTotal = +(qty * unitPrice).toFixed(2);
      const item = { producto_id: currentProduct.id, product_variation_id: variationId, quantity: qty, unit_price_usd: unitPrice, line_total: lineTotal, name: currentProduct.name, variation_text: variationText };
      items.push(item);
      // Registrar reserva provisional y actualizar UI
      addReservation(currentProduct.id, variationId, qty);
      updateRowAvailabilityByProductId(currentProduct.id, origAvailable || (Number(currentProduct.total_quantity) || 0));
      renderItems();
      closeModal();
    });

    function renderItems(){
      invoiceTbody.innerHTML = '';
      let subtotal = 0;
      items.forEach((it, idx) => {
        subtotal += Number(it.line_total || 0);
        const tr = document.createElement('tr');
        tr.innerHTML = `<td class="py-2 text-sm">${it.name}<div class="text-xs text-slate-400">${it.variation_text}</div></td><td class="py-2 text-right">${it.quantity}</td><td class="py-2 text-right">${formatUsd(it.unit_price_usd)}</td><td class="py-2 text-right">${formatUsd(it.line_total)}</td><td class="py-2 text-right"><button data-remove-index="${idx}" class="text-rose-600 text-xs">Eliminar</button></td>`;
        invoiceTbody.appendChild(tr);
      });
      subtotalEl.textContent = formatUsd(subtotal);
      itemsJsonInput.value = JSON.stringify(items.map(i=>({producto_id: i.producto_id, product_variation_id: i.product_variation_id, quantity: i.quantity, unit_price_usd: i.unit_price_usd})));
    }

    invoiceTbody.addEventListener('click', function(e){
      const btn = e.target.closest('[data-remove-index]');
      if(!btn) return;
      const idx = Number(btn.getAttribute('data-remove-index'));
      const removed = items.splice(idx,1);
      if (removed && removed.length > 0) {
        const it = removed[0];
        try {
          removeReservation(it.producto_id, it.product_variation_id, it.quantity);
          // restore UI using stored original total on row
          const row = productsTbody?.querySelector(`tr[data-product-id="${String(it.producto_id)}"]`);
          const orig = row ? Number(row.dataset.originalTotal || '0') : null;
          updateRowAvailabilityByProductId(it.producto_id, orig);
        } catch (err) {
          // ignore
        }
      }
      renderItems();
    });

    invoiceForm.addEventListener('submit', function(e){
      if(items.length === 0){ e.preventDefault(); alert('Agrega al menos un producto'); }
    });
  })();
</script>
