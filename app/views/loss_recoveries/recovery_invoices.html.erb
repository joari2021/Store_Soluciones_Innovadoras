<div class="space-y-6">
  <div class="rounded-3xl border border-cyan-100 bg-gradient-to-r from-cyan-50 via-white to-sky-50 p-5 shadow-sm md:p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Recuperacion de perdidas</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Facturas de recuperación</h1>
      </div>
      <%= link_to new_recovery_invoice_loss_recoveries_path, class: "inline-flex items-center gap-2 rounded-xl border border-cyan-200 bg-cyan-50 px-3.5 py-2 text-sm font-semibold text-cyan-700" do %>
        <i data-lucide="plus" class="h-4 w-4"></i> Nueva factura
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm text-slate-700">
        <thead>
          <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
            <th class="px-3 py-2 text-left">Fecha</th>
            <th class="px-3 py-2 text-left">Usuario</th>
            <th class="px-3 py-2 text-right">Total USD</th>
            <th class="px-3 py-2 text-right">Accion</th>
          </tr>
        </thead>
        <tbody>
          <% if @recovery_invoices.any? %>
            <% @recovery_invoices.each do |inv| %>
              <tr class="border-b border-slate-100">
                <td class="px-3 py-2"><%= inv.occurred_at&.in_time_zone&.strftime('%d/%m/%Y %H:%M') %></td>
                <td class="px-3 py-2"><%= inv.user&.display_name || inv.user&.email || 'Usuario' %></td>
                <td class="px-3 py-2 text-right"><%= number_to_currency(inv.total_usd, unit: '$ ') %></td>
                <td class="px-3 py-2 text-right">
                  <div class="inline-flex items-center gap-2">
                    <%= link_to 'Ver',
                                recovery_invoices_loss_recoveries_path(invoice_id: inv.id),
                                class: 'inline-flex items-center rounded-lg border border-sky-300 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100' %>
                    <%= button_to 'Eliminar', destroy_recovery_invoice_loss_recoveries_path(inv), method: :delete, form: { data: { turbo_confirm: 'Se eliminará esta factura y se restaurará el inventario. Deseas continuar?' } }, class: 'inline-flex items-center rounded-lg border border-rose-300 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100' %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-3 py-6 text-center text-slate-400">No hay facturas de recuperación.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @selected_recovery_invoice.present? %>
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-slate-800">Detalle de factura seleccionada</h2>
        <p class="text-xs text-slate-500">
          Fecha: <span class="font-semibold text-slate-700"><%= @selected_recovery_invoice.occurred_at&.in_time_zone('America/Caracas')&.strftime('%d/%m/%Y %H:%M') %></span>
          · Usuario: <span class="font-semibold text-slate-700"><%= @selected_recovery_invoice.user&.display_name || @selected_recovery_invoice.user&.email || 'Usuario' %></span>
        </p>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-slate-700">
          <thead>
            <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
              <th class="px-3 py-2 text-left">Producto</th>
              <th class="px-3 py-2 text-left">Variacion</th>
              <th class="px-3 py-2 text-right">Cantidad</th>
              <th class="px-3 py-2 text-right">Precio USD</th>
              <th class="px-3 py-2 text-right">Total USD</th>
            </tr>
          </thead>
          <tbody>
            <% if @selected_recovery_invoice_items.any? %>
              <% @selected_recovery_invoice_items.each do |item| %>
                <tr class="border-b border-slate-100">
                  <td class="px-3 py-2"><%= item.producto&.descripcion.to_s.presence || 'Producto' %></td>
                  <td class="px-3 py-2"><%= item.product_variation&.description.to_s.presence || 'Unica' %></td>
                  <td class="px-3 py-2 text-right"><%= number_with_precision(item.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
                  <td class="px-3 py-2 text-right"><%= number_to_currency(item.unit_price_usd, unit: '$ ') %></td>
                  <td class="px-3 py-2 text-right"><%= number_to_currency(item.total_price_usd, unit: '$ ') %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="px-3 py-6 text-center text-slate-400">Esta factura no tiene lineas registradas.</td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="4" class="px-3 py-3 text-right text-sm font-semibold text-slate-600">Total factura</td>
              <td class="px-3 py-3 text-right text-base font-extrabold text-slate-800"><%= number_to_currency(@selected_recovery_invoice.total_usd, unit: '$ ') %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% end %>
</div>
