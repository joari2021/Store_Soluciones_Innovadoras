<div class="space-y-6">
  <div class="rounded-3xl border border-cyan-100 bg-gradient-to-r from-cyan-50 via-white to-sky-50 p-5 shadow-sm md:p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Recuperacion de perdidas</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Facturas de recuperación</h1>
      </div>
      <%= link_to new_recovery_invoice_loss_recoveries_path, class: "inline-flex items-center gap-2 rounded-xl border border-cyan-200 bg-cyan-50 px-3.5 py-2 text-sm font-semibold text-cyan-700" do %>
        <i data-lucide="plus" class="h-4 w-4"></i> Nueva factura
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm text-slate-700">
        <thead>
          <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
            <th class="px-3 py-2 text-left">Fecha</th>
            <th class="px-3 py-2 text-left">Usuario</th>
            <th class="px-3 py-2 text-right">Total USD</th>
            <th class="px-3 py-2 text-right">Accion</th>
          </tr>
        </thead>
        <tbody>
          <% if @recovery_invoices.any? %>
            <% @recovery_invoices.each do |inv| %>
              <% invoice_payload = {
                   id: inv.id,
                   occurred_at: inv.occurred_at&.in_time_zone('America/Caracas')&.strftime('%d/%m/%Y %H:%M'),
                   user_name: inv.user&.display_name || inv.user&.email || 'Usuario',
                   total_usd: inv.total_usd.to_d.to_f,
                   items: inv.recovery_invoice_items.map do |item|
                            {
                              product_name: item.producto&.descripcion.to_s.presence || 'Producto',
                              variation_name: item.product_variation&.description.to_s.presence || 'Unica',
                              quantity: item.quantity.to_d.to_f,
                              unit_price_usd: item.unit_price_usd.to_d.to_f,
                              total_price_usd: item.total_price_usd.to_d.to_f,
                            }
                          end,
                 } %>
              <tr class="border-b border-slate-100">
                <td class="px-3 py-2"><%= inv.occurred_at&.in_time_zone&.strftime('%d/%m/%Y %H:%M') %></td>
                <td class="px-3 py-2"><%= inv.user&.display_name || inv.user&.email || 'Usuario' %></td>
                <td class="px-3 py-2 text-right"><%= number_to_currency(inv.total_usd, unit: '$ ') %></td>
                <td class="px-3 py-2 text-right">
                  <div class="inline-flex items-center gap-2">
                    <button type="button"
                            class="inline-flex items-center rounded-lg border border-sky-300 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100"
                            data-recovery-invoice-view="true"
                            data-recovery-invoice="<%= json_escape(invoice_payload.to_json) %>">
                      Ver
                    </button>
                    <%= button_to 'Eliminar', destroy_recovery_invoice_loss_recoveries_path(inv), method: :delete, form: { data: { turbo_confirm: 'Se eliminará esta factura y se restaurará el inventario. Deseas continuar?' } }, class: 'inline-flex items-center rounded-lg border border-rose-300 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100' %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-3 py-6 text-center text-slate-400">No hay facturas de recuperación.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<div id="recovery-invoice-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/55 px-3">
  <div class="w-full max-w-4xl rounded-2xl border border-slate-200 bg-white p-5 shadow-2xl">
    <div class="mb-3 flex items-start justify-between gap-2">
      <div>
        <h2 class="text-lg font-bold text-slate-800">Detalle de factura</h2>
        <p id="recovery-invoice-modal-meta" class="text-xs text-slate-500"></p>
      </div>
      <button type="button" class="rounded-lg bg-slate-100 px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-200" data-recovery-invoice-close="true">Cerrar</button>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm text-slate-700">
        <thead>
          <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
            <th class="px-3 py-2 text-left">Producto</th>
            <th class="px-3 py-2 text-left">Variacion</th>
            <th class="px-3 py-2 text-right">Cantidad</th>
            <th class="px-3 py-2 text-right">Precio USD</th>
            <th class="px-3 py-2 text-right">Total USD</th>
          </tr>
        </thead>
        <tbody id="recovery-invoice-modal-items"></tbody>
        <tfoot>
          <tr>
            <td colspan="4" class="px-3 py-3 text-right text-sm font-semibold text-slate-600">Total factura</td>
            <td id="recovery-invoice-modal-total" class="px-3 py-3 text-right text-base font-extrabold text-slate-800">$ 0,00</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>
<script>
  (() => {
    const modal = document.getElementById('recovery-invoice-modal');
    const modalMeta = document.getElementById('recovery-invoice-modal-meta');
    const modalItems = document.getElementById('recovery-invoice-modal-items');
    const modalTotal = document.getElementById('recovery-invoice-modal-total');
    if (!modal || !modalMeta || !modalItems || !modalTotal) return;

    const formatUsd = (value) => {
      const amount = Number(value || 0);
      const safe = Number.isFinite(amount) ? amount : 0;
      return `${safe.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} $`;
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    };

    const openModalWithInvoice = (invoice) => {
      const occurredAt = String(invoice?.occurred_at || 'N/A');
      const userName = String(invoice?.user_name || 'Usuario');
      modalMeta.textContent = `Fecha: ${occurredAt} · Usuario: ${userName}`;

      const items = Array.isArray(invoice?.items) ? invoice.items : [];
      if (items.length === 0) {
        modalItems.innerHTML = '<tr><td colspan="5" class="px-3 py-6 text-center text-slate-400">Esta factura no tiene lineas registradas.</td></tr>';
      } else {
        modalItems.innerHTML = items.map((item) => {
          const productName = String(item?.product_name || 'Producto');
          const variationName = String(item?.variation_name || 'Unica');
          const quantity = Number(item?.quantity || 0);
          const unitPrice = Number(item?.unit_price_usd || 0);
          const lineTotal = Number(item?.total_price_usd || 0);
          const safeQuantity = Number.isFinite(quantity) ? quantity : 0;

          return `<tr class="border-b border-slate-100">
            <td class="px-3 py-2">${productName}</td>
            <td class="px-3 py-2">${variationName}</td>
            <td class="px-3 py-2 text-right">${safeQuantity.toLocaleString('es-VE', { maximumFractionDigits: 3 })}</td>
            <td class="px-3 py-2 text-right">${formatUsd(unitPrice)}</td>
            <td class="px-3 py-2 text-right">${formatUsd(lineTotal)}</td>
          </tr>`;
        }).join('');
      }

      modalTotal.textContent = formatUsd(invoice?.total_usd || 0);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };

    document.querySelectorAll('[data-recovery-invoice-view="true"]').forEach((button) => {
      button.addEventListener('click', () => {
        const raw = button.dataset.recoveryInvoice || '{}';
        let payload = {};

        try {
          payload = JSON.parse(raw);
        } catch (_error) {
          payload = {};
        }

        openModalWithInvoice(payload);
      });
    });

    modal.querySelectorAll('[data-recovery-invoice-close="true"]').forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
  })();
</script>
