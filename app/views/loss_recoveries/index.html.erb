<div class="space-y-6">
  <div class="rounded-3xl border border-amber-100 bg-gradient-to-r from-amber-50 via-white to-orange-50 p-5 shadow-sm md:p-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Modulo administrativo</p>
    <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl">Recuperacion de perdidas</h1>
    <p class="mt-1 text-sm text-slate-500">Configura un recargo invisible sobre ventas para recuperar faltantes de inventario.</p>
  </div>
  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Saldo recuperado (USD)</p>
      <p class="mt-2 text-2xl font-extrabold text-emerald-700"><%= number_to_currency(@summary[:total_excess_usd], unit: "$ ") %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Movimientos</p>
      <p class="mt-2 text-2xl font-extrabold text-slate-800"><%= @summary[:count] %></p>
    </div>
    <div class="rounded-2xl border border-cyan-200 bg-cyan-50/60 p-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Saldo base acumulado</p>
      <p class="mt-2 text-2xl font-extrabold text-cyan-700"><%= number_to_currency(@summary[:total_excess_base], unit: "") %></p>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with model: @setting, url: update_settings_loss_recoveries_path, method: :patch, local: true, class: "grid gap-4 md:grid-cols-4 md:items-end" do |form| %>
      <div class="md:col-span-1">
        <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700">
          <%= form.check_box :active, class: "h-4 w-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500" %>
          Activar recuperacion
        </label>
      </div>
      <div>
        <%= form.label :surcharge_percent, "Porcentaje extra (%)", class: "block text-sm font-medium text-slate-700" %>
        <%= form.number_field :surcharge_percent, step: 0.01, min: 0, max: 100, class: "mt-1 block w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700" %>
      </div>
      <div>
        <%= form.label :min_invoice_total_usd, "Minimo de factura (USD)", class: "block text-sm font-medium text-slate-700" %>
        <%= form.number_field :min_invoice_total_usd, step: 0.01, min: 0, class: "mt-1 block w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700" %>
      </div>
      <div>
        <%= form.submit "Guardar configuracion", class: "inline-flex w-full items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800" %>
      </div>
    <% end %>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-sm font-bold uppercase tracking-wide text-slate-500">Ultimos excesos registrados</h2>
      <%= link_to "Ver historial", history_loss_recoveries_path, class: "inline-flex items-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm text-slate-700">
        <thead>
          <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
            <th class="px-3 py-2 text-left">Fecha</th>
            <th class="px-3 py-2 text-left">Venta</th>
            <th class="px-3 py-2 text-left">Cuenta</th>
            <th class="px-3 py-2 text-right">Exceso base</th>
            <th class="px-3 py-2 text-right">Exceso USD</th>
          </tr>
        </thead>
        <tbody>
          <% if @recent_entries.any? %>
            <% @recent_entries.each do |entry| %>
              <tr class="border-b border-slate-100">
                <td class="px-3 py-2"><%= entry.occurred_at&.in_time_zone&.strftime('%d/%m/%Y %H:%M') %></td>
                <td class="px-3 py-2">
                  <%= link_to "Venta ##{entry.venta_id}", venta_path(entry.venta_id), class: "font-semibold text-sky-700 hover:text-sky-600" %>
                </td>
                <td class="px-3 py-2">
                  <% if entry.account.present? %>
                    <%= link_to entry.account.name, account_path(entry.account), class: "text-cyan-700 hover:text-cyan-600" %>
                  <% else %>
                    <span class="text-slate-400">Sin cuenta</span>
                  <% end %>
                </td>
                <td class="px-3 py-2 text-right"><%= number_to_currency(entry.excess_base, unit: "") %> <%= entry.base_currency %></td>
                <td class="px-3 py-2 text-right"><%= number_to_currency(entry.excess_usd, unit: "$ ") %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-3 py-6 text-center text-slate-400">Aun no hay registros de recuperacion.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
