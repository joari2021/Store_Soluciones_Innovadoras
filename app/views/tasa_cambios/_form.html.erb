<%= form_with model: tasa_cambio, local: true, data: { tasa_cambio_form: true } do |form| %>
  <% if tasa_cambio.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-bold">No se pudo guardar la tasa</h4>
        <span class="text-xs font-medium"><%= pluralize(tasa_cambio.errors.count, 'error') %></span>
      </div>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% tasa_cambio.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
    <div>
      <%= form.label :description, 'Descripción', class: 'block text-sm font-medium text-slate-700' %>
      <%= form.text_field :description, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: Dolar BCV' %>
    </div>
    <div>
      <%= form.label :valor, 'Valor de la tasa', class: 'block text-sm font-medium text-slate-700' %>
      <%= form.hidden_field :valor, data: { tasa_valor_hidden: true } %>
      <%= text_field_tag :valor_masked,
                         (tasa_cambio.valor.present? ? format_money(tasa_cambio.valor, unit: 'Bs') : ''),
                         inputmode: 'decimal',
                         autocomplete: 'off',
                         placeholder: '0,00',
                         data: { money_mask: true, money_symbol: 'Bs', tasa_valor_mask: true },
                         class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
    </div>
    <div>
      <%= form.label :symbol, 'Símbolo', class: 'block text-sm font-medium text-slate-700' %>
      <%= form.text_field :symbol, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: $, €, Bs, USDT' %>
    </div>
    <div>
      <%= form.label :fecha_referencia, 'Fecha de referencia', class: 'block text-sm font-medium text-slate-700' %>
      <%= form.text_field :fecha_referencia,
                          value: form.object.fecha_referencia&.strftime('%d-%m-%Y'),
                          autocomplete: 'off',
                          placeholder: 'dd-mm-aaaa',
                          class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
    </div>
  </div>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <%= form.submit (tasa_cambio.persisted? ? 'Actualizar tasa' : 'Guardar tasa'), class: 'inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-300 cursor-pointer' %>
    <%= link_to 'Cancelar', tasa_cambios_path, class: 'inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 hover:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-300' %>
  </div>
<% end %>
<script>
  const initTasaCambioMoneyMask = () => {
    document.querySelectorAll('form[data-tasa-cambio-form="true"]').forEach((form) => {
      if (form.dataset.tasaCambioBound === "true") return;
      form.dataset.tasaCambioBound = "true";

      const maskedInput = form.querySelector('[data-tasa-valor-mask="true"]');
      const hiddenInput = form.querySelector('[data-tasa-valor-hidden="true"]');
      if (!maskedInput || !hiddenInput) return;

      const updateHiddenValue = () => {
        const parsed = window.MoneyInputMask?.parseValue
          ? window.MoneyInputMask.parseValue(maskedInput)
          : Number(maskedInput.value);
        hiddenInput.value = Number.isFinite(parsed) ? parsed : 0;
      };

      updateHiddenValue();
      maskedInput.addEventListener("input", updateHiddenValue);
      form.addEventListener("submit", updateHiddenValue);
    });
  };

  document.addEventListener("turbo:load", initTasaCambioMoneyMask);
  document.addEventListener("turbo:render", initTasaCambioMoneyMask);
  document.addEventListener("DOMContentLoaded", initTasaCambioMoneyMask);
</script>