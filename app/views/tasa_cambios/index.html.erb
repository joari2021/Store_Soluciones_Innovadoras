<div class="space-y-6 fade-in">
  <% if @bcv_ssl_status.present? && @bcv_ssl_status.healthy == false %>
    <% failure_time = @bcv_ssl_status.last_error_at&.in_time_zone('Caracas') %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 shadow-sm">
      <div class="flex items-start gap-3">
        <div class="mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-lg bg-red-100 text-red-700">
          <i data-lucide="shield-alert" class="h-4 w-4"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-red-800">Fallo SSL en scraper BCV</h2>
          <p class="mt-1 text-sm text-red-700">
            El último intento automático del scraper BCV falló por validación de certificado SSL.
            <% if failure_time.present? %>
              Ocurrió el <span class="font-semibold"><%= l(failure_time, format: :short) rescue failure_time.strftime('%d/%m/%Y %H:%M:%S') %></span>.
            <% end %>
          </p>
          <% if @bcv_ssl_status.last_error_message.present? %>
            <p class="mt-2 text-xs text-red-700">
              <span class="font-semibold">Detalle:</span>
              <%= @bcv_ssl_status.last_error_message %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Tasas de Divisas</h1>
        <p class="mt-1 text-sm text-slate-500">Administra y actualiza las tasas usadas en cálculos del sistema.</p>
      </div>
      <div class="flex w-full flex-col gap-2 md:w-auto md:flex-row md:items-center">
        <%= button_to scrape_bcv_tasa_cambios_path, method: :post, form_class: 'w-full md:w-auto', class: 'w-full md:w-auto cursor-pointer bg-sky-600 text-white px-5 py-2.5 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-sky-700 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium' do %>
          <i data-lucide="refresh-cw" class="h-4 w-4"></i>
          Actualizar BCV
        <% end %>
        <%= button_to scrape_usdt_tasa_cambios_path, method: :post, form_class: 'w-full md:w-auto', class: 'w-full md:w-auto cursor-pointer bg-emerald-600 text-white px-5 py-2.5 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-emerald-700 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium' do %>
          <i data-lucide="refresh-cw" class="h-4 w-4"></i>
          Actualizar USDT
        <% end %>
        <%= link_to new_tasa_cambio_path, class: "w-full md:w-auto bg-slate-900 text-white px-6 py-3 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-slate-800 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 4.5a.75.75 0 0 1 .75.75v6h6a.75.75 0 0 1 0 1.5h-6v6a.75.75 0 0 1-1.5 0v-6h-6a.75.75 0 0 1 0-1.5h6v-6a.75.75 0 0 1 .75-.75Z" />
          </svg>
          Nueva tasa
        <% end %>
      </div>
    </div>
  </div>
  <% if @tasa_cambios.any? %>
    <div class="grid gap-3 md:hidden">
      <% @tasa_cambios.each do |tasa_cambio| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-base font-bold text-slate-800"><%= tasa_cambio.description %></h3>
              <p class="mt-1 text-sm text-slate-500">Fecha referencia: <%= l(tasa_cambio.fecha_referencia) rescue tasa_cambio.fecha_referencia&.strftime('%d/%m/%Y') %></p>
            </div>
            <span class="inline-flex items-center rounded-lg bg-sky-100 px-2.5 py-1 text-xs font-semibold text-sky-700"><%= tasa_cambio.symbol %></span>
          </div>
          <div class="mt-3 text-lg font-bold text-slate-800"><%= format_money(tasa_cambio.valor, unit: 'Bs') %></div>
          <div class="mt-4 flex items-center gap-2">
            <%= link_to 'Ver', tasa_cambio_path(tasa_cambio), class: 'inline-flex items-center justify-center rounded-lg bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100 transition-colors' %>
            <%= link_to 'Editar', edit_tasa_cambio_path(tasa_cambio), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-700 hover:bg-amber-100 transition-colors' %>
            <%= link_to 'Eliminar', tasa_cambio_path(tasa_cambio), method: :delete, data: { swal_delete: 'tasa_cambio' }, class: 'inline-flex items-center justify-center rounded-lg bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-100 transition-colors' %>
          </div>
        </article>
      <% end %>
    </div>
    <div class="hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:block">
      <table class="min-w-full table-auto text-sm text-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-4 text-left font-bold">Descripción</th>
            <th class="px-6 py-4 text-center font-bold">Valor</th>
            <th class="px-6 py-4 text-left font-bold">Fecha referencia</th>
            <th class="px-6 py-4 text-left font-bold">Registro</th>
            <th class="px-6 py-4 text-right font-bold">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @tasa_cambios.each_with_index do |tasa_cambio, index| %>
            <tr class="transition-all duration-150 <%= index.even? ? 'bg-white' : 'bg-slate-50/50' %> hover:bg-sky-50/70">
              <td class="px-6 py-4 font-semibold text-slate-800"><%= tasa_cambio.description %></td>
              <td class="px-6 py-4 text-center whitespace-nowrap"><span class="inline-flex items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= format_money(tasa_cambio.valor, unit: 'Bs') %></span></td>
              <td class="px-6 py-4"><%= l(tasa_cambio.fecha_referencia) rescue tasa_cambio.fecha_referencia&.strftime('%d/%m/%Y') %></td>
              <td class="px-6 py-4"><%= l(tasa_cambio.updated_at, format: :short) rescue tasa_cambio.updated_at.strftime('%d/%m/%Y %H:%M') %></td>
              <td class="px-6 py-4">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to tasa_cambio_path(tasa_cambio), class: 'inline-flex items-center justify-center rounded-lg bg-emerald-50 p-2 text-emerald-600 hover:bg-emerald-100 transition-colors', title: 'Ver', 'aria-label': 'Ver' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                      <path d="M12 4.5c-5 0-9.27 3.11-11 7.5 1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5Zm0 12a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
                      <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                    </svg>
                  <% end %>
                  <%= link_to edit_tasa_cambio_path(tasa_cambio), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors', title: 'Editar', 'aria-label': 'Editar' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                      <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
                    </svg>
                  <% end %>
                  <%= link_to tasa_cambio_path(tasa_cambio), method: :delete, data: { swal_delete: 'tasa_cambio' }, class: 'inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 hover:bg-red-100 transition-colors', title: 'Eliminar', 'aria-label': 'Eliminar' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                      <path fill-rule="evenodd" d="M16.5 4.5V6h3a.75.75 0 0 1 0 1.5h-.638l-1.02 11.214A2.25 2.25 0 0 1 15.603 21H8.397a2.25 2.25 0 0 1-2.24-2.286L5.138 7.5H4.5a.75.75 0 0 1 0-1.5h3V4.5A1.5 1.5 0 0 1 9 3h6a1.5 1.5 0 0 1 1.5 1.5Zm-7.5 0V6h6V4.5h-6Z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No hay tasas registradas</h3>
      <p class="mt-1 text-sm text-slate-500">Crea una tasa para comenzar a usar conversiones en el sistema.</p>
    </div>
  <% end %>
</div>