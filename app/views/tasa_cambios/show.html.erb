<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Historial de <%= @tasa_cambio.description %></h1>
        <p class="mt-1 text-sm text-slate-500">Registros por fecha de referencia para esta tasa.</p>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to 'Nueva tasa', new_tasa_cambio_path(description: @tasa_cambio.description), class: 'inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-300' %>
        <%= link_to 'Volver', tasa_cambios_path, class: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-300' %>
      </div>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: tasa_cambio_path(@tasa_cambio), method: :get, local: true, class: 'flex flex-col gap-3 md:flex-row md:items-end md:gap-4' do %>
      <div class="flex-none">
        <label for="fecha" class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Fecha referencia</label>
        <%= text_field_tag :fecha,
                           @fecha_filtro_display,
                           autocomplete: 'off',
                           placeholder: 'dd-mm-aaaa',
                           class: 'js-materialize-datepicker materialize-datepicker-input mt-2 block w-40 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      </div>
      <div class="flex items-center gap-2">
        <%= submit_tag 'Buscar', class: 'inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 cursor-pointer' %>
        <% if @fecha_filtro.present? %>
          <%= link_to 'Limpiar', tasa_cambio_path(@tasa_cambio), class: 'inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
    <div class="w-full overflow-x-auto">
      <table class="w-full min-w-[760px] md:min-w-full table-auto text-sm text-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-4 text-left font-bold">Descripción</th>
            <th class="px-6 py-4 text-center font-bold">Valor</th>
            <th class="px-6 py-4 text-left font-bold">Fecha referencia</th>
            <th class="px-6 py-4 text-left font-bold">Registro</th>
            <% if @show_percentage_change %>
              <th class="px-6 py-4 text-center font-bold">% aumento vs anterior</th>
            <% end %>
            <th class="px-6 py-4 text-right font-bold">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @historial_tasas.each_with_index do |tasa, index| %>
            <tr class="transition-all duration-150 <%= index.even? ? 'bg-white' : 'bg-slate-50/50' %> hover:bg-sky-50/70">
              <td class="px-6 py-4 font-semibold text-slate-800"><%= tasa.description %></td>
              <td class="px-6 py-4 text-center whitespace-nowrap"><span class="inline-flex items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= format_money(tasa.valor, unit: 'Bs') %></span></td>
              <td class="px-6 py-4"><%= l(tasa.fecha_referencia) rescue tasa.fecha_referencia&.strftime('%d/%m/%Y') %></td>
              <td class="px-6 py-4"><%= l(tasa.updated_at, format: :short) rescue tasa.updated_at.strftime('%d/%m/%Y %H:%M') %></td>
              <% if @show_percentage_change %>
                <% previous_valor = tasa.attributes['previous_valor'] %>
                <% previous_valor_decimal = previous_valor.present? ? previous_valor.to_d : nil %>
                <% porcentaje_aumento = if previous_valor_decimal.present? && previous_valor_decimal.positive?
                                          ((tasa.valor.to_d - previous_valor_decimal) / previous_valor_decimal) * 100
                                        end %>
                <td class="px-6 py-4 text-center whitespace-nowrap">
                  <% if porcentaje_aumento.nil? %>
                    <span class="text-slate-400">-</span>
                  <% else %>
                    <% percentage_class = if porcentaje_aumento.positive?
                                            'bg-emerald-50 text-emerald-700'
                                          elsif porcentaje_aumento.negative?
                                            'bg-red-50 text-red-700'
                                          else
                                            'bg-slate-100 text-slate-700'
                                          end %>
                    <span class="inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-semibold <%= percentage_class %>">
                      <%= porcentaje_aumento.positive? ? '+' : '' %><%= number_with_precision(porcentaje_aumento, precision: 2) %>%
                    </span>
                  <% end %>
                </td>
              <% end %>
              <td class="px-6 py-4">
                <% if can_manage_action?(:manage_rates_catalog) %>
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to edit_tasa_cambio_path(tasa), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors', title: 'Editar', 'aria-label': 'Editar' do %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                        <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
                      </svg>
                    <% end %>
                    <%= link_to tasa_cambio_path(tasa), method: :delete, data: { swal_delete: 'tasa_cambio' }, class: 'inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 hover:bg-red-100 transition-colors', title: 'Eliminar', 'aria-label': 'Eliminar' do %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                        <path fill-rule="evenodd" d="M16.5 4.5V6h3a.75.75 0 0 1 0 1.5h-.638l-1.02 11.214A2.25 2.25 0 0 1 15.603 21H8.397a2.25 2.25 0 0 1-2.24-2.286L5.138 7.5H4.5a.75.75 0 0 1 0-1.5h3V4.5A1.5 1.5 0 0 1 9 3h6a1.5 1.5 0 0 1 1.5 1.5Zm-7.5 0V6h6V4.5h-6Z" clip-rule="evenodd" />
                      </svg>
                    <% end %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy&.pages.to_i > 1 %>
    <div class="flex flex-wrap items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
      <% if @pagy.prev %>
        <%= link_to 'Anterior', pagy_url_for(@pagy, @pagy.prev), class: 'inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' %>
      <% else %>
        <span class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-semibold text-slate-400">Anterior</span>
      <% end %>
      <% @pagy.series.each do |item| %>
        <% if item.is_a?(Integer) %>
          <% if item == @pagy.page %>
            <span class="inline-flex h-9 min-w-[2.25rem] items-center justify-center rounded-lg bg-slate-900 px-3 text-sm font-semibold text-white"><%= item %></span>
          <% else %>
            <%= link_to item, pagy_url_for(@pagy, item), class: 'inline-flex h-9 min-w-[2.25rem] items-center justify-center rounded-lg border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' %>
          <% end %>
        <% elsif item == :gap %>
          <span class="px-2 text-slate-400">...</span>
        <% end %>
      <% end %>
      <% if @pagy.next %>
        <%= link_to 'Siguiente', pagy_url_for(@pagy, @pagy.next), class: 'inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' %>
      <% else %>
        <span class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-semibold text-slate-400">Siguiente</span>
      <% end %>
    </div>
  <% end %>
</div>
