<% total_pages = @product_pairs.size %>
<div class="catalogo-shell" data-catalogo-root="true" data-catalogo-duration="15000">
  <div class="catalogo-book" aria-live="polite">
    <% @product_pairs.each_with_index do |pair, index| %>
      <% left_product = pair[0] %>
      <% right_product = pair[1] %>
      <section class="catalogo-page <%= index.zero? ? 'is-active' : '' %>" data-catalogo-page="true" data-page-index="<%= index %>">
        <div class="catalogo-page__content">
          <%= render partial: 'catalogo_producto_card', locals: { producto: left_product, position: 'top', bcv_rate: @bcv_rate } %>
          <%= render partial: 'catalogo_producto_card', locals: { producto: right_product, position: 'bottom', bcv_rate: @bcv_rate } %>
        </div>
      </section>
    <% end %>
  </div>
</div>
<script>
  (() => {
    const root = document.querySelector('[data-catalogo-root="true"]');
    if (!root || root.dataset.boundCatalogo === 'true') return;
    root.dataset.boundCatalogo = 'true';

    const pages = Array.from(root.querySelectorAll('[data-catalogo-page="true"]'));
    const totalPages = pages.length;
    const duration = Number.parseInt(root.dataset.catalogoDuration || '15000', 10);

    if (!pages.length) return;

    let currentIndex = 0;
    let timer = null;

    const setActivePage = (nextIndex) => {
      pages.forEach((page, index) => {
        page.classList.toggle('is-active', index === nextIndex);
        page.classList.toggle('is-prev', index === currentIndex && index !== nextIndex);
      });
      currentIndex = nextIndex;
    };

    const goNext = () => {
      const nextIndex = currentIndex + 1 >= totalPages ? 0 : currentIndex + 1;
      setActivePage(nextIndex);
    };

    const goPrev = () => {
      const nextIndex = currentIndex - 1 < 0 ? totalPages - 1 : currentIndex - 1;
      setActivePage(nextIndex);
    };

    const stopAuto = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const startAuto = () => {
      stopAuto();
      if (totalPages <= 1) return;
      timer = window.setInterval(goNext, duration);
    };

    startAuto();
  })();
</script>
