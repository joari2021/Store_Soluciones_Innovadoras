<% catalogo_fullscreen = @catalogo_fullscreen == true %>
<% content_for :catalogo_fullscreen, '1' if catalogo_fullscreen %>
<% total_pages = @product_pairs.size %>
<% base_params = request.query_parameters.except(:fullscreen) %>
<% fullscreen_param = base_params.merge(fullscreen: 1) %>
<div class="catalogo-shell" data-catalogo-root="true" data-catalogo-duration="15000" data-catalogo-fullscreen="<%= catalogo_fullscreen ? 'true' : 'false' %>">
  <div class="catalogo-shell__actions">
    <% if catalogo_fullscreen %>
      <%= link_to 'Salir pantalla completa', catalogo_productos_path(base_params), class: 'catalogo-fullscreen-toggle', data: { catalogo_fullscreen_link: 'exit' } %>
    <% else %>
      <%= link_to 'Pantalla completa', catalogo_productos_path(fullscreen_param), class: 'catalogo-fullscreen-toggle', data: { catalogo_fullscreen_link: 'enter' } %>
    <% end %>
  </div>
  <div class="catalogo-book" aria-live="polite">
    <% @product_pairs.each_with_index do |pair, index| %>
      <% left_product = pair[0] %>
      <% right_product = pair[1] %>
      <section class="catalogo-page <%= index.zero? ? 'is-active' : '' %>" data-catalogo-page="true" data-page-index="<%= index %>">
        <div class="catalogo-page__content">
          <%= render partial: 'catalogo_producto_card', locals: { producto: left_product, position: 'top', bcv_rate: @bcv_rate } %>
          <%= render partial: 'catalogo_producto_card', locals: { producto: right_product, position: 'bottom', bcv_rate: @bcv_rate } %>
        </div>
      </section>
    <% end %>
  </div>
</div>
<script>
  (() => {
    const root = document.querySelector('[data-catalogo-root="true"]');
    if (!root || root.dataset.boundCatalogo === 'true') return;
    root.dataset.boundCatalogo = 'true';

    const pages = Array.from(root.querySelectorAll('[data-catalogo-page="true"]'));
    const totalPages = pages.length;
    const duration = Number.parseInt(root.dataset.catalogoDuration || '15000', 10);
    const isFullscreenMode = root.dataset.catalogoFullscreen === 'true';

    if (!pages.length) return;

    let currentIndex = 0;
    let timer = null;

    const setActivePage = (nextIndex) => {
      pages.forEach((page, index) => {
        page.classList.toggle('is-active', index === nextIndex);
        page.classList.toggle('is-prev', index === currentIndex && index !== nextIndex);
      });
      currentIndex = nextIndex;
    };

    const goNext = () => {
      const nextIndex = currentIndex + 1 >= totalPages ? 0 : currentIndex + 1;
      setActivePage(nextIndex);
    };

    const goPrev = () => {
      const nextIndex = currentIndex - 1 < 0 ? totalPages - 1 : currentIndex - 1;
      setActivePage(nextIndex);
    };

    const stopAuto = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const startAuto = () => {
      stopAuto();
      if (totalPages <= 1) return;
      timer = window.setInterval(goNext, duration);
    };

    const requestFullscreen = async () => {
      if (document.fullscreenElement || !root.requestFullscreen) return;
      try {
        await root.requestFullscreen();
      } catch (_error) {
        // Ignore if the browser blocks fullscreen.
      }
    };

    const exitFullscreen = async () => {
      if (!document.fullscreenElement || !document.exitFullscreen) return;
      try {
        await document.exitFullscreen();
      } catch (_error) {
        // Ignore if the browser blocks fullscreen.
      }
    };

    root.querySelectorAll('[data-catalogo-fullscreen-link]').forEach((link) => {
      link.addEventListener('click', async (event) => {
        event.preventDefault();
        const action = link.dataset.catalogoFullscreenLink;
        const href = link.getAttribute('href');

        if (action === 'enter') {
          await requestFullscreen();
        } else if (action === 'exit') {
          await exitFullscreen();
        }

        if (href) {
          window.location.href = href;
        }
      });
    });

    if (isFullscreenMode) {
      const handleFirstClick = async () => {
        await requestFullscreen();
      };
      root.addEventListener('click', handleFirstClick, { once: true });
    }

    startAuto();
  })();
</script>
