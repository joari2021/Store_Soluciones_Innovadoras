<% total_pages = @product_pairs.size %>
<div class="catalog-container" id="catalog" data-catalogo-root="true" data-catalogo-duration="15000">
  <div class="catalog-book" aria-live="polite">
    <% @product_pairs.each_with_index do |pair, index| %>
      <% left_product = pair[0] %>
      <% right_product = pair[1] %>
      <section class="page <%= index.zero? ? 'active' : '' %>" data-catalogo-page="true" data-page-index="<%= index %>">
        <%= render partial: 'catalogo_producto_card', locals: { producto: left_product, position: 'top-left', bcv_rate: @bcv_rate } %>
        <%= render partial: 'catalogo_producto_card', locals: { producto: right_product, position: 'bottom-right', bcv_rate: @bcv_rate } %>
        <div class="catalogo-bcv-badge" aria-hidden="true">
          <%= image_tag 'precios-bcv.jpg', class: 'catalogo-bcv-badge__image', alt: '' %>
          <div class="catalogo-bcv-badge__meta">
            <% usd_rate_value = @bcv_usd_rate&.valor.to_d %>
            <% eur_rate_value = @bcv_eur_rate&.valor.to_d %>
            <% bcv_reference_date = @bcv_usd_rate&.fecha_referencia || @bcv_eur_rate&.fecha_referencia %>
            <p class="catalogo-bcv-rate catalogo-bcv-rate--usd"><%= number_with_precision(usd_rate_value, precision: 2, delimiter: '.', separator: ',') %></p>
            <p class="catalogo-bcv-rate catalogo-bcv-rate--eur"><%= number_with_precision(eur_rate_value, precision: 2, delimiter: '.', separator: ',') %></p>
            <p class="catalogo-bcv-date"><%= bcv_reference_date&.strftime('%d-%m-%y') %></p>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
<script>
  (() => {
    const root = document.querySelector('[data-catalogo-root="true"]');
    if (!root || root.dataset.boundCatalogo === 'true') return;
    root.dataset.boundCatalogo = 'true';

    const pages = Array.from(root.querySelectorAll('[data-catalogo-page="true"]'));
    const totalPages = pages.length;
    const duration = Number.parseInt(root.dataset.catalogoDuration || '15000', 10);

    if (!pages.length) return;

    let currentIndex = 0;
    let timer = null;

    const setActivePage = (nextIndex) => {
      if (nextIndex === currentIndex) return;

      const currentPage = pages[currentIndex];
      const nextPage = pages[nextIndex];

      currentPage.classList.remove('active');
      currentPage.classList.add('leaving');

      nextPage.classList.remove('leaving');
      nextPage.classList.add('active');

      window.setTimeout(() => {
        currentPage.classList.remove('leaving');
      }, 1600);

      currentIndex = nextIndex;
    };

    const goNext = () => {
      const nextIndex = currentIndex + 1 >= totalPages ? 0 : currentIndex + 1;
      setActivePage(nextIndex);
      queueNext();
    };

    const stopAuto = () => {
      if (timer) {
        window.clearTimeout(timer);
        timer = null;
      }
    };

    const queueNext = () => {
      stopAuto();
      if (totalPages <= 1) return;
      timer = window.setTimeout(goNext, duration);
    };

    const startAuto = () => {
      queueNext();
    };

    startAuto();
  })();
</script>
