<div class="fondo-opaco position-relative" style="width: 100%; border: 1px solid black;">
  <% if Current.user&.admin? %>
    <%= link_to 'Nuevo Producto', new_producto_path, class: "btn btn-success mb-3" %>
    <button type="button" class="invisible" id="btn_alerta">
      Alerta Precio <span class="badge bg-danger" id="cont_alerta_precio">0</span>
    </button>
  <% end %>
  <div class="position-absolute top-0 end-0 bg-primary text-white p-2">
    <span>Tasa Dolar BCV: <strong><%= number_to_currency(@tasa_dolar_bcv, unit: "Bs ") %></strong></span>
  </div>
  <h1 class="my-4 text-center">Listado de Productos</h1>
  <%= render "shared/campo_buscar", url: productos_path, busqueda: "Productos" %>
  <div class="row row-cols-1 row-cols-md-5 g-4" id="productos-container">
    <% @cont_alertas = 0 %>
    <% @productos.each do |producto| %>
      <% costo_unidad = (producto.precio_costo / producto.cant_unidades) %>
      <% precio_sugerido_usd = producto.precio_sugerido_usd(costo_unidad)%>
      <% alerta_precio = "" %>
      <% if producto.moneda_base_precio === "Dolar" %>
        <% if precio_sugerido_usd > producto.precio_venta_usd && Current.user&.admin? %>
          <% alerta_precio = "border-danger" %>
          <% @cont_alertas += 1 %>
        <% end %>
      <% else %>
        <% @precio_sugerido_bs = producto.calcular_precio_bs(precio_sugerido_usd) %>
        <% if @precio_sugerido_bs > producto.precio_venta_bs && Current.user&.admin? %>
          <% alerta_precio = "border-danger" %>
          <% @cont_alertas += 1 %>
        <% end %>
      <% end %>
      <div class="col">
        <div class="card h-100 shadow-sm <%= alerta_precio %> text-black">
          <%= image_tag producto.foto, class: "card-img-top", alt: producto.descripcion if producto.foto.attached? %>
          <div class="card-body">
            <h5 class="card-title text-truncate"><%= producto.descripcion %></h5>
            <% if Current.user&.admin? %>
              <p class="card-text mb-1"><strong>Costo Pack ($):</strong> <%= number_to_currency(producto.precio_costo, unit: "$ ") %></p>
              <p class="card-text mb-1"><strong>Costo Pack (Bs):</strong> <%= number_to_currency(producto.calcular_precio_bs(producto.precio_costo), unit: "Bs. ") %></p>
              <p class="card-text mb-1"><strong>Cantidad:</strong> <%= producto.cant_unidades %></p>
              <p class="card-text mb-1"><strong>Costo Unidad ($):</strong> <%= number_to_currency((producto.precio_costo / producto.cant_unidades), unit: "$ ") %></p>
              <p class="card-text mb-1"><strong>Costo Unidad (Bs):</strong> <%= number_to_currency(producto.calcular_precio_bs(producto.precio_costo / producto.cant_unidades), unit: "Bs ") %></p>
              <p class="card-text mb-1"><strong>Nivel Ganancia:</strong> <%= producto.nivel_ganancia.upcase %></p>
              <p class="card-text mb-1"><strong>PV Sugerido ($):</strong> <%= number_to_currency(precio_sugerido_usd, unit: "$ ") %></p>
              <p class="card-text mb-1"><strong>PV Sugerido (Bs):</strong> <%= number_to_currency(producto.calcular_precio_bs(precio_sugerido_usd), unit: "Bs ") %></p>
            <% end %>
            <p class="card-text mb-1"><strong>Precio Venta ($):</strong> <%= number_to_currency(producto.precio_venta_usd, unit: "$ ") %></p>
            <p class="card-text mb-1"><strong>Precio Venta (Bs):</strong> <%= number_to_currency(producto.calcular_precio_bs(producto.precio_venta_usd), unit: "Bs ") %></p>
          </div>
          <% if Current.user&.admin? %>
            <div class="card-footer text-center">
              <%= link_to "Editar", edit_producto_path(producto), class: "btn btn-primary btn-sm" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<script>
  cont_alertas = <%= @cont_alertas %>
  contAlertaPrecio = document.getElementById("cont_alerta_precio")
  btnAlerta = document.getElementById("btn_alerta")

  if (cont_alertas > 0) {
    btnAlerta.classList = "btn btn-warning mx-3";
    contAlertaPrecio.innerHTML = cont_alertas;
  }

  btnAlerta.addEventListener("click", function () {
    const container = document.getElementById("productos-container");
    const cards = container.querySelectorAll(".card");

    if (btnAlerta.dataset.filterActive === "true") {
      cards.forEach(card => {
        card.style.display = "";
      });
      btnAlerta.dataset.filterActive = "false";
      btnAlerta.innerHTML = 'Alerta Precio <span class="badge bg-danger" id="cont_alerta_precio">' + cont_alertas + '</span>';
    } else {
      cards.forEach(card => {
        if (card.classList.contains("border-danger")) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
      btnAlerta.dataset.filterActive = "true";
      btnAlerta.innerHTML = 'Mostrar todos los productos';
    }
  });
</script>