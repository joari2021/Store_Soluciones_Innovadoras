<div class="fondo-opaco position-relative" style="width: 100%; border: 1px solid black;">
  <% if Current.user&.admin? %>
    <%= link_to 'Nuevo Producto', new_producto_path, class: "btn btn-success" %>
    <button type="button" class="invisible" id="btn_alerta">
      Alerta Precio <span class="badge bg-danger" id="cont_alerta_precio">0</span>
    </button>
  <% end %>
  <div class="position-absolute top-0 end-0 bg-primary text-white p-2">
    <span>Tasa Dolar BCV: <strong><%= number_to_currency(@tasa_dolar_bcv, unit: "Bs ") %></strong></span>
  </div>
  <h1 class="my-4">Listado de Productos</h1>
  <table class="tabla-ajustada mt-4">
    <thead>
      <tr>
        <th>Foto</th>
        <th>Descripción</th>
        <% if Current.user&.admin? %>
          <th>Costo Pack ($)</th>
          <th>Costo Pack (Bs)</th>
          <th>Cantidad</th>
          <th>Costo Unidad ($)</th>
          <th>Costo Unidad (Bs)</th>
          <th>Nivel Ganancia</th>
          <th>PV Sugerido ($)</th>
          <th>PV Sugerido (Bs)</th>
        <%end%>
        <th>Precio Venta ($)</th>
        <th>Precio Venta (Bs)</th>
        <% if Current.user&.admin? %>
          <th>Acción</th>
        <%end%>
      </tr>
    </thead>
    <%= turbo_frame_tag "productos" do %>
      <tbody id="tbody_productos">
        <% @cont_alertas = 0 %>
        <% @productos.each do |producto| %>
          <% costo_unidad = (producto.precio_costo / producto.cant_unidades) %>
          <% precio_sugerido_usd = producto.precio_sugerido_usd(costo_unidad)%>
          <tr>
            <td><%= image_tag producto.foto if producto.foto.attached? %></td>
            <td><%= producto.descripcion %></td>
            <% if Current.user&.admin? %>
              <td><%= number_to_currency(producto.precio_costo, unit: "$ ") %></td>
              <td><%= number_to_currency(producto.calcular_precio_bs(producto.precio_costo), unit: "Bs. ") %></td>
              <td><%= producto.cant_unidades %></td>
              <td><%= number_to_currency(costo_unidad, unit: "$ ") %></td>
              <td><%= number_to_currency(producto.calcular_precio_bs(costo_unidad), unit: "Bs ") %></td>
              <td><%= producto.nivel_ganancia.upcase %></td>
              <td><%= number_to_currency(precio_sugerido_usd, unit: "$ ") %></td>
              <td><%= number_to_currency(producto.calcular_precio_bs(precio_sugerido_usd), unit: "Bs ") %></td>
            <% end %>
            <% if producto.moneda_base_precio === "Dolar" %>
              <% if precio_sugerido_usd > producto.precio_venta_usd && Current.user&.admin? %>
                <% alerta_precio = "bg-danger" %>
                <% @cont_alertas += 1 %>
              <% else %>
                <% alerta_precio = "" %>
              <% end %>
              <td class="<%= alerta_precio %>"><%= number_to_currency(producto.precio_venta_usd, unit: "$ ") %></td>
              <td class="<%= alerta_precio %>"><%= number_to_currency(producto.calcular_precio_bs(producto.precio_venta_usd), unit: "Bs ") %></td>
            <% else %>
              <% @precio_sugerido_bs = producto.calcular_precio_bs(precio_sugerido_usd) %>
              <% if @precio_sugerido_bs > producto.precio_venta_bs && Current.user&.admin? %>
                <% alerta_precio = "bg-danger" %>
                <% @cont_alertas += 1 %>
              <% else %>
                <% alerta_precio = "" %>
              <% end %>
              <td class="<%= alerta_precio %>"><%= number_to_currency((producto.precio_venta_bs / @tasa_dolar_bcv), unit: "$ ") %></td>
              <td class="<%= alerta_precio %>"><%= number_to_currency(producto.precio_venta_bs, unit: "Bs ") %></td>
            <% end %>
            <% if Current.user&.admin? %>
              <td><%= link_to "Edit", edit_producto_path(producto), class: "btn btn-primary" %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    <%end%>
  </table>
</div>
<script>
  cont_alertas = <%=@cont_alertas%>
  contAlertaPrecio = document.getElementById("cont_alerta_precio")
  btnAlerta = document.getElementById("btn_alerta")

  if (cont_alertas > 0){
    // Reemplazar todas las clases existentes con las nuevas:
    btnAlerta.classList = "btn btn-warning mx-3"; //
    // Reemplazar el contenido del span con el nuevo texto:
    contAlertaPrecio.innerHTML = cont_alertas; // Puedes usar innerText o innerHTML si necesitas HTML
  }

  // Listener para filtrar filas de la tabla
  btnAlerta.addEventListener("click", function () {
    const tbody = document.getElementById("tbody_productos");
    const rows = tbody.querySelectorAll("tr");

    // Si el botón tiene una bandera de "filtrado activo", restaurar todas las filas
    if (btnAlerta.dataset.filterActive === "true") {
      rows.forEach(row => {
        row.style.display = "";
      });
      btnAlerta.dataset.filterActive = "false";
      btnAlerta.innerHTML = 'Alerta Precio <span class="badge bg-danger" id="cont_alerta_precio">' + cont_alertas + '</span>';
    } else {
      rows.forEach(row => {
        // Se busca alguna celda con la clase 'bg-danger' dentro de la fila
        if (row.querySelector("td.bg-danger")) {
          row.style.display = "";
        } else {
          row.style.display = "none";
        }
      });
      btnAlerta.dataset.filterActive = "true";
      btnAlerta.innerHTML = 'Mostrar todos los productos';
    }
  });
</script>