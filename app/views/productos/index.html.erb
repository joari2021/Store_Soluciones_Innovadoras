<section id="tab-productos" class="hidden space-y-6 fade-in">
  <% can_manage_products = can_manage_action?(:manage_products) %>
  <% can_view_sensitive_inventory = current_user_admin? %>
  <% can_unpack = current_user_admin? || current_user_manager? %>
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Productos</h1>
      </div>
      <div class="flex w-full flex-col gap-2 sm:flex-row sm:flex-wrap sm:justify-end">
        <% if can_unpack %>
          <%= link_to internal_usages_productos_path,
                      class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-sm font-medium text-emerald-700 shadow-sm transition-all hover:bg-emerald-100 sm:w-auto' do %>
            <i data-lucide="notebook-pen" class="h-4 w-4"></i>
            Uso interno
          <% end %>
          <%= link_to unpack_packs_productos_path,
                      class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2 text-sm font-medium text-amber-700 shadow-sm transition-all hover:bg-amber-100 sm:w-auto' do %>
            <i data-lucide="package-open" class="h-4 w-4"></i>
            Destapar pack
          <% end %>
          <%= link_to unpack_histories_productos_path,
                      class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-cyan-200 bg-cyan-50 px-3.5 py-2 text-sm font-medium text-cyan-700 shadow-sm transition-all hover:bg-cyan-100 sm:w-auto' do %>
            <i data-lucide="history" class="h-4 w-4"></i>
            Historial desempaque
          <% end %>
        <% end %>
        <% if can_manage_products %>
          <% if current_user_admin? %>
            <%= link_to global_products_path,
                        class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-indigo-300 bg-indigo-50 px-3.5 py-2 text-sm font-medium text-indigo-700 shadow-sm transition-all hover:bg-indigo-100 sm:w-auto' do %>
              <i data-lucide="database" class="h-4 w-4"></i>
              Productos globales
            <% end %>
            <%= link_to import_from_global_productos_path,
                        class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-cyan-300 bg-cyan-50 px-3.5 py-2 text-sm font-medium text-cyan-700 shadow-sm transition-all hover:bg-cyan-100 sm:w-auto' do %>
              <i data-lucide="download" class="h-4 w-4"></i>
              Importar desde global
            <% end %>
          <% end %>
          <%= link_to export_excel_productos_path,
                      class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-emerald-300 bg-white px-3.5 py-2 text-sm font-medium text-emerald-700 shadow-sm transition-all hover:bg-emerald-50 sm:w-auto' do %>
            <i data-lucide="file-spreadsheet" class="h-4 w-4"></i>
            Exportar inventario Excel
          <% end %>
          <%= link_to categorias_path,
                      class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50 sm:w-auto' do %>
            <i data-lucide="tag" class="h-4 w-4"></i>
            Categorias
          <% end %>
          <%= link_to profit_margin_presets_path,
                      class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50 sm:w-auto' do %>
            % Base de Ganancias
          <% end %>
          <%= link_to new_producto_path,
                      remote: true,
                      method: :get,
                      class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-lg shadow-slate-200 transition-all hover:bg-slate-800 active:scale-95 sm:w-auto',
                      data: { turbo_frame: 'modal-productos' },
                      onclick: "openModal('productModal')" do %>
            <i data-lucide="plus" class="h-4 w-4"></i>
            Agregar producto
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <% if @has_productos || @filters_applied %>
    <% if current_user_admin? %>
      <div class="grid gap-3 md:grid-cols-2">
        <article class="rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 to-white p-4 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700">Inventario total global</p>
          <p class="mt-2 text-2xl font-extrabold tracking-tight text-emerald-900"><%= format_money(@inventory_global_totals[:inventory_value_usd], unit: '$') %></p>
          <p class="mt-1 text-xs text-emerald-800/80">Suma absoluta de valor inventario de todos los productos en base de datos.</p>
        </article>
        <article class="rounded-2xl border border-sky-200 bg-gradient-to-br from-sky-50 to-white p-4 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-widest text-sky-700">Valor de venta total global</p>
          <p class="mt-2 text-2xl font-extrabold tracking-tight text-sky-900"><%= format_money(@inventory_global_totals[:sale_value_usd], unit: '$') %></p>
          <p class="mt-1 text-xs text-sky-800/80">Suma absoluta del valor de venta estimado de todo el inventario disponible.</p>
        </article>
      </div>
    <% end %>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <% active_filter_params = {} %>
      <% active_filter_params[:query_text] = @query_text if @query_text.present? %>
      <% active_filter_params[:low_stock] = 1 if @low_stock_filter %>
      <% active_filter_params[:below_target_margin] = 1 if @below_target_margin_filter %>
      <% active_filter_params[:catalog_hidden] = 1 if @catalog_hidden_filter %>
      <% active_filter_params[:global_supplier_id] = @selected_global_supplier_id if @selected_global_supplier_id.present? %>
      <div class="mb-4 rounded-2xl border border-slate-100 bg-slate-50/70 p-3">
        <div class="flex items-center justify-between gap-3">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Filtrar por categoria</p>
          <% if can_manage_products %>
            <%= link_to categorias_path,
                        class: 'inline-flex cursor-pointer items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50' do %>
              <i data-lucide="settings-2" class="h-3.5 w-3.5"></i>
              Gestionar
            <% end %>
          <% end %>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <% all_active = @selected_categoria_id.blank? %>
          <%= link_to productos_path(active_filter_params),
                      data: { products_ajax_link: true, products_category_link: true, products_category_chip: true, products_category_id: '' },
                      class: "inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-all #{all_active ? 'border-sky-300 bg-sky-100 text-sky-700 shadow-sm' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-100'}" do %>
            <span>Todas</span>
            <span class="rounded-full bg-white/80 px-2 py-0.5 text-[11px] font-bold text-slate-700"><%= @product_counts_by_categoria_id.values.sum %></span>
          <% end %>
          <% @categorias.each do |categoria| %>
            <% is_active = @selected_categoria_id == categoria.id %>
            <%= link_to productos_path(active_filter_params.merge(category_id: categoria.id)),
                        data: { products_ajax_link: true, products_category_link: true, products_category_chip: true, products_category_id: categoria.id },
                        class: "inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-all #{is_active ? 'border-cyan-300 bg-cyan-100 text-cyan-800 shadow-sm' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-100'}" do %>
              <span><%= categoria.nombre %></span>
              <span class="rounded-full bg-white/80 px-2 py-0.5 text-[11px] font-bold text-slate-700"><%= @product_counts_by_categoria_id[categoria.id].to_i %></span>
            <% end %>
          <% end %>
        </div>
      </div>
      <%= form_with url: productos_path, method: :get, local: true, class: 'grid gap-3 md:grid-cols-[minmax(0,18rem)_minmax(0,14rem)_minmax(0,14rem)_minmax(0,14rem)_minmax(0,16rem)_auto_auto] md:items-end md:justify-start', data: { products_search_form: true } do %>
        <%= hidden_field_tag :category_id, @selected_categoria_id if @selected_categoria_id.present? %>
        <div class="w-full md:w-[18rem]">
          <label for="products_query_text" class="block text-sm font-medium text-slate-700">Buscar producto</label>
          <div class="relative mt-1">
            <i data-lucide="search" class="pointer-events-none absolute left-3.5 top-3.5 h-4 w-4 text-slate-400"></i>
            <%= text_field_tag :query_text,
                               @query_text,
                               id: 'products_query_text',
                               autocomplete: 'off',
                               placeholder: 'Ej: lapiz, cuaderno, tinta...',
                               class: 'block w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                               data: { products_search_input: true } %>
          </div>
        </div>
        <div class="w-full md:w-[14rem]">
          <label for="products_low_stock" class="flex items-center gap-2 text-sm font-medium text-slate-700">
            <span>Filtro de stock</span>
            <span id="products-low-stock-badge">
              <%= render partial: 'productos/low_stock_badge', locals: { count: @low_stock_total_count } %>
            </span>
          </label>
          <%= select_tag :low_stock,
                         options_for_select([
                           ['Todos', '0'],
                           ['Productos con stock bajo', '1']
                         ], @low_stock_filter ? '1' : '0'),
                         id: 'products_low_stock',
                         class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                         data: { products_low_stock_input: true } %>
        </div>
        <div class="w-full md:w-[14rem]">
          <label for="products_below_target_margin" class="flex items-center gap-2 text-sm font-medium text-slate-700">
            <span>Filtro de precio objetivo</span>
            <span id="products-below-target-badge">
              <%= render partial: 'productos/below_target_badge', locals: { count: @below_target_margin_total_count } %>
            </span>
          </label>
          <%= select_tag :below_target_margin,
                         options_for_select([
                           ['Todos', '0'],
                           ['Por debajo del objetivo', '1']
                         ], @below_target_margin_filter ? '1' : '0'),
                         id: 'products_below_target_margin',
                         class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                         data: { products_below_target_margin_input: true } %>
        </div>
        <div class="w-full md:w-[14rem]">
          <label for="products_catalog_hidden" class="block text-sm font-medium text-slate-700">Catalogo publico</label>
          <%= select_tag :catalog_hidden,
                         options_for_select([
                           ['Todos', '0'],
                           ['Solo ocultos en catalogo', '1']
                         ], @catalog_hidden_filter ? '1' : '0'),
                         id: 'products_catalog_hidden',
                         class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                         data: { products_catalog_hidden_input: true } %>
        </div>
        <div class="w-full md:w-[16rem]">
          <label for="products_global_supplier_id" class="block text-sm font-medium text-slate-700">Proveedor global</label>
          <%= select_tag :global_supplier_id,
                         options_for_select([['Todos', '']] + @global_supplier_options, @selected_global_supplier_id),
                         id: 'products_global_supplier_id',
                         class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <button type="submit" data-products-submit="true" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-70">
          Buscar
        </button>
        <% hidden_catalog_button_params = {
             query_text: @query_text.presence,
             low_stock: (@low_stock_filter ? 1 : 0),
             below_target_margin: (@below_target_margin_filter ? 1 : 0),
             category_id: @selected_categoria_id.presence,
             global_supplier_id: @selected_global_supplier_id.presence,
             catalog_hidden: 1
           }.compact %>
        <%= link_to productos_path(hidden_catalog_button_params),
                    data: { products_ajax_link: true },
                    class: 'inline-flex cursor-pointer items-center justify-center rounded-xl border border-amber-300 bg-amber-50 px-4 py-2.5 text-sm font-semibold text-amber-800 shadow-sm transition-colors hover:bg-amber-100' do %>
          Ver ocultos catalogo
        <% end %>
        <% if @filters_applied %>
          <%= link_to productos_path, data: { products_ajax_link: true, products_clear_link: true }, class: 'inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 disabled:pointer-events-none disabled:opacity-60' do %>
            Limpiar
          <% end %>
        <% else %>
          <span></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <%= render partial: 'index_results' %>
  <div id="products-live-updates" class="hidden" aria-hidden="true"></div>
  <%= render partial: 'modal-productos' %>
</section>
<script>
  (() => {
    const DETAIL_ANIMATION_MS = 220;

    const findProductRoots = (scope) => {
      const roots = [];

      if (scope instanceof Element && scope.matches("[data-products-index='true']")) {
        roots.push(scope);
      }

      if (scope.querySelectorAll) {
        roots.push(...scope.querySelectorAll("[data-products-index='true']"));
      }

      return [...new Set(roots)];
    };

    const rowsToArray = (rows) => Array.from(rows || []);

    const stopRowAnimation = (row) => {
      if (!row || !row._productsAnimation) return;

      row._productsAnimation.cancel();
      row._productsAnimation = null;
      row.style.willChange = "";
    };

    const revealRows = (rows) => {
      rowsToArray(rows).forEach((row) => {
        stopRowAnimation(row);
        row.classList.remove("hidden");

        if (!("animate" in row)) return;

        row.style.willChange = "transform, opacity";
        const animation = row.animate(
          [
            { opacity: 0, transform: "translateY(-10px)" },
            { opacity: 1, transform: "translateY(0)" },
          ],
          {
            duration: DETAIL_ANIMATION_MS,
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          },
        );

        row._productsAnimation = animation;
        const clearAnimationState = () => {
          row.style.willChange = "";
          row._productsAnimation = null;
        };

        animation.onfinish = clearAnimationState;
        animation.oncancel = clearAnimationState;
      });
    };

    const hideRows = (rows) => Promise.all(
      rowsToArray(rows).map((row) => new Promise((resolve) => {
        if (row.classList.contains("hidden")) {
          resolve();
          return;
        }

        stopRowAnimation(row);

        if (!("animate" in row)) {
          row.classList.add("hidden");
          resolve();
          return;
        }

        row.style.willChange = "transform, opacity";
        const animation = row.animate(
          [
            { opacity: 1, transform: "translateY(0)" },
            { opacity: 0, transform: "translateY(-10px)" },
          ],
          {
            duration: DETAIL_ANIMATION_MS - 20,
            easing: "ease-in",
          },
        );

        row._productsAnimation = animation;
        const closeRow = () => {
          row.classList.add("hidden");
          row.style.willChange = "";
          row._productsAnimation = null;
          resolve();
        };

        animation.onfinish = closeRow;
        animation.oncancel = closeRow;
      })),
    );

    const toggleProductDetails = async (root, button) => {
      const productId = button.dataset.productId;
      if (!productId) return;

      const variationRows = rowsToArray(root.querySelectorAll(`.js-product-variation-row[data-product-detail-for="${productId}"]`));
      const lotRows = rowsToArray(root.querySelectorAll(`.js-product-lot-row[data-product-lot-for="${productId}"]`));
      const emptyRows = rowsToArray(root.querySelectorAll(`.js-product-empty-row[data-product-empty-for="${productId}"]`));

      const hasDetails = variationRows.length > 0 || emptyRows.length > 0;
      if (!hasDetails) return;

      const isClosed = variationRows.every((row) => row.classList.contains("hidden")) &&
        emptyRows.every((row) => row.classList.contains("hidden"));

      if (isClosed) {
        revealRows(variationRows);
        revealRows(emptyRows);
        await hideRows(lotRows);
      } else {
        await hideRows(variationRows);
        await hideRows(emptyRows);
        await hideRows(lotRows);
      }

      root.querySelectorAll(`.js-variation-toggle-row[data-product-id="${productId}"]`).forEach((variationButton) => {
        variationButton.dataset.open = "false";
        const icon = variationButton.querySelector(".js-variation-toggle-icon");
        if (icon) icon.classList.remove("rotate-90");
      });

      const icon = button.querySelector(".js-product-toggle-icon");
      if (icon) icon.classList.toggle("rotate-90", isClosed);
    };

    const toggleVariationLots = async (root, button) => {
      const productId = button.dataset.productId;
      const variationKey = button.dataset.variationKey;
      if (!productId || !variationKey) return;

      const allLotRows = rowsToArray(root.querySelectorAll(`.js-product-lot-row[data-product-lot-for="${productId}"]`));
      const targetLotRows = rowsToArray(root.querySelectorAll(`.js-product-lot-row[data-product-lot-for="${productId}"][data-variation-key="${variationKey}"]`));
      if (!targetLotRows.length) return;

      const shouldOpen = targetLotRows.every((row) => row.classList.contains("hidden"));

      await hideRows(allLotRows);
      if (shouldOpen) {
        revealRows(targetLotRows);
      }

      root.querySelectorAll(`.js-variation-toggle-row[data-product-id="${productId}"]`).forEach((variationButton) => {
        const isActive = shouldOpen && variationButton.dataset.variationKey === variationKey;
        variationButton.dataset.open = isActive ? "true" : "false";
        const icon = variationButton.querySelector(".js-variation-toggle-icon");
        if (icon) icon.classList.toggle("rotate-90", isActive);
      });
    };

    const bindSearchDebounce = (scope = document) => {
      const form = scope.querySelector("[data-products-search-form='true']");
      const input = scope.querySelector("[data-products-search-input='true']");
      const lowStockInput = scope.querySelector("[data-products-low-stock-input='true']");
      const belowTargetMarginInput = scope.querySelector(
        "[data-products-below-target-margin-input='true']",
      );
      const catalogHiddenInput = scope.querySelector("[data-products-catalog-hidden-input='true']");
      if (!form) return;

      const currentResultsContainer = () =>
        document.querySelector("[data-products-results='true']");

        const ensureCategoryInput = () => {
          let categoryInput = form.querySelector("input[name='category_id']");
          if (!categoryInput) {
            categoryInput = document.createElement("input");
            categoryInput.type = "hidden";
            categoryInput.name = "category_id";
            form.appendChild(categoryInput);
          }
          return categoryInput;
        };

        const setCategoryValue = (value) => {
          const normalized = String(value || "").trim();
          const categoryInput = form.querySelector("input[name='category_id']");

          if (!normalized) {
            categoryInput?.remove();
            return;
          }

          const targetInput = categoryInput || ensureCategoryInput();
          targetInput.value = normalized;
        };

        const updateCategoryChipState = (selectedCategoryId) => {
          const normalizedSelected = String(selectedCategoryId || "").trim();
          const chips = Array.from(document.querySelectorAll("a[data-products-category-chip='true']"));

          chips.forEach((chip) => {
            const chipCategoryId = String(chip.dataset.productsCategoryId || "").trim();
            const isAllChip = chipCategoryId === "";
            const isActive = normalizedSelected ? chipCategoryId === normalizedSelected : isAllChip;

            chip.classList.remove(
              "border-sky-300",
              "bg-sky-100",
              "text-sky-700",
              "border-cyan-300",
              "bg-cyan-100",
              "text-cyan-800",
              "border-slate-300",
              "bg-white",
              "text-slate-600",
              "hover:border-slate-400",
              "hover:bg-slate-100",
              "shadow-sm",
            );

            if (isAllChip) {
              if (isActive) {
                chip.classList.add("border-sky-300", "bg-sky-100", "text-sky-700", "shadow-sm");
              } else {
                chip.classList.add("border-slate-300", "bg-white", "text-slate-600", "hover:border-slate-400", "hover:bg-slate-100");
              }
              return;
            }

            if (isActive) {
              chip.classList.add("border-cyan-300", "bg-cyan-100", "text-cyan-800", "shadow-sm");
            } else {
              chip.classList.add("border-slate-300", "bg-white", "text-slate-600", "hover:border-slate-400", "hover:bg-slate-100");
            }
          });
        };

      const buildSearchUrl = () => {
        const url = new URL(form.action, window.location.origin);
        const formData = new FormData(form);

        formData.forEach((value, key) => {
          const normalizedValue = String(value || "").trim();
          if (normalizedValue === "" || normalizedValue === "0") return;
          url.searchParams.set(key, normalizedValue);
        });

        url.searchParams.set("format", "json");
        return url;
      };

      const setSearchLoadingState = (loading) => {
        const tableLoadingOverlay = document.querySelector("[data-products-table-loading='true']");
        const submitButton = form.querySelector("[data-products-submit='true']");
        const clearLink = form.querySelector("a[data-products-clear-link='true']");
        const resultsContainer = currentResultsContainer();

        form.dataset.productsSearchLoading = loading ? "true" : "false";
        if (tableLoadingOverlay) {
          tableLoadingOverlay.classList.toggle("hidden", !loading);
          tableLoadingOverlay.classList.toggle("flex", loading);
        }
        if (submitButton) submitButton.disabled = loading;
        if (lowStockInput) lowStockInput.disabled = loading;
        if (belowTargetMarginInput) belowTargetMarginInput.disabled = loading;

        if (clearLink) {
          clearLink.classList.toggle("pointer-events-none", loading);
          clearLink.classList.toggle("opacity-60", loading);
        }

        const categoryChips = Array.from(document.querySelectorAll("a[data-products-category-chip='true']"));
        categoryChips.forEach((chip) => {
          chip.classList.toggle("pointer-events-none", loading);
          chip.classList.toggle("opacity-70", loading);
        });

        if (resultsContainer) {
          resultsContainer.classList.toggle("transition-opacity", loading);
        }
      };

      const syncCurrentRootDataset = () => {
        const root = document.querySelector("[data-products-index='true']");
        if (!root) return;

        const queryValue = input ? String(input.value || "").trim() : "";
        const lowStockValue = lowStockInput ? String(lowStockInput.value || "0") === "1" : false;
        const belowTargetValue = belowTargetMarginInput ? String(belowTargetMarginInput.value || "0") === "1" : false;
        const categoryInput = form.querySelector("input[name='category_id']");

        root.dataset.productsQueryText = queryValue;
        root.dataset.productsLowStock = lowStockValue ? "true" : "false";
        root.dataset.productsBelowTargetMargin = belowTargetValue ? "true" : "false";
        root.dataset.productsCategoryId = String(categoryInput?.value || "").trim();
      };

      const submitSearch = async () => {
        const resultsContainer = currentResultsContainer();
        if (!resultsContainer) {
          form.requestSubmit();
          return;
        }

        if (form._productsSearchAbortController) {
          form._productsSearchAbortController.abort();
        }

        const url = buildSearchUrl();
        const abortController = new AbortController();
        form._productsSearchAbortController = abortController;
        setSearchLoadingState(true);
        syncCurrentRootDataset();

        try {
          const response = await fetch(url.toString(), {
            headers: {
              Accept: "application/json",
              "X-Requested-With": "XMLHttpRequest",
            },
            signal: abortController.signal,
          });

          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || "No se pudo actualizar la búsqueda.");

          if (typeof data.results_html === "string") {
            const liveResultsContainer = currentResultsContainer();
            if (liveResultsContainer && liveResultsContainer.parentNode) {
              const template = document.createElement("template");
              template.innerHTML = data.results_html.trim();
              const nextNode = template.content.firstElementChild;
              if (nextNode) {
                liveResultsContainer.replaceWith(nextNode);
              }
            }
          }

          const nextUrl = new URL(form.action, window.location.origin);
          const rawQuery = input ? String(input.value || "").trim() : "";
          const rawLowStock = lowStockInput ? String(lowStockInput.value || "0") : "0";
          const rawBelowTarget = belowTargetMarginInput ? String(belowTargetMarginInput.value || "0") : "0";
          const rawCategory = String(form.querySelector("input[name='category_id']")?.value || "").trim();

          if (rawQuery) nextUrl.searchParams.set("query_text", rawQuery);
          if (rawLowStock === "1") nextUrl.searchParams.set("low_stock", "1");
          if (rawBelowTarget === "1") nextUrl.searchParams.set("below_target_margin", "1");
          if (rawCategory) nextUrl.searchParams.set("category_id", rawCategory);

          window.history.replaceState({}, "", nextUrl.toString());

          initProductsInfiniteScroll(document);
          if (window.lucide) window.lucide.createIcons();
        } catch (error) {
          if (error.name === "AbortError") return;
          if (window.console && typeof window.console.error === "function") {
            window.console.error("Error actualizando productos por AJAX", error);
          }
        } finally {
          if (form._productsSearchAbortController === abortController) {
            form._productsSearchAbortController = null;
            setSearchLoadingState(false);
          }
        }
      };

      if (form.dataset.ajaxLinksBound !== "true") {
        form.dataset.ajaxLinksBound = "true";
        const searchArea = form.closest("#tab-productos") || document;

        searchArea.addEventListener("click", (event) => {
          const link = event.target.closest("a[data-products-ajax-link='true']");
          if (!link) return;

          const href = link.getAttribute("href");
          if (!href) return;

          const normalizePath = (path) => {
            const normalized = String(path || "").replace(/\/+$/, "");
            return normalized.length > 0 ? normalized : "/";
          };

          const currentPath = normalizePath(new URL(form.action, window.location.origin).pathname);
          const targetUrl = new URL(href, window.location.origin);
          if (normalizePath(targetUrl.pathname) !== currentPath) return;

          event.preventDefault();

          const nextQuery = targetUrl.searchParams.get("query_text") || "";
          const nextLowStock = targetUrl.searchParams.get("low_stock") === "1" ? "1" : "0";
          const nextBelowTarget = targetUrl.searchParams.get("below_target_margin") === "1" ? "1" : "0";
          const nextCatalogHidden = targetUrl.searchParams.get("catalog_hidden") === "1" ? "1" : "0";
          const nextCategoryId = targetUrl.searchParams.get("category_id") || "";

          if (input) input.value = nextQuery;
          if (lowStockInput) lowStockInput.value = nextLowStock;
          if (belowTargetMarginInput) belowTargetMarginInput.value = nextBelowTarget;
          if (catalogHiddenInput) catalogHiddenInput.value = nextCatalogHidden;
          setCategoryValue(nextCategoryId);
          updateCategoryChipState(nextCategoryId);

          void submitSearch();
        });
      }

      updateCategoryChipState(String(form.querySelector("input[name='category_id']")?.value || "").trim());

      if (form.dataset.ajaxSubmitBound !== "true") {
        form.dataset.ajaxSubmitBound = "true";
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          void submitSearch();
        });
      }

      if (input && input.dataset.debounceBound !== "true") {
        input.dataset.debounceBound = "true";
        let timer = null;

        input.addEventListener("input", () => {
          if (timer) clearTimeout(timer);

          timer = setTimeout(() => {
            void submitSearch();
          }, 350);
        });
      }

      if (lowStockInput && lowStockInput.dataset.changeBound !== "true") {
        lowStockInput.dataset.changeBound = "true";
        lowStockInput.addEventListener("change", () => {
          void submitSearch();
        });
      }

      if (
        belowTargetMarginInput &&
        belowTargetMarginInput.dataset.changeBound !== "true"
      ) {
        belowTargetMarginInput.dataset.changeBound = "true";
        belowTargetMarginInput.addEventListener("change", () => {
          void submitSearch();
        });
      }

      if (catalogHiddenInput && catalogHiddenInput.dataset.changeBound !== "true") {
        catalogHiddenInput.dataset.changeBound = "true";
        catalogHiddenInput.addEventListener("change", () => {
          void submitSearch();
        });
      }
    };

    const bindLiveProductRowUpdates = () => {
      const updatesContainer = document.getElementById("products-live-updates");
      const tableBody = document.getElementById("productos_tbody");
      if (!updatesContainer || !tableBody) return;
      if (updatesContainer.dataset.liveUpdatesBound === "true") return;
      updatesContainer.dataset.liveUpdatesBound = "true";

      const replaceProductRows = (productId, rowsHtml) => {
        if (!productId) return;

        const selectors = [
          `tr[data-product-row-id="${productId}"]`,
          `tr[data-product-detail-for="${productId}"]`,
          `tr[data-product-lot-for="${productId}"]`,
          `tr[data-product-empty-for="${productId}"]`,
        ];

        const oldRows = Array.from(tableBody.querySelectorAll(selectors.join(",")));
        if (!oldRows.length) return;

        const nextSibling = oldRows[oldRows.length - 1].nextSibling;
        oldRows.forEach((row) => stopRowAnimation(row));
        oldRows.forEach((row) => row.remove());

        const parser = document.createElement("template");
  parser.innerHTML = (rowsHtml || "").trim();
        const newRows = Array.from(parser.content.querySelectorAll("tr"));
        if (!newRows.length) return;

        const fragment = document.createDocumentFragment();
        newRows.forEach((row) => fragment.appendChild(row));

        if (nextSibling && nextSibling.parentNode === tableBody) {
          tableBody.insertBefore(fragment, nextSibling);
        } else {
          tableBody.appendChild(fragment);
        }

        if (window.lucide) window.lucide.createIcons();
      };

      const processPayload = (node) => {
        if (!(node instanceof Element)) return;

        const payload = node.matches("[data-product-row-update='true']")
          ? node
          : node.querySelector("[data-product-row-update='true']");
        if (!payload) return;

        const productId = payload.dataset.productId;
        const templateNode = payload.querySelector("template[data-product-row-update-html]");
        const rowsHtml = templateNode ? templateNode.innerHTML : "";
        replaceProductRows(productId, rowsHtml);
        payload.remove();
      };

      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          mutation.addedNodes.forEach((node) => processPayload(node));
        });
      });

      observer.observe(updatesContainer, { childList: true });
      updatesContainer.querySelectorAll("[data-product-row-update='true']").forEach((node) => processPayload(node));

      document.addEventListener(
        "turbo:before-cache",
        () => {
          observer.disconnect();
        },
        { once: true },
      );
    };

    const initProductsInfiniteScroll = (scope = document) => {
      bindLiveProductRowUpdates();

      findProductRoots(scope).forEach((root) => {
        if (root.dataset.productsBound === "true") return;
        root.dataset.productsBound = "true";

        const tableBody = root.querySelector("#productos_tbody");
        const loadedCountNode = document.querySelector("[data-products-loaded-count='true']");
        let observer = null;
        let loading = false;

        root.addEventListener("click", (event) => {
          const productButton = event.target.closest(".js-product-toggle-row");
          if (productButton) {
            void toggleProductDetails(root, productButton);
            return;
          }

          const variationButton = event.target.closest(".js-variation-toggle-row");
          if (variationButton) {
            void toggleVariationLots(root, variationButton);
            return;
          }

          const retryButton = event.target.closest("[data-products-retry='true']");
          if (!retryButton) return;

          const pagination = retryButton.closest("[data-products-pagination='true']");
          if (!pagination) return;

          pagination.innerHTML = `
            <div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm text-slate-500 shadow-sm">
              <span class="h-2 w-2 animate-pulse rounded-full bg-sky-400"></span>
              <span data-products-pagination-text="true">Cargando más productos...</span>
            </div>
          `;

          loadPage(pagination);
        });

        const buildUrl = (page) => {
          const url = new URL(root.dataset.productsUrl, window.location.origin);

          if (root.dataset.productsQueryText) {
            url.searchParams.set("query_text", root.dataset.productsQueryText);
          }

          if (root.dataset.productsLowStock === "true") {
            url.searchParams.set("low_stock", "1");
          }

          if (root.dataset.productsBelowTargetMargin === "true") {
            url.searchParams.set("below_target_margin", "1");
          }

          if (root.dataset.productsCategoryId) {
            url.searchParams.set("category_id", root.dataset.productsCategoryId);
          }

          url.searchParams.set("page", String(page));
          url.searchParams.set("format", "json");
          return url.toString();
        };

        const disconnectObserver = () => {
          if (observer) {
            observer.disconnect();
            observer = null;
          }
        };

        const setRetryState = (pagination) => {
          pagination.innerHTML = `
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 cursor-pointer"
              data-products-retry="true"
            >
              Reintentar carga
            </button>
          `;
        };

        const bindPagination = (pagination) => {
          if (!pagination) return;

          disconnectObserver();

          if (!("IntersectionObserver" in window)) {
            setRetryState(pagination);
            return;
          }

          observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                disconnectObserver();
                loadPage(pagination);
              });
            },
            { rootMargin: "220px 0px" },
          );

          observer.observe(pagination);
        };

        const loadPage = async (pagination) => {
          const nextPage = Number(pagination.dataset.nextPage || 0);
          if (!nextPage || loading) return;

          loading = true;
          const messageNode = pagination.querySelector("[data-products-pagination-text='true']");
          if (messageNode) messageNode.textContent = "Cargando más productos...";

          try {
            const response = await fetch(buildUrl(nextPage), {
              headers: {
                Accept: "application/json",
                "X-Requested-With": "XMLHttpRequest",
              },
            });

            const data = await response.json();
            if (!response.ok) throw new Error(data.error || "No se pudo cargar la siguiente página");

            if (data.table_rows_html && tableBody) {
              tableBody.insertAdjacentHTML("beforeend", data.table_rows_html);
              if (window.lucide) window.lucide.createIcons();
            }

            if (loadedCountNode) {
              const currentValue = Number(loadedCountNode.textContent || 0);
              loadedCountNode.textContent = String(currentValue + Number(data.batch_count || 0));
            }

            if (data.next_page) {
              pagination.dataset.nextPage = String(data.next_page);

              if (messageNode) {
                messageNode.textContent = "Desplázate para cargar más";
              }

              bindPagination(pagination);
            } else {
              pagination.remove();
            }
          } catch (_error) {
            setRetryState(pagination);
          } finally {
            loading = false;
          }
        };

        bindPagination(root.querySelector("[data-products-pagination='true']"));

        document.addEventListener(
          "turbo:before-cache",
          () => {
            disconnectObserver();
          },
          { once: true },
        );
      });

      bindSearchDebounce(scope instanceof Element ? scope : document);
    };

    document.addEventListener("turbo:load", () => initProductsInfiniteScroll(document));
    document.addEventListener("DOMContentLoaded", () => initProductsInfiniteScroll(document));
    document.addEventListener("turbo:render", () => initProductsInfiniteScroll(document));
    document.addEventListener("turbo:frame-load", (event) => initProductsInfiniteScroll(event.target));
  })();
</script>