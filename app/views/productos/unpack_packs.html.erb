<section class="space-y-6">
  <div class="rounded-3xl border border-amber-100 bg-gradient-to-r from-amber-50 via-white to-orange-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Destapar Pack</h1>
        <p class="mt-1 text-sm text-slate-500">Convierte packs en unidades con control por variación y costo.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to unpack_histories_productos_path, class: 'inline-flex items-center justify-center rounded-xl border border-cyan-200 bg-cyan-50 px-4 py-2.5 text-sm font-semibold text-cyan-700 shadow-sm transition-colors hover:bg-cyan-100' do %>
          Historial
        <% end %>
        <%= link_to productos_path, class: 'inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800' do %>
          Volver
        <% end %>
      </div>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: unpack_packs_productos_path, method: :get, local: true, class: 'flex flex-wrap items-end gap-3' do %>
      <div class="w-[16rem]">
        <label for="unpack_query_text" class="block text-sm font-medium text-slate-700">Buscar pack</label>
        <input id="unpack_query_text" name="query_text" value="<%= @query_text %>" autocomplete="off" placeholder="Ej: papel, libreta..." class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-amber-500 focus:ring-amber-500" />
      </div>
      <button type="submit" class="inline-flex w-auto items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">Buscar</button>
      <%= link_to unpack_packs_productos_path, class: 'inline-flex w-auto items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
        Limpiar
      <% end %>
    <% end %>
  </div>
  <% if @pack_products.any? %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" id="unpack-pack-grid">
      <% @pack_products.each do |producto| %>
        <% total_stock = producto.total_quantity.to_d %>
        <% stock_badge_class = if total_stock <= 0
                                 'bg-rose-100 text-rose-700 ring-1 ring-rose-200'
                               elsif total_stock < 6
                                 'bg-amber-100 text-amber-700 ring-1 ring-amber-200'
                               else
                                 'bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200'
                               end %>
        <article class="group relative overflow-hidden rounded-3xl border border-amber-100 bg-white p-3 shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-amber-100/60 <%= total_stock.positive? ? 'cursor-pointer' : 'cursor-not-allowed opacity-70' %>"
                 data-pack-card="true"
                 data-pack-id="<%= producto.id %>">
          <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-r from-amber-100/70 via-orange-50/60 to-white/0"></div>
          <div class="relative">
            <span class="absolute left-2 top-2 inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-bold <%= stock_badge_class %>">
              <%= format_quantity(total_stock, precision: 0) %>
            </span>
            <div class="mt-8 aspect-square overflow-hidden rounded-2xl border border-white/80 bg-slate-50 flex items-center justify-center text-slate-300">
              <% if producto.foto.attached? %>
                <%= image_tag producto.foto, class: 'h-full w-full object-cover', alt: producto.display_name_with_presentation %>
              <% else %>
                <i data-lucide="package-open" class="w-12 h-12"></i>
              <% end %>
            </div>
            <div class="mt-3 px-1">
              <h3 class="truncate text-sm font-bold text-slate-800"><%= producto.display_name_with_presentation %></h3>
              <p class="mt-1 text-xs text-slate-500"><%= producto.product_variations.size %> variación(es)</p>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">Sin productos pack disponibles</h3>
      <p class="mt-1 text-sm text-slate-500">No se encontraron productos con presentación pack para destapar.</p>
    </div>
  <% end %>
</section>
<script type="application/json" id="unpack-pack-products-data">
  <%= raw ERB::Util.json_escape(@pack_products_payload.to_json) %>
</script>
<script>
  (() => {
    const initUnpackPackModal = () => {
      const dataEl = document.getElementById('unpack-pack-products-data');
      const grid = document.getElementById('unpack-pack-grid');
      if (!dataEl || !grid) return;
      if (grid.dataset.unpackModalBound === 'true') return;
      grid.dataset.unpackModalBound = 'true';

      let packs = [];
      try {
        packs = JSON.parse(dataEl.textContent || '[]');
      } catch (_error) {
        packs = [];
      }

      const packsById = new Map(Array.from(packs).map((row) => [String(row.id), row]));

      const formatQty = (value) => Number(value || 0).toLocaleString('es-VE', {
        minimumFractionDigits: 0,
        maximumFractionDigits: 2,
      });

      const openVariationModal = async (pack) => {
        if (!pack) return;
        const swal = window.Swal;
        if (!swal) {
          window.alert('No se pudo abrir el modal en este momento. Intenta nuevamente.');
          return;
        }

        const rows = Array.isArray(pack.variations) ? pack.variations : [];
        if (rows.length === 0) {
          await swal.fire({ icon: 'info', title: 'Sin variaciones', text: 'Este pack no tiene variaciones disponibles.', heightAuto: false });
          return;
        }

      const html = `
        <div class="space-y-2 text-left">
          <p class="text-sm text-slate-600">Selecciona cuántos packs deseas destapar por variación.</p>
          <div class="space-y-2 max-h-72 overflow-y-auto pr-1">
            ${rows.map((row) => {
              const available = Number(row.available || 0);
              return `
                <div class="rounded-xl border border-slate-200 bg-white px-3 py-2.5" data-variation-row="${row.id}">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-semibold text-slate-700">${String(row.name || 'Variación')}</p>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">Disp: ${formatQty(available)}</span>
                  </div>
                  <input type="number" min="0" step="1" max="${available}" value="" placeholder="Cantidad de packs" class="mt-2 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" data-variation-input="${row.id}" ${available <= 0 ? 'disabled' : ''}>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;

      const result = await swal.fire({
        title: pack.name || 'Destapar pack',
        html,
        showCancelButton: true,
        confirmButtonText: 'Continuar',
        cancelButtonText: 'Cancelar',
        heightAuto: false,
        preConfirm: () => {
          const dialog = swal.getHtmlContainer();
          if (!dialog) return null;

          const selections = [];
          rows.forEach((row) => {
            const input = dialog.querySelector(`[data-variation-input="${row.id}"]`);
            if (!input) return;
            const available = Number(row.available || 0);
            let packsQty = Number.parseInt(String(input.value || '0'), 10);
            if (!Number.isFinite(packsQty) || packsQty < 0) packsQty = 0;
            if (packsQty > available) packsQty = Math.floor(available);
            if (packsQty <= 0) return;
            selections.push({ variation_id: row.id, packs: packsQty, units: packsQty * Number(pack.cant_presentation || 1) });
          });

          if (selections.length === 0) {
            swal.showValidationMessage('Debes indicar al menos una variación con packs a destapar.');
            return null;
          }

          return selections;
        },
      });

      if (!result.isConfirmed) return;

      const selectedRows = Array.isArray(result.value) ? result.value : [];
      const totalUnits = selectedRows.reduce((sum, row) => sum + Number(row.units || 0), 0);
      const summaryHtml = `
        <div class="space-y-2 text-left">
          <p class="text-sm text-slate-600">Resumen del desempaque:</p>
          <ul class="space-y-1 text-sm text-slate-700">
            ${selectedRows.map((row) => {
              const variation = rows.find((entry) => String(entry.id) === String(row.variation_id));
              return `<li><strong>${variation?.name || 'Variación'}</strong>: ${formatQty(row.packs)} pack(s) => ${formatQty(row.units)} unidad(es)</li>`;
            }).join('')}
          </ul>
          <p class="pt-1 text-sm font-bold text-emerald-700">Total de unidades resultantes: ${formatQty(totalUnits)}</p>
        </div>
      `;

      const confirm = await swal.fire({
        icon: 'question',
        title: 'Confirmar desempaque',
        html: summaryHtml,
        showCancelButton: true,
        confirmButtonText: 'Destapar ahora',
        cancelButtonText: 'Volver',
        heightAuto: false,
      });

      if (!confirm.isConfirmed) return;

      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '<%= process_unpack_productos_path %>';

      const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
      if (csrf) {
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'authenticity_token';
        csrfInput.value = csrf;
        form.appendChild(csrfInput);
      }

      const productInput = document.createElement('input');
      productInput.type = 'hidden';
      productInput.name = 'product_id';
      productInput.value = pack.id;
      form.appendChild(productInput);

      selectedRows.forEach((row, index) => {
        const variationInput = document.createElement('input');
        variationInput.type = 'hidden';
        variationInput.name = `rows[${index}][variation_id]`;
        variationInput.value = row.variation_id;
        form.appendChild(variationInput);

        const packsInput = document.createElement('input');
        packsInput.type = 'hidden';
        packsInput.name = `rows[${index}][packs]`;
        packsInput.value = row.packs;
        form.appendChild(packsInput);
      });

      document.body.appendChild(form);
      form.submit();
      };

      grid.addEventListener('click', async (event) => {
        const card = event.target.closest('[data-pack-card="true"]');
        if (!card) return;
        const packId = String(card.dataset.packId || '');
        const pack = packsById.get(packId);
        if (!pack) return;

        const swal = window.Swal;
        if (!(Number(pack.total_stock || 0) > 0)) {
          if (swal) {
            await swal.fire({ icon: 'warning', title: 'Sin stock', text: 'Este pack no tiene stock disponible.', heightAuto: false });
          } else {
            window.alert('Este pack no tiene stock disponible.');
          }
          return;
        }
        await openVariationModal(pack);
      });
    };

    document.addEventListener('DOMContentLoaded', initUnpackPackModal);
    document.addEventListener('turbo:load', initUnpackPackModal);
    document.addEventListener('turbo:render', initUnpackPackModal);
    initUnpackPackModal();
  })();
</script>
