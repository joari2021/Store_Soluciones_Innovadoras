<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Importar desde catalogo global</h1>
        <p class="mt-1 text-sm text-slate-500">Crea productos locales en este negocio usando datos del catalogo global.</p>
      </div>
      <%= link_to productos_path, class: "inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
        Volver a productos
      <% end %>
    </div>
  </div>
  <% if @global_products.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full table-auto text-sm text-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-4 text-left font-bold">Producto global</th>
            <th class="px-6 py-4 text-left font-bold">Presentacion</th>
            <th class="px-6 py-4 text-left font-bold">Categoria global</th>
            <th class="px-6 py-4 text-left font-bold">Origen</th>
            <th class="px-6 py-4 text-right font-bold">Accion</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @global_products.each_with_index do |global_product, index| %>
            <% already_imported = current_business.productos.exists?(global_product_id: global_product.id) %>
            <% presentation_label = global_product.presentation.to_s == 'pack' ? "Pack (#{global_product.cant_presentation} unid)" : 'Unidad' %>
            <tr class="<%= index.even? ? 'bg-white' : 'bg-slate-50/50' %>">
              <td class="px-6 py-4 font-semibold text-slate-800"><%= global_product.name %></td>
              <td class="px-6 py-4"><%= presentation_label %></td>
              <td class="px-6 py-4"><%= global_product.category_name.presence || '-' %></td>
              <td class="px-6 py-4 text-slate-600"><%= global_product.source_business&.name || '-' %></td>
              <td class="px-6 py-4 text-right">
                <% if already_imported %>
                  <span class="inline-flex items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">
                    Ya importado
                  </span>
                <% else %>
                  <%= button_to 'Importar',
                                create_from_global_productos_path,
                                method: :post,
                                params: { global_product_id: global_product.id },
                                class: 'inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No hay productos globales disponibles</h3>
      <p class="mt-1 text-sm text-slate-500">Crea productos en catalogo global para poder importarlos aqui.</p>
    </div>
  <% end %>
</div>
