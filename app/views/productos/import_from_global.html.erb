<div class="space-y-6 fade-in"
  data-controller="global-import-selection"
  data-global-import-selection-hidden-class-value="hidden"
  data-global-import-selection-selected-ids-value="<%= @selected_global_product_ids.to_json %>">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Importar desde catalogo global</h1>
        <p class="mt-1 text-sm text-slate-500">Crea productos locales en este negocio usando datos del catalogo global.</p>
      </div>
      <%= link_to productos_path, class: "inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
        Volver a productos
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <%= form_with url: import_from_global_productos_path,
                  method: :get,
                  local: true,
                  class: 'grid gap-3 md:grid-cols-[minmax(0,20rem)_auto_auto] md:items-end md:justify-start',
                  data: { global_import_selection_target: 'searchForm' } do %>
      <div data-global-import-selection-target="searchHiddenInputs"></div>
      <div class="w-full md:w-[20rem]">
        <label for="import_global_products_query_text" class="block text-sm font-medium text-slate-700">Buscar producto global</label>
        <div class="relative mt-1">
          <i data-lucide="search" class="pointer-events-none absolute left-3.5 top-3.5 h-4 w-4 text-slate-400"></i>
          <%= text_field_tag :query_text,
                             @query_text,
                             id: 'import_global_products_query_text',
                             autocomplete: 'off',
                             placeholder: 'Ej: adaptador, bolígrafo, huellero...',
                             class: 'block w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
      </div>
      <button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">
        Buscar
      </button>
      <% if @query_text.present? %>
        <%= link_to import_from_global_productos_path, class: 'inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
          Limpiar
        <% end %>
      <% else %>
        <span></span>
      <% end %>
    <% end %>
  </div>
  <%= form_with url: create_from_global_productos_path,
                method: :post,
                local: true,
                data: { global_import_selection_target: 'importForm' } do %>
    <div data-global-import-selection-target="importHiddenInputs"></div>
    <div class="mb-3 hidden items-center justify-between rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800"
         data-global-import-selection-target="toolbar">
      <span>
        Seleccionados:
        <strong data-global-import-selection-target="count">0</strong>
      </span>
      <button type="submit"
              class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800"
              data-global-import-selection-target="submitButton">
        Importar seleccionados
      </button>
    </div>

    <% if @global_products.any? %>
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full table-auto text-sm text-slate-700">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-4 text-center font-bold">Seleccionar</th>
              <th class="px-6 py-4 text-left font-bold">Imagen</th>
              <th class="px-6 py-4 text-left font-bold">Descripcion</th>
              <th class="px-6 py-4 text-left font-bold">Presentacion</th>
              <th class="px-6 py-4 text-left font-bold">Categoria global</th>
              <th class="px-6 py-4 text-left font-bold">Origen</th>
              <th class="px-6 py-4 text-right font-bold">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @global_products.each_with_index do |global_product, index| %>
              <% already_imported = @imported_global_product_ids.include?(global_product.id) %>
              <% presentation_label = global_product.presentation.to_s == 'pack' ? "Pack (#{global_product.cant_presentation} unid)" : 'Unidad' %>
              <tr class="<%= index.even? ? 'bg-white' : 'bg-slate-50/50' %>">
                <td class="px-6 py-4 text-center">
                  <% if already_imported %>
                    <span class="text-xs font-semibold text-slate-400">-</span>
                  <% else %>
                    <input type="checkbox"
                         name="global_product_ids[]"
                         value="<%= global_product.id %>"
                      <%= 'checked' if @selected_global_product_ids.include?(global_product.id) %>
                         class="h-4 w-4 cursor-pointer rounded border-slate-300 text-slate-900 focus:ring-slate-400"
                      data-global-product-id="<%= global_product.id %>"
                         data-action="change->global-import-selection#toggle"
                    data-global-import-selection-target="checkbox">
                  <% end %>
                </td>
                <td class="px-6 py-4">
                  <div class="h-10 w-10 overflow-hidden rounded-lg border border-slate-200 bg-slate-50">
                    <% if global_product.image.attached? %>
                      <%= image_tag global_product.image, class: 'h-full w-full object-cover', alt: global_product.name %>
                    <% else %>
                      <%= image_tag 'default_image.jpeg', class: 'h-full w-full object-cover', alt: global_product.name %>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 font-semibold text-slate-800"><%= global_product.name %></td>
                <td class="px-6 py-4"><%= presentation_label %></td>
                <td class="px-6 py-4"><%= global_product.category_name.presence || '-' %></td>
                <td class="px-6 py-4 text-slate-600"><%= global_product.source_business&.name || '-' %></td>
                <td class="px-6 py-4 text-right">
                  <% if already_imported %>
                    <span class="inline-flex items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">
                      Ya importado
                    </span>
                  <% else %>
                    <span class="inline-flex items-center justify-center rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700">
                      Disponible
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
        <h3 class="text-base font-semibold text-slate-700"><%= @query_text.present? ? 'No se encontraron productos globales' : 'No hay productos globales disponibles' %></h3>
        <p class="mt-1 text-sm text-slate-500"><%= @query_text.present? ? 'Prueba con otro texto de búsqueda.' : 'Crea productos en catalogo global para poder importarlos aqui.' %></p>
      </div>
    <% end %>
  <% end %>
</div>
