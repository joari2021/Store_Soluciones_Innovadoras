<script>
  tasaDolar = <%= @tasa_dolar_bcv || 0 %>
</script>
<%= form_with(model: producto, data: { controller: "form-producto" }, html: { class: "row g-3" }) do |form| %>
  <% if producto.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(producto.errors.count, "error") %> prohibited this producto from being saved:</h2>
      <ul>
        <% producto.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="col-md-5">
    <%= form.label :foto, class:"form-label" %>
    <%= form.file_field :foto, class:"form-control" %>
  </div>
  <div class="col-md-7">
    <%= form.label :descripcion, class: "form-label" %>
    <%= form.text_field :descripcion, class:"form-control", required: true %>
  </div>
  <hr>
  <div class="col-md-2">
    <%= form.label :precio_costo, "Costo Pack ($)", class: "form-label" %>
    <%= form.text_field :precio_costo, class:"form-control", required: true %>
  </div>
  <div class="col-md-3">
    <label class="form-label">Costo Pack Bs</label>
    <input type="text" value="" id="precio_c_bs" class="form-control" readonly>
  </div>
  <div class="col-md-2">
    <%= form.label :cant_unidades, class: "form-label" %>
    <%= form.text_field :cant_unidades, class:"form-control", required: true %>
  </div>
  <div class="col-md-2">
    <label class="form-label">Costo Unidad $</label>
    <input type="text" value="" id="costo_u_usd" class="form-control" readonly>
  </div>
  <div class="col-md-3">
    <label class="form-label">Costo Unidad Bs</label>
    <input type="text" value="" id="costo_u_bs" class="form-control" readonly>
  </div>
  <hr>
  <div class="col-md-3">
    <%= form.label :nivel_ganancia, "Nivel de Ganancia", class: "form-label" %>
    <%= form.select :nivel_ganancia, 
                  options_for_select([["Baja", "Baja"], ["Media", "Media"], ["Alta", "Alta"]], selected: producto.nivel_ganancia), 
                  {}, 
                  { class: "form-select" } %>
  </div>
  <div class="col-md-3">
    <%= form.label :moneda_base_precio, "Moneda Base Precio Venta", class: "form-label" %>
    <%= form.select :moneda_base_precio, 
                  options_for_select([["Bolivar", "Bolivar"], ["Dolar", "Dolar"]], selected: producto.moneda_base_precio), 
                  {}, 
                  { class: "form-select", id: "moneda_precio" } %>
  </div>
  <div class="col-md-3">
    <%= form.label :min_stock, "Min. Stock", class:"form-label" %>
    <%= form.text_field :min_stock, class:"form-control" %>
  </div>
  <div class="col-md-3">
    <%= form.label :max_stock, "Max. Stock", class:"form-label" %>
    <%= form.text_field :max_stock, class:"form-control" %>
  </div>
  <hr>
  <div class="col-md-3">
    <label class="form-label">Precio Sugerido $</label>
    <input type="text" value="" id="precio_sugerido_usd" class="form-control" readonly>
  </div>
  <div class="col-md-3">
    <label class="form-label">Precio Sugerido Bs</label>
    <input type="text" value="" id="precio_sugerido_bs" class="form-control" readonly>
  </div>
  <%if producto.moneda_base_precio === "Dolar"%>
    <script>
      calcularPrecioVentaBs()
    </script>
  <%else%>
    <script>
      calcularPrecioVentaUSD()
    </script>
  <%end%>
  <div class="col-md-3">
    <%= form.label :precio_venta_usd, "Precio Venta ($)", class:"form-label" %>
    <%= form.text_field :precio_venta_usd, class:"form-control" %>
  </div>
  <div class="col-md-3">
    <%= form.label :precio_venta_bs, "Precio Venta (Bs)", class:"form-label" %>
    <%= form.text_field :precio_venta_bs, class:"form-control" %>
  </div>
  <hr>
  <div>
    <%= form.submit "Guardar", class: "btn btn-success mt-3"%>
  </div>
<% end %>
