<%= form_with(model: producto, data: { controller: "form-producto", 'form-producto-tasa-dolar-value' => (@tasa_dolar_bcv || 0), 'form-producto-persisted-value' => producto.persisted? }, html: { class: "space-y-4" }) do |form| %>
  <% query_text_value = params[:query_text].to_s.strip %>
  <% category_id_value = params[:category_id].to_s.strip %>
  <% low_stock_filter_active = ActiveModel::Type::Boolean.new.cast(params[:low_stock]) %>
  <% below_target_margin_filter_active = ActiveModel::Type::Boolean.new.cast(params[:below_target_margin]) %>
  <% catalog_hidden_filter_active = ActiveModel::Type::Boolean.new.cast(params[:catalog_hidden]) %>
  <%= hidden_field_tag :query_text, query_text_value if query_text_value.present? %>
  <%= hidden_field_tag :category_id, category_id_value if category_id_value.present? %>
  <%= hidden_field_tag :low_stock, '1' if low_stock_filter_active %>
  <%= hidden_field_tag :below_target_margin, '1' if below_target_margin_filter_active %>
  <%= hidden_field_tag :catalog_hidden, '1' if catalog_hidden_filter_active %>
  <% locked_by_global = producto.global_product_id.present? %>
  <% locked_hint = 'Este campo se edita en Productos Globales.' %>
  <% locked_field_class = 'cursor-not-allowed bg-slate-100 border-red-200 text-slate-500' %>
  <% locked_inline_style = 'cursor: not-allowed;' %>
  <% normal_field_class = 'w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:border-sky-400 focus:outline-none transition-all' %>
  <% if producto.errors.any? %>
    <div id="form-errors" class="alert alert-danger rounded-xl p-4 mb-3 shadow-sm border border-danger" style="background: #fee2e2; color: #b91c1c;">
      <h4 class="text-base font-bold mb-2"><%= pluralize(producto.errors.count, "error") %> impidieron guardar el producto:</h4>
      <ul class="list-disc pl-5 text-sm">
        <% producto.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% if locked_by_global %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-700">
      ⛔ Campos maestros bloqueados en local. Debes editarlos desde Productos Globales.
    </div>
  <% end %>
  <div class="flex flex-col items-center justify-center mb-2">
    <div class="relative" style="width: 140px; height: 140px;">
      <% image_url = begin
        if producto.foto.attached?
          # Avoid calling url_for when the blob or record is not persisted (signed_id error)
          if producto.foto.respond_to?(:blob) && producto.foto.blob && producto.foto.blob.persisted?
            url_for(producto.foto)
          elsif producto.persisted?
            url_for(producto.foto)
          else
            asset_path('default_image.jpeg')
          end
        else
          asset_path('default_image.jpeg')
        end
      rescue ArgumentError
        asset_path('default_image.jpeg')
      end %>
      <img id="preview-foto" src="<%= image_url %>" alt="Foto del producto" style="width: 140px; height: 140px; object-fit: cover; border-radius: 50%; border: 2px solid #e2e8f0; background: #f8fafc;">
      <label for="producto_foto" class="absolute" title="<%= locked_by_global ? locked_hint : 'Cambiar foto' %>" style="bottom: 0; right: 0; background: <%= locked_by_global ? '#ef4444' : '#0ea5e9' %>; border-radius: 50%; padding: 10px; cursor: <%= locked_by_global ? 'not-allowed' : 'pointer' %>; opacity: <%= locked_by_global ? '0.7' : '1' %>;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 24 24">
          <path d="M3 17.25V21h3.75l11.06-11.06-3.75-3.75L3 17.25zm17.71-10.04a1.003 1.003 0 0 0 0-1.42l-2.5-2.5a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
        </svg>
      </label>
      <%= form.file_field :foto, class: "hidden", id: "producto_foto", accept: "image/*", onchange: "previewFoto(event)", disabled: locked_by_global %>
    </div>
    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mt-2">Foto</div>
  </div>
  <script>
    function previewFoto(event) {
      const input = event.target;
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('preview-foto').src = e.target.result;
        }
        reader.readAsDataURL(input.files[0]);
      }
    }
  </script>
  <div>
    <%= form.label :descripcion, class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
    <%= form.text_field :descripcion,
                        class: "#{normal_field_class} #{locked_by_global ? locked_field_class : ''}",
                        readonly: locked_by_global,
                        title: (locked_by_global ? locked_hint : nil),
                        style: (locked_by_global ? locked_inline_style : nil) %>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= form.label :presentation, 'Presentacion', class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <%= form.select :presentation,
                      options_for_select([
                        ['Unidad', 'unidad'],
                        ['Pack', 'pack'],
                        ['Kg', 'kg']
                      ], producto.presentation.to_s),
                      {},
                      class: "#{normal_field_class} #{locked_by_global ? locked_field_class : ''}",
                      id: 'producto_presentation',
                      disabled: locked_by_global,
                      title: (locked_by_global ? locked_hint : nil),
                      style: (locked_by_global ? locked_inline_style : nil) %>
      <%= form.hidden_field :presentation if locked_by_global %>
    </div>
    <div>
      <%= form.label :cant_presentation, 'Cantidad por presentacion', class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <%= form.number_field :cant_presentation,
                            min: 1,
                            step: 1,
                            class: "#{normal_field_class} #{locked_by_global ? locked_field_class : ''}",
                            id: 'producto_cant_presentation',
                            readonly: locked_by_global,
                            title: (locked_by_global ? locked_hint : nil),
                            style: (locked_by_global ? locked_inline_style : nil) %>
    </div>
  </div>
  <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-3">
    <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-semibold text-amber-800">
      <%= form.check_box :allow_unpack, class: "h-4 w-4 cursor-pointer rounded border-amber-300 text-amber-600 focus:ring-amber-500" %>
      Este producto califica para destapar pack
    </label>
    <p class="mt-1 text-xs text-amber-700">Solo los packs con esta opción activa aparecerán en la vista de destapar pack.</p>
  </div>
  <% if Producto.column_names.include?('show_in_catalog') %>
    <div class="rounded-2xl border border-sky-200 bg-sky-50/60 p-3">
      <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-semibold text-sky-800">
        <%= form.check_box :show_in_catalog, class: "h-4 w-4 cursor-pointer rounded border-sky-300 text-sky-600 focus:ring-sky-500" %>
        Mostrar este producto en el catalogo publico del negocio
      </label>
      <p class="mt-1 text-xs text-sky-700">Si lo desactivas, quedará oculto solo en el catalogo público; seguirá visible en el panel interno.</p>
    </div>
  <% end %>
  <% profit_margin_presets = Array(@profit_margin_presets_for_select) %>
  <% selected_profit_margin_preset_id = if producto.respond_to?(:profit_margin_preset_id) && producto.profit_margin_preset_id.present?
                                          producto.profit_margin_preset_id
                                        elsif producto.respond_to?(:porcentaje_ganancia) && producto.porcentaje_ganancia.present?
                                          profit_margin_presets.find { |preset| preset.percentage.to_d == producto.porcentaje_ganancia.to_d }&.id
                                        end %>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= form.label :categoria_id, 'Categoria', class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <% if @categorias_for_select.present? %>
        <%= form.collection_select :categoria_id,
                                   @categorias_for_select,
                                   :id,
                                   :nombre,
                                   { prompt: 'Selecciona una categoria' },
                                   class: "#{normal_field_class} #{locked_by_global ? locked_field_class : ''}",
                                   disabled: locked_by_global,
                                   title: (locked_by_global ? locked_hint : nil),
                                   style: (locked_by_global ? locked_inline_style : nil) %>
        <%= form.hidden_field :categoria_id if locked_by_global %>
      <% else %>
        <div class="mt-1 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-700">
          No hay categorias registradas. Crea una categoria primero desde la seccion de categorias.
        </div>
      <% end %>
    </div>
    <div>
      <label for="costo_unid_visual" class="text-xs font-bold text-slate-400 uppercase tracking-wider">Costo Unid</label>
      <input type="text" name="costo_unid_visual" id="costo_unid_visual" class="w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:outline-none" placeholder="$ 0,00" data-money-mask="true" data-money-symbol="$" readonly>
    </div>
  </div>
  <div id="ganancia-real-status" class="hidden rounded-xl border px-3 py-3">
    <p id="ganancia-real-message" class="text-sm font-medium"></p>
    <button type="button" id="ganancia-real-toggle-btn" class="mt-2 inline-flex cursor-pointer items-center justify-center rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors"></button>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <label for="producto_profit_margin_preset_id" class="text-xs font-bold text-slate-400 uppercase tracking-wider">Ganancia fija (%)</label>
      <% if profit_margin_presets.any? %>
        <%= form.select :profit_margin_preset_id,
                        options_for_select(
                          profit_margin_presets.map do |preset|
                            ["#{format_quantity(preset.percentage)}%", preset.id, { 'data-fixed-percentage' => preset.percentage.to_d.to_s('F') }]
                          end,
                          selected_profit_margin_preset_id
                        ),
                        { include_blank: 'Selecciona % fijo' },
                        class: "#{normal_field_class} #{locked_by_global ? locked_field_class : ''}",
                        id: 'producto_profit_margin_preset_id',
                        data: { fixed_profit_select: true },
                        disabled: locked_by_global,
                        title: (locked_by_global ? locked_hint : nil),
                        style: (locked_by_global ? locked_inline_style : nil) %>
        <%= form.hidden_field :profit_margin_preset_id if locked_by_global %>
      <% else %>
        <div class="mt-1 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-700">
          No hay porcentajes de ganancia fijos registrados.
        </div>
      <% end %>
    </div>
    <div>
      <%= form.label :porcentaje_ganancia, 'Ganancia real (%)', class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <%= form.text_field :porcentaje_ganancia,
                          class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:outline-none transition-all",
                          id: "producto_porcentaje_ganancia",
                          inputmode: "decimal",
                          autocomplete: "off",
                          placeholder: "% 0,00",
                          data: { money_mask: true, money_symbol: '%' } %>
    </div>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= form.label :precio_venta_usd, "Precio Venta ($)", class:"text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <%= form.text_field :precio_venta_usd,
                          class:"#{normal_field_class} #{locked_by_global ? locked_field_class : ''}",
                          id: "producto_precio_venta_usd",
                          inputmode: "decimal",
                          autocomplete: "off",
                          placeholder: "$ 0,00",
                          data: { money_mask: true, money_symbol: '$' },
                          readonly: locked_by_global,
                          title: (locked_by_global ? locked_hint : nil),
                          style: (locked_by_global ? locked_inline_style : nil) %>
    </div>
    <div>
      <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Precio Venta (Bs)</label>
      <input type="text" name="precio_venta_bs" id="precio_venta_bs_visual" inputmode="decimal" autocomplete="off" data-money-mask="true" data-money-symbol="Bs" class="w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:outline-none" placeholder="Bs 0,00">
    </div>
  </div>
  <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-3">
    <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-semibold text-amber-800">
      <%= form.check_box :exento, class: "h-4 w-4 cursor-pointer rounded border-amber-300 text-amber-600 focus:ring-amber-500" %>
      Producto exento de IVA en la venta
    </label>
    <p class="mt-1 text-xs text-amber-700">Si esta activo, este producto no suma IVA y no se recalcula en IVA invertido.</p>
  </div>
  <hr class="my-4 border-t-2 border-slate-200 rounded-xl">
  <div class="mt-2">
    <div class="flex items-center justify-between">
      <h6 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Variaciones</h6>
      <button type="button" id="add-variation" class="px-4 py-2 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 shadow-lg shadow-slate-200 transition-all">
        Agregar variacion
      </button>
    </div>
    <% ordered_variations = form.object.product_variations.sort_by { |variation| variation.description.to_s.mb_chars.downcase.to_s } %>
    <div id="variations-list" class="mt-4 space-y-4">
      <%= form.fields_for :product_variations, ordered_variations do |pv| %>
        <div class="variation-row rounded-2xl border border-slate-200 bg-slate-50/40 p-4" data-new-record="<%= pv.object.new_record? %>">
          <%= pv.hidden_field :_destroy, class: "variation-destroy" %>
          <div class="flex items-start justify-between gap-3">
            <div class="text-sm font-bold text-slate-700">Variacion</div>
            <button type="button" class="remove-variation inline-flex cursor-pointer items-center justify-center rounded-lg border border-rose-200 bg-rose-50 p-2 text-rose-600 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-rose-100 hover:shadow" title="Eliminar variación" aria-label="Eliminar variación">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 3a1 1 0 0 0-1 1v1H5a1 1 0 1 0 0 2h.636l.89 12.46A2 2 0 0 0 8.52 21h6.96a2 2 0 0 0 1.994-1.54L18.364 7H19a1 1 0 1 0 0-2h-3V4a1 1 0 0 0-1-1H9Zm2 2h2v1h-2V5Zm-2.37 2h6.74l-.86 12.04a.5.5 0 0 1-.498.46H9.988a.5.5 0 0 1-.498-.46L8.63 7Z"/>
              </svg>
            </button>
          </div>
          <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
              <%= pv.label :description, "Descripcion", class: "block text-xs font-bold text-slate-400 uppercase tracking-wider" %>
              <%= pv.text_field :description, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
            </div>
            <div>
              <%= pv.label :safety_stock, "Stock de seguridad", class: "block text-xs font-bold text-slate-400 uppercase tracking-wider" %>
              <%= pv.text_field :safety_stock,
                                value: (pv.object.safety_stock || 0).to_i,
                                inputmode: 'numeric',
                                autocomplete: 'off',
                                pattern: '[0-9]*',
                                data: { variation_safety_stock: true },
                                class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <% has_unique_variation = form.object.product_variations.any? { |variation| variation.description.to_s.strip.casecmp('unica').zero? } %>
    <div id="general-safety-stock-row" class="mt-4 <%= has_unique_variation ? 'hidden' : '' %>">
      <%= form.label :general_safety_stock, "Stock de seguridad general", class: "block text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <%= form.number_field :general_safety_stock,
                            value: (form.object.general_safety_stock || 0).to_i,
                            step: 1,
                            min: 0,
                            inputmode: 'numeric',
                            data: { disable_wheel_change: true },
                            class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
    </div>
  </div>
  <hr class="my-4 border-t-2 border-slate-200 rounded-xl">
  <div class="mt-2">
    <h6 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Proveedores</h6>
    <% global_supplier_rows = if producto.global_product_id.present?
         GlobalSupplierProduct.joins(:global_supplier)
                              .includes(:global_supplier)
                              .where(global_product_id: producto.global_product_id, active: true)
                              .order(Arel.sql('LOWER(global_suppliers.name) ASC'))
       else
         []
       end %>
    <div class="mt-3 space-y-3">
      <% global_supplier_rows.each do |sp| %>
        <div class="rounded-2xl border border-slate-200 bg-slate-50/40 p-4">
          <div class="flex items-center justify-between">
            <div class="text-sm font-bold text-slate-700"><%= sp.global_supplier&.name || 'Proveedor global' %></div>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-4 text-sm text-slate-600">
            <div><span class="font-semibold">Costo mayor:</span> <%= format_money(sp.costo_mayor, unit: '$') %></div>
            <div><span class="font-semibold">Costo menor:</span> <%= format_money(sp.costo_menor, unit: '$') %></div>
            <div><span class="font-semibold">Unid por pack:</span> <%= format_quantity(sp.cantidad, precision: 0) %></div>
          </div>
        </div>
      <% end %>
      <% if global_supplier_rows.empty? %>
        <div class="text-sm text-slate-500">Este producto no tiene proveedores globales asignados.</div>
      <% end %>
    </div>
  </div>
  <hr class="my-4 border-t-2 border-slate-200 rounded-xl">
  <div class="mt-2">
    <h6 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Lotes de Costo (FIFO)</h6>
    <div class="mt-3 space-y-3">
      <% available_lots = producto.inventory_lots.select { |lot| lot.quantity_remaining.to_d > 0 } %>
      <% if available_lots.any? %>
        <% available_lots.each do |lot| %>
          <% units_per_pack = lot.purchase_invoice_item&.unid_x_pack.to_d %>
          <% purchased_units = units_per_pack.positive? ? (lot.quantity_in.to_d * units_per_pack) : lot.quantity_in.to_d %>
          <% remaining_units = if lot.stock_lot_variations.any?
                                lot.stock_lot_variations.sum(:quantity_remaining).to_d
                              elsif units_per_pack.positive?
                                lot.quantity_remaining.to_d * units_per_pack
                              else
                                lot.quantity_remaining.to_d
                              end %>
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="flex items-center justify-between">
              <div>
                <div class="text-sm font-bold text-slate-700">Lote principal #<%= lot.id %></div>
                <div class="text-xs text-slate-500"><%= lot.supplier_display_name %></div>
              </div>
              <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 cursor-pointer">
                <input
                    type="radio"
                    name="lote_costo_selector"
                    class="lot-cost-selector h-4 w-4 text-sky-600 border-slate-300 focus:ring-sky-500"
                    data-unit-cost="<%= lot.unit_cost_usd.to_s %>"
                    data-lot-timestamp="<%= (lot.purchased_at || lot.created_at)&.to_i || 0 %>"
                    <%= 'disabled' if lot.quantity_remaining.to_d <= 0 %>
                  >
                  <span class="<%= lot.quantity_remaining.to_d > 0 ? 'text-emerald-600' : 'text-slate-400' %>">
                    <%= lot.quantity_remaining.to_d > 0 ? 'Usar lote' : 'Agotado' %>
                  </span>
                </label>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-4 text-sm text-slate-600">
                <div><span class="font-semibold">Costo unid:</span> <%= format_money(lot.unit_cost_usd, unit: '$') %></div>
                <div><span class="font-semibold">Fecha compra:</span> <%= l((lot.purchased_at || lot.created_at).to_date) rescue '-' %></div>
                <div><span class="font-semibold">Cantidad comprada (unid):</span> <%= format_quantity(purchased_units, precision: 0) %></div>
                <div><span class="font-semibold">Cantidad restante (unid):</span> <%= format_quantity(remaining_units, precision: 0) %></div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-sm text-slate-500">Sin lotes de compra registrados para este producto.</div>
        <% end %>
      </div>
    </div>
    <div>
      <%= form.submit "Guardar", class: "modal-submit hidden"%>
    </div>
  <% end %>
  <template id="variation-template">
    <div class="variation-row rounded-2xl border border-slate-200 bg-slate-50/40 p-4" data-new-record="true">
      <input type="hidden" name="producto[product_variations_attributes][NEW_RECORD][_destroy]" value="0" class="variation-destroy">
      <div class="flex items-start justify-between gap-3">
        <div class="text-sm font-bold text-slate-700">Variacion</div>
        <button type="button" class="remove-variation inline-flex cursor-pointer items-center justify-center rounded-lg border border-rose-200 bg-rose-50 p-2 text-rose-600 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-rose-100 hover:shadow" title="Eliminar variación" aria-label="Eliminar variación">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M9 3a1 1 0 0 0-1 1v1H5a1 1 0 1 0 0 2h.636l.89 12.46A2 2 0 0 0 8.52 21h6.96a2 2 0 0 0 1.994-1.54L18.364 7H19a1 1 0 1 0 0-2h-3V4a1 1 0 0 0-1-1H9Zm2 2h2v1h-2V5Zm-2.37 2h6.74l-.86 12.04a.5.5 0 0 1-.498.46H9.988a.5.5 0 0 1-.498-.46L8.63 7Z"/>
          </svg>
        </button>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Descripcion</label>
          <input class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" name="producto[product_variations_attributes][NEW_RECORD][description]" type="text" value="Unica">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Stock de seguridad</label>
          <input class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" inputmode="numeric" autocomplete="off" pattern="[0-9]*" data-variation-safety-stock="true" name="producto[product_variations_attributes][NEW_RECORD][safety_stock]" type="text" value="0">
        </div>
      </div>
    </div>
  </template>
  <script>
    document.addEventListener('turbo:frame-load', (e) => {
      if (e.target.id !== 'modal-productos') return;
      const frame = e.target;
      if (frame.dataset.variationsBound === 'true') return;
      frame.dataset.variationsBound = 'true';

      if (!frame.dataset.variationIndex) {
        frame.dataset.variationIndex = String(Date.now());
      }

      const bindDisableWheelChangeInputs = () => {
        const inputs = frame.querySelectorAll('input[type="number"][data-disable-wheel-change="true"]');

        inputs.forEach((input) => {
          if (input.dataset.disableWheelChangeBound === 'true') return;

          input.dataset.disableWheelChangeBound = 'true';
          input.addEventListener('wheel', (event) => {
            event.preventDefault();
          }, { passive: false });
        });
      };

      const bindVariationSafetyStockInputs = () => {
        const inputs = frame.querySelectorAll('input[data-variation-safety-stock="true"]');

        inputs.forEach((input) => {
          if (input.dataset.variationSafetyStockBound !== 'true') {
            input.dataset.variationSafetyStockBound = 'true';

            input.addEventListener('input', () => {
              input.value = String(input.value || '').replace(/\D+/g, '');
            });

            input.addEventListener('blur', () => {
              const normalized = String(input.value || '').replace(/\D+/g, '');
              input.value = normalized === '' ? '0' : String(Number(normalized));
            });
          }

          const normalized = String(input.value || '').replace(/\D+/g, '');
          input.value = normalized === '' ? '0' : String(Number(normalized));
        });
      };

      const hasUniqueVariationDescription = () => {
        const variationRows = frame.querySelectorAll('.variation-row');
        return Array.from(variationRows).some((row) => {
          if (row.classList.contains('hidden')) return false;

          const destroyInput = row.querySelector('.variation-destroy');
          if (destroyInput && destroyInput.value === '1') return false;

          const descriptionInput = row.querySelector('input[name*="[description]"]');
          const description = String(descriptionInput?.value || '').trim().toLowerCase();
          return description === 'unica';
        });
      };

      const updateGeneralSafetyStockVisibility = () => {
        const generalStockRow = frame.querySelector('#general-safety-stock-row');
        if (!generalStockRow) return;

        generalStockRow.classList.toggle('hidden', hasUniqueVariationDescription());
      };

      bindDisableWheelChangeInputs();
      bindVariationSafetyStockInputs();
      updateGeneralSafetyStockVisibility();

      const confirmVariationDelete = () => {
        if (window.Swal) {
          return window.Swal.fire({
            title: '¿Eliminar variación?',
            text: 'Si la variación ya existe, se eliminará al guardar el producto.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#64748b',
            target: 'body',
            heightAuto: false,
          }).then((result) => result.isConfirmed);
        }

        return Promise.resolve(window.confirm('¿Eliminar variación?'));
      };

      frame.addEventListener('click', async (ev) => {
        const clickedElement = ev.target instanceof Element ? ev.target : null;
        if (!clickedElement) return;

        const addButton = clickedElement.closest('#add-variation');
        if (addButton) {
          const container = frame.querySelector('#variations-list');
          const template = frame.querySelector('#variation-template');
          if (!container || !template) return;
          const currentIndex = Number(frame.dataset.variationIndex || Date.now());
          const html = template.innerHTML.replace(/NEW_RECORD/g, currentIndex);
          frame.dataset.variationIndex = String(currentIndex + 1);
          container.insertAdjacentHTML('beforeend', html);
          bindDisableWheelChangeInputs();
          bindVariationSafetyStockInputs();
          updateGeneralSafetyStockVisibility();
          return;
        }

        const removeButton = clickedElement.closest('.remove-variation');
        if (!removeButton) return;

        ev.preventDefault();
        const confirmed = await confirmVariationDelete();
        if (!confirmed) return;

        const row = removeButton.closest('.variation-row');
        if (!row) return;

        const destroyInput = row.querySelector('.variation-destroy');
        const isNew = row.dataset.newRecord === 'true';
        if (destroyInput && !isNew) {
          destroyInput.value = '1';
          row.classList.add('hidden');
        } else {
          row.remove();
        }

        updateGeneralSafetyStockVisibility();
      });

      frame.addEventListener('input', (event) => {
        const input = event.target instanceof Element ? event.target : null;
        if (!input) return;
        if (!input.matches('input[name*="[description]"]')) return;

        updateGeneralSafetyStockVisibility();
      });
    });
  </script>
