<header class="h-14 md:h-20 flex-none glass border-b border-sky-100 flex items-center justify-between px-4 md:px-6 z-10">
  <% header_cashea_account = current_business&.accounts&.where(account_type: 'cashea', active: true)&.ordered_by_group_and_name&.first %>
  <div class="flex items-center gap-4">
    <% if @businesses.present? %>
      <div id="business-switcher" class="relative">
        <button id="business-switcher-button" type="button" class="group flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-2 shadow-sm hover:border-sky-200 hover:bg-sky-50 transition-colors cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Cambiar negocio">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl text-sm font-bold" style="<%= current_business ? current_business.theme_preview_style : Business.theme_preview_style %>">
            <%= current_business&.name.to_s.first&.upcase || 'N' %>
          </span>
          <span class="hidden md:block text-left">
            <span class="block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Negocio</span>
            <span class="block text-sm font-semibold text-slate-800"><%= current_business&.name || 'Sin negocio' %></span>
          </span>
          <i data-lucide="chevron-down" class="hidden md:block h-4 w-4 text-slate-400 group-hover:text-slate-600"></i>
        </button>
        <div id="business-switcher-menu" class="absolute left-0 mt-3 hidden w-72 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
          <div class="border-b border-slate-100 px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Selecciona un negocio</p>
            <p class="mt-1 text-sm font-semibold text-slate-800"><%= current_business&.name || 'Sin negocio' %></p>
          </div>
          <div class="max-h-64 overflow-y-auto py-2">
            <% @businesses.each do |business| %>
              <% is_current = current_business&.id == business.id %>
              <% item_classes = is_current ? 'bg-sky-50 text-sky-700' : 'text-slate-700 hover:bg-slate-50' %>
              <% if current_user_admin? || Current.user&.assigned_to_business?(business) %>
                <%= button_to select_business_path(business), method: :post, form: { class: 'w-full', data: { turbo: false } }, class: "flex w-full items-center gap-3 px-4 py-2 text-left text-sm transition-colors cursor-pointer #{item_classes}", data: { turbo: false } do %>
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold" style="<%= business.theme_preview_style %>">
                    <%= business.name.to_s.first&.upcase || 'N' %>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-medium"><%= business.name %></span>
                  </span>
                  <% if is_current %>
                    <i data-lucide="check" class="h-4 w-4"></i>
                  <% end %>
                <% end %>
              <% else %>
                <div class="flex w-full items-center gap-3 px-4 py-2 text-sm <%= item_classes %>">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold" style="<%= business.theme_preview_style %>">
                    <%= business.name.to_s.first&.upcase || 'N' %>
                  </span>
                  <span class="min-w-0 flex-1 truncate font-medium"><%= business.name %></span>
                  <% if is_current %>
                    <i data-lucide="check" class="h-4 w-4"></i>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
          <% if current_user_admin? %>
            <div class="border-t border-slate-100 bg-slate-50 px-4 py-3 flex items-center justify-between">
              <%= link_to businesses_path, class: 'text-sm font-semibold text-slate-600 hover:text-slate-800' do %>
                Administrar
              <% end %>
              <%= link_to new_business_path, class: 'inline-flex items-center gap-1 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800' do %>
                <i data-lucide="plus" class="h-3.5 w-3.5"></i>
                Nuevo
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <% if current_user_admin? %>
        <%= link_to new_business_path, class: 'inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800' do %>
          <i data-lucide="plus" class="h-4 w-4"></i>
          <span class="hidden md:inline">Crear negocio</span>
        <% end %>
      <% else %>
        <span class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-500">Sin negocio asignado</span>
      <% end %>
    <% end %>
  </div>
  <div class="flex items-center gap-3 md:gap-5" data-header-current-user-id="<%= Current.user&.id %>" data-header-current-user-admin="<%= current_user_admin? ? 'true' : 'false' %>">
    <% if controller_name == 'ventas' && action_name == 'index' %>
      <% can_manage_cash_shifts = can_manage_action?(:manage_cash_shifts) %>
      <% customer_sales_mode_header = Current.user&.customer_mode?(current_business) %>
      <% unless customer_sales_mode_header %>
        <% if @open_cash_shift.present? %>
          <%= link_to cash_shift_path(@open_cash_shift), class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-emerald-100' do %>
            <i data-lucide="clock-3" class="h-4 w-4"></i>
            <span class="hidden lg:inline">Turno #<%= @open_cash_shift.id %> abierto</span>
            <span class="lg:hidden">Turno #<%= @open_cash_shift.id %></span>
          <% end %>
        <% elsif can_manage_cash_shifts %>
          <button type="button"
                  id="ventas-open-cash-shift-trigger"
                  data-create-url="<%= cash_shifts_path %>"
                  data-opening-balances="<%= ERB::Util.json_escape((@open_shift_balance_checks_payload || []).to_json) %>"
            data-last-closed-shift-url="<%= @last_closed_cash_shift.present? ? cash_shift_path(@last_closed_cash_shift) : '' %>"
                  class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-amber-100">
            <i data-lucide="play" class="h-4 w-4"></i>
            <span class="hidden lg:inline">Abrir turno</span>
          </button>
        <% else %>
          <span class="hidden lg:inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600">
            Espera al encargado para abrir turno
          </span>
        <% end %>
        <% if current_user_admin? || current_user_manager? || current_user_standard_staff? %>
          <button type="button"
                  id="ventas-requested-products-trigger"
                  data-list-url="<%= requested_products_ventas_path %>"
                  data-create-url="<%= requested_products_ventas_path %>"
              data-update-url-template="<%= update_requested_product_ventas_path(id: '__ID__') %>"
                  data-increment-url-template="<%= increment_requested_product_ventas_path(id: '__ID__') %>"
              data-delete-url-template="<%= destroy_requested_product_ventas_path(id: '__ID__') %>"
                  data-can-delete="<%= current_user_admin? ? '1' : '0' %>"
                  class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-indigo-100">
            <i data-lucide="clipboard-list" class="h-4 w-4"></i>
            <span class="hidden lg:inline">Solicitudes</span>
          </button>
        <% end %>
      <% end %>
    <% end %>
    <% if Rails.env.development? && current_user_admin? %>
      <%= link_to sandbox_mercantil_c2p_search_path,
                  class: 'hidden lg:inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-violet-200 bg-violet-50 px-3 py-2 text-sm font-semibold text-violet-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-violet-100',
                  data: { turbo_frame: '_top' } do %>
        <i data-lucide="flask-conical" class="h-4 w-4"></i>
        Sandbox C2P
      <% end %>
    <% end %>
    <button id="theme-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-slate-600 shadow-sm ring-1 ring-slate-200 transition-all hover:-translate-y-0.5 hover:bg-slate-50" aria-label="Cambiar modo oscuro">
      <span data-theme-icon="dark">
        <i data-lucide="moon" class="h-5 w-5"></i>
      </span>
      <span data-theme-icon="light" class="hidden">
        <i data-lucide="sun" class="h-5 w-5"></i>
      </span>
    </button>
    <div id="rates-tooltip" class="relative">
      <button id="rates-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-200/85 text-slate-700 shadow-sm ring-1 ring-slate-300 transition-colors hover:bg-slate-300 hover:text-slate-900 cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Ver tasas">
        <i data-lucide="line-chart" class="w-5 h-5"></i>
      </button>
      <div id="rates-panel" class="absolute right-0 mt-3 hidden w-80 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
        <div class="border-b border-slate-100 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Tasas registradas</p>
          <p class="mt-1 text-sm font-semibold text-slate-800">Valores mas recientes</p>
        </div>
        <div class="max-h-64 overflow-y-auto py-2">
          <% if @latest_tasas.present? %>
            <% @latest_tasas.each do |tasa| %>
              <% fecha_label = tasa.fecha_referencia&.strftime('%d/%m/%Y') || '-' %>
              <div class="flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-slate-50">
                <p class="truncate text-sm font-semibold text-slate-800"><%= tasa.description %></p>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-slate-800 whitespace-nowrap"><%= format_money(tasa.valor, unit: 'Bs') %></span>
                  <span class="text-xs text-slate-500 whitespace-nowrap"><%= fecha_label %></span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="px-4 py-4 text-sm text-slate-500">No hay tasas registradas.</div>
          <% end %>
        </div>
      </div>
    </div>
    <div id="recarga-summary-tooltip" class="relative">
      <button id="recarga-summary-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-cyan-100 text-cyan-700 shadow-sm ring-1 ring-cyan-200 transition-colors hover:bg-cyan-200 hover:text-cyan-900 cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Ver resumen de recargas">
        <i data-lucide="smartphone" class="w-5 h-5"></i>
      </button>
      <div id="recarga-summary-panel" class="absolute right-0 mt-3 hidden w-96 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
        <div class="border-b border-slate-100 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Resumen de parametros de recarga</p>
          <p class="mt-1 text-sm font-semibold text-slate-800">Recarga minima configurada por servicio</p>
        </div>
        <div class="max-h-80 overflow-y-auto p-3">
          <% if @header_recarga_summary.present? %>
            <table class="w-full text-left text-sm text-slate-700">
              <thead>
                <tr class="border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                  <th class="px-2 py-2">Sistema</th>
                  <th class="px-2 py-2 text-right">Recarga minima</th>
                </tr>
              </thead>
              <tbody>
                <% @header_recarga_summary.each do |row| %>
                  <tr class="border-b border-slate-100 last:border-0">
                    <td class="px-2 py-2">
                      <p class="font-semibold text-slate-800"><%= row[:service_name] %></p>
                      <p class="text-xs text-slate-500"><%= row[:system_name] %></p>
                    </td>
                    <td class="px-2 py-2 text-right font-semibold text-slate-800">
                      <%= row[:min_amount].present? ? format_money(row[:min_amount], unit: 'Bs') : '-' %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="px-2 py-2 text-sm text-slate-500">No hay servicios de recarga configurados.</p>
          <% end %>
        </div>
        <% if current_user_admin? %>
          <div class="border-t border-slate-100 bg-slate-50 px-4 py-3">
            <%= link_to recarga_parameters_services_path,
                        class: 'inline-flex items-center gap-2 text-sm font-semibold text-cyan-700 hover:text-cyan-900',
                        data: { turbo_frame: '_top' } do %>
              <i data-lucide="settings-2" class="h-4 w-4"></i>
              Configurar parametros de recarga
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <div id="cashea-levels-tooltip" class="relative">
      <button id="cashea-levels-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-white shadow-sm ring-1 ring-amber-200 transition-colors hover:bg-amber-50 cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Ver iniciales Cashea">
        <%= image_tag 'logo cashea.jpg', class: 'h-full w-full object-cover object-center', alt: 'Cashea' %>
      </button>
      <div id="cashea-levels-panel" class="absolute right-0 mt-3 hidden w-[26rem] overflow-hidden rounded-2xl border border-amber-200 bg-white shadow-xl">
        <div class="border-b border-amber-100 bg-amber-50 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Niveles Cashea</p>
          <p class="mt-1 text-sm font-semibold text-slate-800">Inicial permitido por nivel y linea</p>
        </div>
        <div class="p-3">
          <% if header_cashea_account.present? %>
            <div class="rounded-xl border border-amber-200 bg-amber-50/40 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-700">Linea cotidiana</p>
              <div class="mt-2 space-y-1.5">
                <% 1.upto(6) do |level| %>
                  <% percent = header_cashea_account.cashea_initial_percent_for(level: level, line: 'cotidiana') %>
                  <div class="flex items-center justify-between rounded-lg border border-amber-100 bg-white px-3 py-2">
                    <span class="text-sm font-semibold text-slate-700">Nivel <%= level %></span>
                    <span class="text-sm font-bold text-amber-700"><%= number_with_precision(percent, precision: 2, strip_insignificant_zeros: true) %>%</span>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="my-3 border-t border-dashed border-slate-300"></div>

            <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-700">Linea principal</p>
              <div class="mt-2 space-y-1.5">
                <% 1.upto(6) do |level| %>
                  <% percent = header_cashea_account.cashea_initial_percent_for(level: level, line: 'principal') %>
                  <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-3 py-2">
                    <span class="text-sm font-semibold text-slate-700">Nivel <%= level %></span>
                    <span class="text-sm font-bold text-slate-800"><%= number_with_precision(percent, precision: 2, strip_insignificant_zeros: true) %>%</span>
                  </div>
                <% end %>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-slate-500">Cashea no esta configurado para este negocio.</p>
          <% end %>
        </div>
        <% if current_user_admin? %>
          <div class="border-t border-slate-100 bg-slate-50 px-4 py-3">
            <% if header_cashea_account.present? %>
              <%= link_to edit_account_path(header_cashea_account), class: 'inline-flex items-center gap-2 text-sm font-semibold text-amber-700 hover:text-amber-900', data: { turbo_frame: '_top' } do %>
                <i data-lucide="settings-2" class="h-4 w-4"></i>
                Configurar niveles
              <% end %>
            <% else %>
              <%= link_to accounts_path, class: 'inline-flex items-center gap-2 text-sm font-semibold text-amber-700 hover:text-amber-900', data: { turbo_frame: '_top' } do %>
                <i data-lucide="wallet-cards" class="h-4 w-4"></i>
                Configurar cuenta Cashea
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <%= render 'shared/header_notifications' %>
    <!-- Mobile Profile Icon -->
    <div class="md:hidden h-8 w-8 overflow-hidden rounded-full border border-sky-200 bg-sky-100">
      <% if Current.user&.avatar&.attached? %>
        <%= image_tag Current.user.avatar, class: 'h-full w-full object-cover', alt: Current.user.display_name %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center text-xs font-bold text-sky-700"><%= Current.user&.display_name.to_s.first&.upcase || 'U' %></div>
      <% end %>
    </div>
  </div>
</header>
<script>
  (() => {
    if (window.businessSwitcherHandlersBound) return;
    window.businessSwitcherHandlersBound = true;

    const getElements = () => {
      const switcher = document.getElementById('business-switcher');
      if (!switcher) return null;
      const button = document.getElementById('business-switcher-button');
      const menu = document.getElementById('business-switcher-menu');
      if (!button || !menu) return null;
      return { button, menu };
    };

    const closeMenu = () => {
      const elements = getElements();
      if (!elements) return;
      elements.menu.classList.add('hidden');
      elements.button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const elements = getElements();
      if (!elements) return;

      const { button, menu } = elements;
      const clickedButton = button.contains(event.target);
      const clickedMenu = menu.contains(event.target);

      if (clickedButton) {
        menu.classList.toggle('hidden');
        button.setAttribute('aria-expanded', menu.classList.contains('hidden') ? 'false' : 'true');
        return;
      }

      if (!clickedMenu) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeMenu();
    });
  })();

  (() => {
    if (window.ratesTooltipHandlersBound) return;
    window.ratesTooltipHandlersBound = true;

    const getElements = () => {
      const wrapper = document.getElementById('rates-tooltip');
      if (!wrapper) return null;
      const button = document.getElementById('rates-toggle');
      const panel = document.getElementById('rates-panel');
      if (!button || !panel) return null;
      return { button, panel };
    };

    const closePanel = () => {
      const elements = getElements();
      if (!elements) return;
      elements.panel.classList.add('hidden');
      elements.button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const elements = getElements();
      if (!elements) return;

      const { button, panel } = elements;
      const clickedButton = button.contains(event.target);
      const clickedPanel = panel.contains(event.target);

      if (clickedButton) {
        panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', panel.classList.contains('hidden') ? 'false' : 'true');
        return;
      }

      if (!clickedPanel) {
        closePanel();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closePanel();
    });
  })();

  (() => {
    if (window.casheaLevelsTooltipHandlersBound) return;
    window.casheaLevelsTooltipHandlersBound = true;

    const closePanel = () => {
      const wrapper = document.getElementById('cashea-levels-tooltip');
      const button = document.getElementById('cashea-levels-toggle');
      const panel = document.getElementById('cashea-levels-panel');
      if (!wrapper || !button || !panel) return;
      panel.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const wrapper = document.getElementById('cashea-levels-tooltip');
      const button = document.getElementById('cashea-levels-toggle');
      const panel = document.getElementById('cashea-levels-panel');
      if (!wrapper || !button || !panel) return;

      if (button.contains(event.target)) {
        const isHidden = panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        return;
      }

      if (!panel.contains(event.target)) closePanel();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closePanel();
    });
  })();

  (() => {
    const setupRequestedProductsModal = () => {
      const trigger = document.getElementById('ventas-requested-products-trigger');
      if (!trigger) return;
      if (trigger.dataset.rpModalBound === '1') return;
      trigger.dataset.rpModalBound = '1';

      const listUrl = String(trigger.dataset.listUrl || '').trim();
      const createUrl = String(trigger.dataset.createUrl || '').trim();
      const updateTemplate = String(trigger.dataset.updateUrlTemplate || '').trim();
      const incrementTemplate = String(trigger.dataset.incrementUrlTemplate || '').trim();
      const deleteTemplate = String(trigger.dataset.deleteUrlTemplate || '').trim();
      const canDelete = String(trigger.dataset.canDelete || '') === '1';
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    const state = {
      rows: [],
      query: '',
      loading: false,
      saving: false,
      expandedRowIds: new Set(),
      editingRowId: null,
      pendingIncrementsById: {},
    };

    const escapeHtml = (value) => String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

    const normalize = (value) => String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

    const sortRows = () => {
      state.rows.sort((a, b) => String(a.name || '').localeCompare(String(b.name || ''), 'es', { sensitivity: 'base' }));
    };

    const upsertRow = (row) => {
      if (!row || !row.id) return;
      const rowId = String(row.id);
      state.rows = state.rows.filter((item) => String(item.id) !== rowId);
      state.rows.push({
        id: row.id,
        name: String(row.name || '').trim(),
        requests_count: Number(row.requests_count || 0),
        events: Array.isArray(row.events)
          ? row.events.map((event) => ({
            id: event.id,
            event_kind: String(event.event_kind || ''),
            user_name: String(event.user_name || 'Usuario').trim() || 'Usuario',
            requests_count_after: Number(event.requests_count_after || 0),
            happened_at_label: String(event.happened_at_label || '').trim(),
          }))
          : [],
      });
      sortRows();
    };

    const findRowById = (id) => {
      const rowId = String(id || '').trim();
      if (!rowId) return null;
      return state.rows.find((item) => String(item.id) === rowId) || null;
    };

    const incrementPendingRequests = (id) => {
      const rowId = String(id || '').trim();
      if (!rowId) return;
      const current = Number(state.pendingIncrementsById[rowId] || 0);
      state.pendingIncrementsById[rowId] = current + 1;
    };

    const decrementPendingRequests = (id) => {
      const rowId = String(id || '').trim();
      if (!rowId) return;
      const current = Number(state.pendingIncrementsById[rowId] || 0);
      if (current <= 1) {
        delete state.pendingIncrementsById[rowId];
        return;
      }
      state.pendingIncrementsById[rowId] = current - 1;
    };

    const toggleRowDetails = (id) => {
      const key = String(id || '').trim();
      if (!key) return;

      if (state.expandedRowIds.has(key)) {
        state.expandedRowIds.delete(key);
      } else {
        state.expandedRowIds.add(key);
      }
      render();
    };

    const startEditRow = (id) => {
      const rowId = String(id || '').trim();
      if (!rowId) return;
      state.editingRowId = rowId;
      render();
    };

    const cancelEditRow = () => {
      state.editingRowId = null;
      render();
    };

    const setLoading = (isLoading) => {
      state.loading = Boolean(isLoading);
      const container = window.Swal?.getHtmlContainer?.();
      if (!container) return;

      const loader = container.querySelector('[data-rp-loader]');
      const content = container.querySelector('[data-rp-content]');
      if (loader) loader.classList.toggle('hidden', !state.loading);
      if (content) content.classList.toggle('hidden', state.loading);
    };

    const filteredRows = () => {
      const q = normalize(state.query);
      if (!q) return state.rows;
      return state.rows.filter((row) => normalize(row.name).includes(q));
    };

    const render = () => {
      const container = window.Swal?.getHtmlContainer?.();
      if (!container) return;

      const tbody = container.querySelector('[data-rp-table-body]');
      const empty = container.querySelector('[data-rp-empty]');
      const total = container.querySelector('[data-rp-total]');

      if (!tbody || !empty || !total) return;

      if (state.loading) return;

      const rows = filteredRows();
      total.textContent = String(state.rows.length);

      if (rows.length === 0) {
        tbody.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      tbody.innerHTML = rows.map((row) => {
        const rowId = String(row.id);
        const isExpanded = state.expandedRowIds.has(rowId);
        const isEditing = state.editingRowId === rowId;
        const isIncrementing = Number(state.pendingIncrementsById[rowId] || 0) > 0;
        const events = Array.isArray(row.events) ? row.events : [];
        const detailsHtml = events.length > 0
          ? `
            <div class="space-y-1.5">
              ${events.map((event) => {
                const eventLabel = event.event_kind === 'created' ? 'Creó el registro' : 'Sumó una solicitud';
                return `
                  <div class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs text-slate-600">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p><span class="font-semibold text-slate-700">${escapeHtml(event.user_name)}</span> · ${escapeHtml(eventLabel)}</p>
                      <p class="font-semibold text-slate-500">${escapeHtml(event.happened_at_label || '-')}</p>
                    </div>
                    <p class="mt-1 text-[11px] text-slate-500">Cantidad acumulada: <span class="font-semibold text-indigo-700">${Number(event.requests_count_after || 0)}</span></p>
                  </div>
                `;
              }).join('')}
            </div>
          `
          : '<p class="text-xs text-slate-500">Aun no hay movimientos registrados para este producto.</p>';

        return `
          <tr class="border-b border-slate-100">
            <td class="px-3 py-2 text-sm font-medium text-slate-700">
              <div class="flex items-center gap-2">
                <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 hover:bg-slate-50" data-rp-toggle="${rowId}" aria-label="Desplegar control" title="Desplegar control">
                  ${isExpanded ? '▾' : '▸'}
                </button>
                ${isEditing
              ? `<input type="text" value="${escapeHtml(row.name)}" data-rp-edit-input="${rowId}" class="w-full rounded-lg border border-indigo-300 bg-white px-2.5 py-1.5 text-sm text-slate-700 focus:border-indigo-500 focus:ring-indigo-500">`
              : `<button type="button" class="text-left text-sm font-medium text-slate-700 hover:text-indigo-700" data-rp-toggle="${rowId}" title="Ver control de solicitudes">${escapeHtml(row.name)}</button>`}
              </div>
            </td>
            <td class="px-3 py-2 text-right">
              <div class="inline-flex items-center gap-2">
                <span class="min-w-[2rem] text-sm font-bold text-indigo-700">${Number(row.requests_count || 0)}</span>
                <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-indigo-200 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 disabled:cursor-not-allowed disabled:opacity-60" data-rp-increment="${row.id}" title="${isIncrementing ? 'Guardando...' : 'Sumar solicitud'}" aria-label="Sumar solicitud" ${isIncrementing ? 'disabled' : ''}>
                  +
                </button>
              </div>
            </td>
            <td class="px-3 py-2 text-right">
              <div class="inline-flex items-center gap-2">
                ${isEditing
              ? `<button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100" data-rp-save="${rowId}" title="Guardar" aria-label="Guardar">💾</button>
                   <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 hover:bg-slate-50" data-rp-cancel-edit="${rowId}" title="Cancelar" aria-label="Cancelar">✕</button>`
              : `<button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-sky-200 bg-sky-50 text-sky-700 hover:bg-sky-100" data-rp-edit="${rowId}" title="Editar" aria-label="Editar">✏</button>`}
                ${canDelete ? `<button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100" data-rp-delete="${rowId}" title="Eliminar" aria-label="Eliminar">🗑</button>` : ''}
              </div>
            </td>
          </tr>
          ${isExpanded ? `
            <tr class="border-b border-slate-100 bg-slate-50/60">
              <td colspan="3" class="px-3 py-3">
                <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-slate-500">Control de solicitudes (reciente a antiguo)</p>
                ${detailsHtml}
              </td>
            </tr>
          ` : ''}
        `;
      }).join('');
    };

    const fetchList = async () => {
      if (!listUrl) return;
      setLoading(true);
      try {
        const response = await fetch(listUrl, {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
          cache: 'no-store',
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'No se pudo cargar la lista.');

        state.rows = Array.isArray(data.requested_products)
          ? data.requested_products.map((row) => ({
            id: row.id,
            name: String(row.name || '').trim(),
            requests_count: Number(row.requests_count || 0),
            events: Array.isArray(row.events)
              ? row.events.map((event) => ({
                id: event.id,
                event_kind: String(event.event_kind || ''),
                user_name: String(event.user_name || 'Usuario').trim() || 'Usuario',
                requests_count_after: Number(event.requests_count_after || 0),
                happened_at_label: String(event.happened_at_label || '').trim(),
              }))
              : [],
          }))
          : [];
        sortRows();
        render();
      } catch (error) {
        const container = window.Swal?.getHtmlContainer?.();
        const feedback = container?.querySelector('[data-rp-feedback]');
        if (feedback) {
          feedback.textContent = error.message || 'No se pudo cargar la lista.';
          feedback.classList.remove('hidden');
          feedback.classList.remove('text-emerald-700');
          feedback.classList.add('text-rose-700');
        }
      } finally {
        setLoading(false);
        render();
      }
    };

    const showFeedback = (message, ok = false) => {
      const container = window.Swal?.getHtmlContainer?.();
      const feedback = container?.querySelector('[data-rp-feedback]');
      if (!feedback) return;

      feedback.textContent = message;
      feedback.classList.remove('hidden', 'text-rose-700', 'text-emerald-700');
      feedback.classList.add(ok ? 'text-emerald-700' : 'text-rose-700');
    };

    const createRequestedProduct = async () => {
      const container = window.Swal?.getHtmlContainer?.();
      if (!container || state.saving) return;

      const input = container.querySelector('[data-rp-new-name]');
      if (!input) return;

      const name = String(input.value || '').trim();
      if (!name) {
        showFeedback('Escribe el nombre del producto solicitado.');
        return;
      }

      state.saving = true;
      try {
        const response = await fetch(createUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
            'X-CSRF-Token': csrfToken,
          },
          credentials: 'same-origin',
          body: JSON.stringify({ name }),
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'No se pudo registrar el producto solicitado.');

        upsertRow(data.requested_product);
        input.value = '';
        showFeedback(data.created ? 'Producto solicitado agregado.' : 'Producto existente actualizado con una nueva solicitud.', true);
        render();
      } catch (error) {
        showFeedback(error.message || 'No se pudo registrar el producto solicitado.');
      } finally {
        state.saving = false;
      }
    };

    const incrementRequestedProduct = async (id) => {
      if (!id || !incrementTemplate) return;
      const rowId = String(id || '').trim();
      if (!rowId) return;

      const optimisticRow = findRowById(rowId);
      if (optimisticRow) {
        optimisticRow.requests_count = Number(optimisticRow.requests_count || 0) + 1;
        render();
      }

      incrementPendingRequests(rowId);

      try {
        const response = await fetch(incrementTemplate.replace('__ID__', rowId), {
          method: 'PATCH',
          headers: {
            Accept: 'application/json',
            'X-CSRF-Token': csrfToken,
          },
          credentials: 'same-origin',
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'No se pudo actualizar la solicitud.');

        const visibleCountBeforeMerge = Number(findRowById(rowId)?.requests_count || 0);
        upsertRow(data.requested_product);

        const mergedRow = findRowById(rowId);
        if (mergedRow) {
          mergedRow.requests_count = Math.max(Number(mergedRow.requests_count || 0), visibleCountBeforeMerge);
        }

        render();
      } catch (error) {
        const rollbackRow = findRowById(rowId);
        if (rollbackRow) {
          rollbackRow.requests_count = Math.max(Number(rollbackRow.requests_count || 0) - 1, 0);
          render();
        }
        showFeedback(error.message || 'No se pudo actualizar la solicitud.');
      } finally {
        decrementPendingRequests(rowId);
        render();
      }
    };

    const saveRequestedProductName = async (id) => {
      const rowId = String(id || '').trim();
      if (!rowId || !updateTemplate) return;

      const container = window.Swal?.getHtmlContainer?.();
      const input = container?.querySelector(`[data-rp-edit-input="${rowId}"]`);
      const name = String(input?.value || '').trim();
      if (!name) {
        showFeedback('Debes indicar el nombre del producto solicitado.');
        return;
      }

      try {
        const response = await fetch(updateTemplate.replace('__ID__', rowId), {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
            'X-CSRF-Token': csrfToken,
          },
          credentials: 'same-origin',
          body: JSON.stringify({ name }),
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'No se pudo actualizar el nombre.');

        upsertRow(data.requested_product);
        state.editingRowId = null;
        showFeedback('Nombre actualizado correctamente.', true);
        render();
      } catch (error) {
        showFeedback(error.message || 'No se pudo actualizar el nombre.');
      }
    };

    const deleteRequestedProduct = async (id) => {
      const rowId = String(id || '').trim();
      if (!rowId || !deleteTemplate || !canDelete) return;

      const allowDelete = window.confirm('Se eliminara este producto solicitado y su historial. Deseas continuar?');

      if (!allowDelete) return;

      try {
        const response = await fetch(deleteTemplate.replace('__ID__', rowId), {
          method: 'DELETE',
          headers: {
            Accept: 'application/json',
            'X-CSRF-Token': csrfToken,
          },
          credentials: 'same-origin',
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'No se pudo eliminar el producto solicitado.');

        state.rows = state.rows.filter((row) => String(row.id) !== rowId);
        state.expandedRowIds.delete(rowId);
        if (state.editingRowId === rowId) state.editingRowId = null;
        showFeedback('Producto solicitado eliminado.', true);
        render();
      } catch (error) {
        showFeedback(error.message || 'No se pudo eliminar el producto solicitado.');
      }
    };

    const modalHtml = `
      <div class="space-y-3 text-left">
        <div data-rp-loader class="flex min-h-[240px] flex-col items-center justify-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/70">
          <div class="h-10 w-10 animate-spin rounded-full border-4 border-slate-200 border-t-indigo-600"></div>
          <p class="text-sm font-medium text-slate-600">Cargando solicitudes...</p>
        </div>

        <div data-rp-content class="hidden space-y-3">
          <div class="rounded-2xl border border-indigo-200 bg-indigo-50/60 p-3">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
              <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Productos solicitados por clientes</p>
              <p class="text-xs font-semibold text-slate-600">Total: <span data-rp-total>0</span></p>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-indigo-800">Este es un apartado para anadir productos solicitados por clientes y el numero de solicitudes, para llevar un mejor control correcto solo anexe un producto o sume una cantidad por cada vez que un cliente directamente le haya consultado a usted por x producto. Si toca la descripcion de un producto se desplegara la cantidad de veces y usuarios que indicaron la solicitud de un producto, use este apartado de forma profesional y responsable. No debe anadirse ningun producto que ya este registrado en el inventario aunque el producto este agotado, este control de solicitudes no corresponde para eso.</p>
          </div>

          <div class="grid gap-2 md:grid-cols-[1fr_auto]">
            <input type="text" data-rp-search class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" placeholder="Buscar por descripcion">
            <div class="flex gap-2">
              <input type="text" data-rp-new-name class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" placeholder="Nuevo producto solicitado">
              <button type="button" data-rp-add class="inline-flex items-center rounded-xl bg-indigo-600 px-3 py-2 text-xs font-semibold text-white hover:bg-indigo-700">Agregar</button>
            </div>
          </div>

          <p data-rp-feedback class="hidden text-xs font-semibold"></p>

          <div class="overflow-hidden rounded-xl border border-slate-200">
            <div class="max-h-72 overflow-y-auto">
              <table class="min-w-full text-left">
                <thead class="sticky top-0 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    <th class="px-3 py-2">Descripcion</th>
                    <th class="px-3 py-2 text-right">Cantidad de solicitudes</th>
                    <th class="px-3 py-2 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody data-rp-table-body></tbody>
              </table>
            </div>
            <div data-rp-empty class="px-3 py-4 text-sm text-slate-500">No hay productos solicitados.</div>
          </div>
        </div>
      </div>
    `;

    const bindModalEvents = () => {
      const container = window.Swal?.getHtmlContainer?.();
      if (!container) return;

      const searchInput = container.querySelector('[data-rp-search]');
      const addButton = container.querySelector('[data-rp-add]');
      const newNameInput = container.querySelector('[data-rp-new-name]');
      const tbody = container.querySelector('[data-rp-table-body]');

      if (searchInput) {
        searchInput.addEventListener('input', (event) => {
          state.query = String(event.target.value || '');
          render();
        });
      }

      if (addButton) {
        addButton.addEventListener('click', createRequestedProduct);
      }

      if (newNameInput) {
        newNameInput.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter') return;
          event.preventDefault();
          createRequestedProduct();
        });
      }

      if (tbody) {
        tbody.addEventListener('click', (event) => {
          const editButton = event.target.closest('[data-rp-edit]');
          if (editButton) {
            const id = editButton.getAttribute('data-rp-edit');
            startEditRow(id);
            return;
          }

          const cancelButton = event.target.closest('[data-rp-cancel-edit]');
          if (cancelButton) {
            cancelEditRow();
            return;
          }

          const saveButton = event.target.closest('[data-rp-save]');
          if (saveButton) {
            const id = saveButton.getAttribute('data-rp-save');
            saveRequestedProductName(id);
            return;
          }

          const deleteButton = event.target.closest('[data-rp-delete]');
          if (deleteButton) {
            const id = deleteButton.getAttribute('data-rp-delete');
            deleteRequestedProduct(id);
            return;
          }

          const toggleButton = event.target.closest('[data-rp-toggle]');
          if (toggleButton) {
            const id = toggleButton.getAttribute('data-rp-toggle');
            toggleRowDetails(id);
            return;
          }

          const button = event.target.closest('[data-rp-increment]');
          if (!button) return;
          const id = button.getAttribute('data-rp-increment');
          incrementRequestedProduct(id);
        });
      }
    };

      trigger.addEventListener('click', async () => {
        if (!window.Swal) return;

        state.rows = [];
        state.query = '';
        state.expandedRowIds = new Set();
        state.editingRowId = null;

        await window.Swal.fire({
          title: 'Solicitudes de productos',
          html: modalHtml,
          width: 860,
          showCloseButton: true,
          showConfirmButton: false,
          showCancelButton: true,
          cancelButtonText: 'Cerrar',
          heightAuto: false,
          didOpen: async () => {
            setLoading(true);
            bindModalEvents();
            await fetchList();
          },
        });
      });
    };

    if (!window.requestedProductsModalLifecycleBound) {
      window.requestedProductsModalLifecycleBound = true;
      document.addEventListener('turbo:load', setupRequestedProductsModal);
      document.addEventListener('DOMContentLoaded', setupRequestedProductsModal);
    }

    setupRequestedProductsModal();
  })();

  (() => {
    if (window.notificationsTooltipHandlersBound) return;
    window.notificationsTooltipHandlersBound = true;

    const getElements = () => {
      const wrapper = document.getElementById('notifications-tooltip');
      if (!wrapper) return null;
      const button = document.getElementById('notifications-toggle');
      const panel = document.getElementById('notifications-panel');
      if (!button || !panel) return null;
      return { button, panel };
    };

    const closePanel = () => {
      const elements = getElements();
      if (!elements) return;
      elements.panel.classList.add('hidden');
      elements.button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const elements = getElements();
      if (!elements) return;

      const { button, panel } = elements;
      const clickedButton = button.contains(event.target);
      const clickedPanel = panel.contains(event.target);

      if (clickedButton) {
        panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', panel.classList.contains('hidden') ? 'false' : 'true');
        return;
      }

      if (!clickedPanel) {
        closePanel();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closePanel();
    });
  })();

  (() => {
    if (window.recargaSummaryTooltipHandlersBound) return;
    window.recargaSummaryTooltipHandlersBound = true;

    const getElements = () => {
      const wrapper = document.getElementById('recarga-summary-tooltip');
      if (!wrapper) return null;
      const button = document.getElementById('recarga-summary-toggle');
      const panel = document.getElementById('recarga-summary-panel');
      if (!button || !panel) return null;
      return { button, panel };
    };

    const closePanel = () => {
      const elements = getElements();
      if (!elements) return;
      elements.panel.classList.add('hidden');
      elements.button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const elements = getElements();
      if (!elements) return;

      const { button, panel } = elements;
      const clickedButton = button.contains(event.target);
      const clickedPanel = panel.contains(event.target);

      if (clickedButton) {
        panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', panel.classList.contains('hidden') ? 'false' : 'true');
        return;
      }

      if (!clickedPanel) {
        closePanel();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closePanel();
    });
  })();

  (() => {
    if (window.notificationsDismissAnimationBound) return;
    window.notificationsDismissAnimationBound = true;

    document.addEventListener('submit', (event) => {
      const form = event.target.closest('.js-dismiss-header-notification-form');
      if (!form) return;

      const itemId = form.dataset.itemId;
      const item = itemId ? document.getElementById(itemId) : null;
      if (!item || form.dataset.animating === 'true') return;

      event.preventDefault();
      form.dataset.animating = 'true';

      item.style.transition = 'transform 220ms ease, opacity 220ms ease, margin 220ms ease';
      item.style.transform = 'translateX(42px)';
      item.style.opacity = '0';
      item.style.marginTop = '0';
      item.style.marginBottom = '0';

      window.setTimeout(() => {
        if (window.Turbo && typeof window.Turbo.navigator?.submitForm === 'function') {
          window.Turbo.navigator.submitForm(form);
        } else {
          form.submit();
        }
      }, 230);
    });
  })();
</script>