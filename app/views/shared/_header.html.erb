<header class="h-14 md:h-20 flex-none glass border-b border-sky-100 flex items-center justify-between px-4 md:px-6 z-10">
  <% header_cashea_account = current_business&.accounts&.where(account_type: 'cashea', active: true)&.ordered_by_group_and_name&.first %>
  <div class="flex items-center gap-4">
    <% if @businesses.present? %>
      <div id="business-switcher" class="relative">
        <button id="business-switcher-button" type="button" class="group flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-2 shadow-sm hover:border-sky-200 hover:bg-sky-50 transition-colors cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Cambiar negocio">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl text-sm font-bold" style="<%= current_business ? current_business.theme_preview_style : Business.theme_preview_style %>">
            <%= current_business&.name.to_s.first&.upcase || 'N' %>
          </span>
          <span class="hidden md:block text-left">
            <span class="block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Negocio</span>
            <span class="block text-sm font-semibold text-slate-800"><%= current_business&.name || 'Sin negocio' %></span>
          </span>
          <i data-lucide="chevron-down" class="hidden md:block h-4 w-4 text-slate-400 group-hover:text-slate-600"></i>
        </button>
        <div id="business-switcher-menu" class="absolute left-0 mt-3 hidden w-72 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
          <div class="border-b border-slate-100 px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Selecciona un negocio</p>
            <p class="mt-1 text-sm font-semibold text-slate-800"><%= current_business&.name || 'Sin negocio' %></p>
          </div>
          <div class="max-h-64 overflow-y-auto py-2">
            <% @businesses.each do |business| %>
              <% is_current = current_business&.id == business.id %>
              <% item_classes = is_current ? 'bg-sky-50 text-sky-700' : 'text-slate-700 hover:bg-slate-50' %>
              <% if current_user_admin? || Current.user&.assigned_to_business?(business) %>
                <%= button_to select_business_path(business), method: :post, form: { class: 'w-full', data: { turbo: false } }, class: "flex w-full items-center gap-3 px-4 py-2 text-left text-sm transition-colors cursor-pointer #{item_classes}", data: { turbo: false } do %>
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold" style="<%= business.theme_preview_style %>">
                    <%= business.name.to_s.first&.upcase || 'N' %>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-medium"><%= business.name %></span>
                  </span>
                  <% if is_current %>
                    <i data-lucide="check" class="h-4 w-4"></i>
                  <% end %>
                <% end %>
              <% else %>
                <div class="flex w-full items-center gap-3 px-4 py-2 text-sm <%= item_classes %>">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold" style="<%= business.theme_preview_style %>">
                    <%= business.name.to_s.first&.upcase || 'N' %>
                  </span>
                  <span class="min-w-0 flex-1 truncate font-medium"><%= business.name %></span>
                  <% if is_current %>
                    <i data-lucide="check" class="h-4 w-4"></i>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
          <% if current_user_admin? %>
            <div class="border-t border-slate-100 bg-slate-50 px-4 py-3 flex items-center justify-between">
              <%= link_to businesses_path, class: 'text-sm font-semibold text-slate-600 hover:text-slate-800' do %>
                Administrar
              <% end %>
              <%= link_to new_business_path, class: 'inline-flex items-center gap-1 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800' do %>
                <i data-lucide="plus" class="h-3.5 w-3.5"></i>
                Nuevo
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <% if current_user_admin? %>
        <%= link_to new_business_path, class: 'inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800' do %>
          <i data-lucide="plus" class="h-4 w-4"></i>
          <span class="hidden md:inline">Crear negocio</span>
        <% end %>
      <% else %>
        <span class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-500">Sin negocio asignado</span>
      <% end %>
    <% end %>
  </div>
  <div class="flex items-center gap-3 md:gap-5" data-header-current-user-id="<%= Current.user&.id %>" data-header-current-user-admin="<%= current_user_admin? ? 'true' : 'false' %>">
    <% if controller_name == 'ventas' && action_name == 'index' %>
      <% can_manage_cash_shifts = can_manage_action?(:manage_cash_shifts) %>
      <% customer_sales_mode_header = Current.user&.customer_mode?(current_business) %>
      <% unless customer_sales_mode_header %>
        <% if @open_cash_shift.present? %>
          <%= link_to cash_shift_path(@open_cash_shift), class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-emerald-100' do %>
            <i data-lucide="clock-3" class="h-4 w-4"></i>
            <span class="hidden lg:inline">Turno #<%= @open_cash_shift.id %> abierto</span>
            <span class="lg:hidden">Turno #<%= @open_cash_shift.id %></span>
          <% end %>
        <% elsif can_manage_cash_shifts %>
          <button type="button"
                  id="ventas-open-cash-shift-trigger"
                  data-create-url="<%= cash_shifts_path %>"
                  data-opening-balances="<%= ERB::Util.json_escape((@open_shift_balance_checks_payload || []).to_json) %>"
            data-last-closed-shift-url="<%= @last_closed_cash_shift.present? ? cash_shift_path(@last_closed_cash_shift) : '' %>"
                  class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-amber-100">
            <i data-lucide="play" class="h-4 w-4"></i>
            <span class="hidden lg:inline">Abrir turno</span>
          </button>
        <% else %>
          <span class="hidden lg:inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600">
            Espera al encargado para abrir turno
          </span>
        <% end %>
      <% end %>
    <% end %>
    <% if Rails.env.development? && current_user_admin? %>
      <%= link_to sandbox_mercantil_c2p_search_path,
                  class: 'hidden lg:inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-violet-200 bg-violet-50 px-3 py-2 text-sm font-semibold text-violet-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-violet-100',
                  data: { turbo_frame: '_top' } do %>
        <i data-lucide="flask-conical" class="h-4 w-4"></i>
        Sandbox C2P
      <% end %>
    <% end %>
    <button id="theme-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-slate-600 shadow-sm ring-1 ring-slate-200 transition-all hover:-translate-y-0.5 hover:bg-slate-50" aria-label="Cambiar modo oscuro">
      <span data-theme-icon="dark">
        <i data-lucide="moon" class="h-5 w-5"></i>
      </span>
      <span data-theme-icon="light" class="hidden">
        <i data-lucide="sun" class="h-5 w-5"></i>
      </span>
    </button>
    <div id="rates-tooltip" class="relative">
      <button id="rates-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-200/85 text-slate-700 shadow-sm ring-1 ring-slate-300 transition-colors hover:bg-slate-300 hover:text-slate-900 cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Ver tasas">
        <i data-lucide="line-chart" class="w-5 h-5"></i>
      </button>
      <div id="rates-panel" class="absolute right-0 mt-3 hidden w-80 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
        <div class="border-b border-slate-100 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Tasas registradas</p>
          <p class="mt-1 text-sm font-semibold text-slate-800">Valores mas recientes</p>
        </div>
        <div class="max-h-64 overflow-y-auto py-2">
          <% if @latest_tasas.present? %>
            <% @latest_tasas.each do |tasa| %>
              <% fecha_label = tasa.fecha_referencia&.strftime('%d/%m/%Y') || '-' %>
              <div class="flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-slate-50">
                <p class="truncate text-sm font-semibold text-slate-800"><%= tasa.description %></p>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-slate-800 whitespace-nowrap"><%= format_money(tasa.valor, unit: 'Bs') %></span>
                  <span class="text-xs text-slate-500 whitespace-nowrap"><%= fecha_label %></span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="px-4 py-4 text-sm text-slate-500">No hay tasas registradas.</div>
          <% end %>
        </div>
      </div>
    </div>
    <div id="recarga-summary-tooltip" class="relative">
      <button id="recarga-summary-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-cyan-100 text-cyan-700 shadow-sm ring-1 ring-cyan-200 transition-colors hover:bg-cyan-200 hover:text-cyan-900 cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Ver resumen de recargas">
        <i data-lucide="smartphone" class="w-5 h-5"></i>
      </button>
      <div id="recarga-summary-panel" class="absolute right-0 mt-3 hidden w-96 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
        <div class="border-b border-slate-100 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Resumen de parametros de recarga</p>
          <p class="mt-1 text-sm font-semibold text-slate-800">Recarga minima configurada por servicio</p>
        </div>
        <div class="max-h-80 overflow-y-auto p-3">
          <% if @header_recarga_summary.present? %>
            <table class="w-full text-left text-sm text-slate-700">
              <thead>
                <tr class="border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                  <th class="px-2 py-2">Sistema</th>
                  <th class="px-2 py-2 text-right">Recarga minima</th>
                </tr>
              </thead>
              <tbody>
                <% @header_recarga_summary.each do |row| %>
                  <tr class="border-b border-slate-100 last:border-0">
                    <td class="px-2 py-2">
                      <p class="font-semibold text-slate-800"><%= row[:service_name] %></p>
                      <p class="text-xs text-slate-500"><%= row[:system_name] %></p>
                    </td>
                    <td class="px-2 py-2 text-right font-semibold text-slate-800">
                      <%= row[:min_amount].present? ? format_money(row[:min_amount], unit: 'Bs') : '-' %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="px-2 py-2 text-sm text-slate-500">No hay servicios de recarga configurados.</p>
          <% end %>
        </div>
        <% if current_user_admin? %>
          <div class="border-t border-slate-100 bg-slate-50 px-4 py-3">
            <%= link_to recarga_parameters_services_path,
                        class: 'inline-flex items-center gap-2 text-sm font-semibold text-cyan-700 hover:text-cyan-900',
                        data: { turbo_frame: '_top' } do %>
              <i data-lucide="settings-2" class="h-4 w-4"></i>
              Configurar parametros de recarga
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <div id="cashea-levels-tooltip" class="relative">
      <button id="cashea-levels-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-white shadow-sm ring-1 ring-amber-200 transition-colors hover:bg-amber-50 cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Ver iniciales Cashea">
        <%= image_tag 'logo cashea.jpg', class: 'h-full w-full object-cover object-center', alt: 'Cashea' %>
      </button>
      <div id="cashea-levels-panel" class="absolute right-0 mt-3 hidden w-80 overflow-hidden rounded-2xl border border-amber-200 bg-white shadow-xl">
        <div class="border-b border-amber-100 bg-amber-50 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Niveles Cashea</p>
          <p class="mt-1 text-sm font-semibold text-slate-800">Inicial permitido por nivel</p>
        </div>
        <div class="p-3">
          <% if header_cashea_account.present? %>
            <div class="space-y-1.5">
              <% 1.upto(6) do |level| %>
                <% percent = header_cashea_account.public_send("cashea_level_#{level}_initial_percent").to_d %>
                <div class="flex items-center justify-between rounded-lg border border-slate-100 px-3 py-2">
                  <span class="text-sm font-semibold text-slate-700">Nivel <%= level %></span>
                  <span class="text-sm font-bold text-amber-700"><%= number_with_precision(percent, precision: 2, strip_insignificant_zeros: true) %>%</span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-slate-500">Cashea no esta configurado para este negocio.</p>
          <% end %>
        </div>
        <% if current_user_admin? %>
          <div class="border-t border-slate-100 bg-slate-50 px-4 py-3">
            <% if header_cashea_account.present? %>
              <%= link_to edit_account_path(header_cashea_account), class: 'inline-flex items-center gap-2 text-sm font-semibold text-amber-700 hover:text-amber-900', data: { turbo_frame: '_top' } do %>
                <i data-lucide="settings-2" class="h-4 w-4"></i>
                Configurar niveles
              <% end %>
            <% else %>
              <%= link_to accounts_path, class: 'inline-flex items-center gap-2 text-sm font-semibold text-amber-700 hover:text-amber-900', data: { turbo_frame: '_top' } do %>
                <i data-lucide="wallet-cards" class="h-4 w-4"></i>
                Configurar cuenta Cashea
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <%= render 'shared/header_notifications' %>
    <!-- Mobile Profile Icon -->
    <div class="md:hidden h-8 w-8 overflow-hidden rounded-full border border-sky-200 bg-sky-100">
      <% if Current.user&.avatar&.attached? %>
        <%= image_tag Current.user.avatar, class: 'h-full w-full object-cover', alt: Current.user.display_name %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center text-xs font-bold text-sky-700"><%= Current.user&.display_name.to_s.first&.upcase || 'U' %></div>
      <% end %>
    </div>
  </div>
</header>
<script>
  (() => {
    if (window.businessSwitcherHandlersBound) return;
    window.businessSwitcherHandlersBound = true;

    const getElements = () => {
      const switcher = document.getElementById('business-switcher');
      if (!switcher) return null;
      const button = document.getElementById('business-switcher-button');
      const menu = document.getElementById('business-switcher-menu');
      if (!button || !menu) return null;
      return { button, menu };
    };

    const closeMenu = () => {
      const elements = getElements();
      if (!elements) return;
      elements.menu.classList.add('hidden');
      elements.button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const elements = getElements();
      if (!elements) return;

      const { button, menu } = elements;
      const clickedButton = button.contains(event.target);
      const clickedMenu = menu.contains(event.target);

      if (clickedButton) {
        menu.classList.toggle('hidden');
        button.setAttribute('aria-expanded', menu.classList.contains('hidden') ? 'false' : 'true');
        return;
      }

      if (!clickedMenu) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeMenu();
    });
  })();

  (() => {
    if (window.ratesTooltipHandlersBound) return;
    window.ratesTooltipHandlersBound = true;

    const getElements = () => {
      const wrapper = document.getElementById('rates-tooltip');
      if (!wrapper) return null;
      const button = document.getElementById('rates-toggle');
      const panel = document.getElementById('rates-panel');
      if (!button || !panel) return null;
      return { button, panel };
    };

    const closePanel = () => {
      const elements = getElements();
      if (!elements) return;
      elements.panel.classList.add('hidden');
      elements.button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const elements = getElements();
      if (!elements) return;

      const { button, panel } = elements;
      const clickedButton = button.contains(event.target);
      const clickedPanel = panel.contains(event.target);

      if (clickedButton) {
        panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', panel.classList.contains('hidden') ? 'false' : 'true');
        return;
      }

      if (!clickedPanel) {
        closePanel();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closePanel();
    });
  })();

  (() => {
    if (window.casheaLevelsTooltipHandlersBound) return;
    window.casheaLevelsTooltipHandlersBound = true;

    const closePanel = () => {
      const wrapper = document.getElementById('cashea-levels-tooltip');
      const button = document.getElementById('cashea-levels-toggle');
      const panel = document.getElementById('cashea-levels-panel');
      if (!wrapper || !button || !panel) return;
      panel.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const wrapper = document.getElementById('cashea-levels-tooltip');
      const button = document.getElementById('cashea-levels-toggle');
      const panel = document.getElementById('cashea-levels-panel');
      if (!wrapper || !button || !panel) return;

      if (button.contains(event.target)) {
        const isHidden = panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        return;
      }

      if (!panel.contains(event.target)) closePanel();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closePanel();
    });
  })();

  (() => {
    if (window.notificationsTooltipHandlersBound) return;
    window.notificationsTooltipHandlersBound = true;

    const getElements = () => {
      const wrapper = document.getElementById('notifications-tooltip');
      if (!wrapper) return null;
      const button = document.getElementById('notifications-toggle');
      const panel = document.getElementById('notifications-panel');
      if (!button || !panel) return null;
      return { button, panel };
    };

    const closePanel = () => {
      const elements = getElements();
      if (!elements) return;
      elements.panel.classList.add('hidden');
      elements.button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const elements = getElements();
      if (!elements) return;

      const { button, panel } = elements;
      const clickedButton = button.contains(event.target);
      const clickedPanel = panel.contains(event.target);

      if (clickedButton) {
        panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', panel.classList.contains('hidden') ? 'false' : 'true');
        return;
      }

      if (!clickedPanel) {
        closePanel();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closePanel();
    });
  })();

  (() => {
    if (window.recargaSummaryTooltipHandlersBound) return;
    window.recargaSummaryTooltipHandlersBound = true;

    const getElements = () => {
      const wrapper = document.getElementById('recarga-summary-tooltip');
      if (!wrapper) return null;
      const button = document.getElementById('recarga-summary-toggle');
      const panel = document.getElementById('recarga-summary-panel');
      if (!button || !panel) return null;
      return { button, panel };
    };

    const closePanel = () => {
      const elements = getElements();
      if (!elements) return;
      elements.panel.classList.add('hidden');
      elements.button.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const elements = getElements();
      if (!elements) return;

      const { button, panel } = elements;
      const clickedButton = button.contains(event.target);
      const clickedPanel = panel.contains(event.target);

      if (clickedButton) {
        panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', panel.classList.contains('hidden') ? 'false' : 'true');
        return;
      }

      if (!clickedPanel) {
        closePanel();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closePanel();
    });
  })();

  (() => {
    if (window.notificationsDismissAnimationBound) return;
    window.notificationsDismissAnimationBound = true;

    document.addEventListener('submit', (event) => {
      const form = event.target.closest('.js-dismiss-header-notification-form');
      if (!form) return;

      const itemId = form.dataset.itemId;
      const item = itemId ? document.getElementById(itemId) : null;
      if (!item || form.dataset.animating === 'true') return;

      event.preventDefault();
      form.dataset.animating = 'true';

      item.style.transition = 'transform 220ms ease, opacity 220ms ease, margin 220ms ease';
      item.style.transform = 'translateX(42px)';
      item.style.opacity = '0';
      item.style.marginTop = '0';
      item.style.marginBottom = '0';

      window.setTimeout(() => {
        if (window.Turbo && typeof window.Turbo.navigator?.submitForm === 'function') {
          window.Turbo.navigator.submitForm(form);
        } else {
          form.submit();
        }
      }, 230);
    });
  })();
</script>