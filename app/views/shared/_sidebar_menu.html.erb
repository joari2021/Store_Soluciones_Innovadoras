<% close_modal = local_assigns.fetch(:close_modal, false) %>
<% close_attrs = close_modal ? { onclick: "closeModal('sidebarModal')" } : {} %>
<% if current_user_admin? %>
  <%= link_to dashboard_path, close_attrs.merge(class: "nav-btn w-full flex items-center gap-4 p-3.5 rounded-2xl transition-all hover:bg-sky-50 group no-underline hover:no-underline text-slate-700", data: { tooltip: 'Dashboard' }) do %>
    <i data-lucide="line-chart" class="w-5 h-5 group-hover:text-sky-500 transition-colors"></i>
    <span class="sidebar-label">Dashboard</span>
  <% end %>
<% end %>
