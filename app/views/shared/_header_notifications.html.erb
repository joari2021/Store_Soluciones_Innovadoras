<div id="notifications-tooltip" class="relative">
  <button id="notifications-toggle" type="button" class="relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-200/85 text-slate-700 shadow-sm ring-1 ring-slate-300 transition-colors hover:bg-slate-300 hover:text-slate-900 cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Ver notificaciones">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
      <path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5" />
      <path d="M9 17a3 3 0 0 0 6 0" />
    </svg>
    <span id="notifications-indicator">
      <%= render 'shared/header_notifications_indicator' %>
    </span>
  </button>
  <div id="notifications-panel" class="absolute right-0 mt-3 hidden w-96 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
    <div class="border-b border-slate-100 px-4 py-3">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Notificaciones</p>
      <p class="mt-1 text-sm font-semibold text-slate-800">Resumen de pendientes</p>
    </div>
    <%= render 'shared/header_notifications_list' %>
  </div>
</div>