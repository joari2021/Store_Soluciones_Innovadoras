 <!--==================== NAV ====================-->
<aside class="app-sidebar w-72 bg-white/80 border-r border-sky-100 hidden md:flex flex-col backdrop-blur-md z-20">
  <div class="flex items-center justify-center px-6 pt-5">
    <button id="sidebar-toggle" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-slate-50" aria-label="Colapsar sidebar">
      <i data-lucide="panel-left" class="h-5 w-5"></i>
    </button>
  </div>
  <div class="p-5">
    <% active_business = current_business %>
    <div class="flex justify-center">
      <div class="sidebar-logo h-20 w-20 overflow-hidden rounded-full border border-sky-100 bg-white shadow-md">
        <% if active_business&.logo&.attached? %>
          <%= image_tag active_business.logo, class: 'h-full w-full object-cover', alt: "Logo de #{active_business.name}" %>
        <% else %>
          <div class="flex h-full w-full items-center justify-center text-sky-600">
            <i data-lucide="building-2" class="h-8 w-8"></i>
          </div>
        <% end %>
      </div>
    </div>
  </div>
    <nav class="sidebar-nav-scroll flex-1 min-h-0 overflow-y-auto px-6 pr-4 space-y-2 mt-2">
    <%= render "shared/sidebar_menu" %>
  </nav>
  <div class="p-4 border-t border-sky-100/50">
    <div class="sidebar-user-card flex items-center gap-3 p-2.5 bg-gradient-to-r from-sky-50 to-white rounded-2xl border border-sky-100">
      <div class="sidebar-user-avatar flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-white shadow-md">
        <% if Current.user&.avatar&.attached? %>
          <%= image_tag Current.user.avatar, class: 'h-full w-full object-cover', alt: Current.user.display_name %>
        <% else %>
          <span class="text-sm font-bold text-sky-700"><%= Current.user&.display_name.to_s.first&.upcase || 'U' %></span>
        <% end %>
      </div>
      <div class="sidebar-user-details text-sm overflow-hidden">
        <p class="font-bold text-slate-700 truncate"><%= Current.user&.display_name %></p>
        <p class="text-xs text-sky-500 truncate"><%= current_user_role_label %></p>
        <p class="text-[11px] text-slate-400 truncate"><%= current_business&.name %></p>
      </div>
    </div>
    <%= link_to logout_path,
          data: { turbo_method: :delete, swal_delete: 'logout', tooltip: 'Cerrar sesion' },
          class: 'sidebar-logout nav-btn mt-3 inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100' do %>
      <i data-lucide="log-out" class="h-4 w-4"></i>
      <span class="sidebar-logout-label">Cerrar sesion</span>
    <% end %>
  </div>
</aside>
