<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Editar costo global</h1>
        <p class="mt-1 text-sm text-slate-500"><%= @global_supplier_product.global_supplier&.name %> · <%= @global_supplier_product.global_product&.name %></p>
      </div>
      <%= link_to edit_global_supplier_path(@global_supplier_product.global_supplier_id), class: "inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
        Volver
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with model: @global_supplier_product, local: true, class: "space-y-4" do |f| %>
      <% if @global_supplier_product.errors.any? %>
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <ul class="list-disc pl-5">
            <% @global_supplier_product.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid gap-4 md:grid-cols-3">
        <div>
          <%= f.label :costo_mayor, "Costo mayor", class: "block text-sm font-medium text-slate-700" %>
          <%= f.number_field :costo_mayor, step: 0.01, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>

        <div>
          <%= f.label :cantidad, "Cantidad", class: "block text-sm font-medium text-slate-700" %>
          <%= f.number_field :cantidad, step: 0.01, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>

        <div>
          <%= f.label :costo_menor, "Costo menor", class: "block text-sm font-medium text-slate-700" %>
          <%= f.number_field :costo_menor, step: 0.01, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <%= f.submit "Guardar y sincronizar", class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
