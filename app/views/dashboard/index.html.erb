<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Dashboard financiero</h1>
        <p class="mt-1 text-sm text-slate-500">Utilidad de ventas por productos, servicios y relacion con pasivos/gastos.</p>
      </div>
      <%= form_with url: dashboard_path, method: :get, local: true, class: 'grid gap-2 sm:grid-cols-[auto_auto_auto] sm:items-end' do %>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">Desde</label>
          <%= date_field_tag :from, @from_date, class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">Hasta</label>
          <%= date_field_tag :to, @to_date, class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">Actualizar</button>
      <% end %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Utilidad productos</p>
      <p class="mt-2 text-2xl font-extrabold text-emerald-600"><%= format_money(@metrics[:product_profit_usd], unit: '$') %></p>
      <p class="mt-1 text-xs text-slate-500">Ingreso: <%= format_money(@metrics[:product_revenue_usd], unit: '$') %> | Costo: <%= format_money(@metrics[:product_cost_usd], unit: '$') %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Utilidad servicios</p>
      <p class="mt-2 text-2xl font-extrabold text-cyan-700"><%= format_money(@metrics[:service_profit_usd], unit: '$') %></p>
      <p class="mt-1 text-xs text-slate-500">Ingreso: <%= format_money(@metrics[:service_revenue_usd], unit: '$') %> | Costo: <%= format_money(@metrics[:service_cost_usd], unit: '$') %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Ganancia bruta</p>
      <p class="mt-2 text-2xl font-extrabold text-slate-800"><%= format_money(@metrics[:gross_profit_usd], unit: '$') %></p>
      <p class="mt-1 text-xs text-slate-500">Ventas pagadas: <%= @metrics[:sales_count] %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Ganancia neta (menos gastos)</p>
      <p class="mt-2 text-2xl font-extrabold <%= @metrics[:net_profit_after_expenses_usd].to_d >= 0 ? 'text-emerald-600' : 'text-rose-600' %>"><%= format_money(@metrics[:net_profit_after_expenses_usd], unit: '$') %></p>
      <p class="mt-1 text-xs text-slate-500">Gastos pagados: <%= format_money(@metrics[:expense_paid_usd], unit: '$') %></p>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-lg font-semibold text-slate-800">Tendencia mensual</h2>
      <span class="text-xs text-slate-500">Ingreso vs costo vs utilidad</span>
    </div>
    <% max_value = @monthly_rows.flat_map { |row| [row[:revenue], row[:cost], row[:profit].abs] }.max.to_d %>
    <% max_value = 1.to_d if max_value <= 0 %>
    <div class="mt-4 space-y-3">
      <% if @monthly_rows.any? %>
        <% @monthly_rows.each do |row| %>
          <% revenue_width = [(row[:revenue].to_d / max_value * 100).to_f, 2].max %>
          <% cost_width = [(row[:cost].to_d / max_value * 100).to_f, 2].max %>
          <% profit_width = [(row[:profit].to_d.abs / max_value * 100).to_f, 2].max %>
          <div class="rounded-xl border border-slate-100 bg-slate-50 p-3">
            <div class="mb-2 flex items-center justify-between text-xs font-semibold text-slate-600">
              <span><%= row[:label] %></span>
              <span>Utilidad: <%= format_money(row[:profit], unit: '$') %></span>
            </div>
            <div class="space-y-1.5">
              <div>
                <div class="h-2.5 rounded-full bg-slate-200">
                  <div class="h-2.5 rounded-full bg-sky-500" style="width: <%= revenue_width %>%"></div>
                </div>
                <p class="mt-1 text-[11px] text-slate-500">Ingreso: <%= format_money(row[:revenue], unit: '$') %></p>
              </div>
              <div>
                <div class="h-2.5 rounded-full bg-slate-200">
                  <div class="h-2.5 rounded-full bg-amber-500" style="width: <%= cost_width %>%"></div>
                </div>
                <p class="mt-1 text-[11px] text-slate-500">Costo: <%= format_money(row[:cost], unit: '$') %></p>
              </div>
              <div>
                <div class="h-2.5 rounded-full bg-slate-200">
                  <div class="h-2.5 rounded-full <%= row[:profit].to_d >= 0 ? 'bg-emerald-500' : 'bg-rose-500' %>" style="width: <%= profit_width %>%"></div>
                </div>
                <p class="mt-1 text-[11px] text-slate-500">Utilidad: <%= format_money(row[:profit], unit: '$') %></p>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-500">No hay ventas pagadas en el rango seleccionado.</p>
      <% end %>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-800">Gastos pagados (USD)</h2>
      <div class="mt-3 space-y-2">
        <% if @expense_rows.any? %>
          <% max_expense = @expense_rows.map { |row| row[:amount_usd] }.max.to_d %>
          <% max_expense = 1.to_d if max_expense <= 0 %>
          <% @expense_rows.first(8).each do |row| %>
            <% width = [(row[:amount_usd].to_d / max_expense * 100).to_f, 2].max %>
            <div>
              <div class="flex items-center justify-between text-xs text-slate-600">
                <span class="truncate pr-2"><%= row[:label] %></span>
                <span class="font-semibold"><%= format_money(row[:amount_usd], unit: '$') %></span>
              </div>
              <div class="mt-1 h-2 rounded-full bg-slate-100">
                <div class="h-2 rounded-full bg-rose-400" style="width: <%= width %>%"></div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-slate-500">No hay pagos de gastos en el rango seleccionado.</p>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-800">Pasivos del negocio (USD)</h2>
      <div class="mt-3 space-y-2">
        <% if @passive_rows.any? %>
          <% max_passive = @passive_rows.map { |row| row[:amount_usd] }.max.to_d %>
          <% max_passive = 1.to_d if max_passive <= 0 %>
          <% @passive_rows.each do |row| %>
            <% width = [(row[:amount_usd].to_d / max_passive * 100).to_f, 2].max %>
            <div>
              <div class="flex items-center justify-between text-xs text-slate-600">
                <span class="truncate pr-2"><%= row[:label] %></span>
                <span class="font-semibold"><%= format_money(row[:amount_usd], unit: '$') %></span>
              </div>
              <div class="mt-1 h-2 rounded-full bg-slate-100">
                <div class="h-2 rounded-full bg-violet-400" style="width: <%= width %>%"></div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-slate-500">No hay pasivos pendientes.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-amber-200 bg-amber-50/80 p-4 text-xs text-amber-800">
    Cobertura de utilidad real por lote: <strong><%= @metrics[:sales_with_lot_cost_data] %></strong> de <strong><%= @metrics[:sales_count] %></strong> ventas pagadas del periodo.
    Las ventas antiguas sin detalle de lote en notas no pueden reconstruir costo exacto por lote retroactivamente.
  </div>
</div>
