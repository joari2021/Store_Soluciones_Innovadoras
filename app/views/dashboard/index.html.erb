<div class="space-y-6">
  <% from_date_value = @from_date.respond_to?(:strftime) ? @from_date.strftime('%d-%m-%Y') : @from_date.to_s %>
  <% to_date_value = @to_date.respond_to?(:strftime) ? @to_date.strftime('%d-%m-%Y') : @to_date.to_s %>
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Dashboard financiero</h1>
        <p class="mt-1 text-sm text-slate-500">Utilidad de ventas por productos, servicios y relacion con pasivos/gastos.</p>
      </div>
      <%= form_with url: dashboard_path, method: :get, local: true, class: 'grid gap-2 sm:grid-cols-[minmax(220px,1fr)_auto_auto_auto] sm:items-end' do %>
        <div>
          <label for="dashboard_month_preset_select" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Mes completo</label>
          <%= select_tag :month_preset,
                         options_for_select(
                           @month_filter_options.map do |option|
                             [option[:label], option[:value], { data: { from: option[:from], to: option[:to] } }]
                           end,
                           @selected_month_filter
                         ),
                         id: 'dashboard_month_preset_select',
                         class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">Desde</label>
          <%= text_field_tag :from,
                             from_date_value,
                             placeholder: 'dd-mm-aaaa',
                             autocomplete: 'off',
                             id: 'dashboard_from_date',
                             class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">Hasta</label>
          <%= text_field_tag :to,
                             to_date_value,
                             placeholder: 'dd-mm-aaaa',
                             autocomplete: 'off',
                             id: 'dashboard_to_date',
                             class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">Actualizar</button>
      <% end %>
    </div>
  </div>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Utilidad productos</p>
      <p class="mt-2 text-2xl font-extrabold text-emerald-600"><%= format_money(@metrics[:product_profit_usd], unit: '$') %></p>
      <p class="mt-1 text-xs text-slate-500">Ingreso: <%= format_money(@metrics[:product_revenue_usd], unit: '$') %> | Costo: <%= format_money(@metrics[:product_cost_usd], unit: '$') %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Utilidad servicios</p>
      <p class="mt-2 text-2xl font-extrabold text-cyan-700"><%= format_money(@metrics[:service_profit_usd], unit: '$') %></p>
      <p class="mt-1 text-xs text-slate-500">Ingreso: <%= format_money(@metrics[:service_revenue_usd], unit: '$') %> | Costo: <%= format_money(@metrics[:service_cost_usd], unit: '$') %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Ganancia bruta</p>
      <p class="mt-2 text-2xl font-extrabold text-slate-800"><%= format_money(@metrics[:gross_profit_usd], unit: '$') %></p>
      <p class="mt-1 text-xs text-slate-500">Ventas pagadas: <%= @metrics[:sales_count] %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Ganancia neta (menos gastos)</p>
      <p class="mt-2 text-2xl font-extrabold <%= @metrics[:net_profit_after_expenses_usd].to_d >= 0 ? 'text-emerald-600' : 'text-rose-600' %>"><%= format_money(@metrics[:net_profit_after_expenses_usd], unit: '$') %></p>
      <p class="mt-1 text-xs text-slate-500">Gastos pagados: <%= format_money(@metrics[:expense_paid_usd], unit: '$') %></p>
    </div>
  </div>
  <div class="grid gap-4 xl:grid-cols-[minmax(0,2fr)_minmax(340px,1fr)]">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h2 class="text-lg font-semibold text-slate-800">Tendencia mensual</h2>
          <p class="mt-1 text-xs text-slate-500">Visual interactivo de ingreso, costo y utilidad</p>
        </div>
        <span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700 ring-1 ring-sky-100">Mixto</span>
      </div>
      <% if @monthly_rows.any? %>
        <div id="dashboard-monthly-chart" class="mt-4 h-[360px]"></div>
      <% else %>
        <p class="mt-4 text-sm text-slate-500">No hay ventas pagadas en el rango seleccionado.</p>
      <% end %>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h2 class="text-lg font-semibold text-slate-800">Utilidad por origen</h2>
          <p class="mt-1 text-xs text-slate-500">Productos vs servicios</p>
        </div>
        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 ring-1 ring-emerald-100">Donut</span>
      </div>
      <div id="dashboard-profit-split-chart" class="mt-4 h-[360px]"></div>
    </div>
  </div>
  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h2 class="text-lg font-semibold text-slate-800">Gastos pagados</h2>
          <p class="mt-1 text-xs text-slate-500">Top egresos del periodo en USD</p>
        </div>
        <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-1 text-[11px] font-semibold text-rose-700 ring-1 ring-rose-100">Barras</span>
      </div>
      <% if @expense_rows.any? %>
        <div id="dashboard-expenses-chart" class="mt-4 h-[360px]"></div>
      <% else %>
        <p class="mt-4 text-sm text-slate-500">No hay pagos de gastos en el rango seleccionado.</p>
      <% end %>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h2 class="text-lg font-semibold text-slate-800">Pasivos del negocio</h2>
          <p class="mt-1 text-xs text-slate-500">Distribución actual de obligaciones en USD</p>
        </div>
        <span class="inline-flex items-center rounded-full bg-violet-50 px-2.5 py-1 text-[11px] font-semibold text-violet-700 ring-1 ring-violet-100">Polar</span>
      </div>
      <% if @passive_rows.any? %>
        <div id="dashboard-passives-chart" class="mt-4 h-[360px]"></div>
      <% else %>
        <p class="mt-4 text-sm text-slate-500">No hay pasivos pendientes.</p>
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-amber-200 bg-amber-50/80 p-4 text-xs text-amber-800">
    Cobertura de utilidad real por lote: <strong><%= @metrics[:sales_with_lot_cost_data] %></strong> de <strong><%= @metrics[:sales_count] %></strong> ventas pagadas del periodo.
    Las ventas antiguas sin detalle de lote en notas no pueden reconstruir costo exacto por lote retroactivamente.
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
  (() => {
    const dashboardData = {
      monthly: <%= raw json_escape(@monthly_rows.to_json) %>,
      expenses: <%= raw json_escape(@expense_rows.first(8).to_json) %>,
      passives: <%= raw json_escape(@passive_rows.to_json) %>,
      profitSplit: [
        { label: 'Productos', amount: <%= @metrics[:product_profit_usd].to_d.to_f %> },
        { label: 'Servicios', amount: <%= @metrics[:service_profit_usd].to_d.to_f %> }
      ]
    };

    const currencyFormatter = new Intl.NumberFormat('es-VE', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 2,
    });

    const chartRegistry = window.__dashboardCharts || (window.__dashboardCharts = {});

    const destroyChart = (key) => {
      if (!chartRegistry[key]) return;
      chartRegistry[key].destroy();
      delete chartRegistry[key];
    };

    const baseOptions = {
      chart: {
        toolbar: { show: false },
        zoom: { enabled: false },
        fontFamily: 'ui-sans-serif, system-ui, sans-serif'
      },
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 3 },
      legend: {
        position: 'top',
        horizontalAlign: 'left',
        fontSize: '12px'
      },
      grid: {
        borderColor: '#e2e8f0',
        strokeDashArray: 4
      },
      tooltip: {
        y: {
          formatter: (value) => currencyFormatter.format(Number(value || 0))
        }
      },
      noData: {
        text: 'Sin datos para mostrar'
      }
    };

    const renderMonthlyChart = () => {
      const target = document.getElementById('dashboard-monthly-chart');
      if (!target || !dashboardData.monthly.length || typeof ApexCharts === 'undefined') return;
      destroyChart('monthly');

      chartRegistry.monthly = new ApexCharts(target, {
        ...baseOptions,
        chart: {
          ...baseOptions.chart,
          type: 'line',
          height: 360
        },
        colors: ['#0ea5e9', '#f59e0b', '#10b981'],
        series: [
          { name: 'Ingreso', type: 'area', data: dashboardData.monthly.map((row) => Number(row.revenue || 0)) },
          { name: 'Costo', type: 'area', data: dashboardData.monthly.map((row) => Number(row.cost || 0)) },
          { name: 'Utilidad', type: 'line', data: dashboardData.monthly.map((row) => Number(row.profit || 0)) }
        ],
        xaxis: {
          categories: dashboardData.monthly.map((row) => row.label),
          labels: { style: { colors: '#64748b', fontSize: '11px' } }
        },
        yaxis: {
          labels: {
            formatter: (value) => currencyFormatter.format(Number(value || 0)),
            style: { colors: '#64748b', fontSize: '11px' }
          }
        },
        fill: {
          type: ['gradient', 'gradient', 'solid'],
          gradient: {
            shadeIntensity: 1,
            opacityFrom: 0.28,
            opacityTo: 0.04,
            stops: [0, 90, 100]
          }
        },
        markers: {
          size: 4,
          strokeWidth: 0,
          hover: { size: 6 }
        }
      });

      chartRegistry.monthly.render();
    };

    const renderProfitSplitChart = () => {
      const target = document.getElementById('dashboard-profit-split-chart');
      if (!target || typeof ApexCharts === 'undefined') return;
      destroyChart('profitSplit');

      chartRegistry.profitSplit = new ApexCharts(target, {
        ...baseOptions,
        chart: {
          ...baseOptions.chart,
          type: 'donut',
          height: 360
        },
        colors: ['#10b981', '#06b6d4'],
        labels: dashboardData.profitSplit.map((row) => row.label),
        series: dashboardData.profitSplit.map((row) => Number(row.amount || 0)),
        plotOptions: {
          pie: {
            donut: {
              size: '68%',
              labels: {
                show: true,
                total: {
                  show: true,
                  label: 'Total utilidad',
                  formatter: () => currencyFormatter.format(
                    dashboardData.profitSplit.reduce((sum, row) => sum + Number(row.amount || 0), 0)
                  )
                }
              }
            }
          }
        },
        legend: {
          ...baseOptions.legend,
          position: 'bottom'
        }
      });

      chartRegistry.profitSplit.render();
    };

    const renderExpensesChart = () => {
      const target = document.getElementById('dashboard-expenses-chart');
      if (!target || !dashboardData.expenses.length || typeof ApexCharts === 'undefined') return;
      destroyChart('expenses');

      chartRegistry.expenses = new ApexCharts(target, {
        ...baseOptions,
        chart: {
          ...baseOptions.chart,
          type: 'bar',
          height: 360
        },
        colors: ['#fb7185'],
        series: [{ name: 'Gasto', data: dashboardData.expenses.map((row) => Number(row.amount_usd || 0)) }],
        plotOptions: {
          bar: {
            horizontal: true,
            borderRadius: 6,
            barHeight: '52%'
          }
        },
        xaxis: {
          categories: dashboardData.expenses.map((row) => row.label),
          labels: {
            formatter: (value) => currencyFormatter.format(Number(value || 0)),
            style: { colors: '#64748b', fontSize: '11px' }
          }
        },
        yaxis: {
          labels: {
            maxWidth: 180,
            style: { colors: '#475569', fontSize: '11px' }
          }
        }
      });

      chartRegistry.expenses.render();
    };

    const renderPassivesChart = () => {
      const target = document.getElementById('dashboard-passives-chart');
      if (!target || !dashboardData.passives.length || typeof ApexCharts === 'undefined') return;
      destroyChart('passives');

      chartRegistry.passives = new ApexCharts(target, {
        ...baseOptions,
        chart: {
          ...baseOptions.chart,
          type: 'polarArea',
          height: 360
        },
        colors: ['#8b5cf6', '#6366f1', '#a855f7', '#c084fc'],
        labels: dashboardData.passives.map((row) => row.label),
        series: dashboardData.passives.map((row) => Number(row.amount_usd || 0)),
        stroke: { colors: ['#ffffff'] },
        fill: { opacity: 0.9 },
        legend: {
          ...baseOptions.legend,
          position: 'bottom'
        }
      });

      chartRegistry.passives.render();
    };

    const initMonthPresetSync = () => {
      const presetSelect = document.getElementById('dashboard_month_preset_select');
      const fromInput = document.getElementById('dashboard_from_date');
      const toInput = document.getElementById('dashboard_to_date');
      if (!presetSelect || !fromInput || !toInput) return;

      presetSelect.addEventListener('change', () => {
        const selectedOption = presetSelect.options[presetSelect.selectedIndex];
        if (!selectedOption) return;

        const nextFrom = selectedOption.dataset.from;
        const nextTo = selectedOption.dataset.to;
        if (!nextFrom || !nextTo) return;

        fromInput.value = nextFrom;
        toInput.value = nextTo;

        fromInput.dispatchEvent(new Event('input', { bubbles: true }));
        fromInput.dispatchEvent(new Event('change', { bubbles: true }));
        toInput.dispatchEvent(new Event('input', { bubbles: true }));
        toInput.dispatchEvent(new Event('change', { bubbles: true }));
      });
    };

    const initDashboardCharts = () => {
      initMonthPresetSync();
      renderMonthlyChart();
      renderProfitSplitChart();
      renderExpensesChart();
      renderPassivesChart();
    };

    document.addEventListener('turbo:before-cache', () => {
      destroyChart('monthly');
      destroyChart('profitSplit');
      destroyChart('expenses');
      destroyChart('passives');
    }, { once: true });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDashboardCharts, { once: true });
    } else {
      initDashboardCharts();
    }
  })();
</script>
