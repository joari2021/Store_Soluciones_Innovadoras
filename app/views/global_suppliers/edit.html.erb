<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Editar proveedor global</h1>
        <p class="mt-1 text-sm text-slate-500">Los cambios se sincronizan solo en proveedores locales mapeados.</p>
      </div>
      <%= link_to global_suppliers_path, class: "inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
        Volver
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with model: @global_supplier, local: true, class: "space-y-4" do |f| %>
      <% if @global_supplier.errors.any? %>
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <ul class="list-disc pl-5">
            <% @global_supplier.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <%= f.label :name, "Nombre", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :name, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
        <div>
          <%= f.label :rif, "RIF", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :rif, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
        <div>
          <%= f.label :phone, "Telefono", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :phone, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
        <div>
          <%= f.label :mobile_payment_phone, "Telefono pago movil", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :mobile_payment_phone, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
        <div>
          <%= f.label :email, "Email", class: "block text-sm font-medium text-slate-700" %>
          <%= f.email_field :email, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
        <div>
          <%= f.label :bank_account_number, "Nro cuenta", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :bank_account_number, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
        <div>
          <%= f.label :pricing_currency_priority, "Prioridad moneda", class: "block text-sm font-medium text-slate-700" %>
          <%= f.select :pricing_currency_priority,
                       [["USD", "usd"], ["Bs", "bs"]],
                       {},
                       class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
        <div class="flex items-center gap-2 pt-6">
          <%= f.check_box :default_exento, class: "rounded border-slate-300 text-sky-600 focus:ring-sky-500" %>
          <%= f.label :default_exento, "Exento por defecto", class: "text-sm font-medium text-slate-700" %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :address, "Direccion", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_area :address, rows: 3, class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <%= f.submit "Guardar y sincronizar", class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 cursor-pointer" %>
      </div>
    <% end %>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <% format_decimal_input = lambda do |value, scale = 2|
         next '' if value.nil?

         number = value.to_d.round(scale)
         string_value = number.to_s('F')
         if string_value.include?('.')
           integer_part, decimal_part = string_value.split('.', 2)
           decimal_trimmed = decimal_part.to_s.gsub(/0+\z/, '')
           decimal_trimmed.present? ? "#{integer_part}.#{decimal_trimmed}" : integer_part
         else
           string_value
         end
       end %>
    <% tasa_bcv = @tasa_dolar_bcv.to_d %>
    <h2 class="text-lg font-bold text-slate-800">Precios globales por producto</h2>
    <p class="mt-1 text-sm text-slate-500">Edita costo global por producto. Se sincroniza solo en filas locales mapeadas.</p>
    <% if @global_supplier_products.any? %>
      <div class="mt-4 relative w-full md:max-w-2xl">
        <label for="global-supplier-product-search" class="block text-sm font-medium text-slate-700">Buscar producto</label>
        <div class="mt-1 relative">
          <input id="global-supplier-product-search" type="text" autocomplete="off" placeholder="Buscar producto..." class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 pr-10 shadow-sm focus:border-sky-500 focus:ring-sky-500">
          <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400">
            <i data-lucide="search" class="h-4 w-4"></i>
          </span>
        </div>
      </div>
      <div class="mt-5 overflow-x-auto rounded-2xl border border-slate-200" data-global-supplier-products="true" data-tasa-bcv="<%= tasa_bcv %>">
        <table class="min-w-full text-sm text-slate-700">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-4 py-3 text-left">Producto</th>
              <th class="px-4 py-3 text-right">Costo Mayor $</th>
              <th class="px-4 py-3 text-right">Costo Mayor Bs</th>
              <th class="px-4 py-3 text-center">Unid x Pack</th>
              <th class="px-4 py-3 text-right">Costo Menor $</th>
              <th class="px-4 py-3 text-right">Costo Menor Bs</th>
              <th class="px-4 py-3 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="global-supplier-products-body" class="divide-y divide-slate-100 bg-white">
            <% @global_supplier_products.each do |row| %>
              <% row_key = row.id %>
              <% costo_mayor = row.costo_mayor.to_d %>
              <% cantidad = row.cantidad.to_d %>
              <% costo_menor = row.costo_menor.to_d %>
              <% product_name = row.global_product&.display_name_with_presentation || row.global_product&.name || 'Producto global' %>
              <tr class="global-row-display hover:bg-sky-50/60" data-row-key="<%= row_key %>" data-product-name="<%= product_name.to_s.downcase %>">
                <td class="px-4 py-3 font-semibold text-slate-800"><%= product_name %></td>
                <td class="px-4 py-3 text-right"><%= format_money(costo_mayor, unit: '$') %></td>
                <td class="px-4 py-3 text-right"><%= format_money(costo_mayor * tasa_bcv, unit: 'Bs') %></td>
                <td class="px-4 py-3 text-center"><%= format_quantity(cantidad) %></td>
                <td class="px-4 py-3 text-right"><%= format_money(costo_menor, unit: '$') %></td>
                <td class="px-4 py-3 text-right"><%= format_money(costo_menor * tasa_bcv, unit: 'Bs') %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-2">
                    <button type="button" class="edit-global-row inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors cursor-pointer" data-row-key="<%= row_key %>" title="Editar" aria-label="Editar">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                        <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
              <tr class="global-row-edit hidden bg-slate-50/50" data-row-key="<%= row_key %>" data-product-name="<%= product_name.to_s.downcase %>">
                <td colspan="7" class="px-4 py-3">
                  <%= form_with model: row, url: global_supplier_product_path(row), method: :patch, local: true, class: 'global-supplier-row-form' do |f| %>
                    <div class="grid gap-3 md:grid-cols-7 md:items-end">
                      <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Producto</label>
                        <input type="text" value="<%= product_name %>" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm" readonly>
                      </div>
                      <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Costo Mayor $</label>
                        <%= f.hidden_field :costo_mayor, class: 'row-costo-mayor-native' %>
                        <input type="text" inputmode="decimal" autocomplete="off" data-money-mask="true" data-money-symbol="$" value="<%= format_money(costo_mayor, unit: '$') %>" class="row-costo-mayor block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-right text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500">
                      </div>
                      <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Costo Mayor Bs</label>
                        <input type="text" inputmode="decimal" autocomplete="off" data-money-mask="true" data-money-symbol="Bs" value="<%= format_money(costo_mayor * tasa_bcv, unit: 'Bs') %>" class="row-costo-mayor-bs block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-right text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500">
                      </div>
                      <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Unid x Pack</label>
                        <%= f.number_field :cantidad, step: 0.01, value: format_decimal_input.call(cantidad, 2), class: 'row-cantidad-pack block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-center text-sm shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
                      </div>
                      <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Costo Menor $</label>
                        <%= f.hidden_field :costo_menor, class: 'row-costo-menor-native' %>
                        <input type="text" inputmode="decimal" autocomplete="off" data-money-mask="true" data-money-symbol="$" value="<%= format_money(costo_menor, unit: '$') %>" class="row-costo-menor block w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-right text-sm shadow-sm" readonly>
                      </div>
                      <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Costo Menor Bs</label>
                        <input type="text" inputmode="decimal" autocomplete="off" data-money-mask="true" data-money-symbol="Bs" value="<%= format_money(costo_menor * tasa_bcv, unit: 'Bs') %>" class="row-costo-menor-bs block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-right text-sm shadow-sm" readonly>
                      </div>
                    </div>
                    <div class="mt-3 flex items-center justify-end gap-2">
                      <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-emerald-50 p-2 text-emerald-600 hover:bg-emerald-100 transition-colors cursor-pointer" title="Guardar" aria-label="Guardar">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                          <path d="M5.25 3A2.25 2.25 0 0 0 3 5.25v13.5A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V8.56a2.25 2.25 0 0 0-.66-1.59l-2.31-2.31A2.25 2.25 0 0 0 16.44 4H5.25Zm6 2.25a.75.75 0 0 1 1.5 0V9a.75.75 0 0 1-1.5 0V5.25ZM6.75 14.25A2.25 2.25 0 0 1 9 12h6a2.25 2.25 0 0 1 2.25 2.25V18h-10.5v-3.75Z" />
                        </svg>
                      </button>
                      <button type="button" class="cancel-global-row inline-flex items-center justify-center rounded-lg bg-slate-100 p-2 text-slate-600 hover:bg-slate-200 transition-colors cursor-pointer" data-row-key="<%= row_key %>" title="Cancelar" aria-label="Cancelar">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                          <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                        </svg>
                      </button>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">Este proveedor global aun no tiene productos asociados.</p>
    <% end %>
  </div>
</div>
<script>
  document.addEventListener('turbo:load', () => {
    const wrapper = document.querySelector('[data-global-supplier-products="true"]');
    const tbody = document.getElementById('global-supplier-products-body');
    const searchInput = document.getElementById('global-supplier-product-search');
    if (!wrapper || !tbody || !searchInput) return;
    if (wrapper.dataset.bound === 'true') return;
    wrapper.dataset.bound = 'true';

    const tasa = Number(wrapper.dataset.tasaBcv || 0);
    const moneyMask = window.MoneyInputMask;

    const parseNumber = (rawValue) => {
      const compact = String(rawValue || '').replace(/\s/g, '').replace(/[^\d.,-]/g, '');
      let normalized = compact;
      if (compact.includes(',')) {
        normalized = compact.replace(/\./g, '').replace(',', '.');
      } else if (/^\d{1,3}(\.\d{3})+$/.test(compact)) {
        normalized = compact.replace(/\./g, '');
      }
      const parsed = Number.parseFloat(normalized);
      return Number.isFinite(parsed) ? parsed : 0;
    };

    const formatNumber = (value) => Number(value || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const formatMoney = (value, unit) => `${unit} ${formatNumber(value)}`;

    const setMaskedMoney = (input, value, symbol) => {
      if (!input) return;
      if (moneyMask?.setValue) {
        moneyMask.setValue(input, value, symbol);
        return;
      }
      input.value = formatMoney(value, symbol);
    };

    const recalcRow = (editRow, source = 'usd') => {
      if (!editRow) return;

      const costoMayorInput = editRow.querySelector('.row-costo-mayor');
      const costoMayorNativeInput = editRow.querySelector('.row-costo-mayor-native');
      const costoMayorBsInput = editRow.querySelector('.row-costo-mayor-bs');
      const cantidadPackInput = editRow.querySelector('.row-cantidad-pack');
      const costoMenorInput = editRow.querySelector('.row-costo-menor');
      const costoMenorNativeInput = editRow.querySelector('.row-costo-menor-native');
      const costoMenorBsInput = editRow.querySelector('.row-costo-menor-bs');

      const canConvert = tasa > 0;
      let costoMayor = 0;

      if (source === 'bs') {
        const costoMayorBsValue = moneyMask?.parseValue
          ? moneyMask.parseValue(costoMayorBsInput)
          : parseNumber(costoMayorBsInput?.value);
        if (canConvert) costoMayor = costoMayorBsValue / tasa;
      } else {
        costoMayor = moneyMask?.parseValue
          ? moneyMask.parseValue(costoMayorInput)
          : parseNumber(costoMayorInput?.value);
      }

      const cantidadPack = parseNumber(cantidadPackInput?.value);
      const costoMenor = cantidadPack > 0 ? (costoMayor / cantidadPack) : 0;

      if (costoMayorNativeInput) costoMayorNativeInput.value = costoMayor.toFixed(2);
      if (costoMenorNativeInput) costoMenorNativeInput.value = costoMenor.toFixed(2);

      setMaskedMoney(costoMayorInput, costoMayor, '$');
      setMaskedMoney(costoMenorInput, costoMenor, '$');

      if (costoMayorBsInput && source !== 'bs') {
        setMaskedMoney(costoMayorBsInput, canConvert ? costoMayor * tasa : 0, 'Bs');
      }
      if (costoMenorBsInput) {
        setMaskedMoney(costoMenorBsInput, canConvert ? costoMenor * tasa : 0, 'Bs');
      }
    };

    const openEditRow = (rowKey) => {
      const displayRow = tbody.querySelector(`.global-row-display[data-row-key="${rowKey}"]`);
      const editRow = tbody.querySelector(`.global-row-edit[data-row-key="${rowKey}"]`);
      if (!displayRow || !editRow) return;

      displayRow.classList.add('hidden');
      editRow.classList.remove('hidden');
      recalcRow(editRow);
    };

    const closeEditRow = (rowKey) => {
      const displayRow = tbody.querySelector(`.global-row-display[data-row-key="${rowKey}"]`);
      const editRow = tbody.querySelector(`.global-row-edit[data-row-key="${rowKey}"]`);
      if (!displayRow || !editRow) return;

      editRow.classList.add('hidden');
      displayRow.classList.remove('hidden');
    };

    const normalizeText = (value) => String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    const filterRows = () => {
      const term = normalizeText(searchInput.value);
      const displayRows = Array.from(tbody.querySelectorAll('.global-row-display'));

      displayRows.forEach((displayRow) => {
        const rowKey = displayRow.dataset.rowKey;
        const editRow = tbody.querySelector(`.global-row-edit[data-row-key="${rowKey}"]`);
        const productName = normalizeText(displayRow.dataset.productName || '');
        const match = !term || productName.includes(term);

        const isEditing = editRow && !editRow.classList.contains('hidden');
        if (isEditing) {
          displayRow.classList.toggle('hidden', true);
          editRow.classList.toggle('hidden', !match);
          return;
        }

        displayRow.classList.toggle('hidden', !match);
        if (editRow) editRow.classList.add('hidden');
      });
    };

    tbody.addEventListener('click', (event) => {
      const editBtn = event.target.closest('.edit-global-row');
      if (editBtn) {
        openEditRow(editBtn.dataset.rowKey);
        return;
      }

      const cancelBtn = event.target.closest('.cancel-global-row');
      if (cancelBtn) {
        closeEditRow(cancelBtn.dataset.rowKey);
      }
    });

    tbody.addEventListener('input', (event) => {
      const editRow = event.target.closest('.global-row-edit');
      if (!editRow) return;

      if (event.target.classList.contains('row-costo-mayor-bs')) {
        recalcRow(editRow, 'bs');
        return;
      }

      if (
        event.target.classList.contains('row-costo-mayor') ||
        event.target.classList.contains('row-cantidad-pack')
      ) {
        recalcRow(editRow, 'usd');
      }
    });

    searchInput.addEventListener('input', filterRows);
  });
</script>
