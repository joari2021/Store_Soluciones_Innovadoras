<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Proveedores globales</h1>
        <p class="mt-1 text-sm text-slate-500">Maestro central de proveedores compartidos.</p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:justify-end">
        <%= link_to global_products_path, class: "inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
          Productos globales
        <% end %>
        <%= link_to suppliers_path, class: "inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
          Volver a proveedores
        <% end %>
      </div>
    </div>
  </div>
  <% if @global_suppliers.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full table-auto text-sm text-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-4 text-left font-bold">Proveedor global</th>
            <th class="px-6 py-4 text-left font-bold">RIF</th>
            <th class="px-6 py-4 text-left font-bold">Origen</th>
            <th class="px-6 py-4 text-right font-bold">Mapeos locales</th>
            <th class="px-6 py-4 text-right font-bold">Productos asociados</th>
            <th class="px-6 py-4 text-right font-bold">Accion</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @global_suppliers.each_with_index do |supplier, index| %>
            <tr class="<%= index.even? ? 'bg-white' : 'bg-slate-50/50' %>">
              <td class="px-6 py-4 font-semibold text-slate-800"><%= supplier.name %></td>
              <td class="px-6 py-4"><%= supplier.rif.presence || '-' %></td>
              <td class="px-6 py-4 text-slate-600"><%= supplier.source_business&.name || '-' %></td>
              <td class="px-6 py-4 text-right"><%= supplier.suppliers.size %></td>
              <td class="px-6 py-4 text-right"><%= supplier.global_supplier_products.size %></td>
              <td class="px-6 py-4 text-right">
                <div class="inline-flex items-center gap-2">
                  <%= link_to "Ver", global_supplier_path(supplier), class: "inline-flex items-center justify-center rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100" %>
                  <%= link_to "Editar", edit_global_supplier_path(supplier), class: "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No hay proveedores globales registrados</h3>
      <p class="mt-1 text-sm text-slate-500">Ejecuta el backfill o crea registros en la siguiente fase.</p>
    </div>
  <% end %>
</div>
