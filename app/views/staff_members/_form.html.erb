<% selected_level = @staff_member.role_key %>
<% global_authorization_options = [['Administrador', 'administrator']] %>
<% form_url = @staff_member.new_record? ? business_staff_members_path(@business) : business_staff_member_path(@business, @staff_member) %>
<% form_method = @staff_member.new_record? ? :post : :patch %>
<% password_error_present = @staff_member.errors[:password].any? || @staff_member.errors[:password_confirmation].any? %>
<% assignment_roles = @staff_member.business_user_assignments.each_with_object({}) { |assignment, hash| hash[assignment.business_id] = assignment.authorization_level } %>
<% assignment_customer_access = @staff_member.business_user_assignments.each_with_object({}) { |assignment, hash| hash[assignment.business_id] = assignment.customer_access_level } %>
<% selected_business_ids = assignment_roles.keys.presence || [@business.id] %>
<%= form_with model: @staff_member, url: form_url, method: form_method, class: 'space-y-5' do |form| %>
  <% if @staff_member.errors.any? %>
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
      <p class="font-semibold">Corrige los siguientes errores:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @staff_member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="grid gap-4 md:grid-cols-2">
    <div class="space-y-2 md:col-span-2">
      <%= form.label :full_name, 'Nombre completo', class: 'text-sm font-semibold text-slate-700' %>
      <%= form.text_field :full_name, class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: Maria Fernanda Perez' %>
    </div>
    <div class="space-y-2">
      <%= form.label :username, 'Usuario', class: 'text-sm font-semibold text-slate-700' %>
      <%= form.text_field :username, required: true, class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: maria.perez' %>
    </div>
    <div class="space-y-2">
      <%= form.label :email, 'Correo', class: 'text-sm font-semibold text-slate-700' %>
      <%= form.email_field :email, required: true, class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: usuario@correo.com' %>
    </div>
    <div class="space-y-2">
      <%= form.label :sex, 'Sexo', class: 'text-sm font-semibold text-slate-700' %>
      <%= form.select :sex,
                      options_for_select(User::SEX_OPTIONS.map { |value, label| [label, value] }, (@staff_member.sex_key if @staff_member.respond_to?(:sex_key))),
                      {},
                      class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500' %>
    </div>
    <% if @staff_member.admin? %>
      <div class="space-y-2">
        <label for="user_authorization_level" class="text-sm font-semibold text-slate-700">Nivel de autorizacion</label>
        <%= select_tag 'user[authorization_level]',
                      options_for_select(global_authorization_options, selected_level),
                      id: 'user_authorization_level',
                      class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500' %>
      </div>
    <% else %>
      <%= hidden_field_tag 'user[authorization_level]', 'standard_staff' %>
      <div class="space-y-2">
        <p class="text-sm font-semibold text-slate-700">Nivel de autorizacion</p>
        <p class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">Gestionado por negocio. El administrador global no se asigna desde este formulario.</p>
      </div>
    <% end %>
    <div class="space-y-2 md:col-span-2">
      <p class="text-sm font-semibold text-slate-700">Negocios asignados</p>
      <div class="space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-4" data-business-assignments="true">
        <% @businesses.each do |business_option| %>
          <% checked = selected_business_ids.include?(business_option.id) %>
          <% role_value = assignment_roles[business_option.id].presence || 'none' %>
          <% customer_access_value = assignment_customer_access[business_option.id].presence || 'none' %>
          <div class="grid gap-2 rounded-xl border border-slate-200 bg-white p-3 md:grid-cols-[1fr_220px_220px] md:items-center">
            <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700">
              <%= check_box_tag 'user[assignment_business_ids][]',
                                business_option.id,
                                checked,
                                class: 'h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500',
                                data: { assignment_toggle: true, assignment_target: "role_#{business_option.id}", assignment_customer_target: "customer_access_#{business_option.id}" } %>
              <span><%= business_option.name %></span>
            </label>
            <%= select_tag "user[business_roles][#{business_option.id}]",
                           options_for_select([['Sin cargo', 'none'], ['Administrador', 'administrator'], ['Encargado', 'manager'], ['Personal estandar', 'standard_staff']], %w[none administrator manager standard_staff].include?(role_value) ? role_value : 'none'),
                           class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500 #{checked ? '' : 'opacity-50'}",
                           disabled: !checked,
                           id: "role_#{business_option.id}" %>
            <%= select_tag "user[business_customer_access][#{business_option.id}]",
                           options_for_select([['Sin modo cliente', 'none'], ['Cliente', 'customer'], ['Cliente VIP', 'customer_vip']], BusinessUserAssignment::CUSTOMER_ACCESS_LEVELS.include?(customer_access_value) ? customer_access_value : 'none'),
                           class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500 #{checked ? '' : 'opacity-50'}",
                           disabled: !checked,
                           id: "customer_access_#{business_option.id}" %>
          </div>
        <% end %>
      </div>
      <p class="text-xs text-slate-500">Administrador opera en todos los negocios. Para usuarios no administradores, selecciona al menos un negocio y su cargo (incluye Sin cargo si solo usaras modo cliente).</p>
    </div>
    <div class="flex items-end">
      <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700">
        <%= form.check_box :active, class: 'h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500' %>
        Usuario activo
      </label>
    </div>
    <div class="space-y-2 md:col-span-2">
      <%= form.label :avatar, 'Foto del usuario', class: 'text-sm font-semibold text-slate-700' %>
      <%= form.file_field :avatar, accept: 'image/png,image/jpeg,image/webp', class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 file:mr-3 file:rounded-lg file:border-0 file:bg-sky-100 file:px-3 file:py-1 file:text-xs file:font-semibold file:text-sky-700' %>
    </div>
    <% if @staff_member.new_record? %>
      <div class="space-y-2">
        <%= form.label :password, 'Clave temporal', class: 'text-sm font-semibold text-slate-700' %>
        <%= form.password_field :password,
                                required: true,
                                autocomplete: 'new-password',
                                class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500' %>
      </div>
      <div class="space-y-2">
        <%= form.label :password_confirmation, 'Confirmar clave', class: 'text-sm font-semibold text-slate-700' %>
        <%= form.password_field :password_confirmation,
                                required: true,
                                autocomplete: 'new-password',
                                class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500' %>
      </div>
    <% else %>
      <div class="md:col-span-2 rounded-2xl border border-slate-200 bg-slate-50 p-4">
        <div class="flex flex-col gap-1">
          <p class="text-sm font-semibold text-slate-700">Clave del usuario</p>
          <p class="text-sm text-slate-500">Puedes guardar cambios sin escribir una clave nueva.</p>
        </div>
        <details class="mt-4 rounded-2xl border border-slate-200 bg-white p-4" <%= 'open' if password_error_present %>>
          <summary class="cursor-pointer list-none text-sm font-semibold text-sky-700">
            Cambiar clave ahora
          </summary>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <div class="space-y-2">
              <%= form.label :password, 'Nueva clave', class: 'text-sm font-semibold text-slate-700' %>
              <%= form.password_field :password,
                                      autocomplete: 'new-password',
                                      class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500' %>
            </div>
            <div class="space-y-2">
              <%= form.label :password_confirmation, 'Confirmar nueva clave', class: 'text-sm font-semibold text-slate-700' %>
              <%= form.password_field :password_confirmation,
                                      autocomplete: 'new-password',
                                      class: 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-sky-500' %>
            </div>
          </div>
          <p class="mt-3 text-xs text-slate-500">La nueva clave debe tener al menos 10 caracteres e incluir mayusculas, minusculas, numeros y simbolos.</p>
        </details>
      </div>
    <% end %>
  </div>
  <% if @staff_member.new_record? %>
    <p class="text-xs text-slate-500">La clave debe tener al menos 10 caracteres e incluir mayusculas, minusculas, numeros y simbolos.</p>
  <% end %>
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to business_staff_members_path(@business), class: 'inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50' do %>
      Cancelar
    <% end %>
    <%= form.submit (@staff_member.new_record? ? 'Crear usuario' : 'Guardar cambios'), class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-slate-200 hover:bg-slate-800' %>
  </div>
<% end %>
<script>
  (() => {
    const wrapper = document.querySelector('[data-business-assignments="true"]');
    if (!wrapper || wrapper.dataset.bound === '1') return;
    wrapper.dataset.bound = '1';

    wrapper.querySelectorAll('[data-assignment-toggle="true"]').forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        const targetId = checkbox.dataset.assignmentTarget;
        const customerTargetId = checkbox.dataset.assignmentCustomerTarget;
        if (!targetId) return;

        const select = document.getElementById(targetId);
        if (!select) return;

        select.disabled = !checkbox.checked;
        select.classList.toggle('opacity-50', !checkbox.checked);

        if (!customerTargetId) return;
        const customerSelect = document.getElementById(customerTargetId);
        if (!customerSelect) return;
        customerSelect.disabled = !checkbox.checked;
        customerSelect.classList.toggle('opacity-50', !checkbox.checked);
      });
    });
  })();
</script>
