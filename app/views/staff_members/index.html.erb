<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Usuarios del sistema</h1>
        <p class="mt-1 text-sm text-slate-500">Solo administradores pueden ver este listado completo y gestionar accesos.</p>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-sky-700">Negocio seleccionado para crear usuario: <%= @business.name %></p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
        <%= link_to businesses_path, class: "inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50" do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Negocios
        <% end %>
        <%= link_to new_business_staff_member_path(@business), class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-slate-200 hover:bg-slate-800" do %>
          <i data-lucide="user-plus" class="h-4 w-4"></i>
          Nuevo usuario
        <% end %>
      </div>
    </div>
  </div>
  <% if @staff_members.any? %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <% @staff_members.each do |staff_member| %>
        <% member_business = if staff_member.admin?
                              @business
                            else
                              staff_member.assigned_businesses.first || staff_member.business || @business
                            end %>
        <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
          <div class="flex items-start justify-between gap-3">
            <div class="flex min-w-0 items-center gap-3">
              <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-xl border border-sky-100 bg-sky-50 text-sky-700">
                <% if staff_member.avatar.attached? %>
                  <%= image_tag staff_member.avatar, class: 'h-full w-full object-cover', alt: staff_member.display_name %>
                <% else %>
                  <span class="text-sm font-bold"><%= staff_member.display_name.to_s.first&.upcase || 'U' %></span>
                <% end %>
              </div>
              <div class="min-w-0">
                <p class="truncate text-sm font-bold text-slate-800"><%= staff_member.display_name %></p>
                <p class="truncate text-xs text-slate-500">@<%= staff_member.username %></p>
                <p class="truncate text-xs text-slate-500"><%= staff_member.email %></p>
              </div>
            </div>
            <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold <%= staff_member.active? ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-600' %>">
              <%= staff_member.active? ? 'Activo' : 'Inactivo' %>
            </span>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-sky-100 px-2.5 py-1 text-[11px] font-semibold text-sky-700"><%= staff_member.role_label(@business) %></span>
            <% if staff_member.admin? %>
              <span class="inline-flex items-center rounded-full bg-indigo-100 px-2.5 py-1 text-[11px] font-semibold text-indigo-700">Todos los negocios</span>
            <% else %>
              <% assigned_names = staff_member.assigned_businesses.map(&:name) %>
              <% if assigned_names.any? %>
                <% assigned_names.each do |business_name| %>
                  <span class="inline-flex items-center rounded-full bg-indigo-100 px-2.5 py-1 text-[11px] font-semibold text-indigo-700"><%= business_name %></span>
                <% end %>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-semibold text-amber-700">Sin negocio asignado</span>
              <% end %>
            <% end %>
            <% if staff_member.id == Current.user&.id %>
              <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-semibold text-amber-700">Tu usuario</span>
            <% end %>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <%= link_to edit_business_staff_member_path(member_business, staff_member), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors', title: 'Editar', 'aria-label': 'Editar' do %>
              <i data-lucide="pencil" class="h-4 w-4"></i>
            <% end %>
            <% unless staff_member.id == Current.user&.id %>
              <%= link_to business_staff_member_path(member_business, staff_member),
                          data: { turbo_method: :delete, swal_delete: 'user' },
                          class: 'inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 hover:bg-red-100 transition-colors',
                          title: 'Eliminar',
                          'aria-label': 'Eliminar' do %>
                <i data-lucide="trash" class="h-4 w-4"></i>
              <% end %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <p class="text-base font-semibold text-slate-700">Aun no hay usuarios de personal en este negocio.</p>
      <p class="mt-1 text-sm text-slate-500">Crea el primer usuario para comenzar a delegar accesos.</p>
    </div>
  <% end %>
</div>
