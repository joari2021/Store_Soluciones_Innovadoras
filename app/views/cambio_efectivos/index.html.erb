<div class="space-y-6">
  <div class="rounded-3xl border border-emerald-100 bg-gradient-to-r from-emerald-50 via-white to-teal-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Cambios de efectivo</h1>
        <p class="mt-1 text-sm text-slate-500">Historial de ventas de efectivo y sus movimientos asociados.</p>
      </div>
      <%= link_to ventas_path, class: 'inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800' do %>
        Volver a ventas
      <% end %>
    </div>
    <%= form_with url: cambio_efectivos_path, method: :get, local: true, class: 'mt-4 grid gap-3 md:grid-cols-[minmax(0,12rem)_minmax(0,12rem)_auto] md:items-end' do %>
      <div>
        <label for="cambio_efectivo_filter_from" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Desde</label>
        <%= text_field_tag :fecha_desde,
                           @selected_fecha_desde_value,
                           id: 'cambio_efectivo_filter_from',
                           autocomplete: 'off',
                           placeholder: 'dd-mm-aaaa',
                           class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      </div>
      <div>
        <label for="cambio_efectivo_filter_to" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Hasta</label>
        <%= text_field_tag :fecha_hasta,
                           @selected_fecha_hasta_value,
                           id: 'cambio_efectivo_filter_to',
                           autocomplete: 'off',
                           placeholder: 'dd-mm-aaaa',
                           class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      </div>
      <div class="flex items-center justify-start gap-2 md:self-end">
        <button type="submit" class="inline-flex cursor-pointer items-center justify-center w-fit rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">
          Filtrar
        </button>
        <%= link_to cambio_efectivos_path, class: 'inline-flex cursor-pointer items-center justify-center w-fit rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
          Limpiar
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @cambio_efectivos.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-4 py-3 text-left">Fecha</th>
            <th class="px-4 py-3 text-left">Vendido</th>
            <th class="px-4 py-3 text-left">Cobrado</th>
            <th class="px-4 py-3 text-left">Metodo</th>
            <th class="px-4 py-3 text-left">Usuario</th>
            <th class="px-4 py-3 text-right">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @cambio_efectivos.each do |cambio| %>
            <% can_delete = current_user_admin? || (current_user_manager? && cambio.cash_shift&.open?) %>
            <tr>
              <td class="px-4 py-3 text-slate-700">
                <%= l(cambio.occurred_at.in_time_zone('Caracas'), format: :short) rescue cambio.occurred_at.strftime('%d/%m/%Y %H:%M') %>
              </td>
              <td class="px-4 py-3 font-semibold text-slate-700">
                <%= format_money(cambio.efectivo_vendido, unit: 'Bs') %>
                <p class="text-xs text-slate-400">Caja: <%= format_money(cambio.monto_caja_operativa, unit: 'Bs') %> | Dep: <%= format_money(cambio.monto_caja_deposito, unit: 'Bs') %></p>
              </td>
              <td class="px-4 py-3 font-semibold text-emerald-700">
                <%= format_money(cambio.monto_recibido, unit: 'Bs') %>
                <p class="text-xs text-slate-400">Recargo <%= cambio.recargo_percent %>%</p>
              </td>
              <td class="px-4 py-3 text-slate-700">
                <%= cambio.payment_group_label %>
              </td>
              <td class="px-4 py-3 text-slate-700">
                <%= cambio.seller_display_name %>
              </td>
              <td class="px-4 py-3 text-right">
                <% if can_delete %>
                  <%= link_to cambio_efectivo_path(cambio),
                              method: :delete,
                              data: { confirm: 'Deseas eliminar este cambio y revertir los movimientos?' },
                              class: 'inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 hover:bg-red-100',
                              title: 'Eliminar',
                              'aria-label': 'Eliminar' do %>
                    <i data-lucide="trash" class="h-4 w-4"></i>
                  <% end %>
                <% else %>
                  <span class="inline-flex items-center justify-center rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-400">No disponible</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <p class="text-sm text-slate-500">No hay cambios de efectivo registrados.</p>
    </div>
  <% end %>
</div>
