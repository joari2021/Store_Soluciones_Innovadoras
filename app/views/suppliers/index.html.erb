<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Proveedores</h1>
        <p class="mt-1 text-sm text-slate-500">Vista por negocio usando proveedores globales filtrados por tus productos locales.</p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:justify-end">
        <%= link_to global_suppliers_path, class: 'inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50' do %>
          Proveedores globales
        <% end %>
      </div>
    </div>
  </div>
  <% if @suppliers.any? %>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" data-suppliers-filter-root="true">
      <label for="suppliers-live-search" class="block text-sm font-medium text-slate-700">Buscar proveedor</label>
      <div class="relative mt-1">
        <input id="suppliers-live-search" type="text" autocomplete="off" placeholder="Escribe nombre, RIF u origen..." class="block w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" data-suppliers-live-search="true">
        <i data-lucide="search" class="pointer-events-none absolute left-3.5 top-3.5 h-4 w-4 text-slate-400"></i>
      </div>
      <p class="mt-2 hidden text-xs font-semibold text-amber-700" data-suppliers-no-results="true">No hay proveedores que coincidan con esa búsqueda.</p>
    </div>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full table-auto text-sm text-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-4 text-left font-bold">Proveedor</th>
            <th class="px-6 py-4 text-left font-bold">RIF</th>
            <th class="px-6 py-4 text-left font-bold">Origen</th>
            <th class="px-6 py-4 text-right font-bold">Productos asociados</th>
            <th class="px-6 py-4 text-right font-bold">Accion</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @suppliers.each_with_index do |supplier, index| %>
            <% local_supplier = supplier.suppliers.find { |row| row.business_id == current_business.id } if current_business.id == 1 %>
            <tr class="<%= index.even? ? 'bg-white' : 'bg-slate-50/50' %>" data-supplier-row="true" data-supplier-query="<%= [supplier.name, supplier.rif, supplier.source_business&.name].join(' ') %>">
              <td class="px-6 py-4 font-semibold text-slate-800"><%= supplier.name %></td>
              <td class="px-6 py-4"><%= supplier.rif.presence || '-' %></td>
              <td class="px-6 py-4 text-slate-600"><%= supplier.source_business&.name || '-' %></td>
              <td class="px-6 py-4 text-right"><%= supplier.global_supplier_products.size %></td>
              <td class="px-6 py-4 text-right">
                <div class="inline-flex items-center gap-2">
                  <%= link_to 'Ver', supplier_path(supplier), class: 'inline-flex items-center justify-center rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100' %>
                  <%= link_to 'Editar', edit_supplier_path(supplier), class: 'inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50' %>
                  <% if current_business.id == 1 && local_supplier.present? %>
                    <%= link_to 'Ver local', local_preview_supplier_path(supplier), class: 'inline-flex items-center justify-center rounded-lg border border-sky-300 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100' %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No hay proveedores aplicables para este negocio</h3>
      <p class="mt-1 text-sm text-slate-500">Se mostrarán aquí cuando exista coincidencia entre productos locales y catálogo global.</p>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    const root = document.querySelector('[data-suppliers-filter-root="true"]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const input = root.querySelector('[data-suppliers-live-search="true"]');
    const noResults = root.querySelector('[data-suppliers-no-results="true"]');
    if (!input) return;

    const normalize = (value) => String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

    const applyFilter = () => {
      const query = normalize(input.value);
      const rows = Array.from(document.querySelectorAll('[data-supplier-row="true"]'));
      let visibleCount = 0;

      rows.forEach((row) => {
        const rowQuery = normalize(row.dataset.supplierQuery);
        const visible = query.length === 0 || rowQuery.includes(query);
        row.classList.toggle('hidden', !visible);
        if (visible) visibleCount += 1;
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0 || query.length === 0);
      }
    };

    input.addEventListener('input', applyFilter);
  });
</script>
