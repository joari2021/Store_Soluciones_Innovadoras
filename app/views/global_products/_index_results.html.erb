<div id="global-products-results" data-global-products-results="true">
  <% if @has_global_products || @filters_applied %>
    <div class="mt-3 flex flex-col gap-1 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>
        Mostrando <span class="font-semibold text-slate-700" data-global-products-loaded-count="true"><%= @global_products.size %></span>
        de <span class="font-semibold text-slate-700" data-global-products-total-count="true"><%= @matching_global_products_count %></span>
        <span><%= @matching_global_products_count == 1 ? 'producto global' : 'productos globales' %></span>.
      </p>
      <p>
        <% active_filters = [] %>
        <% active_filters << "categoria #{@selected_category}" if @selected_category.present? %>
        <% active_filters << "precio por debajo del objetivo" if @below_target_margin_filter %>
        <% if active_filters.any? %>
          Filtro activo: <span class="font-semibold text-slate-700"><%= active_filters.join(' + ') %></span>.
        <% else %>
          Catalogo global compartido entre negocios.
        <% end %>
      </p>
    </div>
  <% end %>
  <% if @global_products.any? %>
    <div class="space-y-4" data-global-products-index="true">
      <div class="relative" data-global-products-table-shell="true">
        <div data-global-products-table-loading="true" class="pointer-events-none absolute inset-0 z-20 hidden items-center justify-center rounded-2xl bg-white/70 backdrop-blur-[1px]">
          <div class="inline-flex items-center gap-2 rounded-xl border border-sky-200 bg-white px-4 py-2 text-sm font-semibold text-sky-700 shadow-sm">
            <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-sky-500"></span>
            Cargando productos globales...
          </div>
        </div>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <table class="min-w-full table-auto text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-6 py-4 text-left font-bold">Producto global</th>
                <th class="px-6 py-4 text-left font-bold">Categoria</th>
                <th class="px-6 py-4 text-right font-bold">Mapeos locales</th>
                <th class="px-6 py-4 text-right font-bold">Vinculos proveedor</th>
                <th class="px-6 py-4 text-right font-bold">Accion</th>
              </tr>
            </thead>
            <tbody id="global_products_tbody" class="divide-y divide-slate-100">
              <%= render partial: "global_products/table_rows", locals: { products: @global_products } %>
            </tbody>
          </table>
        </div>
        <% if @next_page.present? %>
          <div class="flex justify-center py-2" data-global-products-pagination="true" data-next-page="<%= @next_page %>">
            <div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm text-slate-500 shadow-sm">
              <span class="h-2 w-2 animate-pulse rounded-full bg-sky-400"></span>
              <span>Cargando mas productos globales...</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% elsif @filters_applied %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No se encontraron productos globales con esos filtros</h3>
      <p class="mt-1 text-sm text-slate-500">Prueba limpiando o ajustando la busqueda y categoria.</p>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No hay productos globales registrados</h3>
      <p class="mt-1 text-sm text-slate-500">Crea tu primer producto global para comenzar.</p>
    </div>
  <% end %>
</div>
