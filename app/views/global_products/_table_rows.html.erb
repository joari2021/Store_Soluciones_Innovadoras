<% products.each_with_index do |product, index| %>
  <%= render partial: 'global_products/table_row',
             locals: {
               product: product,
               row_class: (index.even? ? 'bg-white' : 'bg-slate-50/50'),
               flash_row: false,
               query_text: @query_text,
               selected_category: @selected_category,
               below_target_margin_filter: @below_target_margin_filter,
             } %>
<% end %>
