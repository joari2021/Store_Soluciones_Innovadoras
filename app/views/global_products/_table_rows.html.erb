<% products.each_with_index do |product, index| %>
  <tr class="<%= index.even? ? 'bg-white' : 'bg-slate-50/50' %>">
    <td class="px-6 py-4 font-semibold text-slate-800"><%= product.display_name_with_presentation %></td>
    <td class="px-6 py-4"><%= product.category_name.presence || '-' %></td>
    <td class="px-6 py-4 text-right"><%= product.productos.size %></td>
    <td class="px-6 py-4 text-right"><%= product.global_supplier_products.size %></td>
    <td class="px-6 py-4 text-right">
      <%= link_to "Editar", edit_global_product_path(product), class: "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
    </td>
  </tr>
<% end %>
