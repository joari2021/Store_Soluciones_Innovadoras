<% row_class ||= 'bg-white' %>
<% query_text_value = local_assigns[:query_text].presence || @query_text %>
<% selected_category_value = local_assigns[:selected_category].presence || @selected_category %>
<% below_target_margin_value = if local_assigns.key?(:below_target_margin_filter)
                                 local_assigns[:below_target_margin_filter]
                               else
                                 @below_target_margin_filter
                               end %>

<tr id="<%= dom_id(product, :global_row) %>" class="<%= row_class %>">
  <td class="px-6 py-4">
    <div class="h-10 w-10 overflow-hidden rounded-lg border border-slate-200 bg-slate-50">
      <% if product.image.attached? %>
        <%= image_tag product.image, class: 'h-full w-full object-cover', alt: product.name %>
      <% else %>
        <%= image_tag 'default_image.jpeg', class: 'h-full w-full object-cover', alt: product.name %>
      <% end %>
    </div>
  </td>
  <td class="px-6 py-4 font-semibold text-slate-800"><%= product.display_name_with_presentation %></td>
  <td class="px-6 py-4"><%= product.category_name.presence || '-' %></td>
  <td class="px-6 py-4 text-right"><%= product.productos.size %></td>
  <td class="px-6 py-4 text-right"><%= product.global_supplier_products.size %></td>
  <td class="px-6 py-4 text-right">
    <%= link_to "Editar",
                edit_global_product_path(product, query_text: query_text_value.presence, category_name: selected_category_value.presence, below_target_margin: (below_target_margin_value ? '1' : nil)),
                remote: true,
                method: :get,
                class: "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50",
                data: { turbo_frame: "modal-global-products" },
                onclick: "openModal('globalProductModal')" %>
  </td>
</tr>
