<section class="space-y-6 fade-in" data-global-products-root="true">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Productos globales</h1>
        <p class="mt-1 text-sm text-slate-500">Catalogo maestro compartido entre negocios.</p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:flex-row sm:justify-end">
        <%= link_to global_categories_path,
                    class: 'inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 sm:w-auto' do %>
          Categorias globales
        <% end %>
        <%= link_to global_profit_margin_presets_path,
                    class: 'inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 sm:w-auto' do %>
          Ganancias globales
        <% end %>
        <%= link_to new_global_product_path(query_text: @query_text.presence, category_name: @selected_category.presence),
                    remote: true,
                    method: :get,
                    class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-slate-900 px-6 py-3 font-medium text-white shadow-lg shadow-slate-200 transition-all hover:bg-slate-800 active:scale-95 sm:w-auto',
                    data: { turbo_frame: 'modal-global-products' },
                    onclick: "openModal('globalProductModal')" do %>
          <i data-lucide="plus" class="h-4 w-4"></i>
          Nuevo producto global
        <% end %>
        <%= link_to productos_path, class: 'inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 sm:w-auto' do %>
          Volver a productos
        <% end %>
      </div>
    </div>
  </div>
  <% if @has_global_products || @filters_applied %>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <div class="mb-4 rounded-2xl border border-slate-100 bg-slate-50/70 p-3">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Filtrar por categoria</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <% all_active = @selected_category.blank? %>
          <%= link_to global_products_path(query_text: @query_text.presence),
                      class: "inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-all #{all_active ? 'border-sky-300 bg-sky-100 text-sky-700 shadow-sm' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-100'}" do %>
            <span>Todas</span>
            <span class="rounded-full bg-white/80 px-2 py-0.5 text-[11px] font-bold text-slate-700"><%= @category_counts.values.sum %></span>
          <% end %>
          <% @category_options.each do |category_name| %>
            <% is_active = @selected_category == category_name %>
            <%= link_to global_products_path(query_text: @query_text.presence, category_name: category_name),
                        class: "inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-all #{is_active ? 'border-cyan-300 bg-cyan-100 text-cyan-800 shadow-sm' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-100'}" do %>
              <span><%= category_name %></span>
              <span class="rounded-full bg-white/80 px-2 py-0.5 text-[11px] font-bold text-slate-700"><%= @category_counts[category_name].to_i %></span>
            <% end %>
          <% end %>
        </div>
      </div>
      <%= form_with url: global_products_path, method: :get, local: true, class: 'grid gap-3 md:grid-cols-[minmax(0,20rem)_auto_auto] md:items-end md:justify-start' do %>
        <div class="w-full md:w-[20rem]">
          <label for="global_products_query_text" class="block text-sm font-medium text-slate-700">Buscar por descripcion</label>
          <div class="relative mt-1">
            <i data-lucide="search" class="pointer-events-none absolute left-3.5 top-3.5 h-4 w-4 text-slate-400"></i>
            <%= text_field_tag :query_text,
                               @query_text,
                               id: 'global_products_query_text',
                               autocomplete: 'off',
                               placeholder: 'Ej: arroz, harina, refresco...',
                               class: 'block w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
          </div>
        </div>
        <% if @selected_category.present? %>
          <%= hidden_field_tag :category_name, @selected_category %>
        <% end %>
        <button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">
          Buscar
        </button>
        <% if @filters_applied %>
          <%= link_to global_products_path, class: 'inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
            Limpiar
          <% end %>
        <% else %>
          <span></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <%= render partial: 'index_results' %>
  <%= render partial: 'modal-global-products' %>
</section>
<script>
  (() => {
    const root = document.querySelector('[data-global-products-root="true"]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const getResultsContainer = () => document.getElementById('global-products-results');
    const getTableShell = () => document.querySelector('[data-global-products-table-shell="true"]');
    const getLoadingOverlay = () => document.querySelector('[data-global-products-table-loading="true"]');
    const getPagination = () => document.querySelector('[data-global-products-pagination="true"]');
    const getSearchForm = () => root.querySelector('form[action="/global/productos"]');
    const getSearchInput = () => document.getElementById('global_products_query_text');

    let loadingPage = false;

    const setLoadingState = (isLoading) => {
      const tableShell = getTableShell();
      const loadingOverlay = getLoadingOverlay();
      if (loadingOverlay) loadingOverlay.classList.toggle('hidden', !isLoading);
      if (loadingOverlay) loadingOverlay.classList.toggle('flex', isLoading);
      if (tableShell) tableShell.classList.toggle('opacity-80', isLoading);
    };

    const replaceResultsFromHtml = (html) => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html || '', 'text/html');
      const incoming = doc.querySelector('#global-products-results');
      const current = getResultsContainer();
      if (!incoming || !current) return;
      current.replaceWith(incoming);
    };

    const updateCategoryChipState = (selectedCategory) => {
      const normalizedSelected = String(selectedCategory || '').trim();
      const chips = Array.from(root.querySelectorAll('a[href*="/global/productos"]')).filter((link) => {
        return link.closest('.rounded-2xl') && link.className.includes('rounded-full');
      });

      chips.forEach((chip) => {
        const url = new URL(chip.href, window.location.origin);
        const chipCategory = String(url.searchParams.get('category_name') || '').trim();
        const isAll = chipCategory === '';
        const isActive = normalizedSelected ? chipCategory === normalizedSelected : isAll;

        chip.classList.remove(
          'border-sky-300', 'bg-sky-100', 'text-sky-700',
          'border-cyan-300', 'bg-cyan-100', 'text-cyan-800',
          'border-slate-300', 'bg-white', 'text-slate-600', 'hover:border-slate-400', 'hover:bg-slate-100', 'shadow-sm'
        );

        if (isAll) {
          if (isActive) {
            chip.classList.add('border-sky-300', 'bg-sky-100', 'text-sky-700', 'shadow-sm');
          } else {
            chip.classList.add('border-slate-300', 'bg-white', 'text-slate-600', 'hover:border-slate-400', 'hover:bg-slate-100');
          }
          return;
        }

        if (isActive) {
          chip.classList.add('border-cyan-300', 'bg-cyan-100', 'text-cyan-800', 'shadow-sm');
        } else {
          chip.classList.add('border-slate-300', 'bg-white', 'text-slate-600', 'hover:border-slate-400', 'hover:bg-slate-100');
        }
      });
    };

    const applySearchStateFromUrl = (url) => {
      const parsed = new URL(url, window.location.origin);
      const queryText = parsed.searchParams.get('query_text') || '';
      const categoryName = parsed.searchParams.get('category_name') || '';

      const searchInput = getSearchInput();
      if (searchInput) searchInput.value = queryText;

      const form = getSearchForm();
      if (form) {
        let categoryInput = form.querySelector('input[name="category_name"]');
        if (categoryName) {
          if (!categoryInput) {
            categoryInput = document.createElement('input');
            categoryInput.type = 'hidden';
            categoryInput.name = 'category_name';
            form.appendChild(categoryInput);
          }
          categoryInput.value = categoryName;
        } else if (categoryInput) {
          categoryInput.remove();
        }
      }

      updateCategoryChipState(categoryName);
    };

    const fetchAndRender = async (url, { pushHistory = true } = {}) => {
      setLoadingState(true);

      try {
        const response = await fetch(url, {
          headers: {
            Accept: 'text/html,application/xhtml+xml'
          }
        });
        if (!response.ok) return;

        const html = await response.text();
        replaceResultsFromHtml(html);
        applySearchStateFromUrl(url);
        if (pushHistory) {
          window.history.pushState({}, '', url);
        }
        observePagination();
      } finally {
        setLoadingState(false);
      }
    };

    const fetchNextPage = async () => {
      if (loadingPage) return;

      const pagination = getPagination();
      const nextPage = pagination?.dataset?.nextPage;
      if (!nextPage) return;

      loadingPage = true;
      try {
        const params = new URLSearchParams(window.location.search);
        params.set('page', nextPage);
        const response = await fetch(`${window.location.pathname}?${params.toString()}`, {
          headers: { Accept: 'application/json' }
        });
        if (!response.ok) return;

        const payload = await response.json();
        const tbody = document.getElementById('global_products_tbody');
        if (!tbody) return;

        const temp = document.createElement('tbody');
        temp.innerHTML = payload.table_rows_html || '';
        Array.from(temp.children).forEach((row) => tbody.appendChild(row));

        const loadedCount = document.querySelector('[data-global-products-loaded-count="true"]');
        if (loadedCount) {
          loadedCount.textContent = String(Number(loadedCount.textContent || 0) + Number(payload.batch_count || 0));
        }

        if (pagination) {
          if (payload.next_page) {
            pagination.dataset.nextPage = payload.next_page;
          } else {
            pagination.remove();
          }
        }
      } finally {
        loadingPage = false;
      }
    };

    let paginationObserver;
    const observePagination = () => {
      if (paginationObserver) paginationObserver.disconnect();
      const pagination = getPagination();
      if (!pagination) return;

      paginationObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            fetchNextPage();
          }
        });
      }, { rootMargin: '200px 0px' });

      paginationObserver.observe(pagination);
    };

    root.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.action.includes('/global/productos')) return;

      event.preventDefault();
      const formData = new FormData(form);
      const url = new URL(form.action, window.location.origin);

      for (const [key, value] of formData.entries()) {
        const normalizedValue = String(value || '').trim();
        if (normalizedValue) {
          url.searchParams.set(key, normalizedValue);
        }
      }

      fetchAndRender(url.toString());
    });

    root.addEventListener('click', (event) => {
      const link = event.target.closest('a[href]');
      if (!link) return;
      if (!link.href.includes('/global/productos')) return;
      if (link.dataset.turboFrame) return;

      const insideCategorySection = link.className.includes('rounded-full');
      const insideClear = link.textContent.trim().toLowerCase() === 'limpiar';
      if (!insideCategorySection && !insideClear) return;

      event.preventDefault();
      fetchAndRender(link.href);
    });

    window.addEventListener('popstate', () => {
      fetchAndRender(window.location.href, { pushHistory: false });
    });

    observePagination();
  })();
</script>
