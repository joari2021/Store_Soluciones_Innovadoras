<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Productos globales</h1>
        <p class="mt-1 text-sm text-slate-500">Catalogo maestro compartido entre negocios.</p>
      </div>
      <%= link_to productos_path, class: "inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
        Volver a productos
      <% end %>
    </div>
  </div>

  <% if @global_products.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full table-auto text-sm text-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-4 text-left font-bold">Producto global</th>
            <th class="px-6 py-4 text-left font-bold">Presentacion</th>
            <th class="px-6 py-4 text-left font-bold">Origen</th>
            <th class="px-6 py-4 text-right font-bold">Mapeos locales</th>
            <th class="px-6 py-4 text-right font-bold">Vinculos proveedor</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @global_products.each_with_index do |product, index| %>
            <% presentation_label = product.presentation.to_s == 'pack' ? "Pack (#{product.cant_presentation} unid)" : 'Unidad' %>
            <tr class="<%= index.even? ? 'bg-white' : 'bg-slate-50/50' %>">
              <td class="px-6 py-4 font-semibold text-slate-800"><%= product.name %></td>
              <td class="px-6 py-4"><%= presentation_label %></td>
              <td class="px-6 py-4 text-slate-600"><%= product.source_business&.name || '-' %></td>
              <td class="px-6 py-4 text-right"><%= product.productos.size %></td>
              <td class="px-6 py-4 text-right"><%= product.global_supplier_products.size %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No hay productos globales registrados</h3>
      <p class="mt-1 text-sm text-slate-500">Ejecuta el backfill o crea registros en la siguiente fase.</p>
    </div>
  <% end %>
</div>
