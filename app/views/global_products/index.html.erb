<section class="space-y-6 fade-in" data-global-products-root="true">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Productos globales</h1>
        <p class="mt-1 text-sm text-slate-500">Catalogo maestro compartido entre negocios.</p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:flex-row sm:justify-end">
        <%= link_to new_global_product_path,
                    remote: true,
                    method: :get,
                    class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-slate-900 px-6 py-3 font-medium text-white shadow-lg shadow-slate-200 transition-all hover:bg-slate-800 active:scale-95 sm:w-auto',
                    data: { turbo_frame: 'modal-global-products' },
                    onclick: "openModal('globalProductModal')" do %>
          <i data-lucide="plus" class="h-4 w-4"></i>
          Nuevo producto global
        <% end %>
        <%= link_to productos_path, class: 'inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 sm:w-auto' do %>
          Volver a productos
        <% end %>
      </div>
    </div>
  </div>

  <% if @has_global_products || @filters_applied %>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <div class="mb-4 rounded-2xl border border-slate-100 bg-slate-50/70 p-3">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Filtrar por categoria</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <% all_active = @selected_category.blank? %>
          <%= link_to global_products_path(query_text: @query_text.presence),
                      class: "inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-all #{all_active ? 'border-sky-300 bg-sky-100 text-sky-700 shadow-sm' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-100'}" do %>
            <span>Todas</span>
            <span class="rounded-full bg-white/80 px-2 py-0.5 text-[11px] font-bold text-slate-700"><%= @category_counts.values.sum %></span>
          <% end %>
          <% @category_options.each do |category_name| %>
            <% is_active = @selected_category == category_name %>
            <%= link_to global_products_path(query_text: @query_text.presence, category_name: category_name),
                        class: "inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-all #{is_active ? 'border-cyan-300 bg-cyan-100 text-cyan-800 shadow-sm' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-100'}" do %>
              <span><%= category_name %></span>
              <span class="rounded-full bg-white/80 px-2 py-0.5 text-[11px] font-bold text-slate-700"><%= @category_counts[category_name].to_i %></span>
            <% end %>
          <% end %>
        </div>
      </div>

      <%= form_with url: global_products_path, method: :get, local: true, class: 'grid gap-3 md:grid-cols-[minmax(0,20rem)_auto_auto] md:items-end md:justify-start' do %>
        <div class="w-full md:w-[20rem]">
          <label for="global_products_query_text" class="block text-sm font-medium text-slate-700">Buscar por descripcion</label>
          <div class="relative mt-1">
            <i data-lucide="search" class="pointer-events-none absolute left-3.5 top-3.5 h-4 w-4 text-slate-400"></i>
            <%= text_field_tag :query_text,
                               @query_text,
                               id: 'global_products_query_text',
                               autocomplete: 'off',
                               placeholder: 'Ej: arroz, harina, refresco...',
                               class: 'block w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
          </div>
        </div>
        <% if @selected_category.present? %>
          <%= hidden_field_tag :category_name, @selected_category %>
        <% end %>
        <button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">
          Buscar
        </button>
        <% if @filters_applied %>
          <%= link_to global_products_path, class: 'inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
            Limpiar
          <% end %>
        <% else %>
          <span></span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render partial: 'index_results' %>
  <%= render partial: 'modal-global-products' %>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-global-products-root="true"]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const nextPageFromDom = () => {
      const container = document.getElementById('global-products-results');
      return container?.dataset?.nextPage || '';
    };

    const loadMoreButton = () => document.querySelector('[data-global-products-load-more="true"]');

    const requestNextPage = async () => {
      const nextPage = nextPageFromDom();
      if (!nextPage) return;

      const btn = loadMoreButton();
      if (btn) btn.disabled = true;

      const params = new URLSearchParams(window.location.search);
      params.set('page', nextPage);

      const response = await fetch(`${window.location.pathname}?${params.toString()}`, {
        headers: { Accept: 'application/json' }
      });
      if (!response.ok) {
        if (btn) btn.disabled = false;
        return;
      }

      const payload = await response.json();
      const tbody = document.getElementById('global_products_tbody');
      if (!tbody) return;

      const temp = document.createElement('tbody');
      temp.innerHTML = payload.table_rows_html || '';
      Array.from(temp.children).forEach((row) => tbody.appendChild(row));

      const container = document.getElementById('global-products-results');
      if (container) container.dataset.nextPage = payload.next_page || '';

      const wrapper = document.getElementById('global-products-load-more');
      if (wrapper) wrapper.classList.toggle('hidden', !(payload.next_page));
      if (btn) btn.disabled = false;
    };

    document.addEventListener('click', (event) => {
      const btn = event.target.closest('[data-global-products-load-more="true"]');
      if (!btn) return;
      event.preventDefault();
      requestNextPage();
    });
  })();
</script>
