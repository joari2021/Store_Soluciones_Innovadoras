<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Editar producto global</h1>
        <p class="mt-1 text-sm text-slate-500">Los cambios se sincronizan solo en productos locales mapeados.</p>
      </div>
      <%= link_to global_products_path, class: "inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
        Volver
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render partial: "form", locals: { global_product: @global_product, submit_label: "Guardar y sincronizar" } %>
  </div>
</div>
