<div id="globalProductModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4 fade-in">
  <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden relative max-h-[90vh]">
    <div class="p-6 border-b border-sky-50 flex justify-between items-center bg-sky-50/30">
      <h3 class="text-lg font-bold text-slate-700">Producto global</h3>
      <button onclick="closeModal('globalProductModal')" class="w-8 h-8 rounded-full bg-white text-slate-400 hover:text-red-500 flex items-center justify-center transition-colors"><i data-lucide="x" class="w-4 h-4"></i></button>
    </div>
    <div class="max-h-[70vh] overflow-auto p-6 space-y-5">
      <div class="space-y-4">
        <%= turbo_frame_tag "modal-global-products" %>
      </div>
    </div>
    <div class="p-6 pt-2 flex gap-3 border-t border-slate-100 bg-white">
      <button type="button" onclick="closeModal('globalProductModal')" class="flex-1 py-3.5 border border-slate-200 text-slate-600 rounded-xl font-bold hover:bg-slate-50 transition-colors">Cancelar</button>
      <button type="button" class="flex-1 py-3.5 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 shadow-lg shadow-slate-200 transition-all" id="saveGlobalProductModal">Guardar</button>
    </div>
  </div>
</div>
<script>
  (function() {
    const saveBtn = document.getElementById("saveGlobalProductModal");
    if (!saveBtn || saveBtn.dataset.bound === "true") return;
    saveBtn.dataset.bound = "true";

    let modalSubmitting = false;
    saveBtn.addEventListener("click", function() {
      const submitBtn = document.querySelector("#modal-global-products .modal-submit");
      modalSubmitting = true;
      setTimeout(() => { modalSubmitting = false; }, 5000);
      if (submitBtn) submitBtn.click();
    });

    const modalFrame = document.querySelector("turbo-frame#modal-global-products");
    if (!modalFrame) return;

    function openGlobalModal() {
      if (typeof openModal === "function") { openModal("globalProductModal"); return; }
      const modal = document.getElementById("globalProductModal");
      if (modal) modal.classList.remove("hidden");
    }

    function closeGlobalModal() {
      if (typeof closeModal === "function") { closeModal("globalProductModal"); return; }
      const modal = document.getElementById("globalProductModal");
      if (modal) modal.classList.add("hidden");
    }

    function showGlobalProductSavedSuccess() {
      if (!window.Swal) return;

      setTimeout(() => {
        Swal.fire({
          icon: "success",
          title: "Producto global guardado correctamente.",
          showConfirmButton: false,
          timer: 1500,
          heightAuto: false,
        });
      }, 80);
    }

    function handleModalFrameLoad(e) {
      const frame = e && e.target ? e.target : modalFrame;

      const errorSelectors = ["#error_explanation", ".field_with_errors", ".errors", ".alert-danger", ".invalid-feedback", "#form-errors"];
      const hasErrors = frame && errorSelectors.some(sel => frame.querySelector(sel));

      if (hasErrors) {
        openGlobalModal();
        if (window.Swal) {
          Swal.fire({
            icon: "error",
            title: "Error en el formulario",
            html: "Corrige los errores indicados en la parte superior formulario.",
            confirmButtonText: "OK",
            heightAuto: false,
          }).then(() => {
            const firstInput = frame.querySelector("input.is-invalid, input.invalid, .field_with_errors input, textarea, select, input");
            if (firstInput) firstInput.focus();
          });
        }
        return;
      }

      const hasForm = frame && !!frame.querySelector("form");
      const successMarker = frame && (frame.querySelector("[data-success='true']") || frame.querySelector(".success, .alert-success"));
      const frameEmptyish = frame && (!frame.innerHTML || frame.innerHTML.trim().length === 0);

      if (!hasForm && (successMarker || frameEmptyish)) {
        closeGlobalModal();
        if (modalSubmitting) {
          showGlobalProductSavedSuccess();
          modalSubmitting = false;
        }
      }
    }

    modalFrame.addEventListener("turbo:frame-load", handleModalFrameLoad);

    const closeWhenFrameBecomesEmpty = () => {
      const modal = document.getElementById("globalProductModal");
      const isModalOpen = modal && !modal.classList.contains("hidden");
      if (!isModalOpen) return;

      const hasForm = !!modalFrame.querySelector("form");
      const frameEmptyish = !modalFrame.innerHTML || modalFrame.innerHTML.trim().length === 0;
      if (!hasForm && frameEmptyish) {
        closeGlobalModal();
        if (modalSubmitting) {
          showGlobalProductSavedSuccess();
          modalSubmitting = false;
        }
      }
    };

    const modalFrameObserver = new MutationObserver(closeWhenFrameBecomesEmpty);
    modalFrameObserver.observe(modalFrame, {
      childList: true,
      subtree: true,
      characterData: true,
    });

    document.addEventListener("turbo:before-cache", () => {
      modalFrameObserver.disconnect();
    }, { once: true });

    document.addEventListener("turbo:frame-load", (e) => {
      if (e && e.target && e.target.id === "modal-global-products") {
        handleModalFrameLoad(e);
      }
    });
  })();
</script>
