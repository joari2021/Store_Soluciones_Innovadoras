<% modal_mode = local_assigns.fetch(:modal_mode, false) %>
<% query_text = local_assigns[:query_text] %>
<% category_name = local_assigns[:category_name] %>
<% category_name_options = Array(@category_name_options).map(&:to_s).map(&:strip).reject(&:blank?).uniq %>
<% current_category_name = global_product.category_name.to_s.strip %>
<% if current_category_name.present? && !category_name_options.include?(current_category_name) %>
  <% category_name_options << current_category_name %>
<% end %>
<% category_name_options.sort_by!(&:downcase) %>
<% profit_margin_presets = Array(@profit_margin_presets_for_select) %>
<% selected_profit_margin_preset_id = profit_margin_presets.find { |preset| preset.percentage.to_d == global_product.fixed_margin_percentage.to_d }&.id %>
<% global_suppliers_for_product = Array(local_assigns[:global_suppliers_for_product]) %>
<% cheapest_supplier_cost_unit = local_assigns[:cheapest_supplier_cost_unit] %>
<% show_suggested_price_badge = modal_mode && global_product.persisted? %>
<% bcv_rate = @tasa_dolar_bcv.is_a?(Numeric) ? @tasa_dolar_bcv.to_d : 0.to_d %>
<%= form_with(model: global_product, local: true, html: { class: "space-y-4", multipart: true, data: { global_product_bcv_rate: bcv_rate.to_s('F') } }) do |f| %>
  <%= hidden_field_tag :query_text, query_text if query_text.present? %>
  <%= hidden_field_tag :category_name, category_name if category_name.present? %>
  <%= hidden_field_tag :below_target_margin, below_target_margin if below_target_margin.present? %>
  <% if global_product.errors.any? %>
    <div id="form-errors" class="alert alert-danger rounded-xl p-4 mb-3 shadow-sm border border-danger" style="background: #fee2e2; color: #b91c1c;">
      <h4 class="text-base font-bold mb-2"><%= pluralize(global_product.errors.count, "error") %> impidieron guardar el producto global:</h4>
      <ul class="list-disc pl-5 text-sm">
        <% global_product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="flex flex-col items-center justify-center mb-2">
    <div class="relative" style="width: 140px; height: 140px;">
      <% image_url = begin
        if global_product.image.attached?
          if global_product.image.respond_to?(:blob) && global_product.image.blob && global_product.image.blob.persisted?
            url_for(global_product.image)
          elsif global_product.persisted?
            url_for(global_product.image)
          else
            asset_path('default_image.jpeg')
          end
        else
          asset_path('default_image.jpeg')
        end
      rescue ArgumentError
        asset_path('default_image.jpeg')
      end %>
      <img id="preview-global-product-image" src="<%= image_url %>" alt="Foto del producto global" style="width: 140px; height: 140px; object-fit: cover; border-radius: 50%; border: 2px solid #e2e8f0; background: #f8fafc;">
      <label for="global_product_image" class="absolute" style="bottom: 0; right: 0; background: #0ea5e9; border-radius: 50%; padding: 10px; cursor: pointer;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 24 24">
          <path d="M3 17.25V21h3.75l11.06-11.06-3.75-3.75L3 17.25zm17.71-10.04a1.003 1.003 0 0 0 0-1.42l-2.5-2.5a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
        </svg>
      </label>
      <%= f.file_field :image, class: "hidden", id: "global_product_image", accept: "image/*", onchange: "previewGlobalProductImage(event)" %>
    </div>
    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mt-2">Foto</div>
  </div>
  <script>
    function previewGlobalProductImage(event) {
      const input = event.target;
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const imagePreview = document.getElementById('preview-global-product-image');
          if (imagePreview) imagePreview.src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
      }
    }
  </script>
  <div>
    <%= f.label :name, "Descripcion", class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
    <%= f.text_field :name, class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:border-sky-400 focus:outline-none transition-all" %>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :presentation, "Presentacion", class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <%= f.select :presentation,
                   options_for_select([
                     ["Unidad", "unidad"],
                     ["Pack", "pack"],
                   ], global_product.presentation.to_s),
                   {},
                   class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:border-sky-400 focus:outline-none transition-all" %>
    </div>
    <div>
      <%= f.label :cant_presentation, "Unidades por pack", class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <%= f.number_field :cant_presentation,
                         min: 1,
                         step: 1,
                         class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:border-sky-400 focus:outline-none transition-all" %>
    </div>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <label for="global_product_category_name" class="text-xs font-bold text-slate-400 uppercase tracking-wider">Categoria</label>
      <% if category_name_options.any? %>
        <%= select_tag "global_product[category_name]",
                       options_for_select(category_name_options, current_category_name.presence),
                       include_blank: "Selecciona una categoria",
                       id: "global_product_category_name",
                       class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:border-sky-400 focus:outline-none transition-all" %>
      <% else %>
        <%= f.text_field :category_name,
                         value: global_product.category_name,
                         id: "global_product_category_name",
                         class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:border-sky-400 focus:outline-none transition-all",
                         placeholder: "Categoria" %>
      <% end %>
    </div>
    <div>
      <label for="global_product_cost_unit_visual" class="text-xs font-bold text-slate-400 uppercase tracking-wider">Costo Unid</label>
      <input type="text" name="global_product_cost_unit_visual" id="global_product_cost_unit_visual" class="w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:outline-none" placeholder="$ 0,00" data-money-mask="true" data-money-symbol="$" value="<%= cheapest_supplier_cost_unit.present? ? format_money(cheapest_supplier_cost_unit, unit: '$') : '' %>" readonly>
    </div>
  </div>
  <div>
    <label for="global_product_fixed_margin_percentage" class="text-xs font-bold text-slate-400 uppercase tracking-wider">Ganancia fija (%)</label>
    <% if profit_margin_presets.any? %>
      <%= select_tag "global_product[fixed_margin_percentage]",
                     options_for_select(
                       profit_margin_presets.map { |preset| ["#{format_quantity(preset.percentage)}%", preset.percentage.to_d.to_s('F')] },
                       selected_profit_margin_preset_id.present? ? profit_margin_presets.find { |preset| preset.id == selected_profit_margin_preset_id }&.percentage.to_d.to_s('F') : global_product.fixed_margin_percentage.to_d.to_s('F')
                     ),
                     include_blank: "Selecciona % fijo",
                     id: "global_product_fixed_margin_percentage",
                     class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:border-sky-400 focus:outline-none transition-all" %>
    <% else %>
      <%= f.text_field :fixed_margin_percentage,
                       value: global_product.fixed_margin_percentage,
                       class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:border-sky-400 focus:outline-none transition-all",
                       inputmode: "decimal",
                       autocomplete: "off",
                       placeholder: "% 0,00",
                       data: { money_mask: true, money_symbol: "%" } %>
    <% end %>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :sale_price_usd, "Precio Venta ($)", class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
      <%= f.text_field :sale_price_usd,
                       value: global_product.sale_price_usd,
                       class: "w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:outline-none",
                       inputmode: "decimal",
                       autocomplete: "off",
                       placeholder: "$ 0,00",
                       data: { money_mask: true, money_symbol: "$" } %>
      <% if show_suggested_price_badge %>
        <div id="global_product_suggested_price_badge" class="mt-2 rounded-lg border px-3 py-2 text-xs font-semibold border-amber-200 bg-amber-50 text-amber-700">
          Debes seleccionar el porcentaje fijo de ganancia para ver el precio sugerido.
        </div>
      <% end %>
    </div>
    <div>
      <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Precio Venta (Bs)</label>
      <input type="text" name="global_product_price_bs_visual" id="global_product_price_bs_visual" inputmode="decimal" autocomplete="off" data-money-mask="true" data-money-symbol="Bs" class="w-full mt-1 p-3 bg-slate-50 border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-sky-200 focus:outline-none" placeholder="Bs 0,00" readonly>
    </div>
  </div>
  <hr class="my-4 border-t-2 border-slate-200 rounded-xl">
  <div class="mt-2">
    <h6 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Proveedores globales</h6>
    <div class="mt-3 space-y-3">
      <% global_suppliers_for_product.each do |sp| %>
        <div class="rounded-2xl border border-slate-200 bg-slate-50/40 p-4">
          <div class="flex items-center justify-between">
            <div class="text-sm font-bold text-slate-700"><%= sp.global_supplier&.name || 'Proveedor global' %></div>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-4 text-sm text-slate-600">
            <div><span class="font-semibold">Costo mayor:</span> <%= format_money(sp.costo_mayor, unit: '$') %></div>
            <div><span class="font-semibold">Costo menor:</span> <%= format_money(sp.costo_menor, unit: '$') %></div>
            <div><span class="font-semibold">Unid por pack:</span> <%= format_quantity(sp.cantidad, precision: 0) %></div>
          </div>
        </div>
      <% end %>
      <% if global_suppliers_for_product.empty? %>
        <div class="text-sm text-slate-500">Este producto global no tiene proveedores globales asignados.</div>
      <% end %>
    </div>
  </div>
  <div>
    <% if modal_mode %>
      <%= f.submit submit_label, class: "modal-submit hidden" %>
    <% else %>
      <%= f.submit submit_label, class: "modal-submit inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 cursor-pointer" %>
    <% end %>
  </div>
<% end %>
<% if show_suggested_price_badge %>
  <script>
    (function() {
      const costInput = document.getElementById("global_product_cost_unit_visual");
      const marginInput = document.getElementById("global_product_fixed_margin_percentage");
      const salePriceInput = document.getElementById("global_product_sale_price_usd");
      const badge = document.getElementById("global_product_suggested_price_badge");
      if (!costInput || !marginInput || !salePriceInput || !badge) return;

      const RED_CLASSES = ["border-red-200", "bg-red-50", "text-red-700"];
      const GREEN_CLASSES = ["border-emerald-200", "bg-emerald-50", "text-emerald-700"];
      const WARNING_CLASSES = ["border-amber-200", "bg-amber-50", "text-amber-700"];

      function toDecimal(rawValue) {
        if (rawValue === null || rawValue === undefined) return null;
        let value = String(rawValue).trim();
        if (!value) return null;
        value = value.replace(/[^0-9,.-]/g, "");
        if (!value) return null;

        const lastComma = value.lastIndexOf(",");
        const lastDot = value.lastIndexOf(".");

        if (lastComma > lastDot) {
          value = value.replace(/\./g, "").replace(",", ".");
        } else if (lastDot > lastComma) {
          value = value.replace(/,/g, "");
        } else {
          value = value.replace(",", ".");
        }

        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : null;
      }

      function formatUsd(value) {
        return "$ " + value.toLocaleString("es-VE", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });
      }

      function setBadgeStyle(classSet) {
        badge.classList.remove(...RED_CLASSES, ...GREEN_CLASSES, ...WARNING_CLASSES);
        badge.classList.add(...classSet);
      }

      function refreshSuggestedBadge() {
        const unitCost = toDecimal(costInput.value);
        const fixedMarginPercentage = toDecimal(marginInput.value);
        const salePrice = toDecimal(salePriceInput.value) || 0;

        if (fixedMarginPercentage === null) {
          setBadgeStyle(WARNING_CLASSES);
          badge.textContent = "Debes seleccionar el porcentaje fijo de ganancia para ver el precio sugerido.";
          return;
        }

        if (unitCost === null || unitCost <= 0) {
          setBadgeStyle(WARNING_CLASSES);
          badge.textContent = "No hay costo unitario disponible para calcular el precio sugerido.";
          return;
        }

        const suggestedPrice = unitCost * (1 + (fixedMarginPercentage / 100));
        const suggestedLabel = formatUsd(suggestedPrice);
        const saleLabel = formatUsd(salePrice);

        if (suggestedPrice > salePrice) {
          setBadgeStyle(RED_CLASSES);
        } else {
          setBadgeStyle(GREEN_CLASSES);
        }

        badge.textContent = "Precio sugerido: " + suggestedLabel + " (venta actual: " + saleLabel + ")";
      }

      marginInput.addEventListener("change", refreshSuggestedBadge);
      marginInput.addEventListener("input", refreshSuggestedBadge);
      salePriceInput.addEventListener("change", refreshSuggestedBadge);
      salePriceInput.addEventListener("input", refreshSuggestedBadge);
      refreshSuggestedBadge();
    })();
  </script>
<% end %>
<script>
  (function() {
    const form = document.querySelector("form[data-global-product-bcv-rate]");
    const salePriceUsdInput = document.getElementById("global_product_sale_price_usd");
    const salePriceBsInput = document.getElementById("global_product_price_bs_visual");
    if (!form || !salePriceUsdInput || !salePriceBsInput) return;

    if (form.dataset.globalProductPriceSyncBound === "true") return;
    form.dataset.globalProductPriceSyncBound = "true";

    const bcvRate = Number.parseFloat(form.dataset.globalProductBcvRate || "0") || 0;

    function parseMoneyInput(input) {
      if (!input) return 0;
      if (window.MoneyInputMask?.parseValue) {
        return Number(window.MoneyInputMask.parseValue(input) || 0);
      }

      const compact = String(input.value || "")
        .replace(/\s/g, "")
        .replace(/[^\d.,-]/g, "");

      let normalized = compact;
      if (compact.includes(",")) {
        normalized = compact.replace(/\./g, "").replace(",", ".");
      } else if (/^\d{1,3}(\.\d{3})+$/.test(compact)) {
        normalized = compact.replace(/\./g, "");
      }

      const parsed = Number.parseFloat(normalized);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function setMoneyInput(input, value) {
      const safe = Number.isFinite(Number(value)) ? Math.max(Number(value), 0) : 0;

      if (window.MoneyInputMask?.setValue) {
        const symbol = input.dataset.moneySymbol || "Bs";
        window.MoneyInputMask.setValue(input, safe, symbol);
        return;
      }

      input.value = safe.toLocaleString("es-VE", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    }

    function refreshBsFromUsd() {
      const usdValue = parseMoneyInput(salePriceUsdInput);
      const bsValue = bcvRate > 0 ? usdValue * bcvRate : 0;
      setMoneyInput(salePriceBsInput, bsValue);
    }

    salePriceUsdInput.addEventListener("input", refreshBsFromUsd);
    salePriceUsdInput.addEventListener("change", refreshBsFromUsd);
    salePriceUsdInput.addEventListener("blur", refreshBsFromUsd);

    form.addEventListener("submit", () => {
      const normalizedUsd = parseMoneyInput(salePriceUsdInput);
      salePriceUsdInput.value = normalizedUsd.toFixed(2);
    });

    refreshBsFromUsd();
  })();
</script>
