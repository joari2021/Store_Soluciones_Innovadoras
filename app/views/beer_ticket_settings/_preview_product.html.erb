<% ticket_layout = beer_ticket_layout_config %>
<% if preview_product.present? %>
  <div class="h-full w-full overflow-hidden rounded-full">
    <% if preview_product.foto.attached? %>
      <%= image_tag preview_product.foto, class: 'h-full w-full object-contain', style: "transform: scale(#{ticket_layout[:product_scale]}) translateY(#{ticket_layout[:product_translate_y_pct]}%); transform-origin: center center;", alt: preview_product.display_name_with_presentation %>
    <% else %>
      <%= image_tag 'default_image.jpeg', class: 'h-full w-full object-contain', style: "transform: scale(#{ticket_layout[:product_scale]}) translateY(#{ticket_layout[:product_translate_y_pct]}%); transform-origin: center center;", alt: 'Imagen por defecto' %>
    <% end %>
  </div>
<% else %>
  <div class="flex h-full w-full items-center justify-center rounded-full bg-white/70 text-center text-[10px] font-semibold uppercase tracking-wider text-slate-500">
    Selecciona un producto
  </div>
<% end %>
