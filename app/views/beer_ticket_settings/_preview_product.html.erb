<% if preview_product.present? %>
  <div class="h-full w-full overflow-hidden rounded-full">
    <% if preview_product.foto.attached? %>
      <%= image_tag preview_product.foto, class: 'h-full w-full scale-[1.3] translate-y-[12%] object-contain', alt: preview_product.display_name_with_presentation %>
    <% else %>
      <%= image_tag 'default_image.jpeg', class: 'h-full w-full scale-[1.3] translate-y-[12%] object-contain', alt: 'Imagen por defecto' %>
    <% end %>
  </div>
<% else %>
  <div class="flex h-full w-full items-center justify-center rounded-full bg-white/70 text-center text-[10px] font-semibold uppercase tracking-wider text-slate-500">
    Selecciona un producto
  </div>
<% end %>
