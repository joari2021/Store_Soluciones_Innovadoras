<% ticket_layout = beer_ticket_layout_config %>
<style>
  @page {
    size: Letter;
    margin: 0.18in;
  }

  .sheet {
    width: 8.14in !important;
    min-height: 10.64in !important;
    padding: 0 !important;
  }

  .tickets-grid {
    display: grid;
    grid-template-columns: repeat(3, 6.4cm);
    gap: 0.22cm;
    justify-content: center;
    align-content: flex-start;
  }

  .beer-ticket {
    position: relative;
    width: 6.4cm;
    border: 1px dashed #cbd5e1;
    border-radius: 3px;
    overflow: visible;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .beer-ticket-canvas {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 2px;
  }

  .beer-ticket-bg {
    width: 100%;
    height: auto;
    display: block;
  }

  .beer-ticket-product-circle {
    position: absolute;
    left: <%= ticket_layout[:product_left_pct] %>%;
    top: <%= ticket_layout[:product_top_pct] %>%;
    height: <%= ticket_layout[:product_height_pct] %>%;
    aspect-ratio: 1 / 1;
    border-radius: 999px;
    overflow: hidden;
  }

  .beer-ticket-product {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(<%= ticket_layout[:product_scale] %>) translateY(<%= ticket_layout[:product_translate_y_pct] %>%);
    transform-origin: center center;
  }

  .beer-ticket-serial {
    position: absolute;
    right: <%= ticket_layout[:serial_right_pct] %>%;
    bottom: <%= ticket_layout[:serial_bottom_pct] %>%;
    color: #0f172a;
    font-family: 'Brush Script MT', 'Segoe Script', 'Lucida Handwriting', cursive;
    font-size: <%= ticket_layout[:serial_font_cm] %>cm;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .batch-caption {
    margin: 0 0 10px;
    font-size: 12px;
    color: #334155;
    font-weight: 700;
  }

  @media print {
    .batch-caption {
      display: none;
    }

    .beer-ticket {
      border-color: #dbe6ef;
    }
  }
</style>
<p class="batch-caption">
  Lote: <%= @batch.formatted_start_serial %> - <%= @batch.formatted_end_serial %> | Producto: <%= @product.display_name_with_presentation %> | Cantidad: <%= @batch.ticket_count %>
</p>
<div class="tickets-grid">
  <% @serials.each do |serial| %>
    <article class="beer-ticket">
      <div class="beer-ticket-canvas">
        <img src="<%= @ticket_background_path %>" alt="Ticket de cerveza" class="beer-ticket-bg">
        <div class="beer-ticket-product-circle">
          <img src="<%= @ticket_product_image_path %>" alt="Imagen producto" class="beer-ticket-product" loading="eager" decoding="sync">
        </div>
        <div class="beer-ticket-serial"><%= format('%04d', serial.to_i) %></div>
      </div>
    </article>
  <% end %>
</div>
