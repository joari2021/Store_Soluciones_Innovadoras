<% if controlled_products.any? %>
  <div class="space-y-2" data-beer-ticket-products-list="true">
    <% controlled_products.each do |producto| %>
      <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-3" data-controlled-product-id="<%= producto.id %>" data-controlled-product-name="<%= producto.display_name_with_presentation %>">
        <div class="flex min-w-0 items-center gap-3">
          <div class="h-10 w-10 overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
            <% if producto.foto.attached? %>
              <%= image_tag producto.foto, class: 'h-full w-full object-cover', alt: producto.display_name_with_presentation, loading: 'lazy', decoding: 'async' %>
            <% else %>
              <%= image_tag 'default_image.jpeg', class: 'h-full w-full object-cover', alt: 'Imagen por defecto', loading: 'lazy', decoding: 'async' %>
            <% end %>
          </div>
          <p class="truncate text-sm font-semibold text-slate-800"><%= producto.display_name_with_presentation %></p>
        </div>
        <button type="button" class="inline-flex items-center justify-center rounded-lg border border-rose-200 bg-rose-50 p-2 text-rose-600 hover:bg-rose-100" data-remove-controlled-product="true" data-product-id="<%= producto.id %>" aria-label="Quitar producto" title="Quitar">
          <i data-lucide="x" class="h-4 w-4"></i>
        </button>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500" data-beer-ticket-products-list="true">
    No hay productos agregados todavia.
  </div>
<% end %>
