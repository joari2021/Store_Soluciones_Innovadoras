<% setting_products = Array(setting_products) %>
<h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-700">5. Lotes creados e impresión</h3>
<p class="mt-1 text-xs text-slate-500">Cada lote genera hojas en PDF listas para imprimir en tamaño carta, tickets de 5 cm x 2 cm.</p>

<% if setting_products.any? %>
  <div class="mt-3 space-y-3">
    <% setting_products.each do |setting_product| %>
      <% producto = setting_product.producto %>
      <% batches = setting_product.beer_ticket_batches.latest_first %>
      <article class="rounded-2xl border border-slate-200 bg-white p-4">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-sm font-bold text-slate-800"><%= producto.display_name_with_presentation %></p>
            <p class="mt-0.5 text-xs text-slate-500">Serial disponible actual: <span class="font-bold text-slate-700"><%= setting_product.formatted_next_serial %></span></p>
            <% if batches.any? %>
              <p class="mt-1 text-xs font-semibold text-amber-700">Advertencia: este producto ya tiene tickets asociados activos.</p>
            <% end %>
          </div>
          <span class="rounded-full bg-sky-100 px-2.5 py-1 text-xs font-bold text-sky-700"><%= batches.size %> lote<%= batches.size == 1 ? '' : 's' %></span>
        </div>

        <% if batches.any? %>
          <div class="mt-3 overflow-hidden rounded-xl border border-slate-200">
            <table class="min-w-full text-xs text-slate-700">
              <thead class="bg-slate-50 uppercase tracking-wider text-slate-500">
                <tr>
                  <th class="px-3 py-2 text-left">Creado</th>
                  <th class="px-3 py-2 text-left">Rango</th>
                  <th class="px-3 py-2 text-right">Cantidad</th>
                  <th class="px-3 py-2 text-right">Impresión</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% batches.each do |batch| %>
                  <tr>
                    <td class="px-3 py-2"><%= batch.created_at.in_time_zone('America/Caracas').strftime('%d/%m/%Y %H:%M') %></td>
                    <td class="px-3 py-2 font-semibold"><%= batch.formatted_start_serial %> - <%= batch.formatted_end_serial %></td>
                    <td class="px-3 py-2 text-right"><%= batch.ticket_count %></td>
                    <td class="px-3 py-2 text-right">
                      <%= link_to batch_pdf_beer_ticket_setting_path(batch_id: batch.id),
                                  target: '_blank',
                                  class: 'inline-flex items-center rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1 font-semibold text-sky-700 hover:bg-sky-100' do %>
                        Imprimir PDF
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="mt-3 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-3 text-xs text-slate-500">Aun no hay lotes creados para este producto.</p>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="mt-3 rounded-xl border border-dashed border-slate-300 bg-white p-3 text-sm text-slate-500">No hay productos controlados para mostrar lotes.</p>
<% end %>
