<% setting_products = Array(setting_products) %>
<% selected_id = selected_producto_id.presence&.to_i || setting_products.first&.producto_id %>
<% selected_setting_product = setting_products.find { |item| item.producto_id == selected_id } || setting_products.first %>

<h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-700">4. Crear tickets por producto</h3>
<p class="mt-1 text-xs text-slate-500">El serial inicial es el siguiente disponible para el producto seleccionado.</p>

<% if setting_products.any? %>
  <div class="mt-3 grid gap-3 md:grid-cols-2">
    <div>
      <label for="beer-ticket-batch-product" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">Producto</label>
      <select id="beer-ticket-batch-product" class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" data-beer-ticket-batch-product="true">
        <% setting_products.each do |setting_product| %>
          <option value="<%= setting_product.producto_id %>" data-next-serial="<%= setting_product.next_serial %>" <%= setting_product.producto_id == selected_setting_product&.producto_id ? 'selected' : '' %>>
            <%= setting_product.producto.display_name_with_presentation %>
          </option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="beer-ticket-batch-start" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">Serial inicial disponible</label>
      <input id="beer-ticket-batch-start" type="text" readonly value="<%= selected_setting_product&.formatted_next_serial || '0001' %>" class="mt-1 block w-full rounded-xl border border-slate-300 bg-slate-100 px-3 py-2 text-sm font-bold text-slate-700" data-beer-ticket-batch-start="true">
    </div>

    <div>
      <label for="beer-ticket-batch-end" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">Serial final a crear</label>
      <input id="beer-ticket-batch-end" type="number" min="1" value="<%= selected_setting_product&.next_serial.to_i.positive? ? selected_setting_product.next_serial : 1 %>" class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" data-beer-ticket-batch-end="true">
    </div>

    <div>
      <label for="beer-ticket-batch-count" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">Cantidad estimada</label>
      <input id="beer-ticket-batch-count" type="text" readonly value="1 ticket" class="mt-1 block w-full rounded-xl border border-slate-300 bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-700" data-beer-ticket-batch-count="true">
    </div>
  </div>

  <div class="mt-3 flex items-center justify-between gap-3">
    <p class="text-xs text-slate-500">Cada lote queda asociado al producto y habilita su impresión en PDF.</p>
    <button type="button" class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800" data-beer-ticket-create-batch="true">
      Crear tickets
    </button>
  </div>
<% else %>
  <p class="mt-3 rounded-xl border border-dashed border-slate-300 bg-white p-3 text-sm text-slate-500">Agrega al menos un producto para crear lotes de tickets.</p>
<% end %>
