<%= form_with model: business, local: true do |f| %>
  <% if business.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-bold">No se pudo guardar el negocio</h4>
        <span class="text-xs font-medium"><%= pluralize(business.errors.count, 'error') %></span>
      </div>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% business.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="space-y-4">
    <div>
      <%= f.label :name, 'Nombre del negocio', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_field :name, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: Sistema Central, Sucursal Valencia' %>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <%= f.label :phone, 'Telefono del negocio', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :phone, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: 0412-0000000' %>
      </div>
      <div>
        <%= f.label :rif, 'RIF del negocio', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :rif, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: J-12345678-9' %>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <%= f.label :city, 'Ciudad', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :city, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: Valencia' %>
      </div>
      <div>
        <%= f.label :state, 'Estado', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :state, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: Carabobo' %>
      </div>
    </div>
    <div>
      <%= f.label :address, 'Direccion del negocio', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_area :address, rows: 2, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: Av. Principal, local 12, Valencia' %>
    </div>
    <div>
      <%= f.label :theme_profile, 'Perfil de color', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.select :theme_profile,
                   options_for_select(Business.theme_profile_options, business.theme_profile || Business::DEFAULT_THEME_PROFILE),
                   {},
                   class: 'mt-1 block w-full rounded-md border border-slate-300 bg-white shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      <p class="mt-1 text-xs text-slate-500">Selecciona entre perfiles con azules claros, cyan y cyan electrico.</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
      <label class="inline-flex cursor-pointer items-start gap-3 text-sm text-slate-700">
        <%= f.check_box :hide_initial_inventory_button,
                        class: 'mt-0.5 h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500' %>
        <span>
          <span class="block font-semibold text-slate-800">Ocultar boton de inventario inicial</span>
          <span class="mt-0.5 block text-xs text-slate-500">Si lo activas, en facturas de compra no se mostrara el acceso para cargar o editar inventario inicial.</span>
        </span>
      </label>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
      <label class="inline-flex cursor-pointer items-start gap-3 text-sm text-slate-700">
        <%= f.check_box :customer_pos_restrictions_enabled,
                        class: 'mt-0.5 h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500' %>
        <span>
          <span class="block font-semibold text-slate-800">Activar restricciones para usuarios cliente en Ventas</span>
          <span class="mt-0.5 block text-xs text-slate-500">Si lo activas, en este negocio los usuarios cliente tendran bloqueo de funciones y UI reducida (por ejemplo, carrito y borradores). Si lo desactivas, se comportaran como modo normal.</span>
        </span>
      </label>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <%= f.label :logo, 'Logo del negocio', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.file_field :logo, accept: 'image/*', class: 'mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200' %>
        <p class="mt-1 text-xs text-slate-500">Se muestra en el sidebar en formato circular.</p>
        <% if business.logo.attached? %>
          <div class="mt-2 inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-2 py-2">
            <%= image_tag business.logo, class: 'h-12 w-12 rounded-full border border-slate-200 object-cover', alt: "Logo de #{business.name}" %>
            <span class="text-xs font-medium text-slate-600">Logo actual</span>
          </div>
        <% end %>
      </div>
      <div>
        <%= f.label :banner, 'Banner del negocio', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.file_field :banner, accept: 'image/*', class: 'mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200' %>
        <p class="mt-1 text-xs text-slate-500">Se usa como fondo del bloque superior del sidebar.</p>
        <% if business.banner.attached? %>
          <div class="mt-2 overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
            <%= image_tag business.banner, class: 'h-16 w-full object-cover', alt: "Banner de #{business.name}" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="mt-6">
    <%= f.submit business.persisted? ? 'Actualizar negocio' : 'Guardar negocio', class: 'rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-800' %>
  </div>
<% end %>
