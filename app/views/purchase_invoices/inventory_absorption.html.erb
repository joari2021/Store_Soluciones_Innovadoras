<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-amber-200 bg-gradient-to-r from-amber-50 via-white to-orange-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Absorber inventario inter-empresas</h1>
        <p class="mt-1 text-sm text-slate-600">Fusiona inventario por lotes con costos exactos por lote, sin generar factura por pagar.</p>
      </div>
      <%= link_to purchase_invoices_path, class: "inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
        Volver a facturas
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-amber-200 bg-white p-4 shadow-sm sm:p-5">
    <%= form_with url: absorb_source_inventory_purchase_invoices_path,
                  method: :post,
                  local: true,
                  class: 'grid gap-3 md:grid-cols-[minmax(14rem,1fr)_minmax(12rem,1fr)_auto_auto] md:items-end' do %>
      <div>
        <label for="absorb_inventory_source_business_id" class="block text-xs font-semibold uppercase tracking-wider text-amber-800">Negocio origen</label>
        <%= select_tag :source_business_id,
                       options_for_select(@available_source_businesses.map { |business| [business.name, business.id] }, @absorption_source_business_id),
                       id: 'absorb_inventory_source_business_id',
                       class: 'mt-1 block w-full rounded-xl border border-amber-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-amber-500 focus:ring-amber-500' %>
      </div>
      <div>
        <label for="absorb_inventory_mode" class="block text-xs font-semibold uppercase tracking-wider text-amber-800">Modo</label>
        <%= select_tag :absorption_mode,
                       options_for_select([['Mover inventario (recomendado)', 'move'], ['Copiar inventario', 'copy']], @absorption_mode),
                       id: 'absorb_inventory_mode',
                       class: 'mt-1 block w-full rounded-xl border border-amber-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-amber-500 focus:ring-amber-500' %>
      </div>
      <button type="submit"
              name="dry_run"
              value="1"
              class="inline-flex items-center justify-center rounded-xl border border-amber-300 bg-white px-4 py-2.5 text-sm font-semibold text-amber-900 shadow-sm transition-colors hover:bg-amber-100 cursor-pointer">
        Simular
      </button>
      <button type="submit"
              name="dry_run"
              value="0"
              class="inline-flex items-center justify-center rounded-xl bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-amber-800 cursor-pointer"
              data-confirm="Se aplicara la absorcion real del inventario. Esta accion no crea factura por pagar.">
        Ejecutar absorcion
      </button>
    <% end %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h2 class="text-base font-bold text-slate-800">Historial de simulaciones</h2>
        <p class="mt-1 text-sm text-slate-500">Cada simulacion queda registrada para consulta posterior, sin afectar el inventario real.</p>
      </div>
    </div>

    <% if @absorption_simulations.present? %>
      <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200">
        <table class="min-w-full table-auto text-sm text-slate-700">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-4 py-3 text-left font-bold">Fecha</th>
              <th class="px-4 py-3 text-left font-bold">Origen</th>
              <th class="px-4 py-3 text-left font-bold">Modo</th>
              <th class="px-4 py-3 text-right font-bold">Productos</th>
              <th class="px-4 py-3 text-right font-bold">Lotes</th>
              <th class="px-4 py-3 text-right font-bold">Unidades</th>
              <th class="px-4 py-3 text-right font-bold">Accion</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @absorption_simulations.each do |simulation| %>
              <% summary = simulation.summary || {} %>
              <% selected = @selected_absorption_simulation.present? && @selected_absorption_simulation.id == simulation.id %>
              <tr class="<%= selected ? 'bg-sky-50/50' : '' %>">
                <td class="px-4 py-3"><%= simulation.simulated_at.in_time_zone('America/Caracas').strftime('%d/%m/%Y %I:%M %p') %></td>
                <td class="px-4 py-3 font-semibold text-slate-800"><%= simulation.source_business&.name || "Negocio ##{simulation.source_business_id}" %></td>
                <td class="px-4 py-3"><span class="inline-flex items-center rounded-full border border-slate-300 bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700"><%= simulation.mode == 'copy' ? 'Copiar' : 'Mover' %></span></td>
                <td class="px-4 py-3 text-right"><%= (summary['products_touched'] || summary[:products_touched]).to_i %></td>
                <td class="px-4 py-3 text-right"><%= (summary['lots_transferred'] || summary[:lots_transferred]).to_i %></td>
                <td class="px-4 py-3 text-right"><%= (summary['units_transferred'] || summary[:units_transferred]).to_d.round(2).to_s('F') %></td>
                <td class="px-4 py-3 text-right">
                  <%= link_to inventory_absorption_purchase_invoices_path(simulation_id: simulation.id), class: "inline-flex items-center justify-center rounded-xl border px-3 py-1.5 text-xs font-semibold #{selected ? 'border-sky-300 bg-sky-100 text-sky-800' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50'}" do %>
                    Ver detalle
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center">
        <h3 class="text-sm font-semibold text-slate-700">Aun no hay simulaciones registradas</h3>
        <p class="mt-1 text-sm text-slate-500">Haz una simulacion para generar el primer registro de analisis.</p>
      </div>
    <% end %>
  </div>

  <% if @absorption_summary.present? %>
    <% simulation_label = if @absorption_simulated
                            'Resultado de simulacion guardado ahora (sin guardar cambios de inventario)'
                          elsif @selected_absorption_simulation.present?
                            "Detalle de simulacion ##{@selected_absorption_simulation.id}"
                          else
                            'Resultado de simulacion (sin guardar cambios de inventario)'
                          end %>
    <div class="rounded-2xl border border-sky-200 bg-sky-50 p-4 shadow-sm sm:p-5">
      <h2 class="text-base font-bold text-sky-900"><%= simulation_label %></h2>
      <% if @selected_absorption_simulation.present? %>
        <p class="mt-1 text-xs text-sky-800">
          Origen: <span class="font-semibold"><%= @selected_absorption_simulation.source_business&.name || "Negocio ##{@selected_absorption_simulation.source_business_id}" %></span>
          · Modo: <span class="font-semibold"><%= @selected_absorption_simulation.mode == 'copy' ? 'Copiar' : 'Mover' %></span>
          · Fecha: <span class="font-semibold"><%= @selected_absorption_simulation.simulated_at.in_time_zone('America/Caracas').strftime('%d/%m/%Y %I:%M %p') %></span>
        </p>
      <% end %>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <div class="rounded-xl border border-sky-200 bg-white p-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-sky-700">Productos tocados</p>
          <p class="mt-1 text-lg font-extrabold text-slate-800"><%= @absorption_summary[:products_touched].to_i %></p>
        </div>
        <div class="rounded-xl border border-sky-200 bg-white p-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-sky-700">Productos nuevos</p>
          <p class="mt-1 text-lg font-extrabold text-slate-800"><%= @absorption_summary[:destination_products_created].to_i %></p>
        </div>
        <div class="rounded-xl border border-sky-200 bg-white p-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-sky-700">Lotes transferidos</p>
          <p class="mt-1 text-lg font-extrabold text-slate-800"><%= @absorption_summary[:lots_transferred].to_i %></p>
        </div>
        <div class="rounded-xl border border-sky-200 bg-white p-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-sky-700">Unidades transferidas</p>
          <p class="mt-1 text-lg font-extrabold text-slate-800"><%= @absorption_summary[:units_transferred].to_d.round(2).to_s('F') %></p>
        </div>
        <div class="rounded-xl border border-sky-200 bg-white p-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-sky-700">Lotes omitidos</p>
          <p class="mt-1 text-lg font-extrabold text-slate-800"><%= @absorption_summary[:lots_skipped_existing].to_i %></p>
        </div>
      </div>
    </div>

    <% preview_payload = @absorption_preview || {} %>
    <% preview_products = Array(preview_payload[:products] || preview_payload['products']) %>
    <% if preview_products.any? %>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <h2 class="text-base font-bold text-slate-800">Inventario proyectado por producto</h2>
        <p class="mt-1 text-sm text-slate-500">Vista analitica de como quedaria el inventario si se ejecutara la absorcion, sin alterar stock real.</p>
        <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200">
          <table class="min-w-full table-auto text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-4 py-3 text-left font-bold">Producto</th>
                <th class="px-4 py-3 text-left font-bold">Categoria</th>
                <th class="px-4 py-3 text-right font-bold">Existencia</th>
                <th class="px-4 py-3 text-right font-bold">A absorber</th>
                <th class="px-4 py-3 text-right font-bold">Existencia proy.</th>
                <th class="px-4 py-3 text-right font-bold">Costo prom. proy. $</th>
                <th class="px-4 py-3 text-right font-bold">Precio venta $</th>
                <th class="px-4 py-3 text-right font-bold">Valor inv. proy. $</th>
                <th class="px-4 py-3 text-right font-bold">Valor venta proy. $</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% preview_products.each do |row| %>
                <% descripcion = row[:descripcion] || row['descripcion'] %>
                <% presentation = row[:presentation] || row['presentation'] %>
                <% categoria = row[:categoria_nombre] || row['categoria_nombre'] %>
                <% current_quantity = (row[:current_quantity] || row['current_quantity']).to_d %>
                <% incoming_quantity = (row[:incoming_quantity] || row['incoming_quantity']).to_d %>
                <% projected_quantity = (row[:projected_quantity] || row['projected_quantity']).to_d %>
                <% sale_price_usd = (row[:sale_price_usd] || row['sale_price_usd']).to_d %>
                <% projected_inventory_value = (row[:projected_inventory_value_usd] || row['projected_inventory_value_usd']).to_d %>
                <% projected_sale_value = (row[:projected_sale_value_usd] || row['projected_sale_value_usd']).to_d %>
                <% projected_avg_cost = projected_quantity.positive? ? (projected_inventory_value / projected_quantity).round(4) : 0.to_d %>
                <tr>
                  <td class="px-4 py-3 font-semibold text-slate-800">
                    <%= descripcion %>
                    <span class="ml-1 text-xs font-medium text-slate-500"><%= presentation.to_s.upcase %></span>
                  </td>
                  <td class="px-4 py-3"><%= categoria.presence || 'Sin categoria' %></td>
                  <td class="px-4 py-3 text-right"><%= current_quantity.round(2).to_s('F') %></td>
                  <td class="px-4 py-3 text-right text-amber-700 font-semibold"><%= incoming_quantity.round(2).to_s('F') %></td>
                  <td class="px-4 py-3 text-right font-bold text-slate-900"><%= projected_quantity.round(2).to_s('F') %></td>
                  <td class="px-4 py-3 text-right"><%= projected_avg_cost.round(4).to_s('F') %></td>
                  <td class="px-4 py-3 text-right"><%= sale_price_usd.positive? ? format_money(sale_price_usd, unit: '$', precision: 2) : '—' %></td>
                  <td class="px-4 py-3 text-right font-semibold"><%= format_money(projected_inventory_value, unit: '$') %></td>
                  <td class="px-4 py-3 text-right font-semibold"><%= format_money(projected_sale_value, unit: '$') %></td>
                </tr>

                <% incoming_lots = Array(row[:incoming_lots] || row['incoming_lots']) %>
                <tr class="bg-slate-50/60">
                  <td colspan="9" class="px-4 py-3">
                    <% if incoming_lots.any? %>
                      <div class="space-y-1 text-xs text-slate-700">
                        <% incoming_lots.each do |lot| %>
                          <% source_lot_id = lot[:source_lot_id] || lot['source_lot_id'] %>
                          <% quantity_remaining = (lot[:quantity_remaining] || lot['quantity_remaining']).to_d %>
                          <% unit_cost_usd = (lot[:unit_cost_usd] || lot['unit_cost_usd']).to_d %>
                          <% purchased_at = lot[:purchased_at] || lot['purchased_at'] %>
                          <div class="rounded-lg border border-slate-200 bg-white px-2 py-1">
                            Lote origen #<%= source_lot_id %> · Cant: <%= quantity_remaining.round(2).to_s('F') %> · Costo USD: <%= unit_cost_usd.round(4).to_s('F') %>
                            <% if purchased_at.present? %>
                              <% purchased_date = begin
                                                  Date.parse(purchased_at.to_s).strftime('%d/%m/%Y')
                                                rescue StandardError
                                                  purchased_at.to_s
                                                end %>
                              · Fecha: <%= purchased_date %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-xs text-slate-400">Sin lotes entrantes para este producto.</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm">
        <h3 class="text-base font-semibold text-slate-700">No hay lotes para absorber</h3>
        <p class="mt-1 text-sm text-slate-500">El negocio origen no tiene lotes con saldo disponible para transferir.</p>
      </div>
    <% end %>
  <% end %>
</div>
