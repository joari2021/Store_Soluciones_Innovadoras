<% status_key = invoice_payment_status_for(purchase_invoice) %>
<% status_label = invoice_payment_status_label(status_key) %>
<article data-invoice-status="<%= status_key %>" class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-all duration-200 hover:border-sky-200 hover:shadow-md hover:shadow-sky-100/50">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-base font-bold text-slate-800">Factura #<%= purchase_invoice.id %></h3>
      <p class="mt-1 text-sm text-slate-600"><span class="font-semibold text-slate-700">Proveedor:</span> <%= purchase_invoice.supplier_display_name %></p>
      <p class="mt-2">
        <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold <%= invoice_payment_status_badge_class(status_key) %>"><%= status_label %></span>
      </p>
    </div>
    <span class="inline-flex items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= format_money(purchase_invoice.monto_total, unit: '$') %></span>
  </div>
  <div class="mt-3 text-sm text-slate-600">
    <span class="font-semibold text-slate-700">Fecha:</span> <%= purchase_invoice.fecha_emision.present? ? purchase_invoice.fecha_emision.to_date.strftime('%d/%m/%Y') : '-' %>
  </div>
  <div class="mt-4 flex items-center gap-2">
    <%= link_to purchase_invoice_path(purchase_invoice), class: 'inline-flex items-center justify-center rounded-lg bg-emerald-50 p-2 text-emerald-600 hover:bg-emerald-100 transition-colors cursor-pointer', title: 'Ver', aria: { label: 'Ver' } do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
        <path d="M12 4.5c-5 0-9.27 3.11-11 7.5 1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5Zm0 12a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
        <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
      </svg>
    <% end %>
    <%= link_to edit_purchase_invoice_path(purchase_invoice), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors cursor-pointer', title: 'Editar', aria: { label: 'Editar' } do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
        <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
      </svg>
    <% end %>
    <% if current_user_admin? %>
      <%= link_to purchase_invoice_path(purchase_invoice),
                  class: 'inline-flex items-center justify-center rounded-lg bg-rose-50 p-2 text-rose-600 hover:bg-rose-100 transition-colors cursor-pointer',
                  title: 'Eliminar',
                  aria: { label: 'Eliminar' },
                  data: { turbo_method: :delete, swal_delete: 'purchase_invoice', turbo_frame: '_top' } do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M9 3a1 1 0 0 0-1 1v1H5a1 1 0 1 0 0 2h.636l.89 12.46A2 2 0 0 0 8.52 21h6.96a2 2 0 0 0 1.994-1.54L18.364 7H19a1 1 0 1 0 0-2h-3V4a1 1 0 0 0-1-1H9Zm2 2h2v1h-2V5Zm-2.37 2h6.74l-.86 12.04a.5.5 0 0 1-.498.46H9.988a.5.5 0 0 1-.498-.46L8.63 7Z" />
        </svg>
      <% end %>
    <% end %>
  </div>
</article>