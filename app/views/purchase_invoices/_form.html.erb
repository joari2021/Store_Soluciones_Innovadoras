<script>
  const initFacturaForm = (scope) => {
    const form = scope.querySelector('#purchase_invoice_form');
    if (!form) return;
    if (form.dataset.facturaItemsBound === 'true') return;
    form.dataset.facturaItemsBound = 'true';

    const moneyMask = window.MoneyInputMask;

    if (!form.dataset.facturaIndex) {
      form.dataset.facturaIndex = String(Date.now());
    }

    const searchInput = form.querySelector('#producto-search');
    const resultsBox = form.querySelector('#producto-results');
    const supplierSelect = form.querySelector('#purchase_invoice_supplier_id');
    const supplierCurrencyPriorityValue = form.querySelector('#supplier-currency-priority-value');
    const tasaInput = form.querySelector('#purchase_invoice_tasa_dolar');
    const tasaInputRaw = form.querySelector('#purchase_invoice_tasa_dolar_raw');
    const tbody = form.querySelector('#factura-items');
    const template = scope.querySelector('#factura-item-template') || document.querySelector('#factura-item-template');

    if (!tbody || !template) return;

    let lastSupplierAlertAt = 0;

    const hasSupplierSelected = () => Boolean(supplierSelect && supplierSelect.value && supplierSelect.value.trim() !== '');
    const currentSupplierPriority = () => {
      const selectedOption = supplierSelect?.options?.[supplierSelect.selectedIndex];
      const priority = selectedOption?.dataset?.pricingCurrencyPriority;
      return priority === 'bs' ? 'bs' : 'usd';
    };
    const currentSupplierDefaultExento = () => {
      const selectedOption = supplierSelect?.options?.[supplierSelect.selectedIndex];
      return String(selectedOption?.dataset?.defaultExento || 'false') === 'true';
    };
    const syncSupplierPriorityBadge = () => {
      if (!supplierCurrencyPriorityValue) return;
      supplierCurrencyPriorityValue.textContent = currentSupplierPriority() === 'bs' ? 'Bs' : '$';
    };

    const showSupplierRequiredAlert = () => {
      const now = Date.now();
      if (now - lastSupplierAlertAt < 1200) return;
      lastSupplierAlertAt = now;

      if (window.Swal) {
        window.Swal.fire({
          icon: 'info',
          title: 'Proveedor requerido',
          text: 'Seleccione primero a un proveedor.',
          confirmButtonText: 'Entendido',
          confirmButtonColor: '#0284c7',
          target: 'body',
          heightAuto: false
        });
      }
    };

    const updateSearchLockState = () => {
      if (!searchInput) return;

      const locked = !hasSupplierSelected();
      searchInput.readOnly = locked;

      if (locked) {
        searchInput.value = '';
        searchInput.placeholder = 'Seleccione primero un proveedor';
        if (resultsBox) resultsBox.classList.add('hidden');
      } else {
        searchInput.placeholder = 'Buscar producto...';
      }
    };

    const escapeHtml = (value) => {
      const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return String(value || '').replace(/[&<>"']/g, (m) => map[m]);
    };

    const parseNumber = (rawValue) => {
      const compact = String(rawValue || '').replace(/\s/g, '').replace(/[^\d.,-]/g, '');
      let normalized = compact;
      if (compact.includes(',')) {
        normalized = compact.replace(/\./g, '').replace(',', '.');
      } else if (/^\d{1,3}(\.\d{3})+$/.test(compact)) {
        normalized = compact.replace(/\./g, '');
      }
      const parsed = Number.parseFloat(normalized);
      return Number.isFinite(parsed) ? parsed : 0;
    };

    const formatNumber = (value) => Number(value || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const formatMoney = (value, unit) => `${unit}\u00A0${formatNumber(value)}`;
    const formatQty = (value) => {
      const numeric = Number(value || 0);
      const hasDecimals = Math.abs(numeric - Math.trunc(numeric)) > 0;
      return numeric.toLocaleString('es-VE', {
        minimumFractionDigits: hasDecimals ? 2 : 0,
        maximumFractionDigits: hasDecimals ? 2 : 0
      });
    };
    const formatDecimalInput = (value, scale = 2) => {
      const rawValue = String(value ?? '').trim();
      if (rawValue === '') return '';
      const rounded = Number(parseNumber(rawValue).toFixed(scale));
      if (!Number.isFinite(rounded)) return '';
      const hasDecimals = Math.abs(rounded - Math.trunc(rounded)) > 0;
      return hasDecimals ? rounded.toFixed(scale) : String(Math.trunc(rounded));
    };
    const currentRate = () => {
      const rawRate = parseNumber(tasaInputRaw?.value);
      if (rawRate > 0) return rawRate;
      return parseNumber(tasaInput?.value);
    };
    const clampNonNegative = (value) => Math.max(parseNumber(value), 0);

    const syncRawRateInput = () => {
      if (!tasaInputRaw) return;
      tasaInputRaw.value = clampNonNegative(tasaInput?.value).toFixed(4);
    };

    const setMaskedMoney = (input, value, unit) => {
      if (!input) return;
      if (moneyMask) {
        moneyMask.setValue(input, clampNonNegative(value), unit);
        return;
      }
      input.value = formatMoney(clampNonNegative(value), unit);
    };

    const roundValue = (value, precision = 2) => {
      const factor = 10 ** precision;
      return Math.round(clampNonNegative(value) * factor) / factor;
    };

      const parseJsonSafe = (rawValue, fallback = []) => {
        if (!rawValue) return fallback;
        try {
          const parsed = JSON.parse(rawValue);
          return Array.isArray(parsed) ? parsed : fallback;
        } catch (_) {
          return fallback;
        }
      };

      const rowVariations = (editRow) => parseJsonSafe(editRow?.dataset?.variations, []);

      const variationRowsFromInput = (editRow) => {
        const hiddenInput = editRow?.querySelector('.row-variation-breakdown');
        return parseJsonSafe(hiddenInput?.value, []);
      };

      const normalizeVariationRows = (rows, options = {}) => {
        const keepZero = Boolean(options.keepZero);
        if (!Array.isArray(rows)) return [];
        return rows
          .map((entry) => {
            const variationId = entry?.variation_id || entry?.variationId || null;
            const description = String(entry?.description || '').trim();
            const quantity = clampNonNegative(entry?.quantity);
            return {
              variation_id: variationId,
              description,
              quantity
            };
          })
          .filter((entry) => keepZero ? true : entry.quantity > 0);
      };

      const variationCountValue = (rows, variations) => {
        if (rows.length > 0) return rows.length;
        if (variations.length === 1) return 1;
        return 0;
      };

      const formatVariationCountLabel = (rows, variations) => {
        const count = variationCountValue(rows, variations);
        return count === 1 ? '1 variación' : `${count} variaciones`;
      };

      const variationTooltipItems = (rows, variations) => {
        if (rows.length > 0) {
          return rows.map((row) => {
            const description = escapeHtml(row.description || 'Variación');
            const quantity = formatQty(row.quantity);
            return `<li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2"><span class="truncate">${description}</span><span class="font-semibold text-slate-600">${quantity}</span></li>`;
          }).join('');
        }

        if (variations.length === 1) {
          const onlyDescription = escapeHtml(variations[0].description || 'Unica');
          return `<li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2"><span class="truncate">${onlyDescription}</span><span class="font-semibold text-slate-600">Unica</span></li>`;
        }

        return '<li class="text-slate-500">Sin detalle</li>';
      };

      const setVariationRows = (editRow, rows, options = {}) => {
        const normalizedRows = normalizeVariationRows(rows, options);
        const hiddenInput = editRow?.querySelector('.row-variation-breakdown');
        if (hiddenInput) hiddenInput.value = JSON.stringify(normalizedRows);
        return normalizedRows;
      };

      const syncVariationSummary = (rowKey) => {
        const displayRow = tbody.querySelector(`.factura-row-display[data-row-key="${rowKey}"]`);
        const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
        if (!displayRow || !editRow) return;

        const summaryEl = displayRow.querySelector('.js-variations-summary');
        if (!summaryEl) return;
        const summaryCountEl = summaryEl.querySelector('.js-variations-summary-count');
        const tooltipListEl = summaryEl.querySelector('.js-variations-tooltip-list');

        const variations = rowVariations(editRow);
        const rows = normalizeVariationRows(variationRowsFromInput(editRow));
        if (summaryCountEl) summaryCountEl.textContent = formatVariationCountLabel(rows, variations);
        if (tooltipListEl) tooltipListEl.innerHTML = variationTooltipItems(rows, variations);
      };

      const buildVariationOption = (variation, selectedId) => {
        const selected = String(selectedId || '') === String(variation.id || '') ? 'selected' : '';
        return `<option value="${variation.id}" ${selected}>${escapeHtml(variation.description || 'Variación')}</option>`;
      };

      const availableVariationsForRow = (variations, rows, currentIndex) => {
        const usedByOthers = new Set(
          rows
            .filter((_, rowIndex) => rowIndex !== currentIndex)
            .map((row) => String(row.variation_id || ''))
            .filter((value) => value.length > 0)
        );

        const currentVariationId = String(rows[currentIndex]?.variation_id || '');
        return variations.filter((variation) => {
          const id = String(variation.id || '');
          if (!id) return false;
          if (id === currentVariationId) return true;
          return !usedByOthers.has(id);
        });
      };

      const renderVariationEditor = (editRow) => {
        if (!editRow) return;

        const editorEl = editRow.querySelector('.row-variation-editor');
        if (!editorEl) return;

        const variations = rowVariations(editRow);
        const quantityPacks = clampNonNegative(editRow.querySelector('.row-cantidad-packs')?.value);
        let rows = normalizeVariationRows(variationRowsFromInput(editRow), { keepZero: true });

        if (variations.length === 1) {
          const only = variations[0];
          const unicaQty = rows[0]?.quantity > 0 ? rows[0].quantity : quantityPacks;
          rows = setVariationRows(editRow, [{ variation_id: only.id, description: only.description, quantity: unicaQty }], { keepZero: true });
          editorEl.innerHTML = `
            <div class="flex items-center gap-2">
              <span class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700">${escapeHtml(only.description || 'Unica')}</span>
              <input type="number" step="0.01" min="0" class="row-variation-qty w-20 rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs" value="${formatDecimalInput(unicaQty, 2)}" data-variation-id="${only.id}" data-variation-description="${escapeHtml(only.description || 'Unica')}">
            </div>
          `;
          return;
        }

        if (rows.length === 0 && variations.length > 0) {
          rows = setVariationRows(editRow, [{ variation_id: variations[0].id, description: variations[0].description, quantity: quantityPacks }], { keepZero: true });
        }

        const rowHtml = rows.map((row, index) => {
          const optionsForRow = availableVariationsForRow(variations, rows, index);
          const optionsHtml = optionsForRow.map((variation) => buildVariationOption(variation, row.variation_id)).join('');
          return `
            <div class="grid grid-cols-[1fr_auto_auto] items-center gap-2" data-variation-row-index="${index}">
              <select class="row-variation-select rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs">
                ${optionsHtml}
              </select>
              <input type="number" step="0.01" min="0" class="row-variation-qty w-20 rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs" value="${formatDecimalInput(row.quantity, 2)}">
              <button type="button" class="row-variation-remove rounded-md px-2 py-1 text-xs font-semibold text-red-600 hover:bg-red-50" title="Eliminar variación">✕</button>
            </div>
          `;
        }).join('');

        const usedIds = new Set(rows.map((row) => String(row.variation_id || '')).filter((value) => value.length > 0));
        const availableToAdd = variations.filter((variation) => !usedIds.has(String(variation.id || '')));
        const canAddMore = availableToAdd.length > 0;
        editorEl.innerHTML = `
          <div class="max-h-36 space-y-1.5 overflow-y-auto pr-1">${rowHtml}</div>
          ${canAddMore ? '<button type="button" class="row-variation-add mt-1 rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-200">+ Variación</button>' : ''}
        `;
      };

      const commitVariationEditor = (editRow) => {
        if (!editRow) return;
        const variations = rowVariations(editRow);
        const editorEl = editRow.querySelector('.row-variation-editor');
        if (!editorEl) return;

        const rows = Array.from(editorEl.querySelectorAll('[data-variation-row-index], .row-variation-qty[data-variation-id]')).map((element) => {
          if (element.matches('.row-variation-qty[data-variation-id]')) {
            return {
              variation_id: element.getAttribute('data-variation-id'),
              description: element.getAttribute('data-variation-description') || (variations[0]?.description || 'Unica'),
              quantity: clampNonNegative(element.value)
            };
          }

          const selectEl = element.querySelector('.row-variation-select');
          const qtyEl = element.querySelector('.row-variation-qty');
          const selectedId = selectEl?.value;
          const selectedVariation = variations.find((variation) => String(variation.id) === String(selectedId));
          return {
            variation_id: selectedId,
            description: selectedVariation?.description || 'Variación',
            quantity: clampNonNegative(qtyEl?.value)
          };
        });

        setVariationRows(editRow, rows, { keepZero: true });
        const rowKey = editRow.dataset.rowKey;
        if (rowKey) syncVariationSummary(rowKey);
      };

      const rowVariationTotal = (editRow) => {
        const rows = normalizeVariationRows(variationRowsFromInput(editRow));
        return rows.reduce((sum, row) => sum + clampNonNegative(row.quantity), 0);
      };

      const validateVariationQuantityForRow = (editRow, { showAlert = true } = {}) => {
        if (!editRow) return true;

        const quantityPacks = clampNonNegative(editRow.querySelector('.row-cantidad-packs')?.value);
        const unitsPerPack = clampNonNegative(editRow.querySelector('.row-unidades')?.value);
        const expectedTotal = quantityPacks * unitsPerPack;
        const variationTotal = rowVariationTotal(editRow);
        const isValid = Math.abs(expectedTotal - variationTotal) < 0.0001;

        if (!isValid && showAlert && window.Swal) {
          const productName = editRow.querySelector('.row-product-name')?.textContent?.trim() || 'Producto';
          window.Swal.fire({
            icon: 'warning',
            title: 'Variaciones no cuadran',
            text: `${productName}: (${formatQty(quantityPacks)} packs × ${formatQty(unitsPerPack)} unid) = ${formatQty(expectedTotal)} y variaciones suma ${formatQty(variationTotal)}.`,
            confirmButtonText: 'Entendido',
            confirmButtonColor: '#0284c7',
            target: 'body',
            heightAuto: false
          });
        }

        return isValid;
      };

      const validateVariationQuantityForAllRows = () => {
        const rows = Array.from(tbody.querySelectorAll('.factura-row-edit')).filter((row) => {
          const destroyInput = row.querySelector('.factura-item-destroy');
          return !(destroyInput && destroyInput.value === '1');
        });

        for (const row of rows) {
          commitVariationEditor(row);
          if (!validateVariationQuantityForRow(row, { showAlert: true })) {
            const rowKey = row.dataset.rowKey;
            if (rowKey) setEditMode(rowKey, true);
            return false;
          }
        }

        return true;
      };

    const setExentoChipState = (chipEl, isActive) => {
      if (!chipEl) return;
      chipEl.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      chipEl.classList.remove('border-emerald-300', 'bg-emerald-50', 'text-emerald-700', 'border-slate-300', 'bg-white', 'text-slate-600', 'hover:bg-slate-50');
      if (isActive) {
        chipEl.classList.add('border-emerald-300', 'bg-emerald-50', 'text-emerald-700');
      } else {
        chipEl.classList.add('border-slate-300', 'bg-white', 'text-slate-600', 'hover:bg-slate-50');
      }

      const trackEl = chipEl.querySelector('.js-exento-track');
      const thumbEl = chipEl.querySelector('.js-exento-thumb');

      if (trackEl) {
        trackEl.classList.remove('bg-emerald-500', 'bg-slate-300');
        trackEl.classList.add(isActive ? 'bg-emerald-500' : 'bg-slate-300');
      }

      if (thumbEl) {
        thumbEl.classList.remove('translate-x-5', 'translate-x-0.5');
        thumbEl.classList.add(isActive ? 'translate-x-5' : 'translate-x-0.5');
      }
    };

    const syncEditExentoSwitch = (editRow) => {
      if (!editRow) return;
      const exentoInput = editRow.querySelector('.row-exento');
      const trackEl = editRow.querySelector('.js-edit-exento-track');
      const thumbEl = editRow.querySelector('.js-edit-exento-thumb');
      const isActive = Boolean(exentoInput?.checked);

      if (trackEl) {
        trackEl.classList.remove('bg-emerald-500', 'bg-slate-300');
        trackEl.classList.add(isActive ? 'bg-emerald-500' : 'bg-slate-300');
      }

      if (thumbEl) {
        thumbEl.classList.remove('translate-x-5', 'translate-x-0.5');
        thumbEl.classList.add(isActive ? 'translate-x-5' : 'translate-x-0.5');
      }
    };

    const rowCurrentValues = (editRow) => {
      const costoMayor = clampNonNegative(editRow.querySelector('.row-costo-mayor-native')?.value || editRow.querySelector('.row-costo-mayor')?.value);
      const unidXPack = clampNonNegative(editRow.querySelector('.row-unidades')?.value);
      const costoMenor = unidXPack > 0 ? (costoMayor / unidXPack) : 0;
      const tasa = currentRate();
      return {
        costoMayorUsd: roundValue(costoMayor, 2),
        costoMayorBs: roundValue(costoMayor * tasa, 2),
        unidXPack: roundValue(unidXPack, 4),
        costoMenorUsd: roundValue(costoMenor, 2),
        costoMenorBs: roundValue(costoMenor * tasa, 2)
      };
    };

    const rowReferenceValues = (editRow) => {
      const refCostoMayor = clampNonNegative(editRow.dataset.refCostoMayor || 0);
      const refUnidXPack = clampNonNegative(editRow.dataset.refUnidXPack || 0);
      const refCostoMenor = clampNonNegative(editRow.dataset.refCostoMenor || 0);
      const tasa = currentRate();
      return {
        costoMayorUsd: roundValue(refCostoMayor, 2),
        costoMayorBs: roundValue(refCostoMayor * tasa, 2),
        unidXPack: roundValue(refUnidXPack, 4),
        costoMenorUsd: roundValue(refCostoMenor, 2),
        costoMenorBs: roundValue(refCostoMenor * tasa, 2)
      };
    };

    const rowHasReference = (editRow) => {
      if (!editRow) return false;
      const refSupplierId = String(editRow.dataset.refSupplierId || '').trim();
      const currentSupplierId = String(supplierSelect?.value || '').trim();
      if (!refSupplierId || !currentSupplierId || refSupplierId !== currentSupplierId) return false;
      return String(editRow.dataset.hasReference || 'false') === 'true';
    };

    const rowHasSupplierDiff = (editRow) => {
      if (!rowHasReference(editRow)) return false;
      const currentValues = rowCurrentValues(editRow);
      const referenceValues = rowReferenceValues(editRow);

      return currentValues.costoMayorUsd !== referenceValues.costoMayorUsd ||
        currentValues.unidXPack !== referenceValues.unidXPack ||
        currentValues.costoMenorUsd !== referenceValues.costoMenorUsd;
    };

    const updateOverwriteButton = (rowKey) => {
      const displayRow = tbody.querySelector(`.factura-row-display[data-row-key="${rowKey}"]`);
      const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
      if (!displayRow || !editRow) return;

      const overwriteBtn = displayRow.querySelector('.overwrite-supplier-product-row');
      if (!overwriteBtn) return;

      if (displayRow.classList.contains('hidden')) {
        overwriteBtn.style.display = 'none';
        return;
      }

      if (rowHasSupplierDiff(editRow)) {
        overwriteBtn.style.display = 'inline-flex';
      } else {
        overwriteBtn.style.display = 'none';
      }
    };

    const updateAllOverwriteButtons = () => {
      tbody.querySelectorAll('.factura-row-edit').forEach((row) => {
        const rowKey = row.dataset.rowKey;
        if (rowKey) updateOverwriteButton(rowKey);
      });
    };

    const updateGrandTotals = () => {
      const subtotalUsdEl = form.querySelector('#factura-subtotal-usd');
      const subtotalBsEl = form.querySelector('#factura-subtotal-bs');
      const ivaUsdEl = form.querySelector('#factura-iva-usd');
      const ivaBsEl = form.querySelector('#factura-iva-bs');
      const exentoUsdEl = form.querySelector('#factura-exento-usd');
      const exentoBsEl = form.querySelector('#factura-exento-bs');
      const totalFinalUsdEl = form.querySelector('#factura-total-final-usd');
      const totalFinalBsEl = form.querySelector('#factura-total-final-bs');

      if (!subtotalUsdEl || !subtotalBsEl || !ivaUsdEl || !ivaBsEl || !exentoUsdEl || !exentoBsEl || !totalFinalUsdEl || !totalFinalBsEl) return;

      let subtotalUsd = 0;
      let subtotalBs = 0;
      let exentoUsd = 0;
      let exentoBs = 0;

      tbody.querySelectorAll('.factura-row-edit').forEach((row) => {
        const destroyInput = row.querySelector('.factura-item-destroy');
        if (destroyInput && destroyInput.value === '1') return;

        const totalRowUsd = parseNumber(row.querySelector('.row-total-usd')?.value);
        const totalRowBs = parseNumber(row.querySelector('.row-total-bs')?.value);
        const isExento = Boolean(row.querySelector('.row-exento')?.checked);

        if (isExento) {
          exentoUsd += totalRowUsd;
          exentoBs += totalRowBs;
        } else {
          subtotalUsd += totalRowUsd;
          subtotalBs += totalRowBs;
        }
      });

      const ivaUsd = subtotalUsd * 0.16;
      const ivaBs = subtotalBs * 0.16;
      const totalFinalBs = subtotalBs + ivaBs + exentoBs;
      const priority = currentSupplierPriority();
      const rate = currentRate();
      const subtotalUsdDisplay = priority === 'bs'
        ? (rate > 0 ? (subtotalBs / rate) : 0)
        : subtotalUsd;
      const ivaUsdDisplay = priority === 'bs'
        ? (rate > 0 ? (ivaBs / rate) : 0)
        : ivaUsd;
      const exentoUsdDisplay = priority === 'bs'
        ? (rate > 0 ? (exentoBs / rate) : 0)
        : exentoUsd;
      const totalFinalUsd = priority === 'bs'
        ? (rate > 0 ? (totalFinalBs / rate) : 0)
        : (subtotalUsd + ivaUsd + exentoUsd);

      subtotalUsdEl.textContent = formatMoney(subtotalUsdDisplay, '$');
      subtotalBsEl.textContent = formatMoney(subtotalBs, 'Bs');
      ivaUsdEl.textContent = formatMoney(ivaUsdDisplay, '$');
      ivaBsEl.textContent = formatMoney(ivaBs, 'Bs');
      exentoUsdEl.textContent = formatMoney(exentoUsdDisplay, '$');
      exentoBsEl.textContent = formatMoney(exentoBs, 'Bs');
      totalFinalUsdEl.textContent = formatMoney(totalFinalUsd, '$');
      totalFinalBsEl.textContent = formatMoney(totalFinalBs, 'Bs');
    };

    const recalcEditRow = (editRow, options = {}) => {
      if (!editRow) return;
      syncEditExentoSwitch(editRow);

      const source = options.source;
      const priority = currentSupplierPriority();
      const costoMayorInput = editRow.querySelector('.row-costo-mayor');
      const costoMayorNativeInput = editRow.querySelector('.row-costo-mayor-native');
      const costoMayorBsNativeInput = editRow.querySelector('.row-costo-mayor-bs-native');
      const cantidadPacksInput = editRow.querySelector('.row-cantidad-packs');
      const unidadesInput = editRow.querySelector('.row-unidades');
      const costoMenorInput = editRow.querySelector('.row-costo-menor');
      const costoMayorBsInput = editRow.querySelector('.row-costo-mayor-bs');
      const totalUsdInput = editRow.querySelector('.row-total-usd');
      const totalBsInput = editRow.querySelector('.row-total-bs');

      const tasa = currentRate();
      const costoMayorFromNative = clampNonNegative(costoMayorNativeInput?.value);
      const costoMayorBsFromNative = clampNonNegative(costoMayorBsNativeInput?.value);
      const costoMayorFromUsdInput = clampNonNegative(costoMayorInput?.value);
      const costoMayorBsFromInput = clampNonNegative(costoMayorBsInput?.value);

      let costoMayor = 0;
      let costoMayorBs = 0;

      if (source === 'bs') {
        costoMayorBs = costoMayorBsFromInput;
        costoMayor = tasa > 0 ? (costoMayorBs / tasa) : 0;
      } else if (source === 'usd') {
        costoMayor = costoMayorFromUsdInput;
        costoMayorBs = costoMayor * tasa;
      } else if (priority === 'bs') {
        costoMayorBs = costoMayorBsFromNative || costoMayorBsFromInput;
        costoMayor = tasa > 0 ? (costoMayorBs / tasa) : 0;
      } else {
        costoMayor = costoMayorFromNative || costoMayorFromUsdInput;
        costoMayorBs = costoMayor * tasa;
      }

      const cantidadPacks = parseNumber(cantidadPacksInput?.value);
      const unidades = parseNumber(unidadesInput?.value);

        const variations = rowVariations(editRow);
        if (variations.length === 1) {
          setVariationRows(editRow, [{ variation_id: variations[0].id, description: variations[0].description, quantity: cantidadPacks }]);
          renderVariationEditor(editRow);
          const rowKeyForVariation = editRow.dataset.rowKey;
          if (rowKeyForVariation) syncVariationSummary(rowKeyForVariation);
        }

      const costoMenor = unidades > 0 ? (costoMayor / unidades) : 0;
      const totalUsd = costoMayor * cantidadPacks;
      const totalBs = costoMayorBs * cantidadPacks;

      if (costoMayorNativeInput) costoMayorNativeInput.value = costoMayor.toFixed(8);
      if (costoMayorBsNativeInput) costoMayorBsNativeInput.value = costoMayorBs.toFixed(8);
      setMaskedMoney(costoMayorInput, costoMayor, '$');

      if (costoMenorInput) costoMenorInput.value = costoMenor.toFixed(2);
      if (source === 'bs') {
        if (costoMayorBsInput && String(costoMayorBsInput.value || '').trim() === '') {
          costoMayorBsInput.value = '';
        }
      } else {
        setMaskedMoney(costoMayorBsInput, costoMayorBs, 'Bs');
      }
      if (totalUsdInput) totalUsdInput.value = formatMoney(totalUsd, '$');
      if (totalBsInput) totalBsInput.value = formatMoney(totalBs, 'Bs');
    };

    const syncDisplayRow = (rowKey) => {
      const displayRow = tbody.querySelector(`.factura-row-display[data-row-key="${rowKey}"]`);
      const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
      if (!displayRow || !editRow) return;

      recalcEditRow(editRow);

      const productName = editRow.querySelector('.row-product-name')?.textContent?.trim() || '';
      const cantidadPacks = parseNumber(editRow.querySelector('.row-cantidad-packs')?.value);
      const costoMayor = parseNumber(editRow.querySelector('.row-costo-mayor-native')?.value || editRow.querySelector('.row-costo-mayor')?.value);
      const costoMayorBs = parseNumber(editRow.querySelector('.row-costo-mayor-bs-native')?.value || editRow.querySelector('.row-costo-mayor-bs')?.value);
      const unidades = parseNumber(editRow.querySelector('.row-unidades')?.value);
      const totalUsd = costoMayor * cantidadPacks;
      const totalBs = costoMayorBs * cantidadPacks;
      const exentoActivo = Boolean(editRow.querySelector('.row-exento')?.checked);

      const setText = (selector, value) => {
        const el = displayRow.querySelector(selector);
        if (el) el.textContent = value;
      };

      displayRow.dataset.exento = exentoActivo ? 'true' : 'false';
      setExentoChipState(displayRow.querySelector('.js-exento-mark'), exentoActivo);
      setText('.js-product-name', productName);
      setText('.js-cantidad-packs', formatQty(cantidadPacks));
      setText('.js-costo-mayor-usd', formatMoney(costoMayor, '$'));
      setText('.js-costo-mayor-bs', formatMoney(costoMayorBs, 'Bs'));
      setText('.js-unidades', formatQty(unidades));
      setText('.js-total-usd', formatMoney(totalUsd, '$'));
      setText('.js-total-bs', formatMoney(totalBs, 'Bs'));
        syncVariationSummary(rowKey);
      updateOverwriteButton(rowKey);
      updateGrandTotals();
    };

    const setEditMode = (rowKey, editing) => {
      const displayRow = tbody.querySelector(`.factura-row-display[data-row-key="${rowKey}"]`);
      const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
      if (!displayRow || !editRow) return;

      if (editing) {
        displayRow.classList.add('hidden');
        editRow.classList.remove('hidden');
        recalcEditRow(editRow);
        updateOverwriteButton(rowKey);
      } else {
        syncDisplayRow(rowKey);
        editRow.classList.add('hidden');
        displayRow.classList.remove('hidden');
        updateOverwriteButton(rowKey);
        updateGrandTotals();
      }
    };

    const deleteRow = (rowKey) => {
      const displayRow = tbody.querySelector(`.factura-row-display[data-row-key="${rowKey}"]`);
      const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
      if (!displayRow || !editRow) return;

      const isNewRecord = editRow.dataset.newRecord === 'true';
      if (isNewRecord) {
        displayRow.remove();
        editRow.remove();
        updateGrandTotals();
        return;
      }

      const destroyInput = editRow.querySelector('.factura-item-destroy');
      if (destroyInput) destroyInput.value = '1';
      displayRow.classList.add('hidden');
      editRow.classList.add('hidden');
      updateGrandTotals();
    };

    const overwriteSupplierProduct = async (rowKey) => {
      const displayRow = tbody.querySelector(`.factura-row-display[data-row-key="${rowKey}"]`);
      const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
      if (!displayRow || !editRow) return;

      if (!rowHasSupplierDiff(editRow)) {
        const overwriteBtn = displayRow.querySelector('.overwrite-supplier-product-row');
        if (overwriteBtn) overwriteBtn.style.display = 'none';
        updateOverwriteButton(rowKey);
        return;
      }

      const supplierId = String(supplierSelect?.value || '').trim();
      if (!supplierId) {
        showSupplierRequiredAlert();
        return;
      }

      const productoId = String(editRow.dataset.productId || editRow.querySelector('input[name*="[producto_id]"]')?.value || '').trim();
      if (!productoId) return;

      let confirmed = true;
      if (window.Swal) {
        const result = await window.Swal.fire({
          icon: 'question',
          title: '¿Sobrescribir datos del proveedor?',
          text: 'Se actualizará la asociación de este producto para el proveedor seleccionado.',
          showCancelButton: true,
          confirmButtonText: 'Sí, sobrescribir',
          cancelButtonText: 'Cancelar',
          confirmButtonColor: '#0284c7',
          cancelButtonColor: '#64748b',
          target: 'body',
          heightAuto: false
        });
        confirmed = Boolean(result.isConfirmed);
      }

      if (!confirmed) return;

      recalcEditRow(editRow);
      const costoMayor = clampNonNegative(editRow.querySelector('.row-costo-mayor-native')?.value);
      const unidXPack = clampNonNegative(editRow.querySelector('.row-unidades')?.value);
      const costoMenor = clampNonNegative(editRow.querySelector('.row-costo-menor')?.value);

      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

      try {
        const response = await fetch(`/suppliers/${encodeURIComponent(supplierId)}/overwrite_product_values`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {})
          },
          body: JSON.stringify({
            producto_id: productoId,
            costo_mayor: costoMayor,
            cantidad: unidXPack,
            costo_menor: costoMenor
          })
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || 'No se pudo sobrescribir la asociación del proveedor.');
        }

        editRow.dataset.refSupplierId = supplierId;
        editRow.dataset.hasReference = 'true';
        editRow.dataset.refCostoMayor = String(clampNonNegative(data.costo_mayor));
        editRow.dataset.refUnidXPack = String(clampNonNegative(data.cantidad));
        editRow.dataset.refCostoMenor = String(clampNonNegative(data.costo_menor));

        updateOverwriteButton(rowKey);

        if (window.Swal) {
          window.Swal.fire({
            icon: 'success',
            title: 'Actualizado',
            text: 'Se sobrescribieron los datos del producto en el proveedor.',
            confirmButtonText: 'Entendido',
            confirmButtonColor: '#0284c7',
            target: 'body',
            heightAuto: false
          });
        }
      } catch (error) {
        if (window.Swal) {
          window.Swal.fire({
            icon: 'error',
            title: 'No se pudo guardar',
            text: error.message || 'Error al sobrescribir los datos del proveedor.',
            confirmButtonText: 'Entendido',
            confirmButtonColor: '#0284c7',
            target: 'body',
            heightAuto: false
          });
        }
      }
    };

    const renderResults = (items) => {
      if (!resultsBox) return;
      if (!items.length) {
        resultsBox.innerHTML = '<div class="px-3 py-2 text-sm text-slate-500">Sin resultados</div>';
        resultsBox.classList.remove('hidden');
        return;
      }
      resultsBox.innerHTML = items.map((item) => (
              `<button type="button" class="select-product-result w-full text-left px-3 py-2 hover:bg-slate-50" data-product-id="${item.id}" data-product-name="${escapeHtml(item.descripcion)}" data-costo-mayor="${item.costo_mayor || ''}" data-costo-menor="${item.costo_menor || ''}" data-unid-x-pack="${item.unid_x_pack || ''}" data-variations="${encodeURIComponent(JSON.stringify(item.variations || []))}">
           <div class="text-sm font-medium text-slate-700">${escapeHtml(item.descripcion)}</div>
         </button>`
      )).join('');
      resultsBox.classList.remove('hidden');
    };

    const addItemRow = (productId, productName, defaults = {}) => {
      const container = form.querySelector('#factura-items');
      if (!container || !template) return;
      const currentIndex = Number(form.dataset.facturaIndex || Date.now());
      let html = template.innerHTML.replace(/NEW_RECORD/g, currentIndex);
      html = html.replace(/PRODUCT_ID/g, String(productId));
      html = html.replace(/PRODUCT_NAME/g, escapeHtml(productName));
      html = html.replace(/PRODUCT_VARIATIONS_JSON/g, escapeHtml(JSON.stringify(defaults.variations || [])));
      form.dataset.facturaIndex = String(currentIndex + 1);
      container.insertAdjacentHTML('beforeend', html);

      const rowKey = String(currentIndex);
      const displayRow = container.querySelector(`.factura-row-display[data-row-key="${rowKey}"]`);
      const editRow = container.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
      if (editRow) {
        const cantidadInput = editRow.querySelector('.row-cantidad-packs');
        const costoMayorNativeInput = editRow.querySelector('.row-costo-mayor-native');
        const costoMayorBsNativeInput = editRow.querySelector('.row-costo-mayor-bs-native');
        const costoMayorInput = editRow.querySelector('.row-costo-mayor');
        const unidadesInput = editRow.querySelector('.row-unidades');
        const exentoInput = editRow.querySelector('.row-exento');
          const variationBreakdownInput = editRow.querySelector('.row-variation-breakdown');

        const costoMayor = parseNumber(defaults.costo_mayor);
        const costoMenor = parseNumber(defaults.costo_menor);
        const unidXPack = parseNumber(defaults.unid_x_pack);
        const supplierId = String(supplierSelect?.value || '').trim();

        if (cantidadInput && !cantidadInput.value) cantidadInput.value = '';
        if (unidadesInput && !unidadesInput.value) unidadesInput.value = unidXPack > 0 ? formatDecimalInput(unidXPack, 2) : '';
        if (costoMayorNativeInput) costoMayorNativeInput.value = costoMayor.toFixed(8);
        if (costoMayorBsNativeInput) costoMayorBsNativeInput.value = (costoMayor * currentRate()).toFixed(8);
        if (exentoInput) {
          const hasProvidedExento = Object.prototype.hasOwnProperty.call(defaults, 'exento');
          const providedExentoValue = defaults.exento;
          const isExento = hasProvidedExento
            ? (String(providedExentoValue || '') === '1' || String(providedExentoValue || '') === 'true' || providedExentoValue === true)
            : currentSupplierDefaultExento();
          exentoInput.checked = isExento;
        }
        setMaskedMoney(costoMayorInput, costoMayor, '$');

        editRow.dataset.productId = String(productId || '');
          editRow.dataset.variations = JSON.stringify(defaults.variations || []);
        editRow.dataset.refSupplierId = supplierId;
        editRow.dataset.hasReference = supplierId ? 'true' : 'false';
        editRow.dataset.refCostoMayor = String(costoMayor || 0);
        editRow.dataset.refUnidXPack = String(unidXPack || 0);
        editRow.dataset.refCostoMenor = String(costoMenor || 0);

        if (displayRow) {
          displayRow.dataset.productId = String(productId || '');
        }

          if (variationBreakdownInput && (!variationBreakdownInput.value || variationBreakdownInput.value === '[]')) {
            variationBreakdownInput.value = '[]';
          }

        if (costoMenor > 0 && unidXPack > 0 && costoMayor <= 0) {
          const costoMayorFromMenor = costoMenor * unidXPack;
          if (costoMayorNativeInput) costoMayorNativeInput.value = costoMayorFromMenor.toFixed(8);
          if (costoMayorBsNativeInput) costoMayorBsNativeInput.value = (costoMayorFromMenor * currentRate()).toFixed(8);
          setMaskedMoney(costoMayorInput, costoMayorFromMenor, '$');
        }

        recalcEditRow(editRow, { source: 'supplier' });
          renderVariationEditor(editRow);
          commitVariationEditor(editRow);
      }
      setEditMode(rowKey, true);
    };


    let debounceTimer = null;
    updateSearchLockState();
    syncSupplierPriorityBadge();
    syncRawRateInput();

    if (supplierSelect) {
      supplierSelect.addEventListener('change', () => {
        updateSearchLockState();
        syncSupplierPriorityBadge();
        tbody.querySelectorAll('.factura-row-edit').forEach((row) => {
          recalcEditRow(row);
          const rowKey = row.dataset.rowKey;
          if (rowKey && row.classList.contains('hidden')) {
            syncDisplayRow(rowKey);
          }
        });
        updateAllOverwriteButtons();
        updateGrandTotals();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('click', (ev) => {
        if (hasSupplierSelected()) return;
        ev.preventDefault();
        showSupplierRequiredAlert();
      });

      searchInput.addEventListener('focus', (ev) => {
        if (hasSupplierSelected()) return;
        ev.preventDefault();
        searchInput.blur();
        showSupplierRequiredAlert();
      });

      searchInput.addEventListener('keydown', (ev) => {
        if (hasSupplierSelected()) return;
        ev.preventDefault();
        showSupplierRequiredAlert();
      });

      searchInput.addEventListener('input', () => {
        if (!hasSupplierSelected()) {
          searchInput.value = '';
          if (resultsBox) resultsBox.classList.add('hidden');
          return;
        }

        const value = searchInput.value.trim();
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          if (!value || value.length < 2) {
            if (resultsBox) resultsBox.classList.add('hidden');
            return;
          }
          const supplierId = supplierSelect ? supplierSelect.value : '';
          fetch(`/productos/search?q=${encodeURIComponent(value)}&supplier_id=${encodeURIComponent(supplierId)}`)
            .then((res) => res.json())
            .then((data) => renderResults(data))
            .catch(() => {
              if (resultsBox) {
                resultsBox.innerHTML = '<div class="px-3 py-2 text-sm text-slate-500">Error buscando productos</div>';
                resultsBox.classList.remove('hidden');
              }
            });
        }, 250);
      });
    }

    tbody.querySelectorAll('.factura-row-edit').forEach((row) => {
        renderVariationEditor(row);
        commitVariationEditor(row);
      recalcEditRow(row);
      const rowKey = row.dataset.rowKey;
      if (rowKey) setEditMode(rowKey, false);
    });
    updateAllOverwriteButtons();
    updateGrandTotals();

    form.addEventListener('input', (ev) => {
      const row = ev.target && ev.target.closest ? ev.target.closest('.factura-row-edit') : null;
      if (!row) return;
        if (ev.target.classList.contains('row-variation-qty') || ev.target.classList.contains('row-variation-select')) {
          commitVariationEditor(row);
          return;
        }
      const rowKey = row.dataset.rowKey;
      if (ev.target.classList.contains('row-costo-mayor-bs')) {
        recalcEditRow(row, { source: 'bs' });
        if (rowKey) updateOverwriteButton(rowKey);
        updateGrandTotals();
        return;
      }
      if (ev.target.classList.contains('row-costo-mayor')) {
        recalcEditRow(row, { source: 'usd' });
        if (rowKey) updateOverwriteButton(rowKey);
        updateGrandTotals();
        return;
      }
      recalcEditRow(row);
      if (rowKey) updateOverwriteButton(rowKey);
      updateGrandTotals();
    });

    form.addEventListener('blur', (ev) => {
      if (!ev.target || !ev.target.classList || !ev.target.classList.contains('row-costo-mayor-bs')) return;
      const row = ev.target.closest('.factura-row-edit');
      if (!row) return;
      recalcEditRow(row, { source: 'bs' });
      const rowKey = row.dataset.rowKey;
      if (rowKey && row.classList.contains('hidden')) {
        syncDisplayRow(rowKey);
      }
      updateGrandTotals();
    }, true);

    form.addEventListener('blur', (ev) => {
      if (!ev.target || !ev.target.classList) return;
      if (!ev.target.classList.contains('row-cantidad-packs') && !ev.target.classList.contains('row-unidades')) return;

      const rawValue = String(ev.target.value || '').trim();
      if (rawValue === '') return;

      ev.target.value = formatDecimalInput(rawValue, 2);

      const row = ev.target.closest('.factura-row-edit');
      if (!row) return;
      recalcEditRow(row);
      const rowKey = row.dataset.rowKey;
      if (rowKey && row.classList.contains('hidden')) {
        syncDisplayRow(rowKey);
      }
      updateGrandTotals();
    }, true);

      form.addEventListener('blur', (ev) => {
        if (!ev.target || !ev.target.classList || !ev.target.classList.contains('row-variation-qty')) return;
        const rawValue = String(ev.target.value || '').trim();
        if (rawValue !== '') {
          ev.target.value = formatDecimalInput(rawValue, 2);
        }
        const row = ev.target.closest('.factura-row-edit');
        if (!row) return;
        commitVariationEditor(row);
      }, true);

      form.addEventListener('submit', (ev) => {
      syncRawRateInput();
        tbody.querySelectorAll('.factura-row-edit').forEach((row) => {
          commitVariationEditor(row);
          recalcEditRow(row);
        });
        if (!validateVariationQuantityForAllRows()) {
          ev.preventDefault();
        }
    });

    if (tasaInput) {
      const onRateChange = () => {
        syncRawRateInput();
        tbody.querySelectorAll('.factura-row-edit').forEach((row) => {
          recalcEditRow(row, { source: 'rate' });
          const rowKey = row.dataset.rowKey;
          if (rowKey && row.classList.contains('hidden')) {
            syncDisplayRow(rowKey);
          }
          if (rowKey) updateOverwriteButton(rowKey);
        });
        updateGrandTotals();
      };

      tasaInput.addEventListener('input', onRateChange);
      tasaInput.addEventListener('change', onRateChange);
    }

    form.addEventListener('click', (ev) => {
      const resultBtn = ev.target && ev.target.closest ? ev.target.closest('.select-product-result') : null;
      if (resultBtn) {
        const productId = resultBtn.getAttribute('data-product-id');
        const productName = resultBtn.getAttribute('data-product-name');
          const variationsRaw = resultBtn.getAttribute('data-variations') || '';
          const variations = parseJsonSafe(decodeURIComponent(variationsRaw || '[]'), []);
        addItemRow(productId, productName, {
          costo_mayor: resultBtn.getAttribute('data-costo-mayor'),
          costo_menor: resultBtn.getAttribute('data-costo-menor'),
            unid_x_pack: resultBtn.getAttribute('data-unid-x-pack'),
            variations
        });
        if (searchInput) searchInput.value = '';
        if (resultsBox) resultsBox.classList.add('hidden');
        return;
      }

      const editBtn = ev.target && ev.target.closest ? ev.target.closest('.edit-factura-row') : null;
      if (editBtn) {
        const rowKey = editBtn.getAttribute('data-row-key');
        if (rowKey) setEditMode(rowKey, true);
        return;
      }

      const exentoBtn = ev.target && ev.target.closest ? ev.target.closest('.toggle-exento-row') : null;
      if (exentoBtn) {
        const rowKey = exentoBtn.getAttribute('data-row-key');
        if (!rowKey) return;
        const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
        const displayRow = tbody.querySelector(`.factura-row-display[data-row-key="${rowKey}"]`);
        if (!editRow || !displayRow || displayRow.classList.contains('hidden')) return;

        const exentoInput = editRow.querySelector('.row-exento');
        if (!exentoInput) return;

        exentoInput.checked = !exentoInput.checked;
        syncDisplayRow(rowKey);
        updateGrandTotals();
        return;
      }

        const variationAddBtn = ev.target && ev.target.closest ? ev.target.closest('.row-variation-add') : null;
        if (variationAddBtn) {
          const editRow = variationAddBtn.closest('.factura-row-edit');
          if (!editRow) return;
          const variations = rowVariations(editRow);
          const currentRows = normalizeVariationRows(variationRowsFromInput(editRow), { keepZero: true });
          if (variations.length === 0) return;
          const nextVariation = variations.find((variation) => !currentRows.some((row) => String(row.variation_id) === String(variation.id)));
          if (!nextVariation) return;
          currentRows.push({ variation_id: nextVariation.id, description: nextVariation.description, quantity: 0 });
          setVariationRows(editRow, currentRows, { keepZero: true });
          renderVariationEditor(editRow);
          commitVariationEditor(editRow);
          return;
        }

        const variationRemoveBtn = ev.target && ev.target.closest ? ev.target.closest('.row-variation-remove') : null;
        if (variationRemoveBtn) {
          const editRow = variationRemoveBtn.closest('.factura-row-edit');
          const variationRowEl = variationRemoveBtn.closest('[data-variation-row-index]');
          if (!editRow || !variationRowEl) return;
          const index = Number(variationRowEl.getAttribute('data-variation-row-index'));
          const rows = normalizeVariationRows(variationRowsFromInput(editRow), { keepZero: true }).filter((_, rowIndex) => rowIndex !== index);
          setVariationRows(editRow, rows, { keepZero: true });
          renderVariationEditor(editRow);
          commitVariationEditor(editRow);
          return;
        }

      const saveBtn = ev.target && ev.target.closest ? ev.target.closest('.save-factura-row') : null;
      if (saveBtn) {
        const rowKey = saveBtn.getAttribute('data-row-key');
          if (rowKey) {
            const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
            if (!editRow) return;
            commitVariationEditor(editRow);
            if (!validateVariationQuantityForRow(editRow, { showAlert: true })) return;
            setEditMode(rowKey, false);
          }
        return;
      }

      const overwriteBtn = ev.target && ev.target.closest ? ev.target.closest('.overwrite-supplier-product-row') : null;
      if (overwriteBtn) {
        const rowKey = overwriteBtn.getAttribute('data-row-key');
        if (rowKey) {
          updateOverwriteButton(rowKey);
          if (window.getComputedStyle(overwriteBtn).display === 'none') return;
          overwriteSupplierProduct(rowKey);
        }
        return;
      }

      const cancelBtn = ev.target && ev.target.closest ? ev.target.closest('.cancel-factura-row') : null;
      if (cancelBtn) {
        const rowKey = cancelBtn.getAttribute('data-row-key');
        if (!rowKey) return;
        const editRow = tbody.querySelector(`.factura-row-edit[data-row-key="${rowKey}"]`);
        if (editRow && editRow.dataset.newRecord === 'true') {
          deleteRow(rowKey);
        } else {
          setEditMode(rowKey, false);
        }
        return;
      }

      const deleteBtn = ev.target && ev.target.closest ? ev.target.closest('.delete-factura-row') : null;
      if (deleteBtn) {
        const rowKey = deleteBtn.getAttribute('data-row-key');
        if (rowKey) deleteRow(rowKey);
      }
    });

    document.addEventListener('click', (ev) => {
      if (!resultsBox || resultsBox.classList.contains('hidden')) return;
      if (resultsBox.contains(ev.target) || (searchInput && searchInput.contains(ev.target))) return;
      resultsBox.classList.add('hidden');
    });
  };

  document.addEventListener('turbo:load', () => {
    initFacturaForm(document);
  });

  document.addEventListener('turbo:frame-load', (e) => {
    initFacturaForm(e.target);
  });
</script>
