<% initial_inventory_mode = factura.initial_inventory? %>
<% intercompany_mode = !initial_inventory_mode && (factura.intercompany? || ActiveModel::Type::Boolean.new.cast(params.dig(:purchase_invoice, :intercompany)) || params[:mode].to_s == 'intercompany') %>
<%= form_with model: factura,
              scope: :purchase_invoice,
              local: true,
              html: {
                id: 'purchase_invoice_form',
                data: {
                  require_supplier_for_products: (!initial_inventory_mode && !intercompany_mode).to_s,
                  initial_inventory_mode: initial_inventory_mode.to_s,
                  intercompany_mode: intercompany_mode.to_s,
                  source_accounts_map: @source_accounts_map.to_json
                }
              } do |f| %>
  <%= hidden_field_tag :invoice_kind, factura.invoice_kind %>
  <% format_decimal_input = lambda do |value, scale = 2|
       next '' if value.nil?

       number = value.to_d.round(scale)
       string_value = number.to_s('F')
       if string_value.include?('.')
         integer_part, decimal_part = string_value.split('.', 2)
         decimal_trimmed = decimal_part.to_s.gsub(/0+\z/, '')
         decimal_trimmed.present? ? "#{integer_part}.#{decimal_trimmed}" : integer_part
       else
         string_value
       end
     end %>
  <% normalize_iso_date = lambda do |value|
       raw = value.to_s.strip
       if raw.blank?
         ''
       else
         begin
           if raw.match?(%r{\A\d{1,2}[/-]\d{1,2}[/-]\d{4}\z})
             Date.strptime(raw.tr('/', '-'), '%d-%m-%Y').iso8601
           elsif raw.match?(/\A\d{4}-\d{2}-\d{2}\z/)
             Date.iso8601(raw).iso8601
           else
             Date.parse(raw).iso8601
           end
         rescue ArgumentError
           ''
         end
       end
     end %>
  <% normalize_display_date = lambda do |value|
       iso_value = normalize_iso_date.call(value)
       if iso_value.present?
         begin
           Date.iso8601(iso_value).strftime('%d-%m-%Y')
         rescue ArgumentError
           ''
         end
       else
         ''
       end
     end %>
  <% pending_due_on_input_value = normalize_display_date.call(@pending_due_on_value) %>
  <% if factura.errors.any? %>
    <% balance_error_message = factura.errors.full_messages.find { |message| message.to_s.downcase.include?('saldo insuficiente') } %>
    <% if balance_error_message.present? %>
      <div
        class="hidden"
        data-balance-insufficient-alert="true"
        data-balance-insufficient-message="<%= balance_error_message %>"
      ></div>
    <% end %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-bold">No se pudo guardar la factura</h4>
        <span class="text-xs font-medium"><%= pluralize(factura.errors.count, 'error') %></span>
      </div>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% factura.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
    <div>
      <% if initial_inventory_mode %>
        <%= f.hidden_field :supplier_id, value: nil %>
        <%= f.hidden_field :intercompany, value: false %>
        <p class="block text-sm font-medium text-slate-700">Proveedor</p>
        <div class="mt-1 rounded-xl border border-cyan-200 bg-cyan-50 px-3 py-2 text-sm text-cyan-800">
          Inventario inicial no requiere proveedor.
        </div>
      <% else %>
        <%= f.hidden_field :intercompany, value: intercompany_mode ? 1 : 0, id: 'purchase_invoice_intercompany' %>
        <% if intercompany_mode %>
          <div class="rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-2 text-xs font-semibold text-indigo-700">
            Modo activo: Factura inter-empresas
          </div>
        <% end %>
        <div id="supplier-mode-fields" class="<%= intercompany_mode ? 'hidden' : '' %>">
          <%= f.label :supplier_id, 'Proveedor', class: 'mt-2 block text-sm font-medium text-slate-700' %>
          <% supplier_options = @available_suppliers.map { |supplier| [supplier.nombre, supplier.id, { 'data-pricing-currency-priority' => (supplier.pricing_currency_priority.presence || 'usd'), 'data-default-exento' => (supplier.default_exento? ? 'true' : 'false') }] } %>
          <%= f.select :supplier_id,
                      options_for_select(supplier_options, f.object.supplier_id),
                      { prompt: 'Seleccionar proveedor' },
                      class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 shadow-sm focus:ring-sky-500 focus:border-sky-500' %>
        </div>
        <div id="intercompany-mode-fields" class="<%= intercompany_mode ? '' : 'hidden' %>">
          <%= f.label :source_business_id, 'Negocio proveedor (origen)', class: 'mt-2 block text-sm font-medium text-slate-700' %>
          <%= f.select :source_business_id,
                      options_for_select(@available_source_businesses.map { |business| [business.name, business.id] }, factura.source_business_id),
                      { prompt: 'Seleccionar negocio origen' },
                      id: 'purchase_invoice_source_business_id',
                      class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 shadow-sm focus:ring-sky-500 focus:border-sky-500' %>
        </div>
      <% end %>
      <% initial_priority = intercompany_mode ? 'usd' : (factura.supplier&.pricing_currency_priority.presence || 'usd') %>
      <p id="supplier-currency-priority-badge" class="mt-2 inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700">
        Base de cálculo: <span class="ml-1" id="supplier-currency-priority-value"><%= initial_priority == 'bs' ? 'Bs' : '$' %></span>
      </p>
    </div>
    <div>
      <%= f.label :fecha_emision, 'Fecha', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_field :fecha_emision,
                       value: f.object.fecha_emision&.strftime('%d-%m-%Y'),
                       autocomplete: 'off',
                       placeholder: 'dd-mm-aaaa',
                       class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 shadow-sm focus:ring-sky-500 focus:border-sky-500' %>
    </div>
    <div>
      <%= f.label :tasa_dolar, 'Tasa Dolar BCV', class: 'block text-sm font-medium text-slate-700' %>
      <% tasa_default = factura.tasa_dolar.presence || (@tasa_dolar_bcv.is_a?(Numeric) ? @tasa_dolar_bcv : nil) %>
      <% tasa_display = tasa_default.present? ? format_money(tasa_default, unit: 'Bs') : 'Bs 0,00' %>
      <%= f.hidden_field :tasa_dolar, id: 'purchase_invoice_tasa_dolar_raw', value: tasa_default %>
      <input id="purchase_invoice_tasa_dolar" type="text" value="<%= tasa_display %>" readonly class="mt-1 block w-full rounded-xl border border-slate-300 bg-slate-100 px-3 py-2 shadow-sm focus:ring-sky-500 focus:border-sky-500">
    </div>
    <div>
      <%= f.label :numero, 'Número', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_field :numero, class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 shadow-sm focus:ring-sky-500 focus:border-sky-500' %>
    </div>
  </div>
  <h3 class="mt-6 text-lg font-semibold text-slate-800">Productos</h3>
  <% supplier_priority_is_bs = (!initial_inventory_mode && !intercompany_mode) && factura.supplier&.pricing_currency_priority.to_s == 'bs' %>
  <% supplier_default_exento = factura.supplier&.default_exento? %>
  <% apply_supplier_iva_adjustment = supplier_priority_is_bs && !supplier_default_exento %>
  <% if initial_inventory_mode %>
    <p class="mt-1 text-xs font-semibold text-cyan-700">Modo inventario inicial: destaca la columna "Existencia inicial" para registrar unidades reales disponibles.</p>
  <% end %>
  <div class="mt-3 relative md:max-w-2xl">
    <label for="producto-search" class="block text-sm font-medium text-slate-700">Buscar producto</label>
    <div class="mt-1 relative">
      <input id="producto-search" type="text" autocomplete="off" placeholder="Buscar producto..." class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 pr-10 shadow-sm focus:border-sky-500 focus:ring-sky-500">
      <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400">
        <i data-lucide="search" class="h-4 w-4"></i>
      </span>
    </div>
    <div id="producto-results" class="absolute z-20 mt-2 w-full rounded-xl border border-slate-200 bg-white shadow-lg hidden">
      <div class="px-3 py-2 text-sm text-slate-500">Escribe para buscar</div>
    </div>
  </div>
  <div class="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full text-sm text-slate-700">
      <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
        <tr>
          <th class="px-4 py-3 text-left">Acciones</th>
          <th class="px-4 py-3 text-left">Producto</th>
          <% unless initial_inventory_mode || intercompany_mode %>
            <th class="px-4 py-3 text-left">E</th>
            <th class="px-4 py-3 text-center">Cantidad Packs</th>
          <% end %>
          <th class="px-4 py-3 text-right">Costo Mayor $</th>
          <th class="px-4 py-3 text-right">Costo Mayor Bs</th>
          <th class="px-4 py-3 text-center">Unid x Pack</th>
          <% if initial_inventory_mode %>
            <th class="px-4 py-3 text-right text-cyan-800 bg-cyan-50/80">Precio unit $</th>
            <th class="px-4 py-3 text-right text-cyan-800 bg-cyan-50/80">Precio unit Bs</th>
            <th class="px-4 py-3 text-center text-cyan-800 bg-cyan-50/80">Existencia inicial</th>
          <% end %>
          <th class="px-4 py-3 text-left">Variaciones</th>
          <th class="px-4 py-3 text-right">Total $</th>
          <th class="px-4 py-3 text-right">Total Bs</th>
        </tr>
      </thead>
      <tbody id="factura-items" class="divide-y divide-slate-100 bg-white">
        <%= f.fields_for :purchase_invoice_items do |fi| %>
          <% row_key = fi.object.id || "new_#{fi.object.object_id}" %>
          <% raw_product_name = fi.object.product_name.to_s.strip %>
          <% product_name = if raw_product_name.present?
                              producto_descripcion = fi.object.producto&.descripcion.to_s.strip
                              if producto_descripcion.present? && raw_product_name.casecmp(producto_descripcion).zero?
                                fi.object.producto&.display_name_with_presentation.presence || raw_product_name
                              else
                                raw_product_name
                              end
                            else
                              fi.object.producto&.display_name_with_presentation || fi.object.producto&.descripcion || 'Selecciona un producto'
                            end %>
          <% cantidad_packs = fi.object.cantidad.to_d %>
          <% costo_mayor = fi.object.costo_mayor.to_d %>
          <% unid_x_pack = fi.object.unid_x_pack.to_d %>
          <% costo_menor = unid_x_pack.positive? ? (costo_mayor / unid_x_pack) : fi.object.costo_menor.to_d %>
          <% tasa = (factura.tasa_dolar || 0).to_d %>
          <% costo_mayor_bs = fi.object.costo_mayor_bs.to_d.positive? ? fi.object.costo_mayor_bs.to_d : (costo_mayor * tasa) %>
          <% costo_menor_rounded = costo_menor.round(2) %>
          <% costo_menor_bs = initial_inventory_mode ? (costo_menor_rounded * tasa) : (unid_x_pack.positive? ? (costo_mayor_bs / unid_x_pack) : costo_mayor_bs) %>
          <% total_usd = initial_inventory_mode ? (costo_menor_rounded * cantidad_packs) : (costo_mayor * cantidad_packs) %>
          <% total_bs = initial_inventory_mode ? (costo_menor_bs * cantidad_packs) : (costo_mayor_bs * cantidad_packs) %>
          <% exento_activo = intercompany_mode ? true : fi.object.exento? %>
          <% product_variations = fi.object.producto&.product_variations&.order(:id)&.map { |variation| { id: variation.id, description: variation.description } } || [] %>
          <% variation_breakdown_rows = fi.object.variation_breakdown.is_a?(Array) ? fi.object.variation_breakdown : [] %>
          <% single_variation = product_variations.one? ? product_variations.first : nil %>
          <% single_variation_quantity = initial_inventory_mode ? cantidad_packs : (cantidad_packs * (unid_x_pack.positive? ? unid_x_pack : 1)) %>
          <% effective_variation_rows = if variation_breakdown_rows.any?
              variation_breakdown_rows
            elsif single_variation.present?
              [{
                'variation_id' => single_variation[:id],
                'description' => single_variation[:description],
                'quantity' => single_variation_quantity.to_f
              }]
            else
              []
            end %>
          <% variation_count = effective_variation_rows.size %>
          <% product_variations_json = product_variations.to_json %>
          <% variation_breakdown_json = effective_variation_rows.to_json %>
          <% supplier_ref = if factura.supplier_id.present? && fi.object.producto_id.present?
              SupplierProduct.find_by(supplier_id: factura.supplier_id, producto_id: fi.object.producto_id)
            end %>
          <% ref_costo_mayor = supplier_ref&.costo_mayor&.to_s('F') || '' %>
          <% ref_unid_x_pack = supplier_ref&.cantidad&.to_s('F') || '' %>
          <% ref_costo_menor = supplier_ref&.costo_menor&.to_s('F') || '' %>
          <% has_supplier_ref = supplier_ref.present? %>
          <% overwrite_diff = false %>
          <% if has_supplier_ref %>
            <% apply_row_iva_adjustment = apply_supplier_iva_adjustment && !exento_activo %>
            <% comparable_costo_mayor = apply_row_iva_adjustment ? (costo_mayor.to_d * 1.16) : costo_mayor.to_d %>
            <% comparable_costo_menor = unid_x_pack.to_d.positive? ? (comparable_costo_mayor / unid_x_pack.to_d) : costo_menor.to_d %>
            <% overwrite_diff = comparable_costo_mayor.round(2) != supplier_ref.costo_mayor.to_d.round(2) ||
                                unid_x_pack.to_d.round(4) != supplier_ref.cantidad.to_d.round(4) ||
                                comparable_costo_menor.round(2) != supplier_ref.costo_menor.to_d.round(2) %>
          <% end %>
          <tr class="factura-row-display hover:bg-sky-50/60" data-row-key="<%= row_key %>" data-product-id="<%= fi.object.producto_id %>" data-exento="<%= exento_activo ? 'true' : 'false' %>">
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <button type="button" class="overwrite-supplier-product-row inline-flex items-center justify-center rounded-lg bg-sky-50 p-2 text-sky-600 hover:bg-sky-100 transition-colors" style="<%= overwrite_diff ? '' : 'display:none;' %>" data-row-key="<%= row_key %>" title="Sobrescribir en proveedor" aria-label="Sobrescribir en proveedor">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M5.25 3A2.25 2.25 0 0 0 3 5.25v13.5A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V8.56a2.25 2.25 0 0 0-.66-1.59l-2.31-2.31A2.25 2.25 0 0 0 16.44 4H5.25Zm6 2.25a.75.75 0 0 1 1.5 0V9a.75.75 0 0 1-1.5 0V5.25ZM6.75 14.25A2.25 2.25 0 0 1 9 12h6a2.25 2.25 0 0 1 2.25 2.25V18h-10.5v-3.75Z" />
                  </svg>
                </button>
                <button type="button" class="edit-factura-row inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors" data-row-key="<%= row_key %>" title="Editar" aria-label="Editar">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
                  </svg>
                </button>
                <button type="button" class="delete-factura-row inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 hover:bg-red-100 transition-colors" data-row-key="<%= row_key %>" title="Eliminar" aria-label="Eliminar">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M16.5 4.5V6h3a.75.75 0 0 1 0 1.5h-.638l-1.02 11.214A2.25 2.25 0 0 1 15.603 21H8.397a2.25 2.25 0 0 1-2.24-2.286L5.138 7.5H4.5a.75.75 0 0 1 0-1.5h3V4.5A1.5 1.5 0 0 1 9 3h6a1.5 1.5 0 0 1 1.5 1.5Zm-7.5 0V6h6V4.5h-6Z" clip-rule="evenodd" />
                  </svg>
                </button>
              </div>
            </td>
            <td class="px-4 py-3 font-semibold text-slate-800 js-product-name"><%= product_name %></td>
            <% unless initial_inventory_mode || intercompany_mode %>
              <td class="px-4 py-3">
                <button
                  type="button"
                  class="toggle-exento-row js-exento-mark inline-flex items-center gap-2 rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors <%= exento_activo ? 'border-emerald-300 bg-emerald-50 text-emerald-700' : 'border-slate-300 bg-white text-slate-600 hover:bg-slate-50' %>"
                  data-row-key="<%= row_key %>"
                  title="Marcar exento"
                  aria-label="Marcar exento"
                  aria-pressed="<%= exento_activo ? 'true' : 'false' %>">
                  <span class="text-[11px] font-bold">E</span>
                  <span class="js-exento-track relative inline-flex h-5 w-10 items-center rounded-full transition-colors <%= exento_activo ? 'bg-emerald-500' : 'bg-slate-300' %>">
                    <span class="js-exento-thumb inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform <%= exento_activo ? 'translate-x-5' : 'translate-x-0.5' %>"></span>
                  </span>
                </button>
              </td>
              <td class="px-4 py-3 text-center js-cantidad-packs"><%= format_quantity(cantidad_packs) %></td>
            <% end %>
            <td class="px-4 py-3 table-number js-costo-mayor-usd"><%= format_money(costo_mayor, unit: '$') %></td>
            <td class="px-4 py-3 table-number js-costo-mayor-bs"><%= format_money(costo_mayor_bs, unit: 'Bs') %></td>
            <td class="px-4 py-3 text-center js-unidades"><%= format_quantity(unid_x_pack) %></td>
            <% if initial_inventory_mode %>
              <td class="px-4 py-3 table-number js-costo-unit-usd font-semibold text-cyan-800 bg-cyan-50/40"><%= format_money(costo_menor_rounded, unit: '$') %></td>
              <td class="px-4 py-3 table-number js-costo-unit-bs font-semibold text-cyan-800 bg-cyan-50/40"><%= format_money(costo_menor_bs, unit: 'Bs') %></td>
              <td class="px-4 py-3 text-center js-cantidad-packs font-semibold text-cyan-800 bg-cyan-50/40"><%= format_quantity(cantidad_packs) %></td>
            <% end %>
            <td class="px-4 py-3">
              <div class="js-variations-summary group relative max-w-[16rem]">
                <div class="js-variations-summary-text inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs text-slate-700">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 text-slate-500">
                    <path d="M12 5c-5.523 0-9.5 4.028-10.95 6.238a1.5 1.5 0 0 0 0 1.524C2.5 14.972 6.477 19 12 19s9.5-4.028 10.95-6.238a1.5 1.5 0 0 0 0-1.524C21.5 9.028 17.523 5 12 5Zm0 11a4.25 4.25 0 1 1 0-8.5 4.25 4.25 0 0 1 0 8.5Zm0-2.5a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5Z"/>
                  </svg>
                  <span class="js-variations-summary-count"><%= variation_count == 1 ? '1 variación' : "#{variation_count} variaciones" %></span>
                </div>
                <div class="pointer-events-none absolute left-0 top-full z-30 mt-1 w-max max-w-[18rem] translate-y-1 rounded-xl border border-slate-200 bg-white p-2 text-xs text-slate-700 opacity-0 shadow-lg transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">
                  <ul class="js-variations-tooltip-list space-y-1">
                    <% if effective_variation_rows.any? %>
                      <% effective_variation_rows.each do |entry| %>
                        <% description = (entry['description'] || entry[:description]).presence || 'Variación' %>
                        <% quantity = format_decimal_input.call(entry['quantity'] || entry[:quantity], 2) %>
                        <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">
                          <span class="truncate"><%= description %></span>
                          <span class="font-semibold text-slate-600"><%= quantity %></span>
                        </li>
                      <% end %>
                    <% else %>
                      <li class="text-slate-500">Sin detalle</li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 table-number js-total-usd"><%= format_money(total_usd, unit: '$') %></td>
            <td class="px-4 py-3 table-number js-total-bs"><%= format_money(total_bs, unit: 'Bs') %></td>
          </tr>
          <tr class="factura-row-edit hidden bg-slate-50/40" data-row-key="<%= row_key %>" data-new-record="<%= fi.object.persisted? ? 'false' : 'true' %>" data-product-id="<%= fi.object.producto_id %>" data-ref-supplier-id="<%= factura.supplier_id %>" data-has-reference="<%= supplier_ref.present? ? 'true' : 'false' %>" data-ref-costo-mayor="<%= ref_costo_mayor %>" data-ref-unid-x-pack="<%= ref_unid_x_pack %>" data-ref-costo-menor="<%= ref_costo_menor %>" data-variations="<%= ERB::Util.json_escape(product_variations_json) %>" data-single-variation-id="<%= single_variation&.[](:id) %>" data-single-variation-description="<%= single_variation&.[](:description) %>">
            <%= fi.hidden_field :_destroy, class: 'factura-item-destroy' %>
            <%= fi.hidden_field :producto_id %>
            <%= fi.hidden_field :product_name, value: product_name %>
            <%= fi.hidden_field :id if fi.object.persisted? %>
            <%= fi.hidden_field :variation_breakdown, value: variation_breakdown_json, class: 'row-variation-breakdown' %>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <button type="button" class="save-factura-row inline-flex items-center justify-center rounded-lg bg-emerald-50 p-2 text-emerald-600 hover:bg-emerald-100 transition-colors" data-row-key="<%= row_key %>" title="Guardar" aria-label="Guardar">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M5.25 3A2.25 2.25 0 0 0 3 5.25v13.5A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V8.56a2.25 2.25 0 0 0-.66-1.59l-2.31-2.31A2.25 2.25 0 0 0 16.44 4H5.25Zm6 2.25a.75.75 0 0 1 1.5 0V9a.75.75 0 0 1-1.5 0V5.25ZM6.75 14.25A2.25 2.25 0 0 1 9 12h6a2.25 2.25 0 0 1 2.25 2.25V18h-10.5v-3.75Z" />
                  </svg>
                </button>
                <button type="button" class="cancel-factura-row inline-flex items-center justify-center rounded-lg bg-slate-100 p-2 text-slate-600 hover:bg-slate-200 transition-colors" data-row-key="<%= row_key %>" title="Cancelar" aria-label="Cancelar">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </button>
                <button type="button" class="delete-factura-row inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 hover:bg-red-100 transition-colors" data-row-key="<%= row_key %>" title="Eliminar" aria-label="Eliminar">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M16.5 4.5V6h3a.75.75 0 0 1 0 1.5h-.638l-1.02 11.214A2.25 2.25 0 0 1 15.603 21H8.397a2.25 2.25 0 0 1-2.24-2.286L5.138 7.5H4.5a.75.75 0 0 1 0-1.5h3V4.5A1.5 1.5 0 0 1 9 3h6a1.5 1.5 0 0 1 1.5 1.5Zm-7.5 0V6h6V4.5h-6Z" clip-rule="evenodd" />
                  </svg>
                </button>
              </div>
            </td>
            <td class="px-4 py-3 font-semibold text-slate-800 row-product-name"><%= product_name %></td>
            <% unless initial_inventory_mode || intercompany_mode %>
              <td class="px-4 py-3">
                <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-slate-700">
                  <%= fi.check_box :exento, class: 'row-exento peer sr-only' %>
                  <span class="text-[11px] font-bold">E</span>
                  <span class="js-edit-exento-track relative inline-flex h-5 w-10 items-center rounded-full bg-slate-300 transition-colors peer-checked:bg-emerald-500">
                    <span class="js-edit-exento-thumb inline-block h-4 w-4 translate-x-0.5 transform rounded-full bg-white shadow transition-transform"></span>
                  </span>
                </label>
              </td>
              <td class="px-4 py-3"><%= fi.number_field :cantidad, step: 0.01, value: format_decimal_input.call(fi.object.cantidad, 2), class: 'row-cantidad-packs block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-center shadow-sm focus:border-sky-500 focus:ring-sky-500' %></td>
            <% else %>
              <%= fi.hidden_field :exento, value: 1, class: 'row-exento' %>
            <% end %>
            <td class="px-4 py-3">
              <%= fi.hidden_field :costo_mayor, class: 'row-costo-mayor-native' %>
              <%= fi.hidden_field :costo_mayor_bs, value: costo_mayor_bs.to_s('F'), class: 'row-costo-mayor-bs-native' %>
              <input type="text" class="row-costo-mayor block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-right shadow-sm focus:border-sky-500 focus:ring-sky-500" data-money-mask="true" data-money-symbol="$" value="<%= format_money(costo_mayor, unit: '$') %>">
            </td>
            <td class="px-4 py-3"><input type="text" class="row-costo-mayor-bs block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-right shadow-sm focus:border-sky-500 focus:ring-sky-500" data-money-mask="true" data-money-symbol="Bs" value="<%= format_money(costo_mayor_bs, unit: 'Bs') %>"></td>
            <td class="px-4 py-3"><%= fi.number_field :unid_x_pack, step: 0.01, value: format_decimal_input.call(fi.object.unid_x_pack, 2), class: 'row-unidades block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-center shadow-sm focus:border-sky-500 focus:ring-sky-500' %></td>
            <% if initial_inventory_mode %>
              <td class="px-4 py-3 bg-cyan-50/30"><input type="text" class="row-costo-unit-usd block w-full rounded-xl border border-cyan-300 bg-cyan-50/70 px-3 py-2 text-right font-semibold text-cyan-900 shadow-sm" readonly></td>
              <td class="px-4 py-3 bg-cyan-50/30"><input type="text" class="row-costo-unit-bs block w-full rounded-xl border border-cyan-300 bg-cyan-50/70 px-3 py-2 text-right font-semibold text-cyan-900 shadow-sm" readonly></td>
              <td class="px-4 py-3 bg-cyan-50/30"><%= fi.number_field :cantidad, step: 0.01, value: format_decimal_input.call(fi.object.cantidad, 2), class: 'row-cantidad-packs block w-full rounded-xl border border-cyan-300 bg-cyan-50/70 px-3 py-2 text-center font-semibold text-cyan-900 shadow-sm focus:border-cyan-500 focus:ring-cyan-500' %></td>
            <% end %>
            <td class="px-4 py-3">
              <div class="row-variation-editor max-w-[16rem] space-y-1.5"></div>
            </td>
            <%= fi.hidden_field :costo_menor, class: 'row-costo-menor' %>
            <td class="px-4 py-3"><input type="text" class="row-total-usd block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-right shadow-sm" readonly></td>
            <td class="px-4 py-3"><input type="text" class="row-total-bs block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-right shadow-sm" readonly></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-slate-50 border-t border-slate-200">
        <% totals_leading_colspan = initial_inventory_mode ? 8 : 7 %>
        <% unless initial_inventory_mode || intercompany_mode %>
          <tr>
            <td class="px-4 py-3" colspan="<%= totals_leading_colspan %>"></td>
            <td class="px-4 py-3 text-right font-bold text-slate-700">Subtotal</td>
            <td class="px-4 py-3 table-number font-extrabold text-slate-800" id="factura-subtotal-usd">$ 0,00</td>
            <td class="px-4 py-3 table-number font-extrabold text-slate-800" id="factura-subtotal-bs">Bs 0,00</td>
          </tr>
          <tr>
            <td class="px-4 py-3" colspan="<%= totals_leading_colspan %>"></td>
            <td class="px-4 py-3 text-right font-bold text-slate-700">IVA 16%</td>
            <td class="px-4 py-3 table-number font-extrabold text-slate-800" id="factura-iva-usd">$ 0,00</td>
            <td class="px-4 py-3 table-number font-extrabold text-slate-800" id="factura-iva-bs">Bs 0,00</td>
          </tr>
          <tr>
            <td class="px-4 py-3" colspan="<%= totals_leading_colspan %>"></td>
            <td class="px-4 py-3 text-right font-bold text-slate-700">Exento</td>
            <td class="px-4 py-3 table-number font-extrabold text-slate-800" id="factura-exento-usd">$ 0,00</td>
            <td class="px-4 py-3 table-number font-extrabold text-slate-800" id="factura-exento-bs">Bs 0,00</td>
          </tr>
        <% end %>
        <tr>
          <td class="px-4 py-3" colspan="<%= totals_leading_colspan %>"></td>
          <td class="px-4 py-3 text-right font-bold text-slate-700">Total</td>
          <td class="px-4 py-3 table-number font-extrabold text-slate-800" id="factura-total-final-usd">$ 0,00</td>
          <td class="px-4 py-3 table-number font-extrabold text-slate-800" id="factura-total-final-bs">Bs 0,00</td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% unless initial_inventory_mode %>
    <% if factura.new_record? %>
      <% payment_rows = Array(@invoice_payment_rows).presence || [{ account_id: '', amount: '' }] %>
      <% payment_account_options = Array(@bs_accounts).map do |account| %>
        <% ["#{account.name} (Saldo: #{format_money(account.balance, unit: 'Bs')})", account.id, { 'data-balance' => account.balance.to_d.to_s('F') }] %>
      <% end %>
      <% selected_source_business_id = factura.source_business_id.presence || params.dig(:purchase_invoice, :source_business_id).to_i %>
      <% selected_source_accounts = Array(@source_accounts_map[selected_source_business_id]) %>
      <% pending_checked = @pending_payment_checked == true %>
      <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" data-invoice-payments-block="true">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Pago de factura</p>
            <p class="mt-1 text-sm text-slate-500">Distribuye el pago entre cuentas en Bs o deja saldo pendiente por pagar.</p>
          </div>
          <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-700">
            <%= check_box_tag :mark_pending_payment,
                            '1',
                            pending_checked,
                            id: 'purchase_invoice_mark_pending',
                            class: 'h-4 w-4 rounded border-amber-300 text-amber-600 focus:ring-amber-500',
                            data: { invoice_pending_toggle: true } %>
            Pendiente por pagar
          </label>
        </div>
        <% if intercompany_mode %>
          <div class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-xs text-indigo-700">
            Define cada pago con dos cuentas: cuenta a debitar fondos (negocio destino) y cuenta a acreditar fondos (negocio origen). Puedes repartir abonos en una o varias cuentas de ambos negocios.
          </div>
        <% end %>
        <% if payment_account_options.empty? %>
          <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
            No hay cuentas activas en Bs. Crea o activa una cuenta en moneda VES para registrar pagos.
          </div>
        <% end %>
        <div class="mt-4 space-y-3" data-invoice-payments-container="true">
          <% payment_rows.each_with_index do |row, index| %>
            <% row_account_id = row[:account_id].presence || row['account_id'].presence %>
            <% row_source_account_id = row[:source_account_id].presence || row['source_account_id'].presence %>
            <% row_amount_value = row[:amount].presence || row['amount'].presence || 'Bs 0,00' %>
            <div class="grid gap-3 rounded-xl border border-slate-200 bg-slate-50/70 p-3 <%= intercompany_mode ? 'md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_220px_auto]' : 'md:grid-cols-[minmax(0,1fr)_220px_auto]' %> md:items-end"
               data-invoice-payment-row="true"
               data-invoice-payment-index="<%= index %>">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500"><%= intercompany_mode ? 'Cuenta a debitar fondos (destino)' : 'Cuenta en Bs' %></label>
                <%= select_tag "invoice_payments[#{index}][account_id]",
                             options_for_select(payment_account_options, row_account_id),
                             include_blank: 'Selecciona cuenta en Bs',
                             class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                             data: { invoice_payment_account: true } %>
              </div>
              <% if intercompany_mode %>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Cuenta a acreditar fondos (origen)</label>
                  <%= select_tag "invoice_payments[#{index}][source_account_id]",
                               options_for_select(selected_source_accounts.map { |account| ["#{account[:name]} (Saldo: #{format_money(account[:balance], unit: 'Bs')})", account[:id], { 'data-balance' => account[:balance].to_d.to_s('F') }] }, row_source_account_id),
                               include_blank: 'Selecciona cuenta en origen',
                               class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                               data: { invoice_payment_source_account: true } %>
                </div>
              <% end %>
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Monto pagado (Bs)</label>
                <%= text_field_tag "invoice_payments[#{index}][amount]",
                                 row_amount_value,
                                 inputmode: 'decimal',
                                 autocomplete: 'off',
                                 placeholder: 'Bs 0,00',
                                 class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                                 data: {
                                   money_mask: true,
                                   money_symbol: 'Bs',
                                   invoice_payment_amount: true
                                 } %>
              </div>
              <button type="button"
                    class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-100"
                    data-invoice-payment-remove="true">
                Quitar
              </button>
            </div>
          <% end %>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <button type="button"
                class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60"
                data-invoice-payment-add="true"
                <%= 'disabled' if payment_account_options.empty? %>>
          Agregar cuenta
        </button>
        <p class="text-xs text-slate-500">Puedes dividir el pago entre varias cuentas.</p>
      </div>

      <div class="mt-4 grid gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 md:grid-cols-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total factura Bs</p>
          <p class="mt-1 text-base font-extrabold text-slate-800" data-invoice-payment-total-invoice-bs="true">Bs 0,00</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total pagado Bs</p>
          <p class="mt-1 text-base font-extrabold text-emerald-700" data-invoice-payment-total-paid-bs="true">Bs 0,00</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Saldo pendiente Bs</p>
          <p class="mt-1 text-base font-extrabold text-amber-700" data-invoice-payment-pending-bs="true">Bs 0,00</p>
        </div>
      </div>

      <p class="mt-3 text-xs text-slate-500" data-invoice-payment-hint="true">
        Si queda saldo pendiente, marca la opción pendiente por pagar para generar la deuda con el proveedor.
      </p>

      <div class="mt-4 <%= pending_checked ? '' : 'hidden' %>" data-invoice-pending-due-wrapper="true">
            <label for="purchase_invoice_pending_due_on" class="block text-sm font-medium text-slate-700">Fecha de vencimiento del saldo pendiente</label>
            <%= text_field_tag :pending_due_on,
                   pending_due_on_input_value,
                   id: 'purchase_invoice_pending_due_on',
               autocomplete: 'off',
               placeholder: 'dd-mm-aaaa',
               class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
               data: { invoice_pending_due_on: true } %>
          </div>
          <template id="invoice-payment-row-template">
            <div class="grid gap-3 rounded-xl border border-slate-200 bg-slate-50/70 p-3 <%= intercompany_mode ? 'md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_220px_auto]' : 'md:grid-cols-[minmax(0,1fr)_220px_auto]' %> md:items-end"
             data-invoice-payment-row="true"
             data-invoice-payment-index="__INDEX__">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500"><%= intercompany_mode ? 'Cuenta a debitar fondos (destino)' : 'Cuenta en Bs' %></label>
                <%= select_tag 'invoice_payments[__INDEX__][account_id]',
                           options_for_select(payment_account_options),
                           include_blank: 'Selecciona cuenta en Bs',
                           class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                           data: { invoice_payment_account: true } %>
              </div>
              <% if intercompany_mode %>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Cuenta a acreditar fondos (origen)</label>
                  <%= select_tag 'invoice_payments[__INDEX__][source_account_id]',
                             options_for_select(selected_source_accounts.map { |account| ["#{account[:name]} (Saldo: #{format_money(account[:balance], unit: 'Bs')})", account[:id], { 'data-balance' => account[:balance].to_d.to_s('F') }] }),
                             include_blank: 'Selecciona cuenta en origen',
                             class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                             data: { invoice_payment_source_account: true } %>
                </div>
              <% end %>
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Monto pagado (Bs)</label>
                <%= text_field_tag 'invoice_payments[__INDEX__][amount]',
                               'Bs 0,00',
                               inputmode: 'decimal',
                               autocomplete: 'off',
                               placeholder: 'Bs 0,00',
                               class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                               data: {
                                 money_mask: true,
                                 money_symbol: 'Bs',
                                 invoice_payment_amount: true
                               } %>
              </div>
              <button type="button"
                  class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-100"
                  data-invoice-payment-remove="true">
                Quitar
              </button>
            </div>
          </template>
        </div>
      <% else %>
        <% pending_balance_bs = @invoice_pending_balance_bs.to_d %>
        <% total_paid_bs = @invoice_total_paid_bs.to_d %>
        <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Pago de factura</p>
              <p class="mt-1 text-sm text-slate-500">Aqui puedes ver lo que ya se registro al crear la factura y el saldo pendiente actual.</p>
            </div>
            <% if @invoice_pending_debt.present? %>
              <span class="inline-flex items-center rounded-xl border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-700">
                Pendiente por pagar
              </span>
            <% else %>
              <span class="inline-flex items-center rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700">
                Factura pagada
              </span>
            <% end %>
          </div>
          <div class="mt-4 grid gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 md:grid-cols-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total factura Bs</p>
              <p class="mt-1 text-base font-extrabold text-slate-800"><%= format_money(factura.total_bs, unit: 'Bs') %></p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total pagado actual Bs</p>
              <p class="mt-1 text-base font-extrabold text-emerald-700"><%= format_money(total_paid_bs, unit: 'Bs') %></p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Saldo pendiente actual Bs</p>
              <p class="mt-1 text-base font-extrabold text-amber-700"><%= format_money(pending_balance_bs, unit: 'Bs') %></p>
            </div>
          </div>
          <div class="mt-4">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-semibold text-slate-700">Pagos registrados en la factura</p>
              <p class="text-xs text-slate-500">Los pagos posteriores del saldo pendiente se registran desde la deuda asociada.</p>
            </div>
            <% if @invoice_payment_movements.present? %>
              <div class="mt-3 space-y-3">
                <% @invoice_payment_movements.each do |movement| %>
                  <div class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-slate-50/70 p-4 md:flex-row md:items-center md:justify-between">
                    <div>
                      <p class="text-sm font-semibold text-slate-800"><%= movement.account.name %></p>
                      <p class="mt-1 text-xs text-slate-500">
                        <%= l(movement.occurred_at.to_date, format: '%d/%m/%Y') %>
                        <% if movement.payment_method.present? %>
                          · <%= movement.payment_method_label %>
                        <% end %>
                      </p>
                    </div>
                    <p class="text-sm font-extrabold text-emerald-700"><%= format_money(movement.amount, unit: 'Bs') %></p>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-500">
                Esta factura no tiene pagos directos registrados en su creacion.
              </div>
            <% end %>
          </div>
          <% if @invoice_pending_debt.present? %>
            <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50/70 p-4">
              <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                  <p class="text-sm font-semibold text-amber-800">Deuda pendiente asociada</p>
                  <p class="mt-1 text-xs text-amber-700">
