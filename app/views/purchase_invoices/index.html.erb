<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Facturas de Compra</h1>
        <p class="mt-1 text-sm text-slate-500">Controla compras por proveedor, tasa y detalle de costos en un solo lugar.</p>
      </div>
      <%= link_to new_purchase_invoice_path, class: "w-full md:w-auto bg-slate-900 text-white px-6 py-3 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-slate-800 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M12 4.5a.75.75 0 0 1 .75.75v6h6a.75.75 0 0 1 0 1.5h-6v6a.75.75 0 0 1-1.5 0v-6h-6a.75.75 0 0 1 0-1.5h6v-6a.75.75 0 0 1 .75-.75Z" />
        </svg>
        Nueva factura
      <% end %>
    </div>
  </div>
  <% if @purchase_invoices.any? %>
    <div class="grid gap-3 md:hidden">
      <% @purchase_invoices.each do |f| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-all duration-200 hover:border-sky-200 hover:shadow-md hover:shadow-sky-100/50">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h3 class="truncate text-base font-bold text-slate-800">Factura #<%= f.id %></h3>
              <p class="mt-1 text-sm text-slate-600"><span class="font-semibold text-slate-700">Proveedor:</span> <%= f.supplier_display_name %></p>
            </div>
            <span class="inline-flex items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= format_money(f.monto_total, unit: "$") %></span>
          </div>
          <div class="mt-3 text-sm text-slate-600">
            <span class="font-semibold text-slate-700">Fecha:</span> <%= f.fecha_emision.present? ? f.fecha_emision.to_date.strftime('%d/%m/%Y') : '-' %>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <%= link_to purchase_invoice_path(f), class: 'inline-flex items-center justify-center rounded-lg bg-emerald-50 p-2 text-emerald-600 hover:bg-emerald-100 transition-colors', title: 'Ver', 'aria-label': 'Ver' do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path d="M12 4.5c-5 0-9.27 3.11-11 7.5 1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5Zm0 12a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
                <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
              </svg>
            <% end %>
            <%= link_to edit_purchase_invoice_path(f), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors', title: 'Editar', 'aria-label': 'Editar' do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
              </svg>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
    <div class="hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:block">
      <table class="min-w-full table-auto text-sm text-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-4 text-left font-bold">Factura</th>
            <th class="px-6 py-4 text-left font-bold">Proveedor</th>
            <th class="px-6 py-4 text-center font-bold">Monto total</th>
            <th class="px-6 py-4 text-left font-bold">Fecha emisión</th>
            <th class="px-6 py-4 text-right font-bold">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @purchase_invoices.each_with_index do |f, index| %>
            <tr class="transition-all duration-150 <%= index.even? ? 'bg-white' : 'bg-slate-50/50' %> hover:bg-sky-50/70">
              <td class="px-6 py-4 font-semibold text-slate-800">#<%= f.id %></td>
              <td class="px-6 py-4"><%= f.supplier_display_name %></td>
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <span class="inline-flex items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= format_money(f.monto_total, unit: "$") %></span>
              </td>
              <td class="px-6 py-4"><%= f.fecha_emision.present? ? f.fecha_emision.to_date.strftime('%d/%m/%Y') : '-' %></td>
              <td class="px-6 py-4">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to purchase_invoice_path(f), class: 'inline-flex items-center justify-center rounded-lg bg-emerald-50 p-2 text-emerald-600 hover:bg-emerald-100 transition-colors', title: 'Ver', 'aria-label': 'Ver' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                      <path d="M12 4.5c-5 0-9.27 3.11-11 7.5 1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5Zm0 12a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
                      <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                    </svg>
                  <% end %>
                  <%= link_to edit_purchase_invoice_path(f), class: 'inline-flex items-center justify-center rounded-lg bg-amber-50 p-2 text-amber-600 hover:bg-amber-100 transition-colors', title: 'Editar', 'aria-label': 'Editar' do %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                      <path d="M16.862 3.487a2.625 2.625 0 1 1 3.712 3.713L8.25 19.524l-4.5.75.75-4.5L16.862 3.487Z" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No hay facturas registradas</h3>
      <p class="mt-1 text-sm text-slate-500">Agrega una factura para comenzar a registrar tus compras.</p>
    </div>
  <% end %>
</div>
