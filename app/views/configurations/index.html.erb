<section class="space-y-6 fade-in" id="tab-configuracion">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Configuracion</h1>
        <p class="mt-1 text-sm text-slate-500">Centro para administrar reglas y parametros del sistema.</p>
      </div>
      <%= link_to ventas_path, class: 'inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50' do %>
        Volver
      <% end %>
    </div>
  </div>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <%= link_to beer_ticket_setting_path,
                class: 'group block rounded-3xl border border-sky-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-sky-300 hover:shadow-lg' do %>
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-sky-500">Configuracion</p>
          <h2 class="mt-2 text-xl font-black tracking-tight text-slate-800">Tickets de Cervezas</h2>
          <p class="mt-2 text-sm text-slate-500">Activa y controla productos que requieren ticket de serie.</p>
        </div>
        <div class="rounded-2xl bg-sky-50 p-3 text-sky-600 transition-colors group-hover:bg-sky-100">
          <i data-lucide="ticket" class="h-6 w-6"></i>
        </div>
      </div>
      <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-sky-700">
        Administrar
        <i data-lucide="arrow-right" class="h-4 w-4"></i>
      </div>
    <% end %>
  </div>
</section>
