<%= form_with model: @system_service, local: true, class: "space-y-5" do |form| %>
  <% if @system_service.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-bold">Revisa los campos</h4>
        <span class="text-xs font-medium"><%= pluralize(@system_service.errors.count, 'error') %></span>
      </div>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% @system_service.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, "Nombre del sistema", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500", placeholder: "Ingrese el nombre del sistema de servicios" %>
  </div>
  <div>
    <%= form.label :image, "Imagen", class: "block text-sm font-medium text-slate-700" %>
    <%= form.file_field :image, direct_upload: true, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
    <% if @system_service.image.attached? %>
      <div class="mt-3 flex items-center gap-3">
        <%= image_tag @system_service.image, class: "h-16 w-16 rounded-xl border border-slate-200 object-cover", alt: @system_service.name %>
        <span class="text-xs text-slate-500">Imagen actual</span>
      </div>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit(@system_service.persisted? ? "Actualizar sistema" : "Crear sistema", class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800") %>
    <%= link_to 'Cancelar', system_services_path, class: "inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50" %>
  </div>
<% end %>