<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Sistemas de servicios</h1>
        <p class="mt-1 text-sm text-slate-500">Administra nombres e imagenes para clasificar los servicios.</p>
      </div>
      <%= link_to new_system_service_path, class: "w-full md:w-auto bg-slate-900 text-white px-6 py-3 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-slate-800 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium", data: { turbo_frame: "_top" } do %>
        <i data-lucide="plus" class="h-5 w-5"></i>
        Nuevo sistema
      <% end %>
    </div>
  </div>
  <% if @system_services.any? %>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
      <% @system_services.each do |system_service| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
          <div class="aspect-[16/10] overflow-hidden rounded-xl bg-slate-100">
            <% if system_service.image.attached? %>
              <%= image_tag system_service.image, class: "h-full w-full object-cover", alt: system_service.name %>
            <% else %>
              <div class="flex h-full items-center justify-center text-slate-300">
                <i data-lucide="image-off" class="h-10 w-10"></i>
              </div>
            <% end %>
          </div>
          <div class="mt-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Sistema</p>
              <h3 class="mt-1 truncate text-base font-bold text-slate-800"><%= system_service.name %></h3>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to edit_system_service_path(system_service), class: "inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white p-2 text-slate-600 hover:border-slate-300 hover:text-slate-800", data: { turbo_frame: "_top" }, title: "Editar" do %>
                <i data-lucide="pencil" class="h-4 w-4"></i>
              <% end %>
              <%= link_to system_service_path(system_service), class: "inline-flex items-center justify-center rounded-lg border border-red-200 bg-red-50 p-2 text-red-600 hover:bg-red-100", data: { turbo_method: :delete, swal_delete: "system_service" }, title: "Eliminar" do %>
                <i data-lucide="trash" class="h-4 w-4"></i>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
        <i data-lucide="layers" class="h-6 w-6"></i>
      </div>
      <h3 class="text-base font-semibold text-slate-700">No hay sistemas registrados</h3>
      <p class="mt-1 text-sm text-slate-500">Crea un sistema para ordenar los servicios.</p>
    </div>
  <% end %>
</div>