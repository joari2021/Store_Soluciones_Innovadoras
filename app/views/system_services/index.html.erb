<h1>Listado de Sistemas de Servicios</h1>
<div class="mb-3">
  <%= link_to 'Nuevo Sistema de Servicios', new_system_service_path, class: "btn btn-primary" %>
</div>
<table class="tabla-ajustada">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @system_services.each do |system_service| %>
      <tr>
        <td><%= system_service.name %></td>
        <td>
          <%= link_to 'Editar', edit_system_service_path(system_service), class: "btn btn-warning btn-sm" %>
          <%= link_to 'Eliminar', system_service_path(system_service), method: :delete, data: { confirm: "¿Estás seguro de que deseas eliminar este sistema de servicios?" }, class: "btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>