<div class="space-y-6">
  <% can_manage_cash_shifts = can_manage_action?(:manage_cash_shifts) %>
  <% cash_shift_totals_by_id = @cash_shift_totals_by_id || {} %>
  <% selected_fecha_desde_value = @selected_fecha_desde_value.to_s %>
  <% selected_fecha_hasta_value = @selected_fecha_hasta_value.to_s %>
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Cierres de turno</h1>
        <p class="mt-1 text-sm text-slate-500">Controla aperturas, cierres y resumen de ventas por turno.</p>
      </div>
      <div>
        <% if @open_cash_shift.present? %>
          <%= link_to cash_shift_path(@open_cash_shift), class: 'inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-emerald-200 hover:bg-emerald-700' do %>
            <i data-lucide="clock-3" class="h-4 w-4"></i>
            Ver turno abierto
          <% end %>
        <% elsif can_manage_cash_shifts %>
          <button
            id="cash-shift-open-trigger"
            type="button"
            data-create-url="<%= cash_shifts_path %>"
            class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-slate-200 transition-colors hover:bg-slate-800"
          >
            <i data-lucide="play" class="h-4 w-4"></i>
            Abrir turno
          </button>
        <% else %>
          <span class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-600">
            Solo encargado/admin puede abrir turno
          </span>
        <% end %>
      </div>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <%= form_with url: cash_shifts_path, method: :get, local: true, class: 'grid gap-3 md:grid-cols-[minmax(0,12rem)_minmax(0,12rem)_auto] md:items-end' do %>
      <div>
        <label for="cash_shift_filter_from" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Desde</label>
        <%= text_field_tag :fecha_desde,
                           selected_fecha_desde_value,
                           id: 'cash_shift_filter_from',
                           autocomplete: 'off',
                           placeholder: 'dd-mm-aaaa',
                           class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      </div>
      <div>
        <label for="cash_shift_filter_to" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Hasta</label>
        <%= text_field_tag :fecha_hasta,
                           selected_fecha_hasta_value,
                           id: 'cash_shift_filter_to',
                           autocomplete: 'off',
                           placeholder: 'dd-mm-aaaa',
                           class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      </div>
      <div class="flex items-center justify-start gap-2 md:self-end">
        <button type="submit" class="inline-flex cursor-pointer items-center justify-center w-fit rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">
          Filtrar
        </button>
        <%= link_to cash_shifts_path, class: 'inline-flex cursor-pointer items-center justify-center w-fit rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
          Limpiar
        <% end %>
      </div>
    <% end %>
  </div>
  <% if @cash_shifts.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-sm text-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-4 py-3 text-left">Turno</th>
            <th class="px-4 py-3 text-left">Apertura</th>
            <th class="px-4 py-3 text-left">Cierre</th>
            <th class="px-4 py-3 text-right">Ventas USD</th>
            <th class="px-4 py-3 text-right">Ventas VES</th>
            <th class="px-4 py-3 text-center">Estado</th>
            <th class="px-4 py-3 text-right">Accion</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @cash_shifts.each do |shift| %>
            <% shift_totals = cash_shift_totals_by_id.fetch(shift.id, { usd_total: 0.to_d, ves_total: 0.to_d }) %>
            <tr>
              <td class="px-4 py-3 font-semibold text-slate-800">#<%= shift.id %></td>
              <td class="px-4 py-3">
                <p class="font-medium text-slate-700"><%= shift.opened_by&.display_name || 'Sin usuario' %></p>
                <p class="text-xs text-slate-500"><%= l(shift.opened_at, format: :short) rescue shift.opened_at.strftime('%d/%m/%Y %H:%M') %></p>
              </td>
              <td class="px-4 py-3">
                <% if shift.closed_at.present? %>
                  <p class="font-medium text-slate-700"><%= shift.closed_by&.display_name || 'Sin usuario' %></p>
                  <p class="text-xs text-slate-500"><%= l(shift.closed_at, format: :short) rescue shift.closed_at.strftime('%d/%m/%Y %H:%M') %></p>
                <% else %>
                  <p class="text-xs font-semibold text-amber-700">Pendiente</p>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right font-semibold text-slate-800"><%= number_to_currency(shift_totals[:usd_total], unit: '$ ') %></td>
              <td class="px-4 py-3 text-right font-semibold text-slate-800"><%= number_to_currency(shift_totals[:ves_total], unit: 'Bs ') %></td>
              <td class="px-4 py-3 text-center">
                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold <%= shift.open? ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-600' %>">
                  <%= shift.status_label %>
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to cash_shift_path(shift), class: 'inline-flex items-center justify-center rounded-lg bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-700 hover:bg-sky-100' do %>
                  Ver detalle
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <p class="text-base font-semibold text-slate-700">No hay turnos registrados.</p>
      <p class="mt-1 text-sm text-slate-500">Abre el primer turno para comenzar a facturar por jornada.</p>
    </div>
  <% end %>
</div>
<script>
  (() => {
    const initCashShiftOpenModal = () => {
      const trigger = document.getElementById('cash-shift-open-trigger');
      if (!trigger || trigger.dataset.boundOpenModal === 'true') return;

      trigger.dataset.boundOpenModal = 'true';

      const escapeHtml = (value) => String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

      const formatAmount = (value, symbol) => {
        const parsed = Number(value || 0);
        const amount = Number.isFinite(parsed)
          ? parsed.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
          : '0,00';
        return `${symbol || ''} ${amount}`.trim();
      };

      const formatDateLabel = (rawDate) => {
        const text = String(rawDate || '').trim();
        if (!text) return 'Sin fecha';

        const matchIso = text.match(/^(\d{4})-(\d{2})-(\d{2})/);
        if (matchIso) return `${matchIso[3]}-${matchIso[2]}-${matchIso[1]}`;

        const parsed = new Date(text);
        if (Number.isNaN(parsed.getTime())) return text;

        const day = String(parsed.getDate()).padStart(2, '0');
        const month = String(parsed.getMonth() + 1).padStart(2, '0');
        const year = String(parsed.getFullYear());
        return `${day}-${month}-${year}`;
      };

      const buildRatesHtml = (snapshot) => {
        const safeSnapshot = snapshot && typeof snapshot === 'object' ? snapshot : {};
        const bcvRates = Array.isArray(safeSnapshot.bcv_rates) ? safeSnapshot.bcv_rates : [];
        const otherRates = Array.isArray(safeSnapshot.other_rates) ? safeSnapshot.other_rates : [];

        const bcvSection = bcvRates.length > 0
          ? `
            <div class="mt-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-left">
              <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Tasas BCV activas</p>
              <ul class="mt-2 space-y-1 text-xs text-slate-700">
                ${bcvRates.map((rate) => {
                  const label = escapeHtml(rate.description || 'Tasa BCV');
                  const amount = escapeHtml(formatAmount(rate.value, rate.symbol || ''));
                  const referenceDate = escapeHtml(formatDateLabel(rate.fecha_referencia));
                  return `<li><strong>${label}:</strong> ${amount} <span class="text-slate-500">(ref. ${referenceDate})</span></li>`;
                }).join('')}
              </ul>
            </div>
          `
          : '';

        const otherSection = otherRates.length > 0
          ? `
            <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-3 text-left">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Otras tasas</p>
              <ul class="mt-2 max-h-44 space-y-1 overflow-y-auto pr-1 text-xs text-slate-700">
                ${otherRates.map((rate) => {
                  const label = escapeHtml(rate.description || 'Tasa');
                  const amount = escapeHtml(formatAmount(rate.value, rate.symbol || ''));
                  const updatedDate = escapeHtml(formatDateLabel(rate.updated_at));
                  return `<li><strong>${label}:</strong> ${amount} <span class="text-slate-500">(act. ${updatedDate})</span></li>`;
                }).join('')}
              </ul>
            </div>
          `
          : '';

        return `${bcvSection}${otherSection}`;
      };

      const extractShiftIdFromUrl = (url) => {
        const match = String(url || '').match(/\/cash_shifts\/(\d+)/);
        return match ? match[1] : '';
      };

      const promoteOpenShiftCTA = (shiftUrl, shiftIdValue = '') => {
        if (!trigger || !shiftUrl) return;

        const shiftId = String(shiftIdValue || extractShiftIdFromUrl(shiftUrl)).trim();
        const link = document.createElement('a');
        link.href = shiftUrl;
        link.className = 'inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-emerald-200 hover:bg-emerald-700';
        link.innerHTML = `<i data-lucide="clock-3" class="h-4 w-4"></i> ${shiftId ? `Ver turno #${escapeHtml(shiftId)}` : 'Ver turno abierto'}`;

        trigger.replaceWith(link);
        if (window.lucide?.createIcons) {
          window.lucide.createIcons();
        }
      };

      const openShift = async () => {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (!csrfToken) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Token CSRF no disponible',
              text: 'Recarga la pagina e intenta de nuevo.',
              heightAuto: false,
            });
          }
          return;
        }

        if (!window.Swal) {
          if (!window.confirm('Se actualizaran las tasas BCV y luego se abrira el turno. Deseas continuar?')) return;
        } else {
          window.Swal.fire({
            title: 'Actualizando tasas BCV',
            html: '<p class="text-sm text-slate-600">Espere un momento, se estan actualizando las tasas.</p>',
            allowOutsideClick: false,
            allowEscapeKey: false,
            showConfirmButton: false,
            heightAuto: false,
            didOpen: () => {
              window.Swal.showLoading();
            },
          });
        }

        try {
          const response = await fetch(trigger.dataset.createUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
              'X-CSRF-Token': csrfToken,
            },
            credentials: 'same-origin',
            body: JSON.stringify({}),
          });

          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.success) {
            const existingOpenShift = /ya existe un turno abierto/i.test(String(data.error || ''));
            const existingShiftUrl = String(data.cash_shift_url || '').trim();
            const existingShiftId = String(data.cash_shift_id || '').trim();

            if (existingOpenShift) {
              if (window.Swal) {
                const existingResult = await window.Swal.fire({
                  icon: 'info',
                  title: 'Ya hay un turno abierto',
                  text: 'Puedes seguir facturando o abrir el detalle del turno activo.',
                  confirmButtonText: 'Ver turno',
                  showCancelButton: true,
                  cancelButtonText: 'Cerrar',
                  heightAuto: false,
                });

                if (existingResult.isConfirmed && existingShiftUrl) {
                  window.location.href = existingShiftUrl;
                  return;
                }

                if (existingShiftUrl) {
                  promoteOpenShiftCTA(existingShiftUrl, existingShiftId);
                }
                return;
              }

              if (window.confirm('Ya hay un turno abierto. Deseas ver su detalle?')) {
                if (existingShiftUrl) {
                  window.location.href = existingShiftUrl;
                }
                return;
              }

              if (existingShiftUrl) {
                promoteOpenShiftCTA(existingShiftUrl, existingShiftId);
              }
              return;
            }

            throw new Error(String(data.error || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.'));
          }

          const scraperStatus = String(data.scraper_status || '').trim();
          const resultText = scraperStatus === 'up_to_date'
            ? 'Las tasas ya estan actualizadas y el turno se abrio correctamente.'
            : 'Las tasas han sido actualizadas y el turno se abrio correctamente.';
          const ratesHtml = buildRatesHtml(data.rates_snapshot);
          const cashShiftUrl = String(data.cash_shift_url || '').trim();
          const cashShiftId = String(data.cash_shift_id || '').trim();

          if (window.Swal) {
            const result = await window.Swal.fire({
              icon: 'success',
              title: 'Turno abierto',
              html: `<p class="text-sm text-slate-600">${escapeHtml(resultText)}</p>${ratesHtml}`,
              confirmButtonText: 'Ver turno',
              showCancelButton: true,
              cancelButtonText: 'Cerrar',
              heightAuto: false,
            });

            if (result.isConfirmed && cashShiftUrl) {
              window.location.href = cashShiftUrl;
              return;
            }

            if (cashShiftUrl) {
              promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
            }
            return;
          }

          if (window.confirm(`${resultText}\n\nDeseas ver el turno abierto ahora?`)) {
            if (cashShiftUrl) {
              window.location.href = cashShiftUrl;
            }
            return;
          }

          if (cashShiftUrl) {
            promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
          }
        } catch (error) {
          if (window.Swal) {
            await window.Swal.fire({
              icon: 'error',
              title: 'No se pudo abrir el turno',
              text: error.message || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.',
              heightAuto: false,
            });
          } else {
            window.alert(error.message || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.');
          }
        }
      };

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        openShift();
      });
    };

    document.addEventListener('turbo:load', initCashShiftOpenModal);
    document.addEventListener('DOMContentLoaded', initCashShiftOpenModal);
  })();
</script>
