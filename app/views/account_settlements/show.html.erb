<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Detalle de cierre</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl">Cierre #<%= @settlement.id %></h1>
        <p class="mt-1 text-sm text-slate-500"><%= @account.name %></p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to 'Volver a cierres procesados', account_account_settlements_path(@account), class: 'inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 cursor-pointer' %>
        <%= link_to 'Volver a cuenta', account_path(@account), class: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700 cursor-pointer' %>
      </div>
    </div>
  </div>
  <div class="grid gap-3 md:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total del cierre</p>
      <p class="mt-1 text-sm font-bold text-slate-800"><%= format_money(@settlement.total_amount, unit: @account.currency_symbol) %></p>
    </div>
    <div class="rounded-lg border border-emerald-100 bg-emerald-50 p-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Acreditado</p>
      <p class="mt-1 text-sm font-bold text-emerald-700"><%= format_money(@settlement.credited_amount || 0, unit: 'Bs') %></p>
    </div>
    <div class="rounded-lg border border-amber-100 bg-amber-50 p-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-amber-600">Comision</p>
      <p class="mt-1 text-sm font-bold text-amber-700"><%= format_money(@settlement.commission_amount || 0, unit: 'Bs') %></p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Fecha acreditacion</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= @settlement.settlement_date ? @settlement.settlement_date.strftime('%d/%m/%Y') : '-' %></p>
    </div>
  </div>
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4">
      <h2 class="text-lg font-semibold text-slate-800">Movimientos del cierre</h2>
      <p class="mt-1 text-sm text-slate-500">Movimientos vinculados a este cierre.</p>
    </div>
    <% if @settlement_movements.any? %>
      <ul class="divide-y divide-slate-100">
        <% @settlement_movements.each do |movement| %>
          <% signed_amount = movement.signed_amount %>
          <% amount_positive = signed_amount >= 0 %>
          <li class="px-5 py-4">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <% movement_source_link = account_movement_source_link_data(movement) %>
                <p class="text-sm font-semibold text-slate-800"><%= movement.movement_kind_label %></p>
                <p class="text-xs text-slate-500">
                  <%= l(movement.occurred_at.in_time_zone('Caracas'), format: :short) rescue movement.occurred_at.strftime('%d/%m/%Y %H:%M') %>
                </p>
                <% if movement.payment_method.present? %>
                  <p class="mt-1 text-xs text-slate-500">Metodo: <span class="font-semibold text-slate-700"><%= movement.payment_method_label %></span></p>
                <% end %>
                <p class="mt-1 text-sm text-slate-600"><%= account_movement_display_description(movement) %></p>
                <% if movement_source_link.present? %>
                  <p class="mt-2">
                    <%= link_to movement_source_link[:label], movement_source_link[:path], class: 'inline-flex cursor-pointer items-center rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 shadow-sm transition-colors hover:bg-sky-100 hover:text-sky-800' %>
                  </p>
                <% end %>
              </div>
              <div class="text-right">
                <span class="text-sm font-bold <%= amount_positive ? 'text-emerald-600' : 'text-red-600' %>">
                  <%= amount_positive ? '+' : '-' %><%= format_money(signed_amount.abs, unit: @account.currency_symbol) %>
                </span>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-5 py-8 text-center text-sm text-slate-500">
        No hay movimientos asociados a este cierre.
      </div>
    <% end %>
  </div>
</div>
