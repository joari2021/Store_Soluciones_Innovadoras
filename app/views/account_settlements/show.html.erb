<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400"><%= @settlement.processed? ? 'Detalle de cierre' : 'Cierre pendiente' %></p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl">Cierre #<%= @settlement.id %></h1>
        <p class="mt-1 text-sm text-slate-500"><%= @account.name %></p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to 'Volver a cierres procesados', account_account_settlements_path(@account), class: 'inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 cursor-pointer' if @settlement.processed? %>
        <%= link_to 'Volver a cuenta', account_path(@account), class: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700 cursor-pointer' %>
      </div>
    </div>
  </div>
  <div class="grid gap-3 md:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total del cierre</p>
      <p class="mt-1 text-sm font-bold text-slate-800"><%= format_money(@settlement.total_amount, unit: @account.currency_symbol) %></p>
    </div>
    <div class="rounded-lg border border-emerald-100 bg-emerald-50 p-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Acreditado</p>
      <p class="mt-1 text-sm font-bold text-emerald-700"><%= format_money(@settlement.credited_amount || 0, unit: 'Bs') %></p>
    </div>
    <div class="rounded-lg border border-amber-100 bg-amber-50 p-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-amber-600">Comision</p>
      <p class="mt-1 text-sm font-bold text-amber-700"><%= format_money(@settlement.commission_amount || 0, unit: 'Bs') %></p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= @settlement.processed? ? 'Fecha acreditacion' : 'Estado' %></p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= @settlement.processed? ? (@settlement.settlement_date ? @settlement.settlement_date.strftime('%d/%m/%Y') : '-') : 'Pendiente por procesar' %></p>
    </div>
  </div>
  <% unless @settlement.processed? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50/80 p-5 shadow-sm">
      <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-slate-800">Procesar cierre pendiente</h2>
          <p class="mt-1 text-sm text-slate-600">Indica cuanto se acredito realmente y cuanto cobro de comision la entidad.</p>
        </div>
        <div class="text-right">
          <span class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">Total: <%= format_money(@settlement.total_amount, unit: @account.currency_symbol) %></span>
          <% if @settlement_latest_movement_at.present? %>
            <p class="mt-1 text-xs font-semibold text-slate-600">
              Fecha base del cierre: <%= @settlement_latest_movement_at.strftime('%d/%m/%Y') %>
            </p>
          <% end %>
        </div>
      </div>
      <% if @account.settlement_account_required? && (@settlement.settlement_account || @account.settlement_account).blank? %>
        <p class="mt-3 rounded-xl border border-rose-200 bg-white px-3 py-2 text-sm font-semibold text-rose-700">Debes asignar una cuenta bancaria en Bs a esta cuenta antes de procesar el cierre.</p>
      <% end %>
      <%= form_with model: [@account, @settlement], method: :patch, local: true, class: 'mt-4 grid gap-3 md:grid-cols-3' do |f| %>
        <div>
          <%= f.label :credited_amount, 'Monto acreditado', class: 'block text-xs font-bold uppercase tracking-wider text-slate-500' %>
          <%= f.text_field :credited_amount,
                           value: format_money(@settlement.total_amount, unit: 'Bs'),
                           class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-right text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                           placeholder: 'Bs 0,00',
                           data: { money_mask: 'true', money_symbol: 'Bs' } %>
        </div>
        <div>
          <%= f.label :commission_amount, 'Comision cobrada', class: 'block text-xs font-bold uppercase tracking-wider text-slate-500' %>
          <%= f.text_field :commission_amount,
                           value: format_money(0, unit: 'Bs'),
                           class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-right text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                           placeholder: 'Bs 0,00',
                           data: { money_mask: 'true', money_symbol: 'Bs' } %>
        </div>
        <div>
          <%= f.label :settlement_date, 'Fecha de acreditacion', class: 'block text-xs font-bold uppercase tracking-wider text-slate-500' %>
          <%= f.text_field :settlement_date, value: @suggested_settlement_date.strftime('%d-%m-%Y'), class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500', autocomplete: 'off', placeholder: 'dd-mm-aaaa' %>
        </div>
        <div class="md:col-span-3 flex justify-end">
          <%= f.submit 'Procesar cierre', class: 'inline-flex cursor-pointer items-center justify-center rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700' %>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4">
      <h2 class="text-lg font-semibold text-slate-800">Movimientos del cierre</h2>
      <p class="mt-1 text-sm text-slate-500">Movimientos vinculados a este cierre.</p>
    </div>
    <% if @settlement_movements.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead>
            <tr>
              <th class="sticky top-0 z-10 bg-slate-50 px-5 py-3 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Tipo</th>
              <th class="sticky top-0 z-10 bg-slate-50 px-5 py-3 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Fecha</th>
              <th class="sticky top-0 z-10 bg-slate-50 px-5 py-3 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Metodo</th>
              <th class="sticky top-0 z-10 bg-slate-50 px-5 py-3 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Referencia</th>
              <th class="sticky top-0 z-10 bg-slate-50 px-5 py-3 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Descripcion</th>
              <th class="sticky top-0 z-10 bg-slate-50 px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-500">Monto</th>
              <th class="sticky top-0 z-10 bg-slate-50 px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-500">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% @settlement_movements.each do |movement| %>
              <% signed_amount = movement.signed_amount %>
              <% amount_positive = signed_amount >= 0 %>
              <% movement_source_link = account_movement_source_link_data(movement) %>
              <tr>
                <td class="px-5 py-3 text-sm font-semibold text-slate-800"><%= movement.movement_kind_label %></td>
                <td class="px-5 py-3 text-xs text-slate-500"><%= l(movement.occurred_at.in_time_zone('Caracas'), format: :short) rescue movement.occurred_at.strftime('%d/%m/%Y %H:%M') %></td>
                <td class="px-5 py-3 text-xs text-slate-600"><%= movement.payment_method.present? ? movement.payment_method_label : '-' %></td>
                <td class="px-5 py-3 text-xs text-slate-600"><%= account_movement_reference(movement).presence || '-' %></td>
                <td class="px-5 py-3 text-sm text-slate-600"><%= account_movement_display_description(movement) %></td>
                <td class="px-5 py-3 text-right text-sm font-bold <%= amount_positive ? 'text-emerald-600' : 'text-red-600' %>"><%= amount_positive ? '+' : '-' %><%= format_money(signed_amount.abs, unit: @account.currency_symbol) %></td>
                <td class="px-5 py-3 text-right">
                  <% if movement_source_link.present? %>
                    <%= link_to movement_source_link[:path],
                                class: 'js-icon-tooltip inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-sky-300 bg-sky-50 text-sky-700 shadow-sm transition-colors hover:bg-sky-100 hover:text-sky-800',
                                data: { tooltip: movement_source_link[:label] },
                                aria: { label: movement_source_link[:label] } do %>
                      <i data-lucide="eye" class="h-4 w-4"></i>
                    <% end %>
                  <% else %>
                    <span class="text-xs text-slate-400">-</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-5 py-8 text-center text-sm text-slate-500">
        No hay movimientos asociados a este cierre.
      </div>
    <% end %>
  </div>
</div>
