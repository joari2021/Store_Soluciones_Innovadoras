<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Cierres procesados</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl"><%= @account.name %></h1>
        <p class="mt-1 text-sm text-slate-500">Listado de cierres ya acreditados.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to 'Volver a cuenta', account_path(@account), class: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700 cursor-pointer' %>
      </div>
    </div>
  </div>
  <% if @processed_settlements.any? %>
    <div class="space-y-3">
      <% @processed_settlements.each do |settlement| %>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-sm font-semibold text-slate-800">Cierre #<%= settlement.id %></p>
              <p class="text-xs text-slate-500">
                <% if settlement.period_start_at && settlement.period_end_at %>
                  <%= l(settlement.period_start_at.in_time_zone('Caracas'), format: :short) rescue settlement.period_start_at.strftime('%d/%m/%Y %H:%M') %>
                  -
                  <%= l(settlement.period_end_at.in_time_zone('Caracas'), format: :short) rescue settlement.period_end_at.strftime('%d/%m/%Y %H:%M') %>
                <% else %>
                  Cerrado: <%= l(settlement.closed_at.in_time_zone('Caracas'), format: :short) rescue settlement.closed_at.strftime('%d/%m/%Y %H:%M') %>
                <% end %>
              </p>
            </div>
            <div class="text-right">
              <p class="text-xs text-slate-500">Total del cierre</p>
              <p class="text-sm font-bold text-slate-800"><%= format_money(settlement.total_amount, unit: @account.currency_symbol) %></p>
            </div>
          </div>
          <div class="mt-3 grid gap-3 md:grid-cols-4">
            <div class="rounded-lg border border-emerald-100 bg-emerald-50 p-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Acreditado</p>
              <p class="mt-1 text-sm font-bold text-emerald-700"><%= format_money(settlement.credited_amount || 0, unit: 'Bs') %></p>
            </div>
            <div class="rounded-lg border border-amber-100 bg-amber-50 p-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-amber-600">Comision</p>
              <p class="mt-1 text-sm font-bold text-amber-700"><%= format_money(settlement.commission_amount || 0, unit: 'Bs') %></p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Fecha acreditacion</p>
              <p class="mt-1 text-sm font-semibold text-slate-700">
                <%= settlement.settlement_date ? settlement.settlement_date.strftime('%d/%m/%Y') : '-' %>
              </p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Movimientos</p>
              <p class="mt-1 text-sm font-semibold text-slate-700"><%= settlement.movements_count || 0 %></p>
            </div>
          </div>
          <div class="mt-4 flex justify-end">
            <%= link_to 'Ver movimientos', account_account_settlement_path(@account, settlement),
                        class: 'inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 cursor-pointer' %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <h3 class="text-base font-semibold text-slate-700">No hay cierres procesados</h3>
      <p class="mt-1 text-sm text-slate-500">Cuando proceses cierres, apareceran aqui.</p>
    </div>
  <% end %>
</div>
