<h1>Listado de Gestores</h1>
<div class="mb-3">
  <%= link_to 'Nuevo Gestor', new_manager_path, class: "btn btn-primary" %>
</div>
<table class="tabla-ajustada">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @managers.each do |manager| %>
      <tr>
        <td><%= manager.name %></td>
        <td>
          <%= link_to 'Editar', edit_manager_path(manager), class: "btn btn-warning btn-sm" %>
          <%= link_to 'Eliminar', manager_path(manager), method: :delete, data: { confirm: "¿Estás seguro de que deseas eliminar este gestor?" }, class: "btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>