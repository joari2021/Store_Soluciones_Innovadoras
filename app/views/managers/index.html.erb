<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Gestores</h1>
        <p class="mt-1 text-sm text-slate-500">Gestiona el listado de gestores asociados a los servicios.</p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:flex-row sm:justify-end md:w-auto">
        <%= link_to services_path, class: "inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50 sm:w-auto", data: { turbo_frame: "_top" } do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Volver
        <% end %>
        <%= link_to new_manager_path, class: "inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-slate-900 px-6 py-3 font-medium text-white shadow-lg shadow-slate-200 transition-all hover:bg-slate-800 active:scale-95 sm:w-auto", data: { turbo_frame: "_top" } do %>
          <i data-lucide="plus" class="h-5 w-5"></i>
          Nuevo gestor
        <% end %>
      </div>
    </div>
  </div>
  <% if @managers.any? %>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      <% @managers.each do |manager| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-100 text-sm font-bold text-sky-700">
              <%= manager.name.to_s.first&.upcase || 'G' %>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Gestor</p>
              <h3 class="truncate text-base font-bold text-slate-800"><%= manager.name %></h3>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <%= link_to edit_manager_path(manager), class: "inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white p-2 text-slate-600 hover:border-slate-300 hover:text-slate-800", data: { turbo_frame: "_top" }, title: "Editar" do %>
              <i data-lucide="pencil" class="h-4 w-4"></i>
            <% end %>
            <%= link_to manager_path(manager), class: "inline-flex items-center justify-center rounded-lg border border-red-200 bg-red-50 p-2 text-red-600 hover:bg-red-100", data: { turbo_method: :delete, swal_delete: "manager" }, title: "Eliminar" do %>
              <i data-lucide="trash" class="h-4 w-4"></i>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
        <i data-lucide="users" class="h-6 w-6"></i>
      </div>
      <h3 class="text-base font-semibold text-slate-700">No hay gestores registrados</h3>
      <p class="mt-1 text-sm text-slate-500">Crea gestores para asignarlos a servicios.</p>
    </div>
  <% end %>
</div>