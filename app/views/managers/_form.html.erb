<%= form_with model: @manager, local: true, class: "space-y-5" do |form| %>
  <% if @manager.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-bold">Revisa los campos</h4>
        <span class="text-xs font-medium"><%= pluralize(@manager.errors.count, 'error') %></span>
      </div>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% @manager.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, "Nombre del gestor", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500", placeholder: "Ingrese el nombre del gestor" %>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit(@manager.persisted? ? "Actualizar gestor" : "Crear gestor", class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800") %>
    <%= link_to 'Cancelar', managers_path, class: "inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50" %>
  </div>
<% end %>