<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Borradores</h1>
    <p class="mt-1 text-sm text-slate-500">Listado de ventas eliminadas para auditoría (solo administradores).</p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <% if @venta_eliminadas.empty? %>
      <p class="text-sm text-slate-700">No se encontraron ventas eliminadas.</p>
    <% else %>
      <div class="divide-y">
        <% @venta_eliminadas.each do |record| %>
          <div class="py-3">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-semibold text-slate-800">Venta ID: <%= record.venta_id %> - Total: <%= format_money(record.total_usd, unit: '$') %> | Bs <%= format_money(record.total_bs, unit: 'Bs ') %></p>
                <p class="text-xs text-slate-500">Cliente ID: <%= record.cliente_id || 'N/A' %> · Facturo: <%= record.seller_user_id || 'N/A' %> · Cobro: <%= record.cashier_user_id || 'N/A' %></p>
                <p class="text-xs text-slate-500">Eliminada por: <%= record.deleted_by_user_id %> · Fecha: <%= record.deleted_at&.in_time_zone('America/Caracas')&.strftime('%d/%m/%Y %H:%M') %></p>
              </div>
              <div>
                <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-1 text-xs" data-toggle-details="<%= record.id %>">Detalles</button>
              </div>
            </div>
            <div id="venta-eliminada-<%= record.id %>" class="mt-3 hidden rounded bg-slate-50 p-3 text-sm text-slate-700">
              <pre class="whitespace-pre-wrap text-xs"><%= JSON.pretty_generate(record.payload || {}) rescue record.payload.to_s %></pre>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<script>
  document.addEventListener('turbo:load', function(){
    document.querySelectorAll('[data-toggle-details]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var id = btn.getAttribute('data-toggle-details');
        var el = document.getElementById('venta-eliminada-' + id);
        if(!el) return;
        el.classList.toggle('hidden');
      });
    });
  });
</script>
