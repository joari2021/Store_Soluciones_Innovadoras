<section class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Porcentajes de ganancia</h1>
        <p class="mt-1 text-sm text-slate-500">Define porcentajes fijos para reutilizarlos rapidamente en el formulario de productos.</p>
      </div>
      <%= link_to productos_path,
                  class: "inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50" do %>
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Volver a productos
      <% end %>
    </div>
  </div>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)]">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">Crear porcentaje fijo</h2>
      <div class="mt-4">
        <%= render "form", profit_margin_preset: @profit_margin_preset, submit_label: "Guardar porcentaje" %>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">Porcentajes registrados</h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= @profit_margin_presets.size %></span>
      </div>
      <% if @profit_margin_presets.any? %>
        <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
          <table class="min-w-full text-left text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-4 py-3">Porcentaje</th>
                <th class="px-4 py-3 text-right">Productos</th>
                <th class="px-4 py-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @profit_margin_presets.each do |preset| %>
                <tr class="hover:bg-slate-50/80">
                  <td class="px-4 py-3 font-semibold text-slate-800"><%= format_quantity(preset.percentage) %>%</td>
                  <td class="px-4 py-3 text-right">
                    <span class="inline-flex items-center rounded-full bg-cyan-100 px-2.5 py-1 text-xs font-bold text-cyan-700"><%= @product_counts_by_preset_id[preset.id].to_i %></span>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex justify-end gap-2">
                      <%= link_to edit_profit_margin_preset_path(preset), class: "inline-flex cursor-pointer items-center justify-center rounded-lg bg-sky-50 p-2 text-sky-600 transition-colors hover:bg-sky-100", title: "Editar", aria: { label: "Editar porcentaje" } do %>
                        <i data-lucide="pencil" class="h-4 w-4"></i>
                      <% end %>
                      <%= button_to profit_margin_preset_path(preset), method: :delete, class: "inline-flex cursor-pointer items-center justify-center rounded-lg bg-rose-50 p-2 text-rose-600 transition-colors hover:bg-rose-100", form: { data: { turbo_confirm: "Este porcentaje fijo sera eliminado. Continuar?" } }, title: "Eliminar", aria: { label: "Eliminar porcentaje" } do %>
                        <i data-lucide="trash-2" class="h-4 w-4"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center">
          <p class="text-sm text-slate-600">Aun no hay porcentajes fijos. Crea el primero para usarlo en productos.</p>
        </div>
      <% end %>
    </div>
  </div>
</section>
