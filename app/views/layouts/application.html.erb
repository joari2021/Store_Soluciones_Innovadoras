<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:page_title) ? yield(:page_title) : (current_business&.name.presence || 'Innova Business') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicons/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/favicons/favicon-32x32.png" sizes="32x32">
    <link rel="icon" type="image/png" href="/favicons/favicon-16x16.png" sizes="16x16">
    <link rel="apple-touch-icon" href="/favicons/apple-icon-180x180.png" sizes="180x180">
    <link rel="manifest" href="/favicons/manifest.json">
    <!--=============== REMIXICONS ===============-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
    <script src="https://unpkg.com/lucide@latest" defer></script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js" defer></script>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "delete_confirmation_dialog", defer: true %>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" defer></script>
  </head>
  <% active_theme_profile = current_business&.theme_profile || Business::DEFAULT_THEME_PROFILE %>
  <% catalogo_fullscreen_mode = content_for?(:catalogo_fullscreen) %>
  <body data-business-theme-profile="<%= active_theme_profile %>" style="<%= Business.theme_css_variables(active_theme_profile) %>" class="app-shell text-slate-600 h-screen overflow-hidden<%= catalogo_fullscreen_mode ? ' catalogo-fullscreen' : '' %>">
    <div class="flex h-full">
      <!-- Desktop Sidebar -->
      <%= render "shared/sidebar" unless catalogo_fullscreen_mode %>
      <!-- Main Content -->
      <main class="flex-1 flex flex-col h-full overflow-hidden relative w-full">
        <!-- Header Mobile/Desktop -->
        <%= render "shared/header" unless catalogo_fullscreen_mode %>
        <!-- Scrollable Area -->
        <div id="content-container" class="app-thin-scrollbar flex-1 overflow-y-auto <%= catalogo_fullscreen_mode ? 'p-0' : 'p-4 md:p-8 pb-20 md:pb-8' %>">
          <%= render "shared/flash_toasts" %>
          <%= yield %>
        </div>
      </main>
      <!-- Mobile Bottom Navigation -->
      <% unless catalogo_fullscreen_mode %>
        <nav class="md:hidden fixed bottom-0 w-full glass border-t border-sky-100 z-50 px-6 py-2 flex justify-between items-center pb-safe">
          <% if current_user_admin? %>
            <button onclick="switchTab('dashboard')" class="mobile-nav-btn mobile-nav-active flex flex-col items-center gap-1 text-slate-400 transition-colors">
              <i data-lucide="layout-grid" class="w-6 h-6"></i>
            </button>
          <% end %>
          <%= link_to ventas_path, onclick: "switchTab('ventas')", class: 'mobile-nav-btn flex flex-col items-center gap-1 text-slate-400 transition-colors' do %>
            <i data-lucide="shopping-cart" class="w-6 h-6"></i>
          <% end %>
          <div class="w-12 h-12 -mt-8 bg-sky-500 rounded-full flex items-center justify-center text-white shadow-lg shadow-sky-200 border-4 border-white cursor-pointer hover:scale-105 transition-transform" onclick="openModal('sidebarModal')">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </div>
          <button onclick="switchTab('productos')" class="mobile-nav-btn flex flex-col items-center gap-1 text-slate-400 transition-colors">
            <i data-lucide="package" class="w-6 h-6"></i>
          </button>
          <button onclick="switchTab('clientes')" class="mobile-nav-btn flex flex-col items-center gap-1 text-slate-400 transition-colors">
            <i data-lucide="users" class="w-6 h-6"></i>
          </button>
        </nav>
      <% end %>
    </div>
    <div id="turbo-preloader" class="turbo-preloader is-active" aria-hidden="true">
      <div class="atom-loader" aria-hidden="true">
        <div class="line line-1"></div>
        <div class="line line-2"></div>
        <div class="line line-3"></div>
      </div>
    </div>
    <div id="materialize-datepicker-portal" class="materialize-datepicker-scope"></div>
    <!-- Mobile Sidebar Modal -->
    <div id="sidebarModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
      <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full mx-4 max-h-[80vh] overflow-auto">
        <div class="p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-slate-800">Menú</h3>
            <button onclick="closeModal('sidebarModal')" class="text-slate-400 hover:text-slate-600">
              <i data-lucide="x" class="w-6 h-6"></i>
            </button>
          </div>
          <nav class="space-y-2">
            <% if current_user_admin? %>
              <%= link_to dashboard_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="line-chart" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Dashboard</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:ventas) %>
              <%= link_to ventas_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="shopping-cart" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Ventas</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:historial_ventas) %>
              <%= link_to historial_ventas_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="list" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Historial de Ventas</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:cash_shifts) %>
              <%= link_to cash_shifts_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="clock-3" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Cierres de Turno</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:productos) %>
              <%= link_to productos_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="package" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Productos</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:catalogo) %>
              <%= link_to catalogo_productos_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="book-open" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Catalogo</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:services) %>
              <%= link_to services_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="zap" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Servicios</span>
              <% end %>
            <% end %>
            <% if current_user_admin? %>
              <%= link_to discount_schedules_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="badge-percent" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Descuentos</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:deudas) %>
              <%= link_to debts_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="hand-coins" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Deudas</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:expenses) %>
              <%= link_to expenses_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="receipt" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Gastos</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:accounts) %>
              <%= link_to accounts_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="wallet" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Cuentas</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:purchase_invoices) %>
              <%= link_to purchase_invoices_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="file-text" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Facturas de Compra</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:suppliers) %>
              <%= link_to suppliers_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="truck" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Proveedores</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:clientes) %>
              <%= link_to clientes_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="users" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Clientes</span>
              <% end %>
            <% end %>
            <% if can_access_module?(:rates) %>
              <%= link_to tasa_cambios_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-sky-50 transition-colors", onclick: "closeModal('sidebarModal')" do %>
                <i data-lucide="arrow-left-right" class="w-5 h-5 text-slate-600"></i>
                <span class="text-slate-700">Tasas de Divisas</span>
              <% end %>
            <% end %>
            <%= link_to logout_path, data: { turbo_method: :delete, swal_delete: 'logout' }, class: "flex items-center gap-3 p-3 rounded-xl border border-rose-100 bg-rose-50 text-rose-700 hover:bg-rose-100 transition-colors", onclick: "closeModal('sidebarModal')" do %>
              <i data-lucide="log-out" class="w-5 h-5"></i>
              <span class="text-rose-700">Cerrar sesión</span>
            <% end %>
          </nav>
        </div>
      </div>
    </div>
    <script>
      if (!window.showTurboPreloader) {
        window.showTurboPreloader = (event) => {
          const preloader = document.getElementById('turbo-preloader');
          if (!preloader) return;
          const visitUrl = event?.detail?.url;
          if (visitUrl) {
            const target = new URL(visitUrl, window.location.origin);
            const currentPath = window.location.pathname;
            if (currentPath === target.pathname && currentPath.startsWith('/services')) return;
          }
          if (window.__turboPreloaderWatchdog) {
            window.clearTimeout(window.__turboPreloaderWatchdog);
            window.__turboPreloaderWatchdog = null;
          }
          preloader.classList.remove('is-hiding');
          preloader.classList.add('is-active');
          window.__turboPreloaderWatchdog = window.setTimeout(() => {
            const stuckPreloader = document.getElementById('turbo-preloader');
            if (!stuckPreloader) return;
            stuckPreloader.classList.remove('is-active');
            stuckPreloader.classList.remove('is-hiding');
          }, 12000);
        };
      }

      if (!window.hideTurboPreloader) {
        window.hideTurboPreloader = () => {
          const preloader = document.getElementById('turbo-preloader');
          if (!preloader) return;
          if (window.__turboPreloaderWatchdog) {
            window.clearTimeout(window.__turboPreloaderWatchdog);
            window.__turboPreloaderWatchdog = null;
          }
          if (!preloader.classList.contains('is-active') && !preloader.classList.contains('is-hiding')) return;
          preloader.classList.add('is-hiding');
          window.setTimeout(() => {
            preloader.classList.remove('is-active');
            preloader.classList.remove('is-hiding');
          }, 780);
        };
      }

      if (!window.__turboPreloaderBound) {
        window.__turboPreloaderBound = true;
        document.addEventListener('turbo:before-visit', window.showTurboPreloader);
        document.addEventListener('turbo:visit', window.showTurboPreloader);
        document.addEventListener('turbo:load', window.hideTurboPreloader);
        document.addEventListener('turbo:render', window.hideTurboPreloader);
        document.addEventListener('turbo:before-fetch-response', window.hideTurboPreloader);
        document.addEventListener('turbo:submit-end', window.hideTurboPreloader);
        document.addEventListener('turbo:frame-load', window.hideTurboPreloader);
        document.addEventListener('turbo:fetch-request-error', window.hideTurboPreloader);
        document.addEventListener('turbo:before-cache', window.hideTurboPreloader);
        document.addEventListener('DOMContentLoaded', window.hideTurboPreloader);
        window.addEventListener('pageshow', window.hideTurboPreloader);
        window.addEventListener('load', window.hideTurboPreloader);
      }

      if (!window.handleTurboBeforeRender) {
        window.handleTurboBeforeRender = (event) => {
          const newBody = event?.detail?.newBody;
          if (newBody && newBody.hasAttribute('data-turbo-preview')) return;
          window.hideTurboPreloader();
        };
        document.addEventListener('turbo:before-render', window.handleTurboBeforeRender);
      }

      if (!window.initializeLucideIcons) {
        window.initializeLucideIcons = function(attemptsRemaining = 20) {
          if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
            return;
          }

          if (attemptsRemaining <= 0) return;

          window.setTimeout(() => window.initializeLucideIcons(attemptsRemaining - 1), 150);
        };
      }

      if (!window.__lucideListenersBound) {
        window.__lucideListenersBound = true;
        document.addEventListener('DOMContentLoaded', window.initializeLucideIcons);
        document.addEventListener('turbo:load', window.initializeLucideIcons);
      }

      if (!window.applySidebarState) {
        window.applySidebarState = (collapsed) => {
          document.body.classList.toggle('sidebar-collapsed', collapsed);
          window.localStorage.setItem('sidebar-collapsed', collapsed ? '1' : '0');
        };
      }

      if (!window.applyTheme) {
        window.applyTheme = (theme) => {
          const normalized = theme === 'dark' ? 'dark' : 'light';
          document.body.dataset.theme = normalized;
          window.localStorage.setItem('theme-preference', normalized);

          const toggle = document.getElementById('theme-toggle');
          if (!toggle) return;
          const darkIcon = toggle.querySelector('[data-theme-icon="dark"]');
          const lightIcon = toggle.querySelector('[data-theme-icon="light"]');
          if (!darkIcon || !lightIcon) return;

          if (normalized === 'dark') {
            darkIcon.classList.add('hidden');
            lightIcon.classList.remove('hidden');
          } else {
            lightIcon.classList.add('hidden');
            darkIcon.classList.remove('hidden');
          }
        };
      }

      if (!window.bindUiToggles) {
        window.bindUiToggles = () => {
          const savedCollapsed = window.localStorage.getItem('sidebar-collapsed') === '1';
          window.applySidebarState(savedCollapsed);

          const savedTheme = window.localStorage.getItem('theme-preference');
          window.applyTheme(savedTheme || 'light');

          const sidebarToggle = document.getElementById('sidebar-toggle');
          if (sidebarToggle && !sidebarToggle.dataset.boundToggle) {
            sidebarToggle.dataset.boundToggle = 'true';
            sidebarToggle.addEventListener('click', () => {
              const collapsed = !document.body.classList.contains('sidebar-collapsed');
              window.applySidebarState(collapsed);
            });
          }

          const themeToggle = document.getElementById('theme-toggle');
          if (themeToggle && !themeToggle.dataset.boundToggle) {
            themeToggle.dataset.boundToggle = 'true';
            themeToggle.addEventListener('click', () => {
              const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
              window.applyTheme(next);
            });
          }

          document.querySelectorAll('aside .nav-btn[data-tooltip]').forEach((btn) => {
            const label = btn.dataset.tooltip || '';
            if (!btn.getAttribute('aria-label')) {
              btn.setAttribute('aria-label', label);
            }
          });
        };
      }

      window.bindUiToggles();
      document.addEventListener('turbo:load', window.bindUiToggles);

      if (!window.ensureSidebarTooltip) {
        window.ensureSidebarTooltip = () => {
          let tooltip = document.querySelector('.sidebar-tooltip');
          if (!tooltip) {
            tooltip = document.createElement('div');
            tooltip.className = 'sidebar-tooltip';
            document.body.appendChild(tooltip);
          }
          return tooltip;
        };
      }

      if (!window.showSidebarTooltip) {
        window.showSidebarTooltip = (event) => {
          const target = event.currentTarget;
          const isSidebarButton = Boolean(target?.closest('aside .nav-btn'));
          if (isSidebarButton && !document.body.classList.contains('sidebar-collapsed')) return;
          const label = target?.dataset?.tooltip || '';
          if (!label) return;
          const tooltip = window.ensureSidebarTooltip();
          tooltip.textContent = label;
          const rect = target.getBoundingClientRect();
          const top = rect.top + rect.height / 2;

          const spacing = 12;
          const viewportPadding = 8;
          const explicitSide = String(target?.dataset?.tooltipSide || '').toLowerCase();
          const preferredSide = explicitSide || (target?.classList?.contains('js-icon-tooltip') ? 'left' : 'right');
          const tooltipWidth = tooltip.offsetWidth || 0;

          let left = preferredSide === 'left'
            ? rect.left - tooltipWidth - spacing
            : rect.right + spacing;

          const minLeft = viewportPadding;
          const maxLeft = Math.max(viewportPadding, window.innerWidth - tooltipWidth - viewportPadding);

          if (left < minLeft) {
            left = rect.right + spacing;
          }

          if (left > maxLeft) {
            left = rect.left - tooltipWidth - spacing;
          }

          left = Math.min(Math.max(left, minLeft), maxLeft);

          tooltip.style.top = `${top}px`;
          tooltip.style.left = `${left}px`;
          tooltip.style.transform = 'translate3d(0, -50%, 0)';
          tooltip.classList.add('is-visible');
        };
      }

      if (!window.hideSidebarTooltip) {
        window.hideSidebarTooltip = () => {
          const tooltip = document.querySelector('.sidebar-tooltip');
          if (tooltip) tooltip.classList.remove('is-visible');
        };
      }

      if (!window.bindSidebarTooltips) {
        window.bindSidebarTooltips = () => {
          window.ensureSidebarTooltip();
          document.querySelectorAll('aside .nav-btn[data-tooltip], .js-icon-tooltip[data-tooltip]').forEach((btn) => {
            if (btn.dataset.tooltipBound) return;
            btn.dataset.tooltipBound = 'true';
            btn.addEventListener('mouseenter', window.showSidebarTooltip);
            btn.addEventListener('focus', window.showSidebarTooltip);
            btn.addEventListener('mouseleave', window.hideSidebarTooltip);
            btn.addEventListener('blur', window.hideSidebarTooltip);
          });
        };
      }

      window.bindSidebarTooltips();
      document.addEventListener('turbo:load', window.bindSidebarTooltips);

      if (!window.getTabIdFromPath) {
        window.getTabIdFromPath = function(path) {
          if (!path) return null;
          if (path.includes('/dashboard')) return 'dashboard';
          if (path.includes('/ventas/historial')) return 'historial_ventas';
          if (/\/ventas\/\d+(\/|$)/.test(path)) return 'historial_ventas';
          if (path.includes('/productos')) return 'productos';
          if (path.includes('/porcentajes-ganancia')) return 'productos';
          if (path.includes('/descuentos-programados')) return 'descuentos';
          if (path.includes('/facturas') || path.includes('/facturas-compra')) return 'facturas';
          if (path.includes('/suppliers')) return 'proveedores';
          if (path.includes('/cuentas')) return 'cuentas';
          if (path.includes('/tasa_cambios')) return 'tasas';
          if (path.includes('/cierres-turno')) return 'cash_shifts';
          if (path.includes('/negocios')) return 'businesses';
          if (path.includes('/ventas')) return 'ventas';
          if (path.includes('/clientes')) return 'clientes';
          if (path.includes('/services')) return 'servicios';
          if (path.includes('/expenses') || path.includes('/gastos')) return 'gastos';
          if (path.includes('/deudas')) return 'deudas';
          return null;
        };
      }

      if (!window.switchTab) {
        window.switchTab = function(tabId, options = {}) {
          const currentTabId = window.getTabIdFromPath(window.location.pathname);
          const isSameView = currentTabId === tabId;
          const shouldAnimate = options.animate !== false && !isSameView;
          const tabSections = Array.from(document.querySelectorAll('section[id^="tab-"]'));
          const activeSection = document.getElementById('tab-' + tabId);

          // Switch tab sections only when there is a real tab container on the page.
          if (activeSection && tabSections.length > 1) {
            tabSections.forEach(section => {
              if (section === activeSection) return;
              section.classList.add('hidden');
              if (shouldAnimate) {
                section.classList.remove('fade-in');
              }
            });

            const wasHidden = activeSection.classList.contains('hidden');
            activeSection.classList.remove('hidden');
            if (shouldAnimate && wasHidden) {
              // Trigger reflow for animation
              void activeSection.offsetWidth;
              activeSection.classList.add('fade-in');
            }
          } else if (activeSection) {
            // Single-section pages should never be hidden and shown again.
            activeSection.classList.remove('hidden');
          }

          // Update Desktop Sidebar based on link route instead of inline onclick.
          const desktopNavButtons = Array.from(document.querySelectorAll('aside .nav-btn'));
          desktopNavButtons.forEach(btn => btn.classList.remove('nav-item-active'));
          const desktopMatch = desktopNavButtons.find((link) => {
            const href = link.getAttribute('href');
            return href && window.getTabIdFromPath(href) === tabId;
          });
          if (desktopMatch) desktopMatch.classList.add('nav-item-active');

          // Update Mobile Nav
          document.querySelectorAll('.mobile-nav-btn').forEach(btn => btn.classList.remove('mobile-nav-active', 'text-sky-500'));
          document.querySelectorAll('.mobile-nav-btn').forEach(btn => btn.classList.add('text-slate-400'));

          const mobileEls = document.querySelectorAll(`nav.md\\:hidden [onclick*="${tabId}"]`);
          if (mobileEls.length > 0) {
            mobileEls[0].classList.add('mobile-nav-active', 'text-sky-500');
            mobileEls[0].classList.remove('text-slate-400');
          }

          window.__activeTabId = tabId;
        };
      }

      if (!window.setActiveFromPath) {
        window.setActiveFromPath = function() {
          const tabId = window.getTabIdFromPath(window.location.pathname);
          if (tabId) {
            window.switchTab(tabId, { animate: false });
          }
        };
      }

      if (!window.__navListenersBound) {
        window.__navListenersBound = true;
        document.addEventListener('turbo:load', window.setActiveFromPath);
      }

        function openModal(id) {
          const modal = document.getElementById(id);
          if (!modal) return; // evita errores si el modal aún no está en el DOM
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }

        function closeModal(id) {
          const modal = document.getElementById(id);
          if (!modal) return;
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
    </script>
  </body>
</html>
