<!DOCTYPE html>
<html>
  <head>
    <title>Soluciones Innovadoras</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!--=============== REMIXICONS ===============-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
    <script src="https://unpkg.com/lucide@latest" defer></script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js" defer></script>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "delete_confirmation_dialog", defer: true %>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" defer></script>
  </head>
  <% active_theme_profile = current_business&.theme_profile || Business::DEFAULT_THEME_PROFILE %>
  <body data-business-theme-profile="<%= active_theme_profile %>" style="<%= Business.theme_css_variables(active_theme_profile) %>" class="app-shell text-slate-600 h-screen overflow-hidden">
    <div class="flex h-full">
      <!-- Desktop Sidebar -->
      <%= render "shared/sidebar" %>
      <!-- Main Content -->
      <main class="flex-1 flex flex-col h-full overflow-hidden relative w-full">
        <!-- Header Mobile/Desktop -->
        <%= render "shared/header" %>
        <!-- Scrollable Area -->
        <div id="content-container" class="app-thin-scrollbar flex-1 overflow-y-auto p-4 md:p-8 pb-24 md:pb-8">
          <%= render "shared/flash_toasts" %>
          <%= yield %>
        </div>
      </main>
      <!-- Mobile Bottom Navigation -->
      <nav class="md:hidden fixed bottom-0 w-full glass border-t border-sky-100 z-50 px-6 py-3 flex justify-between items-center pb-safe">
        <button onclick="switchTab('dashboard')" class="mobile-nav-btn mobile-nav-active flex flex-col items-center gap-1 text-slate-400 transition-colors">
          <i data-lucide="layout-grid" class="w-6 h-6"></i>
        </button>
        <%= link_to ventas_path, onclick: "switchTab('ventas')", class: 'mobile-nav-btn flex flex-col items-center gap-1 text-slate-400 transition-colors' do %>
          <i data-lucide="shopping-cart" class="w-6 h-6"></i>
        <% end %>
        <div class="w-12 h-12 -mt-8 bg-sky-500 rounded-full flex items-center justify-center text-white shadow-lg shadow-sky-200 border-4 border-white cursor-pointer hover:scale-105 transition-transform" onclick="openModal('productModal')">
          <i data-lucide="plus" class="w-6 h-6"></i>
        </div>
        <button onclick="switchTab('productos')" class="mobile-nav-btn flex flex-col items-center gap-1 text-slate-400 transition-colors">
          <i data-lucide="package" class="w-6 h-6"></i>
        </button>
        <button onclick="switchTab('clientes')" class="mobile-nav-btn flex flex-col items-center gap-1 text-slate-400 transition-colors">
          <i data-lucide="users" class="w-6 h-6"></i>
        </button>
      </nav>
    </div>
    <div id="materialize-datepicker-portal" class="materialize-datepicker-scope"></div>
    <script>
      if (!window.initializeLucideIcons) {
        window.initializeLucideIcons = function(attemptsRemaining = 20) {
          if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
            return;
          }

          if (attemptsRemaining <= 0) return;

          window.setTimeout(() => window.initializeLucideIcons(attemptsRemaining - 1), 150);
        };
      }

      if (!window.__lucideListenersBound) {
        window.__lucideListenersBound = true;
        document.addEventListener('DOMContentLoaded', window.initializeLucideIcons);
        document.addEventListener('turbo:load', window.initializeLucideIcons);
      }

      if (!window.getTabIdFromPath) {
        window.getTabIdFromPath = function(path) {
          if (!path) return null;
          if (path.includes('/ventas/historial')) return 'historial_ventas';
          if (/\/ventas\/\d+(\/|$)/.test(path)) return 'historial_ventas';
          if (path.includes('/productos')) return 'productos';
          if (path.includes('/porcentajes-ganancia')) return 'productos';
          if (path.includes('/facturas') || path.includes('/facturas-compra')) return 'facturas';
          if (path.includes('/suppliers')) return 'proveedores';
          if (path.includes('/cuentas')) return 'cuentas';
          if (path.includes('/tasa_cambios')) return 'tasas';
          if (path.includes('/cierres-turno')) return 'cash_shifts';
          if (path.includes('/negocios')) return 'businesses';
          if (path.includes('/ventas')) return 'ventas';
          if (path.includes('/clientes')) return 'clientes';
          if (path.includes('/services')) return 'servicios';
          if (path.includes('/expenses') || path.includes('/gastos')) return 'gastos';
          if (path.includes('/deudas')) return 'deudas';
          return null;
        };
      }

      if (!window.switchTab) {
        window.switchTab = function(tabId, options = {}) {
          const currentTabId = window.getTabIdFromPath(window.location.pathname);
          const isSameView = currentTabId === tabId;
          const shouldAnimate = options.animate !== false && !isSameView;
          const tabSections = Array.from(document.querySelectorAll('section[id^="tab-"]'));
          const activeSection = document.getElementById('tab-' + tabId);

          // Switch tab sections only when there is a real tab container on the page.
          if (activeSection && tabSections.length > 1) {
            tabSections.forEach(section => {
              if (section === activeSection) return;
              section.classList.add('hidden');
              if (shouldAnimate) {
                section.classList.remove('fade-in');
              }
            });

            const wasHidden = activeSection.classList.contains('hidden');
            activeSection.classList.remove('hidden');
            if (shouldAnimate && wasHidden) {
              // Trigger reflow for animation
              void activeSection.offsetWidth;
              activeSection.classList.add('fade-in');
            }
          } else if (activeSection) {
            // Single-section pages should never be hidden and shown again.
            activeSection.classList.remove('hidden');
          }

          // Update Desktop Sidebar based on link route instead of inline onclick.
          const desktopNavButtons = Array.from(document.querySelectorAll('aside .nav-btn'));
          desktopNavButtons.forEach(btn => btn.classList.remove('nav-item-active'));
          const desktopMatch = desktopNavButtons.find((link) => {
            const href = link.getAttribute('href');
            return href && window.getTabIdFromPath(href) === tabId;
          });
          if (desktopMatch) desktopMatch.classList.add('nav-item-active');

          // Update Mobile Nav
          document.querySelectorAll('.mobile-nav-btn').forEach(btn => btn.classList.remove('mobile-nav-active', 'text-sky-500'));
          document.querySelectorAll('.mobile-nav-btn').forEach(btn => btn.classList.add('text-slate-400'));

          const mobileEls = document.querySelectorAll(`nav.md\\:hidden [onclick*="${tabId}"]`);
          if (mobileEls.length > 0) {
            mobileEls[0].classList.add('mobile-nav-active', 'text-sky-500');
            mobileEls[0].classList.remove('text-slate-400');
          }

          window.__activeTabId = tabId;
        };
      }

      if (!window.setActiveFromPath) {
        window.setActiveFromPath = function() {
          const tabId = window.getTabIdFromPath(window.location.pathname);
          if (tabId) {
            window.switchTab(tabId, { animate: false });
          }
        };
      }

      if (!window.__navListenersBound) {
        window.__navListenersBound = true;
        document.addEventListener('turbo:load', window.setActiveFromPath);
      }

        function openModal(id) {
          const modal = document.getElementById(id);
          if (!modal) return; // evita errores si el modal aún no está en el DOM
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }

        function closeModal(id) {
          const modal = document.getElementById(id);
          if (!modal) return;
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
    </script>
  </body>
</html>
