<%= form_with(model: global_category, local: true, class: "space-y-4") do |form| %>
  <% if global_category.errors.any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
      <p class="font-semibold">No se pudo guardar la categoria global:</p>
      <ul class="mt-1 list-disc pl-5">
        <% global_category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nombre", class: "text-xs font-bold uppercase tracking-wider text-slate-500" %>
    <%= form.text_field :name,
                        class: "mt-1 w-full rounded-xl border border-slate-300 bg-white p-3 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                        autocomplete: "off",
                        placeholder: "Ej: Snacks, Lacteos, Bebidas" %>
  </div>

  <div>
    <%= form.submit submit_label,
                    class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800" %>
  </div>
<% end %>
