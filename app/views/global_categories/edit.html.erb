<section class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Editar categoria global</h1>
        <p class="mt-1 text-sm text-slate-500">Al cambiar su nombre, se actualiza la categoria en productos globales asociados.</p>
      </div>
      <%= link_to global_categories_path,
                  class: "inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50" do %>
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Volver a categorias globales
      <% end %>
    </div>
  </div>
  <div class="max-w-xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <%= render "form", global_category: @global_category, submit_label: "Actualizar categoria" %>
  </div>
</section>
