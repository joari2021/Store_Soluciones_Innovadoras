<%= form_with(model: saime_user, local: true) do |f| %>
  <% if saime_user.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading">Por favor, corrige los siguientes errores:</h4>
      <ul>
        <% saime_user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= hidden_field_tag :filter, params[:filter] %>
  <div class="row">
    <div class="col-md-4 mb-3">
      <%= f.label :identification, "Cédula" %>
      <%= f.text_field :identification, class: "form-control", required: true %>
    </div>
    <div class="col-md-4 mb-3">
      <%= f.label :entry, "Entrada" %>
      <%= f.text_field :entry, class: "form-control", required: true %>
    </div>
    <div class="col-md-4 mb-3">
      <%= f.label :temporary_status, "Status Usuario" %>
      <%= f.select :temporary_status, 
          options_for_select([["Activo", "activo"], ["Error en clave", "error en clave"]], selected: saime_user.temporary_status), 
          {}, 
          class: "form-control" %>
    </div>
    <%if Current.user&.admin?%>
      <div class="col-md-4 mb-3">
        <%= f.label :confirmed_status, "Status Confirmado Usuario" %>
        <%= f.select :confirmed_status, 
          options_for_select([["Activo", "activo"], ["Bad Request", "bad request"]], selected: saime_user.confirmed_status), 
          {}, 
          class: "form-control" %>
      </div>
    <%end%>
    <% if @saime_user.persisted? %>
      <div class="col-md-4 mb-3">
        <%= f.label :appointment_registration, "Registro Terminado" %>
        <%= f.select :appointment_registration, 
          options_for_select([["SI", true], ["NO", false]], selected: saime_user.appointment_registration), 
          {}, 
          class: "form-control" %>
      </div>
    <%end%>
  </div>
  <h4>Citas</h4>
  <div id="appointments-container">
    <%= f.fields_for :appointments do |appointment_fields| %>
      <div class="appointment border p-3 mb-3 text-black">
        <div class="row">
          <div class="col-md-2">
            <%= appointment_fields.hidden_field :_destroy %>
            <%= appointment_fields.label :appointment_date, "Fecha de la Cita" %>
            <%= appointment_fields.date_field :appointment_date, 
                class: "form-control appointment-date", 
                min: Date.today.to_s, 
                max: (Date.today + 3.months).to_s, 
                required: true %>
          </div>
          <div class="col-md-3">
            <%= appointment_fields.label :appointment_type, "Tipo de Cita" %>
            <%= appointment_fields.select :appointment_type, 
                options_for_select([["Cédula", "cedula"], ["Civil", "civil"], ["Niño", "niño"]], appointment_fields.object.appointment_type || "cedula"), 
                {}, 
                class: "form-control appointment-type" %>
          </div>
          <% if @saime_user.persisted? %>
            <!-- Esto solo se mostrará en la vista edit -->
            <div class="col-md-3">
              <%= appointment_fields.label :status, "Status" %>
              <%= appointment_fields.select :status, 
                options_for_select([["Disponible", "disponible"], ["Apartada", "apartada"], ["Apartada y Pagada", "pagada"], ["No programable", "inprogramable"]], selected: appointment_fields.object.status), 
                {}, 
                class: "form-control select-status", 
                data: { action: "change->appointment#toggleClient" } %>
            </div>
            <!-- Contenedor para el campo Cliente -->
            <div class="col-md-3 cliente-field-container" style="<%= (appointment_fields.object.status == 'apartada' || appointment_fields.object.status == 'pagada') ? 'display:block;' : 'display:none;' %>">
              <%= appointment_fields.label :client, "Cliente" %>
              <%= appointment_fields.text_field :client, class: "form-control" %>
            </div>
          <% end %>
          <div class="col-md-1"><button type="button" class="btn btn-danger remove-appointment ms-2 mt-3">✖</button></div>
        </div>
      </div>
    <% end %>
  </div>
  <button type="button" id="add-appointment" class="btn btn-primary mt-3">Añadir otra cita</button>
  <div class="mt-4">
    <%= f.submit "Guardar", class: "btn btn-success", id:"btnFormSaime" %>
    <%= link_to "Volver", "javascript:history.back()", class: "btn btn-secondary ms-2" %>
  </div>
  <!-- Template para nueva cita -->
  <template id="appointment-template">
    <div class="appointment border p-3 mb-3 text-black">
      <div class="row">
        <div class="col-md-2">
          <label>Fecha de la Cita</label>
          <input type="date" name="saime_user[appointments_attributes][INDEX][appointment_date]" class="form-control appointment-date" required>
        </div>
        <div class="col-md-3">
          <label>Tipo de Cita</label>
          <select name="saime_user[appointments_attributes][INDEX][appointment_type]" class="form-control appointment-type">
            <option value="cedula">Cédula</option>
            <option value="civil">Civil</option>
            <option value="niño">Niño</option>
          </select>
        </div>
        <div class="col-md-1"><button type="button" class="btn btn-danger remove-appointment ms-2 mt-3">✖</button></div>
      </div>
    </div>
  </template>
<% end %>
