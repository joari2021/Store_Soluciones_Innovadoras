<h1>Citas Saime</h1>
<div>
  <%= link_to 'Nuevo Registro', new_saime_user_path, class: "btn btn-primary me-3" %>
  <%= render "modal-datos-citas"%>
</div>
<nav class="navbar navbar-expand-lg navbar-light bg-light mb-3">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">Filtros de Citas</a>
    <div class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to "Citas Disponibles", saime_users_path(filter: "disponible"), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Citas No Programables", saime_users_path(filter: "inprogramable"), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Citas Apartadas", saime_users_path(filter: "apartadas"), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Usuarios Bloqueados Temporalmente", saime_users_path(filter: "temporarily_blocked"), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Usuarios Bloqueados", saime_users_path(filter: "blocked"), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Citas por Agendar", saime_users_path(filter: "por_agendar"), class: "nav-link" %>
        </li>
      </ul>
    </div>
  </div>
</nav>
<div class="row">
  <% @saime_users.each do |user| %>
    <div class="col-md-2 mb-4">
      <div class="card h-100">
        <div class="card-body bg-success">
          <h5 class="card-title d-flex justify-content-between align-items-center">
            Cédula: <%= user.identification %>
            <a href="#" class="copy fs-3 ms-auto" data-dato="<%= user.identification %>">
              <i class="ri-file-copy-line"></i>
            </a>
          </h5>
          <p class="card-text d-flex justify-content-between align-items-center">
            Entrada: <span class="masked-entry ms-2">*************</span>
            <a href="#" class="copy fs-3 ms-auto" data-dato="<%= user.entry %>">
              <i class="ri-file-copy-line"></i>
            </a>
          </p>
          <hr>
          <h6 class="fw-bold">CITAS:</h6>
          <% if user.appointments.any? %>
            <ul class="list-group list-group-flush">
              <% user.appointments.each do |appointment| %>
                <li class="appointment text-black ">
                  <p class="d-flex justify-content-between align-items-center">
                    <strong>Fecha:</strong>
                    <span class="ms-auto"><%= appointment.appointment_date.strftime("%d/%m/%Y") %></span>
                  </p>
                  <p class="d-flex justify-content-between align-items-center"><strong>Tipo:</strong><span class="ms-auto"><%= appointment.appointment_type.capitalize %></span></p>
                  <p class="d-flex justify-content-between align-items-center"><strong>Status:</strong> <span class="ms-auto"><%= appointment.status %></span></p>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="fst-italic">¡No hay Citas Registradas!</p>
          <% end %>
        </div>
        <div class="card-footer text-end">
          <%= link_to "Edit", edit_saime_user_path(user), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
