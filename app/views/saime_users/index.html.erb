<h1 class="my-4">Citas Saime</h1>
<div class="row">
  <% @saime_users.each do |user| %>
    <div class="col-md-2 mb-4">
      <div class="card h-100">
        <div class="card-body bg-success">
          <h5 class="card-title d-flex justify-content-between align-items-center">
            Cédula: <%= user.identification %>
            <a href="#" class="copy fs-3 ms-auto" data-dato="<%= user.identification %>">
              <i class="ri-file-copy-line"></i>
            </a>
          </h5>
          <p class="card-text d-flex justify-content-between align-items-center">
            Entrada: <span class="masked-entry ms-2">*************</span>
            <a href="#" class="copy fs-3 ms-auto" data-dato="<%= user.entry %>">
              <i class="ri-file-copy-line"></i>
            </a>
          </p>
          <hr>
          <h6 class="fw-bold">CITAS:</h6>
          <% if user.appointments.any? %>
            <ul class="list-group list-group-flush">
              <% user.appointments.each do |appointment| %>
                <li class="appointment text-black ">
                  <p class="d-flex justify-content-between align-items-center"><strong>Tipo:</strong><span class="ms-auto"><%= appointment.appointment_type.capitalize %></span></p>
                  <p class="d-flex justify-content-between align-items-center">
                    <strong>Fecha:</strong>
                    <span class="ms-auto"><%= appointment.appointment_date.strftime("%d/%m/%Y") %></span>
                  </p>
                  <p class="d-flex justify-content-between align-items-center"><strong>Hora:</strong><span class="ms-auto"><%= appointment.appointment_time%></span></p>
                  <p class="d-flex justify-content-between align-items-center"><strong>Status:</strong> <span class="ms-auto"><%= appointment.status %></span></p>
                  <p class="d-flex justify-content-between align-items-center">
                    <strong>Reprogramable:</strong>
                    <span class="ms-auto">
                      <% if appointment.reschedulable %>
                        <i class="ri-checkbox-circle-fill text-success fs-3"></i>
                      <% else %>
                        <i class="ri-close-circle-fill text-danger fs-3"></i>
                      <% end %>
                    </span>
                  </p class="d-flex justify-content-between align-items-center">
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted">No appointments found</p>
          <% end %>
        </div>
        <div class="card-footer text-end">
          <%= link_to "Edit", edit_saime_user_path(user), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>