<% historial_query_params = @historial_query_params || {} %>
<% selected_cliente_query = @cliente_query.to_s %>
<% selected_cash_shift_id = @selected_cash_shift_id.to_s.presence %>
<% selected_fecha_desde_value = @selected_fecha_desde&.strftime('%d-%m-%Y') %>
<% selected_fecha_hasta_value = @selected_fecha_hasta&.strftime('%d-%m-%Y') %>
<% cash_shift_options = [['Todos los turnos', '']] + Array(@cash_shifts_for_filter).map { |shift| ["Turno ##{shift.id} · #{shift.opened_at.strftime('%d/%m/%Y %H:%M')} · #{shift.status_label}", shift.id.to_s] } %>
<div
  class="space-y-6 fade-in"
  data-sold-products-index="true"
  data-sold-products-url="<%= historial_productos_ventas_path %>"
  data-sold-products-cliente-query="<%= selected_cliente_query %>"
  data-sold-products-cash-shift-id="<%= selected_cash_shift_id %>"
  data-sold-products-fecha-desde="<%= selected_fecha_desde_value %>"
  data-sold-products-fecha-hasta="<%= selected_fecha_hasta_value %>"
>
  <div class="relative overflow-hidden rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="absolute -top-16 right-0 h-48 w-48 rounded-full bg-cyan-200/30 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 h-32 w-32 rounded-full bg-sky-200/30 blur-2xl"></div>
    <div class="relative flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-sky-200 bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-sky-700 shadow-sm backdrop-blur">
          <i data-lucide="package-search" class="h-3.5 w-3.5"></i>
          Productos vendidos
        </span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-800 md:text-4xl">Historial de productos vendidos</h1>
        <p class="mt-2 max-w-xl text-sm leading-6 text-slate-600 md:text-base">Consulta todos los productos vendidos con los mismos filtros del historial de ventas.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to historial_ventas_path(historial_query_params), class: "inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-cyan-200 bg-cyan-50 px-6 py-3 font-medium text-cyan-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-cyan-100 active:scale-95 md:w-auto" do %>
          <i data-lucide="history" class="h-4 w-4"></i>
          Historial ventas
        <% end %>
        <%= link_to ventas_path, class: "inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-slate-900 px-6 py-3 font-medium text-white shadow-lg shadow-slate-200 transition-all hover:-translate-y-0.5 hover:bg-slate-800 active:scale-95 md:w-auto" do %>
          <i data-lucide="shopping-cart" class="h-4 w-4"></i>
          Ir al POS
        <% end %>
      </div>
    </div>
    <div class="relative mt-6 rounded-2xl border border-white/70 bg-white/85 p-4 shadow-sm backdrop-blur">
      <%= form_with url: historial_productos_ventas_path, method: :get, local: true, class: 'grid gap-3 md:grid-cols-[minmax(0,16rem)_minmax(0,14rem)_minmax(0,12rem)_minmax(0,12rem)_auto_auto] md:items-end' do %>
        <div>
          <label for="historial_productos_cliente_query" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Cliente</label>
          <%= text_field_tag :cliente_query,
                             selected_cliente_query,
                             id: 'historial_productos_cliente_query',
                             autocomplete: 'off',
                             placeholder: 'Nombre, documento...',
                             class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <div>
          <label for="historial_productos_cash_shift_id" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Turno</label>
          <%= select_tag :cash_shift_id,
                         options_for_select(cash_shift_options, selected_cash_shift_id),
                         id: 'historial_productos_cash_shift_id',
                         class: 'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <div>
          <label for="historial_productos_fecha_desde" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Desde</label>
          <%= text_field_tag :fecha_desde,
                             selected_fecha_desde_value,
                             id: 'historial_productos_fecha_desde',
                             autocomplete: 'off',
                             placeholder: 'dd-mm-aaaa',
                             class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <div>
          <label for="historial_productos_fecha_hasta" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Hasta</label>
          <%= text_field_tag :fecha_hasta,
                             selected_fecha_hasta_value,
                             id: 'historial_productos_fecha_hasta',
                             autocomplete: 'off',
                             placeholder: 'dd-mm-aaaa',
                             class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">Filtrar</button>
        <%= link_to historial_productos_ventas_path, class: 'inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
          Limpiar
        <% end %>
      <% end %>
    </div>
    <div class="relative mt-6 grid gap-3 sm:grid-cols-2">
      <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Items vendidos</p>
        <p class="mt-2 text-2xl font-extrabold text-slate-800"><%= @sold_products_total %></p>
        <p class="mt-1 text-xs text-slate-500">Filtrado actual</p>
      </div>
      <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Productos unicos</p>
        <p class="mt-2 text-2xl font-extrabold text-slate-800"><%= @sold_products_unique %></p>
        <p class="mt-1 text-xs text-slate-500">Filtrado actual</p>
      </div>
    </div>
  </div>
  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between gap-3 border-b border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Tabla de productos</p>
        <h2 class="mt-1 text-lg font-bold text-slate-800">Productos vendidos por fecha</h2>
      </div>
      <span class="inline-flex items-center rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700 ring-1 ring-sky-100"><%= @sold_products_total %> resultados</span>
    </div>
    <% if @sold_items.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm text-slate-700">
          <thead class="border-b border-sky-100 bg-sky-50/70 text-xs font-bold uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-4">Producto</th>
              <th class="px-6 py-4">Fecha y hora</th>
              <th class="px-6 py-4">Venta</th>
              <th class="px-6 py-4 text-right">Cantidad</th>
            </tr>
          </thead>
          <tbody id="sold-products-tbody" class="divide-y divide-slate-100">
            <%= render partial: 'ventas/historial_producto_row', collection: @sold_items, as: :sold_item, locals: { start_index: 0 } %>
          </tbody>
        </table>
      </div>
      <% if @pagy&.next %>
        <div class="border-t border-slate-100 px-6 py-4 text-center" data-sold-products-pagination="true" data-next-page="<%= @pagy.next %>">
          <div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm text-slate-500 shadow-sm">
            <span class="h-2 w-2 animate-pulse rounded-full bg-sky-400"></span>
            <span data-sold-products-pagination-text="true">Desplazate para cargar mas</span>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-10 text-center">
        <p class="text-base font-semibold text-slate-700">No hay productos vendidos para el filtro seleccionado.</p>
        <p class="mt-1 text-sm text-slate-500">Prueba ajustando cliente, turno o rango de fechas.</p>
      </div>
    <% end %>
  </div>
</div>
<script>
  (() => {
    const initSoldProductsInfiniteScroll = (scope = document) => {
      const roots = [];

      if (scope instanceof Element && scope.matches("[data-sold-products-index='true']")) {
        roots.push(scope);
      }

      if (scope.querySelectorAll) {
        roots.push(...scope.querySelectorAll("[data-sold-products-index='true']"));
      }

      roots.forEach((root) => {
        if (root.dataset.soldProductsBound === "true") return;
        root.dataset.soldProductsBound = "true";

        const tableBody = root.querySelector("#sold-products-tbody");
        let observer = null;
        let loading = false;

        const buildUrl = (page) => {
          const url = new URL(root.dataset.soldProductsUrl, window.location.origin);
          const clienteQuery = String(root.dataset.soldProductsClienteQuery || "").trim();
          const cashShiftId = String(root.dataset.soldProductsCashShiftId || "").trim();
          const fechaDesde = String(root.dataset.soldProductsFechaDesde || "").trim();
          const fechaHasta = String(root.dataset.soldProductsFechaHasta || "").trim();

          if (clienteQuery) url.searchParams.set("cliente_query", clienteQuery);
          if (cashShiftId) url.searchParams.set("cash_shift_id", cashShiftId);
          if (fechaDesde) url.searchParams.set("fecha_desde", fechaDesde);
          if (fechaHasta) url.searchParams.set("fecha_hasta", fechaHasta);

          url.searchParams.set("page", String(page));
          url.searchParams.set("format", "json");
          return url.toString();
        };

        const disconnectObserver = () => {
          if (observer) {
            observer.disconnect();
            observer = null;
          }
        };

        const setRetryState = (pagination) => {
          pagination.innerHTML = `
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 cursor-pointer"
              data-sold-products-retry="true"
            >
              Reintentar carga
            </button>
          `;
        };

        const bindPagination = (pagination) => {
          if (!pagination) return;

          disconnectObserver();

          if (!("IntersectionObserver" in window)) {
            setRetryState(pagination);
            return;
          }

          observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                disconnectObserver();
                loadPage(pagination);
              });
            },
            { rootMargin: "220px 0px" },
          );

          observer.observe(pagination);
        };

        const loadPage = async (pagination) => {
          const nextPage = Number(pagination.dataset.nextPage || 0);
          if (!nextPage || loading) return;

          loading = true;
          const messageNode = pagination.querySelector("[data-sold-products-pagination-text='true']");
          if (messageNode) messageNode.textContent = "Cargando mas productos...";

          try {
            const response = await fetch(buildUrl(nextPage), {
              headers: {
                Accept: "application/json",
                "X-Requested-With": "XMLHttpRequest",
              },
            });

            const data = await response.json();
            if (!response.ok) throw new Error(data.error || "No se pudo cargar la siguiente pagina");

            if (data.table_rows_html && tableBody) {
              tableBody.insertAdjacentHTML("beforeend", data.table_rows_html);
              if (window.lucide) window.lucide.createIcons();
            }

            if (data.next_page) {
              pagination.dataset.nextPage = String(data.next_page);

              if (messageNode) {
                messageNode.textContent = "Desplazate para cargar mas";
              }

              bindPagination(pagination);
            } else {
              pagination.remove();
            }
          } catch (_error) {
            setRetryState(pagination);
          } finally {
            loading = false;
          }
        };

        root.addEventListener("click", (event) => {
          const retryButton = event.target.closest("[data-sold-products-retry='true']");
          if (!retryButton) return;

          const pagination = retryButton.closest("[data-sold-products-pagination='true']");
          if (!pagination) return;

          pagination.innerHTML = `
            <div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm text-slate-500 shadow-sm">
              <span class="h-2 w-2 animate-pulse rounded-full bg-sky-400"></span>
              <span data-sold-products-pagination-text="true">Cargando mas productos...</span>
            </div>
          `;

          loadPage(pagination);
        });

        bindPagination(root.querySelector("[data-sold-products-pagination='true']"));

        document.addEventListener(
          "turbo:before-cache",
          () => {
            disconnectObserver();
          },
          { once: true },
        );
      });
    };

    document.addEventListener("turbo:load", () => initSoldProductsInfiniteScroll(document));
    document.addEventListener("DOMContentLoaded", () => initSoldProductsInfiniteScroll(document));
    document.addEventListener("turbo:render", () => initSoldProductsInfiniteScroll(document));
    document.addEventListener("turbo:frame-load", (event) => initSoldProductsInfiniteScroll(event.target));
  })();
</script>
