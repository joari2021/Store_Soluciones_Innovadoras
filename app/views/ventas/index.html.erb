                  setBankFieldsEnabled(bankFields, Boolean(checkbox?.checked), 'sky');
                  setRowVisualState(row, Boolean(checkbox?.checked), 'sky');
                  setPaymentAccordionState(row, Boolean(checkbox?.checked));
                  syncPaymentRowMethodTone(row);
