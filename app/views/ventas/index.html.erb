            <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white ring-1 ring-white/15">Nueva</span>
          </div>
        </div>
        <div class="mt-4 space-y-3">
          <div class="grid grid-cols-1 gap-2 <%= customer_pos_mode ? '' : 'sm:grid-cols-2' %>">
            <% unless customer_pos_mode %>
              <button id="ventas-save-draft-button" type="button" class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50" disabled>
