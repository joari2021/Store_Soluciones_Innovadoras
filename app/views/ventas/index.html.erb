            <script>
              (() => {
                if (window.ventasPosListenersBound) return;
                window.ventasPosListenersBound = true;

                const initVentasPOS = () => {
                  const root = document.getElementById('ventas-pos-root');
                  if (!root || root.dataset.bound === 'true') return;
                  root.dataset.bound = 'true';

                  const hasOpenCashShift = root.dataset.openShift === 'true';

                  const productsDataEl = document.getElementById('ventas-products-data');
                  if (!productsDataEl) return;

                  let products = [];
                  try {
                    products = JSON.parse(productsDataEl.textContent || '[]');
                  } catch (error) {
                    products = [];
                  }

                  const servicesDataEl = document.getElementById('ventas-services-data');
                  let services = [];
                  if (servicesDataEl) {
                    try {
                      services = JSON.parse(servicesDataEl.textContent || '[]');
                    } catch (error) {
                      services = [];
                    }
                  }

                  const accountsDataEl = document.getElementById('ventas-accounts-data');
                  let accounts = [];
                  if (accountsDataEl) {
                    try {
                      accounts = JSON.parse(accountsDataEl.textContent || '[]');
                    } catch (error) {
                      accounts = [];
                    }
                  }

                  const draftsDataEl = document.getElementById('ventas-drafts-data');
                  let drafts = [];
                  if (draftsDataEl) {
                    try {
                      drafts = JSON.parse(draftsDataEl.textContent || '[]');
                    } catch (error) {
                      drafts = [];
                    }
                  }

                  const PAYMENT_SPECIAL_ORDER = ['biopago', 'pos', 'cashea'];

                  const accountTypeKey = (account) => String(account?.account_type || '').toLowerCase();

                  const isSpecialAccount = (account) => PAYMENT_SPECIAL_ORDER.includes(accountTypeKey(account));

                  const paymentCurrencyPriority = (currency) => {
                    const key = String(currency || '').toUpperCase();
                    const priority = {
                      VES: 0,
                      USD: 1,
                      EUR: 2,
                      USDT: 3,
                      BTC: 4,
                      BNB: 5,
                    };

                    return Object.prototype.hasOwnProperty.call(priority, key) ? priority[key] : 99;
                  };

                  const paymentTypePriority = (account) => {
                    const type = accountTypeKey(account);
                    const specialIndex = PAYMENT_SPECIAL_ORDER.indexOf(type);
                    if (specialIndex >= 0) return specialIndex;

                    if (account?.is_bank || type === 'bank_account') return 100;
                    if (type === 'cash_box') return 200;
                    if (type === 'card') return 300;
                    if (type === 'digital_wallet') return 400;
                    if (type === 'crypto_wallet') return 500;

                    return 900;
                  };

                  const orderAccountsForPaymentModal = (accountList) => {
                    const list = Array.isArray(accountList) ? [...accountList] : [];

                    return list.sort((a, b) => {
                      const typePriorityDiff = paymentTypePriority(a) - paymentTypePriority(b);
                      if (typePriorityDiff !== 0) return typePriorityDiff;

                      const aIsBank = Boolean(a?.is_bank) || accountTypeKey(a) === 'bank_account';
                      const bIsBank = Boolean(b?.is_bank) || accountTypeKey(b) === 'bank_account';

                      if (aIsBank && bIsBank && Boolean(a?.is_primary) !== Boolean(b?.is_primary)) {
                        return a?.is_primary ? -1 : 1;
                      }

                      const currencyDiff = paymentCurrencyPriority(a?.currency) - paymentCurrencyPriority(b?.currency);
                      if (currencyDiff !== 0) return currencyDiff;

                      return String(a?.name || '').localeCompare(String(b?.name || ''), 'es', { sensitivity: 'base' });
                    });
                  };

                  const productsById = new Map(products.map((product) => [String(product.id), product]));
                  const servicesById = new Map(services.map((service) => [String(service.id), service]));
                  const accountsById = new Map(accounts.map((account) => [String(account.id), account]));
                  const cart = new Map();
                  const syncedReservedProductQuantities = new Map();
                  const vatRate = 0.16;
                  const paymentTolerance = 0.01;
                  let selectedClient = null;
                  let activeDraftId = null;
                  let activeDraftVisibility = null;
                  let draftSyncTimeout = null;
                  let draftSyncedFingerprint = null;
                  let draftSyncInProgress = false;
                  let liveProductsSyncInterval = null;
                  let liveProductsSyncInFlight = false;

                  const saveDraftButton = document.getElementById('ventas-save-draft-button');
                  const clearPanelButton = document.getElementById('ventas-clear-panel-button');
                  const draftsListEl = document.getElementById('ventas-drafts-list');
                  const draftsEmptyEl = document.getElementById('ventas-drafts-empty');
                  const draftsCountEl = document.getElementById('ventas-drafts-count');

                  const parseRate = (value) => {
                    if (!value) return 0;
                    const normalized = String(value).replace(',', '.');
                    const parsed = Number.parseFloat(normalized);
                    if (!Number.isFinite(parsed)) return 0;
                    return Math.round(parsed * 100) / 100;
                  };

                  const bcvRate = parseRate(root.dataset.bcvRate);

                  let baseCurrency = 'ves';
                  const baseCurrencyInputs = root.querySelectorAll('input[name="ventas-base-currency"]');
                  const checkedBase = Array.from(baseCurrencyInputs).find((input) => input.checked);
                  if (checkedBase) baseCurrency = checkedBase.value;

                  if (bcvRate <= 0) {
                    baseCurrencyInputs.forEach((input) => {
                      if (input.value === 'ves') {
                        input.disabled = true;
                        input.closest('label')?.classList.add('opacity-50');
                      }
                    });
                  }

                  if (baseCurrency === 'ves' && bcvRate <= 0) {
                    baseCurrency = 'usd';
                    baseCurrencyInputs.forEach((input) => {
                      input.checked = input.value === 'usd';
                    });
                  }

                  const roundTo = (value, digits = 2) => {
                    const factor = 10 ** digits;
                    return Math.round((Number(value) || 0) * factor) / factor;
                  };

                  const normalizeSearchValue = (value) =>
                    String(value || '')
                      .toLowerCase()
                      .normalize('NFD')
                      .replace(/[\u0300-\u036f]/g, '')
                      .trim();

                  const normalizeVariationId = (value) => {
                    if (value === null || value === undefined) return null;
                    if (value === '' || value === 'null') return null;
                    return String(value);
                  };

                  const normalizeItemType = (value) => (value === 'service' ? 'service' : 'product');

                  const normalizeCurrencyCode = (value) => String(value || '').trim().toUpperCase();
                  const isUsdCurrency = (currency) => ['USD', 'USDT'].includes(currency);

                  const convertUsdToBase = (usdValue) => {
                    if (baseCurrency === 'usd') return roundTo(Number(usdValue) || 0, 2);
                    if (bcvRate <= 0) return 0;
                    return roundTo((Number(usdValue) || 0) * bcvRate, 2);
                  };

                  const convertBaseToUsd = (baseValue) => {
                    if (baseCurrency === 'usd') return roundTo(Number(baseValue) || 0, 2);
                    if (bcvRate <= 0) return 0;
                    return roundTo((Number(baseValue) || 0) / bcvRate, 2);
                  };

                  const convertAmount = (amount, fromCurrency, toCurrency) => {
                    const fromCode = normalizeCurrencyCode(fromCurrency);
                    const toCode = normalizeCurrencyCode(toCurrency);
                    const numeric = Number(amount) || 0;

                    if (fromCode === toCode) return roundTo(numeric, 2);
                    if (isUsdCurrency(fromCode) && toCode === 'VES') return bcvRate > 0 ? roundTo(numeric * bcvRate, 2) : null;
                    if (fromCode === 'VES' && isUsdCurrency(toCode)) return bcvRate > 0 ? roundTo(numeric / bcvRate, 2) : null;
                    if (isUsdCurrency(fromCode) && isUsdCurrency(toCode)) return roundTo(numeric, 2);
                    return null;
                  };

                  const formatNumber = (value, digits = 2) => {
                    const amount = Number.isFinite(value) ? value : 0;
                    return amount.toLocaleString('es-VE', {
                      minimumFractionDigits: digits,
                      maximumFractionDigits: digits,
                    });
                  };

                  const formatMoney = (value, unit = '$') => `${unit}${formatNumber(value)}`;
                  const formatMoneyBs = (value) => (bcvRate > 0 ? formatMoney(value * bcvRate, 'Bs ') : 'Bs --');
                  const formatBaseMoney = (value) => (baseCurrency === 'usd' ? formatMoney(value, '$') : formatMoney(value, 'Bs '));
                  const formatAltFromBase = (value) => {
                    if (baseCurrency === 'usd') return formatMoneyBs(value);
                    return bcvRate > 0 ? formatMoney(convertBaseToUsd(value), '$') : '$--';
                  };
                  const formatCurrencyValue = (value, currencyCode) => {
                    if (currencyCode === 'VES') return formatMoney(value, 'Bs ');
                    return formatMoney(value, '$');
                  };

                  const currentBaseCurrencyCode = () => (baseCurrency === 'ves' ? 'VES' : 'USD');

                  const normalizeServiceReferenceName = (service) => {
                    const raw = String(service?.currency_base_price || '').trim();
                    if (!raw) return 'Dolar BCV';
                    return raw === '$' ? 'Dolar BCV' : raw;
                  };

                  const resolveServiceReferenceSymbol = (service, referenceName = null) => {
                    const normalizedReference = referenceName || normalizeServiceReferenceName(service);
                    const rawSymbol = String(service?.currency_symbol || '').trim();
                    if (rawSymbol.length > 0) return rawSymbol;
                    return normalizedReference === 'Bs' ? 'Bs' : '$';
                  };

                  const resolveServiceReferenceRateBs = (service, referenceName = null) => {
                    const normalizedReference = referenceName || normalizeServiceReferenceName(service);
                    const payloadRate = Number(service?.reference_rate_bs);
                    if (Number.isFinite(payloadRate) && payloadRate > 0) return payloadRate;
                    if (normalizedReference === 'Bs') return 1;
                    if (normalizedReference === 'Dolar BCV') return bcvRate > 0 ? bcvRate : 0;
                    return 0;
                  };

                  const computeOnRequestServiceAmounts = ({ service, referenceAmount }) => {
                    const normalizedReference = normalizeServiceReferenceName(service);
                    const referenceSymbol = resolveServiceReferenceSymbol(service, normalizedReference);
                    const referenceRateBs = resolveServiceReferenceRateBs(service, normalizedReference);

                    if (!(referenceAmount > 0)) {
                      return { error: 'Indica un precio valido mayor a 0.' };
                    }

                    if (normalizedReference === 'Bs' && !(bcvRate > 0)) {
                      return { error: 'No hay tasa BCV disponible para convertir precios en Bs.' };
                    }

                    if (normalizedReference !== 'Bs' && normalizedReference !== 'Dolar BCV' && !(referenceRateBs > 0)) {
                      return { error: `No hay tasa disponible para ${normalizedReference}.` };
                    }

                    let amountBs = 0;
                    let unitPriceUsd = 0;

                    if (normalizedReference === 'Bs') {
                      amountBs = referenceAmount;
                      unitPriceUsd = referenceAmount / bcvRate;
                    } else if (normalizedReference === 'Dolar BCV') {
                      unitPriceUsd = referenceAmount;
                      amountBs = referenceAmount * (referenceRateBs > 0 ? referenceRateBs : bcvRate);
                    } else {
                      if (!(bcvRate > 0)) {
                        return { error: 'No hay tasa BCV disponible para convertir el precio acordado.' };
                      }
                      amountBs = referenceAmount * referenceRateBs;
                      unitPriceUsd = amountBs / bcvRate;
                    }

                    if (!(unitPriceUsd > 0)) {
                      return { error: 'No se pudo calcular el precio del servicio.' };
                    }

                    const invoiceCurrencyCode = currentBaseCurrencyCode();
                    const invoiceUnitAmountRaw = invoiceCurrencyCode === 'USD' ? unitPriceUsd : amountBs;
                    const invoiceUnitAmount = roundTo(invoiceUnitAmountRaw, 2);

                    return {
                      unitPriceUsd: roundTo(unitPriceUsd, 6),
                      invoiceCurrencyCode,
                      invoiceUnitAmount,
                      priceSignature: `${invoiceCurrencyCode}:${invoiceUnitAmount.toFixed(2)}`,
                      priceDisplay: formatCurrencyValue(invoiceUnitAmount, invoiceCurrencyCode),
                      referenceName: normalizedReference,
                      referenceSymbol,
                      referenceAmount: roundTo(referenceAmount, 2),
                    };
                  };

                  const parseMoneyInput = (input) => {
                    if (!input) return 0;
                    if (window.MoneyInputMask?.parseValue) return window.MoneyInputMask.parseValue(input);
                      const raw = String(input.value || '').replace(/\s/g, '').replace(/[^\d.,-]/g, '');
                    const normalized = raw.includes(',') ? raw.replace(/\./g, '').replace(',', '.') : raw;
                    const parsed = Number.parseFloat(normalized);
                    return Number.isFinite(parsed) ? parsed : 0;
                  };

                  const setMoneyInputValue = (input, value, symbol) => {
                    if (!input) return;
                    if (window.MoneyInputMask?.setValue) {
                      window.MoneyInputMask.setValue(input, value, symbol);
                      return;
                    }
                    input.value = formatMoney(value, symbol || '$');
                    if (symbol) input.dataset.moneySymbol = symbol;
                  };

                  const initMoneyMasks = (rootEl) => {
                    if (window.MoneyInputMask?.init) {
                      window.MoneyInputMask.init(rootEl || document);
                    }
                  };

                  const buildKey = (itemType, itemId, variationId) => `${normalizeItemType(itemType)}:${itemId}::${normalizeVariationId(variationId) || 'none'}`;

                  const buildProductReservationSnapshot = () => {
                    const snapshot = new Map();
                    cart.forEach((item, key) => {
                      if ((item.itemType || 'product') !== 'product') return;
                      const quantity = Number(item.quantity) || 0;
                      if (!(quantity > 0)) return;
                      snapshot.set(String(key), quantity);
                    });
                    return snapshot;
                  };

                  const applySyncedReservationSnapshot = (snapshot) => {
                    syncedReservedProductQuantities.clear();
                    if (!(snapshot instanceof Map)) return;

                    snapshot.forEach((quantity, key) => {
                      const safeQuantity = Number(quantity) || 0;
                      if (!(safeQuantity > 0)) return;
                      syncedReservedProductQuantities.set(String(key), safeQuantity);
                    });
                  };

                  const syncedReservedQuantityForVariation = (productId, variationId) => {
                    const key = buildKey('product', productId, normalizeVariationId(variationId));
                    return Number(syncedReservedProductQuantities.get(String(key))) || 0;
                  };

                  const syncedReservedQuantityForProduct = (productId) => {
                    const prefix = `product:${String(productId)}::`;
                    let total = 0;
                    syncedReservedProductQuantities.forEach((quantity, key) => {
                      if (!String(key).startsWith(prefix)) return;
                      total += Number(quantity) || 0;
                    });
                    return total;
                  };

                  const getVatMode = () => {
                    const selected = root.querySelector('input[name="ventas-vat-mode"]:checked');
                    return selected ? selected.value : 'none';
                  };

                  const computePricing = (baseUnitUsd, quantity) => {
                    const vatMode = getVatMode();
                    const unitUsd = Number(baseUnitUsd) || 0;
                    const unitBaseRaw = baseCurrency === 'usd' ? unitUsd : convertUsdToBase(unitUsd);
                    const unitBase = roundTo(unitBaseRaw, 2);
                    const safeQty = Number(quantity) || 0;
                    let unitNet = unitBase;

                    if (vatMode === 'included' && vatRate > 0) {
                      unitNet = roundTo(unitBase / (1 + vatRate), 2);
                    }

                    const lineNet = roundTo(unitNet * safeQty, 2);
                    return {
                      unitDisplay: unitNet,
                      lineNet: lineNet,
                      lineTotal: lineNet,
                    };
                  };

                  const resolveServiceUnitPriceUsd = (service, item = {}) => {
                    const itemPrice = Number(item.unit_price_usd);
                    if (Number.isFinite(itemPrice) && itemPrice > 0) return itemPrice;

                    const defaultPrice = Number(service?.price_usd);
                    if (Number.isFinite(defaultPrice) && defaultPrice > 0) return defaultPrice;

                    return 0;
                  };

                  const computeServicePricing = (service, item = {}) => {
                    const baseCode = currentBaseCurrencyCode();
                    const persistedBaseAmount = Number(item.unit_price_base_amount);
                    const persistedBaseCurrency = normalizeCurrencyCode(item.unit_price_base_currency);
                    if (Number.isFinite(persistedBaseAmount) && persistedBaseAmount > 0 && persistedBaseCurrency === baseCode) {
                      const vatMode = getVatMode();
                      const safeQty = Number(item.quantity) || 0;
                      let unitNet = roundTo(persistedBaseAmount, 2);

                      if (vatMode === 'included' && vatRate > 0) {
                        unitNet = roundTo(unitNet / (1 + vatRate), 2);
                      }

                      const lineNet = roundTo(unitNet * safeQty, 2);
                      return {
                        unitDisplay: unitNet,
                        lineNet,
                        lineTotal: lineNet,
                      };
                    }

                    const unitPriceUsd = resolveServiceUnitPriceUsd(service, item);
                    return computePricing(unitPriceUsd, item.quantity);
                  };

                  const escapeHtml = (value) =>
                    String(value)
                      .replace(/&/g, '&amp;')
                      .replace(/</g, '&lt;')
                      .replace(/>/g, '&gt;')
                      .replace(/"/g, '&quot;')
                      .replace(/'/g, '&#39;');

                  const escapeCssUrl = (value) => encodeURI(String(value || '').trim());

                  const formatDraftUpdatedAt = (isoValue) => {
                    if (!isoValue) return '';
                    const date = new Date(isoValue);
                    if (Number.isNaN(date.getTime())) return '';
                    return date.toLocaleString('es-VE', {
                      day: '2-digit',
                      month: '2-digit',
                      hour: '2-digit',
                      minute: '2-digit',
                    });
                  };

                  const setBaseCurrencySelection = (nextCurrency) => {
                    const normalized = String(nextCurrency || '').toUpperCase();
                    const candidate = normalized === 'VES' ? 'ves' : 'usd';
                    const targetInput = Array.from(baseCurrencyInputs).find((input) => input.value === candidate && !input.disabled);
                    if (!targetInput) return;
                    baseCurrency = targetInput.value;
                    baseCurrencyInputs.forEach((input) => {
                      input.checked = input.value === baseCurrency;
                    });
                  };

                  const setVatModeSelection = (nextMode) => {
                    const normalized = String(nextMode || '').toLowerCase();
                    const safeMode = ['none', 'add', 'included'].includes(normalized) ? normalized : 'none';
                    root.querySelectorAll('input[name="ventas-vat-mode"]').forEach((radio) => {
                      radio.checked = radio.value === safeMode;
                    });
                  };

                  const updateDraftActionButtons = () => {
                    if (saveDraftButton) {
                      const canSave = cart.size > 0;
                      saveDraftButton.disabled = !canSave;
                      saveDraftButton.classList.toggle('opacity-50', !canSave);
                      saveDraftButton.classList.toggle('cursor-not-allowed', !canSave);
                    }

                    if (clearPanelButton) {
                      const canClear = cart.size > 0 || Boolean(activeDraftId);
                      clearPanelButton.disabled = !canClear;
                      clearPanelButton.classList.toggle('opacity-50', !canClear);
                      clearPanelButton.classList.toggle('cursor-not-allowed', !canClear);
                    }
                  };

                  const renderDraftTags = () => {
                    if (!draftsListEl || !draftsEmptyEl || !draftsCountEl) return;

                    const safeDrafts = Array.isArray(drafts) ? drafts : [];
                    draftsCountEl.textContent = String(safeDrafts.length);
                    draftsEmptyEl.classList.toggle('hidden', safeDrafts.length > 0);

                    if (safeDrafts.length === 0) {
                      draftsListEl.innerHTML = '';
                      return;
                    }

                    draftsListEl.innerHTML = safeDrafts
                      .map((draft) => {
                        const draftId = String(draft.id || '');
                        const isActive = activeDraftId && String(activeDraftId) === draftId;
                        const clientName = String(draft.client_name || 'Cliente general');
                        const itemsCount = Number(draft.items_count || 0);
                        const updatedAt = formatDraftUpdatedAt(draft.updated_at);
                        const activeBadge = isActive
                          ? '<span class="inline-flex rounded-full bg-white/20 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Activo</span>'
                          : '';
                        const chipClass = isActive
                          ? 'border-sky-600 bg-sky-600 text-white shadow-sm ring-1 ring-sky-500'
                          : 'border-cyan-200 bg-white text-cyan-700 ring-1 ring-cyan-200 hover:bg-cyan-50';
                        const countBadgeClass = isActive
                          ? 'bg-white/20 text-white'
                          : 'bg-cyan-100 text-cyan-700';
                        const dateTextClass = isActive ? 'text-white/85' : 'text-cyan-600/80';

                        return `
                          <button type="button" data-draft-id="${escapeHtml(draftId)}" class="inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors ${chipClass}">
                            <span class="max-w-[12rem] truncate">${escapeHtml(clientName)}</span>
                            <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full px-1.5 py-0.5 text-[11px] font-bold ${countBadgeClass}">${itemsCount}</span>
                            ${activeBadge}
                            ${updatedAt ? `<span class="text-[10px] font-medium ${dateTextClass}">${escapeHtml(updatedAt)}</span>` : ''}
                          </button>
                        `;
                      })
                      .join('');
                  };

                  const getCartQuantityForVariation = (productId, variationId) => {
                    let total = 0;
                    const normalizedVariation = normalizeVariationId(variationId);
                    cart.forEach((item) => {
                      if ((item.itemType || 'product') !== 'product') return;
                      if (String(item.productId) === String(productId) && normalizeVariationId(item.variationId) === normalizedVariation) {
                        total += Number(item.quantity) || 0;
                      }
                    });
                    return total;
                  };

                  const getCartQuantityForProduct = (productId) => {
                    let total = 0;
                    cart.forEach((item) => {
                      if ((item.itemType || 'product') !== 'product') return;
                      if (String(item.productId) === String(productId)) {
                        total += Number(item.quantity) || 0;
                      }
                    });
                    return total;
                  };

                  const getAvailableForVariation = (product, variationId) => {
                    const normalizedVariation = normalizeVariationId(variationId);
                    const variation = (product.variations || []).find((row) => normalizeVariationId(row.id) === normalizedVariation);
                    const baseAvailable = variation ? Number(variation.available) || 0 : 0;
                    const inCart = getCartQuantityForVariation(product.id, normalizedVariation);
                    const syncedReserved = syncedReservedQuantityForVariation(product.id, normalizedVariation);
                    const pendingReservation = Math.max(0, inCart - syncedReserved);
                    return Math.max(0, baseAvailable - pendingReservation);
                  };

                  const getAvailableTotal = (product) => {
                    const baseTotal = Number(product.available_total) || 0;
                    const inCart = getCartQuantityForProduct(product.id);
                    const syncedReserved = syncedReservedQuantityForProduct(product.id);
                    const pendingReservation = Math.max(0, inCart - syncedReserved);
                    return Math.max(0, baseTotal - pendingReservation);
                  };

                  const buildProductCardVariationsHtml = (product) => {
                    const variationRows = Array.isArray(product?.variations) ? product.variations : [];
                    const availableRows = variationRows.filter((variation) => getAvailableForVariation(product, variation.id) > 0);

                    if (availableRows.length === 0) {
                      return '<span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500 ring-1 ring-slate-200">Sin stock por variacion</span>';
                    }

                    const visibleRows = availableRows.slice(0, 3);
                    const extraCount = Math.max(0, availableRows.length - visibleRows.length);

                    const chips = visibleRows
                      .map((variation) => {
                        const variationName = String(variation?.name || 'Unica');
                        return `<span class="max-w-[5.5rem] truncate rounded-full bg-cyan-50 px-2 py-0.5 text-[10px] font-semibold text-cyan-700 ring-1 ring-cyan-100">${escapeHtml(variationName)}</span>`;
                      })
                      .join('');

                    if (!(extraCount > 0)) return chips;

                    return `${chips}<span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600 ring-1 ring-slate-200">+${extraCount}</span>`;
                  };

                  const compareVariationNames = (leftName, rightName) => String(leftName || 'Unica').localeCompare(
                    String(rightName || 'Unica'),
                    'es',
                    { sensitivity: 'base' }
                  );

                  const sortVariationSelectionEntries = (entries) => Array.from(entries || []).sort((left, right) => {
                    const leftHasStock = Number((Number(left?.available) || 0) > 0);
                    const rightHasStock = Number((Number(right?.available) || 0) > 0);
                    if (leftHasStock !== rightHasStock) return rightHasStock - leftHasStock;

                    const nameComparison = compareVariationNames(left?.name, right?.name);
                    if (nameComparison !== 0) return nameComparison;

                    return String(normalizeVariationId(left?.id) || '').localeCompare(String(normalizeVariationId(right?.id) || ''), 'es', { sensitivity: 'base' });
                  });

                  const sortVariationSelectionRows = (container) => {
                    if (!container) return;

                    const sortedRows = Array.from(container.querySelectorAll('[data-variation-row]')).sort((leftRow, rightRow) => {
                      const leftHasStock = Number((Number.parseInt(leftRow.dataset.variationAvailable || '0', 10) || 0) > 0);
                      const rightHasStock = Number((Number.parseInt(rightRow.dataset.variationAvailable || '0', 10) || 0) > 0);
                      if (leftHasStock !== rightHasStock) return rightHasStock - leftHasStock;

                      const nameComparison = compareVariationNames(leftRow.dataset.variationName, rightRow.dataset.variationName);
                      if (nameComparison !== 0) return nameComparison;

                      return String(normalizeVariationId(leftRow.dataset.variationId || null) || '').localeCompare(
                        String(normalizeVariationId(rightRow.dataset.variationId || null) || ''),
                        'es',
                        { sensitivity: 'base' }
                      );
                    });

                    sortedRows.forEach((row) => container.appendChild(row));
                  };

                  const applyVariationRowAvailabilityState = (row, available) => {
                    if (!row) return;

                    const isDisabled = available <= 0;
                    const nameLabel = row.querySelector('[data-variation-name-label]');
                    const metaLabel = row.querySelector('[data-variation-meta]');
                    const statusBadge = row.querySelector('[data-variation-status-badge]');
                    const qtyInput = row.querySelector('[data-variation-qty]');
                    const actionButtons = row.querySelectorAll('[data-qty-action]');

                    row.classList.toggle('border-slate-200', !isDisabled);
                    row.classList.toggle('bg-white', !isDisabled);
                    row.classList.toggle('hover:bg-slate-50', !isDisabled);
                    row.classList.toggle('border-rose-200', isDisabled);
                    row.classList.toggle('bg-rose-50/80', isDisabled);
                    row.classList.toggle('cursor-not-allowed', isDisabled);
                    row.classList.remove('opacity-50');

                    if (nameLabel) {
                      nameLabel.classList.toggle('text-slate-700', !isDisabled);
                      nameLabel.classList.toggle('text-rose-700', isDisabled);
                    }

                    if (metaLabel) {
                      metaLabel.classList.toggle('text-slate-500', !isDisabled);
                      metaLabel.classList.toggle('text-rose-600', isDisabled);
                    }

                    if (statusBadge) {
                      statusBadge.textContent = isDisabled ? 'Sin stock' : 'Disponible';
                      statusBadge.className = isDisabled
                        ? 'inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-[10px] font-bold text-rose-700 ring-1 ring-rose-200'
                        : 'inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-700 ring-1 ring-emerald-200';
                    }

                    actionButtons.forEach((button) => {
                      button.disabled = isDisabled;
                      button.classList.toggle('border-slate-200', !isDisabled);
                      button.classList.toggle('text-slate-500', !isDisabled);
                      button.classList.toggle('hover:bg-slate-50', !isDisabled);
                      button.classList.toggle('border-rose-200', isDisabled);
                      button.classList.toggle('bg-rose-100', isDisabled);
                      button.classList.toggle('text-rose-400', isDisabled);
                      button.classList.toggle('cursor-not-allowed', isDisabled);
                    });

                    if (qtyInput) {
                      qtyInput.disabled = isDisabled;
                      qtyInput.classList.toggle('border-slate-200', !isDisabled);
                      qtyInput.classList.toggle('bg-white', !isDisabled);
                      qtyInput.classList.toggle('text-slate-700', !isDisabled);
                      qtyInput.classList.toggle('border-rose-200', isDisabled);
                      qtyInput.classList.toggle('bg-rose-100', isDisabled);
                      qtyInput.classList.toggle('text-rose-500', isDisabled);
                    }
                  };

                  const syncOpenVariationSelectionModal = () => {
                    if (!window.Swal || typeof window.Swal.getHtmlContainer !== 'function') return;

                    const dialog = window.Swal.getHtmlContainer();
                    if (!dialog) return;

                    const modalRoot = dialog.querySelector('[data-variation-modal-product-id]');
                    if (!modalRoot) return;

                    const rowsContainer = modalRoot.querySelector('[data-variation-modal-list]');

                    const modalProductId = modalRoot.dataset.variationModalProductId;
                    const modalProduct = productsById.get(String(modalProductId));
                    if (!modalProduct) return;

                    dialog.querySelectorAll('[data-variation-row]').forEach((row) => {
                      const variationId = normalizeVariationId(row.dataset.variationId || null);
                      const available = getAvailableForVariation(modalProduct, variationId);
                      row.dataset.variationAvailable = String(available);

                      const qtyInput = row.querySelector('[data-variation-qty]');
                      const availableLabel = row.querySelector('[data-variation-available-label]');
                      applyVariationRowAvailabilityState(row, available);

                      if (!qtyInput) return;

                      let selected = Number.parseInt(String(qtyInput.value || '').replace(/\D/g, ''), 10) || 0;
                      selected = Math.min(Math.max(selected, 0), available);
                      qtyInput.value = selected > 0 ? String(selected) : '0';

                      if (availableLabel) {
                        const remaining = Math.max(0, available - selected);
                        availableLabel.textContent = formatNumber(remaining, 0);
                      }
                    });

                    sortVariationSelectionRows(rowsContainer || dialog);
                  };

                  const updateProductCardMeta = () => {
                    document.querySelectorAll('.ventas-product-card').forEach((card) => {
                      const productId = card.dataset.productId;
                      const product = productsById.get(String(productId));
                      if (!product) return;

                      const variationRows = Array.isArray(product.variations) ? product.variations : [];
                      const availableVariationCount = variationRows.filter((variation) => getAvailableForVariation(product, variation.id) > 0).length;

                      const variationCountEl = card.querySelector(`[data-product-variation-count="${productId}"]`);
                      if (variationCountEl) {
                        variationCountEl.textContent = `${availableVariationCount} var.`;
                      }

                      const variationsEl = card.querySelector(`[data-product-variations="${productId}"]`);
                      if (variationsEl) {
                        variationsEl.innerHTML = buildProductCardVariationsHtml(product);
                      }

                      const unitPriceUsd = Number(product.price_usd) || 0;

                      const priceUsdEl = card.querySelector(`[data-product-price-usd="${productId}"]`);
                      if (priceUsdEl) {
                        priceUsdEl.textContent = formatMoney(unitPriceUsd, '$');
                      }

                      const priceBsEl = card.querySelector(`[data-product-price-bs="${productId}"]`);
                      if (priceBsEl) {
                        priceBsEl.textContent = bcvRate > 0 ? formatMoney(unitPriceUsd * bcvRate, 'Bs ') : 'Bs --';
                      }
                    });
                  };

                  const updateAvailabilityUI = () => {
                    document.querySelectorAll('[data-product-stock]').forEach((el) => {
                      const productId = el.dataset.productStock;
                      const product = productsById.get(String(productId));
                      if (!product) return;
                      el.textContent = formatNumber(getAvailableTotal(product), 0);
                    });

                    updateProductCardMeta();
                    updateProductCardStates();
                    syncOpenVariationSelectionModal();
                  };

                  const updateProductCardStates = () => {
                    document.querySelectorAll('.ventas-product-card').forEach((card) => {
                      const productId = card.dataset.productId;
                      const product = productsById.get(String(productId));
                      if (!product) return;

                      const inCart = getCartQuantityForProduct(productId) > 0;
                      const available = getAvailableTotal(product);
                      const outOfStock = available <= 0;

                      card.classList.toggle('ring-2', inCart);
                      card.classList.toggle('ring-cyan-300', inCart);
                      card.classList.toggle('border-cyan-300', inCart);
                      card.classList.toggle('border-rose-300', outOfStock);
                      card.classList.toggle('ring-1', outOfStock);
                      card.classList.toggle('ring-rose-200', outOfStock);
                      card.classList.toggle('opacity-70', outOfStock);
                      card.classList.toggle('cursor-not-allowed', outOfStock);

                      const overlay = card.querySelector('[data-out-of-stock]');
                      if (overlay) {
                        overlay.classList.toggle('hidden', !outOfStock);
                        overlay.classList.toggle('flex', outOfStock);
                      }
                    });
                  };

                  const initSearchTabs = () => {
                    const searchInput = document.getElementById('ventas-item-search');
                    const clearButton = document.getElementById('ventas-item-search-clear');
                    const productPanel = document.getElementById('ventas-product-panel');
                    const servicePanel = document.getElementById('ventas-service-panel');
                    const tabButtons = Array.from(root.querySelectorAll('[data-ventas-tab]'));
                    const categoryButtons = Array.from(root.querySelectorAll('[data-product-category-filter]'));
                    const serviceSystemButtons = Array.from(root.querySelectorAll('[data-service-system-filter]'));
                    if (!searchInput || !clearButton || !productPanel || !servicePanel) return;

                    let activeTab = 'products';
                    let activeProductCategory = '';
                    let activeServiceSystem = '';

                    const applySearch = () => {
                      const query = normalizeSearchValue(searchInput.value);
                      clearButton.classList.toggle('hidden', query.length === 0);

                      document.querySelectorAll('[data-product-query]').forEach((card) => {
                        const cardValue = normalizeSearchValue(card.dataset.productQuery);
                        const cardCategory = normalizeSearchValue(card.dataset.productCategory || '');
                        const matchesCategory = activeProductCategory.length === 0 || cardCategory === activeProductCategory;
                        card.classList.toggle('hidden', (query.length > 0 && !cardValue.includes(query)) || !matchesCategory);
                      });

                      document.querySelectorAll('[data-service-query]').forEach((card) => {
                        const cardValue = normalizeSearchValue(card.dataset.serviceQuery);
                        const cardSystem = normalizeSearchValue(card.dataset.serviceSystem || '');
                        const matchesSystem = activeServiceSystem.length === 0 || cardSystem === activeServiceSystem;
                        card.classList.toggle('hidden', (query.length > 0 && !cardValue.includes(query)) || !matchesSystem);
                      });
                    };

                    const updateTabStyles = () => {
                      tabButtons.forEach((button) => {
                        const isActive = button.dataset.ventasTab === activeTab;
                        button.classList.toggle('bg-sky-600', isActive);
                        button.classList.toggle('text-white', isActive);
                        button.classList.toggle('border-sky-600', isActive);
                        button.classList.toggle('shadow-lg', isActive);
                        button.classList.toggle('shadow-sky-200', isActive);
                        button.classList.toggle('hover:bg-sky-700', isActive);
                        button.classList.toggle('hover:text-white', isActive);
                        button.classList.toggle('bg-white', !isActive);
                        button.classList.toggle('text-slate-600', !isActive);
                        button.classList.toggle('border-slate-200', !isActive);
                        button.classList.toggle('hover:bg-slate-50', !isActive);
                        button.classList.toggle('hover:text-slate-700', !isActive);
                      });
                    };

                    const updateCategoryFilterStyles = () => {
                      categoryButtons.forEach((button) => {
                        const categoryValue = normalizeSearchValue(button.dataset.productCategoryFilter || '');
                        const isActive = categoryValue === activeProductCategory;

                        button.classList.toggle('bg-sky-600', isActive);
                        button.classList.toggle('text-white', isActive);
                        button.classList.toggle('border-sky-600', isActive);
                        button.classList.toggle('shadow-sm', isActive);
                        button.classList.toggle('hover:bg-sky-700', isActive);
                        button.classList.toggle('hover:text-white', isActive);
                        button.classList.toggle('bg-white', !isActive);
                        button.classList.toggle('text-cyan-700', !isActive);
                        button.classList.toggle('border-cyan-200', !isActive);
                        button.classList.toggle('ring-1', !isActive);
                        button.classList.toggle('ring-cyan-200', !isActive);
                        button.classList.toggle('hover:bg-cyan-50', !isActive);
                        button.classList.toggle('hover:text-cyan-700', !isActive);
                      });
                    };

                    const updateServiceSystemFilterStyles = () => {
                      serviceSystemButtons.forEach((button) => {
                        const systemValue = normalizeSearchValue(button.dataset.serviceSystemFilter || '');
                        const isActive = systemValue === activeServiceSystem;

                        button.classList.toggle('bg-sky-600', isActive);
                        button.classList.toggle('text-white', isActive);
                        button.classList.toggle('border-sky-600', isActive);
                        button.classList.toggle('shadow-sm', isActive);
                        button.classList.toggle('hover:bg-sky-700', isActive);
                        button.classList.toggle('hover:text-white', isActive);
                        button.classList.toggle('bg-white', !isActive);
                        button.classList.toggle('text-cyan-700', !isActive);
                        button.classList.toggle('border-cyan-200', !isActive);
                        button.classList.toggle('ring-1', !isActive);
                        button.classList.toggle('ring-cyan-200', !isActive);
                        button.classList.toggle('hover:bg-cyan-50', !isActive);
                        button.classList.toggle('hover:text-cyan-700', !isActive);
                      });
                    };

                    const setActiveTab = (tab) => {
                      activeTab = tab === 'services' ? 'services' : 'products';
                      productPanel.classList.toggle('hidden', activeTab !== 'products');
                      servicePanel.classList.toggle('hidden', activeTab !== 'services');
                      updateTabStyles();
                      applySearch();
                    };

                    searchInput.addEventListener('input', applySearch);
                    clearButton.addEventListener('click', () => {
                      searchInput.value = '';
                      applySearch();
                      searchInput.focus();
                    });

                    tabButtons.forEach((button) => {
                      button.addEventListener('click', () => {
                        setActiveTab(button.dataset.ventasTab);
                      });
                    });

                    categoryButtons.forEach((button) => {
                      button.addEventListener('click', () => {
                        activeProductCategory = normalizeSearchValue(button.dataset.productCategoryFilter || '');
                        updateCategoryFilterStyles();
                        applySearch();
                      });
                    });

                    serviceSystemButtons.forEach((button) => {
                      button.addEventListener('click', () => {
                        activeServiceSystem = normalizeSearchValue(button.dataset.serviceSystemFilter || '');
                        updateServiceSystemFilterStyles();
                        applySearch();
                      });
                    });

                    updateCategoryFilterStyles();
                    updateServiceSystemFilterStyles();
                    setActiveTab(activeTab);
                  };

                  initSearchTabs();

                  const renderTotals = () => {
                    let subtotalBase = 0;
                    const vatMode = getVatMode();

                    cart.forEach((item) => {
                      const itemType = item.itemType || 'product';
                      if (itemType === 'service') {
                        const service = servicesById.get(String(item.serviceId));
                        if (!service) return;
                        const pricing = computeServicePricing(service, item);
                        if (!(pricing.unitDisplay > 0)) return;
                        subtotalBase = roundTo(subtotalBase + pricing.lineNet, 2);
                        return;
                      }

                      const product = productsById.get(String(item.productId));
                      if (!product) return;
                      const pricing = computePricing(product.price_usd, item.quantity);
                      subtotalBase = roundTo(subtotalBase + pricing.lineNet, 2);
                    });

                    const vatBase = vatMode === 'none' ? 0 : roundTo(subtotalBase * vatRate, 2);
                    const totalBase = roundTo(subtotalBase + vatBase, 2);

                    const setText = (id, value) => {
                      const el = document.getElementById(id);
                      if (el) el.textContent = value;
                    };

                    setText('ventas-subtotal-usd', formatBaseMoney(subtotalBase));
                    setText('ventas-subtotal-bs', formatAltFromBase(subtotalBase));
                    setText('ventas-iva-usd', formatBaseMoney(vatBase));
                    setText('ventas-iva-bs', formatAltFromBase(vatBase));
                    setText('ventas-total-usd', formatBaseMoney(totalBase));
                    setText('ventas-total-bs', formatAltFromBase(totalBase));

                    const ivaLabel = document.getElementById('ventas-iva-label');
                    if (ivaLabel) {
                      ivaLabel.textContent = vatMode === 'none' ? 'IVA' : 'IVA 16%';
                    }
                  };

                  const renderCart = () => {
                    const cartList = document.getElementById('ventas-cart-list');
                    const emptyState = document.getElementById('ventas-cart-empty');
                    const payButton = document.getElementById('ventas-pay-button');
                    if (!cartList || !emptyState) return;

                    if (cart.size === 0) {
                      cartList.innerHTML = '';
                      emptyState.classList.remove('hidden');
                      if (payButton) {
                        payButton.classList.add('opacity-60', 'cursor-not-allowed');
                        payButton.disabled = true;
                      }
                      updateDraftActionButtons();
                      renderTotals();
                      updateAvailabilityUI();
                      queueActiveDraftSync();
                      return;
                    }

                    emptyState.classList.add('hidden');
                    if (payButton) {
                      if (hasOpenCashShift) {
                        payButton.classList.remove('opacity-60', 'cursor-not-allowed');
                        payButton.disabled = false;
                      } else {
                        payButton.classList.add('opacity-60', 'cursor-not-allowed');
                        payButton.disabled = true;
                      }
                    }

                    updateDraftActionButtons();

                    const itemsHtml = Array.from(cart.entries()).map(([key, item]) => {
                      const itemType = item.itemType || 'product';
                      if (itemType === 'service') {
                        const service = servicesById.get(String(item.serviceId));
                        if (!service) return '';
                        const pricing = computeServicePricing(service, item);
                        if (!(pricing.unitDisplay > 0)) return '';
                        const displayName = service.system_name
                          ? `${service.name} · ${service.system_name}`.trim()
                          : service.name;
                        const agreedReference = service.price_on_request && item.agreed_reference_name
                          ? ` · ${escapeHtml(item.agreed_reference_name)}`
                          : '';
                        const agreedDisplay = service.price_on_request && item.agreed_price_display
                          ? ` · Acordado: ${escapeHtml(item.agreed_price_display)}`
                          : '';

                        return `
                          <div class="rounded-xl border border-slate-200 bg-white px-3 py-3" data-cart-key="${key}">
                            <div class="flex items-start justify-between gap-2">
                              <div class="min-w-0 flex-1">
                                <p class="text-sm font-semibold text-slate-700 truncate">${escapeHtml(displayName)}</p>
                                <p class="mt-1 text-[11px] text-slate-400">Servicio${service.price_on_request ? ` (a convenir${agreedReference})` : ''} · Unit: ${formatBaseMoney(pricing.unitDisplay)} · ${formatAltFromBase(pricing.unitDisplay)}${agreedDisplay}</p>
                              </div>
                              <button type="button" class="text-slate-300 hover:text-red-500" data-cart-action="remove" data-cart-key="${key}">
                                <i data-lucide="x" class="w-4 h-4"></i>
                              </button>
                            </div>
                            <div class="mt-3 flex items-center justify-between">
                              <div class="flex items-center gap-2">
                                <button type="button" class="h-7 w-7 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" data-cart-action="decrease" data-cart-key="${key}">-</button>
                                <span class="text-sm font-semibold text-slate-700">${formatNumber(item.quantity, 0)}</span>
                                <button type="button" class="h-7 w-7 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" data-cart-action="increase" data-cart-key="${key}">+</button>
                              </div>
                              <div class="text-right">
                                <p class="text-sm font-bold text-slate-700">${formatBaseMoney(pricing.lineTotal)}</p>
                                <p class="text-[11px] text-slate-400">${formatAltFromBase(pricing.lineTotal)}</p>
                              </div>
                            </div>
                          </div>
                        `;
                      }

                      const product = productsById.get(String(item.productId));
                      if (!product) return '';

                      const pricing = computePricing(product.price_usd, item.quantity);
                      const variation = (product.variations || []).find((row) => normalizeVariationId(row.id) === normalizeVariationId(item.variationId));
                      const variationName = variation ? variation.name : 'Unica';
                      const displayName = `${product.name} ${variationName}`.trim();

                      return `
                        <div class="rounded-xl border border-slate-200 bg-white px-3 py-3" data-cart-key="${key}">
                          <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                              <p class="text-sm font-semibold text-slate-700 truncate">${escapeHtml(displayName)}</p>
                              <p class="mt-1 text-[11px] text-slate-400">Unit: ${formatBaseMoney(pricing.unitDisplay)} · ${formatAltFromBase(pricing.unitDisplay)}</p>
                            </div>
                            <button type="button" class="text-slate-300 hover:text-red-500" data-cart-action="remove" data-cart-key="${key}">
                              <i data-lucide="x" class="w-4 h-4"></i>
                            </button>
                          </div>
                          <div class="mt-3 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                              <button type="button" class="h-7 w-7 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" data-cart-action="decrease" data-cart-key="${key}">-</button>
                              <span class="text-sm font-semibold text-slate-700">${formatNumber(item.quantity, 0)}</span>
                              <button type="button" class="h-7 w-7 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" data-cart-action="increase" data-cart-key="${key}">+</button>
                            </div>
                            <div class="text-right">
                              <p class="text-sm font-bold text-slate-700">${formatBaseMoney(pricing.lineTotal)}</p>
                              <p class="text-[11px] text-slate-400">${formatAltFromBase(pricing.lineTotal)}</p>
                            </div>
                          </div>
                        </div>
                      `;
                    }).join('');

                    cartList.innerHTML = itemsHtml;
                    renderTotals();
                    updateAvailabilityUI();

                    if (window.lucide && typeof window.lucide.createIcons === 'function') {
                      window.lucide.createIcons();
                    }

                    queueActiveDraftSync();
                  };

                  const addToCart = (productId, variationId, quantity) => {
                    const product = productsById.get(String(productId));
                    if (!product) return;

                    const normalizedVariation = normalizeVariationId(variationId);

                    const available = getAvailableForVariation(product, normalizedVariation);
                    if (quantity > available) {
                      if (window.Swal) {
                        window.Swal.fire({
                          icon: 'warning',
                          title: 'Stock insuficiente',
                          text: `Disponible: ${formatNumber(available, 0)}`,
                          heightAuto: false,
                        });
                      }
                      return;
                    }

                    const key = buildKey('product', productId, normalizedVariation);
                    const existing = cart.get(key) || {
                      itemType: 'product',
                      productId: String(productId),
                      variationId: normalizedVariation,
                      quantity: 0,
                    };

                    existing.quantity += quantity;
                    cart.set(key, existing);
                    renderCart();
                  };

                  const addServiceToCart = (serviceId, quantity) => {
                    const service = servicesById.get(String(serviceId));
                    if (!service) return;

                    const resolvedUnitPriceUsd = resolveServiceUnitPriceUsd(service, {
                      unit_price_usd: service.price_usd,
                    });

                    if (!(resolvedUnitPriceUsd > 0)) {
                      if (window.Swal) {
                        window.Swal.fire({
                          icon: 'warning',
                          title: 'Precio no disponible',
                          text: service.price_on_request
                            ? 'Debes indicar un precio acordado para este servicio.'
                            : 'Este servicio no tiene tasa disponible para facturar.',
                          heightAuto: false,
                        });
                      }
                      return;
                    }

                    const key = buildKey('service', serviceId, null);
                    const existing = cart.get(key) || {
                      itemType: 'service',
                      serviceId: String(serviceId),
                      quantity: 0,
                      unit_price_usd: resolvedUnitPriceUsd,
                      nested_agreements: [],
                      consumable_decisions: [],
                    };

                    if (!Array.isArray(existing.nested_agreements)) existing.nested_agreements = [];
                    if (!Array.isArray(existing.consumable_decisions)) existing.consumable_decisions = [];
                    existing.unit_price_usd = resolvedUnitPriceUsd;
                    existing.quantity += quantity;
                    cart.set(key, existing);
                    renderCart();
                  };

                  const promptServicePriceOnRequest = async (service) => {
                    if (!window.Swal) return null;

                    const referenceName = normalizeServiceReferenceName(service);
                    const referenceSymbol = resolveServiceReferenceSymbol(service, referenceName);
                    const invoiceCurrencyCode = currentBaseCurrencyCode();
                    const invoiceLabel = invoiceCurrencyCode === 'VES' ? 'Bs' : 'USD';
                    const amountInputId = `ventas-agree-amount-${service.id}`;
                    const quantityInputId = `ventas-agree-quantity-${service.id}`;
                    const previewId = `ventas-agree-preview-${service.id}`;

                    const modalHtml = `
                      <div class="space-y-3 text-left">
                        <p class="text-sm text-slate-500">${escapeHtml(service.name || 'Servicio')}</p>
                        <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700">
                          <p>Moneda base del servicio: <strong>${escapeHtml(referenceName)}</strong></p>
                          <p>Factura actual en: <strong>${invoiceLabel}</strong></p>
                        </div>
                        <div class="grid gap-2 sm:grid-cols-2">
                          <label class="space-y-1 text-xs font-semibold uppercase tracking-wide text-slate-500">
                            <span>Monto (${escapeHtml(referenceSymbol)})</span>
                            <input id="${amountInputId}" type="text" inputmode="decimal" autocomplete="off"
                              class="w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                              placeholder="${escapeHtml(referenceSymbol)} 0,00" data-money-mask="true" data-money-symbol="${escapeHtml(referenceSymbol)}">
                          </label>
                          <label class="space-y-1 text-xs font-semibold uppercase tracking-wide text-slate-500">
                            <span>Cantidad</span>
                            <input id="${quantityInputId}" type="number" min="1" step="1" inputmode="numeric"
                              class="w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                              value="1">
                          </label>
                        </div>
                        <p id="${previewId}" class="text-xs text-slate-500"></p>
                      </div>
                    `;

                    const updatePreview = (dialog) => {
                      const amountInput = dialog.querySelector(`#${amountInputId}`);
                      const quantityInput = dialog.querySelector(`#${quantityInputId}`);
                      const previewEl = dialog.querySelector(`#${previewId}`);
                      if (!amountInput || !quantityInput || !previewEl) return;

                      const rawAmount = parseMoneyInput(amountInput);
                      const rawQuantity = Number.parseInt(String(quantityInput.value || '').replace(/\D/g, ''), 10);
                      if (!(Number.isFinite(rawAmount) && rawAmount > 0) || !(Number.isInteger(rawQuantity) && rawQuantity > 0)) {
                        previewEl.textContent = 'Ingresa monto y cantidad para ver el total estimado.';
                        return;
                      }

                      const computed = computeOnRequestServiceAmounts({
                        service,
                        referenceAmount: rawAmount,
                      });
                      if (computed.error) {
                        previewEl.textContent = computed.error;
                        return;
                      }

                      const lineTotal = roundTo(computed.invoiceUnitAmount * rawQuantity, 2);
                      previewEl.textContent = `Se agregara ${rawQuantity} x ${computed.priceDisplay} = ${formatCurrencyValue(lineTotal, computed.invoiceCurrencyCode)}`;
                    };

                    const result = await window.Swal.fire({
                      title: 'Precio a convenir',
                      html: modalHtml,
                      showCancelButton: true,
                      confirmButtonText: 'Agregar',
                      cancelButtonText: 'Cancelar',
                      heightAuto: false,
                      didOpen: () => {
                        const dialog = window.Swal.getHtmlContainer();
                        if (!dialog) return;

                        const amountInput = dialog.querySelector(`#${amountInputId}`);
                        const quantityInput = dialog.querySelector(`#${quantityInputId}`);
                        initMoneyMasks(dialog);

                        if (amountInput) amountInput.addEventListener('input', () => updatePreview(dialog));
                        if (quantityInput) {
                          quantityInput.addEventListener('input', () => updatePreview(dialog));
                          quantityInput.addEventListener('blur', () => {
                            const parsed = Number.parseInt(String(quantityInput.value || '').replace(/\D/g, ''), 10);
                            quantityInput.value = Number.isInteger(parsed) && parsed > 0 ? String(parsed) : '1';
                            updatePreview(dialog);
                          });
                        }

                        updatePreview(dialog);
                      },
                      preConfirm: () => {
                        const dialog = window.Swal.getHtmlContainer();
                        if (!dialog) return null;

                        const amountInput = dialog.querySelector(`#${amountInputId}`);
                        const quantityInput = dialog.querySelector(`#${quantityInputId}`);

                        const numeric = parseMoneyInput(amountInput);
                        if (!Number.isFinite(numeric) || numeric <= 0) {
                          window.Swal.showValidationMessage('Indica un precio valido mayor a 0.');
                          return null;
                        }

                        const quantity = Number.parseInt(String(quantityInput?.value || '').replace(/\D/g, ''), 10);
                        if (!Number.isInteger(quantity) || quantity <= 0) {
                          window.Swal.showValidationMessage('Indica una cantidad valida mayor a 0.');
                          return null;
                        }

                        const computed = computeOnRequestServiceAmounts({
                          service,
                          referenceAmount: numeric,
                        });

                        if (computed.error) {
                          window.Swal.showValidationMessage(computed.error);
                          return null;
                        }

                        return {
                          ...computed,
                          quantity,
                        };
                      },
                    });

                    if (!result.isConfirmed) return null;
                    return result.value || null;
                  };

                  const promptNestedToAgreeCostsForItem = async (item, service) => {
                    const rows = Array.isArray(service?.nested_to_agree_costs) ? service.nested_to_agree_costs : [];

                    if (rows.length === 0) {
                      item.nested_agreements = [];
                      return true;
                    }

                    const existingByExpenseId = new Map(
                      (Array.isArray(item.nested_agreements) ? item.nested_agreements : [])
                        .map((row) => [String(row.nested_expense_id || ''), row])
                    );

                    if (!window.Swal) {
                      item.nested_agreements = rows.map((row) => {
                        const expenseId = String(row.expense_id || '');
                        const existing = existingByExpenseId.get(expenseId) || {};
                        return {
                          nested_expense_id: expenseId,
                          amount_reference: Number(existing.amount_reference) > 0
                            ? Number(existing.amount_reference)
                            : Number(row.default_amount_reference || 0),
                          currency_reference: String(existing.currency_reference || row.reference_name || 'Bs'),
                        };
                      }).filter((row) => row.nested_expense_id && Number(row.amount_reference) > 0);
                      return item.nested_agreements.length === rows.length;
                    }

                    const title = service?.name ? `Costos a convenir (${service.name})` : 'Costos a convenir anidados';

                    const html = rows.map((row, index) => {
                      const expenseId = String(row.expense_id || '');
                      const amountId = `nested-agree-${expenseId || index}`;
                      const existing = existingByExpenseId.get(expenseId) || {};
                      const defaultAmount = Number(existing.amount_reference) > 0
                        ? Number(existing.amount_reference)
                        : Number(row.default_amount_reference || 0);
                      const quantityMultiplier = roundTo((Number(item.quantity || 0) || 0) * (Number(row.quantity || 0) || 0), 2);
                      const referenceSymbol = String(row.reference_symbol || '$');
                      const nestedName = escapeHtml(String(row.nested_service_name || 'Servicio anidado'));
                      const structureName = escapeHtml(String(row.structure_name || 'Sin estructura'));
                      const referenceName = escapeHtml(String(row.reference_name || 'Bs'));
                      return `
                        <div class="rounded-xl border border-cyan-200 bg-cyan-50/70 p-3 text-left" data-nested-agree-row="${escapeHtml(expenseId)}">
                          <p class="text-xs font-semibold text-cyan-700">${structureName}</p>
                          <p class="text-sm font-semibold text-slate-800">${nestedName}</p>
                          <p class="text-xs text-slate-500">Cantidad aplicada en esta venta: ${formatNumber(quantityMultiplier, 2)} · Referencia: ${referenceName}</p>
                          <input id="${amountId}" type="text" inputmode="decimal" autocomplete="off"
                            class="mt-2 w-full rounded-lg border border-cyan-200 bg-white px-3 py-2 text-sm text-slate-700"
                            placeholder="${escapeHtml(referenceSymbol)} 0,00"
                            value="${defaultAmount > 0 ? formatCurrencyValue(defaultAmount, 'USD').replace('$', referenceSymbol).trim() : ''}"
                            data-money-mask="true" data-money-symbol="${escapeHtml(referenceSymbol)}" data-nested-agree-input="${escapeHtml(expenseId)}">
                        </div>
                      `;
                    }).join('');

                    const result = await window.Swal.fire({
                      title,
                      html: `<div class="space-y-2">${html}</div>`,
                      showCancelButton: true,
                      confirmButtonText: 'Guardar costos',
                      cancelButtonText: 'Cancelar',
                      heightAuto: false,
                      didOpen: () => {
                        const dialog = window.Swal.getHtmlContainer();
                        if (!dialog) return;
                        initMoneyMasks(dialog);
                      },
                      preConfirm: () => {
                        const dialog = window.Swal.getHtmlContainer();
                        if (!dialog) return null;

                        const collected = [];
                        let hasError = false;

                        rows.forEach((row, index) => {
                          if (hasError) return;
                          const expenseId = String(row.expense_id || '');
                          const amountId = `nested-agree-${expenseId || index}`;
                          const input = dialog.querySelector(`#${amountId}`);
                          const amount = parseMoneyInput(input);
                          if (!(amount > 0)) {
                            hasError = true;
                            window.Swal.showValidationMessage('Indica un monto valido mayor a 0 para cada servicio anidado a convenir.');
                            return;
                          }

                          collected.push({
                            nested_expense_id: expenseId,
                            amount_reference: roundTo(amount, 2),
                            currency_reference: String(row.reference_name || 'Bs'),
                          });
                        });

                        if (hasError) return null;
                        return collected;
                      },
                    });

                    if (!result.isConfirmed) return false;

                    item.nested_agreements = Array.isArray(result.value) ? result.value : [];
                    return true;
                  };

                  const promptConsumableDeliveryForItem = async (item, service) => {
                    const rows = Array.isArray(service?.consumable_costs) ? service.consumable_costs : [];

                    if (rows.length === 0) {
                      item.consumable_decisions = [];
                      return true;
                    }

                    const existingByExpenseId = new Map(
                      (Array.isArray(item.consumable_decisions) ? item.consumable_decisions : [])
                        .map((row) => [String(row.service_product_expense_id || ''), row])
                    );

                    if (!window.Swal) {
                      item.consumable_decisions = rows.map((row) => ({
                        service_product_expense_id: String(row.expense_id || ''),
                        delivered: existingByExpenseId.get(String(row.expense_id || ''))?.delivered !== false,
                        product_variation_id: row.variation_id,
                      }));
                      return true;
                    }

                    const title = service?.name ? `Entrega de consumibles (${service.name})` : 'Entrega de consumibles';

                    const html = rows.map((row, index) => {
                      const expenseId = String(row.expense_id || '');
                      const deliveredDefault = existingByExpenseId.get(expenseId)?.delivered !== false;
                      const structureName = escapeHtml(String(row.structure_name || 'Sin estructura'));
                      const productName = escapeHtml(String(row.product_name || 'Producto'));
                      const variationName = escapeHtml(String(row.variation_name || 'Variacion'));
                      const quantityValue = roundTo((Number(item.quantity || 0) || 0) * (Number(row.quantity || 0) || 0), 2);

                      return `
                        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3" data-consumable-row="${escapeHtml(expenseId)}">
                          <div class="flex items-start justify-between gap-2">
                            <div>
                              <p class="text-xs font-semibold text-slate-500">${structureName}</p>
                              <p class="text-sm font-semibold text-slate-800">${productName} (${variationName})</p>
                              <p class="text-xs text-slate-500">Cantidad esperada: ${formatNumber(quantityValue, 2)}</p>
                            </div>
                            <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100" title="Omitir" data-consumable-omit="${escapeHtml(expenseId)}">x</button>
                          </div>
                          <label class="mt-2 inline-flex items-center gap-2 text-xs font-semibold text-slate-700">
                            <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-emerald-600" data-consumable-delivered="${escapeHtml(expenseId)}" ${deliveredDefault ? 'checked' : ''}>
                            Entregado
                          </label>
                        </div>
                      `;
                    }).join('');

                    const result = await window.Swal.fire({
                      title,
                      html: `<div class="space-y-2 text-left">${html}</div>`,
                      showCancelButton: true,
                      confirmButtonText: 'Guardar decision',
                      cancelButtonText: 'Cancelar',
                      heightAuto: false,
                      didOpen: () => {
                        const dialog = window.Swal.getHtmlContainer();
                        if (!dialog) return;

                        dialog.querySelectorAll('[data-consumable-omit]').forEach((button) => {
                          button.addEventListener('click', () => {
                            const expenseId = button.dataset.consumableOmit;
                            const checkbox = dialog.querySelector(`[data-consumable-delivered="${expenseId}"]`);
                            if (!checkbox) return;
                            checkbox.checked = false;
                          });
                        });
                      },
                      preConfirm: () => {
                        const dialog = window.Swal.getHtmlContainer();
                        if (!dialog) return null;

                        return rows.map((row) => {
                          const expenseId = String(row.expense_id || '');
                          const delivered = Boolean(dialog.querySelector(`[data-consumable-delivered="${expenseId}"]`)?.checked);

                          return {
                            service_product_expense_id: expenseId,
                            delivered,
                            product_variation_id: row.variation_id,
                          };
                        });
                      },
                    });

                    if (!result.isConfirmed) return false;

                    item.consumable_decisions = Array.isArray(result.value) ? result.value : [];
                    return true;
                  };

                  const ensureServiceCheckoutDecisions = async () => {
                    const serviceEntries = Array.from(cart.entries()).filter(([, item]) => item.itemType === 'service');

                    for (const [key, item] of serviceEntries) {
                      const service = servicesById.get(String(item.serviceId));
                      if (!service || !service.auto_cost_stock_discount) continue;

                      const nestedReady = await promptNestedToAgreeCostsForItem(item, service);
                      if (!nestedReady) return false;

                      const consumableReady = await promptConsumableDeliveryForItem(item, service);
                      if (!consumableReady) return false;

                      cart.set(key, item);
                    }

                    return true;
                  };

                  const updateQuantity = (key, delta) => {
                    const item = cart.get(key);
                    if (!item) return;

                    const itemType = item.itemType || 'product';
                    if (itemType === 'product') {
                      const product = productsById.get(String(item.productId));
                      if (!product) return;

                      if (delta > 0) {
                        const available = getAvailableForVariation(product, item.variationId);
                        if (available <= 0) {
                          if (window.Swal) {
                            window.Swal.fire({
                              icon: 'warning',
                              title: 'Stock insuficiente',
                              text: 'No hay unidades disponibles para esta variacion.',
                              heightAuto: false,
                            });
                          }
                          return;
                        }
                      }
                    }

                    item.quantity = Math.max(0, Number(item.quantity) + delta);
                    if (item.quantity <= 0) {
                      cart.delete(key);
                    } else {
                      cart.set(key, item);
                    }
                    renderCart();
                  };

                  const promptAddProduct = (productId) => {
                    const product = productsById.get(String(productId));
                    if (!product) return;

                    const variations = product.variations && product.variations.length > 0
                      ? product.variations
                      : [{ id: null, name: 'Unica', available: Number(product.available_total) || 0 }];

                    const availableEntries = sortVariationSelectionEntries(variations.map((variation) => {
                      const available = getAvailableForVariation(product, variation.id);
                      return {
                        id: variation.id,
                        name: variation.name,
                        available: available,
                      };
                    }));

                    const hasStock = availableEntries.some((entry) => entry.available > 0);
                    if (!hasStock) {
                      if (window.Swal) {
                        window.Swal.fire({
                          icon: 'warning',
                          title: 'Sin stock',
                          text: 'No hay unidades disponibles para este producto.',
                          heightAuto: false,
                        });
                      }
                      return;
                    }

                    const optionsHtml = availableEntries
                      .map((entry) => {
                        const disabled = entry.available <= 0;
                        const valueAttr = entry.id === null ? '' : entry.id;
                        const rowClass = disabled
                          ? 'border-rose-200 bg-rose-50/80 cursor-not-allowed'
                          : 'border-slate-200 bg-white hover:bg-slate-50';
                        const titleClass = disabled ? 'text-rose-700' : 'text-slate-700';
                        const metaClass = disabled ? 'text-rose-600' : 'text-slate-500';
                        const badgeClass = disabled
                          ? 'bg-rose-100 text-rose-700 ring-1 ring-rose-200'
                          : 'bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200';
                        const controlButtonClass = disabled
                          ? 'border-rose-200 bg-rose-100 text-rose-400 cursor-not-allowed'
                          : 'border-slate-200 text-slate-500 hover:bg-slate-50';
                        const inputClass = disabled
                          ? 'border-rose-200 bg-rose-100 text-rose-500'
                          : 'border-slate-200 bg-white text-slate-700';
                        return `
                          <div class="flex items-center justify-between gap-3 rounded-lg border px-3 py-2 ${rowClass}" data-variation-row data-variation-id="${valueAttr}" data-variation-name="${escapeHtml(entry.name)}" data-variation-available="${entry.available}">
                            <div class="min-w-0">
                              <div class="flex flex-wrap items-center gap-2">
                                <p class="text-sm font-semibold truncate ${titleClass}" data-variation-name-label>${escapeHtml(entry.name)}</p>
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold ${badgeClass}" data-variation-status-badge>${disabled ? 'Sin stock' : 'Disponible'}</span>
                              </div>
                              <p class="text-xs ${metaClass}" data-variation-meta>Disp: <span data-variation-available-label>${formatNumber(entry.available, 0)}</span></p>
                            </div>
                            <div class="grid grid-cols-[1.75rem_2.5rem_1.75rem] items-center gap-2">
                              <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-lg border ${controlButtonClass}" data-qty-action="decrease" ${disabled ? 'disabled' : ''}>-</button>
                              <input type="text" inputmode="numeric" pattern="[0-9]*" value="0" ${disabled ? 'disabled' : ''}
                                class="w-10 rounded-lg border px-1 py-1 text-center text-sm font-semibold ${inputClass}" data-variation-qty>
                              <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-lg border ${controlButtonClass}" data-qty-action="increase" ${disabled ? 'disabled' : ''}>+</button>
                            </div>
                          </div>
                        `;
                      })
                      .join('');

                    const modalHtml = `
                      <div class="space-y-3 text-left" data-variation-modal-product-id="${product.id}">
                        <p class="text-sm text-slate-500">${escapeHtml(product.name)}</p>
                        <p class="text-xs text-slate-400">Agrega cantidades por variacion para incluir varias en una sola vez.</p>
                        <div class="space-y-2" data-variation-modal-list>${optionsHtml}</div>
                      </div>
                    `;

                    window.Swal.fire({
                      title: 'Selecciona variacion',
                      html: modalHtml,
                      showCancelButton: true,
                      confirmButtonText: 'Agregar',
                      cancelButtonText: 'Cancelar',
                      heightAuto: false,
                      didOpen: () => {
                        const dialog = window.Swal.getHtmlContainer();
                        if (!dialog) return;

                        const updateAvailableLabel = (row, available, selected) => {
                          const label = row.querySelector('[data-variation-available-label]');
                          if (!label) return;

                          const remaining = Math.max(0, available - selected);
                          label.textContent = formatNumber(remaining, 0);
                        };

                        const getRowAvailable = (row) => {
                          return Number.parseInt(row.dataset.variationAvailable || '0', 10) || 0;
                        };

                        const normalizeQty = (row, input) => {
                          const available = getRowAvailable(row);
                          const raw = String(input.value || '').replace(/\D/g, '');
                          const parsed = Number.parseInt(raw || '0', 10) || 0;
                          const safe = Math.min(Math.max(parsed, 0), available);
                          input.value = safe > 0 ? String(safe) : '0';
                          updateAvailableLabel(row, available, safe);
                          return safe;
                        };

                        dialog.querySelectorAll('[data-variation-row]').forEach((row) => {
                          const available = getRowAvailable(row);
                          const qtyInput = row.querySelector('[data-variation-qty]');
                          if (!qtyInput) return;

                          applyVariationRowAvailabilityState(row, available);
                          normalizeQty(row, qtyInput);

                          row.querySelectorAll('[data-qty-action]').forEach((button) => {
                            button.addEventListener('click', () => {
                              if (button.disabled) return;
                              const rowAvailable = getRowAvailable(row);
                              const current = normalizeQty(row, qtyInput);
                              const delta = button.dataset.qtyAction === 'increase' ? 1 : -1;
                              const next = Math.min(Math.max(current + delta, 0), rowAvailable);
                              qtyInput.value = String(next);
                              normalizeQty(row, qtyInput);
                            });
                          });

                          qtyInput.addEventListener('input', () => {
                            normalizeQty(row, qtyInput);
                          });

                          qtyInput.addEventListener('blur', () => {
                            normalizeQty(row, qtyInput);
                          });
                        });

                        sortVariationSelectionRows(dialog.querySelector('[data-variation-modal-list]'));
                      },
                      preConfirm: () => {
                        const dialog = window.Swal.getHtmlContainer();
                        if (!dialog) return null;

                        const liveProduct = productsById.get(String(productId)) || product;

                        const selections = [];
                        let invalid = false;
                        dialog.querySelectorAll('[data-variation-row]').forEach((row) => {
                          const variationId = row.dataset.variationId || null;
                          const variationName = row.dataset.variationName || 'Unica';
                          const qtyInput = row.querySelector('[data-variation-qty]');
                          const quantity = Number.parseInt(qtyInput?.value || '0', 10) || 0;
                          if (quantity <= 0) return;

                          const available = getAvailableForVariation(liveProduct, variationId);
                          if (quantity > available) {
                            window.Swal.showValidationMessage(`Disponible para ${variationName}: ${formatNumber(available, 0)}`);
                            invalid = true;
                            return;
                          }

                          selections.push({ variationId: normalizeVariationId(variationId), quantity });
                        });

                        if (invalid) return null;

                        if (selections.length === 0) {
                          window.Swal.showValidationMessage('Agrega al menos una variacion con cantidad.');
                          return null;
                        }

                        return selections;
                      },
                    }).then((result) => {
                      if (!result.isConfirmed) return;
                      const payload = result.value || [];
                      payload.forEach((entry) => {
                        addToCart(productId, entry.variationId, entry.quantity);
                      });
                    });
                  };

                  const buildVentaPayload = (payments, change, creditSale = null, serviceCostPayments = []) => {
                    const items = Array.from(cart.entries()).map(([cartKey, item]) => {
                      if (item.itemType === 'service') {
                        const signatureFromKey = String(cartKey || '').split('::')[1] || '';
                        const normalizedSignature = signatureFromKey && signatureFromKey !== 'none' ? signatureFromKey : (item.price_signature || null);

                        return {
                          item_type: 'service',
                          service_id: item.serviceId,
                          quantity: item.quantity,
                          unit_price_usd: item.unit_price_usd,
                          unit_price_base_amount: item.unit_price_base_amount,
                          unit_price_base_currency: item.unit_price_base_currency,
                          agreed_price_display: item.agreed_price_display,
                          agreed_reference_name: item.agreed_reference_name,
                          agreed_reference_amount: item.agreed_reference_amount,
                          agreed_reference_symbol: item.agreed_reference_symbol,
                          price_signature: normalizedSignature,
                          nested_agreements: Array.isArray(item.nested_agreements) ? item.nested_agreements : [],
                          consumable_decisions: Array.isArray(item.consumable_decisions) ? item.consumable_decisions : [],
                        };
                      }

                      return {
                        item_type: 'product',
                        product_id: item.productId,
                        variation_id: item.variationId,
                        quantity: item.quantity,
                      };
                    });

                    const payload = {
                      draft_id: activeDraftId,
                      vat_mode: getVatMode(),
                      vat_rate: vatRate,
                      tasa_dolar: bcvRate,
                      base_currency: baseCurrency === 'ves' ? 'VES' : 'USD',
                      cliente_id: selectedClient ? selectedClient.id : null,
                      items: items,
                      payments: payments || [],
                    };

                    const changeEntries = Array.isArray(change) ? change : (change ? [change] : []);
                    if (changeEntries.length > 0) payload.change = changeEntries;

                    const serviceCostEntries = Array.isArray(serviceCostPayments)
                      ? serviceCostPayments
                      : (serviceCostPayments ? [serviceCostPayments] : []);
                    if (serviceCostEntries.length > 0) payload.service_cost_payments = serviceCostEntries;

                    if (creditSale && creditSale.enabled) {
                      payload.credit_sale = {
                        enabled: true,
                        due_on: String(creditSale.due_on || '').trim(),
                      };
                    }

                    return payload;
                  };

                  const submitVenta = async (payments, change, creditSale = null, serviceCostPayments = []) => {
                    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                    if (!csrfToken) {
                      if (window.Swal) {
                        window.Swal.fire({
                          icon: 'error',
                          title: 'Token CSRF no disponible',
                          text: 'Recarga la pagina e intenta de nuevo.',
                          heightAuto: false,
                        });
                      }
                      return;
                    }

                    const payload = buildVentaPayload(payments, change, creditSale, serviceCostPayments);

                    if (window.Swal) {
                      window.Swal.fire({
                        title: 'Procesando venta',
                        text: 'Guardando la venta, espera...',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        didOpen: () => window.Swal.showLoading(),
                        heightAuto: false,
                      });
                    }

                    try {
                      const response = await fetch('/ventas', {
                        method: 'POST',
                        headers: {
                          'Content-Type': 'application/json',
                          'X-CSRF-Token': csrfToken,
                        },
                        body: JSON.stringify({ venta: payload }),
                      });

                      let data = {};
                      try {
                        data = await response.json();
                      } catch (error) {
                        data = {};
                      }

                      if (!response.ok) {
                        const requestError = new Error(data.error || 'No se pudo registrar la venta.');
                        requestError.payload = data;
                        throw requestError;
                      }

                      if (Array.isArray(data.products)) {
                        syncProductsMap(data.products);
                      }

                      drafts = Array.isArray(data.drafts) ? data.drafts : drafts;
                      if (draftSyncTimeout) {
                        clearTimeout(draftSyncTimeout);
                        draftSyncTimeout = null;
                      }
                      draftSyncedFingerprint = null;
                      activeDraftId = null;
                      activeDraftVisibility = null;
                      applySyncedReservationSnapshot(new Map());
                      cart.clear();
                      setSelectedClient(null);
                      renderDraftTags();
                      renderCart();

                      if (window.Swal) {
                        const successTotal = baseCurrency === 'ves'
                          ? formatMoney(data.total_bs, 'Bs ')
                          : formatMoney(data.total_usd, '$');
                        window.Swal.fire({
                          icon: 'success',
                          title: 'Venta registrada',
                          text: `Total ${successTotal}`,
                          heightAuto: false,
                        });
                      }
                    } catch (error) {
                      const duplicatePayment = error?.payload?.duplicate_payment;
                      if (duplicatePayment && window.Swal) {
                        const accountName = escapeHtml(String(duplicatePayment.account_name || 'Cuenta bancaria'));
                        const amountNumber = Number(duplicatePayment.amount);
                        const currencyCode = String(duplicatePayment.currency || '').trim();
                        const currencySymbol = String(duplicatePayment.currency_symbol || '').trim();
                        const amountLabel = Number.isFinite(amountNumber)
                          ? `${currencySymbol || currencyCode} ${amountNumber.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
                          : `${escapeHtml(String(duplicatePayment.amount || '-'))} ${escapeHtml(currencyCode)}`;
                        const paymentDate = escapeHtml(String(duplicatePayment.payment_date || '-'));
                        const saleId = String(duplicatePayment.venta_id || '').trim();
                        const saleUrl = String(duplicatePayment.venta_url || '').trim();
                        const saleLinkHtml = saleUrl
                          ? `<a href="${escapeHtml(saleUrl)}" class="inline-flex items-center justify-center rounded-lg border border-sky-300 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100">Ir a la venta ${saleId ? `#${escapeHtml(saleId)}` : ''}</a>`
                          : '';

                        window.Swal.fire({
                          icon: 'error',
                          title: 'Pago bancario duplicado',
                          html: `
                            <div class="space-y-2 text-left text-sm text-slate-600">
                              <p>Ya existe un pago registrado con los mismos datos:</p>
                              <p><strong>Cuenta:</strong> ${accountName}</p>
                              <p><strong>Monto:</strong> ${amountLabel}</p>
                              <p><strong>Fecha:</strong> ${paymentDate}</p>
                              ${saleLinkHtml}
                            </div>
                          `,
                          heightAuto: false,
                        });
                        return;
                      }

                      if (window.Swal) {
                        window.Swal.fire({
                          icon: 'error',
                          title: 'Error al registrar',
                          text: error.message,
                          heightAuto: false,
                        });
                      }
                    }
                  };

                  const productGrid = document.getElementById('ventas-product-grid');
                  if (productGrid) {
                    productGrid.addEventListener('click', (event) => {
                      const addButton = event.target.closest('.ventas-add-button');
                      const card = event.target.closest('.ventas-product-card');
                      const productId = addButton?.dataset.productId || card?.dataset.productId;
                      if (!productId) return;
                      if (!window.Swal) {
                        addToCart(productId, null, 1);
                        return;
                      }
                      promptAddProduct(productId);
                    });
                  }

                  const serviceGrid = document.getElementById('ventas-service-grid');
                  if (serviceGrid) {
                    serviceGrid.addEventListener('click', async (event) => {
                      const addButton = event.target.closest('.ventas-add-service');
                      const card = event.target.closest('.ventas-service-card');
                      const serviceId = addButton?.dataset.serviceId || card?.dataset.serviceId;
                      if (!serviceId) return;

                      const service = servicesById.get(String(serviceId));
                      if (!service) return;

                      if (card?.dataset.serviceDisabled === 'true') {
                        if (window.Swal) {
                          window.Swal.fire({
                            icon: 'warning',
                            title: 'Precio no disponible',
                            text: 'Este servicio no tiene tasa disponible para facturar.',
                            heightAuto: false,
                          });
                        }
                        return;
                      }

                      if (service.price_on_request) {
                        const agreedPricing = await promptServicePriceOnRequest(service);
                        if (!agreedPricing) return;

                        const key = buildKey('service', serviceId, agreedPricing.priceSignature);
                        const existing = cart.get(key) || {
                          itemType: 'service',
                          serviceId: String(serviceId),
                          quantity: 0,
                          unit_price_usd: agreedPricing.unitPriceUsd,
                          unit_price_base_amount: agreedPricing.invoiceUnitAmount,
                          unit_price_base_currency: agreedPricing.invoiceCurrencyCode,
                          agreed_price_display: agreedPricing.priceDisplay,
                          agreed_reference_name: agreedPricing.referenceName,
                          agreed_reference_amount: agreedPricing.referenceAmount,
                          agreed_reference_symbol: agreedPricing.referenceSymbol,
                          nested_agreements: [],
                          consumable_decisions: [],
                        };

                        if (!Array.isArray(existing.nested_agreements)) existing.nested_agreements = [];
                        if (!Array.isArray(existing.consumable_decisions)) existing.consumable_decisions = [];
                        existing.unit_price_usd = agreedPricing.unitPriceUsd;
                        existing.unit_price_base_amount = agreedPricing.invoiceUnitAmount;
                        existing.unit_price_base_currency = agreedPricing.invoiceCurrencyCode;
                        existing.agreed_price_display = agreedPricing.priceDisplay;
                        existing.agreed_reference_name = agreedPricing.referenceName;
                        existing.agreed_reference_amount = agreedPricing.referenceAmount;
                        existing.agreed_reference_symbol = agreedPricing.referenceSymbol;
                        existing.quantity += agreedPricing.quantity;
                        cart.set(key, existing);
                        renderCart();
                        return;
                      }

                      addServiceToCart(serviceId, 1);
                    });
                  }

                  const cartList = document.getElementById('ventas-cart-list');
                  if (cartList) {
                    cartList.addEventListener('click', (event) => {
                      const button = event.target.closest('button[data-cart-action]');
                      if (!button) return;

                      const action = button.dataset.cartAction;
                      const key = button.dataset.cartKey;
                      if (!key) return;

                      if (action === 'increase') updateQuantity(key, 1);
                      if (action === 'decrease') updateQuantity(key, -1);
                      if (action === 'remove') {
                        cart.delete(key);
                        renderCart();
                      }
                    });
                  }

                  root.querySelectorAll('input[name="ventas-vat-mode"]').forEach((radio) => {
                    radio.addEventListener('change', () => {
                      renderCart();
                    });
                  });

                  baseCurrencyInputs.forEach((input) => {
                    input.addEventListener('change', () => {
                      if (input.disabled) return;
                      baseCurrency = input.value;
                      renderCart();
                    });
                  });

                  const payButton = document.getElementById('ventas-pay-button');
                  if (payButton) {
                    payButton.addEventListener('click', async () => {
                      if (!hasOpenCashShift) {
                        if (window.Swal) {
                          window.Swal.fire({
                            icon: 'warning',
                            title: 'Turno no iniciado',
                            text: 'Debes abrir un turno antes de poder facturar.',
                            heightAuto: false,
                          });
                        }
                        return;
                      }

                      if (cart.size === 0) {
                        if (window.Swal) {
                          window.Swal.fire({
                            icon: 'info',
                            title: 'Orden vacia',
                            text: 'Agrega productos o servicios antes de cobrar.',
                            heightAuto: false,
                          });
                        }
                        return;
                      }

                      const checkoutDecisionsReady = await ensureServiceCheckoutDecisions();
                      if (!checkoutDecisionsReady) return;

                      let subtotalBase = 0;
                      cart.forEach((item) => {
                        const itemType = item.itemType || 'product';
                        if (itemType === 'service') {
                          const service = servicesById.get(String(item.serviceId));
                          if (!service) return;
                          const pricing = computeServicePricing(service, item);
                          if (!(pricing.unitDisplay > 0)) return;
                          subtotalBase = roundTo(subtotalBase + pricing.lineNet, 2);
                          return;
                        }

                        const product = productsById.get(String(item.productId));
                        if (!product) return;
                        const pricing = computePricing(product.price_usd, item.quantity);
                        subtotalBase = roundTo(subtotalBase + pricing.lineNet, 2);
                      });

                      const vatMode = getVatMode();
                      const vatBase = vatMode === 'none' ? 0 : roundTo(subtotalBase * vatRate, 2);
                      const totalBase = roundTo(subtotalBase + vatBase, 2);

                      if (!window.Swal) {
                        return;
                      }

                      if (accounts.length === 0) {
                        window.Swal.fire({
                          icon: 'info',
                          title: 'Sin cuentas disponibles',
                          text: 'Registra al menos una cuenta para cobrar.',
                          heightAuto: false,
                        });
                        return;
                      }

                      const orderedAccounts = orderAccountsForPaymentModal(accounts);
                      const specialAccounts = orderedAccounts.filter((account) => isSpecialAccount(account));
                      const bankAccounts = orderedAccounts.filter((account) => account.is_bank);
                      const cashAccounts = orderedAccounts.filter((account) => {
                        const type = accountTypeKey(account);
                        return !account.is_bank && !isSpecialAccount(account) && type === 'cash_box';
                      });
                      const typedOtherAccounts = orderedAccounts.filter((account) => {
                        const type = accountTypeKey(account);
                        return !account.is_bank && !isSpecialAccount(account) && type !== 'cash_box';
                      });

                      const primaryBankAccount = bankAccounts.find((account) => account.is_primary);
                      if (bankAccounts.length > 0 && !primaryBankAccount) {
                        window.Swal.fire({
                          icon: 'warning',
                          title: 'Cuenta bancaria principal requerida',
                          text: 'No hay cuentas bancarias establecidas como principal para este negocio, por favor establezca una.',
                          heightAuto: false,
                        });
                        return;
                      }

                      const baseCurrencyCode = baseCurrency === 'ves' ? 'VES' : 'USD';

                      const padDatePart = (value) => String(value).padStart(2, '0');

                      const formatDisplayDate = (date) => {
                        if (!(date instanceof Date)) return '';
                        return `${padDatePart(date.getDate())}-${padDatePart(date.getMonth() + 1)}-${date.getFullYear()}`;
                      };

                      const formatIsoDate = (date) => {
                        if (!(date instanceof Date)) return '';
                        return `${date.getFullYear()}-${padDatePart(date.getMonth() + 1)}-${padDatePart(date.getDate())}`;
                      };

                      const parsePaymentDateInput = (rawValue) => {
                        const normalized = String(rawValue || '').trim();
                        if (!normalized) return null;

                        const isoMatch = normalized.match(/^(\d{4})-(\d{2})-(\d{2})$/);
                        if (isoMatch) {
                          const year = Number(isoMatch[1]);
                          const month = Number(isoMatch[2]);
                          const day = Number(isoMatch[3]);
                          const parsedDate = new Date(year, month - 1, day);

                          if (
                            parsedDate.getFullYear() !== year ||
                            parsedDate.getMonth() !== month - 1 ||
                            parsedDate.getDate() !== day
                          ) {
                            return null;
                          }

                          return parsedDate;
                        }

                        const displayMatch = normalized.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);
                        if (!displayMatch) return null;

                        const day = Number(displayMatch[1]);
                        const month = Number(displayMatch[2]);
                        const year = Number(displayMatch[3]);
                        const parsedDate = new Date(year, month - 1, day);

                        if (
                          parsedDate.getFullYear() !== year ||
                          parsedDate.getMonth() !== month - 1 ||
                          parsedDate.getDate() !== day
                        ) {
                          return null;
                        }

                        return parsedDate;
                      };

                      const normalizePaymentDateInput = (rawValue) => {
                        const parsedDate = parsePaymentDateInput(rawValue);
                        if (!parsedDate) return null;

                        return {
                          date: parsedDate,
                          display: formatDisplayDate(parsedDate),
                          iso: formatIsoDate(parsedDate),
                        };
                      };

                      const todayPaymentDate = formatDisplayDate(new Date());

                      const capturePaymentModalState = (dialog) => {
                        if (!dialog) return null;

                        const payments = Array.from(dialog.querySelectorAll('[data-pay-row]')).map((row) => {
                          const accountId = row.dataset.payRow;
                          return {
                            accountId: String(accountId),
                            checked: Boolean(row.querySelector(`[data-pay-check="${accountId}"]`)?.checked),
                            amount: row.querySelector(`[data-pay-input="${accountId}"]`)?.value || '',
                            method: row.querySelector(`[data-pay-bank-method="${accountId}"]`)?.value || '',
                            reference: row.querySelector(`[data-pay-reference="${accountId}"]`)?.value || '',
                            paymentDate: row.querySelector(`[data-pay-date="${accountId}"]`)?.value || '',
                          };
                        });

                        const changeToggle = dialog.querySelector('[data-change-toggle]');
                        const creditToggle = dialog.querySelector('[data-credit-toggle]');
                        const creditDueOnInput = dialog.querySelector('[data-credit-due-on]');
                        const change = Array.from(dialog.querySelectorAll('[data-change-row]')).map((row) => {
                          const accountId = row.dataset.changeRow;
                          return {
                            accountId: String(accountId),
                            checked: Boolean(row.querySelector(`[data-change-check="${accountId}"]`)?.checked),
                            amount: row.querySelector(`[data-change-input="${accountId}"]`)?.value || '',
                            method: row.querySelector(`[data-change-bank-method="${accountId}"]`)?.value || '',
                            reference: row.querySelector(`[data-change-reference="${accountId}"]`)?.value || '',
                          };
                        });

                        const serviceCostPayments = Array.from(dialog.querySelectorAll('[data-service-cost-row]')).map((row) => {
                          const serviceId = row.dataset.serviceCostRow;
                          return {
                            serviceId: String(serviceId || ''),
                            checked: Boolean(row.querySelector(`[data-service-cost-toggle="${serviceId}"]`)?.checked),
                            accountId: row.querySelector(`[data-service-cost-account="${serviceId}"]`)?.value || '',
                            amount: row.querySelector(`[data-service-cost-amount="${serviceId}"]`)?.value || '',
                            method: row.querySelector(`[data-service-cost-method="${serviceId}"]`)?.value || '',
                            reference: row.querySelector(`[data-service-cost-reference="${serviceId}"]`)?.value || '',
                            paymentDate: row.querySelector(`[data-service-cost-date="${serviceId}"]`)?.value || '',
                          };
                        });

                        const showExtraBankAccounts = Array.from(dialog.querySelectorAll('[data-bank-extra="true"]'))
                          .some((row) => !row.classList.contains('hidden'));

                        return {
                          payments,
                          change,
                          serviceCostPayments,
                          changeEnabled: Boolean(changeToggle?.checked),
                          creditEnabled: Boolean(creditToggle?.checked),
                          creditDueOn: creditDueOnInput?.value || '',
                          showExtraBankAccounts,
                        };
                      };

                      const buildPaymentRow = (account, options = {}) => {
                        const symbol = account.currency_symbol || account.currency;
                        const isBank = account.is_bank;
                        const paymentMethodImageUrl = String(account.payment_method_image_url || '').trim();
                        const hasPaymentMethodImage = paymentMethodImageUrl.length > 0;
                        const typeLabelMap = {
                          bank_account: 'Banco',
                          cash_box: 'Efectivo',
                          card: 'Tarjeta',
                          pos: 'Punto de venta',
                          biopago: 'Biopago',
                          cashea: 'Cashea',
                          digital_wallet: 'Billetera digital',
                          crypto_wallet: 'Billetera cripto',
                        };
                        const accountTypeLabel = typeLabelMap[account.account_type] || account.account_type || 'Cuenta';
                        const bankFieldsClass = isBank ? '' : 'hidden';
                        const extraClass = options.extra ? ' hidden' : '';
                        const extraAttr = options.extra ? ' data-bank-extra="true"' : '';
                        const cardClasses = 'rounded-2xl border border-slate-200 bg-white/95 p-3.5 shadow-sm transition-all';
                        const cardStyle = hasPaymentMethodImage
                          ? ` style="background-image: url('${escapeCssUrl(paymentMethodImageUrl)}'); background-size: cover; background-position: center; background-repeat: no-repeat; background-color: #ffffff;"`
                          : '';
                        const titleClass = hasPaymentMethodImage ? 'text-slate-800' : 'text-slate-700';
                        const labelSurfaceClass = hasPaymentMethodImage
                          ? 'rounded-xl bg-white/80 px-2.5 py-1.5 shadow-sm ring-1 ring-white/80 backdrop-blur-[1px]'
                          : '';
                        const checkClass = hasPaymentMethodImage
                          ? 'mt-0.5 h-4 w-4 cursor-pointer rounded border border-slate-300 bg-white text-sky-600 shadow-sm'
                          : 'mt-0.5 h-4 w-4 cursor-pointer text-sky-600';
                        const typeBadgeClass = hasPaymentMethodImage
                          ? 'bg-white/90 text-slate-700 ring-1 ring-slate-200 backdrop-blur-[1px]'
                          : 'bg-slate-100 text-slate-600 ring-1 ring-slate-200';
                        const currencyBadgeClass = hasPaymentMethodImage
                          ? 'bg-white/90 text-cyan-700 ring-1 ring-cyan-200 shadow-sm backdrop-blur-[1px]'
                          : 'bg-cyan-50 text-cyan-700 ring-1 ring-cyan-100';
                        const inputClass = hasPaymentMethodImage
                          ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-700 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500 disabled:opacity-95'
                          : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400 disabled:opacity-90';
                        const bankSelectClass = hasPaymentMethodImage
                          ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-500 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500 disabled:opacity-95'
                          : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-400 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400 disabled:opacity-90';
                        const bankFieldClass = hasPaymentMethodImage
                          ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-700 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500 disabled:opacity-95'
                          : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400 disabled:opacity-90';
                        const equivalentClass = hasPaymentMethodImage
                          ? 'mt-2 inline-flex w-fit rounded-lg bg-white/82 px-2 py-1 text-xs font-semibold text-slate-700 ring-1 ring-white/75 backdrop-blur-[1px]'
                          : 'mt-2 text-xs font-medium text-slate-500';
                        return `
                          <div class="${cardClasses}${extraClass}" data-pay-row="${account.id}"${extraAttr}${cardStyle}>
                            <div class="flex items-start justify-between gap-3">
                              <label class="flex cursor-pointer items-start gap-2 text-sm font-semibold ${titleClass} ${labelSurfaceClass}">
                                <input type="checkbox" class="${checkClass}" data-pay-check="${account.id}">
                                <span class="inline-flex flex-col">
                                  <span class="inline-flex items-center gap-2 leading-tight" data-pay-account-label><span>${escapeHtml(account.name)}</span></span>
                                  <span class="mt-1 inline-flex w-fit items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ${typeBadgeClass}" data-pay-account-type-badge>${escapeHtml(accountTypeLabel)}</span>
                                </span>
                              </label>
                              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${currencyBadgeClass}" data-pay-account-currency-badge>${escapeHtml(account.currency)}</span>
                            </div>
                            <div class="mt-3 grid gap-2 md:grid-cols-2">
                              <input type="text" inputmode="decimal" autocomplete="off" placeholder="${escapeHtml(symbol)} 0,00" class="${inputClass}" data-pay-input="${account.id}" data-money-mask="true" data-money-symbol="${escapeHtml(symbol)}" disabled>
                              <div class="space-y-2 ${bankFieldsClass}" data-pay-bank-fields="${account.id}">
                                <select class="${bankSelectClass}" data-bank-method-select="true" data-pay-bank-method="${account.id}" disabled>
                                  <option value="" style="color:#94a3b8;background:#ffffff;">Metodo</option>
                                  <option value="transfer" style="color:#0369a1;background:#ffffff;">Transferencia</option>
                                  <option value="mobile" style="color:#0369a1;background:#ffffff;">Pago movil</option>
                                </select>
                                <input type="text" class="${bankFieldClass} js-materialize-datepicker materialize-datepicker-input" placeholder="dd-mm-aaaa" data-pay-date="${account.id}" value="${todayPaymentDate}" disabled>
                                <input type="text" inputmode="numeric" maxlength="6" minlength="6" pattern="[0-9]{6}" title="La referencia debe tener exactamente 6 digitos" class="${bankFieldClass}" placeholder="Ultimos 6 digitos" data-pay-reference="${account.id}" disabled>
                              </div>
                            </div>
                            <p class="${equivalentClass}" data-pay-equivalent="${account.id}"></p>
                          </div>
                        `;
                      };

                      const buildChangeRow = (account) => {
                        const symbol = account.currency_symbol || account.currency;
                        const isBank = account.is_bank;
                        const paymentMethodImageUrl = String(account.payment_method_image_url || '').trim();
                        const hasPaymentMethodImage = paymentMethodImageUrl.length > 0;
                        const typeLabelMap = {
                          bank_account: 'Banco',
                          cash_box: 'Efectivo',
                          card: 'Tarjeta',
                          pos: 'Punto de venta',
                          biopago: 'Biopago',
                          cashea: 'Cashea',
                          digital_wallet: 'Billetera digital',
                          crypto_wallet: 'Billetera cripto',
                        };
                        const accountTypeLabel = typeLabelMap[account.account_type] || account.account_type || 'Cuenta';
                        const bankFieldsClass = isBank ? '' : 'hidden';
                        const rowClasses = 'rounded-2xl border border-amber-200 bg-white/95 p-3.5 shadow-sm transition-all';
                        const rowStyle = hasPaymentMethodImage
                          ? ` style="background-image: url('${escapeCssUrl(paymentMethodImageUrl)}'); background-size: cover; background-position: center; background-repeat: no-repeat; background-color: #ffffff;"`
                          : '';
                        const labelClass = hasPaymentMethodImage ? 'text-slate-800' : 'text-slate-700';
                        const labelSurfaceClass = hasPaymentMethodImage
                          ? 'rounded-xl bg-white/80 px-2.5 py-1.5 shadow-sm ring-1 ring-white/80 backdrop-blur-[1px]'
                          : '';
                        const checkClass = hasPaymentMethodImage
                          ? 'mt-0.5 h-4 w-4 cursor-pointer rounded border border-slate-300 bg-white text-amber-600 shadow-sm'
                          : 'mt-0.5 h-4 w-4 cursor-pointer text-amber-600';
                        const typeBadgeClass = hasPaymentMethodImage
                          ? 'bg-white/90 text-amber-700 ring-1 ring-amber-200 backdrop-blur-[1px]'
                          : 'bg-amber-50 text-amber-700 ring-1 ring-amber-200';
                        const currencyBadgeClass = hasPaymentMethodImage
                          ? 'bg-white/90 text-amber-700 ring-1 ring-amber-200 shadow-sm backdrop-blur-[1px]'
                          : 'bg-amber-50 text-amber-700 ring-1 ring-amber-200';
                        const inputClass = hasPaymentMethodImage
                          ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-700 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500 disabled:opacity-95'
                          : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-amber-50/40 px-3 py-2 text-sm text-slate-700 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400 disabled:opacity-90';
                        const bankSelectClass = hasPaymentMethodImage
                          ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-500 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500 disabled:opacity-95'
                          : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-amber-50/40 px-3 py-2 text-sm text-slate-400 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400 disabled:opacity-90';
                        const bankFieldClass = hasPaymentMethodImage
                          ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-700 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500 disabled:opacity-95'
                          : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-amber-50/40 px-3 py-2 text-sm text-slate-700 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400 disabled:opacity-90';
                        const equivalentClass = hasPaymentMethodImage
                          ? 'mt-2 inline-flex w-fit rounded-lg bg-white/82 px-2 py-1 text-xs font-semibold text-slate-700 ring-1 ring-white/75 backdrop-blur-[1px]'
                          : 'mt-2 text-xs font-medium text-slate-500';
                        return `
                          <div class="${rowClasses}" data-change-row="${account.id}"${rowStyle}>
                            <div class="flex items-start justify-between gap-3">
                              <label class="flex cursor-pointer items-start gap-2 text-sm font-semibold ${labelClass} ${labelSurfaceClass}">
                                <input type="checkbox" class="${checkClass}" data-change-check="${account.id}">
                                <span class="inline-flex flex-col">
                                  <span class="inline-flex items-center gap-2 leading-tight"><span>${escapeHtml(account.name)}</span></span>
                                  <span class="mt-1 inline-flex w-fit items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ${typeBadgeClass}">${escapeHtml(accountTypeLabel)}</span>
                                </span>
                              </label>
                              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${currencyBadgeClass}">${escapeHtml(account.currency)}</span>
                            </div>
                            <div class="mt-3 grid gap-2 md:grid-cols-2">
                              <input type="text" inputmode="decimal" autocomplete="off" placeholder="${escapeHtml(symbol)} 0,00" class="${inputClass}" data-change-input="${account.id}" data-money-mask="true" data-money-symbol="${escapeHtml(symbol)}" disabled>
                              <div class="space-y-2 ${bankFieldsClass}" data-change-bank-fields="${account.id}">
                                <select class="${bankSelectClass}" data-bank-method-select="true" data-change-bank-method="${account.id}" disabled>
                                  <option value="">Metodo</option>
                                  <option value="transfer">Transferencia</option>
                                  <option value="mobile">Pago movil</option>
                                </select>
                                <input type="text" inputmode="numeric" maxlength="6" minlength="6" pattern="[0-9]{6}" title="La referencia debe tener exactamente 6 digitos" class="${bankFieldClass}" placeholder="Ultimos 6 digitos" data-change-reference="${account.id}" disabled>
                              </div>
                            </div>
                            <p class="${equivalentClass}" data-change-equivalent="${account.id}"></p>
                          </div>
                        `;
                      };

                      const extraBankAccounts = primaryBankAccount
                        ? bankAccounts.filter((account) => !account.is_primary)
                        : [];
                      const orderedAccountsForChange = [
                        ...specialAccounts,
                        ...bankAccounts,
                        ...cashAccounts,
                        ...typedOtherAccounts,
                      ];

                      const specialRowsHtml = specialAccounts.map((account) => buildPaymentRow(account)).join('');

                      const bankRowsHtml = primaryBankAccount
                        ? buildPaymentRow(primaryBankAccount)
                        : bankAccounts.map((account) => buildPaymentRow(account)).join('');
                      const toggleBankHtml = primaryBankAccount && extraBankAccounts.length > 0
                        ? '<button type="button" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 shadow-sm transition-colors hover:bg-slate-50" data-toggle-bank-accounts>Ver mas cuentas</button>'
                        : '';
                      const extraBankRowsHtml = primaryBankAccount
                        ? extraBankAccounts.map((account) => buildPaymentRow(account, { extra: true })).join('')
                        : '';
                      const cashRowsHtml = cashAccounts.map((account) => buildPaymentRow(account)).join('');
                      const otherRowsHtml = typedOtherAccounts.map((account) => buildPaymentRow(account)).join('');
                      const paymentRowsHtml = `${specialRowsHtml}${bankRowsHtml}${toggleBankHtml}${extraBankRowsHtml}${cashRowsHtml}${otherRowsHtml}`;

                      const changeRowsHtml = orderedAccountsForChange.map((account) => buildChangeRow(account)).join('');
                      const vatLabel = vatMode === 'none' ? 'Sin IVA' : (vatMode === 'add' ? 'IVA agregado' : 'IVA invertido');

                      const serviceCostGrouped = new Map();
                      cart.forEach((item) => {
                        const itemType = item.itemType || 'product';
                        if (itemType !== 'service') return;

                        const service = servicesById.get(String(item.serviceId));
                        if (!service || !service.auto_cost_stock_discount) return;

                        const quantity = Number(item.quantity || 0);
                        const unitCostUsd = Number(service.unit_cost_usd || 0);
                        if (!(quantity > 0) || !(unitCostUsd > 0)) return;

                        const serviceId = String(service.id);
                        const existing = serviceCostGrouped.get(serviceId) || {
                          serviceId,
                          serviceName: service.name || `Servicio #${serviceId}`,
                          quantity: 0,
                          unitCostUsd,
                        };

                        existing.quantity += quantity;
                        existing.unitCostUsd = unitCostUsd;
                        serviceCostGrouped.set(serviceId, existing);
                      });

                      const serviceCostRows = Array.from(serviceCostGrouped.values()).map((row) => {
                        const totalCostUsd = roundTo(Number(row.unitCostUsd || 0) * Number(row.quantity || 0), 2);
                        return {
                          ...row,
                          totalCostUsd,
                        };
                      }).filter((row) => row.totalCostUsd > 0);

                      const totalServiceCostUsd = roundTo(
                        serviceCostRows.reduce((sum, row) => sum + Number(row.totalCostUsd || 0), 0),
                        2
                      );

                      const accountOptionsForServiceCost = orderedAccounts
                        .map((account) => `
                          <option
                            value="${account.id}"
                            data-account-type="${escapeHtml(account.account_type || '')}"
                            data-account-currency="${escapeHtml(account.currency || '')}"
                          >${escapeHtml(account.name)} (${escapeHtml(account.currency || '')})</option>
                        `)
                        .join('');

                      const buildServiceCostRow = (row) => {
                        return `
                          <div class="rounded-2xl border border-cyan-200 bg-white/95 p-3.5 shadow-sm" data-service-cost-row="${row.serviceId}" data-service-cost-total-usd="${row.totalCostUsd}">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                              <div>
                                <p class="text-sm font-semibold text-slate-800">${escapeHtml(row.serviceName)}</p>
                                <p class="mt-1 text-xs text-slate-500">Costo estimado: ${formatCurrencyValue(row.totalCostUsd, 'USD')} · Cantidad: ${formatNumber(row.quantity, 2)}</p>
                              </div>
                              <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-cyan-700">
                                <input type="checkbox" class="h-4 w-4 cursor-pointer text-cyan-600" data-service-cost-toggle="${row.serviceId}">
                                Pagar ahora
                              </label>
                            </div>
                            <div class="mt-3 grid gap-2 md:grid-cols-2 hidden" data-service-cost-fields="${row.serviceId}">
                              <select class="ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700" data-service-cost-account="${row.serviceId}">
                                <option value="">Cuenta para costo</option>
                                ${accountOptionsForServiceCost}
                              </select>
                              <input type="text" inputmode="decimal" autocomplete="off" placeholder="Monto" class="ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700" data-service-cost-amount="${row.serviceId}" data-money-mask="true" data-money-symbol="$">
                              <select class="ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700 hidden" data-service-cost-method="${row.serviceId}">
                                <option value="">Metodo</option>
                                <option value="transfer">Transferencia</option>
                                <option value="mobile">Pago movil</option>
                              </select>
                              <input type="text" class="ventas-payment-modal-field js-materialize-datepicker materialize-datepicker-input w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700 hidden" placeholder="dd-mm-aaaa" data-service-cost-date="${row.serviceId}" value="${todayPaymentDate}">
                              <input type="text" inputmode="numeric" maxlength="6" minlength="6" pattern="[0-9]{6}" title="La referencia debe tener exactamente 6 digitos" class="ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700 hidden md:col-span-2" placeholder="Ultimos 6 digitos" data-service-cost-reference="${row.serviceId}">
                            </div>
                            <p class="mt-2 text-xs font-medium text-slate-500" data-service-cost-equivalent="${row.serviceId}"></p>
                          </div>
                        `;
                      };

                      const serviceCostRowsHtml = serviceCostRows.map((row) => buildServiceCostRow(row)).join('');
                      const serviceCostSectionHtml = serviceCostRows.length > 0
                        ? `
                          <div class="rounded-2xl border border-cyan-200 bg-cyan-50/70 p-3.5 space-y-3">
                            <div class="flex flex-wrap items-start justify-between gap-2">
                              <div>
                                <p class="text-sm font-semibold text-cyan-700">Costos automaticos de servicios</p>
                                <p class="text-xs text-cyan-700">Puedes registrar pago inmediato o dejar saldo pendiente por pagar.</p>
                              </div>
                              <span class="inline-flex items-center rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold text-cyan-700 ring-1 ring-cyan-200">Total estimado: ${formatCurrencyValue(totalServiceCostUsd, 'USD')}</span>
                            </div>
                            <div class="space-y-2">${serviceCostRowsHtml}</div>
                          </div>
                        `
                        : '';

                      const paymentHtml = `
                        <div class="space-y-4 text-left">
                          <div class="rounded-2xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-4 shadow-sm">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                              <div>
                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total a cobrar</p>
                                <p class="mt-1 text-2xl font-extrabold text-slate-800">${formatBaseMoney(totalBase)}</p>
                                <p class="text-xs font-semibold text-slate-500">${formatAltFromBase(totalBase)}</p>
                              </div>
                              <div class="flex flex-wrap items-center gap-2">
                                <span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700 ring-1 ring-sky-100">Base ${escapeHtml(baseCurrencyCode)}</span>
                                <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-semibold text-amber-700 ring-1 ring-amber-200">${escapeHtml(vatLabel)}</span>
                              </div>
                            </div>
                            <div class="mt-3 grid gap-2 sm:grid-cols-2">
                              <div class="rounded-xl bg-white px-3 py-2 text-xs text-slate-500 ring-1 ring-slate-200">Subtotal: <span class="font-semibold text-slate-700">${formatBaseMoney(subtotalBase)}</span></div>
                              <div class="rounded-xl bg-white px-3 py-2 text-xs text-slate-500 ring-1 ring-slate-200">IVA: <span class="font-semibold text-slate-700">${formatBaseMoney(vatBase)}</span></div>
                            </div>
                          </div>
                          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5">
                            <div class="flex items-center justify-between gap-2">
                              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Metodos de pago</p>
                              <span class="text-[11px] font-semibold text-slate-500">Selecciona cuenta y monto</span>
                            </div>
                            <div class="mt-3 space-y-2">${paymentRowsHtml}</div>
                          </div>
                          ${serviceCostSectionHtml}
                          <div class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 space-y-3">
                            <div class="flex items-center justify-between gap-2">
                              <span class="text-sm font-semibold text-emerald-700">Saldo a credito (opcional)</span>
                              <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-emerald-700">
                                <input type="checkbox" class="h-4 w-4 cursor-pointer text-emerald-600" data-credit-toggle>
                                Registrar saldo pendiente
                              </label>
                            </div>
                            <p class="text-xs text-emerald-700">Si queda saldo pendiente, se creara una deuda por cobrar vinculada a esta venta.</p>
                            <div class="hidden" data-credit-fields>
                              <label class="block text-xs font-semibold uppercase tracking-wide text-emerald-700">Vence (opcional)</label>
                              <input type="text" class="ventas-payment-modal-field js-materialize-datepicker materialize-datepicker-input mt-1 w-full rounded-xl border border-transparent bg-white px-3 py-2 text-sm text-slate-700" placeholder="dd-mm-aaaa" data-credit-due-on disabled>
                            </div>
                          </div>
                          <div id="ventas-change-section" class="hidden rounded-2xl border border-amber-200 bg-amber-50/70 p-3.5 space-y-3">
                            <div class="flex items-center justify-between">
                              <span class="text-sm font-semibold text-amber-700">Vuelto (opcional)</span>
                              <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-amber-700">
                                <input type="checkbox" class="h-4 w-4 cursor-pointer text-amber-600" data-change-toggle>
                                Registrar vuelto
                              </label>
                            </div>
                            <p class="text-xs text-amber-700" data-change-hint></p>
                            <div class="space-y-2 hidden" data-change-rows>
                              ${changeRowsHtml}
                            </div>
                          </div>
                        </div>
                      `;

                      const openPaymentModal = (initialState = null) => {
                        window.Swal.fire({
                          title: 'Metodos de pago',
                          html: paymentHtml,
                          confirmButtonText: 'Confirmar',
                          cancelButtonText: 'Cancelar',
                          showCancelButton: true,
                          allowOutsideClick: false,
                          allowEscapeKey: false,
                          focusConfirm: false,
                          buttonsStyling: false,
                          customClass: {
                            popup: 'ventas-payment-modal',
                            title: 'ventas-payment-modal-title',
                            actions: 'ventas-payment-modal-actions',
                            confirmButton: 'ventas-payment-modal-confirm cursor-pointer',
                            cancelButton: 'ventas-payment-modal-cancel cursor-pointer',
                          },
                          heightAuto: false,
                          didOpen: () => {
                            const dialog = window.Swal.getHtmlContainer();
                            if (!dialog) return;

                            const popup = window.Swal.getPopup();
                            const actionsContainer = popup?.querySelector('.swal2-actions');

                            if (actionsContainer && !actionsContainer.querySelector('[data-payment-footer-balance]')) {
                              const balancePanel = document.createElement('div');
                              balancePanel.className = 'ventas-payment-modal-balance';
                              balancePanel.dataset.paymentFooterBalance = 'true';
                              balancePanel.innerHTML = `
                                <span class="font-semibold text-slate-600">Falta por cancelar</span>
                                <span class="text-right">
                                  <span id="ventas-pay-remaining" class="block font-semibold text-slate-700"></span>
                                  <span id="ventas-pay-remaining-alt" class="block text-xs text-slate-400"></span>
                                </span>
                              `;
                              actionsContainer.prepend(balancePanel);
                            }

                            initMoneyMasks(dialog);

                            const changeSection = dialog.querySelector('#ventas-change-section');
                            const changeToggle = dialog.querySelector('[data-change-toggle]');
                            const changeRowsContainer = dialog.querySelector('[data-change-rows]');
                            const changeHintEl = dialog.querySelector('[data-change-hint]');
                            const creditToggle = dialog.querySelector('[data-credit-toggle]');
                            const creditFields = dialog.querySelector('[data-credit-fields]');
                            const creditDueOnInput = dialog.querySelector('[data-credit-due-on]');
                            const serviceCostRowsInModal = Array.from(dialog.querySelectorAll('[data-service-cost-row]'));

                            const syncMethodSelectTone = (select) => {
                              if (!select) return;

                              if (select.disabled) {
                                select.classList.add('text-slate-400');
                                select.classList.remove('text-slate-700');
                                select.style.color = '#94a3b8';
                                return;
                              }

                              const isPlaceholderSelected = String(select.value || '').trim() === '';

                              select.classList.toggle('text-slate-400', isPlaceholderSelected);
                              select.classList.toggle('text-slate-700', !isPlaceholderSelected);
                              select.style.color = isPlaceholderSelected ? '#94a3b8' : '#334155';
                            };

                            const syncPaymentRowMethodTone = (row) => {
                              if (!row) return;

                              const accountId = row.dataset.payRow;
                              if (!accountId) return;

                              const methodSelect = row.querySelector(`[data-pay-bank-method="${accountId}"]`);
                              const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                              if (!methodSelect || !checkbox) return;

                              const hasMethod = String(methodSelect.value || '').trim().length > 0;
                              const shouldToneDown = checkbox.checked && !hasMethod;

                              row.querySelectorAll('[data-pay-account-label], [data-pay-account-type-badge], [data-pay-account-currency-badge]').forEach((el) => {
                                el.classList.toggle('opacity-70', shouldToneDown);
                                el.classList.toggle('opacity-100', !shouldToneDown);
                              });
                            };

                            const setRowVisualState = (row, enabled, tone = 'sky') => {
                              if (!row) return;

                              row.classList.toggle('ventas-payment-row-active', enabled);
                              row.classList.toggle('ventas-payment-row-inactive', !enabled);

                              if (tone === 'amber') {
                                row.classList.toggle('border-amber-300', enabled);
                                row.classList.toggle('bg-amber-50', enabled);
                                row.classList.toggle('ring-1', enabled);
                                row.classList.toggle('ring-amber-200', enabled);
                                row.classList.remove('border-sky-300', 'bg-sky-50', 'ring-sky-200');
                              } else {
                                row.classList.toggle('border-sky-300', enabled);
                                row.classList.toggle('bg-sky-50', enabled);
                                row.classList.toggle('ring-1', enabled);
                                row.classList.toggle('ring-sky-200', enabled);
                                row.classList.remove('border-amber-300', 'bg-amber-50', 'ring-amber-200');
                              }
                            };

                            const setFieldEnabledState = (field, enabled, tone = 'sky') => {
                              if (!field) return;

                              const isPayDateField = field.matches('input[data-pay-date]');

                              field.disabled = !enabled;
                              if (!enabled) field.value = '';
                              if (!enabled) field.blur();
                              if (enabled && isPayDateField && String(field.value || '').trim() === '') {
                                field.value = todayPaymentDate;
                              }

                              field.classList.remove(
                                'border-sky-300',
                                'border-amber-300',
                                'border-transparent',
                                'ring-2',
                                'ring-sky-100',
                                'ring-amber-100',
                                'bg-white',
                                'opacity-70',
                                'opacity-100',
                                'ventas-payment-modal-field-active',
                                'ventas-payment-modal-field-active-sky',
                                'ventas-payment-modal-field-active-amber',
                                'ventas-payment-modal-field-disabled',
                              );

                              if (enabled) {
                                field.classList.add('bg-white', 'opacity-100', 'ventas-payment-modal-field-active');
                                if (tone === 'amber') {
                                  field.classList.add('ventas-payment-modal-field-active-amber');
                                } else {
                                  field.classList.add('ventas-payment-modal-field-active-sky');
                                }
                              } else {
                                field.classList.add('border-transparent', 'opacity-70', 'ventas-payment-modal-field-disabled');
                              }
                            };

                            const setBankFieldsEnabled = (container, enabled, tone) => {
                              if (!container) return;
                              container.querySelectorAll('select, input').forEach((field) => {
                                setFieldEnabledState(field, enabled, tone);
                                if (field.matches('select[data-bank-method-select]')) {
                                  syncMethodSelectTone(field);
                                }
                              });
                            };

                            const toggleChangeSection = (visible) => {
                              if (!changeSection) return;
                              changeSection.classList.toggle('hidden', !visible);
                            };

                            const resetChangeRow = (row) => {
                              const accountId = row.dataset.changeRow;
                              const checkbox = row.querySelector(`[data-change-check="${accountId}"]`);
                              const input = row.querySelector(`[data-change-input="${accountId}"]`);
                              const bankFields = row.querySelector(`[data-change-bank-fields="${accountId}"]`);
                              const equivalentEl = row.querySelector(`[data-change-equivalent="${accountId}"]`);

                              if (checkbox) checkbox.checked = false;
                              setFieldEnabledState(input, false, 'amber');
                              setBankFieldsEnabled(bankFields, false, 'amber');
                              setRowVisualState(row, false, 'amber');
                              if (equivalentEl) equivalentEl.textContent = '';
                            };

                            const setChangeRowsEnabled = (enabled) => {
                              if (!changeRowsContainer) return;
                              changeRowsContainer.classList.toggle('hidden', !enabled);
                              if (!enabled) {
                                changeRowsContainer.querySelectorAll('[data-change-row]').forEach((row) => {
                                  resetChangeRow(row);
                                });
                              }
                            };

                            const setCreditFieldsEnabled = (enabled) => {
                              if (creditFields) {
                                creditFields.classList.toggle('hidden', !enabled);
                              }

                              if (creditDueOnInput) {
                                setFieldEnabledState(creditDueOnInput, enabled, 'sky');
                              }
                            };

                            const syncServiceCostBankFields = (serviceId, isBankAccount) => {
                              const methodSelect = dialog.querySelector(`[data-service-cost-method="${serviceId}"]`);
                              const dateInput = dialog.querySelector(`[data-service-cost-date="${serviceId}"]`);
                              const referenceInput = dialog.querySelector(`[data-service-cost-reference="${serviceId}"]`);

                              if (methodSelect) {
                                methodSelect.classList.toggle('hidden', !isBankAccount);
                                if (!isBankAccount) methodSelect.value = '';
                              }
                              if (dateInput) {
                                dateInput.classList.toggle('hidden', !isBankAccount);
                                if (!isBankAccount) {
                                  dateInput.value = '';
                                } else if (String(dateInput.value || '').trim() === '') {
                                  dateInput.value = todayPaymentDate;
                                }
                              }
                              if (referenceInput) {
                                referenceInput.classList.toggle('hidden', !isBankAccount);
                                if (!isBankAccount) referenceInput.value = '';
                              }
                            };

                            const setServiceCostFieldsEnabled = (serviceId, enabled) => {
                              const fieldsContainer = dialog.querySelector(`[data-service-cost-fields="${serviceId}"]`);
                              if (!fieldsContainer) return;

                              fieldsContainer.classList.toggle('hidden', !enabled);

                              const accountSelect = dialog.querySelector(`[data-service-cost-account="${serviceId}"]`);
                              const amountInput = dialog.querySelector(`[data-service-cost-amount="${serviceId}"]`);
                              const methodSelect = dialog.querySelector(`[data-service-cost-method="${serviceId}"]`);
                              const dateInput = dialog.querySelector(`[data-service-cost-date="${serviceId}"]`);
                              const referenceInput = dialog.querySelector(`[data-service-cost-reference="${serviceId}"]`);

                              [accountSelect, amountInput, methodSelect, dateInput, referenceInput].forEach((field) => {
                                if (!field) return;
                                field.disabled = !enabled;
                                if (!enabled) field.value = '';
                              });

                              if (!enabled) {
                                syncServiceCostBankFields(serviceId, false);
                              }
                            };

                            const updateServiceCostEquivalents = () => {
                              serviceCostRowsInModal.forEach((row) => {
                                const serviceId = row.dataset.serviceCostRow;
                                if (!serviceId) return;

                                const equivalentEl = row.querySelector(`[data-service-cost-equivalent="${serviceId}"]`);
                                const accountSelect = row.querySelector(`[data-service-cost-account="${serviceId}"]`);
                                const amountInput = row.querySelector(`[data-service-cost-amount="${serviceId}"]`);
                                const totalCostUsd = Number(row.dataset.serviceCostTotalUsd || 0);
                                const account = accountSelect ? accountsById.get(String(accountSelect.value || '')) : null;
                                const amount = parseMoneyInput(amountInput);

                                if (!equivalentEl) return;

                                if (!account || !(amount > 0)) {
                                  equivalentEl.textContent = '';
                                  equivalentEl.classList.remove('text-rose-600', 'text-emerald-700');
                                  return;
                                }

                                const amountUsd = convertAmount(amount, account.currency, 'USD');
                                if (amountUsd === null) {
                                  equivalentEl.textContent = 'Sin tasa de conversion disponible';
                                  equivalentEl.classList.remove('text-emerald-700');
                                  equivalentEl.classList.add('text-rose-600');
                                  return;
                                }

                                const pendingUsd = roundTo(totalCostUsd - amountUsd, 2);
                                if (pendingUsd > paymentTolerance) {
                                  equivalentEl.textContent = `Pagas ${formatCurrencyValue(amountUsd, 'USD')} · Pendiente ${formatCurrencyValue(Math.abs(pendingUsd), 'USD')}`;
                                  equivalentEl.classList.remove('text-rose-600');
                                  equivalentEl.classList.add('text-emerald-700');
                                } else if (pendingUsd < -paymentTolerance) {
                                  equivalentEl.textContent = `El monto supera el costo estimado (${formatCurrencyValue(totalCostUsd, 'USD')})`;
                                  equivalentEl.classList.remove('text-emerald-700');
                                  equivalentEl.classList.add('text-rose-600');
                                } else {
                                  equivalentEl.textContent = `Costo cubierto: ${formatCurrencyValue(totalCostUsd, 'USD')}`;
                                  equivalentEl.classList.remove('text-rose-600');
                                  equivalentEl.classList.add('text-emerald-700');
                                }
                              });
                            };

                            const updateRemaining = () => {
                            let paidBase = 0;
                            let paidAlt = 0;
                            const altCurrencyCode = baseCurrencyCode === 'USD' ? 'VES' : 'USD';
                            const altAvailable = bcvRate > 0;
                            dialog.querySelectorAll('[data-pay-row]').forEach((row) => {
                              const accountId = row.dataset.payRow;
                              const account = accountsById.get(String(accountId));
                              if (!account) return;

                              const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                              const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                              const equivalentEl = row.querySelector(`[data-pay-equivalent="${accountId}"]`);
                              const amount = parseMoneyInput(input);

                              if (!checkbox?.checked || amount <= 0) {
                                if (equivalentEl) equivalentEl.textContent = '';
                                return;
                              }

                              const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                              if (baseAmount === null) {
                                if (equivalentEl) {
                                  equivalentEl.textContent = 'Sin tasa de conversion';
                                  equivalentEl.classList.add('text-red-500');
                                }
                                return;
                              }

                              if (equivalentEl) {
                                equivalentEl.textContent = `Equiv: ${formatBaseMoney(baseAmount)}`;
                                equivalentEl.classList.remove('text-red-500');
                              }
                              paidBase += baseAmount;

                              if (altAvailable) {
                                const altAmount = convertAmount(amount, account.currency, altCurrencyCode);
                                if (altAmount !== null) {
                                  paidAlt += altAmount;
                                }
                              }
                            });

                            let remaining = roundTo(totalBase - paidBase, 2);
                            if (Math.abs(remaining) <= paymentTolerance) remaining = 0;

                            let remainingAlt = null;
                            if (altAvailable) {
                              const totalAlt = convertAmount(totalBase, baseCurrencyCode, altCurrencyCode);
                              if (totalAlt !== null) {
                                remainingAlt = roundTo(totalAlt - paidAlt, 2);
                              }
                            }

                            const remainingEl = popup?.querySelector('#ventas-pay-remaining');
                            const remainingAltEl = popup?.querySelector('#ventas-pay-remaining-alt');
                            if (!remainingEl) return;

                            const remainingAbs = Math.abs(remaining);
                            const remainingAltAbs = remainingAlt !== null ? Math.abs(remainingAlt) : 0;
                            const altTolerance = 0.02;

                            const changeDueBase = remaining < -paymentTolerance ? remainingAbs : 0;
                            const changeDueAlt = remainingAlt !== null && remainingAlt < -altTolerance ? remainingAltAbs : 0;
                            const shouldShowChange = changeDueBase > 0 || changeDueAlt > 0;

                            if (changeSection) {
                              toggleChangeSection(shouldShowChange);
                              if (!shouldShowChange) {
                                if (changeToggle) changeToggle.checked = false;
                                setChangeRowsEnabled(false);
                              }
                            }

                            if (changeHintEl) {
                              if (shouldShowChange) {
                                const hints = [];
                                if (changeDueBase > 0) hints.push(formatBaseMoney(changeDueBase));
                                if (changeDueAlt > 0 && altAvailable) hints.push(formatCurrencyValue(changeDueAlt, altCurrencyCode));
                                changeHintEl.textContent = hints.length ? `Sugerido: ${hints.join(' · ')}` : '';
                              } else {
                                changeHintEl.textContent = '';
                              }
                            }

                            if (remaining > paymentTolerance) {
                              remainingEl.textContent = `Faltan ${formatBaseMoney(remaining)}`;
                              remainingEl.classList.remove('text-emerald-600');
                              remainingEl.classList.add('text-amber-600');
                            } else if (remaining < -paymentTolerance) {
                              remainingEl.textContent = `Vuelto ${formatBaseMoney(remainingAbs)}`;
                              remainingEl.classList.remove('text-amber-600');
                              remainingEl.classList.add('text-emerald-600');
                            } else {
                              remainingEl.textContent = 'Completo';
                              remainingEl.classList.remove('text-amber-600');
                              remainingEl.classList.add('text-emerald-600');
                            }

                            if (remainingAltEl) {
                              if (!altAvailable || remainingAlt === null) {
                                remainingAltEl.textContent = '--';
                              } else if (remainingAlt > altTolerance) {
