              <input type="radio" name="ventas-vat-mode" value="add" class="cursor-pointer text-sky-600 focus:ring-sky-500" onchange="window.__ventasForceVatRecalc && window.__ventasForceVatRecalc(this.value)">
              Agregar
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-amber-200 bg-white px-2.5 py-2 text-slate-600 shadow-sm">
              <input type="radio" name="ventas-vat-mode" value="included" class="cursor-pointer text-sky-600 focus:ring-sky-500" onchange="window.__ventasForceVatRecalc && window.__ventasForceVatRecalc(this.value)">
              Invertido
            </label>
