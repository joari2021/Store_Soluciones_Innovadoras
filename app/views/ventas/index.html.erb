<script>
  (() => {
    if (!window.ventasPosBoundRoots) {
      window.ventasPosBoundRoots = new WeakSet();
    }

    const initVentasPOS = () => {
      const root = document.getElementById('ventas-pos-root');
      if (!root) return;
      if (window.ventasPosBoundRoots.has(root)) return;

      const hasOpenCashShift = root.dataset.openShift === 'true';
      const openCashShiftId = Number(root.dataset.openShiftId || 0);
      let canChargeSale = root.dataset.canChargeSale === 'true';
      let canViewAllDrafts = root.dataset.canViewAllDrafts === 'true';
      const currentUserId = Number(root.dataset.currentUserId || 0);
      let activeCashierId = Number(root.dataset.activeCashierId || 0);
      let activeCashierName = String(root.dataset.activeCashierName || '').trim();
      let activeCashierRoleLabel = String(root.dataset.activeCashierRoleLabel || '').trim();

      const productsDataEl = document.getElementById('ventas-products-data');
      if (!productsDataEl) return;
      window.ventasPosBoundRoots.add(root);

      let products = [];
      try {
        products = JSON.parse(productsDataEl.textContent || '[]');
      } catch (error) {
        products = [];
      }

      const servicesDataEl = document.getElementById('ventas-services-data');
      let services = [];
      if (servicesDataEl) {
        try {
          services = JSON.parse(servicesDataEl.textContent || '[]');
        } catch (error) {
          services = [];
        }
      }

      const accountsDataEl = document.getElementById('ventas-accounts-data');
      let accounts = [];
      if (accountsDataEl) {
        try {
          accounts = JSON.parse(accountsDataEl.textContent || '[]');
        } catch (error) {
          accounts = [];
        }
      }

      const cashBoxesDataEl = document.getElementById('ventas-cash-boxes-data');
      let cashBoxes = [];
      if (cashBoxesDataEl) {
        try {
          cashBoxes = JSON.parse(cashBoxesDataEl.textContent || '[]');
        } catch (error) {
          cashBoxes = [];
        }
      }

      const draftsDataEl = document.getElementById('ventas-drafts-data');
      let drafts = [];
      if (draftsDataEl) {
        try {
          drafts = JSON.parse(draftsDataEl.textContent || '[]');
        } catch (error) {
          drafts = [];
        }
      }

      const PAYMENT_SPECIAL_ORDER = ['biopago', 'pos', 'cashea'];

      const applyActiveCashierState = (activeCashier, options = {}) => {
        const syncHeader = options.syncHeader !== false;
        const canChargeOverride = options.canChargeSale;
        const canViewAllDraftsOverride = options.canViewAllDrafts;
        const previousCanViewAllDrafts = canViewAllDrafts;
        activeCashierId = Number(activeCashier?.id || 0);
        activeCashierName = String(activeCashier?.name || '').trim();
        activeCashierRoleLabel = String(activeCashier?.role_label || '').trim();

        if (typeof canChargeOverride === 'boolean') {
          canChargeSale = canChargeOverride;
          root.dataset.canChargeSale = canChargeSale ? 'true' : 'false';
        }

        if (typeof canViewAllDraftsOverride === 'boolean') {
          canViewAllDrafts = canViewAllDraftsOverride;
          root.dataset.canViewAllDrafts = canViewAllDrafts ? 'true' : 'false';
        }

        root.dataset.activeCashierId = activeCashierId > 0 ? String(activeCashierId) : '';
        root.dataset.activeCashierName = activeCashierName;
        root.dataset.activeCashierRoleLabel = activeCashierRoleLabel;

        if (!previousCanViewAllDrafts && canViewAllDrafts && activeDraftId && activeDraftCreatedById && currentUserId > 0 && activeDraftCreatedById !== currentUserId) {
          resetWorkingSale();
        }

        if (syncHeader && typeof window.updateHeaderCashierState === 'function') {
          window.updateHeaderCashierState(activeCashier || null);
        }
      };

      const fetchActiveCashierStatus = async () => {
        if (!hasOpenCashShift || !openCashShiftId || openCashShiftId <= 0) return null;
        const response = await fetch(`/cierres-turno/${openCashShiftId}/active_cashier_status?t=${Date.now()}`, {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        });

        if (!response.ok) return null;

        const payload = await response.json();
        applyActiveCashierState(payload.active_cashier || null, {
          canChargeSale: payload.can_charge_sale === true,
          canViewAllDrafts: payload.can_view_all_drafts === true,
        });
        return payload;
      };

      const onCashierUpdated = (event) => {
        const payload = event?.detail || {};
        if (!Object.prototype.hasOwnProperty.call(payload, 'activeCashier')) return;
        applyActiveCashierState(payload.activeCashier || null, {
          syncHeader: false,
          canChargeSale: payload.canChargeSale,
          canViewAllDrafts: payload.canViewAllDrafts,
        });
      };
      window.addEventListener('cashier:updated', onCashierUpdated);

      let cashierPollIntervalId = null;

      if (hasOpenCashShift && openCashShiftId > 0) {
        fetchActiveCashierStatus().catch(() => null);
        cashierPollIntervalId = window.setInterval(() => {
          fetchActiveCashierStatus().catch(() => null);
        }, 15000);
      }

      document.addEventListener('turbo:before-cache', () => {
        window.removeEventListener('cashier:updated', onCashierUpdated);
        if (cashierPollIntervalId) {
          window.clearInterval(cashierPollIntervalId);
          cashierPollIntervalId = null;
        }
      }, { once: true });

      const accountTypeKey = (account) => String(account?.account_type || '').toLowerCase();

      const isSpecialAccount = (account) => PAYMENT_SPECIAL_ORDER.includes(accountTypeKey(account));

      const paymentCurrencyPriority = (currency) => {
        const key = String(currency || '').toUpperCase();
        const priority = {
          VES: 0,
          USD: 1,
          EUR: 2,
          USDT: 3,
          BTC: 4,
          BNB: 5,
        };

        return Object.prototype.hasOwnProperty.call(priority, key) ? priority[key] : 99;
      };

      const paymentTypePriority = (account) => {
        const type = accountTypeKey(account);
        const specialIndex = PAYMENT_SPECIAL_ORDER.indexOf(type);
        if (specialIndex >= 0) return specialIndex;

        if (account?.is_bank || type === 'bank_account') return 100;
        if (type === 'cash_box') return 200;
        if (type === 'card') return 300;
        if (type === 'digital_wallet') return 400;
        if (type === 'crypto_wallet') return 500;

        return 900;
      };

      const orderAccountsForPaymentModal = (accountList) => {
        const list = Array.isArray(accountList) ? [...accountList] : [];

        return list.sort((a, b) => {
          const typePriorityDiff = paymentTypePriority(a) - paymentTypePriority(b);
          if (typePriorityDiff !== 0) return typePriorityDiff;

          const aIsBank = Boolean(a?.is_bank) || accountTypeKey(a) === 'bank_account';
          const bIsBank = Boolean(b?.is_bank) || accountTypeKey(b) === 'bank_account';

          if (aIsBank && bIsBank && Boolean(a?.is_primary) !== Boolean(b?.is_primary)) {
            return a?.is_primary ? -1 : 1;
          }

          const currencyDiff = paymentCurrencyPriority(a?.currency) - paymentCurrencyPriority(b?.currency);
          if (currencyDiff !== 0) return currencyDiff;

          return String(a?.name || '').localeCompare(String(b?.name || ''), 'es', { sensitivity: 'base' });
        });
      };

      const productsById = new Map(products.map((product) => [String(product.id), product]));
      const servicesById = new Map(services.map((service) => [String(service.id), service]));
      const accountsById = new Map(accounts.map((account) => [String(account.id), account]));
      const productsGrid = document.getElementById('ventas-product-grid');
      const servicesGrid = document.getElementById('ventas-service-grid');
      const productsNoResultsEl = document.getElementById('ventas-products-no-results');
      const servicesNoResultsEl = document.getElementById('ventas-services-no-results');
      const productsInfiniteSentinel = document.getElementById('ventas-products-infinite-sentinel');
      const servicesInfiniteSentinel = document.getElementById('ventas-services-infinite-sentinel');
      const productsCatalogUrl = String(root.dataset.productsCatalogUrl || '').trim();
      const servicesCatalogUrl = String(root.dataset.servicesCatalogUrl || '').trim();
      let nextProductsPage = Number.parseInt(root.dataset.productsNextPage || '', 10);
      let nextServicesPage = Number.parseInt(root.dataset.servicesNextPage || '', 10);
      let loadingProductsCatalog = false;
      let loadingServicesCatalog = false;
      let activeTab = 'products';
      let activeProductCategory = '';
      let activeServiceSystem = '';
      let catalogInfiniteObserver = null;
      const cart = new Map();
      const syncedReservedProductQuantities = new Map();
      const vatRate = 0.16;
      const paymentTolerance = 0.01;
      let selectedClient = null;
      let activeDraftId = null;
      let activeDraftCreatedById = null;
      let activeDraftVisibility = null;
      let activeDraftCheckoutStatus = null;
      let draftListFilter = 'pending';
      let draftSyncTimeout = null;
      let draftSyncedFingerprint = null;
      let draftSyncInProgress = false;
      let draftLoadInProgress = false;
      let liveProductsSyncInterval = null;
      let liveProductsSyncInFlight = false;

      const normalizeClientBenefits = (rawBenefits) => {
        const source = rawBenefits && typeof rawBenefits === 'object' ? rawBenefits : {};
        const productRulesRaw = source.product_rules && typeof source.product_rules === 'object'
          ? source.product_rules
          : {};
        const servicePricesRaw = source.service_fixed_prices && typeof source.service_fixed_prices === 'object'
          ? source.service_fixed_prices
          : {};

        const productRules = {};
        Object.entries(productRulesRaw).forEach(([key, rule]) => {
          const normalizedKey = String(key || '').trim();
          if (!normalizedKey || normalizedKey === 'null' || normalizedKey === 'undefined') return;
          if (!rule || typeof rule !== 'object') return;
          const mode = String(rule.mode || '').trim().toLowerCase();
          const value = Number(rule.value);
          if (!['fixed', 'percent'].includes(mode)) return;
          if (!(Number.isFinite(value) && value > 0)) return;
          productRules[normalizedKey] = {
            mode,
            value: mode === 'percent' ? Math.max(0, Math.min(100, value)) : value,
          };
        });

        const serviceFixedPrices = {};
        Object.entries(servicePricesRaw).forEach(([key, value]) => {
          const normalizedKey = String(key || '').trim();
          if (!normalizedKey || normalizedKey === 'null' || normalizedKey === 'undefined') return;
          const numeric = Number(value);
          if (!(Number.isFinite(numeric) && numeric > 0)) return;
          serviceFixedPrices[normalizedKey] = numeric;
        });

        const generalDiscount = Number(source.general_product_discount_percent);

        return {
          general_product_discount_percent: Number.isFinite(generalDiscount)
            ? Math.max(0, Math.min(100, generalDiscount))
            : 0,
          product_rules: productRules,
          service_fixed_prices: serviceFixedPrices,
        };
      };

      const clientHasBenefits = (client) => {
        const benefits = normalizeClientBenefits(client?.benefits || {});
        return benefits.general_product_discount_percent > 0
          || Object.keys(benefits.product_rules).length > 0
          || Object.keys(benefits.service_fixed_prices).length > 0;
      };

      const resolveProductUnitPriceUsdForClient = (product, client) => {
        const basePrice = Number(product?.price_usd || 0);
        if (!(Number.isFinite(basePrice) && basePrice > 0)) return 0;
        if (!client) return basePrice;

        const benefits = normalizeClientBenefits(client.benefits || {});
        const productRule = benefits.product_rules[String(product.id)];

        if (productRule) {
          if (productRule.mode === 'fixed') return roundTo(Number(productRule.value) || 0, 2);
          if (productRule.mode === 'percent') {
            return roundTo(basePrice * (1 - (Number(productRule.value) || 0) / 100), 2);
          }
        }

        const generalDiscount = Number(benefits.general_product_discount_percent || 0);
        if (generalDiscount > 0) {
          return roundTo(basePrice * (1 - generalDiscount / 100), 2);
        }

        return basePrice;
      };

      const resolveServiceFixedUnitPriceUsdForClient = (service, client) => {
        if (!client || !service) return null;
        const benefits = normalizeClientBenefits(client.benefits || {});
        const fixed = Number(benefits.service_fixed_prices[String(service.id)]);
        if (!(Number.isFinite(fixed) && fixed > 0)) return null;
        return roundTo(fixed, 2);
      };

      const normalizeScheduledDiscountRules = (rawRules) => {
        if (!Array.isArray(rawRules)) return [];

        return rawRules
          .map((rule) => {
            const quantityMode = String(rule?.quantity_mode || '').trim();
            const quantityThreshold = Number(rule?.quantity_threshold || 0);
            const discountMode = String(rule?.discount_mode || '').trim();
            const discountValue = Number(rule?.discount_value || 0);
            const fixedCurrency = String(rule?.fixed_currency || 'USD').trim().toUpperCase();

            if (!['exact_quantity', 'from_quantity'].includes(quantityMode)) return null;
            if (!['percent', 'fixed_amount'].includes(discountMode)) return null;
            if (!(Number.isFinite(quantityThreshold) && quantityThreshold > 0)) return null;
            if (!(Number.isFinite(discountValue) && discountValue > 0)) return null;

            return {
              id: rule?.id,
              quantity_mode: quantityMode,
              quantity_threshold: quantityThreshold,
              discount_mode: discountMode,
              discount_value: discountValue,
              fixed_currency: fixedCurrency,
            };
          })
          .filter(Boolean);
      };

      const resolveScheduledDiscountRule = (rules, quantity) => {
        const normalizedRules = normalizeScheduledDiscountRules(rules);
        if (!normalizedRules.length) return null;

        const qty = Number(quantity || 0);
        if (!(Number.isFinite(qty) && qty > 0)) return null;

        const applicable = normalizedRules.filter((rule) => {
          if (rule.quantity_mode === 'exact_quantity') return qty === Number(rule.quantity_threshold);
          return qty >= Number(rule.quantity_threshold);
        });

        if (!applicable.length) return null;

        applicable.sort((a, b) => {
          const thresholdDiff = Number(b.quantity_threshold) - Number(a.quantity_threshold);
          if (thresholdDiff !== 0) return thresholdDiff;
          return Number(b.id || 0) - Number(a.id || 0);
        });

        return applicable[0];
      };

      const applyScheduledDiscountRuleToUnitPriceUsd = (unitPriceUsd, quantity, rules) => {
        const baseUnit = Number(unitPriceUsd || 0);
        if (!(Number.isFinite(baseUnit) && baseUnit > 0)) return 0;

        const rule = resolveScheduledDiscountRule(rules, quantity);
        if (!rule) return roundTo(baseUnit, 6);

        if (rule.discount_mode === 'percent') {
          const percent = Math.max(0, Math.min(100, Number(rule.discount_value || 0)));
          return roundTo(Math.max(0, baseUnit * (1 - percent / 100)), 6);
        }

        let fixedUnitPriceUsd = Number(rule.discount_value || 0);
        if (String(rule.fixed_currency || 'USD') === 'VES') {
          if (!(bcvRate > 0)) return roundTo(baseUnit, 6);
          fixedUnitPriceUsd = fixedUnitPriceUsd / bcvRate;
        }

        return roundTo(Math.max(0, fixedUnitPriceUsd), 6);
      };

      const applyScheduledDiscountRuleToUnitPriceBase = (unitPriceBase, quantity, rules, targetCurrency = 'VES') => {
        const baseUnit = Number(unitPriceBase || 0);
        if (!(Number.isFinite(baseUnit) && baseUnit > 0)) return 0;

        const rule = resolveScheduledDiscountRule(rules, quantity);
        if (!rule) return roundTo(baseUnit, 2);

        if (rule.discount_mode === 'percent') {
          const percent = Math.max(0, Math.min(100, Number(rule.discount_value || 0)));
          return roundTo(Math.max(0, baseUnit * (1 - percent / 100)), 2);
        }

        let fixedUnitPrice = Number(rule.discount_value || 0);
        const fixedCurrency = String(rule.fixed_currency || 'USD').trim().toUpperCase();
        const targetCode = String(targetCurrency || 'VES').trim().toUpperCase();

        if (fixedCurrency !== targetCode) {
          const converted = convertAmount(fixedUnitPrice, fixedCurrency, targetCode);
          if (converted === null) return roundTo(baseUnit, 2);
          fixedUnitPrice = converted;
        }

        return roundTo(Math.max(0, fixedUnitPrice), 2);
      };

      const saveDraftButton = document.getElementById('ventas-save-draft-button');
      const clearPanelButton = document.getElementById('ventas-clear-panel-button');
      const draftsListEl = document.getElementById('ventas-drafts-list');
      const draftsEmptyEl = document.getElementById('ventas-drafts-empty');
      const draftsCountEl = document.getElementById('ventas-drafts-count');
      const draftsReadyFilterButton = document.getElementById('ventas-drafts-ready-filter');
      const draftsPendingFilterButton = document.getElementById('ventas-drafts-pending-filter');
      const cartToggleButton = document.getElementById('ventas-cart-toggle');
      const cartCountBadge = document.getElementById('ventas-cart-count');
      const cartModal = document.getElementById('ventas-cart-modal');
      const cartBackdrop = document.getElementById('ventas-cart-backdrop');
      const cartPanel = document.getElementById('ventas-cart-panel');
      const cartCloseButton = document.getElementById('ventas-cart-close');

      const parseRate = (value) => {
        if (!value) return 0;
        const normalized = String(value).replace(',', '.');
        const parsed = Number.parseFloat(normalized);
        if (!Number.isFinite(parsed)) return 0;
        return Math.round(parsed * 100) / 100;
      };

      const bcvRate = parseRate(root.dataset.bcvRate);

      let baseCurrency = 'ves';
      const getBaseCurrencyInputs = () => Array.from(root.querySelectorAll('input[name="ventas-base-currency"]'));
      const checkedBase = getBaseCurrencyInputs().find((input) => input.checked);
      if (checkedBase) baseCurrency = checkedBase.value;
      root.dataset.baseCurrency = baseCurrency === 'ves' ? 'VES' : 'USD';
      const getSelectedBaseCurrency = () => {
        const checked = getBaseCurrencyInputs().find((input) => input.checked && !input.disabled);
        if (checked && (checked.value === 'ves' || checked.value === 'usd')) return checked.value;
        return baseCurrency === 'ves' ? 'ves' : 'usd';
      };
      if (bcvRate <= 0) {
        getBaseCurrencyInputs().forEach((input) => {
          if (input.value === 'ves') {
            input.disabled = true;
            input.closest('label')?.classList.add('opacity-50');
          }
        });
      }

      if (baseCurrency === 'ves' && bcvRate <= 0) {
        baseCurrency = 'usd';
        getBaseCurrencyInputs().forEach((input) => {
          input.checked = input.value === 'usd';
        });
      }

      const roundTo = (value, digits = 2) => {
        const factor = 10 ** digits;
        return Math.round((Number(value) || 0) * factor) / factor;
      };

      const normalizeSearchValue = (value) =>
        String(value || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();

      const normalizeVariationId = (value) => {
        if (value === null || value === undefined) return null;
        if (value === '' || value === 'null') return null;
        return String(value);
      };

      const normalizeItemType = (value) => (value === 'service' ? 'service' : 'product');

      const normalizeCurrencyCode = (value) => String(value || '').trim().toUpperCase();
      const isUsdCurrency = (currency) => ['USD', 'USDT'].includes(currency);

      const convertUsdToBase = (usdValue) => {
        if (baseCurrency === 'usd') return roundTo(Number(usdValue) || 0, 2);
        if (bcvRate <= 0) return 0;
        return roundTo((Number(usdValue) || 0) * bcvRate, 2);
      };

      const convertBaseToUsd = (baseValue) => {
        if (baseCurrency === 'usd') return roundTo(Number(baseValue) || 0, 2);
        if (bcvRate <= 0) return 0;
        return roundTo((Number(baseValue) || 0) / bcvRate, 2);
      };

      const convertAmount = (amount, fromCurrency, toCurrency) => {
        const fromCode = normalizeCurrencyCode(fromCurrency);
        const toCode = normalizeCurrencyCode(toCurrency);
        const numeric = Number(amount) || 0;

        if (fromCode === toCode) return roundTo(numeric, 2);
        if (isUsdCurrency(fromCode) && toCode === 'VES') return bcvRate > 0 ? roundTo(numeric * bcvRate, 2) : null;
        if (fromCode === 'VES' && isUsdCurrency(toCode)) return bcvRate > 0 ? roundTo(numeric / bcvRate, 2) : null;
        if (isUsdCurrency(fromCode) && isUsdCurrency(toCode)) return roundTo(numeric, 2);
        return null;
      };

      const formatNumber = (value, digits = 2) => {
        const amount = Number.isFinite(value) ? value : 0;
        return amount.toLocaleString('es-VE', {
          minimumFractionDigits: digits,
          maximumFractionDigits: digits,
        });
      };

      const formatMoney = (value, unit = '$') => `${unit}${formatNumber(value)}`;
      const formatMoneyBs = (value) => (bcvRate > 0 ? formatMoney(value * bcvRate, 'Bs ') : 'Bs --');
      const formatBaseMoney = (value) => (baseCurrency === 'usd' ? formatMoney(value, '$') : formatMoney(value, 'Bs '));
      const formatAltFromBase = (value) => {
        if (baseCurrency === 'usd') return formatMoneyBs(value);
        return bcvRate > 0 ? formatMoney(convertBaseToUsd(value), '$') : '$--';
      };
      const formatCurrencyValue = (value, currencyCode) => {
        if (currencyCode === 'VES') return formatMoney(value, 'Bs ');
        return formatMoney(value, '$');
      };

      const normalizeServiceName = (value) =>
        String(value || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();

      const normalizeServiceGroupingName = (service) => normalizeServiceName(
        service?.sale_display_name || service?.name || service?.description || service?.system_name || ''
      );

      const resolvePrintVolumeDiscountPercent = (service) => {
        if (!service?.printing_type_service) return 0;
        const rules = Array.isArray(service.print_volume_discounts) ? service.print_volume_discounts : [];
        if (rules.length === 0) return 0;

        const serviceKey = normalizeServiceGroupingName(service);
        if (!serviceKey) return 0;

        let totalQty = 0;
        cart.forEach((entry) => {
          if ((entry.itemType || 'product') !== 'service') return;
          const entryService = servicesById.get(String(entry.serviceId));
          if (!entryService || !entryService.printing_type_service) return;
          const entryKey = normalizeServiceGroupingName(entryService);
          if (!entryKey || entryKey !== serviceKey) return;
          totalQty += Number(entry.quantity) || 0;
        });

        if (!(totalQty > 0)) return 0;

        let best = 0;
        rules.forEach((rule) => {
          const minQty = Number(rule.min_quantity);
          const percent = Number(rule.discount_percent);
          if (!(minQty > 0) || !(percent > 0)) return;
          if (totalQty >= minQty && percent > best) best = percent;
        });

        return best > 0 ? best : 0;
      };

      const isRecargaService = (service) => {
        if (!service) return false;
        if (service.recarga_service === true) return true;
        const systemName = normalizeServiceName(service.system_name);
        return systemName.includes('recarga');
      };

      const isPayallAccount = (account) => normalizeServiceName(account?.name).includes('payall');

      const findPayallAccount = () => {
        return accounts.find((account) => isPayallAccount(account)) || null;
      };

      const recargaReservedInCart = () => {
        let total = 0;
        cart.forEach((item) => {
          if ((item.itemType || 'product') !== 'service') return;
          const amount = Number(item.recarga_base_amount || 0);
          if (Number.isFinite(amount) && amount > 0) total += amount;
        });
        return roundTo(total, 2);
      };

      const normalizeBaseCurrencySelection = (value) => (String(value || '').trim().toLowerCase() === 'ves' ? 'ves' : 'usd');
      const currentBaseCurrencyCode = () => (baseCurrency === 'ves' ? 'VES' : 'USD');

      const resolveServiceBaseSnapshotForCurrency = (item, service, targetCurrency = baseCurrency) => {
        const normalizedCurrency = normalizeBaseCurrencySelection(targetCurrency);
        const targetCode = normalizedCurrency === 'ves' ? 'VES' : 'USD';
        const fallbackBaseAmount = Number(item?.unit_price_base_amount);
        const fallbackBaseCurrency = normalizeCurrencyCode(item?.unit_price_base_currency);
        let unitPriceUsd = Number(item?.unit_price_usd);
        let unitPriceBaseAmount = null;

        if (service?.printing_type_service) {
          const baseUnitBs = Number(item?.selected_print_unit_price_bs);
          if (Number.isFinite(baseUnitBs) && baseUnitBs > 0) {
            const resolvedUnitBs = roundTo(baseUnitBs, 2);
            unitPriceUsd = bcvRate > 0 ? roundTo(resolvedUnitBs / bcvRate, 6) : unitPriceUsd;
            unitPriceBaseAmount = normalizedCurrency === 'ves'
              ? resolvedUnitBs
              : (bcvRate > 0 ? roundTo(resolvedUnitBs / bcvRate, 2) : null);
          }
        }

        if (!(Number.isFinite(unitPriceBaseAmount) && unitPriceBaseAmount > 0) && Number.isFinite(fallbackBaseAmount) && fallbackBaseAmount > 0) {
          if (fallbackBaseCurrency === targetCode) {
            unitPriceBaseAmount = roundTo(fallbackBaseAmount, 2);
          } else {
            const convertedBaseAmount = convertAmount(fallbackBaseAmount, fallbackBaseCurrency, targetCode);
            if (Number.isFinite(convertedBaseAmount) && convertedBaseAmount > 0) {
              unitPriceBaseAmount = roundTo(convertedBaseAmount, 2);
            }
          }
        }

        if (!(Number.isFinite(unitPriceBaseAmount) && unitPriceBaseAmount > 0) && Number.isFinite(unitPriceUsd) && unitPriceUsd > 0) {
          unitPriceBaseAmount = normalizedCurrency === 'ves'
            ? (bcvRate > 0 ? roundTo(unitPriceUsd * bcvRate, 2) : null)
            : roundTo(unitPriceUsd, 2);
        }

        return {
          unitPriceUsd: Number.isFinite(unitPriceUsd) && unitPriceUsd > 0 ? unitPriceUsd : 0,
          unitPriceBaseAmount: Number.isFinite(unitPriceBaseAmount) && unitPriceBaseAmount > 0 ? roundTo(unitPriceBaseAmount, 2) : null,
          unitPriceBaseCurrency: targetCode,
        };
      };

      const syncCartBaseCurrencySnapshots = (targetCurrency = baseCurrency) => {
        const normalizedCurrency = normalizeBaseCurrencySelection(targetCurrency);
        cart.forEach((item, key) => {
          if ((item.itemType || 'product') !== 'service') return;
          const service = servicesById.get(String(item.serviceId));
          if (!service) return;

          const snapshot = resolveServiceBaseSnapshotForCurrency(item, service, normalizedCurrency);
          item.unit_price_usd = snapshot.unitPriceUsd;
          item.unit_price_base_amount = snapshot.unitPriceBaseAmount;
          item.unit_price_base_currency = snapshot.unitPriceBaseCurrency;
          cart.set(key, item);
        });
      };

      const applyBaseCurrencySelection = (nextCurrency, options = {}) => {
        const normalizedCurrency = normalizeBaseCurrencySelection(nextCurrency);
        const shouldSyncInputs = options.syncInputs !== false;
        const shouldSyncCart = options.syncCart !== false;
        const shouldRender = options.render !== false;

        baseCurrency = normalizedCurrency;
        root.dataset.baseCurrency = currentBaseCurrencyCode();

        if (shouldSyncInputs) {
          getBaseCurrencyInputs().forEach((input) => {
            input.checked = input.value === normalizedCurrency;
          });
        }

        if (shouldSyncCart) {
          syncCartBaseCurrencySnapshots(normalizedCurrency);
        }

        if (shouldRender) {
          renderCart();
        }
      };

      const normalizeServiceReferenceName = (service) => {
        const raw = String(service?.currency_base_price || '').trim();
        if (!raw) return 'Dolar BCV';
        return raw === '$' ? 'Dolar BCV' : raw;
      };

      const resolveServiceReferenceSymbol = (service, referenceName = null) => {
        const normalizedReference = referenceName || normalizeServiceReferenceName(service);
        const rawSymbol = String(service?.currency_symbol || '').trim();
        if (rawSymbol.length > 0) return rawSymbol;
        return normalizedReference === 'Bs' ? 'Bs' : '$';
      };

      const resolveServiceReferenceRateBs = (service, referenceName = null) => {
        const normalizedReference = referenceName || normalizeServiceReferenceName(service);
        const payloadRate = Number(service?.reference_rate_bs);
        if (Number.isFinite(payloadRate) && payloadRate > 0) return payloadRate;
        if (normalizedReference === 'Bs') return 1;
        if (normalizedReference === 'Dolar BCV') return bcvRate > 0 ? bcvRate : 0;
        return 0;
      };

      const serviceUsesBolivarReference = (service) => {
        const normalizedReference = normalizeServiceReferenceName(service);
        return normalizedReference === 'Bs' || normalizedReference === 'Unidad VI';
      };

      const computeOnRequestServiceAmounts = ({ service, referenceAmount }) => {
        const normalizedReference = normalizeServiceReferenceName(service);
        const referenceSymbol = resolveServiceReferenceSymbol(service, normalizedReference);
        const referenceRateBs = resolveServiceReferenceRateBs(service, normalizedReference);

        if (!(referenceAmount > 0)) {
          return { error: 'Indica un precio valido mayor a 0.' };
        }

        if (normalizedReference === 'Bs' && !(bcvRate > 0)) {
          return { error: 'No hay tasa BCV disponible para convertir precios en Bs.' };
        }

        if (normalizedReference !== 'Bs' && normalizedReference !== 'Dolar BCV' && !(referenceRateBs > 0)) {
          return { error: `No hay tasa disponible para ${normalizedReference}.` };
        }

        let amountBs = 0;
        let unitPriceUsd = 0;

        if (normalizedReference === 'Bs') {
          amountBs = referenceAmount;
          unitPriceUsd = referenceAmount / bcvRate;
        } else if (normalizedReference === 'Dolar BCV') {
          unitPriceUsd = referenceAmount;
          amountBs = referenceAmount * (referenceRateBs > 0 ? referenceRateBs : bcvRate);
        } else {
          if (!(bcvRate > 0)) {
            return { error: 'No hay tasa BCV disponible para convertir el precio acordado.' };
          }
          amountBs = referenceAmount * referenceRateBs;
          unitPriceUsd = amountBs / bcvRate;
        }

        if (!(unitPriceUsd > 0)) {
          return { error: 'No se pudo calcular el precio del servicio.' };
        }

        const invoiceCurrencyCode = currentBaseCurrencyCode();
        const invoiceUnitAmountRaw = invoiceCurrencyCode === 'USD' ? unitPriceUsd : amountBs;
        const invoiceUnitAmount = roundTo(invoiceUnitAmountRaw, 2);

        return {
          unitPriceUsd: roundTo(unitPriceUsd, 6),
          invoiceCurrencyCode,
          invoiceUnitAmount,
          priceSignature: `${invoiceCurrencyCode}:${invoiceUnitAmount.toFixed(2)}`,
          priceDisplay: formatCurrencyValue(invoiceUnitAmount, invoiceCurrencyCode),
          referenceName: normalizedReference,
          referenceSymbol,
          referenceAmount: roundTo(referenceAmount, 2),
        };
      };

      const parseMoneyInput = (input) => {
        if (!input) return 0;
        if (window.MoneyInputMask?.parseValue) return window.MoneyInputMask.parseValue(input);
          const raw = String(input.value || '').replace(/\s/g, '').replace(/[^\d.,-]/g, '');
        const normalized = raw.includes(',') ? raw.replace(/\./g, '').replace(',', '.') : raw;
        const parsed = Number.parseFloat(normalized);
        return Number.isFinite(parsed) ? parsed : 0;
      };

      const setMoneyInputValue = (input, value, symbol) => {
        if (!input) return;
        if (window.MoneyInputMask?.setValue) {
          window.MoneyInputMask.setValue(input, value, symbol);
          return;
        }
        input.value = formatMoney(value, symbol || '$');
        if (symbol) input.dataset.moneySymbol = symbol;
      };

      const initMoneyMasks = (rootEl) => {
        if (window.MoneyInputMask?.init) {
          window.MoneyInputMask.init(rootEl || document);
        }
      };

      const padDatePart = (value) => String(value).padStart(2, '0');

      const formatDisplayDate = (date) => {
        if (!(date instanceof Date)) return '';
        return `${padDatePart(date.getDate())}-${padDatePart(date.getMonth() + 1)}-${date.getFullYear()}`;
      };

      const formatIsoDate = (date) => {
        if (!(date instanceof Date)) return '';
        return `${date.getFullYear()}-${padDatePart(date.getMonth() + 1)}-${padDatePart(date.getDate())}`;
      };

      const parsePaymentDateInput = (rawValue) => {
        const normalized = String(rawValue || '').trim();
        if (!normalized) return null;

        const isoMatch = normalized.match(/^(\d{4})-(\d{2})-(\d{2})$/);
        if (isoMatch) {
          const year = Number(isoMatch[1]);
          const month = Number(isoMatch[2]);
          const day = Number(isoMatch[3]);
          const parsedDate = new Date(year, month - 1, day);

          if (
            parsedDate.getFullYear() !== year ||
            parsedDate.getMonth() !== month - 1 ||
            parsedDate.getDate() !== day
          ) {
            return null;
          }

          return parsedDate;
        }

        const displayMatch = normalized.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);
        if (!displayMatch) return null;

        const day = Number(displayMatch[1]);
        const month = Number(displayMatch[2]);
        const year = Number(displayMatch[3]);
        const parsedDate = new Date(year, month - 1, day);

        if (
          parsedDate.getFullYear() !== year ||
          parsedDate.getMonth() !== month - 1 ||
          parsedDate.getDate() !== day
        ) {
          return null;
        }

        return parsedDate;
      };

      const normalizePaymentDateInput = (rawValue) => {
        const parsedDate = parsePaymentDateInput(rawValue);
        if (!parsedDate) return null;

        return {
          date: parsedDate,
          display: formatDisplayDate(parsedDate),
          iso: formatIsoDate(parsedDate),
        };
      };

      const openPaymentModalWithConfig = (config = {}) => {
        const modalTotals = config.totals || {};
        const totalBase = Number(modalTotals.totalBase || 0);
        const subtotalBase = Number(modalTotals.subtotalBase || 0);
        const exentoBase = Number(modalTotals.exentoBase || 0);
        const vatBase = Number(modalTotals.vatBase || 0);
        const vatLabel = String(config.vatLabel || 'Sin IVA');
        const allowCredit = config.allowCredit !== false;
        const allowChange = config.allowChange !== false;
        const allowedAccountFilter = typeof config.allowedAccountFilter === 'function'
          ? config.allowedAccountFilter
          : null;
        const accountsList = Array.isArray(config.accountsList) ? config.accountsList : accounts;
        const filteredAccounts = allowedAccountFilter
          ? accountsList.filter((account) => allowedAccountFilter(account))
          : accountsList;
        const visiblePaymentAccounts = filteredAccounts.filter((account) => !isPayallAccount(account));
        const orderedAccounts = orderAccountsForPaymentModal(visiblePaymentAccounts);
        const specialAccounts = orderedAccounts.filter((account) => isSpecialAccount(account));
        const bankAccounts = orderedAccounts.filter((account) => account.is_bank);
        const cashAccounts = orderedAccounts.filter((account) => {
          const type = accountTypeKey(account);
          return !account.is_bank && !isSpecialAccount(account) && type === 'cash_box';
        });
        const typedOtherAccounts = orderedAccounts.filter((account) => {
          const type = accountTypeKey(account);
          return !account.is_bank && !isSpecialAccount(account) && type !== 'cash_box';
        });

        const primaryBankAccount = bankAccounts.find((account) => account.is_primary);
        const previousBaseCurrency = baseCurrency;
        if (config.baseCurrencyOverride) {
          applyBaseCurrencySelection(config.baseCurrencyOverride, { syncInputs: false, syncCart: false, render: false });
        }
        const baseCurrencyCode = baseCurrency === 'ves' ? 'VES' : 'USD';

        const todayPaymentDate = formatDisplayDate(new Date());

        const capturePaymentModalState = (dialog) => {
          if (!dialog) return null;

          const payments = Array.from(dialog.querySelectorAll('[data-pay-row]')).map((row) => {
            const accountId = row.dataset.payRow;
            return {
              accountId: String(accountId),
              checked: Boolean(row.querySelector(`[data-pay-check="${accountId}"]`)?.checked),
              amount: row.querySelector(`[data-pay-input="${accountId}"]`)?.value || '',
              method: row.querySelector(`[data-pay-bank-method="${accountId}"]`)?.value || '',
              reference: row.querySelector(`[data-pay-reference="${accountId}"]`)?.value || '',
              paymentDate: row.querySelector(`[data-pay-date="${accountId}"]`)?.value || '',
            };
          });

          const changeToggle = dialog.querySelector('[data-change-toggle]');
          const creditToggle = dialog.querySelector('[data-credit-toggle]');
          const creditDueOnInput = dialog.querySelector('[data-credit-due-on]');
          const extraPayments = Array.from(dialog.querySelectorAll('[data-pay-multi-entry]')).map((entry) => ({
            accountId: entry.dataset.payMultiEntry || '',
            amount: entry.querySelector('[data-pay-multi-amount]')?.value || '',
            method: entry.querySelector('[data-pay-multi-method]')?.value || '',
            paymentDate: entry.querySelector('[data-pay-multi-date]')?.value || '',
            reference: entry.querySelector('[data-pay-multi-reference]')?.value || '',
          }));
          const change = Array.from(dialog.querySelectorAll('[data-change-row]')).map((row) => {
            const accountId = row.dataset.changeRow;
            return {
              accountId: String(accountId),
              checked: Boolean(row.querySelector(`[data-change-check="${accountId}"]`)?.checked),
              amount: row.querySelector(`[data-change-input="${accountId}"]`)?.value || '',
              method: row.querySelector(`[data-change-bank-method="${accountId}"]`)?.value || '',
              reference: row.querySelector(`[data-change-reference="${accountId}"]`)?.value || '',
            };
          });

          const showExtraBankAccounts = Array.from(dialog.querySelectorAll('[data-bank-extra="true"]'))
            .some((row) => !row.classList.contains('hidden'));

          return {
            payments,
            extraPayments,
            change,
            changeEnabled: Boolean(changeToggle?.checked),
            creditEnabled: Boolean(creditToggle?.checked),
            creditDueOn: creditDueOnInput?.value || '',
            showExtraBankAccounts,
          };
        };

        const buildPaymentRow = (account, options = {}) => {
          const symbol = account.currency_symbol || account.currency;
          const isBank = account.is_bank;
          const accountType = String(account.account_type || '').toLowerCase();
          const allowMultiPayments = accountType !== 'cash_box';
          const paymentMethodImageUrl = String(account.payment_method_image_url || '').trim();
          const logoUrl = String(account.small_logo_url || account.logo_url || '').trim();
          const hasPaymentMethodImage = paymentMethodImageUrl.length > 0;
          const hasLogo = logoUrl.length > 0;
          const bankFieldsClass = isBank ? 'ventas-pay-bank-fields' : 'hidden';
          const extraClass = options.extra ? ' hidden' : '';
          const extraAttr = options.extra ? ' data-bank-extra="true"' : '';
          const cardClasses = 'ventas-pay-accordion rounded-2xl border border-slate-200 bg-white/95 p-3.5 shadow-sm transition-all';
          const inputClass = 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400';
          const bankSelectClass = 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-500 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400';
          const bankFieldClass = 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-slate-50/70 px-3 py-2 text-sm text-slate-700 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400';
          const equivalentClass = 'ventas-pay-equivalent text-xs font-medium text-slate-500';
          const methodImageHtml = hasPaymentMethodImage
            ? `<div class="ventas-pay-method-image">
                <img src="${escapeHtml(paymentMethodImageUrl)}" alt="Imagen del metodo de pago" loading="lazy" data-pay-method-image>
              </div>`
            : `<div class="ventas-pay-method-image ventas-pay-method-image--fallback" aria-hidden="true">
                <div class="ventas-pay-method-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 10h18"></path>
                    <path d="M4 20h16a1 1 0 0 0 1-1v-8a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v8a1 1 0 0 0 1 1z"></path>
                    <path d="M7 20v-4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v4"></path>
                  </svg>
                </div>
              </div>`;
          return `
            <div class="${cardClasses}${extraClass}" data-pay-row="${account.id}"${extraAttr}>
              <input type="checkbox" class="ventas-pay-checkbox" data-pay-check="${account.id}">
              <div class="flex items-center gap-2">
                <button type="button" class="ventas-pay-accordion-toggle flex-1" data-pay-toggle="${account.id}">
                  <span class="ventas-pay-avatar" aria-hidden="true">
                    ${hasLogo
                      ? `<img src="${escapeHtml(logoUrl)}" alt="Logo de la cuenta" loading="lazy">`
                      : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M3 10h18"></path>
                          <path d="M4 20h16a1 1 0 0 0 1-1v-8a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v8a1 1 0 0 0 1 1z"></path>
                          <path d="M7 20v-4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v4"></path>
                        </svg>`}
                  </span>
                  <span class="ventas-pay-title" data-pay-account-label>${escapeHtml(account.display_name || account.name)}</span>
                  <span class="ventas-pay-chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 9l6 6 6-6"></path>
                    </svg>
                  </span>
                </button>
              </div>
              <div class="ventas-pay-accordion-content" data-pay-content>
                <div class="ventas-pay-fields${isBank ? ' ventas-pay-fields--bank' : ''}">
                  <div class="ventas-pay-amount">
                    <input type="text" inputmode="decimal" autocomplete="off" placeholder="${escapeHtml(symbol)} 0,00" class="${inputClass}" data-pay-input="${account.id}" data-money-mask="true" data-money-symbol="${escapeHtml(symbol)}" disabled>
                    <p class="${equivalentClass}" data-pay-equivalent="${account.id}"></p>
                  </div>
                  <div class="${bankFieldsClass}" data-pay-bank-fields="${account.id}">
                    <select class="${bankSelectClass}" data-bank-method-select="true" data-pay-bank-method="${account.id}" disabled>
                      <option value="" style="color:#94a3b8;background:#ffffff;">Metodo</option>
                      <option value="transfer" style="color:#0369a1;background:#ffffff;">Transferencia</option>
                      <option value="mobile" style="color:#0369a1;background:#ffffff;">Pago movil</option>
                    </select>
                    <input type="text" class="${bankFieldClass} js-materialize-datepicker materialize-datepicker-input" placeholder="dd-mm-aaaa" data-pay-date="${account.id}" value="${todayPaymentDate}" disabled>
                    <input type="text" inputmode="numeric" maxlength="4" minlength="4" pattern="[0-9]{4}" title="La referencia debe tener exactamente 4 digitos" class="${bankFieldClass}" placeholder="Ultimos 4 digitos" data-pay-reference="${account.id}" disabled>
                  </div>
                </div>
                ${allowMultiPayments
                  ? `<div class="mt-2 border-t border-slate-200 pt-2">
                      <div class="flex items-center justify-between gap-2">
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Pagos adicionales</p>
                        <button type="button" class="inline-flex items-center rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700 hover:bg-sky-100" data-pay-multi-add="${account.id}" title="Agregar otro pago del mismo metodo">+ pago</button>
                      </div>
                      <div class="mt-2 space-y-2" data-pay-multi-list="${account.id}"></div>
                    </div>`
                  : ''}
                ${methodImageHtml}
              </div>
            </div>
          `;
        };

        const buildChangeRow = (account) => {
          const symbol = account.currency_symbol || account.currency;
          const isBank = account.is_bank;
          const paymentMethodImageUrl = String(account.payment_method_image_url || '').trim();
          const hasPaymentMethodImage = paymentMethodImageUrl.length > 0;
          const normalizedAccountType = String(account.account_type || '').toLowerCase();
          const typeLabelMap = {
            bank_account: 'Banco',
            cash_box: 'Efectivo',
            card: 'Tarjeta',
            pos: 'Punto de venta',
            biopago: 'Biopago',
            cashea: 'Cashea',
            digital_wallet: 'Billetera digital',
            crypto_wallet: 'Billetera cripto',
          };
          const accountTypeLabel = typeLabelMap[normalizedAccountType] || account.account_type || 'Cuenta';
          const hideTypeBadge = ['biopago', 'pos', 'cashea'].includes(normalizedAccountType);
          const bankFieldsClass = isBank ? '' : 'hidden';
          const rowClasses = 'rounded-2xl border border-amber-200 bg-white/95 p-3.5 shadow-sm transition-all';
          const rowStyle = hasPaymentMethodImage
            ? ` style="background-image: url('${escapeCssUrl(paymentMethodImageUrl)}'); background-size: cover; background-position: center; background-repeat: no-repeat; background-color: #ffffff;"`
            : '';
          const labelClass = hasPaymentMethodImage ? 'text-slate-800' : 'text-slate-700';
          const labelSurfaceClass = hasPaymentMethodImage
            ? 'rounded-xl bg-white/80 px-2.5 py-1.5 shadow-sm ring-1 ring-white/80 backdrop-blur-[1px]'
            : '';
          const checkClass = hasPaymentMethodImage
            ? 'mt-0.5 h-4 w-4 cursor-pointer rounded border border-slate-300 bg-white text-amber-600 shadow-sm'
            : 'mt-0.5 h-4 w-4 cursor-pointer text-amber-600';
          const typeBadgeClass = hasPaymentMethodImage
            ? 'bg-white/90 text-amber-700 ring-1 ring-amber-200 backdrop-blur-[1px]'
            : 'bg-amber-50 text-amber-700 ring-1 ring-amber-200';
          const currencyBadgeClass = hasPaymentMethodImage
            ? 'bg-white/90 text-amber-700 ring-1 ring-amber-200 shadow-sm backdrop-blur-[1px]'
            : 'bg-amber-50 text-amber-700 ring-1 ring-amber-200';
          const inputClass = hasPaymentMethodImage
            ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-700 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500'
            : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-amber-50/40 px-3 py-2 text-sm text-slate-700 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400';
          const bankSelectClass = hasPaymentMethodImage
            ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-500 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500'
            : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-amber-50/40 px-3 py-2 text-sm text-slate-400 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400';
          const bankFieldClass = hasPaymentMethodImage
            ? 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-white/86 px-3 py-2 text-sm text-slate-700 shadow-sm backdrop-blur-[1px] disabled:cursor-not-allowed disabled:border-transparent disabled:bg-white/70 disabled:text-slate-500'
            : 'ventas-payment-modal-field w-full rounded-xl border border-transparent bg-amber-50/40 px-3 py-2 text-sm text-slate-700 disabled:cursor-not-allowed disabled:border-transparent disabled:bg-slate-100 disabled:text-slate-400';
          const equivalentClass = hasPaymentMethodImage
            ? 'mt-2 inline-flex w-fit rounded-lg bg-white/82 px-2 py-1 text-xs font-semibold text-slate-700 ring-1 ring-white/75 backdrop-blur-[1px]'
            : 'mt-2 text-xs font-medium text-slate-500';
          const typeBadgeHtml = hideTypeBadge
            ? ''
            : `<span class="mt-1 inline-flex w-fit items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ${typeBadgeClass}">${escapeHtml(accountTypeLabel)}</span>`;
          return `
            <div class="${rowClasses}" data-change-row="${account.id}"${rowStyle}>
              <div class="flex items-start justify-between gap-3">
                <label class="flex cursor-pointer items-start gap-2 text-sm font-semibold ${labelClass} ${labelSurfaceClass}">
                  <input type="checkbox" class="${checkClass}" data-change-check="${account.id}">
                  <span class="inline-flex flex-col">
                    <span class="inline-flex items-center gap-2 leading-tight"><span>${escapeHtml(account.display_name || account.name)}</span></span>
                    ${typeBadgeHtml}
                  </span>
                </label>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${currencyBadgeClass}">${escapeHtml(account.currency)}</span>
              </div>
              <div class="mt-3 grid gap-2 md:grid-cols-2">
                <input type="text" inputmode="decimal" autocomplete="off" placeholder="${escapeHtml(symbol)} 0,00" class="${inputClass}" data-change-input="${account.id}" data-money-mask="true" data-money-symbol="${escapeHtml(symbol)}" disabled>
                <div class="space-y-2 ${bankFieldsClass}" data-change-bank-fields="${account.id}">
                  <select class="${bankSelectClass}" data-bank-method-select="true" data-change-bank-method="${account.id}" disabled>
                    <option value="">Metodo</option>
                    <option value="transfer">Transferencia</option>
                    <option value="mobile">Pago movil</option>
                  </select>
                  <input type="text" inputmode="numeric" maxlength="4" minlength="4" pattern="[0-9]{4}" title="La referencia debe tener exactamente 4 digitos" class="${bankFieldClass}" placeholder="Ultimos 4 digitos" data-change-reference="${account.id}" disabled>
                </div>
              </div>
              <p class="${equivalentClass}" data-change-equivalent="${account.id}"></p>
            </div>
          `;
        };

        const extraBankAccounts = primaryBankAccount
          ? bankAccounts.filter((account) => !account.is_primary)
          : [];
        const orderedAccountsForChange = [
          ...specialAccounts,
          ...bankAccounts,
          ...cashAccounts,
          ...typedOtherAccounts,
        ];

        const specialRowsHtml = specialAccounts.map((account) => buildPaymentRow(account)).join('');
        const bankRowsHtml = primaryBankAccount
          ? buildPaymentRow(primaryBankAccount)
          : bankAccounts.map((account) => buildPaymentRow(account)).join('');
        const toggleBankHtml = primaryBankAccount && extraBankAccounts.length > 0
          ? '<button type="button" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 shadow-sm transition-colors hover:bg-slate-50" data-toggle-bank-accounts>Ver mas cuentas</button>'
          : '';
        const extraBankRowsHtml = primaryBankAccount
          ? extraBankAccounts.map((account) => buildPaymentRow(account, { extra: true })).join('')
          : '';
        const cashRowsHtml = cashAccounts.map((account) => buildPaymentRow(account)).join('');
        const otherRowsHtml = typedOtherAccounts.map((account) => buildPaymentRow(account)).join('');
        const paymentRowsHtml = `${specialRowsHtml}${bankRowsHtml}${toggleBankHtml}${extraBankRowsHtml}${cashRowsHtml}${otherRowsHtml}`;
        const changeRowsHtml = allowChange
          ? orderedAccountsForChange.map((account) => buildChangeRow(account)).join('')
          : '';

        const creditSectionHtml = allowCredit
          ? `
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-semibold text-emerald-700">Saldo a credito (opcional)</span>
                <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-emerald-700">
                  <input type="checkbox" class="h-4 w-4 cursor-pointer text-emerald-600" data-credit-toggle>
                  Registrar saldo pendiente
                </label>
              </div>
              <p class="text-xs text-emerald-700">Si queda saldo pendiente, se creara una deuda por cobrar vinculada a esta venta.</p>
              <div class="hidden" data-credit-fields>
                <label class="block text-xs font-semibold uppercase tracking-wide text-emerald-700">Vence (opcional)</label>
                <input type="text" class="ventas-payment-modal-field js-materialize-datepicker materialize-datepicker-input mt-1 w-full rounded-xl border border-transparent bg-white px-3 py-2 text-sm text-slate-700" placeholder="dd-mm-aaaa" data-credit-due-on disabled>
              </div>
            </div>
          `
          : '';

        const changeSectionHtml = allowChange
          ? `
            <div id="ventas-change-section" class="hidden rounded-2xl border border-amber-200 bg-amber-50/70 p-3.5 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm font-semibold text-amber-700">Vuelto (opcional)</span>
                <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-amber-700">
                  <input type="checkbox" class="h-4 w-4 cursor-pointer text-amber-600" data-change-toggle>
                  Registrar vuelto
                </label>
              </div>
              <p class="text-xs text-amber-700" data-change-hint></p>
              <div class="space-y-2 hidden" data-change-rows>
                ${changeRowsHtml}
              </div>
            </div>
          `
          : '';

        const paymentHtml = `
          <div class="space-y-4 text-left">
            <div class="rounded-2xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-4 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total a cobrar</p>
                  <p class="mt-1 text-2xl font-extrabold text-slate-800">${formatBaseMoney(totalBase)}</p>
                  <p class="text-xs font-semibold text-slate-500">${formatAltFromBase(totalBase)}</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-700 ring-1 ring-sky-100">Base ${escapeHtml(baseCurrencyCode)}</span>
                  <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-semibold text-amber-700 ring-1 ring-amber-200">${escapeHtml(vatLabel)}</span>
                </div>
              </div>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                <div class="rounded-xl bg-white px-3 py-2 text-xs text-slate-500 ring-1 ring-slate-200">Subtotal gravado: <span class="font-semibold text-slate-700">${formatBaseMoney(subtotalBase)}</span></div>
                <div class="rounded-xl bg-white px-3 py-2 text-xs text-slate-500 ring-1 ring-slate-200">Exento: <span class="font-semibold text-slate-700">${formatBaseMoney(exentoBase)}</span></div>
                <div class="rounded-xl bg-white px-3 py-2 text-xs text-slate-500 ring-1 ring-slate-200">IVA: <span class="font-semibold text-slate-700">${formatBaseMoney(vatBase)}</span></div>
              </div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5">
              <div class="flex items-center justify-between gap-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Metodos de pago</p>
                <span class="text-[11px] font-semibold text-slate-500">Selecciona cuenta y monto</span>
              </div>
              <div class="mt-3 space-y-2">${paymentRowsHtml}</div>
            </div>
            ${creditSectionHtml}
            ${changeSectionHtml}
          </div>
        `;

        const openPaymentModal = (initialState = null) => {
          window.Swal.fire({
            title: 'Registrar pago',
            html: paymentHtml,
            confirmButtonText: 'Confirmar',
            cancelButtonText: 'Cancelar',
            showCancelButton: true,
            allowOutsideClick: false,
            allowEscapeKey: false,
            focusConfirm: false,
            buttonsStyling: false,
            customClass: {
              popup: 'ventas-payment-modal',
              title: 'ventas-payment-modal-title',
              actions: 'ventas-payment-modal-actions',
              confirmButton: 'ventas-payment-modal-confirm cursor-pointer',
              cancelButton: 'ventas-payment-modal-cancel cursor-pointer',
            },
            heightAuto: false,
            didOpen: () => {
              const dialog = window.Swal.getHtmlContainer();
              if (!dialog) return;

              const popup = window.Swal.getPopup();
              const actionsContainer = popup?.querySelector('.swal2-actions');

              if (actionsContainer && !actionsContainer.querySelector('[data-payment-footer-balance]')) {
                const balancePanel = document.createElement('div');
                balancePanel.className = 'ventas-payment-modal-balance';
                balancePanel.dataset.paymentFooterBalance = 'true';
                balancePanel.innerHTML = `
                  <span class="font-semibold text-slate-600">Falta por cancelar</span>
                  <span class="text-right">
                    <span id="ventas-pay-remaining" class="block font-semibold text-slate-700"></span>
                    <span id="ventas-pay-remaining-alt" class="block text-xs text-slate-400"></span>
                  </span>
                `;
                actionsContainer.prepend(balancePanel);
              }

              initMoneyMasks(dialog);

              const addMultiPaymentEntry = (row, entry = null) => {
                const accountId = row?.dataset?.payRow;
                if (!accountId) return;

                const account = accountsById.get(String(accountId));
                if (!account) return;

                const isBank = account.account_type === 'bank_account';
                const symbol = account.currency_symbol || account.currency;
                const list = row.querySelector(`[data-pay-multi-list="${accountId}"]`);
                if (!list) return;

                const item = document.createElement('div');
                item.className = isBank
                  ? 'grid gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2 md:grid-cols-2'
                  : 'grid gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2 md:grid-cols-[1fr_auto]';
                item.dataset.payMultiEntry = String(accountId);
                item.innerHTML = isBank
                  ? `
                    <input type="text" inputmode="decimal" autocomplete="off" placeholder="${escapeHtml(symbol)} 0,00" class="ventas-payment-modal-field w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs text-slate-700" data-pay-multi-amount data-money-mask="true" data-money-symbol="${escapeHtml(symbol)}">
                    <select class="ventas-payment-modal-field w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs text-slate-700" data-pay-multi-method>
                      <option value="">Metodo banco</option>
                      <option value="transfer">Transferencia</option>
                      <option value="mobile">Pago movil</option>
                    </select>
                    <input type="text" class="ventas-payment-modal-field js-materialize-datepicker materialize-datepicker-input w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs text-slate-700" placeholder="dd-mm-aaaa" data-pay-multi-date value="${todayPaymentDate}">
                    <input type="text" inputmode="numeric" maxlength="4" minlength="4" pattern="[0-9]{4}" title="La referencia debe tener exactamente 4 digitos" class="ventas-payment-modal-field w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs text-slate-700" placeholder="Ref 4 digitos" data-pay-multi-reference>
                    <button type="button" class="inline-flex h-8 w-8 items-center justify-center justify-self-end rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition-colors hover:bg-rose-100 md:col-span-2" data-pay-multi-remove title="Quitar pago adicional" aria-label="Quitar pago adicional">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4h8v2"></path>
                        <path d="M19 6l-1 14H6L5 6"></path>
                        <path d="M10 11v6"></path>
                        <path d="M14 11v6"></path>
                      </svg>
                    </button>
                  `
                  : `
                    <input type="text" inputmode="decimal" autocomplete="off" placeholder="${escapeHtml(symbol)} 0,00" class="ventas-payment-modal-field w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs text-slate-700" data-pay-multi-amount data-money-mask="true" data-money-symbol="${escapeHtml(symbol)}">
                    <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition-colors hover:bg-rose-100" data-pay-multi-remove title="Quitar pago adicional" aria-label="Quitar pago adicional">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4h8v2"></path>
                        <path d="M19 6l-1 14H6L5 6"></path>
                        <path d="M10 11v6"></path>
                        <path d="M14 11v6"></path>
                      </svg>
                    </button>
                  `;

                list.appendChild(item);
                initMoneyMasks(item);
                if (typeof window.initializeMaterializeDatepickers === 'function') {
                  window.initializeMaterializeDatepickers(item);
                }

                const amountInput = item.querySelector('[data-pay-multi-amount]');
                const methodSelect = item.querySelector('[data-pay-multi-method]');
                const dateInput = item.querySelector('[data-pay-multi-date]');
                const referenceInput = item.querySelector('[data-pay-multi-reference]');
                const removeButton = item.querySelector('[data-pay-multi-remove]');

                amountInput?.addEventListener('input', updateRemaining);
                methodSelect?.addEventListener('change', updateRemaining);
                dateInput?.addEventListener('change', () => {
                  const normalized = normalizePaymentDateInput(dateInput.value);
                  dateInput.value = normalized ? normalized.display : '';
                  updateRemaining();
                });
                referenceInput?.addEventListener('input', updateRemaining);
                removeButton?.addEventListener('click', () => {
                  item.remove();
                  updateRemaining();
                });

                if (entry) {
                  if (typeof entry.amount === 'string' && amountInput) amountInput.value = entry.amount;
                  if (typeof entry.method === 'string' && methodSelect) methodSelect.value = entry.method;
                  if (typeof entry.paymentDate === 'string' && dateInput) {
                    const normalized = normalizePaymentDateInput(entry.paymentDate);
                    dateInput.value = normalized ? normalized.display : '';
                  }
                  if (typeof entry.reference === 'string' && referenceInput) referenceInput.value = entry.reference;
                }
              };

              const changeSection = dialog.querySelector('#ventas-change-section');
              const changeToggle = dialog.querySelector('[data-change-toggle]');
              const changeRowsContainer = dialog.querySelector('[data-change-rows]');
              const changeHintEl = dialog.querySelector('[data-change-hint]');
              const creditToggle = dialog.querySelector('[data-credit-toggle]');
              const creditFields = dialog.querySelector('[data-credit-fields]');
              const creditDueOnInput = dialog.querySelector('[data-credit-due-on]');

              const syncMethodSelectTone = (select) => {
                if (!select) return;

                if (select.disabled) {
                  select.classList.add('text-slate-400');
                  select.classList.remove('text-slate-700');
                  select.style.color = '#94a3b8';
                  return;
                }

                const isPlaceholderSelected = String(select.value || '').trim() === '';

                select.classList.toggle('text-slate-400', isPlaceholderSelected);
                select.classList.toggle('text-slate-700', !isPlaceholderSelected);
                select.style.color = isPlaceholderSelected ? '#94a3b8' : '#334155';
              };

              const syncPaymentRowMethodTone = (row) => {
                if (!row) return;

                const accountId = row.dataset.payRow;
                if (!accountId) return;

                const methodSelect = row.querySelector(`[data-pay-bank-method="${accountId}"]`);
                const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                if (!methodSelect || !checkbox) return;

                const hasMethod = String(methodSelect.value || '').trim().length > 0;
                const shouldToneDown = checkbox.checked && !hasMethod;

                row.querySelectorAll('[data-pay-account-label]').forEach((el) => {
                  el.classList.toggle('is-muted', shouldToneDown);
                });
              };

              const setPaymentAccordionState = (row, open) => {
                if (!row) return;
                row.classList.toggle('is-open', open);
                const content = row.querySelector('[data-pay-content]');
                if (!content) return;
                if (open) {
                  content.style.maxHeight = `${content.scrollHeight}px`;
                } else {
                  content.style.maxHeight = '0px';
                }
              };

              const setRowVisualState = (row, enabled, tone = 'sky') => {
                if (!row) return;

                row.classList.toggle('ventas-payment-row-active', enabled);
                row.classList.toggle('ventas-payment-row-inactive', !enabled);

                if (tone === 'amber') {
                  row.classList.toggle('border-amber-300', enabled);
                  row.classList.toggle('bg-amber-50', enabled);
                  row.classList.toggle('ring-1', enabled);
                  row.classList.toggle('ring-amber-200', enabled);
                  row.classList.remove('border-sky-300', 'bg-sky-50', 'ring-sky-200');
                } else {
                  row.classList.toggle('border-sky-300', enabled);
                  row.classList.toggle('bg-sky-50', enabled);
                  row.classList.toggle('ring-1', enabled);
                  row.classList.toggle('ring-sky-200', enabled);
                  row.classList.remove('border-amber-300', 'bg-amber-50', 'ring-amber-200');
                }
              };

              const setFieldEnabledState = (field, enabled, tone = 'sky') => {
                if (!field) return;

                const isPayDateField = field.matches('input[data-pay-date]');

                field.disabled = !enabled;
                if (!enabled) field.value = '';
                if (!enabled) field.blur();
                if (enabled && isPayDateField && String(field.value || '').trim() === '') {
                  field.value = todayPaymentDate;
                }

                field.classList.remove(
                  'border-sky-300',
                  'border-amber-300',
                  'border-transparent',
                  'ring-2',
                  'ring-sky-100',
                  'ring-amber-100',
                  'bg-white',
                  'ventas-payment-modal-field-active',
                  'ventas-payment-modal-field-active-sky',
                  'ventas-payment-modal-field-active-amber',
                  'ventas-payment-modal-field-disabled',
                );

                if (enabled) {
                  field.classList.add('bg-white', 'ventas-payment-modal-field-active');
                  if (tone === 'amber') {
                    field.classList.add('ventas-payment-modal-field-active-amber');
                  } else {
                    field.classList.add('ventas-payment-modal-field-active-sky');
                  }
                } else {
                  field.classList.add('border-transparent', 'ventas-payment-modal-field-disabled');
                }
              };

              const setBankFieldsEnabled = (container, enabled, tone) => {
                if (!container) return;
                container.querySelectorAll('select, input').forEach((field) => {
                  setFieldEnabledState(field, enabled, tone);
                  if (field.matches('select[data-bank-method-select]')) {
                    syncMethodSelectTone(field);
                  }
                });
              };

              const toggleChangeSection = (visible) => {
                if (!changeSection) return;
                changeSection.classList.toggle('hidden', !visible);
              };

              const resetChangeRow = (row) => {
                const accountId = row.dataset.changeRow;
                const checkbox = row.querySelector(`[data-change-check="${accountId}"]`);
                const input = row.querySelector(`[data-change-input="${accountId}"]`);
                const bankFields = row.querySelector(`[data-change-bank-fields="${accountId}"]`);
                const equivalentEl = row.querySelector(`[data-change-equivalent="${accountId}"]`);

                if (checkbox) checkbox.checked = false;
                setFieldEnabledState(input, false, 'amber');
                setBankFieldsEnabled(bankFields, false, 'amber');
                setRowVisualState(row, false, 'amber');
                if (equivalentEl) equivalentEl.textContent = '';
              };

              const setChangeRowsEnabled = (enabled) => {
                if (!changeRowsContainer) return;
                changeRowsContainer.classList.toggle('hidden', !enabled);
                if (!enabled) {
                  changeRowsContainer.querySelectorAll('[data-change-row]').forEach((row) => {
                    resetChangeRow(row);
                  });
                }
              };

              const setCreditFieldsEnabled = (enabled) => {
                if (creditFields) {
                  creditFields.classList.toggle('hidden', !enabled);
                }

                if (creditDueOnInput) {
                  setFieldEnabledState(creditDueOnInput, enabled, 'sky');
                }
              };

              const updateRemaining = () => {
                let paidBase = 0;
                let paidAlt = 0;
                const altCurrencyCode = baseCurrencyCode === 'USD' ? 'VES' : 'USD';
                const altAvailable = bcvRate > 0;
                dialog.querySelectorAll('[data-pay-row]').forEach((row) => {
                  const accountId = row.dataset.payRow;
                  const account = accountsById.get(String(accountId));
                  if (!account) return;

                  const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                  const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                  const equivalentEl = row.querySelector(`[data-pay-equivalent="${accountId}"]`);
                  const amount = parseMoneyInput(input);

                  if (!checkbox?.checked || amount <= 0) {
                    if (equivalentEl) equivalentEl.textContent = '';
                    return;
                  }

                  const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                  if (baseAmount === null) {
                    if (equivalentEl) {
                      equivalentEl.textContent = 'Sin tasa de conversion';
                      equivalentEl.classList.add('text-red-500');
                    }
                    return;
                  }

                  if (equivalentEl) {
                    equivalentEl.textContent = `Equiv: ${formatBaseMoney(baseAmount)}`;
                    equivalentEl.classList.remove('text-red-500');
                  }
                  paidBase += baseAmount;

                  if (altAvailable) {
                    const altAmount = convertAmount(amount, account.currency, altCurrencyCode);
                    if (altAmount !== null) {
                      paidAlt += altAmount;
                    }
                  }

                  row.querySelectorAll(`[data-pay-multi-entry="${accountId}"]`).forEach((entry) => {
                    const extraAmount = parseMoneyInput(entry.querySelector('[data-pay-multi-amount]'));
                    if (extraAmount <= 0) return;

                    const extraBaseAmount = convertAmount(extraAmount, account.currency, baseCurrencyCode);
                    if (extraBaseAmount === null) return;
                    paidBase += extraBaseAmount;

                    if (altAvailable) {
                      const extraAltAmount = convertAmount(extraAmount, account.currency, altCurrencyCode);
                      if (extraAltAmount !== null) paidAlt += extraAltAmount;
                    }
                  });
                });

                let remaining = roundTo(totalBase - paidBase, 2);
                if (Math.abs(remaining) <= paymentTolerance) remaining = 0;

                let remainingAlt = null;
                if (altAvailable) {
                  const totalAlt = convertAmount(totalBase, baseCurrencyCode, altCurrencyCode);
                  if (totalAlt !== null) {
                    remainingAlt = roundTo(totalAlt - paidAlt, 2);
                  }
                }

                const remainingEl = popup?.querySelector('#ventas-pay-remaining');
                const remainingAltEl = popup?.querySelector('#ventas-pay-remaining-alt');
                if (!remainingEl) return;

                const remainingAbs = Math.abs(remaining);
                const remainingAltAbs = remainingAlt !== null ? Math.abs(remainingAlt) : 0;
                const altTolerance = 0.02;

                const changeDueBase = remaining < -paymentTolerance ? remainingAbs : 0;
                const changeDueAlt = remainingAlt !== null && remainingAlt < -altTolerance ? remainingAltAbs : 0;
                const shouldShowChange = changeDueBase > 0 || changeDueAlt > 0;

                if (changeSection) {
                  toggleChangeSection(shouldShowChange);
                  if (!shouldShowChange) {
                    if (changeToggle) changeToggle.checked = false;
                    setChangeRowsEnabled(false);
                  }
                }

                if (changeHintEl) {
                  if (shouldShowChange) {
                    const hints = [];
                    if (changeDueBase > 0) hints.push(formatBaseMoney(changeDueBase));
                    if (changeDueAlt > 0 && altAvailable) hints.push(formatCurrencyValue(changeDueAlt, altCurrencyCode));
                    changeHintEl.textContent = hints.length ? `Sugerido: ${hints.join(' · ')}` : '';
                  } else {
                    changeHintEl.textContent = '';
                  }
                }

                if (remaining > paymentTolerance) {
                  remainingEl.textContent = `Faltan ${formatBaseMoney(remaining)}`;
                  remainingEl.classList.remove('text-emerald-600');
                  remainingEl.classList.add('text-amber-600');
                } else if (remaining < -paymentTolerance) {
                  remainingEl.textContent = `Vuelto ${formatBaseMoney(remainingAbs)}`;
                  remainingEl.classList.remove('text-amber-600');
                  remainingEl.classList.add('text-emerald-600');
                } else {
                  remainingEl.textContent = 'Completo';
                  remainingEl.classList.remove('text-amber-600');
                  remainingEl.classList.add('text-emerald-600');
                }

                if (remainingAltEl) {
                  if (!altAvailable || remainingAlt === null) {
                    remainingAltEl.textContent = '--';
                  } else if (remainingAlt > altTolerance) {
                    remainingAltEl.textContent = `Faltan ${formatCurrencyValue(remainingAltAbs, altCurrencyCode)}`;
                  } else if (remainingAlt < -altTolerance) {
                    remainingAltEl.textContent = `Vuelto ${formatCurrencyValue(remainingAltAbs, altCurrencyCode)}`;
                  } else {
                    remainingAltEl.textContent = formatCurrencyValue(0, altCurrencyCode);
                  }
                }

                if (changeToggle?.checked) {
                  dialog.querySelectorAll('[data-change-row]').forEach((row) => {
                    const accountId = row.dataset.changeRow;
                    const account = accountsById.get(String(accountId));
                    if (!account) return;
                    const input = row.querySelector(`[data-change-input="${accountId}"]`);
                    const equivalentEl = row.querySelector(`[data-change-equivalent="${accountId}"]`);
                    const amount = parseMoneyInput(input);
                    if (amount <= 0) {
                      if (equivalentEl) equivalentEl.textContent = '';
                      return;
                    }

                    const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                    if (baseAmount === null) {
                      if (equivalentEl) {
                        equivalentEl.textContent = 'Sin tasa de conversion';
                        equivalentEl.classList.add('text-red-500');
                      }
                      return;
                    }

                    if (equivalentEl) {
                      equivalentEl.textContent = `Equiv: ${formatBaseMoney(baseAmount)}`;
                      equivalentEl.classList.remove('text-red-500');
                    }
                  });
                }
              };

              const toggleBankButton = dialog.querySelector('[data-toggle-bank-accounts]');
              const extraBankRows = Array.from(dialog.querySelectorAll('[data-bank-extra="true"]'));
              let expanded = Boolean(config.initialState?.showExtraBankAccounts || initialState?.showExtraBankAccounts);

              const resetExtraBankRow = (row) => {
                const accountId = row.dataset.payRow;
                const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                const bankFields = row.querySelector(`[data-pay-bank-fields="${accountId}"]`);
                const equivalentEl = row.querySelector(`[data-pay-equivalent="${accountId}"]`);

                if (checkbox) checkbox.checked = false;
                setFieldEnabledState(input, false, 'sky');
                setBankFieldsEnabled(bankFields, false, 'sky');
                setRowVisualState(row, false, 'sky');
                if (equivalentEl) equivalentEl.textContent = '';
                syncPaymentRowMethodTone(row);
              };

              if (toggleBankButton && extraBankRows.length > 0) {
                const syncExtraBankRows = (resetWhenHidden = true) => {
                  extraBankRows.forEach((row) => {
                    row.classList.toggle('hidden', !expanded);
                    if (!expanded && resetWhenHidden) resetExtraBankRow(row);
                  });
                  toggleBankButton.textContent = expanded ? 'Ocultar cuentas' : 'Ver mas cuentas';
                };

                toggleBankButton.addEventListener('click', () => {
                  expanded = !expanded;
                  syncExtraBankRows();
                  updateRemaining();
                });

                syncExtraBankRows(!initialState || !expanded);
              }

              if (changeToggle) {
                changeToggle.addEventListener('change', () => {
                  setChangeRowsEnabled(changeToggle.checked);
                  updateRemaining();
                });
              }

              if (creditToggle) {
                creditToggle.addEventListener('change', () => {
                  setCreditFieldsEnabled(creditToggle.checked);
                  updateRemaining();
                });
              }

              const rowHasPaymentData = (row) => {
                if (!row) return false;
                const accountId = row.dataset.payRow;
                if (!accountId) return false;

                const amountInput = row.querySelector(`[data-pay-input="${accountId}"]`);
                return parseMoneyInput(amountInput) > 0;
              };

              const closeOtherPaymentRows = (currentRow) => {
                dialog.querySelectorAll('[data-pay-row]').forEach((row) => {
                  if (row === currentRow) return;
                  if (rowHasPaymentData(row)) return;

                  const accountId = row.dataset.payRow;
                  const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                  if (checkbox?.checked) {
                    checkbox.checked = false;
                    checkbox.dispatchEvent(new Event('change'));
                    return;
                  }

                  setPaymentAccordionState(row, false);
                  setRowVisualState(row, false, 'sky');
                });
              };

              dialog.querySelectorAll('[data-pay-check]').forEach((checkbox) => {
                checkbox.addEventListener('change', () => {
                  const accountId = checkbox.dataset.payCheck;
                  const row = dialog.querySelector(`[data-pay-row="${accountId}"]`);
                  const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                  const bankFields = row.querySelector(`[data-pay-bank-fields="${accountId}"]`);
                  if (!input) return;

                  setFieldEnabledState(input, checkbox.checked, 'sky');
                  setBankFieldsEnabled(bankFields, checkbox.checked, 'sky');
                  if (!checkbox.checked) {
                    row.querySelectorAll(`[data-pay-multi-entry="${accountId}"]`).forEach((entry) => entry.remove());
                  }

                  setRowVisualState(row, checkbox.checked, 'sky');
                  setPaymentAccordionState(row, checkbox.checked);
                  syncPaymentRowMethodTone(row);
                  updateRemaining();
                });
              });

              dialog.querySelectorAll('[data-pay-toggle]').forEach((button) => {
                button.addEventListener('click', () => {
                  const accountId = button.dataset.payToggle;
                  const row = dialog.querySelector(`[data-pay-row="${accountId}"]`);
                  const checkbox = row?.querySelector(`[data-pay-check="${accountId}"]`);
                  if (!row || !checkbox) return;

                  const isOpen = row.classList.contains('is-open');
                  if (isOpen) {
                    if (rowHasPaymentData(row)) return;
                    if (checkbox.checked) {
                      checkbox.checked = false;
                      checkbox.dispatchEvent(new Event('change'));
                    } else {
                      setPaymentAccordionState(row, false);
                      setRowVisualState(row, false, 'sky');
                    }
                    return;
                  }

                  closeOtherPaymentRows(row);
                  if (!checkbox.checked) {
                    checkbox.checked = true;
                    checkbox.dispatchEvent(new Event('change'));
                  } else {
                    setPaymentAccordionState(row, true);
                  }
                });
              });

              dialog.querySelectorAll('[data-pay-method-image]').forEach((image) => {
                image.addEventListener('load', () => {
                  const row = image.closest('[data-pay-row]');
                  if (!row || !row.classList.contains('is-open')) return;
                  setPaymentAccordionState(row, true);
                });
              });
              dialog.querySelectorAll('[data-change-input]').forEach((input) => {
                input.addEventListener('input', updateRemaining);
              });

              dialog.querySelectorAll('[data-change-bank-method]').forEach((select) => {
                syncMethodSelectTone(select);
                select.addEventListener('change', () => {
                  syncMethodSelectTone(select);
                  updateRemaining();
                });
              });

              dialog.querySelectorAll('[data-change-reference]').forEach((input) => {
                input.addEventListener('input', updateRemaining);
              });

              dialog.querySelectorAll('[data-pay-check]').forEach((checkbox) => {
                checkbox.addEventListener('change', () => {
                  const accountId = checkbox.dataset.payCheck;
                  const row = dialog.querySelector(`[data-pay-row="${accountId}"]`);
                  const input = dialog.querySelector(`[data-pay-input="${accountId}"]`);
                  const bankFields = dialog.querySelector(`[data-pay-bank-fields="${accountId}"]`);
                  if (!input) return;

                  setFieldEnabledState(input, checkbox.checked, 'sky');
                  setBankFieldsEnabled(bankFields, checkbox.checked, 'sky');
                  if (!checkbox.checked) {
                    row?.querySelectorAll(`[data-pay-multi-entry="${accountId}"]`).forEach((entry) => entry.remove());
                  }

                  setRowVisualState(row, checkbox.checked, 'sky');
                  syncPaymentRowMethodTone(row);
                  updateRemaining();
                });
              });

              dialog.querySelectorAll('[data-pay-multi-a