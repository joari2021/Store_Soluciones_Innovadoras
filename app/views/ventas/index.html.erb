</div>
<script>
  (() => {
    if (!window.ventasPosBoundRoots) {
      window.ventasPosBoundRoots = new WeakSet();
    }

    const initVentasPOS = () => {
      const root = document.getElementById('ventas-pos-root');
      if (!root) return;
      if (window.ventasPosBoundRoots.has(root)) return;

      let hasOpenCashShift = root.dataset.openShift === 'true';
      let openCashShiftId = Number(root.dataset.openShiftId || 0);
      let canChargeSale = root.dataset.canChargeSale === 'true';
      let canViewAllDrafts = root.dataset.canViewAllDrafts === 'true';
      const isCustomerPosMode = root.dataset.customerPosMode === 'true';
      const canUseCashExchange = root.dataset.canUseCashExchange === 'true';
      const currentUserId = Number(root.dataset.currentUserId || 0);
      let activeCashierId = Number(root.dataset.activeCashierId || 0);
      let activeCashierName = String(root.dataset.activeCashierName || '').trim();
      let activeCashierRoleLabel = String(root.dataset.activeCashierRoleLabel || '').trim();

      const productsDataEl = document.getElementById('ventas-products-data');
      if (!productsDataEl) return;
      window.ventasPosBoundRoots.add(root);

      let products = [];
      try {
        products = JSON.parse(productsDataEl.textContent || '[]');
      } catch (error) {
        products = [];
      }

      const servicesDataEl = document.getElementById('ventas-services-data');
      let services = [];
      if (servicesDataEl) {
        try {
          services = JSON.parse(servicesDataEl.textContent || '[]');
        } catch (error) {
          services = [];
        }
      }

      const accountsDataEl = document.getElementById('ventas-accounts-data');
      let accounts = [];
      if (accountsDataEl) {
        try {
          accounts = JSON.parse(accountsDataEl.textContent || '[]');
        } catch (error) {
          accounts = [];
        }
      }

      const cashBoxesDataEl = document.getElementById('ventas-cash-boxes-data');
      let cashBoxes = [];
      if (cashBoxesDataEl) {
        try {
          cashBoxes = JSON.parse(cashBoxesDataEl.textContent || '[]');
        } catch (error) {
          cashBoxes = [];
        }
      }

      const draftsDataEl = document.getElementById('ventas-drafts-data');
      let drafts = [];
      if (draftsDataEl) {
        try {
          drafts = JSON.parse(draftsDataEl.textContent || '[]');
        } catch (error) {
          drafts = [];
        }
      }

      const PAYMENT_SPECIAL_ORDER = ['biopago', 'pos', 'cashea'];

      const applyActiveCashierState = (activeCashier, options = {}) => {
        const syncHeader = options.syncHeader !== false;
        const canChargeOverride = options.canChargeSale;
        const canViewAllDraftsOverride = options.canViewAllDrafts;
        const previousCanViewAllDrafts = canViewAllDrafts;
        activeCashierId = Number(activeCashier?.id || 0);
        activeCashierName = String(activeCashier?.name || '').trim();
        activeCashierRoleLabel = String(activeCashier?.role_label || '').trim();

        if (typeof canChargeOverride === 'boolean') {
          canChargeSale = canChargeOverride;
          root.dataset.canChargeSale = canChargeSale ? 'true' : 'false';
        }

        if (typeof canViewAllDraftsOverride === 'boolean') {
          canViewAllDrafts = canViewAllDraftsOverride;
          root.dataset.canViewAllDrafts = canViewAllDrafts ? 'true' : 'false';
        }

        root.dataset.activeCashierId = activeCashierId > 0 ? String(activeCashierId) : '';
        root.dataset.activeCashierName = activeCashierName;
        root.dataset.activeCashierRoleLabel = activeCashierRoleLabel;

        if (!previousCanViewAllDrafts && canViewAllDrafts && activeDraftId && activeDraftCreatedById && currentUserId > 0 && activeDraftCreatedById !== currentUserId) {
          resetWorkingSale();
        }

        if (syncHeader && typeof window.updateHeaderCashierState === 'function') {
          window.updateHeaderCashierState(activeCashier || null);
        }
      };

      const fetchActiveCashierStatus = async () => {
        if (isCustomerPosMode) return null;
        if (!hasOpenCashShift || !openCashShiftId || openCashShiftId <= 0) return null;
        const response = await fetch(`/cierres-turno/${openCashShiftId}/active_cashier_status?t=${Date.now()}`, {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        });

        if (!response.ok) return null;

        const payload = await response.json();
        applyActiveCashierState(payload.active_cashier || null, {
          canChargeSale: payload.can_charge_sale === true,
          canViewAllDrafts: payload.can_view_all_drafts === true,
        });
        return payload;
      };

      const onCashierUpdated = (event) => {
        const payload = event?.detail || {};
        if (!Object.prototype.hasOwnProperty.call(payload, 'activeCashier')) return;
        applyActiveCashierState(payload.activeCashier || null, {
          syncHeader: false,
          canChargeSale: payload.canChargeSale,
          canViewAllDrafts: payload.canViewAllDrafts,
        });
      };
      window.addEventListener('cashier:updated', onCashierUpdated);

      let cashierPollIntervalId = null;

      const startCashierPolling = () => {
        if (isCustomerPosMode) return;
        if (!hasOpenCashShift || openCashShiftId <= 0) return;
        if (cashierPollIntervalId) window.clearInterval(cashierPollIntervalId);

        fetchActiveCashierStatus().catch(() => null);
        cashierPollIntervalId = window.setInterval(() => {
          fetchActiveCashierStatus().catch(() => null);
        }, 15000);
      };

      const stopCashierPolling = () => {
        if (!cashierPollIntervalId) return;
        window.clearInterval(cashierPollIntervalId);
        cashierPollIntervalId = null;
      };

      const onCashShiftOpened = (event) => {
        const payload = event?.detail || {};
        const shiftId = Number(payload.shiftId || payload.cashShiftId || 0);
        if (!(shiftId > 0)) return;

        hasOpenCashShift = true;
        openCashShiftId = shiftId;
        root.dataset.openShift = 'true';
        root.dataset.openShiftId = String(shiftId);

        startCashierPolling();
        fetchActiveCashierStatus().catch(() => null);
        renderCart();
      };
      window.addEventListener('cash_shift:opened', onCashShiftOpened);

      startCashierPolling();

      document.addEventListener('turbo:before-cache', () => {
        window.removeEventListener('cashier:updated', onCashierUpdated);
        window.removeEventListener('cash_shift:opened', onCashShiftOpened);
        stopCashierPolling();
      }, { once: true });

      const accountTypeKey = (account) => String(account?.account_type || '').toLowerCase();

      const isSpecialAccount = (account) => PAYMENT_SPECIAL_ORDER.includes(accountTypeKey(account));

      const paymentCurrencyPriority = (currency) => {
        const key = String(currency || '').toUpperCase();
        const priority = {
          VES: 0,
          USD: 1,
          EUR: 2,
          USDT: 3,
          BTC: 4,
          BNB: 5,
        };

        return Object.prototype.hasOwnProperty.call(priority, key) ? priority[key] : 99;
      };

      const paymentTypePriority = (account) => {
        const type = accountTypeKey(account);
        const specialIndex = PAYMENT_SPECIAL_ORDER.indexOf(type);
        if (specialIndex >= 0) return specialIndex;

        if (account?.is_bank || type === 'bank_account') return 100;
        if (type === 'cash_box') return 200;
        if (type === 'card') return 300;
        if (type === 'digital_wallet') return 400;
        if (type === 'crypto_wallet') return 500;

        return 900;
      };

      const orderAccountsForPaymentModal = (accountList) => {
        const list = Array.isArray(accountList) ? [...accountList] : [];

        return list.sort((a, b) => {
          const typePriorityDiff = paymentTypePriority(a) - paymentTypePriority(b);
          if (typePriorityDiff !== 0) return typePriorityDiff;

          const aIsBank = Boolean(a?.is_bank) || accountTypeKey(a) === 'bank_account';
          const bIsBank = Boolean(b?.is_bank) || accountTypeKey(b) === 'bank_account';

          if (aIsBank && bIsBank && Boolean(a?.is_primary) !== Boolean(b?.is_primary)) {
            return a?.is_primary ? -1 : 1;
          }

          const currencyDiff = paymentCurrencyPriority(a?.currency) - paymentCurrencyPriority(b?.currency);
          if (currencyDiff !== 0) return currencyDiff;

          return String(a?.name || '').localeCompare(String(b?.name || ''), 'es', { sensitivity: 'base' });
        });
      };

      const productsById = new Map(products.map((product) => [String(product.id), product]));
      const servicesById = new Map(services.map((service) => [String(service.id), service]));
      const accountsById = new Map(accounts.map((account) => [String(account.id), account]));
      const productsGrid = document.getElementById('ventas-product-grid');
      const servicesGrid = document.getElementById('ventas-service-grid');
      const productsNoResultsEl = document.getElementById('ventas-products-no-results');
      const servicesNoResultsEl = document.getElementById('ventas-services-no-results');
      const productsInfiniteSentinel = document.getElementById('ventas-products-infinite-sentinel');
      const servicesInfiniteSentinel = document.getElementById('ventas-services-infinite-sentinel');
      const productsCatalogUrl = String(root.dataset.productsCatalogUrl || '').trim();
      const servicesCatalogUrl = String(root.dataset.servicesCatalogUrl || '').trim();
      let nextProductsPage = Number.parseInt(root.dataset.productsNextPage || '', 10);
      let nextServicesPage = Number.parseInt(root.dataset.servicesNextPage || '', 10);
      let loadingProductsCatalog = false;
      let loadingServicesCatalog = false;
      let activeTab = 'products';
      let activeProductCategory = '';
      let activeServiceSystem = '';
      let catalogInfiniteObserver = null;
