            <p id="ventas-client-empty" class="mt-3 text-xs text-slate-500">Cliente general</p>
          <% end %>
        </div>
        <div class="mt-4 rounded-3xl border border-slate-200 bg-slate-50/60 p-4">
          <div class="mb-3 flex items-center justify-between gap-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Items de la orden</p>
            <span class="rounded-full bg-slate-900/5 px-2.5 py-1 text-[11px] font-semibold text-slate-600">Resumen en vivo</span>
          </div>
          <div class="app-thin-scrollbar pr-2">
            <div id="ventas-cart-list" class="space-y-3"></div>
            <div id="ventas-cart-empty" class="rounded-2xl border border-dashed border-slate-200 bg-white p-6 text-center shadow-sm">
              <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-2xl bg-sky-100 text-sky-600">
                <i data-lucide="shopping-bag" class="h-5 w-5"></i>
              </div>
              <p class="text-sm font-semibold text-slate-700">Orden sin items</p>
              <p class="mt-1 text-xs text-slate-500">Selecciona productos o servicios para armar la orden.</p>
            </div>
          </div>
        </div>
        <div class="mt-4 rounded-3xl border border-amber-200 bg-amber-50/60 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">IVA 16%</p>
          <div class="mt-2 grid grid-cols-3 gap-2 text-[11px]">
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-amber-200 bg-white px-2.5 py-2 text-slate-600 shadow-sm">
              <input type="radio" name="ventas-vat-mode" value="none" checked class="cursor-pointer text-sky-600 focus:ring-sky-500" onchange="window.__ventasForceVatRecalc && window.__ventasForceVatRecalc(this.value)">
