        </button>
      </div>
      <div class="app-thin-scrollbar flex-1 overflow-y-auto p-4 sm:p-5">
        <div class="ventas-theme-payment-panel rounded-3xl bg-gradient-to-br from-slate-900 via-sky-900 to-cyan-700 p-5 text-white shadow-lg shadow-sky-200/40">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-100/80"><%= customer_pos_mode ? 'Panel de pedido' : 'Panel de cobro' %></p>
              <h2 class="mt-2 flex items-center gap-2 text-xl font-bold">
                <i data-lucide="receipt" class="h-5 w-5 text-sky-200"></i>
                Orden actual
