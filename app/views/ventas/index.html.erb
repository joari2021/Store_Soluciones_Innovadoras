                });

                (initialState.extraPayments || []).forEach((entry) => {
                  const accountId = String(entry.accountId || '');
                  const row = dialog.querySelector(`[data-pay-row="${accountId}"]`);
                  if (!row) return;

                  const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                  if (checkbox && !checkbox.checked) {
                    checkbox.checked = true;
                    checkbox.dispatchEvent(new Event('change'));
                  }

                  addMultiPaymentEntry(row, entry);
                });
              } else {
                setCreditFieldsEnabled(false);
              }

              updateRemaining();
            },
            preConfirm: () => {
              const dialog = window.Swal.getHtmlContainer();
              if (!dialog) return null;

              const modalState = capturePaymentModalState(dialog);
              const creditToggle = dialog.querySelector('[data-credit-toggle]');
              const creditDueOnInput = dialog.querySelector('[data-credit-due-on]');
              const creditEnabled = allowCredit && Boolean(creditToggle?.checked);
              const creditDueOn = String(creditDueOnInput?.value || '').trim();
              const normalizedCreditDueOn = creditDueOn ? normalizePaymentDateInput(creditDueOn) : null;
              let paidBase = 0;
              const payments = [];
              let missingMethod = false;
              let missingConversion = false;
              let missingReference = false;
              let missingPaymentDate = false;

              const resolveMethodForAccount = (account, bankMethod = '') => {
                if (!account) return '';
                if (account.account_type === 'bank_account') return bankMethod || '';
                if (account.account_type === 'cash_box') return 'cash';
                if (account.account_type === 'card') return 'card';
                if (account.account_type === 'pos') return 'pos';
                if (account.account_type === 'biopago') return 'biopago';
                if (account.account_type === 'cashea') return 'cashea';
                if (account.account_type === 'digital_wallet') return 'wallet';
                if (account.account_type === 'crypto_wallet') return 'crypto';
                return 'cash';
              };

              dialog.querySelectorAll('[data-pay-row]').forEach((row) => {
                const accountId = row.dataset.payRow;
                const account = accountsById.get(String(accountId));
                if (!account) return;

                const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                if (!checkbox?.checked) return;

                const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                const amount = parseMoneyInput(input);
                if (amount <= 0) return;

                let method = resolveMethodForAccount(account);
                let reference = '';
                let paymentDate = '';

                if (account.account_type === 'bank_account') {
                  const methodSelect = row.querySelector(`[data-pay-bank-method="${accountId}"]`);
                  method = methodSelect?.value || '';
                  if (!method) missingMethod = true;

                  const paymentDateInput = row.querySelector(`[data-pay-date="${accountId}"]`);
                  const paymentDateValue = String(paymentDateInput?.value || '').trim();
                  const normalizedPaymentDate = normalizePaymentDateInput(paymentDateValue);
                  if (!normalizedPaymentDate) missingPaymentDate = true;
                  paymentDate = normalizedPaymentDate?.iso || '';

                  const referenceInput = row.querySelector(`[data-pay-reference="${accountId}"]`);
                  const referenceValue = referenceInput?.value || '';
                  if (!/^\d{4}$/.test(referenceValue)) missingReference = true;
                  reference = referenceValue.trim();
                }

                const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                if (baseAmount === null) {
                  missingConversion = true;
                  return;
                }

                payments.push({
                  account_id: accountId,
                  method: method,
                  amount: amount,
                  currency: account.currency,
                  reference: reference,
                  payment_date: paymentDate,
                });

                paidBase += baseAmount;

                row.querySelectorAll(`[data-pay-multi-entry="${accountId}"]`).forEach((entry) => {
                  const extraAmount = parseMoneyInput(entry.querySelector('[data-pay-multi-amount]'));
                  if (extraAmount <= 0) return;

                  const extraMethodValue = String(entry.querySelector('[data-pay-multi-method]')?.value || '').trim();
                  const methodForEntry = resolveMethodForAccount(account, extraMethodValue);

                  if (account.account_type === 'bank_account' && !methodForEntry) missingMethod = true;

                  const paymentDateRaw = String(entry.querySelector('[data-pay-multi-date]')?.value || '').trim();
                  const normalizedPaymentDate = paymentDateRaw ? normalizePaymentDateInput(paymentDateRaw) : null;
                  if (account.account_type === 'bank_account' && !normalizedPaymentDate) missingPaymentDate = true;

                  const referenceValue = String(entry.querySelector('[data-pay-multi-reference]')?.value || '').trim();
                  if (account.account_type === 'bank_account' && !/^\d{4}$/.test(referenceValue)) missingReference = true;

                  const extraBaseAmount = convertAmount(extraAmount, account.currency, baseCurrencyCode);
                  if (extraBaseAmount === null) {
                    missingConversion = true;
                    return;
                  }

                  payments.push({
                    account_id: accountId,
                    method: methodForEntry,
                    amount: extraAmount,
                    currency: account.currency,
                    reference: referenceValue,
                    payment_date: normalizedPaymentDate?.iso || '',
                  });

                  paidBase += extraBaseAmount;
                });
              });

              if (missingMethod) {
                window.Swal.showValidationMessage('Selecciona el metodo de pago para cuentas bancarias.');
                return null;
              }

              if (missingReference) {
                window.Swal.showValidationMessage('La referencia debe tener 4 digitos.');
                return null;
              }

              if (missingPaymentDate) {
                window.Swal.showValidationMessage('Debes indicar la fecha del pago para cuentas bancarias.');
                return null;
              }

              if (missingConversion) {
                window.Swal.showValidationMessage('Hay pagos sin tasa de conversion disponible.');
                return null;
              }

              if (allowCredit && creditEnabled && !selectedClient?.id) {
                window.Swal.showValidationMessage('Debes seleccionar un cliente para registrar saldo en deuda por cobrar.');
                return null;
              }

              if (allowCredit && creditEnabled && String(selectedClient?.phone || '').trim().length === 0) {
                window.Swal.showValidationMessage('El cliente registrado no posee numero de telefono, ese dato es obligatorio.');
                return null;
              }

              if (allowCredit && creditEnabled && creditDueOn && !normalizedCreditDueOn) {
                window.Swal.showValidationMessage('La fecha de vencimiento del credito es invalida.');
                return null;
              }

              let remaining = roundTo(totalBase - paidBase, 2);
              if (Math.abs(remaining) <= paymentTolerance) remaining = 0;
              const creditCoversPendingBalance = allowCredit && creditEnabled && remaining > paymentTolerance;

              if (payments.length === 0 && !creditCoversPendingBalance) {
                window.Swal.showValidationMessage('Registra al menos un pago.');
                return null;
              }

              if (remaining > paymentTolerance && !creditCoversPendingBalance) {
                window.Swal.showValidationMessage(`Falta por cancelar ${formatBaseMoney(remaining)}`);
                return null;
              }

              const suggestedChangeBase = remaining < -paymentTolerance ? Math.abs(remaining) : 0;
              const changeToggle = dialog.querySelector('[data-change-toggle]');
              const changeEntries = [];
              let missingChangeMethod = false;
              let missingChangeReference = false;
              let missingChangeConversion = false;

              if (allowChange && changeToggle?.checked) {
                dialog.querySelectorAll('[data-change-row]').forEach((row) => {
                  const accountId = row.dataset.changeRow;
                  const account = accountsById.get(String(accountId));
                  if (!account) return;

                  const checkbox = row.querySelector(`[data-change-check="${accountId}"]`);
                  if (!checkbox?.checked) return;

                  const input = row.querySelector(`[data-change-input="${accountId}"]`);
                  const amount = parseMoneyInput(input);
                  if (amount <= 0) return;

                  let method = 'cash';
                  if (account.account_type === 'bank_account') {
                    const methodSelect = row.querySelector(`[data-change-bank-method="${accountId}"]`);
                    method = methodSelect?.value || '';
                    if (!method) missingChangeMethod = true;
                    const referenceInput = row.querySelector(`[data-change-reference="${accountId}"]`);
                    const referenceValue = referenceInput?.value || '';
                    if (!/^\d{4}$/.test(referenceValue)) missingChangeReference = true;
                  } else if (account.account_type === 'cash_box') {
                    method = 'cash';
                  } else if (account.account_type === 'card') {
                    method = 'card';
                  } else if (account.account_type === 'pos') {
                    method = 'pos';
                  } else if (account.account_type === 'biopago') {
                    method = 'biopago';
                  } else if (account.account_type === 'cashea') {
                    method = 'cashea';
                  } else if (account.account_type === 'digital_wallet') {
                    method = 'wallet';
                  } else if (account.account_type === 'crypto_wallet') {
                    method = 'crypto';
                  }

                  const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                  if (baseAmount === null) {
                    missingChangeConversion = true;
                    return;
                  }

                  const referenceInput = row.querySelector(`[data-change-reference="${accountId}"]`);
                  const reference = referenceInput?.value || '';

                  changeEntries.push({
                    account_id: accountId,
                    method: method,
                    amount: amount,
                    currency: account.currency,
                    reference: reference.trim(),
                  });
                });

                if (missingChangeMethod) {
                  window.Swal.showValidationMessage('Selecciona el metodo del vuelto para cuentas bancarias.');
                  return null;
                }

                if (missingChangeReference) {
                  window.Swal.showValidationMessage('La referencia del vuelto debe tener 4 digitos.');
                  return null;
                }

                if (missingChangeConversion) {
                  window.Swal.showValidationMessage('Hay vueltos sin tasa de conversion disponible.');
                  return null;
                }

                if (changeEntries.length === 0) {
                  window.Swal.showValidationMessage('Registra al menos un monto de vuelto o desactiva la opcion.');
                  return null;
                }
              }

              return {
                payments,
                change: changeEntries,
                credit_sale: {
                  enabled: creditCoversPendingBalance,
                  due_on: creditCoversPendingBalance ? (normalizedCreditDueOn?.iso || '') : '',
                },
                totalBase,
                suggestedChangeBase,
                hasPendingSuggestedChange: suggestedChangeBase > paymentTolerance && (!allowChange || changeEntries.length === 0),
                modalState,
              };
            },
          }).then(async (result) => {
            const restoreCurrency = () => {
              if (config.baseCurrencyOverride) {
                applyBaseCurrencySelection(previousBaseCurrency, { syncInputs: false, syncCart: false, render: false });
              }
            };

            if (!result.isConfirmed) {
              restoreCurrency();
              return;
            }

            const payload = result.value || {};
            if (payload.hasPendingSuggestedChange && window.Swal) {
              const changeConfirmation = await window.Swal.fire({
                icon: 'warning',
                title: 'Vuelto sugerido sin registrar',
                html: `<p class="text-sm text-slate-600">Se detecto un vuelto sugerido de <strong>${formatBaseMoney(payload.suggestedChangeBase || 0)}</strong>. ¿Deseas continuar sin registrarlo?</p>`,
                showCancelButton: true,
                confirmButtonText: 'Continuar sin vuelto',
                cancelButtonText: 'Volver al cobro',
                buttonsStyling: false,
                customClass: {
                  popup: 'rounded-2xl border border-amber-200 shadow-xl',
                  title: 'text-lg font-extrabold text-slate-800',
                  actions: 'w-full flex flex-wrap items-center justify-end gap-2 mt-5',
                  confirmButton: 'inline-flex items-center justify-center rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-amber-500',
                  cancelButton: 'inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50',
                },
                heightAuto: false,
              });

              if (!changeConfirmation.isConfirmed) {
                restoreCurrency();
                openPaymentModal(payload.modalState || null);
                return;
              }
            }

            if (typeof config.onBeforeSubmit === 'function') {
              const canContinue = await config.onBeforeSubmit(payload);
              if (!canContinue) {
                restoreCurrency();
                openPaymentModal(payload.modalState || null);
                return;
              }
            }

            if (typeof config.onSubmit === 'function') {
              await config.onSubmit(payload);
            }

            restoreCurrency();
          });
        };

        openPaymentModal(config.initialState || null);
      };

      const submitCambioEfectivo = async (exchangeData, payload) => {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (!csrfToken) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Token CSRF no disponible',
              text: 'Recarga la pagina e intenta de nuevo.',
              heightAuto: false,
            });
          }
          return false;
        }

        if (window.Swal) {
          window.Swal.fire({
            title: 'Procesando cambio',
            text: 'Registrando la pasarela de cambios, espera...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => window.Swal.showLoading(),
            heightAuto: false,
          });
        }

        const requestPayload = {
          delivery_target: exchangeData.delivery_target,
          delivery_option: exchangeData.delivery_option,
          efectivo_vendido: exchangeData.efectivo_vendido,
          monto_caja_operativa: exchangeData.monto_caja_operativa,
          monto_caja_deposito: exchangeData.monto_caja_deposito,
          monto_cuenta_origen: exchangeData.monto_cuenta_origen,
          monto_recibido: exchangeData.monto_recibido,
          recargo_percent: exchangeData.recargo_percent,
          payment_group: exchangeData.payment_group,
          payments: payload?.payments || [],
        };

        try {
          const response = await fetch('/cambios-efectivo', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
            },
            body: JSON.stringify({ cambio_efectivo: requestPayload }),
          });

          let data = {};
          try {
            data = await response.json();
          } catch (error) {
            data = {};
          }

          if (!response.ok) {
            throw new Error(data.error || 'No se pudo registrar la pasarela de cambios.');
          }

          const updateAccountBalance = (accountId, delta) => {
            const account = accountsById.get(String(accountId));
            if (!account) return;
            account.balance = roundTo(Number(account.balance || 0) + delta, 2);
          };

          const updateCashBoxBalance = (role, delta) => {
            const entry = cashBoxes.find((acc) => acc.account_type === 'cash_box'
              && acc.cash_role === role
              && String(acc.currency || '').toUpperCase() === 'VES');
            if (!entry) return;
            entry.balance = roundTo(Number(entry.balance || 0) + delta, 2);
          };

          if (exchangeData.delivery_target === 'cash') {
            updateCashBoxBalance('cash_box', -exchangeData.monto_caja_operativa);
            updateCashBoxBalance('cash_deposit', -exchangeData.monto_caja_deposito);
          }

          if (exchangeData.delivery_target === 'digital') {
            const primaryBankAccount = accounts.find((account) => account.account_type === 'bank_account'
              && account.is_primary
              && String(account.currency || '').toUpperCase() === 'VES');
            if (primaryBankAccount) {
              updateAccountBalance(primaryBankAccount.id, -Number(exchangeData.monto_cuenta_origen || 0));
            }
          }

          (payload?.payments || []).forEach((payment) => {
            updateAccountBalance(payment.account_id, Number(payment.amount || 0));
          });

          if (window.Swal) {
            window.Swal.fire({
              icon: 'success',
              title: 'Pasarela registrada',
              text: data.message || 'Pasarela de cambios registrada correctamente.',
              heightAuto: false,
            });
          }

          return true;
        } catch (error) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Error al registrar',
              text: error.message,
              heightAuto: false,
            });
          }
          return false;
        }
      };

      const currentActiveCashierLabel = () => {
        const role = String(activeCashierRoleLabel || '').trim();
        const name = String(activeCashierName || '').trim();
        const full = [role, name].filter((part) => part.length > 0).join(' ');
        return full || 'el cajero activo';
      };

      const ensureCashExchangeAllowed = async () => {
        if (!canUseCashExchange) {
          if (window.Swal) {
            await window.Swal.fire({
              icon: 'warning',
              title: 'Acceso restringido',
              text: 'Solo encargado o administrador pueden usar la pasarela de cambios.',
              heightAuto: false,
            });
          }
          return false;
        }

        await fetchActiveCashierStatus().catch(() => null);

        if (activeCashierId > 0 && currentUserId > 0 && activeCashierId !== currentUserId) {
          if (window.Swal) {
            await window.Swal.fire({
              icon: 'warning',
              title: 'Cajero activo diferente',
              text: `Los cambios solo pueden ser procesados por ${currentActiveCashierLabel()}, quien es el cajero en este momento.`,
              heightAuto: false,
            });
          }
          return false;
        }

        if (!(activeCashierId > 0)) {
          if (window.Swal) {
            await window.Swal.fire({
              icon: 'warning',
              title: 'Sin cajero activo',
              text: 'No hay un cajero activo asignado en este momento para procesar la pasarela de cambios.',
              heightAuto: false,
            });
          }
          return false;
        }

        return true;
      };

      const openCashExchangeModal = () => {
        if (!window.Swal) return;

        const cashBoxAccount = cashBoxes.find((account) => account.account_type === 'cash_box'
          && account.cash_role === 'cash_box'
          && String(account.currency || '').toUpperCase() === 'VES');
        const cashDepositAccount = cashBoxes.find((account) => account.account_type === 'cash_box'
          && account.cash_role === 'cash_deposit'
          && String(account.currency || '').toUpperCase() === 'VES');
        const primaryBankVesAccount = accounts.find((account) => account.account_type === 'bank_account'
          && account.is_primary
          && String(account.currency || '').toUpperCase() === 'VES');

        const modalHtml = `
          <div class="space-y-4 text-left">
            <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-3 text-sm text-amber-800">
              <strong>Importante!!:</strong> El monto a cobrar al cliente debe ser completo en el metodo seleccionado, no fraccionado.
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
              <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Indicar que necesita recibir el cliente</label>
              <select data-cash-exchange-target class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500">
                <option value="cash">Efectivo</option>
                <option value="mobile_other_banks">Pago movil/transf. otros bcos</option>
                <option value="third_party_bancamiga">Transferencia de tercero (Bancamiga)</option>
              </select>
            </div>
            <div class="rounded-2xl border border-emerald-200 bg-white p-4 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Calculo de montos y metodo</p>
              <div class="mt-3 grid gap-3 md:grid-cols-3">
                <div>
                  <label class="text-xs font-semibold uppercase tracking-wide text-slate-500" data-cash-exchange-amount-label>Efectivo a vender</label>
                  <input type="text" inputmode="decimal" autocomplete="off" data-cash-exchange-amount class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" data-money-mask="true" data-money-symbol="Bs">
                </div>
                <div>
                  <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Metodo de pago</label>
                  <select data-cash-exchange-method class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500">
                    <option value="bank">Pago movil/Transferencia (+5%)</option>
                    <option value="pos_biopago">Biopago/Punto de venta (+8%)</option>
                  </select>
                </div>
                <div>
                  <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Monto a cobrar</label>
                  <input type="text" inputmode="decimal" autocomplete="off" data-cash-exchange-charge class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" data-money-mask="true" data-money-symbol="Bs">
                </div>
              </div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500" data-cash-exchange-source-title>Origen de los fondos (Bs)</p>
              <div class="mt-3 grid gap-3 md:grid-cols-2" data-cash-exchange-cash-origin>
                <div>
                  <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Caja Bs (Caja)</label>
                  <input type="text" inputmode="decimal" autocomplete="off" data-cash-exchange-box class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" data-money-mask="true" data-money-symbol="Bs">
                  <div data-cash-exchange-badge-box class="mt-2 inline-flex items-center rounded-lg bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"></div>
                </div>
                <div>
                  <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Caja Bs (Deposito)</label>
                  <input type="text" inputmode="decimal" autocomplete="off" data-cash-exchange-deposit class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" data-money-mask="true" data-money-symbol="Bs">
                  <div data-cash-exchange-badge-deposit class="mt-2 inline-flex items-center rounded-lg bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"></div>
                </div>
              </div>
              <div class="mt-3 hidden" data-cash-exchange-digital-origin>
                <div>
                  <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Cuenta bancaria principal (Bs)</label>
                  <input type="text" inputmode="decimal" autocomplete="off" data-cash-exchange-origin-bank class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" data-money-mask="true" data-money-symbol="Bs" readonly>
                  <div data-cash-exchange-badge-origin-bank class="mt-2 inline-flex items-center rounded-lg bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"></div>
                </div>
              </div>
            </div>
          </div>
        `;

        const openCashExchangePaymentModal = (exchangeData, initialState = null) => {
          const paymentGroup = exchangeData.payment_group;
          const deliveryTarget = exchangeData.delivery_target;
          const filteredAccounts = accounts.filter((account) => {
            const currency = String(account.currency || '').toUpperCase();
            if (currency !== 'VES') return false;
            if (deliveryTarget === 'cash') {
              if (paymentGroup === 'bank') return account.account_type === 'bank_account';
              return ['pos', 'biopago'].includes(String(account.account_type || '').toLowerCase());
            }

            if (paymentGroup === 'cash') {
              return account.account_type === 'cash_box' && account.cash_role === 'cash_box';
            }

            return ['pos', 'biopago'].includes(String(account.account_type || '').toLowerCase());
          });

          if (filteredAccounts.length === 0) {
            window.Swal.fire({
              icon: 'error',
              title: 'Sin cuentas disponibles',
              text: paymentGroup === 'bank'
                ? 'No hay cuentas bancarias en Bs disponibles para registrar el pago.'
                : paymentGroup === 'cash'
                  ? 'No hay cuentas de caja operativa en Bs disponibles para registrar el pago.'
                : 'No hay cuentas Biopago o Punto de venta disponibles para registrar el pago.',
              heightAuto: false,
            });
            return;
          }

          openPaymentModalWithConfig({
            totals: {
              totalBase: exchangeData.monto_recibido,
              subtotalBase: exchangeData.monto_recibido,
              exentoBase: 0,
              vatBase: 0,
            },
            vatLabel: 'Pasarela de cambios',
            allowCredit: false,
            allowChange: false,
            baseCurrencyOverride: 'ves',
            accountsList: filteredAccounts,
            initialState,
            onSubmit: async (payload) => {
              const success = await submitCambioEfectivo(exchangeData, payload);
              if (!success) {
                openCashExchangePaymentModal(exchangeData, payload?.modalState || null);
              }
            },
          });
        };

        window.Swal.fire({
          title: 'Pasarela de cambios',
          html: modalHtml,
          confirmButtonText: 'Procesar cambio',
          cancelButtonText: 'Cancelar',
          showCancelButton: true,
          allowOutsideClick: false,
          allowEscapeKey: false,
          focusConfirm: false,
          buttonsStyling: false,
          customClass: {
            popup: 'ventas-payment-modal',
            title: 'ventas-payment-modal-title',
            actions: 'ventas-payment-modal-actions',
            confirmButton: 'ventas-payment-modal-confirm cursor-pointer',
            cancelButton: 'ventas-payment-modal-cancel cursor-pointer',
          },
          heightAuto: false,
          didOpen: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return;

            initMoneyMasks(dialog);

            const targetSelect = dialog.querySelector('[data-cash-exchange-target]');
            const amountLabel = dialog.querySelector('[data-cash-exchange-amount-label]');
            const amountInput = dialog.querySelector('[data-cash-exchange-amount]');
            const methodSelect = dialog.querySelector('[data-cash-exchange-method]');
            const chargeInput = dialog.querySelector('[data-cash-exchange-charge]');
            const boxInput = dialog.querySelector('[data-cash-exchange-box]');
            const depositInput = dialog.querySelector('[data-cash-exchange-deposit]');
            const boxBadge = dialog.querySelector('[data-cash-exchange-badge-box]');
            const depositBadge = dialog.querySelector('[data-cash-exchange-badge-deposit]');
            const sourceTitle = dialog.querySelector('[data-cash-exchange-source-title]');
            const cashOriginSection = dialog.querySelector('[data-cash-exchange-cash-origin]');
            const digitalOriginSection = dialog.querySelector('[data-cash-exchange-digital-origin]');
            const originBankInput = dialog.querySelector('[data-cash-exchange-origin-bank]');
            const originBankBadge = dialog.querySelector('[data-cash-exchange-badge-origin-bank]');

            const deliveryOption = () => String(targetSelect?.value || 'cash');
            const isDigitalOption = () => deliveryOption() !== 'cash';

            const updateMethodOptions = () => {
              if (!methodSelect) return;
              const current = String(methodSelect.value || '');
              const options = isDigitalOption()
                ? [
                    { value: 'cash', label: 'Efectivo (+5%)' },
                    { value: 'pos_biopago', label: 'Biopago/Punto de venta (+8%)' },
                  ]
                : [
                    { value: 'bank', label: 'Pago movil/Transferencia (+5%)' },
                    { value: 'pos_biopago', label: 'Biopago/Punto de venta (+8%)' },
                  ];

              methodSelect.innerHTML = options.map((option) => `<option value="${option.value}">${option.label}</option>`).join('');
              methodSelect.value = options.some((option) => option.value === current) ? current : options[0].value;
            };

            const updateBadge = (badge, balance, used) => {
              if (!badge) return;
              const remaining = roundTo(Number(balance || 0) - Number(used || 0), 2);
              const isNegative = remaining < 0;
              badge.textContent = isNegative
                ? 'Este monto excede el disponible'
                : `Disponible: ${formatMoney(remaining, 'Bs ')}`;
              badge.classList.toggle('bg-emerald-100', !isNegative);
              badge.classList.toggle('text-emerald-700', !isNegative);
              badge.classList.toggle('ring-emerald-200', !isNegative);
              badge.classList.toggle('bg-red-100', isNegative);
              badge.classList.toggle('text-red-700', isNegative);
              badge.classList.toggle('ring-red-200', isNegative);
            };

            const percentForMethod = () => (String(methodSelect?.value || '') === 'pos_biopago' ? 0.08 : 0.05);
            let lastEdited = 'cash';
            let lastBoxEdited = 'box';

            const syncChargeFromCash = () => {
              if (!amountInput || !chargeInput) return;
              const baseAmount = parseMoneyInput(amountInput);
              const charge = roundTo(baseAmount * (1 + percentForMethod()), 2);
              setMoneyInputValue(chargeInput, charge, 'Bs ');
            };

            const syncCashFromCharge = () => {
              if (!amountInput || !chargeInput) return;
              const charge = parseMoneyInput(chargeInput);
              const baseAmount = roundTo(charge / (1 + percentForMethod()), 2);
              setMoneyInputValue(amountInput, baseAmount, 'Bs ');
            };

            const syncBoxesFromCash = () => {
              if (!amountInput || !boxInput || !depositInput || !originBankInput) return;
              const cashAmount = parseMoneyInput(amountInput);

              if (isDigitalOption()) {
                setMoneyInputValue(originBankInput, cashAmount, 'Bs ');
                return;
              }

              const boxAmount = parseMoneyInput(boxInput);
              const depositAmount = parseMoneyInput(depositInput);

              if (lastBoxEdited === 'deposit') {
                const nextBox = Math.max(0, roundTo(cashAmount - depositAmount, 2));
                setMoneyInputValue(boxInput, nextBox, 'Bs ');
              } else {
                const nextDeposit = Math.max(0, roundTo(cashAmount - boxAmount, 2));
                setMoneyInputValue(depositInput, nextDeposit, 'Bs ');
              }
            };

            const refreshBadges = () => {
              if (isDigitalOption()) {
                const used = parseMoneyInput(originBankInput);
                updateBadge(originBankBadge, Number(primaryBankVesAccount?.balance || 0), used);
                return;
              }

              const boxAmount = parseMoneyInput(boxInput);
              const depositAmount = parseMoneyInput(depositInput);
              updateBadge(boxBadge, Number(cashBoxAccount?.balance || 0), boxAmount);
              updateBadge(depositBadge, Number(cashDepositAccount?.balance || 0), depositAmount);
            };

            const updateTargetVisibility = () => {
              const targetIsDigital = isDigitalOption();
              if (amountLabel) amountLabel.textContent = targetIsDigital ? 'Monto a enviar' : 'Efectivo a vender';
              if (sourceTitle) sourceTitle.textContent = targetIsDigital ? 'Cuenta origen del envio (Bs)' : 'Origen de los fondos (Bs)';
              if (cashOriginSection) cashOriginSection.classList.toggle('hidden', targetIsDigital);
              if (digitalOriginSection) digitalOriginSection.classList.toggle('hidden', !targetIsDigital);
            };

            if (targetSelect) {
              const hasCashBoxes = Boolean(cashBoxAccount && cashDepositAccount);
              const hasPrimaryBank = Boolean(primaryBankVesAccount);
              const defaultTarget = hasCashBoxes ? 'cash' : (hasPrimaryBank ? 'mobile_other_banks' : 'cash');
              targetSelect.value = targetSelect.value || defaultTarget;
            }
            updateMethodOptions();

            if (amountInput) {
              setMoneyInputValue(amountInput, 0, 'Bs ');
            }
            if (chargeInput) {
              setMoneyInputValue(chargeInput, 0, 'Bs ');
            }
            if (boxInput) {
              setMoneyInputValue(boxInput, 0, 'Bs ');
            }
            if (depositInput) {
              setMoneyInputValue(depositInput, 0, 'Bs ');
            }
            if (originBankInput) {
              setMoneyInputValue(originBankInput, 0, 'Bs ');
            }
            updateTargetVisibility();
            refreshBadges();

            amountInput?.addEventListener('input', () => {
              lastEdited = 'cash';
              lastBoxEdited = 'deposit';
              syncChargeFromCash();
              syncBoxesFromCash();
              refreshBadges();
            });

            chargeInput?.addEventListener('input', () => {
              lastEdited = 'charge';
              lastBoxEdited = 'deposit';
              syncCashFromCharge();
              syncBoxesFromCash();
              refreshBadges();
            });

            methodSelect?.addEventListener('change', () => {
              if (lastEdited === 'charge') {
                syncCashFromCharge();
              } else {
                syncChargeFromCash();
              }
              syncBoxesFromCash();
              refreshBadges();
            });

            targetSelect?.addEventListener('change', () => {
              updateMethodOptions();
              updateTargetVisibility();
              if (lastEdited === 'charge') {
                syncCashFromCharge();
              } else {
                syncChargeFromCash();
              }
              syncBoxesFromCash();
              refreshBadges();
            });

            boxInput?.addEventListener('input', () => {
              lastBoxEdited = 'box';
              syncBoxesFromCash();
              refreshBadges();
            });

            depositInput?.addEventListener('input', () => {
              lastBoxEdited = 'deposit';
              syncBoxesFromCash();
              refreshBadges();
            });
          },
          preConfirm: async () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return null;

            const amountInput = dialog.querySelector('[data-cash-exchange-amount]');
            const targetSelect = dialog.querySelector('[data-cash-exchange-target]');
            const methodSelect = dialog.querySelector('[data-cash-exchange-method]');
            const chargeInput = dialog.querySelector('[data-cash-exchange-charge]');
            const boxInput = dialog.querySelector('[data-cash-exchange-box]');
            const depositInput = dialog.querySelector('[data-cash-exchange-deposit]');
            const originBankInput = dialog.querySelector('[data-cash-exchange-origin-bank]');

            const deliveryOption = String(targetSelect?.value || 'cash');
            const deliveryTarget = deliveryOption === 'cash' ? 'cash' : 'digital';
            const efectivoVendido = roundTo(parseMoneyInput(amountInput), 2);
            const montoRecibido = roundTo(parseMoneyInput(chargeInput), 2);
            const montoCajaOperativa = roundTo(parseMoneyInput(boxInput), 2);
            const montoCajaDeposito = roundTo(parseMoneyInput(depositInput), 2);
            const montoCuentaOrigen = roundTo(parseMoneyInput(originBankInput), 2);
            const paymentGroup = String(methodSelect?.value || 'bank');
            const recargoPercent = paymentGroup === 'pos_biopago' ? 8 : 5;

            if (!(efectivoVendido > 0)) {
              window.Swal.showValidationMessage(deliveryTarget === 'digital'
                ? 'Debes indicar el monto a enviar.'
                : 'Debes indicar el efectivo a vender.');
              return null;
            }

            if (!(montoRecibido > 0)) {
              window.Swal.showValidationMessage('Debes indicar el monto a cobrar.');
              return null;
            }

            if (deliveryTarget === 'cash') {
              if (!cashBoxAccount || !cashDepositAccount) {
                window.Swal.showValidationMessage('No se encontraron las cajas en Bs configuradas para entregar efectivo.');
                return null;
              }

              if ((montoCajaOperativa + montoCajaDeposito - efectivoVendido) > 0.01
                || (montoCajaOperativa + montoCajaDeposito - efectivoVendido) < -0.01) {
                window.Swal.showValidationMessage('Los montos de caja no cuadran con el efectivo a vender.');
                return null;
              }

              if (montoCajaOperativa > Number(cashBoxAccount.balance || 0)) {
                window.Swal.showValidationMessage('El monto en caja operativa excede el disponible.');
                return null;
              }

              if (montoCajaDeposito > Number(cashDepositAccount.balance || 0)) {
                window.Swal.showValidationMessage('El monto en caja deposito excede el disponible.');
                return null;
              }
            } else {
              if (!primaryBankVesAccount) {
                window.Swal.showValidationMessage('No existe una cuenta bancaria principal en Bs.');
                return null;
              }

              if ((montoCuentaOrigen - efectivoVendido) > 0.01 || (montoCuentaOrigen - efectivoVendido) < -0.01) {
                window.Swal.showValidationMessage('El monto a enviar debe coincidir con el monto descontado de la cuenta principal.');
                return null;
              }

              if (montoCuentaOrigen > Number(primaryBankVesAccount.balance || 0)) {
                window.Swal.showValidationMessage('El monto a enviar excede el disponible de la cuenta bancaria principal.');
                return null;
              }
            }

            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
            if (!csrfToken) {
              window.Swal.showValidationMessage('Token CSRF no disponible.');
              return null;
            }

            const response = await fetch('/cambios-efectivo/validate', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken,
              },
              body: JSON.stringify({
                cambio_efectivo: {
                  delivery_target: deliveryTarget,
                  delivery_option: deliveryOption,
                  efectivo_vendido: efectivoVendido,
                  monto_caja_operativa: montoCajaOperativa,
                  monto_caja_deposito: montoCajaDeposito,
                  monto_cuenta_origen: montoCuentaOrigen,
                  monto_recibido: montoRecibido,
                  payment_group: paymentGroup,
                },
              }),
            });

            let data = {};
            try {
              data = await response.json();
            } catch (error) {
              data = {};
            }

            if (!response.ok) {
              window.Swal.showValidationMessage(data.error || 'No se pudo validar la pasarela de cambios.');
              return null;
            }

            return {
              delivery_target: deliveryTarget,
              delivery_option: deliveryOption,
              efectivo_vendido: efectivoVendido,
              monto_caja_operativa: montoCajaOperativa,
              monto_caja_deposito: montoCajaDeposito,
              monto_cuenta_origen: montoCuentaOrigen,
              monto_recibido: montoRecibido,
              recargo_percent: recargoPercent,
              payment_group: paymentGroup,
            };
          },
        }).then((result) => {
          if (!result.isConfirmed) return;
          const exchangeData = result.value;
          if (!exchangeData) return;
          openCashExchangePaymentModal(exchangeData);
        });
      };

      const buildKey = (itemType, itemId, variationId) => `${normalizeItemType(itemType)}:${itemId}::${normalizeVariationId(variationId) || 'none'}`;

      const buildProductReservationSnapshot = () => {
        const snapshot = new Map();
        cart.forEach((item, key) => {
          const quantity = Number(item.quantity) || 0;
          if (!(quantity > 0)) return;

          if ((item.itemType || 'product') === 'product') {
            snapshot.set(String(key), quantity);
            return;
          }

          if ((item.itemType || 'product') !== 'service') return;
          const service = servicesById.get(String(item.serviceId || ''));
          if (!service) return;

          resolveServiceMaterialRowsForReservation(service, item).forEach((row) => {
            const materialProductId = String(row.productId || '').trim();
            const materialVariationId = normalizeVariationId(row.variationId || row.variation_id);
            const materialQuantity = Number(row.quantity) || 0;
            if (!materialProductId || !(materialQuantity > 0)) return;

            const materialKey = `print-material:${materialProductId}::${materialVariationId || 'none'}`;
            const previous = Number(snapshot.get(materialKey)) || 0;
            snapshot.set(materialKey, previous + (quantity * materialQuantity));
          });
        });
        return snapshot;
      };

      const applySyncedReservationSnapshot = (snapshot) => {
        syncedReservedProductQuantities.clear();
        if (!(snapshot instanceof Map)) return;

        snapshot.forEach((quantity, key) => {
          const safeQuantity = Number(quantity) || 0;
          if (!(safeQuantity > 0)) return;
          syncedReservedProductQuantities.set(String(key), safeQuantity);
        });
      };

      const syncedReservedQuantityForVariation = (productId, variationId) => {
        const key = buildKey('product', productId, normalizeVariationId(variationId));
        return Number(syncedReservedProductQuantities.get(String(key))) || 0;
      };

      const syncedReservedQuantityForProduct = (productId) => {
        const prefix = `product:${String(productId)}::`;
        let total = 0;
        syncedReservedProductQuantities.forEach((quantity, key) => {
          if (!String(key).startsWith(prefix)) return;
          total += Number(quantity) || 0;
        });
        return total;
      };

      const syncedReservedQuantityForPrintMaterialProduct = (productId) => {
        const prefix = `print-material:${String(productId)}::`;
        let total = 0;
        syncedReservedProductQuantities.forEach((quantity, key) => {
          if (!String(key).startsWith(prefix)) return;
          total += Number(quantity) || 0;
        });
        return total;
      };

      const syncedReservedQuantityForPrintMaterialVariation = (productId, variationId) => {
        const key = `print-material:${String(productId)}::${normalizeVariationId(variationId) || 'none'}`;
        return Number(syncedReservedProductQuantities.get(key)) || 0;
      };

      const normalizeVatMode = (mode) => {
        const normalized = String(mode || '').toLowerCase();
        return ['none', 'add', 'included'].includes(normalized) ? normalized : 'none';
      };

      const readCheckedVatMode = () => {
        const selected = root.querySelector('input[name="ventas-vat-mode"]:checked');
        return normalizeVatMode(selected ? selected.value : root.dataset.vatMode);
      };

      let currentVatMode = readCheckedVatMode();
      let vatRenderReady = false;

      const syncVatModeInputs = (mode) => {
        const safeMode = normalizeVatMode(mode);
        root.querySelectorAll('input[name="ventas-vat-mode"]').forEach((radio) => {
          radio.checked = radio.value === safeMode;
        });
      };

      const setVatMode = (mode, options = {}) => {
        const shouldRender = options.render !== false;
        const safeMode = normalizeVatMode(mode);
        const changed = currentVatMode !== safeMode;

        currentVatMode = safeMode;
        root.dataset.vatMode = safeMode;
        syncVatModeInputs(safeMode);

        if (shouldRender && changed && vatRenderReady) {
          renderCart();
        }
      };

      const getVatMode = () => currentVatMode;

      root.dataset.vatMode = currentVatMode;
      syncVatModeInputs(currentVatMode);

      const computePricing = (baseUnitUsd, quantity, options = {}) => {
        const vatMode = getVatMode();
        const isExento = options?.exento === true;
        const unitUsd = Number(baseUnitUsd) || 0;
        const unitBaseRaw = baseCurrency === 'usd' ? unitUsd : convertUsdToBase(unitUsd);
        const unitBase = roundTo(unitBaseRaw, 2);
        const safeQty = Number(quantity) || 0;
        let unitNet = unitBase;

        if (!isExento && vatMode === 'included' && vatRate > 0) {
          unitNet = roundTo(unitBase / (1 + vatRate), 2);
        }

        const lineNet = roundTo(unitNet * safeQty, 2);
        return {
          unitDisplay: unitNet,
          lineNet: lineNet,
          lineTotal: lineNet,
          exento: isExento,
        };
      };

      const computePricingFromBaseAmount = (baseUnitAmount, quantity, options = {}) => {
        const vatMode = getVatMode();
        const isExento = options?.exento === true;
        const unitBase = roundTo(Number(baseUnitAmount) || 0, 2);
        const safeQty = Number(quantity) || 0;
        let unitNet = unitBase;

        if (!isExento && vatMode === 'included' && vatRate > 0) {
          unitNet = roundTo(unitBase / (1 + vatRate), 2);
        }

        const lineNet = roundTo(unitNet * safeQty, 2);
        return {
          unitDisplay: unitNet,
          lineNet: lineNet,
          lineTotal: lineNet,
          exento: isExento,
        };
      };

      const resolveServiceUnitPriceUsd = (service, item = {}, options = {}) => {
        const preferBsReference = options?.preferBsReference === true;
        const normalizedReference = normalizeServiceReferenceName(service);
        const servicePriceBs = Number(service?.price_bs);

        // For Unidad VI priced services, prefer recalculating from Bs to keep parity with print pricing rules.
        if (preferBsReference && Number.isFinite(servicePriceBs) && servicePriceBs > 0) {
          if (bcvRate > 0) return roundTo(servicePriceBs / bcvRate, 6);
          return 0;
        }

        const itemPrice = Number(item.unit_price_usd);
        if (Number.isFinite(itemPrice) && itemPrice > 0) return itemPrice;

        if (normalizedReference === 'Unidad VI' && Number.isFinite(servicePriceBs) && servicePriceBs > 0) {
          if (bcvRate > 0) return roundTo(servicePriceBs / bcvRate, 6);
          return 0;
        }

        const defaultPrice = Number(service?.price_usd);
        if (Number.isFinite(defaultPrice) && defaultPrice > 0) return defaultPrice;

        return 0;
      };

      const resolveServiceUnitPriceBaseAmount = (service, options = {}) => {
        const normalizedReference = normalizeServiceReferenceName(service);
        const servicePriceBs = Number(service?.price_bs);

        if (baseCurrency === 'ves') {
          if (Number.isFinite(servicePriceBs) && servicePriceBs > 0) return roundTo(servicePriceBs, 2);

          const servicePriceUsd = resolveServiceUnitPriceUsd(service, { unit_price_usd: service?.price_usd }, options);
          if (Number.isFinite(servicePriceUsd) && servicePriceUsd > 0 && bcvRate > 0) {
            return roundTo(servicePriceUsd * bcvRate, 2);
          }
        }

        const resolvedUnitPriceUsd = resolveServiceUnitPriceUsd(service, { unit_price_usd: service?.price_usd }, options);
        if (baseCurrency === 'usd' && Number.isFinite(resolvedUnitPriceUsd) && resolvedUnitPriceUsd > 0) {
          return roundTo(resolvedUnitPriceUsd, 2);
        }

        if (normalizedReference === 'Unidad VI' && Number.isFinite(servicePriceBs) && servicePriceBs > 0 && baseCurrency === 'usd' && bcvRate > 0) {
          return roundTo(servicePriceBs / bcvRate, 2);
        }

        return 0;
      };

      const computeServicePricing = (service, item = {}) => {
        let unitPriceUsd = 0;
        let unitPriceBaseVes = null;
        const usesBolivarReference = serviceUsesBolivarReference(service);
        const clientServiceRule = resolveServiceRuleForClient(service, selectedClient);
        if (clientServiceRule?.mode === 'fixed' && Number(clientServiceRule.value) > 0) {
          unitPriceUsd = roundTo(Number(clientServiceRule.value), 6);
        }

        const discountPercent = resolvePrintVolumeDiscountPercent(service);
        if (!(unitPriceUsd > 0)) {
          if (service?.printing_type_service && Number(item?.selected_print_unit_price_bs) > 0 && bcvRate > 0) {
            const baseUnitBs = Number(item.selected_print_unit_price_bs);
            const discountedBs = discountPercent > 0
              ? roundTo(baseUnitBs * (1 - discountPercent / 100), 2)
              : roundTo(baseUnitBs, 2);
            unitPriceBaseVes = discountedBs;
            unitPriceUsd = roundTo(discountedBs / bcvRate, 6);
          } else {
            if (usesBolivarReference && baseCurrency === 'ves') {
              const itemBaseCurrency = normalizeCurrencyCode(item?.unit_price_base_currency);
              const itemBaseAmount = Number(item?.unit_price_base_amount);
              const fallbackBaseVes = itemBaseCurrency === 'VES' && Number.isFinite(itemBaseAmount) && itemBaseAmount > 0
                ? itemBaseAmount
                : Number(service?.price_bs || 0);

              if (Number.isFinite(fallbackBaseVes) && fallbackBaseVes > 0) {
                unitPriceBaseVes = roundTo(fallbackBaseVes, 2);
              }
            }

            const baseUnitUsd = resolveServiceUnitPriceUsd(service, item);
            unitPriceUsd = discountPercent > 0
              ? roundTo(baseUnitUsd * (1 - discountPercent / 100), 6)
              : roundTo(baseUnitUsd, 6);
          }
        }

        if (clientServiceRule?.mode === 'percent' && Number(clientServiceRule.value) > 0) {
          const percent = Math.max(0, Math.min(100, Number(clientServiceRule.value || 0)));
          unitPriceUsd = roundTo(Math.max(0, unitPriceUsd * (1 - percent / 100)), 6);
          if (Number.isFinite(unitPriceBaseVes) && unitPriceBaseVes > 0) {
            unitPriceBaseVes = roundTo(Math.max(0, unitPriceBaseVes * (1 - percent / 100)), 2);
          }
        }

        if (usesBolivarReference && baseCurrency === 'ves' && Number.isFinite(unitPriceBaseVes) && unitPriceBaseVes > 0) {
          const discountedBaseVes = applyScheduledDiscountRuleToUnitPriceBase(
            unitPriceBaseVes,
            item.quantity,
            service?.scheduled_discount_rules,
            'VES'
          );

          return computePricingFromBaseAmount(discountedBaseVes, item.quantity, { exento: false });
        }

        unitPriceUsd = applyScheduledDiscountRuleToUnitPriceUsd(
          unitPriceUsd,
          item.quantity,
          service?.scheduled_discount_rules
        );

        return computePricing(unitPriceUsd, item.quantity, { exento: false });
      };

      const computeProductPricing = (product, item = {}) => {
        let unitPriceUsd = resolveProductUnitPriceUsdForClient(product, selectedClient);
        unitPriceUsd = applyScheduledDiscountRuleToUnitPriceUsd(
          unitPriceUsd,
          item.quantity,
          product?.scheduled_discount_rules
        );
        return computePricing(unitPriceUsd, item.quantity, { exento: Boolean(product?.exento) });
      };

      const calculateCartTotals = () => {
        let taxableSubtotalBase = 0;
        let exentoSubtotalBase = 0;
        const vatMode = getVatMode();

        cart.forEach((item) => {
          const itemType = item.itemType || 'product';
          if (itemType === 'service') {
            const service = servicesById.get(String(item.serviceId));
            if (!service) return;
            const pricing = computeServicePricing(service, item);
            if (!(pricing.unitDisplay > 0)) return;
            taxableSubtotalBase = roundTo(taxableSubtotalBase + pricing.lineNet, 2);
            return;
          }

          const product = productsById.get(String(item.productId));
          if (!product) return;

          const isExento = Boolean(product.exento);
          const pricing = computeProductPricing(product, item);
          if (isExento) {
            exentoSubtotalBase = roundTo(exentoSubtotalBase + pricing.lineNet, 2);
          } else {
            taxableSubtotalBase = roundTo(taxableSubtotalBase + pricing.lineNet, 2);
          }
        });

        const vatBase = vatMode === 'none' ? 0 : roundTo(taxableSubtotalBase * vatRate, 2);
        const totalBase = roundTo(taxableSubtotalBase + exentoSubtotalBase + vatBase, 2);

        return {
          taxableSubtotalBase,
          exentoSubtotalBase,
          vatBase,
          totalBase,
        };
      };

      const escapeHtml = (value) =>
        String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');

      const escapeCssUrl = (value) => encodeURI(String(value || '').trim());

      const formatDraftUpdatedAt = (isoValue) => {
        if (!isoValue) return '';
        const date = new Date(isoValue);
        if (Number.isNaN(date.getTime())) return '';
        return date.toLocaleString('es-VE', {
          day: '2-digit',
          month: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
        });
      };

      const setBaseCurrencySelection = (nextCurrency) => {
        const candidate = normalizeBaseCurrencySelection(nextCurrency);
        const targetInput = getBaseCurrencyInputs().find((input) => input.value === candidate && !input.disabled);
        if (!targetInput) return;
        applyBaseCurrencySelection(targetInput.value);
      };

      const upsertProductsCollection = (rows) => {
        Array.from(rows || []).forEach((row) => {
          const key = String(row?.id || '');
          if (!key) return;

          productsById.set(key, row);
          const index = products.findIndex((product) => String(product?.id || '') === key);
          if (index >= 0) {
            products[index] = row;
          } else {
            products.push(row);
          }
        });
      };

      const upsertServicesCollection = (rows) => {
        Array.from(rows || []).forEach((row) => {
          const key = String(row?.id || '');
          if (!key) return;

          servicesById.set(key, row);
          const index = services.findIndex((service) => String(service?.id || '') === key);
          if (index >= 0) {
            services[index] = row;
          } else {
            services.push(row);
          }
        });
      };

      const refreshCatalogSearch = () => {
        const searchInput = document.getElementById('ventas-item-search');
        if (!searchInput) return;
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
      };

      const isElementInViewport = (element) => {
        if (!element) return false;
        const rect = element.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
        return rect.top <= viewportHeight && rect.bottom >= 0;
      };

      const syncCatalogInfiniteSentinels = () => {
        if (productsInfiniteSentinel) {
          const hasNextProductsPage = Number.isInteger(nextProductsPage) && nextProductsPage > 0;
          productsInfiniteSentinel.classList.toggle('hidden', !hasNextProductsPage || activeTab !== 'products');
          productsInfiniteSentinel.classList.toggle('opacity-60', loadingProductsCatalog);
        }

        if (servicesInfiniteSentinel) {
          const hasNextServicesPage = Number.isInteger(nextServicesPage) && nextServicesPage > 0;
          servicesInfiniteSentinel.classList.toggle('hidden', !hasNextServicesPage || activeTab !== 'services');
          servicesInfiniteSentinel.classList.toggle('opacity-60', loadingServicesCatalog);
        }
      };

      const maybeAutoLoadVisibleCatalog = () => {
        if (activeTab === 'products') {
          if (!loadingProductsCatalog && Number.isInteger(nextProductsPage) && nextProductsPage > 0 && isElementInViewport(productsInfiniteSentinel)) {
            loadMoreProductsCatalog();
          }
          return;
        }

        if (!loadingServicesCatalog && Number.isInteger(nextServicesPage) && nextServicesPage > 0 && isElementInViewport(servicesInfiniteSentinel)) {
          loadMoreServicesCatalog();
        }
      };

      const setupCatalogInfiniteScroll = () => {
        if (catalogInfiniteObserver) {
          catalogInfiniteObserver.disconnect();
        }

        if (typeof window.IntersectionObserver !== 'function') return;

        catalogInfiniteObserver = new window.IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            if (entry.target === productsInfiniteSentinel) {
              loadMoreProductsCatalog();
            }

            if (entry.target === servicesInfiniteSentinel) {
              loadMoreServicesCatalog();
            }
          });
        }, {
          root: null,
          rootMargin: '240px 0px 240px 0px',
          threshold: 0.01,
        });

        if (productsInfiniteSentinel) {
          catalogInfiniteObserver.observe(productsInfiniteSentinel);
        }

        if (servicesInfiniteSentinel) {
          catalogInfiniteObserver.observe(servicesInfiniteSentinel);
        }
      };

      const loadMoreProductsCatalog = async () => {
        if (loadingProductsCatalog) return;
        if (!(Number.isInteger(nextProductsPage) && nextProductsPage > 0)) return;
        if (!productsCatalogUrl || !productsGrid) return;

        loadingProductsCatalog = true;
        syncCatalogInfiniteSentinels();

        try {
          const response = await fetch(`${productsCatalogUrl}?page=${encodeURIComponent(nextProductsPage)}`, {
            headers: {
              Accept: 'application/json',
            },
            credentials: 'same-origin',
          });

          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(String(data.error || 'No se pudo cargar más productos.'));

          if (String(data.cards_html || '').trim()) {
            productsGrid.insertAdjacentHTML('beforeend', String(data.cards_html));
          }

          upsertProductsCollection(data.products || []);
          const parsedNext = Number.parseInt(data.next_page, 10);
          nextProductsPage = Number.isInteger(parsedNext) && parsedNext > 0 ? parsedNext : null;
          root.dataset.productsNextPage = nextProductsPage || '';

          if (window.lucide?.createIcons) {
            window.lucide.createIcons();
          }

                      updateAvailabilityUI();
                      refreshCatalogSearch();
        } catch (error) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Error al cargar productos',
              text: error.message || 'Intenta nuevamente.',
              heightAuto: false,
            });
          }
        } finally {
          loadingProductsCatalog = false;
          syncCatalogInfiniteSentinels();
          maybeAutoLoadVisibleCatalog();
        }
      };

      const loadMoreServicesCatalog = async () => {
        if (loadingServicesCatalog) return;
        if (!(Number.isInteger(nextServicesPage) && nextServicesPage > 0)) return;
        if (!servicesCatalogUrl || !servicesGrid) return;

        loadingServicesCatalog = true;
        syncCatalogInfiniteSentinels();

        try {
          const response = await fetch(`${servicesCatalogUrl}?page=${encodeURIComponent(nextServicesPage)}`, {
            headers: {
              Accept: 'application/json',
            },
            credentials: 'same-origin',
          });

          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(String(data.error || 'No se pudo cargar más servicios.'));

          servicesGrid.querySelectorAll('[data-services-placeholder]').forEach((node) => node.remove());

          if (String(data.cards_html || '').trim()) {
            servicesGrid.insertAdjacentHTML('beforeend', String(data.cards_html));
          }

          upsertServicesCollection(data.services || []);
          const parsedNext = Number.parseInt(data.next_page, 10);
          nextServicesPage = Number.isInteger(parsedNext) && parsedNext > 0 ? parsedNext : null;
          root.dataset.servicesNextPage = nextServicesPage || '';

          if (window.lucide?.createIcons) {
            window.lucide.createIcons();
          }

                      refreshCatalogSearch();
        } catch (error) {
          nextServicesPage = null;
          root.dataset.servicesNextPage = '';
          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Error al cargar servicios',
              text: error.message || 'Intenta nuevamente.',
              heightAuto: false,
            });
          }
        } finally {
          loadingServicesCatalog = false;
          syncCatalogInfiniteSentinels();
                      maybeAutoLoadVisibleCatalog();
        }
      };

      const setVatModeSelection = (nextMode, options = {}) => {
        setVatMode(nextMode, options);
      };

      window.__ventasForceVatRecalc = (mode) => {
        if (mode) {
          setVatModeSelection(mode, { render: true });
          return;
        }

        renderCart();
      };

      const startVatModeWatcher = () => {
        if (root.__ventasVatWatcherId) return;

        let previousMode = getVatMode();
        root.__ventasVatWatcherId = window.setInterval(() => {
          const currentMode = readCheckedVatMode();
          if (currentMode === previousMode) return;
          previousMode = currentMode;
          setVatMode(currentMode, { render: true });
        }, 250);

        document.addEventListener('turbo:before-cache', () => {
          if (!root.__ventasVatWatcherId) return;
          window.clearInterval(root.__ventasVatWatcherId);
          root.__ventasVatWatcherId = null;
        }, { once: true });
      };

      const updateDraftActionButtons = () => {
        const canSave = cart.size > 0;

        if (saveDraftButton) {
          saveDraftButton.disabled = !canSave;
          saveDraftButton.classList.toggle('opacity-50', !canSave);
          saveDraftButton.classList.toggle('cursor-not-allowed', !canSave);
        }

        if (clearPanelButton) {
          const canClear = cart.size > 0 || Boolean(activeDraftId);
          clearPanelButton.disabled = !canClear;
          clearPanelButton.classList.toggle('opacity-50', !canClear);
          clearPanelButton.classList.toggle('cursor-not-allowed', !canClear);
        }
      };

      const normalizeDraftCheckoutStatus = (value, fallback = 'pending') => {
        const normalized = String(value || '').trim().toLowerCase();
        if (normalized === 'ready' || normalized === 'pending') return normalized;

        const safeFallback = String(fallback || '').trim().toLowerCase();
        return safeFallback === 'ready' ? 'ready' : 'pending';
      };

      const renderDraftFilterButtons = () => {
        const readyActive = draftListFilter === 'ready';
        const pendingActive = !readyActive;

        if (draftsReadyFilterButton) {
          draftsReadyFilterButton.classList.toggle('bg-sky-600', readyActive);
          draftsReadyFilterButton.classList.toggle('text-white', readyActive);
          draftsReadyFilterButton.classList.toggle('border-sky-600', readyActive);
          draftsReadyFilterButton.classList.toggle('ring-sky-500', readyActive);
          draftsReadyFilterButton.classList.toggle('bg-sky-50', !readyActive);
          draftsReadyFilterButton.classList.toggle('text-sky-700', !readyActive);
          draftsReadyFilterButton.classList.toggle('border-sky-200', !readyActive);
        }

        if (draftsPendingFilterButton) {
          draftsPendingFilterButton.classList.toggle('bg-emerald-600', pendingActive);
          draftsPendingFilterButton.classList.toggle('text-white', pendingActive);
          draftsPendingFilterButton.classList.toggle('border-emerald-600', pendingActive);
          draftsPendingFilterButton.classList.toggle('ring-emerald-500', pendingActive);
          draftsPendingFilterButton.classList.toggle('bg-emerald-50', !pendingActive);
          draftsPendingFilterButton.classList.toggle('text-emerald-700', !pendingActive);
          draftsPendingFilterButton.classList.toggle('border-emerald-200', !pendingActive);
        }
      };

      const renderDraftTags = () => {
        if (!draftsListEl || !draftsEmptyEl || !draftsCountEl) return;

        const safeDrafts = Array.isArray(drafts) ? drafts : [];
        const filteredDrafts = safeDrafts.filter((draft) => {
          const status = normalizeDraftCheckoutStatus(draft.checkout_status, 'pending');
          return draftListFilter === 'ready' ? status === 'ready' : status === 'pending';
        });

        renderDraftFilterButtons();
        draftsCountEl.textContent = `${filteredDrafts.length}/${safeDrafts.length}`;
        draftsEmptyEl.classList.toggle('hidden', filteredDrafts.length > 0);

        if (filteredDrafts.length === 0) {
          draftsListEl.innerHTML = '';
          draftsEmptyEl.textContent = draftListFilter === 'ready'
            ? 'No hay borradores listos para cobrar.'
            : 'No hay borradores pendientes por cobrar.';
          return;
        }

        draftsEmptyEl.textContent = 'No hay borradores guardados.';

        draftsListEl.innerHTML = filteredDrafts
          .map((draft) => {
            const draftId = String(draft.id || '');
            const isActive = activeDraftId && String(activeDraftId) === draftId;
            const checkoutStatus = normalizeDraftCheckoutStatus(draft.checkout_status, 'pending');
            const isReady = checkoutStatus === 'ready';
            const clientName = String(draft.client_name || 'Cliente general');
            const itemsCount = Number(draft.items_count || 0);
            const updatedAt = formatDraftUpdatedAt(draft.updated_at);
            const createdBy = String(draft.created_by_name || '').trim() || 'Sin usuario';
            const createdLabel = updatedAt
              ? `Orden Creada por <span class="text-[12px] font-bold">${escapeHtml(createdBy)}</span> ${escapeHtml(updatedAt)}`
              : `Orden Creada por <span class="text-[12px] font-bold">${escapeHtml(createdBy)}</span>`;
            const activeBadge = isActive
              ? '<span class="inline-flex rounded-full bg-white/20 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Activo</span>'
              : '';
            const checkoutBadge = isReady
              ? '<span class="inline-flex rounded-full bg-sky-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-sky-700">Listo</span>'
              : '<span class="inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-700">Pendiente</span>';
            const chipClass = isActive
              ? 'border-sky-600 bg-sky-600 text-white shadow-sm ring-1 ring-sky-500'
              : 'border-cyan-200 bg-white text-cyan-700 ring-1 ring-cyan-200 hover:bg-cyan-50';
            const countBadgeClass = isActive
              ? 'bg-white/20 text-white'
              : 'bg-cyan-100 text-cyan-700';
            const dateTextClass = isActive ? 'text-white/85' : 'text-cyan-600/80';

            return `
              <button type="button" data-draft-id="${escapeHtml(draftId)}" class="inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors ${chipClass}">
                <span class="max-w-[12rem] truncate">${escapeHtml(clientName)}</span>
                <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full px-1.5 py-0.5 text-[11px] font-bold ${countBadgeClass}">${itemsCount}</span>
                ${checkoutBadge}
                ${activeBadge}
                ${updatedAt ? `<span class="text-[10px] font-medium ${dateTextClass}">${createdLabel}</span>` : ''}
              </button>
            `;
          })
          .join('');
      };

      const getCartQuantityForVariation = (productId, variationId) => {
        let total = 0;
        const normalizedVariation = normalizeVariationId(variationId);
        cart.forEach((item) => {
          if ((item.itemType || 'product') !== 'product') return;
          if (String(item.productId) === String(productId) && normalizeVariationId(item.variationId) === normalizedVariation) {
            total += Number(item.quantity) || 0;
          }
        });
        return total;
      };

      const getCartQuantityForProduct = (productId) => {
        let total = 0;
        cart.forEach((item) => {
          if ((item.itemType || 'product') !== 'product') return;
          if (String(item.productId) === String(productId)) {
            total += Number(item.quantity) || 0;
          }
        });
        return total;
      };

      const resolveServiceMaterialProductId = (service, materialSurchargeId) => {
        const safeMaterialSurchargeId = String(materialSurchargeId || '').trim();
        if (!safeMaterialSurchargeId) return '';

        const options = Array.isArray(service?.print_material_options) ? service.print_material_options : [];
        const option = options.find((row) => String(row?.id || '').trim() === safeMaterialSurchargeId);
        return String(option?.product_id || '').trim();
      };

      const parseMaterialQuantity = (rawValue, fallback = 1) => {
        const normalized = String(rawValue ?? '')
          .trim()
          .replace(',', '.');
        const parsed = Number.parseFloat(normalized);
        if (!Number.isFinite(parsed) || parsed <= 0) return fallback;

        return roundTo(parsed, 2);
      };

      const formatMaterialFractionLabel = (rawValue) => {
        const quantity = parseMaterialQuantity(rawValue, 1);
        if (Math.abs(quantity - 1) <= 0.001) return '1';
        if (Math.abs(quantity - 0.5) <= 0.001) return '1/2';
        if (Math.abs(quantity - 0.25) <= 0.001) return '1/4';

        return formatNumber(quantity, 2);
      };

      const normalizeServiceMaterialRowsForCart = (rows) => {
        if (!Array.isArray(rows)) return [];

        return rows
          .map((row) => {
            const source = row || {};
            const productId = String(source.productId || source.product_id || '').trim();
            const rawSurchargeId = String(source.surchargeId || source.surcharge_id || '').trim();
            const surchargeId = rawSurchargeId || (productId ? `product-${productId}` : '');
            const label = String(source.label || '').trim();
            const variationId = normalizeVariationId(source.variationId || source.variation_id);
            const variationName = String(source.variationName || source.variation_name || '').trim();
            const quantity = parseMaterialQuantity(source.quantity || '1', 1);
            const breakdownInInvoice = Boolean(source.breakdownInInvoice || source.breakdown_in_invoice);
            const optionalDeliveryExtra = Boolean(source.optionalDeliveryExtra || source.optional_delivery_extra);
            const requestedQuantity = parseMaterialQuantity(source.requestedQuantity || source.requested_quantity || quantity, quantity);
            if (!surchargeId || !productId) return null;

            return {
              surchargeId,
              productId,
              label: label || null,
              variationId: variationId || null,
              variationName: variationName || null,
              quantity,
              breakdownInInvoice,
              optionalDeliveryExtra,
              requestedQuantity,
            };
          })
          .filter(Boolean);
      };

      const materialRowsSignatureToken = (rows) => {
        const normalizedRows = normalizeServiceMaterialRowsForCart(rows);
        if (normalizedRows.length === 0) return null;

        const signature = normalizedRows
          .map((row) => `${row.surchargeId}:${row.productId}:${row.variationId || 'none'}:${row.quantity}`)
          .sort()
          .join(',');

        return signature ? `material-set-${signature}` : null;
      };

      const resolveServiceMaterialRowsForReservation = (service, item) => {
        const explicitRows = normalizeServiceMaterialRowsForCart(item?.selected_print_material_rows);
        if (explicitRows.length > 0) return explicitRows;

        const materialProductId = String(item?.selected_print_material_product_id || '').trim()
          || resolveServiceMaterialProductId(service, item?.selected_print_material_surcharge_id);
        if (!materialProductId) return [];

        return [{
          surchargeId: String(item?.selected_print_material_surcharge_id || '').trim(),
          productId: materialProductId,
          label: String(item?.selected_print_material_label || '').trim() || null,
          quantity: parseMaterialQuantity(item?.quantity_per_service_material || 1, 1),
        }];
      };

      const resolveMaterialShortageContextLabel = ({ row, materialContext }) => {
        const rowLabel = String(row?.label || '').trim();
        const sourceLabel = String(materialContext?.sourceLabel || '').trim();

        if (sourceLabel && rowLabel) {
          return sourceLabel.toLowerCase() === rowLabel.toLowerCase()
            ? sourceLabel
            : `${sourceLabel} - ${rowLabel}`;
        }

        if (rowLabel) return rowLabel;
        if (sourceLabel) return sourceLabel;
        return 'Material del servicio';
      };

      const buildServiceMaterialShortageRows = ({ service, materialRows, serviceUnits, materialContext = null }) => {
        const rows = normalizeServiceMaterialRowsForCart(materialRows);
        if (rows.length === 0) return [];

        const safeUnits = parseMaterialQuantity(serviceUnits, 1);
        const groupedRequirements = new Map();

        rows.forEach((row) => {
          const productId = String(row.productId || '').trim();
          const variationId = normalizeVariationId(row.variationId || row.variation_id);
          const requirementKey = `${productId}::${variationId || 'none'}`;
          if (!productId) return;

          const previous = groupedRequirements.get(requirementKey) || {
            label: String(row.label || '').trim() || 'Material',
            variationId,
            variationName: String(row.variationName || '').trim(),
            required: 0,
            contexts: new Map(),
          };
          const rowRequired = parseMaterialQuantity(row.quantity, 1) * safeUnits;
          const contextLabel = resolveMaterialShortageContextLabel({ row, materialContext });

          previous.required += rowRequired;
          previous.contexts.set(
            contextLabel,
            roundTo((previous.contexts.get(contextLabel) || 0) + rowRequired, 2),
          );
          groupedRequirements.set(requirementKey, previous);
        });

        const shortages = [];
        groupedRequirements.forEach((requirement, requirementKey) => {
          const [productId] = String(requirementKey).split('::');
          const product = productsById.get(productId);
          const productName = String(product?.name || '').trim();
          const variationId = normalizeVariationId(requirement.variationId);
          const variationLabel = String(requirement.variationName || '').trim();
          const labelBase = productName || requirement.label || 'Material';
          const label = variationLabel ? `${labelBase} (${variationLabel})` : labelBase;
          const available = product
            ? (variationId ? Number(getAvailableForVariation(product, variationId)) || 0 : Number(getAvailableTotal(product)) || 0)
            : 0;
          const required = roundTo(requirement.required, 2);
          const missing = roundTo(Math.max(0, required - available), 2);
          if (!(missing > 0)) return;

          shortages.push({
            label,
            required,
            available: roundTo(Math.max(0, available), 2),
            missing,
            contexts: Array.from(requirement.contexts.entries()).map(([contextLabel, contextRequired]) => ({
              label: contextLabel,
              required: roundTo(contextRequired, 2),
            })),
          });
        });

        return shortages;
      };

      const notifyServiceMaterialShortage = async ({ service, shortages, serviceUnits }) => {
        if (!Array.isArray(shortages) || shortages.length === 0) return;
        if (!window.Swal) return;

        const serviceLabel = escapeHtml(String(service?.name || service?.sale_display_name || 'Servicio'));
        const unitsLabel = formatNumber(parseMaterialQuantity(serviceUnits, 1), 2);
        const rowsHtml = shortages
          .map((row) => `
            <li class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-left">
              <p class="text-sm font-semibold text-rose-700">${escapeHtml(row.label)}</p>
              <p class="text-xs text-rose-700">Requerido: ${formatNumber(row.required, 2)} · Disponible: ${formatNumber(row.available, 2)} · Faltan: ${formatNumber(row.missing, 2)}</p>
              ${Array.isArray(row.contexts) && row.contexts.length > 0
                ? `<p class="mt-1 text-[11px] text-rose-700">Origen: ${row.contexts
                  .map((contextRow) => `${escapeHtml(contextRow.label)} (${formatNumber(contextRow.required, 2)})`)
                  .join(' · ')}</p>`
                : ''}
            </li>
          `)
          .join('');

        await window.Swal.fire({
          icon: 'warning',
          title: 'Stock insuficiente de materiales',
          html: `
            <div class="space-y-3 text-left">
              <p class="text-sm text-slate-600">No se puede cargar al panel el servicio <strong>${serviceLabel}</strong> (${unitsLabel} unidad(es)).</p>
              <ul class="space-y-2">${rowsHtml}</ul>
            </div>
          `,
          confirmButtonText: 'Entendido',
          heightAuto: false,
        });
      };

      const ensureServiceMaterialsAvailability = async ({ service, materialRows, serviceUnits, materialContext = null }) => {
        const shortages = buildServiceMaterialShortageRows({ service, materialRows, serviceUnits, materialContext });
        if (shortages.length === 0) return true;

        await notifyServiceMaterialShortage({ service, shortages, serviceUnits });
        return false;
      };

      const getCartQuantityForPrintMaterialProduct = (productId) => {
        const safeProductId = String(productId || '').trim();
        if (!safeProductId) return 0;

        let total = 0;
        cart.forEach((item) => {
          if ((item.itemType || 'product') !== 'service') return;

          const service = servicesById.get(String(item.serviceId || ''));
          if (!service) return;

          resolveServiceMaterialRowsForReservation(service, item).forEach((row) => {
            if (String(row.productId || '').trim() !== safeProductId) return;

            total += (Number(item.quantity) || 0) * (Number(row.quantity) || 0);
          });
        });

        return total;
      };

      const getCartQuantityForPrintMaterialVariation = (productId, variationId) => {
        const safeProductId = String(productId || '').trim();
        const safeVariationId = normalizeVariationId(variationId);
        if (!safeProductId || !safeVariationId) return 0;

        let total = 0;
        cart.forEach((item) => {
          if ((item.itemType || 'product') !== 'service') return;

          const service = servicesById.get(String(item.serviceId || ''));
          if (!service) return;

          resolveServiceMaterialRowsForReservation(service, item).forEach((row) => {
            const rowProductId = String(row.productId || '').trim();
            const rowVariationId = normalizeVariationId(row.variationId || row.variation_id);
            if (rowProductId !== safeProductId || rowVariationId !== safeVariationId) return;

            total += (Number(item.quantity) || 0) * (Number(row.quantity) || 0);
          });
        });

        return total;
      };

      const getAvailableForVariation = (product, variationId) => {
        const normalizedVariation = normalizeVariationId(variationId);
        const variation = (product.variations || []).find((row) => normalizeVariationId(row.id) === normalizedVariation);
        const baseAvailable = variation ? Number(variation.available) || 0 : 0;
        const inCart = getCartQuantityForVariation(product.id, normalizedVariation);
        const syncedReserved = syncedReservedQuantityForVariation(product.id, normalizedVariation);
        const pendingReservation = Math.max(0, inCart - syncedReserved);
        const inCartPrintMaterial = getCartQuantityForPrintMaterialVariation(product.id, normalizedVariation);
        const syncedReservedPrintMaterial = syncedReservedQuantityForPrintMaterialVariation(product.id, normalizedVariation);
        const pendingPrintMaterialReservation = Math.max(0, inCartPrintMaterial - syncedReservedPrintMaterial);
        return Math.max(0, baseAvailable - pendingReservation - pendingPrintMaterialReservation);
      };

      const getAvailableTotal = (product) => {
        const baseTotal = Number(product.available_total) || 0;
        const inCart = getCartQuantityForProduct(product.id);
        const syncedReserved = syncedReservedQuantityForProduct(product.id);
        const pendingReservation = Math.max(0, inCart - syncedReserved);

        const inCartPrintMaterial = getCartQuantityForPrintMaterialProduct(product.id);
        const syncedReservedPrintMaterial = syncedReservedQuantityForPrintMaterialProduct(product.id);
        const pendingPrintMaterialReservation = Math.max(0, inCartPrintMaterial - syncedReservedPrintMaterial);

        return Math.max(0, baseTotal - pendingReservation - pendingPrintMaterialReservation);
      };

      const buildProductCardVariationsHtml = (product) => {
        const variationRows = Array.isArray(product?.variations) ? product.variations : [];
        const availableRows = variationRows.filter((variation) => getAvailableForVariation(product, variation.id) > 0);

        if (availableRows.length === 0) {
          return '<span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500 ring-1 ring-slate-200">Sin stock por variacion</span>';
        }

        const visibleRows = availableRows.slice(0, 3);
        const extraCount = Math.max(0, availableRows.length - visibleRows.length);

        const chips = visibleRows
          .map((variation) => {
            const variationName = String(variation?.name || 'Unica');
            return `<span class="max-w-[5.5rem] truncate rounded-full bg-cyan-50 px-2 py-0.5 text-[10px] font-semibold text-cyan-700 ring-1 ring-cyan-100">${escapeHtml(variationName)}</span>`;
          })
          .join('');

        if (!(extraCount > 0)) return chips;

        return `${chips}<span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600 ring-1 ring-slate-200">+${extraCount}</span>`;
      };

      const compareVariationNames = (leftName, rightName) => String(leftName || 'Unica').localeCompare(
        String(rightName || 'Unica'),
        'es',
        { sensitivity: 'base' }
      );

      const sortVariationSelectionEntries = (entries) => Array.from(entries || []).sort((left, right) => {
        const leftHasStock = Number((Number(left?.available) || 0) > 0);
        const rightHasStock = Number((Number(right?.available) || 0) > 0);
        if (leftHasStock !== rightHasStock) return rightHasStock - leftHasStock;

        const nameComparison = compareVariationNames(left?.name, right?.name);
        if (nameComparison !== 0) return nameComparison;

        return String(normalizeVariationId(left?.id) || '').localeCompare(String(normalizeVariationId(right?.id) || ''), 'es', { sensitivity: 'base' });
      });

      const sortVariationSelectionRows = (container) => {
        if (!container) return;

        const sortedRows = Array.from(container.querySelectorAll('[data-variation-row]')).sort((leftRow, rightRow) => {
          const leftHasStock = Number((Number.parseInt(leftRow.dataset.variationAvailable || '0', 10) || 0) > 0);
          const rightHasStock = Number((Number.parseInt(rightRow.dataset.variationAvailable || '0', 10) || 0) > 0);
          if (leftHasStock !== rightHasStock) return rightHasStock - leftHasStock;

          const nameComparison = compareVariationNames(leftRow.dataset.variationName, rightRow.dataset.variationName);
          if (nameComparison !== 0) return nameComparison;

          return String(normalizeVariationId(leftRow.dataset.variationId || null) || '').localeCompare(
            String(normalizeVariationId(rightRow.dataset.variationId || null) || ''),
            'es',
            { sensitivity: 'base' }
          );
        });

        sortedRows.forEach((row) => container.appendChild(row));
      };

      const applyVariationRowAvailabilityState = (row, available) => {
        if (!row) return;

        const isDisabled = available <= 0;
        const nameLabel = row.querySelector('[data-variation-name-label]');
        const metaLabel = row.querySelector('[data-variation-meta]');
        const statusBadge = row.querySelector('[data-variation-status-badge]');
        const qtyInput = row.querySelector('[data-variation-qty]');
        const actionButtons = row.querySelectorAll('[data-qty-action]');

        row.classList.toggle('border-slate-200', !isDisabled);
        row.classList.toggle('bg-white', !isDisabled);
        row.classList.toggle('hover:bg-slate-50', !isDisabled);
        row.classList.toggle('border-rose-200', isDisabled);
        row.classList.toggle('bg-rose-50/80', isDisabled);
        row.classList.toggle('cursor-not-allowed', isDisabled);
        row.classList.remove('opacity-50');

        if (nameLabel) {
          nameLabel.classList.toggle('text-slate-700', !isDisabled);
          nameLabel.classList.toggle('text-rose-700', isDisabled);
        }

        if (metaLabel) {
          metaLabel.classList.toggle('text-slate-500', !isDisabled);
          metaLabel.classList.toggle('text-rose-600', isDisabled);
        }

        if (statusBadge) {
          statusBadge.textContent = isDisabled ? 'Sin stock' : 'Disponible';
          statusBadge.className = isDisabled
            ? 'inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-[10px] font-bold text-rose-700 ring-1 ring-rose-200'
            : 'inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-700 ring-1 ring-emerald-200';
        }

        actionButtons.forEach((button) => {
          button.disabled = isDisabled;
          button.classList.toggle('border-slate-200', !isDisabled);
          button.classList.toggle('text-slate-500', !isDisabled);
          button.classList.toggle('hover:bg-slate-50', !isDisabled);
          button.classList.toggle('border-rose-200', isDisabled);
          button.classList.toggle('bg-rose-100', isDisabled);
          button.classList.toggle('text-rose-400', isDisabled);
          button.classList.toggle('cursor-not-allowed', isDisabled);
        });

        if (qtyInput) {
          qtyInput.disabled = isDisabled;
          qtyInput.classList.toggle('border-slate-200', !isDisabled);
          qtyInput.classList.toggle('bg-white', !isDisabled);
          qtyInput.classList.toggle('text-slate-700', !isDisabled);
          qtyInput.classList.toggle('border-rose-200', isDisabled);
          qtyInput.classList.toggle('bg-rose-100', isDisabled);
          qtyInput.classList.toggle('text-rose-500', isDisabled);
        }
      };

      const syncOpenVariationSelectionModal = () => {
        if (!window.Swal || typeof window.Swal.getHtmlContainer !== 'function') return;

        const dialog = window.Swal.getHtmlContainer();
        if (!dialog) return;

        const modalRoot = dialog.querySelector('[data-variation-modal-product-id]');
        if (!modalRoot) return;

        const rowsContainer = modalRoot.querySelector('[data-variation-modal-list]');

        const modalProductId = modalRoot.dataset.variationModalProductId;
        const modalProduct = productsById.get(String(modalProductId));
        if (!modalProduct) return;

        dialog.querySelectorAll('[data-variation-row]').forEach((row) => {
          const variationId = normalizeVariationId(row.dataset.variationId || null);
          const available = getAvailableForVariation(modalProduct, variationId);
          row.dataset.variationAvailable = String(available);

          const qtyInput = row.querySelector('[data-variation-qty]');
          const availableLabel = row.querySelector('[data-variation-available-label]');
          applyVariationRowAvailabilityState(row, available);

          if (!qtyInput) return;

          let selected = Number.parseInt(String(qtyInput.value || '').replace(/\D/g, ''), 10) || 0;
          selected = Math.min(Math.max(selected, 0), available);
          qtyInput.value = selected > 0 ? String(selected) : '0';

          if (availableLabel) {
            const remaining = Math.max(0, available - selected);
            availableLabel.textContent = formatNumber(remaining, 0);
          }
        });

        sortVariationSelectionRows(rowsContainer || dialog);
      };

      const updateProductCardMeta = () => {
        document.querySelectorAll('.ventas-product-card').forEach((card) => {
          const productId = card.dataset.productId;
          const product = productsById.get(String(productId));
          if (!product) return;

          const variationRows = Array.isArray(product.variations) ? product.variations : [];
          const availableVariationCount = variationRows.filter((variation) => getAvailableForVariation(product, variation.id) > 0).length;

          const variationCountEl = card.querySelector(`[data-product-variation-count="${productId}"]`);
          if (variationCountEl) {
            variationCountEl.textContent = `${availableVariationCount} var.`;
          }

          const variationsEl = card.querySelector(`[data-product-variations="${productId}"]`);
          if (variationsEl) {
            variationsEl.innerHTML = buildProductCardVariationsHtml(product);
          }

          const unitPriceUsd = Number(product.price_usd) || 0;

          const priceUsdEl = card.querySelector(`[data-product-price-usd="${productId}"]`);
          if (priceUsdEl) {
            priceUsdEl.textContent = formatMoney(unitPriceUsd, '$');
          }

          const priceBsEl = card.querySelector(`[data-product-price-bs="${productId}"]`);
          if (priceBsEl) {
            priceBsEl.textContent = bcvRate > 0 ? formatMoney(unitPriceUsd * bcvRate, 'Bs ') : 'Bs --';
          }
        });
      };

      const updateAvailabilityUI = () => {
        document.querySelectorAll('[data-product-stock]').forEach((el) => {
          const productId = el.dataset.productStock;
          const product = productsById.get(String(productId));
          if (!product) return;
          el.textContent = formatNumber(getAvailableTotal(product), 0);
        });

        updateProductCardMeta();
        updateProductCardStates();
        syncOpenVariationSelectionModal();
      };

      const updateProductCardStates = () => {
        document.querySelectorAll('.ventas-product-card').forEach((card) => {
          const productId = card.dataset.productId;
          const product = productsById.get(String(productId));
          if (!product) return;

          const inCart = getCartQuantityForProduct(productId) > 0;
          const available = getAvailableTotal(product);
          const outOfStock = available <= 0;

          card.classList.toggle('ring-2', inCart);
          card.classList.toggle('ring-cyan-300', inCart);
          card.classList.toggle('border-cyan-300', inCart);
          card.classList.toggle('border-rose-300', outOfStock);
          card.classList.toggle('ring-1', outOfStock);
          card.classList.toggle('ring-rose-200', outOfStock);
          card.classList.toggle('opacity-70', outOfStock);
          card.classList.toggle('cursor-not-allowed', outOfStock);

          const overlay = card.querySelector('[data-out-of-stock]');
          if (overlay) {
            overlay.classList.toggle('hidden', !outOfStock);
            overlay.classList.toggle('flex', outOfStock);
          }
        });
      };

      const initSearchTabs = () => {
        const searchInput = document.getElementById('ventas-item-search');
        const clearButton = document.getElementById('ventas-item-search-clear');
        const productPanel = document.getElementById('ventas-product-panel');
        const servicePanel = document.getElementById('ventas-service-panel');
        const tabButtons = Array.from(root.querySelectorAll('[data-ventas-tab]'));
        const categoryButtons = Array.from(root.querySelectorAll('[data-product-category-filter]'));
        const serviceSystemButtons = Array.from(root.querySelectorAll('[data-service-system-filter]'));
        if (!searchInput || !clearButton || !productPanel || !servicePanel) return;

        const updateSearchEmptyStates = ({ query, visibleProducts, visibleServices }) => {
          const hasQuery = query.length > 0;

          if (productsNoResultsEl) {
            const totalProductCards = productsGrid ? productsGrid.querySelectorAll('[data-product-query]').length : 0;
            const showProductsEmpty = hasQuery && totalProductCards > 0 && visibleProducts === 0;
            productsNoResultsEl.classList.toggle('hidden', !showProductsEmpty);
          }

          if (servicesNoResultsEl) {
            const totalServiceCards = servicesGrid ? servicesGrid.querySelectorAll('[data-service-query]').length : 0;
            const servicesLoading = Boolean(servicesGrid?.querySelector('[data-services-placeholder]'));
            const showServicesEmpty = hasQuery && !servicesLoading && totalServiceCards > 0 && visibleServices === 0;
            servicesNoResultsEl.classList.toggle('hidden', !showServicesEmpty);
          }
        };

        const applySearch = () => {
          const query = normalizeSearchValue(searchInput.value);
          clearButton.classList.toggle('hidden', query.length === 0);

          let visibleProducts = 0;
          let visibleServices = 0;

          document.querySelectorAll('[data-product-query]').forEach((card) => {
            const cardValue = normalizeSearchValue(card.dataset.productQuery);
            const cardCategory = normalizeSearchValue(card.dataset.productCategory || '');
            const matchesCategory = activeProductCategory.length === 0 || cardCategory === activeProductCategory;
            const visible = !((query.length > 0 && !cardValue.includes(query)) || !matchesCategory);
            card.classList.toggle('hidden', !visible);
            if (visible) visibleProducts += 1;
          });

          document.querySelectorAll('[data-service-query]').forEach((card) => {
            const cardValue = normalizeSearchValue(card.dataset.serviceQuery);
            const cardSystem = normalizeSearchValue(card.dataset.serviceSystem || '');
            const matchesSystem = activeServiceSystem.length === 0 || cardSystem === activeServiceSystem;
            const visible = !((query.length > 0 && !cardValue.includes(query)) || !matchesSystem);
            card.classList.toggle('hidden', !visible);
            if (visible) visibleServices += 1;
          });

          updateSearchEmptyStates({ query, visibleProducts, visibleServices });

          syncCatalogInfiniteSentinels();
          maybeAutoLoadVisibleCatalog();
        };

        const updateTabStyles = () => {
          tabButtons.forEach((button) => {
            const isActive = button.dataset.ventasTab === activeTab;
            button.classList.toggle('bg-sky-600', isActive);
            button.classList.toggle('text-white', isActive);
            button.classList.toggle('border-sky-600', isActive);
            button.classList.toggle('shadow-lg', isActive);
            button.classList.toggle('shadow-sky-200', isActive);
            button.classList.toggle('hover:bg-sky-700', isActive);
            button.classList.toggle('hover:text-white', isActive);
            button.classList.toggle('bg-white', !isActive);
            button.classList.toggle('text-slate-600', !isActive);
            button.classList.toggle('border-slate-200', !isActive);
            button.classList.toggle('hover:bg-slate-50', !isActive);
            button.classList.toggle('hover:text-slate-700', !isActive);
          });
        };

        const updateCategoryFilterStyles = () => {
          categoryButtons.forEach((button) => {
            const categoryValue = normalizeSearchValue(button.dataset.productCategoryFilter || '');
            const isActive = categoryValue === activeProductCategory;

            button.classList.toggle('bg-sky-600', isActive);
            button.classList.toggle('text-white', isActive);
            button.classList.toggle('border-sky-600', isActive);
            button.classList.toggle('shadow-sm', isActive);
            button.classList.toggle('hover:bg-sky-700', isActive);
            button.classList.toggle('hover:text-white', isActive);
            button.classList.toggle('bg-white', !isActive);
            button.classList.toggle('text-cyan-700', !isActive);
            button.classList.toggle('border-cyan-200', !isActive);
            button.classList.toggle('ring-1', !isActive);
            button.classList.toggle('ring-cyan-200', !isActive);
            button.classList.toggle('hover:bg-cyan-50', !isActive);
            button.classList.toggle('hover:text-cyan-700', !isActive);
          });
        };

        const updateServiceSystemFilterStyles = () => {
          serviceSystemButtons.forEach((button) => {
            const systemValue = normalizeSearchValue(button.dataset.serviceSystemFilter || '');
            const isActive = systemValue === activeServiceSystem;

            button.classList.toggle('bg-sky-600', isActive);
            button.classList.toggle('text-white', isActive);
            button.classList.toggle('border-sky-600', isActive);
            button.classList.toggle('shadow-sm', isActive);
            button.classList.toggle('hover:bg-sky-700', isActive);
            button.classList.toggle('hover:text-white', isActive);
            button.classList.toggle('bg-white', !isActive);
            button.classList.toggle('text-cyan-700', !isActive);
            button.classList.toggle('border-cyan-200', !isActive);
            button.classList.toggle('ring-1', !isActive);
            button.classList.toggle('ring-cyan-200', !isActive);
            button.classList.toggle('hover:bg-cyan-50', !isActive);
            button.classList.toggle('hover:text-cyan-700', !isActive);
          });
        };

        const setActiveTab = (tab) => {
          activeTab = tab === 'services' ? 'services' : 'products';
          productPanel.classList.toggle('hidden', activeTab !== 'products');
          servicePanel.classList.toggle('hidden', activeTab !== 'services');
          updateTabStyles();
          syncCatalogInfiniteSentinels();
          applySearch();
          if (activeTab === 'services' && servicesGrid && servicesGrid.children.length === 0) {
            if (!loadingServicesCatalog && Number.isInteger(nextServicesPage) && nextServicesPage > 0) {
              loadMoreServicesCatalog();
            }
          }
        };

        searchInput.addEventListener('input', applySearch);
        clearButton.addEventListener('click', () => {
          searchInput.value = '';
          applySearch();
          searchInput.focus();
        });

        tabButtons.forEach((button) => {
          button.addEventListener('click', () => {
            setActiveTab(button.dataset.ventasTab);
          });
        });

        categoryButtons.forEach((button) => {
          button.addEventListener('click', () => {
            activeProductCategory = normalizeSearchValue(button.dataset.productCategoryFilter || '');
            updateCategoryFilterStyles();
            applySearch();
          });
        });

        serviceSystemButtons.forEach((button) => {
          button.addEventListener('click', () => {
            activeServiceSystem = normalizeSearchValue(button.dataset.serviceSystemFilter || '');
            updateServiceSystemFilterStyles();
            applySearch();
          });
        });

        updateCategoryFilterStyles();
        updateServiceSystemFilterStyles();
        setActiveTab(activeTab);
      };

      initSearchTabs();
      setupCatalogInfiniteScroll();
      syncCatalogInfiniteSentinels();
      maybeAutoLoadVisibleCatalog();
      startVatModeWatcher();

      const renderTotals = () => {
        const vatMode = getVatMode();
        const totals = calculateCartTotals();
        const subtotalBase = totals.taxableSubtotalBase;
        const exentoBase = totals.exentoSubtotalBase;
        const vatBase = totals.vatBase;
        const totalBase = totals.totalBase;

        const setText = (id, value) => {
          const el = document.getElementById(id);
          if (el) el.textContent = value;
        };

        setText('ventas-subtotal-usd', formatBaseMoney(subtotalBase));
        setText('ventas-subtotal-bs', formatAltFromBase(subtotalBase));
        setText('ventas-exento-usd', formatBaseMoney(exentoBase));
        setText('ventas-exento-bs', formatAltFromBase(exentoBase));
        setText('ventas-iva-usd', formatBaseMoney(vatBase));
        setText('ventas-iva-bs', formatAltFromBase(vatBase));
        setText('ventas-total-usd', formatBaseMoney(totalBase));
        setText('ventas-total-bs', formatAltFromBase(totalBase));

          const ivaLabel = document.getElementById('ventas-iva-label');
        if (ivaLabel) {
          ivaLabel.textContent = vatMode === 'none' ? 'IVA' : 'IVA 16%';
        }
      };

      const renderCart = () => {
        const cartList = document.getElementById('ventas-cart-list');
        const emptyState = document.getElementById('ventas-cart-empty');
        const payButton = document.getElementById('ventas-pay-button');

        const updateCartBadge = () => {
          if (!cartCountBadge) return;
          const totalUnits = Array.from(cart.values()).reduce((sum, item) => sum + Number(item.quantity || 0), 0);
          if (totalUnits > 0) {
            cartCountBadge.textContent = String(totalUnits);
            cartCountBadge.classList.remove('hidden');
            cartCountBadge.classList.add('inline-flex');
          } else {
            cartCountBadge.textContent = '0';
            cartCountBadge.classList.add('hidden');
            cartCountBadge.classList.remove('inline-flex');
          }
        };

        // Keep totals/IVA reactive even if the visual cart container changes.
        if (!cartList) {
          renderTotals();
          updateDraftActionButtons();
          updateAvailabilityUI();
          updateCartBadge();
          queueActiveDraftSync();
          return;
        }

        if (cart.size === 0) {
          cartList.innerHTML = '';
          emptyState?.classList.remove('hidden');
          if (payButton) {
            payButton.classList.add('opacity-60', 'cursor-not-allowed');
            payButton.disabled = true;
          }
          updateDraftActionButtons();
          renderTotals();
          updateAvailabilityUI();
          updateCartBadge();
          queueActiveDraftSync();
          return;
        }

        emptyState?.classList.add('hidden');
        if (payButton) {
          if (hasOpenCashShift) {
            payButton.classList.remove('opacity-60', 'cursor-not-allowed');
            payButton.disabled = false;
          } else {
            payButton.classList.add('opacity-60', 'cursor-not-allowed');
            payButton.disabled = true;
          }
        }

        updateDraftActionButtons();

        const itemsHtml = Array.from(cart.entries()).map(([key, item]) => {
          const itemType = item.itemType || 'product';
          if (itemType === 'service') {
            const service = servicesById.get(String(item.serviceId));
            if (!service) return '';
            const pricing = computeServicePricing(service, item);
            if (!(pricing.unitDisplay > 0)) return '';
            const saleBaseName = String(service.sale_display_name || service.name || 'Servicio').trim();
            const isPrintingService = Boolean(service?.printing_type_service);
            const recargaBaseAmount = Number(item.recarga_base_amount || 0);
            const recargaTotalAmount = Number(item.recarga_total_amount || 0);
            const materialLabels = normalizeServiceMaterialRowsForCart(item.selected_print_material_rows)
              .map((row) => String(row.label || '').trim())
              .filter((label, index, array) => label.length > 0 && array.indexOf(label) === index);
            const selectedMaterialLabel = String(item.selected_print_material_label || '').trim()
              || (materialLabels[0] || '');
            const displayName = isRecargaService(service) && recargaBaseAmount > 0
              ? `Recarga ${saleBaseName} ${formatMoney(recargaBaseAmount, 'Bs ')}`
              : (isPrintingService && selectedMaterialLabel
                ? `${saleBaseName} ${selectedMaterialLabel}`
                : saleBaseName);
            const deliveryLabel = item.delivery_presentation === 'physical'
              ? 'Entrega fisica'
              : (item.delivery_presentation === 'digital' ? 'Entrega digital' : null);
            const materialLabel = materialLabels.length > 0
              ? ` · Materiales: ${escapeHtml(materialLabels.join(' / '))}`
              : '';
            const physicalPrinting = service?.physical_printing;
            const physicalPrintingLabel = item.delivery_presentation === 'physical' && physicalPrinting?.enabled
              ? ` · Impresion: ${formatCurrencyValue(Number(physicalPrinting.cost_bs || 0), 'VES')}`
              : '';
            const agreedReference = service.price_on_request && item.agreed_reference_name
              ? ` · ${escapeHtml(item.agreed_reference_name)}`
              : '';
            const agreedDisplay = service.price_on_request && item.agreed_price_display
              ? ` · Acordado: ${escapeHtml(item.agreed_price_display)}`
              : '';
            const recargaDisplay = isRecargaService(service) && recargaTotalAmount > 0
              ? ` · Total recarga: ${escapeHtml(formatMoney(recargaTotalAmount, 'Bs '))}`
              : '';

            return `
              <div class="rounded-xl border border-slate-200 bg-white px-3 py-3" data-cart-key="${key}">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-slate-700 truncate">${escapeHtml(displayName)}</p>
                      <p class="mt-1 text-[11px] text-slate-400">Servicio${service.price_on_request ? ` (a convenir${agreedReference})` : ''}${deliveryLabel ? ` · ${deliveryLabel}` : ''}${materialLabel} · Unit: ${formatBaseMoney(pricing.unitDisplay)} · ${formatAltFromBase(pricing.unitDisplay)}${physicalPrintingLabel}${agreedDisplay}${recargaDisplay}</p>
                  </div>
                  <button type="button" class="text-slate-300 hover:text-red-500" data-cart-action="remove" data-cart-key="${key}">
                    <i data-lucide="x" class="w-4 h-4"></i>
                  </button>
                </div>
                <div class="mt-3 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <button type="button" class="h-7 w-7 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" data-cart-action="decrease" data-cart-key="${key}">-</button>
                    <span class="text-sm font-semibold text-slate-700">${formatNumber(item.quantity, 0)}</span>
                    <button type="button" class="h-7 w-7 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" data-cart-action="increase" data-cart-key="${key}">+</button>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-bold text-slate-700">${formatBaseMoney(pricing.lineTotal)}</p>
                    <p class="text-[11px] text-slate-400">${formatAltFromBase(pricing.lineTotal)}</p>
                  </div>
                </div>
              </div>
            `;
          }

          const product = productsById.get(String(item.productId));
          if (!product) return '';

          const pricing = computeProductPricing(product, item);
          const variation = (product.variations || []).find((row) => normalizeVariationId(row.id) === normalizeVariationId(item.variationId));
          const variationName = variation ? variation.name : 'Unica';
          const displayName = `${product.name} ${variationName}`.trim();
          const exentoLabel = product.exento ? ' · Exento IVA' : '';

          return `
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-3" data-cart-key="${key}">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-semibold text-slate-700 truncate">${escapeHtml(displayName)}</p>
                  <p class="mt-1 text-[11px] text-slate-400">Unit: ${formatBaseMoney(pricing.unitDisplay)} · ${formatAltFromBase(pricing.unitDisplay)}${exentoLabel}</p>
                </div>
                <button type="button" class="text-slate-300 hover:text-red-500" data-cart-action="remove" data-cart-key="${key}">
                  <i data-lucide="x" class="w-4 h-4"></i>
                </button>
              </div>
              <div class="mt-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <button type="button" class="h-7 w-7 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" data-cart-action="decrease" data-cart-key="${key}">-</button>
                  <span class="text-sm font-semibold text-slate-700">${formatNumber(item.quantity, 0)}</span>
                  <button type="button" class="h-7 w-7 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" data-cart-action="increase" data-cart-key="${key}">+</button>
                </div>
                <div class="text-right">
                  <p class="text-sm font-bold text-slate-700">${formatBaseMoney(pricing.lineTotal)}</p>
                  <p class="text-[11px] text-slate-400">${formatAltFromBase(pricing.lineTotal)}</p>
                </div>
              </div>
            </div>
          `;
        }).join('');

        cartList.innerHTML = itemsHtml;
        renderTotals();
        updateAvailabilityUI();

        if (window.lucide && typeof window.lucide.createIcons === 'function') {
          window.lucide.createIcons();
        }

        updateCartBadge();
        queueActiveDraftSync();
      };

      vatRenderReady = true;

      const setCartModalOpen = (isOpen) => {
        if (!cartModal || !cartBackdrop || !cartPanel) return;

        if (isOpen) {
          cartModal.classList.remove('pointer-events-none');
          cartModal.setAttribute('aria-hidden', 'false');
          cartBackdrop.classList.add('opacity-100');
          cartPanel.classList.remove('translate-x-full');
          cartPanel.classList.add('translate-x-0');
          return;
        }

        cartBackdrop.classList.remove('opacity-100');
        cartPanel.classList.remove('translate-x-0');
        cartPanel.classList.add('translate-x-full');
        cartModal.setAttribute('aria-hidden', 'true');
        window.setTimeout(() => {
          cartModal.classList.add('pointer-events-none');
        }, 300);
      };

      if (cartToggleButton && !cartToggleButton.dataset.boundModal) {
        cartToggleButton.dataset.boundModal = 'true';
        cartToggleButton.addEventListener('click', () => setCartModalOpen(true));
      }

      if (cartCloseButton && !cartCloseButton.dataset.boundModal) {
        cartCloseButton.dataset.boundModal = 'true';
        cartCloseButton.addEventListener('click', () => setCartModalOpen(false));
      }

      if (cartBackdrop && !cartBackdrop.dataset.boundModal) {
        cartBackdrop.dataset.boundModal = 'true';
        cartBackdrop.addEventListener('click', () => setCartModalOpen(false));
      }

      const addToCart = (productId, variationId, quantity) => {
        const product = productsById.get(String(productId));
        if (!product) return;

        const normalizedVariation = normalizeVariationId(variationId);

        const available = getAvailableForVariation(product, normalizedVariation);
        if (quantity > available) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'warning',
              title: 'Stock insuficiente',
              text: `Disponible: ${formatNumber(available, 0)}`,
              heightAuto: false,
            });
          }
          return;
        }

        const key = buildKey('product', productId, normalizedVariation);
        const existing = cart.get(key) || {
          itemType: 'product',
          productId: String(productId),
          variationId: normalizedVariation,
          quantity: 0,
        };

        existing.quantity += quantity;
        cart.set(key, existing);
        renderCart();
      };

      const resolveServiceDeliveryOptions = (service) => {
        if (!service) return [];

        const options = [];
        const physicalEnabled = Boolean(service.delivery_physical_enabled) || Boolean(service.physical_printing?.enabled);
        const digitalEnabled = Boolean(service.delivery_digital_enabled);

        if (physicalEnabled) options.push({ value: 'physical', label: 'Fisico' });
        if (digitalEnabled) options.push({ value: 'digital', label: 'Digital' });
        return options;
      };

      const resolveConfiguredPhysicalMaterials = (service, deliveryPresentation) => {
        if (!service || String(deliveryPresentation || '').toLowerCase() !== 'physical') return null;

        const configuredRows = Array.isArray(service?.physical_printing?.material_rows)
          ? service.physical_printing.material_rows
          : [];

        const normalizedRows = configuredRows
          .map((row) => {
            const surchargeId = String(row?.surcharge_id || '').trim();
            const productId = String(row?.product_id || '').trim();
            const label = String(row?.label || '').trim();
            const quantity = Number.parseInt(String(row?.quantity || '1').replace(/\D/g, ''), 10);
            if (!surchargeId || !productId) return null;

            return {
              surchargeId,
              productId,
              label: label || null,
              quantity: Number.isInteger(quantity) && quantity > 0 ? quantity : 1,
            };
          })
          .filter(Boolean);

        if (normalizedRows.length > 0) return normalizedRows;

        const fallback = service?.physical_printing?.material;
        const surchargeId = String(fallback?.surcharge_id || '').trim();
        const productId = String(fallback?.product_id || '').trim();
        const label = String(fallback?.label || '').trim();
        if (!surchargeId || !productId) return null;

        return [{ surchargeId, productId, label: label || null, quantity: 1 }];
      };

      const resolveConfiguredPhysicalDeliveryExtraRows = (service, deliveryPresentation) => {
        if (!service || String(deliveryPresentation || '').toLowerCase() !== 'physical') return [];

        const configuredRows = Array.isArray(service?.physical_printing?.extra_products)
          ? service.physical_printing.extra_products
          : [];

        return configuredRows
          .map((row) => {
            const productId = String(row?.product_id || '').trim();
            const productName = String(row?.product_name || '').trim();
            const variationId = normalizeVariationId(row?.variation_id);
            const variationName = String(row?.variation_name || '').trim();
            const quantity = parseMaterialQuantity(row?.quantity || '1', 1);
            if (!productId || !variationId || !(quantity > 0)) return null;

            return {
              surchargeId: `physical-extra-${productId}-${variationId}`,
              productId,
              label: productName || 'Producto adicional de entrega',
              variationId,
              variationName: variationName || null,
              quantity,
              requestedQuantity: quantity,
              optionalDeliveryExtra: true,
              breakdownInInvoice: Boolean(row?.breakdown_in_invoice),
            };
          })
          .filter(Boolean);
      };

      const resolvePhysicalExtraRowsWithAvailability = async ({ service, extraRows, serviceUnits }) => {
        const normalizedRows = normalizeServiceMaterialRowsForCart(extraRows);
        if (normalizedRows.length === 0) return [];

        const safeUnits = parseMaterialQuantity(serviceUnits, 1);
        const adjustedRows = [];
        const stockRows = [];

        normalizedRows.forEach((row) => {
          const product = productsById.get(String(row.productId || ''));
          const available = product
            ? (row.variationId
              ? Math.max(0, Number(getAvailableForVariation(product, row.variationId)) || 0)
              : Math.max(0, Number(getAvailableTotal(product)) || 0))
            : 0;
          const requiredTotal = roundTo(parseMaterialQuantity(row.quantity, 1) * safeUnits, 2);
          const includedTotal = roundTo(Math.min(requiredTotal, available), 2);
          const missingTotal = roundTo(Math.max(0, requiredTotal - includedTotal), 2);
          const includedPerService = safeUnits > 0 ? roundTo(includedTotal / safeUnits, 2) : 0;
          const requestedPerService = parseMaterialQuantity(row.quantity, 1);
          const variationLabel = String(row.variationName || '').trim();
          const displayBase = String(product?.name || row.label || 'Producto adicional').trim();
          const displayLabel = variationLabel ? `${displayBase} (${variationLabel})` : displayBase;

          if (includedPerService > 0) {
            adjustedRows.push({
              ...row,
              label: displayLabel,
              quantity: includedPerService,
              requestedQuantity: requestedPerService,
            });
          }

          const hasNoneAvailable = available <= 0;
          const hasPartialAvailability = available > 0 && missingTotal > 0;

          stockRows.push({
            label: displayLabel,
            required: requiredTotal,
            available: roundTo(available, 2),
            included: includedTotal,
            missing: missingTotal,
            status: hasNoneAvailable ? 'none' : (hasPartialAvailability ? 'partial' : 'full'),
            statusLabel: hasNoneAvailable
              ? 'Sin disponibilidad'
              : (hasPartialAvailability ? 'Stock insuficiente' : 'Disponible completo'),
          });
        });

        if (!window.Swal) return adjustedRows;

        const serviceName = String(service?.name || service?.sale_display_name || 'Servicio').trim();
        const serviceSystemName = String(service?.system_name || '').trim();
        const serviceLabel = escapeHtml(
          serviceSystemName.length > 0 ? `${serviceName} (${serviceSystemName})` : serviceName
        );
        const hasMissingRows = stockRows.some((row) => row.missing > 0);
        const hasNoStockRows = stockRows.some((row) => row.status === 'none');
        const hasDeliverableRows = stockRows.some((row) => row.status === 'partial' || row.status === 'full');
        const title = hasMissingRows
          ? (hasNoStockRows ? 'Productos adicionales con faltantes de stock' : 'Productos adicionales con stock insuficiente')
          : 'Productos adicionales en presentacion fisica';
        const icon = hasMissingRows ? (hasNoStockRows ? 'error' : 'warning') : 'info';

        const rowsHtml = stockRows.map((row) => {
          const colorClasses = row.status === 'none'
            ? 'border-red-200 bg-red-50 text-red-800'
            : (row.status === 'partial'
              ? 'border-amber-200 bg-amber-50 text-amber-800'
              : 'border-emerald-200 bg-emerald-50 text-emerald-800');

          return `
          <li class="rounded-lg border px-3 py-2 text-left ${colorClasses}">
            <p class="text-sm font-semibold">${escapeHtml(row.label)}</p>
            <p class="text-xs">Estado: ${escapeHtml(row.statusLabel)}</p>
            <p class="text-xs">Requerido: ${formatNumber(row.required, 2)} · Disponible: ${formatNumber(row.available, 2)} · Se incluira: ${formatNumber(row.included, 2)} · Faltan: ${formatNumber(row.missing, 2)}</p>
          </li>
        `;
        }).join('');

        const result = await window.Swal.fire({
          icon,
          title,
          html: `
            <div class="space-y-3 text-left">
              <p class="text-sm text-slate-600">La venta de este servicio incluye en la presentacion de entrega los siguientes productos.</p>
              <p class="text-sm text-slate-600"><strong>${serviceLabel}</strong></p>
              <ul class="space-y-2">${rowsHtml}</ul>
              ${hasDeliverableRows ? '<p class="text-xs font-semibold text-amber-700">No olvides entregar los productos adicionales disponibles junto con la entrega del servicio.</p>' : ''}
              <p class="text-xs text-slate-500">Si continuas, solo se descontara el stock disponible. Nunca se dejara stock negativo.</p>
            </div>
          `,
          showCancelButton: true,
          confirmButtonText: 'Continuar',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
        });

        if (!result.isConfirmed) return false;
        return adjustedRows;
      };

      const resolveConfiguredLaminationMaterials = (service) => {
        if (!service?.lamination_type_service) return null;

        const configuredRows = Array.isArray(service?.print_material_options)
          ? service.print_material_options
          : [];

        const normalizedRows = configuredRows
          .map((row) => {
            const surchargeId = String(row?.id || '').trim();
            const productId = String(row?.product_id || '').trim();
            const label = String(row?.label || '').trim();
            const quantity = parseMaterialQuantity(row?.quantity || row?.required_quantity || '1', 1);
            if (!surchargeId || !productId) return null;

            return {
              surchargeId,
              productId,
              label: label || null,
              quantity,
            };
          })
          .filter(Boolean);

        return normalizedRows.length > 0 ? normalizedRows : null;
      };

      const resolveConfiguredRequiredMaterials = (service, deliveryPresentation) => {
        if (!service) return null;

        if (service.lamination_type_service) {
          return resolveConfiguredLaminationMaterials(service);
        }

        // For digital deliveries, no physical consumables are required.
        if (String(deliveryPresentation || '').toLowerCase() === 'digital') {
          return [];
        }

        return resolveConfiguredPhysicalMaterials(service, deliveryPresentation);
      };

      const promptServiceDeliveryPresentation = async (service) => {
        const options = resolveServiceDeliveryOptions(service);
        if (options.length === 0) {
          if (window.Swal) {
            await window.Swal.fire({
              icon: 'warning',
              title: 'Presentacion no configurada',
              text: 'Este servicio no tiene presentacion de entrega (fisico o digital).',
              heightAuto: false,
            });
          }
          return null;
        }
        if (options.length === 1) return options[0].value;

        if (!window.Swal) return options[0].value;

        const selectId = `delivery-presentation-${service.id}`;
        const html = `
          <div class="space-y-2 text-left">
            <p class="text-sm text-slate-500">Selecciona como se entregara este servicio:</p>
            <select id="${selectId}" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
              ${options.map((row) => `<option value="${row.value}">${row.label}</option>`).join('')}
            </select>
          </div>
        `;

        const result = await window.Swal.fire({
          title: 'Presentacion de entrega',
          html,
          showCancelButton: true,
          confirmButtonText: 'Continuar',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
          preConfirm: () => {
            const dialog = window.Swal.getHtmlContainer();
            const selected = dialog?.querySelector(`#${selectId}`)?.value || '';
            if (!selected) {
              window.Swal.showValidationMessage('Selecciona una presentacion para continuar.');
              return null;
            }
            return selected;
          },
        });

        if (!result.isConfirmed) return null;
        return String(result.value || '').trim() || null;
      };

      const promptPrintingMaterialSelection = async (service) => {
        const options = Array.isArray(service?.print_material_options)
          ? service.print_material_options.filter((row) => String(row?.label || '').trim().length > 0)
          : [];

        if (!service?.printing_type_service || options.length === 0) return null;

        if (options.length === 1) {
          return {
            id: String(options[0].id || ''),
            label: String(options[0].label || '').trim(),
          };
        }

        if (!window.Swal) {
          return {
            id: String(options[0].id || ''),
            label: String(options[0].label || '').trim(),
          };
        }

        const selectId = `printing-material-${service.id}`;
        const html = `
          <div class="space-y-2 text-left">
            <p class="text-sm text-slate-500">Selecciona el material para esta impresion:</p>
            <select id="${selectId}" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
              ${options.map((row) => `<option value="${String(row.id || '')}">${escapeHtml(String(row.label || '').trim())}</option>`).join('')}
            </select>
          </div>
        `;

        const result = await window.Swal.fire({
          title: 'Material de impresion',
          html,
          showCancelButton: true,
          confirmButtonText: 'Continuar',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
          preConfirm: () => {
            const dialog = window.Swal.getHtmlContainer();
            const selectedId = dialog?.querySelector(`#${selectId}`)?.value || '';
            const selected = options.find((row) => String(row.id || '') === String(selectedId || ''));
            if (!selected) {
              window.Swal.showValidationMessage('Selecciona un material para continuar.');
              return null;
            }

            return {
              id: String(selected.id || ''),
              label: String(selected.label || '').trim(),
            };
          },
        });

        if (!result.isConfirmed) return false;
        return result.value || null;
      };

      const promptPrintingRowsSelection = async (service) => {
        const coverageOptions = Array.isArray(service?.print_coverage_options)
          ? service.print_coverage_options.filter((row) => Number(row?.price_bs) > 0)
          : [];
        const materialOptions = Array.isArray(service?.print_material_options)
          ? service.print_material_options.filter((row) => String(row?.label || '').trim().length > 0)
          : [];

        if (coverageOptions.length === 0 || materialOptions.length === 0) {
          if (window.Swal) {
            await window.Swal.fire({
              icon: 'warning',
              title: 'Configura impresion',
              text: 'Este servicio de impresion requiere coberturas y materiales configurados.',
              heightAuto: false,
            });
          }
          return null;
        }

        if (!window.Swal) {
          const fallbackCoverage = coverageOptions[0];
          const fallbackMaterial = materialOptions[0];
          const materialRequiredQuantity = parseMaterialQuantity(fallbackMaterial.required_quantity, 1);
          return [{
            coverageId: String(fallbackCoverage.id || ''),
            coveragePercent: Number(fallbackCoverage.coverage_percent) || 0,
            coveragePriceBs: Number(fallbackCoverage.price_bs) || 0,
            materialId: String(fallbackMaterial.id || ''),
            materialLabel: String(fallbackMaterial.label || '').trim(),
            materialProductId: String(fallbackMaterial.product_id || '').trim(),
            materialRequiredQuantity,
            surchargePercent: Number(fallbackMaterial.surcharge_percent) || 0,
            includeProductPriceInSale: Boolean(fallbackMaterial.include_product_price_in_sale),
            productPriceUsd: Number(fallbackMaterial.product_price_usd) || 0,
            quantity: 1,
          }];
        }

        const rowsContainerId = `printing-rows-${service.id}`;
        const addButtonId = `printing-rows-add-${service.id}`;

        const coverageOptionsHtml = coverageOptions
          .map((row) => {
            const id = String(row.id || '');
            const percent = Number(row.coverage_percent) || 0;
            const priceBs = Number(row.price_bs) || 0;
            return `<option value="${id}" data-coverage-percent="${percent}" data-price-bs="${priceBs}">${escapeHtml(`${formatCurrencyValue(priceBs, 'VES')} - ${formatNumber(percent, 0)}%`)}</option>`;
          })
          .join('');

        const materialOptionsHtml = materialOptions
          .map((row) => {
            const id = String(row.id || '');
            const label = String(row.label || '').trim();
            const productId = String(row.product_id || '').trim();
            const requiredQuantity = parseMaterialQuantity(row.required_quantity, 1);
            const surcharge = Number(row.surcharge_percent) || 0;
            const includeProductPrice = Boolean(row.include_product_price_in_sale);
            const productPriceUsd = Number(row.product_price_usd) || 0;
            return `<option value="${id}" data-material-label="${escapeHtml(label)}" data-product-id="${productId}" data-required-quantity="${requiredQuantity}" data-surcharge-percent="${surcharge}" data-include-product-price="${includeProductPrice}" data-product-price-usd="${productPriceUsd}">${escapeHtml(`${label} (+${formatNumber(surcharge, 2)}%)`)}</option>`;
          })
          .join('');

        const buildRowHtml = () => `
          <div class="printing-row grid gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3 sm:grid-cols-12" data-printing-row>
            <div class="sm:col-span-4">
              <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Precio</label>
              <select class="printing-coverage w-full rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm text-slate-700">${coverageOptionsHtml}</select>
            </div>
            <div class="sm:col-span-4">
              <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Material</label>
              <select class="printing-material w-full rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm text-slate-700">${materialOptionsHtml}</select>
              <p class="mt-1 text-right text-[11px] font-semibold text-slate-500" data-printing-material-availability>0 disponibles</p>
            </div>
            <div class="sm:col-span-3">
              <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Cantidad</label>
              <div class="flex items-center gap-2">
                <button type="button" class="printing-qty-minus h-8 w-8 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100">-</button>
                <input type="number" min="1" step="1" value="1" class="printing-qty w-full rounded-lg border border-slate-300 bg-white px-2 py-2 text-center text-sm font-semibold text-slate-700">
                <button type="button" class="printing-qty-plus h-8 w-8 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100">+</button>
              </div>
            </div>
            <div class="sm:col-span-1 flex items-end justify-end">
              <button type="button" class="printing-remove-row h-8 w-8 rounded-full border border-rose-200 bg-rose-50 text-rose-600 shadow-sm transition-colors hover:bg-rose-100 hover:text-rose-700" title="Eliminar fila">×</button>
            </div>
            <div class="sm:col-span-12 rounded-lg border border-slate-200 bg-white px-3 py-2">
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                <span class="text-slate-500">Unitario: <strong class="text-slate-700" data-printing-unit-bs>Bs 0,00</strong> <span class="text-slate-400" data-printing-unit-usd></span></span>
                <span class="text-slate-500">Subtotal: <strong class="text-slate-700" data-printing-total-bs>Bs 0,00</strong> <span class="text-slate-400" data-printing-total-usd></span></span>
              </div>
            </div>
          </div>
        `;

        const result = await window.Swal.fire({
          title: `${escapeHtml(String(service.name || service.sale_display_name || 'Servicio'))}`,
          html: `
            <div class="space-y-3 text-left">
              <p class="text-sm text-slate-500">Agrega una o varias lineas de impresion. Cada cobertura solo puede usarse una vez.</p>
              <div id="${rowsContainerId}" class="space-y-2"></div>
              <button id="${addButtonId}" type="button" class="inline-flex items-center gap-2 rounded-xl border border-cyan-300 bg-cyan-50 px-3 py-2 text-xs font-semibold uppercase tracking-wide text-cyan-700 shadow-sm transition-colors hover:bg-cyan-100">Agregar</button>
            </div>
          `,
          width: 820,
          showCancelButton: true,
          confirmButtonText: 'Agregar al carrito',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
          didOpen: () => {
            const dialog = window.Swal.getHtmlContainer();
            const rowsContainer = dialog?.querySelector(`#${rowsContainerId}`);
            const addButton = dialog?.querySelector(`#${addButtonId}`);
            if (!rowsContainer || !addButton) return;

            const refreshCoverageLocks = () => {
              const rows = Array.from(rowsContainer.querySelectorAll('[data-printing-row]'));
              const selectedIds = rows
                .map((row) => row.querySelector('.printing-coverage')?.value || '')
                .filter((value) => value.length > 0);

              rows.forEach((row) => {
                const coverageSelect = row.querySelector('.printing-coverage');
                if (!coverageSelect) return;
                const currentValue = coverageSelect.value;
                Array.from(coverageSelect.options).forEach((option) => {
                  const isTaken = selectedIds.includes(option.value) && option.value !== currentValue;
                  option.disabled = isTaken;
                });
              });
            };

            const baseAvailableForMaterialProductId = (productId) => {
              const safeProductId = String(productId || '').trim();
              if (!safeProductId) return 0;

              const product = productsById.get(safeProductId);
              if (!product) return 0;

              return Math.max(0, Math.floor(getAvailableTotal(product)));
            };

            const selectedMaterialProductIdForRow = (rowEl) => {
              const selectedMaterialOption = rowEl?.querySelector('.printing-material')?.selectedOptions?.[0];
              return String(selectedMaterialOption?.dataset.productId || '').trim();
            };

            const selectedMaterialRequiredQuantityForRow = (rowEl) => {
              const selectedMaterialOption = rowEl?.querySelector('.printing-material')?.selectedOptions?.[0];
              return parseMaterialQuantity(selectedMaterialOption?.dataset.requiredQuantity || '1', 1);
            };

            const selectedQtyForRow = (rowEl) => {
              const qtyInput = rowEl?.querySelector('.printing-qty');
              if (!qtyInput || qtyInput.disabled) return 0;

              const parsed = Number.parseInt(String(qtyInput.value || '').replace(/\D/g, ''), 10);
              return Number.isInteger(parsed) && parsed > 0 ? parsed : 0;
            };

            const requestedQtyByRowsForMaterialProduct = (productId, { excludeRow = null } = {}) => {
              const safeProductId = String(productId || '').trim();
              if (!safeProductId) return 0;

              let total = 0;
              Array.from(rowsContainer.querySelectorAll('[data-printing-row]')).forEach((candidateRow) => {
                if (excludeRow && candidateRow === excludeRow) return;
                if (selectedMaterialProductIdForRow(candidateRow) !== safeProductId) return;
                total += (selectedQtyForRow(candidateRow) * selectedMaterialRequiredQuantityForRow(candidateRow));
              });

              return roundTo(total, 4);
            };

            const availablePrintsForMaterialOption = (materialOption, { rowEl = null } = {}) => {
              const productId = String(materialOption?.dataset.productId || '').trim();
              if (!productId) return 0;

              const requiredQuantity = parseMaterialQuantity(materialOption?.dataset.requiredQuantity || '1', 1);
              const baseAvailable = Number(baseAvailableForMaterialProductId(productId)) || 0;
              const reservedByOtherRows = requestedQtyByRowsForMaterialProduct(productId, { excludeRow: rowEl });
              const remainingUnits = Math.max(0, baseAvailable - reservedByOtherRows);
              if (!(requiredQuantity > 0)) return 0;

              return Math.max(0, Math.floor(remainingUnits / requiredQuantity));
            };

            const availabilityTextFor = (available) => {
              const safeAvailable = Number.isFinite(available) ? Math.max(0, Math.floor(available)) : 0;
              if (safeAvailable >= 1000) return '+1000 disponibles';
              return `${safeAvailable} disponibles`;
            };

            const applyMaterialAvailabilityState = (rowEl) => {
              if (!rowEl) return;

              const materialSelect = rowEl.querySelector('.printing-material');
              const qtyInput = rowEl.querySelector('.printing-qty');
              const minusButton = rowEl.querySelector('.printing-qty-minus');
              const plusButton = rowEl.querySelector('.printing-qty-plus');
              const availabilityEl = rowEl.querySelector('[data-printing-material-availability]');
              const selectedMaterialOption = materialSelect?.selectedOptions?.[0];
              const availablePrints = availablePrintsForMaterialOption(selectedMaterialOption, { rowEl });

              if (!qtyInput) return;

              let appliedQty = 0;

              if (availablePrints > 0) {
                const parsedQty = Number.parseInt(String(qtyInput.value || '').replace(/\D/g, ''), 10);
                const safeQty = Number.isInteger(parsedQty) && parsedQty > 0 ? parsedQty : 1;
                qtyInput.disabled = false;
                qtyInput.min = '1';
                qtyInput.max = String(availablePrints);
                qtyInput.value = String(Math.min(safeQty, availablePrints));
                appliedQty = Number.parseInt(String(qtyInput.value || '0'), 10) || 0;
                if (minusButton) minusButton.disabled = false;
                if (plusButton) plusButton.disabled = false;
              } else {
                qtyInput.disabled = true;
                qtyInput.min = '0';
                qtyInput.removeAttribute('max');
                qtyInput.value = '0';
                appliedQty = 0;
                if (minusButton) minusButton.disabled = true;
                if (plusButton) plusButton.disabled = true;
              }

              if (availabilityEl) {
                const remainingAfterSelection = Math.max(0, availablePrints - appliedQty);
                availabilityEl.textContent = availabilityTextFor(remainingAfterSelection);
                availabilityEl.classList.toggle('text-rose-600', remainingAfterSelection <= 0);
                availabilityEl.classList.toggle('text-emerald-600', remainingAfterSelection > 0);
                availabilityEl.classList.toggle('text-slate-500', false);
              }
            };

            const updateRowPricingSummary = (rowEl) => {
              if (!rowEl) return;

              const coverageOption = rowEl.querySelector('.printing-coverage')?.selectedOptions?.[0];
              const materialOption = rowEl.querySelector('.printing-material')?.selectedOptions?.[0];
              const qtyInput = rowEl.querySelector('.printing-qty');
              const unitBsEl = rowEl.querySelector('[data-printing-unit-bs]');
              const unitUsdEl = rowEl.querySelector('[data-printing-unit-usd]');
              const totalBsEl = rowEl.querySelector('[data-printing-total-bs]');
              const totalUsdEl = rowEl.querySelector('[data-printing-total-usd]');

              const coveragePriceBs = Number(coverageOption?.dataset.priceBs);
              const surchargePercent = Number(materialOption?.dataset.surchargePercent);
              const includeProductPrice = String(materialOption?.dataset.includeProductPrice || '').toLowerCase() === 'true';
              const productPriceUsd = Number(materialOption?.dataset.productPriceUsd);
              const materialRequiredQuantity = parseMaterialQuantity(materialOption?.dataset.requiredQuantity || '1', 1);
              const quantity = Number.parseInt(String(qtyInput?.value || '').replace(/\D/g, ''), 10);
              const safeQuantity = qtyInput?.disabled
                ? 0
                : (Number.isInteger(quantity) && quantity > 0 ? quantity : 1);
              const safeCoveragePriceBs = Number.isFinite(coveragePriceBs) ? coveragePriceBs : 0;
              const safeSurchargePercent = Number.isFinite(surchargePercent) ? surchargePercent : 0;
              const materialUnitBs = includeProductPrice && Number.isFinite(productPriceUsd) && productPriceUsd > 0 && bcvRate > 0
                ? roundTo(productPriceUsd * bcvRate * materialRequiredQuantity, 2)
                : 0;
              const unitBs = roundTo((safeCoveragePriceBs * (1 + (safeSurchargePercent / 100))) + materialUnitBs, 2);
              const totalBs = roundTo(unitBs * safeQuantity, 2);
              const unitUsd = bcvRate > 0 ? roundTo(unitBs / bcvRate, 2) : null;
              const totalUsd = bcvRate > 0 ? roundTo(totalBs / bcvRate, 2) : null;

              if (unitBsEl) unitBsEl.textContent = formatCurrencyValue(unitBs, 'VES');
              if (totalBsEl) totalBsEl.textContent = formatCurrencyValue(totalBs, 'VES');
              if (unitUsdEl) unitUsdEl.textContent = unitUsd != null ? `· ${formatCurrencyValue(unitUsd, 'USD')}` : '';
              if (totalUsdEl) totalUsdEl.textContent = totalUsd != null ? `· ${formatCurrencyValue(totalUsd, 'USD')}` : '';
            };

            const refreshAllMaterialAvailability = () => {
              const rows = Array.from(rowsContainer.querySelectorAll('[data-printing-row]'));
              rows.forEach((row) => applyMaterialAvailabilityState(row));
              rows.forEach((row) => updateRowPricingSummary(row));
            };

            const bindRow = (rowEl) => {
              const qtyInput = rowEl.querySelector('.printing-qty');
              const minus = rowEl.querySelector('.printing-qty-minus');
              const plus = rowEl.querySelector('.printing-qty-plus');
              const remove = rowEl.querySelector('.printing-remove-row');
              const coverageSelect = rowEl.querySelector('.printing-coverage');
              const materialSelect = rowEl.querySelector('.printing-material');

              const sanitizeQty = () => {
                applyMaterialAvailabilityState(rowEl);

                if (qtyInput?.disabled) {
                  qtyInput.value = '0';
                  updateRowPricingSummary(rowEl);
                  return;
                }

                const parsed = Number.parseInt(String(qtyInput?.value || '').replace(/\D/g, ''), 10);
                const normalized = Number.isInteger(parsed) && parsed > 0 ? parsed : 1;
                const maxAllowed = Number.parseInt(String(qtyInput?.max || '').trim(), 10);
                const hasMax = Number.isInteger(maxAllowed) && maxAllowed > 0;
                const clamped = hasMax ? Math.min(normalized, maxAllowed) : normalized;
                qtyInput.value = String(clamped);
                refreshAllMaterialAvailability();
                updateRowPricingSummary(rowEl);
              };

              minus?.addEventListener('click', () => {
                if (qtyInput?.disabled) return;
                sanitizeQty();
                qtyInput.value = String(Math.max(1, Number.parseInt(qtyInput.value, 10) - 1));
                refreshAllMaterialAvailability();
                updateRowPricingSummary(rowEl);
              });
              plus?.addEventListener('click', () => {
                if (qtyInput?.disabled) return;
                sanitizeQty();
                const maxAllowed = Number.parseInt(String(qtyInput?.max || '').trim(), 10);
                const hasMax = Number.isInteger(maxAllowed) && maxAllowed > 0;
                const current = Number.parseInt(String(qtyInput.value || '1'), 10);
                const nextValue = hasMax ? Math.min(current + 1, maxAllowed) : (current + 1);
                qtyInput.value = String(nextValue);
                refreshAllMaterialAvailability();
                updateRowPricingSummary(rowEl);
              });
              qtyInput?.addEventListener('change', sanitizeQty);
              qtyInput?.addEventListener('input', sanitizeQty);

              coverageSelect?.addEventListener('change', () => {
                refreshCoverageLocks();
                updateRowPricingSummary(rowEl);
              });
              materialSelect?.addEventListener('change', () => {
                applyMaterialAvailabilityState(rowEl);
                sanitizeQty();
                refreshAllMaterialAvailability();
                updateRowPricingSummary(rowEl);
              });

              remove?.addEventListener('click', () => {
                const rows = rowsContainer.querySelectorAll('[data-printing-row]');
                if (rows.length <= 1) {
                  applyMaterialAvailabilityState(rowEl);
                  sanitizeQty();
                  return;
                }
                rowEl.remove();
                refreshCoverageLocks();
                refreshAllMaterialAvailability();
              });

                applyMaterialAvailabilityState(rowEl);
                sanitizeQty();
                refreshAllMaterialAvailability();
                updateRowPricingSummary(rowEl);
            };

            const appendRow = () => {
              rowsContainer.insertAdjacentHTML('beforeend', buildRowHtml());
              const row = rowsContainer.lastElementChild;
              if (!row) return;
              bindRow(row);
              refreshCoverageLocks();
              refreshAllMaterialAvailability();
              updateRowPricingSummary(row);
            };

            addButton.addEventListener('click', appendRow);
            appendRow();
          },
          preConfirm: () => {
            const dialog = window.Swal.getHtmlContainer();
            const rows = Array.from(dialog?.querySelectorAll('[data-printing-row]') || []);
            if (rows.length === 0) {
              window.Swal.showValidationMessage('Agrega al menos una linea de impresion.');
              return null;
            }

            const seenCoverageIds = new Set();
            const materialQuantityByProductId = new Map();
            const parsedRows = [];

            for (const row of rows) {
              const coverageSelect = row.querySelector('.printing-coverage');
              const materialSelect = row.querySelector('.printing-material');
              const qtyInput = row.querySelector('.printing-qty');

              const coverageId = String(coverageSelect?.value || '').trim();
              const materialId = String(materialSelect?.value || '').trim();
              const quantity = Number.parseInt(String(qtyInput?.value || '').replace(/\D/g, ''), 10);

              if (!coverageId || !materialId || !(Number.isInteger(quantity) && quantity > 0)) {
                window.Swal.showValidationMessage('Completa cobertura, material y cantidad en cada fila.');
                return null;
              }

              if (seenCoverageIds.has(coverageId)) {
                window.Swal.showValidationMessage('No puedes repetir la misma cobertura en otra fila.');
                return null;
              }
              seenCoverageIds.add(coverageId);

              const coverageOption = coverageSelect?.selectedOptions?.[0];
              const materialOption = materialSelect?.selectedOptions?.[0];
              const coveragePercent = Number(coverageOption?.dataset.coveragePercent);
              const coveragePriceBs = Number(coverageOption?.dataset.priceBs);
              const surchargePercent = Number(materialOption?.dataset.surchargePercent);
              const includeProductPriceInSale = String(materialOption?.dataset.includeProductPrice || '').toLowerCase() === 'true';
              const productPriceUsd = Number(materialOption?.dataset.productPriceUsd);
              const materialRequiredQuantity = parseMaterialQuantity(materialOption?.dataset.requiredQuantity || '1', 1);
              const materialProductId = String(materialOption?.dataset.productId || '').trim();
              const materialLabel = String(materialOption?.dataset.materialLabel || materialOption?.textContent || '').trim();

              if (!(Number.isFinite(coveragePriceBs) && coveragePriceBs > 0)) {
                window.Swal.showValidationMessage('La cobertura seleccionada no tiene monto Bs valido.');
                return null;
              }

              const availableUnits = materialProductId
                ? Math.max(0, Number(getAvailableTotal({ id: materialProductId, available_total: productsById.get(materialProductId)?.available_total })) || 0)
                : 0;
              const availablePrints = materialRequiredQuantity > 0
                ? Math.max(0, Math.floor(availableUnits / materialRequiredQuantity))
                : 0;
              if (availablePrints <= 0) {
                window.Swal.showValidationMessage(`El material ${materialLabel || 'seleccionado'} no tiene stock disponible para impresion.`);
                return null;
              }

              if (quantity > availablePrints) {
                window.Swal.showValidationMessage(`La cantidad para ${materialLabel || 'el material'} no puede superar ${availablePrints} impresion(es) disponibles.`);
                return null;
              }

              const requestedUnits = roundTo(quantity * materialRequiredQuantity, 4);
              const alreadyRequested = Number(materialQuantityByProductId.get(materialProductId) || 0);
              const accumulated = roundTo(alreadyRequested + requestedUnits, 4);
              if (accumulated > availableUnits) {
                window.Swal.showValidationMessage(`La suma de filas para ${materialLabel || 'el material'} excede el stock disponible (${availablePrints} impresion(es)).`);
                return null;
              }
              materialQuantityByProductId.set(materialProductId, accumulated);

              parsedRows.push({
                coverageId,
                coveragePercent: Number.isFinite(coveragePercent) ? coveragePercent : 0,
                coveragePriceBs,
                materialId,
                materialLabel,
                materialProductId,
                materialRequiredQuantity,
                surchargePercent: Number.isFinite(surchargePercent) ? surchargePercent : 0,
                includeProductPriceInSale,
                productPriceUsd: Number.isFinite(productPriceUsd) ? productPriceUsd : 0,
                quantity,
              });
            }

            return parsedRows;
          },
        });

        if (!result.isConfirmed) return false;
        return Array.isArray(result.value) ? result.value : [];
      };

      const addPrintingServiceRowsToCart = async (service, rows) => {
        if (!service || !Array.isArray(rows) || rows.length === 0) return;
        if (!(bcvRate > 0)) {
          if (window.Swal) {
            await window.Swal.fire({
              icon: 'warning',
              title: 'Tasa BCV no disponible',
              text: 'No se puede calcular el precio USD de impresion sin tasa BCV.',
              heightAuto: false,
            });
          }
          return;
        }

        rows.forEach((row) => {
          const surchargeMultiplier = 1 + ((Number(row.surchargePercent) || 0) / 100);
          const baseUnitPriceBs = roundTo((Number(row.coveragePriceBs) || 0) * surchargeMultiplier, 2);
          const materialRequiredQuantity = parseMaterialQuantity(row.materialRequiredQuantity || 1, 1);
          const materialPriceUsd = row.includeProductPriceInSale
            ? ((Number(row.productPriceUsd) || 0) * materialRequiredQuantity)
            : 0;
          const materialPriceBs = materialPriceUsd > 0 ? roundTo(materialPriceUsd * bcvRate, 2) : 0;
          const unitPriceBs = roundTo(baseUnitPriceBs + materialPriceBs, 2);
          const unitPriceUsd = roundTo((unitPriceBs / bcvRate), 6);
          if (!(unitPriceUsd > 0)) return;

          const keyParts = [
            `print-coverage-${row.coverageId}`,
            `print-material-${row.materialId}`,
            `print-unit-bs-${unitPriceBs.toFixed(2)}`,
          ];
          const key = buildKey('service', service.id, keyParts.join('|'));
          const existing = cart.get(key) || {
            itemType: 'service',
            serviceId: String(service.id),
            delivery_presentation: null,
            selected_print_coverage_id: row.coverageId,
            selected_print_coverage_percent: String(roundTo(Number(row.coveragePercent) || 0, 2)),
            selected_print_price_bs: roundTo(Number(row.coveragePriceBs) || 0, 2),
            selected_print_surcharge_percent: roundTo(Number(row.surchargePercent) || 0, 4),
            selected_print_unit_price_bs: unitPriceBs,
            selected_print_material_surcharge_id: row.materialId,
            selected_print_material_label: String(row.materialLabel || '').trim() || null,
            selected_print_material_product_id: String(row.materialProductId || '').trim() || null,
            selected_print_material_rows: toServiceMaterialRowsPayload([{
              surchargeId: String(row.materialId || '').trim(),
              productId: String(row.materialProductId || '').trim(),
              label: String(row.materialLabel || '').trim() || null,
              quantity: materialRequiredQuantity,
              requestedQuantity: materialRequiredQuantity,
            }]),
            quantity: 0,
            unit_price_usd: unitPriceUsd,
            unit_price_base_amount: baseCurrency === 'ves' ? unitPriceBs : roundTo(unitPriceUsd, 2),
            unit_price_base_currency: baseCurrency === 'ves' ? 'VES' : 'USD',
            consumable_decisions: [],
          };

          existing.delivery_presentation = null;
          existing.selected_print_coverage_id = row.coverageId;
          existing.selected_print_coverage_percent = String(roundTo(Number(row.coveragePercent) || 0, 2));
          existing.selected_print_price_bs = roundTo(Number(row.coveragePriceBs) || 0, 2);
          existing.selected_print_surcharge_percent = roundTo(Number(row.surchargePercent) || 0, 4);
          existing.selected_print_unit_price_bs = unitPriceBs;
          existing.selected_print_material_surcharge_id = row.materialId;
          existing.selected_print_material_label = String(row.materialLabel || '').trim() || existing.selected_print_material_label;
          existing.selected_print_material_product_id = String(row.materialProductId || '').trim() || existing.selected_print_material_product_id;
          existing.selected_print_material_rows = toServiceMaterialRowsPayload([{
            surchargeId: String(row.materialId || '').trim(),
            productId: String(row.materialProductId || '').trim(),
            label: String(row.materialLabel || '').trim() || existing.selected_print_material_label || null,
            quantity: materialRequiredQuantity,
            requestedQuantity: materialRequiredQuantity,
          }]);
          existing.unit_price_usd = unitPriceUsd;
          existing.unit_price_base_amount = baseCurrency === 'ves' ? unitPriceBs : roundTo(unitPriceUsd, 2);
          existing.unit_price_base_currency = baseCurrency === 'ves' ? 'VES' : 'USD';
          existing.quantity += Number(row.quantity) || 0;
          if (!Array.isArray(existing.consumable_decisions)) existing.consumable_decisions = [];

          cart.set(key, existing);
        });

        renderCart();
      };

      const toServiceMaterialRowsPayload = (rows) => normalizeServiceMaterialRowsForCart(rows).map((row) => ({
        surcharge_id: row.surchargeId,
        product_id: row.productId,
        label: row.label,
        variation_id: row.variationId,
        quantity: row.quantity,
        breakdown_in_invoice: row.breakdownInInvoice === true,
        optional_delivery_extra: row.optionalDeliveryExtra === true,
        requested_quantity: row.requestedQuantity,
      }));

      const addServiceToCart = async (serviceId, quantity, options = {}) => {
        const service = servicesById.get(String(serviceId));
        if (!service) return;
        const agreedPricing = options?.agreedPricing || null;

        if (service.printing_type_service) {
          const rows = await promptPrintingRowsSelection(service);
          if (rows === false || !Array.isArray(rows) || rows.length === 0) return;
          await addPrintingServiceRowsToCart(service, rows);
          return;
        }

        const isLaminationService = Boolean(service.lamination_type_service);
        const deliveryPresentation = isLaminationService ? null : await promptServiceDeliveryPresentation(service);
        if (!isLaminationService && !deliveryPresentation) return;

        const deliveryOptions = isLaminationService ? [] : resolveServiceDeliveryOptions(service);
        const isDigitalOnlyDelivery = (
          !isLaminationService
          && deliveryPresentation === 'digital'
          && deliveryOptions.length === 1
          && deliveryOptions[0]?.value === 'digital'
        );
        const shouldWarnDigitalOnlyDelivery = Boolean(service.warn_digital_only_delivery_in_sales);
        if (isDigitalOnlyDelivery && shouldWarnDigitalOnlyDelivery && window.Swal) {
          await window.Swal.fire({
            icon: 'info',
            title: 'Entrega digital',
            text: 'El precio de este servicio solo incluye entrega digital, si requiere alguna impresion, producto y/o servicio adicional debe anexarlo adicionalmente',
            heightAuto: false,
          });
        }

        const configuredPhysicalMaterials = resolveConfiguredRequiredMaterials(service, deliveryPresentation);
        if (configuredPhysicalMaterials === null) {
          if (isLaminationService && window.Swal) {
            await window.Swal.fire({
              icon: 'warning',
              title: 'Configura materiales de plastificacion',
              text: 'Este servicio requiere materiales configurados en el formulario del servicio.',
              heightAuto: false,
            });
          }
          return;
        }

        const normalizedMaterialRows = normalizeServiceMaterialRowsForCart(configuredPhysicalMaterials);
        if (isLaminationService && normalizedMaterialRows.length === 0) return;

        const configuredPhysicalExtraRows = isLaminationService
          ? []
          : resolveConfiguredPhysicalDeliveryExtraRows(service, deliveryPresentation);
        const resolvedPhysicalExtraRows = await resolvePhysicalExtraRowsWithAvailability({
          service,
          extraRows: configuredPhysicalExtraRows,
          serviceUnits: quantity,
        });
        if (resolvedPhysicalExtraRows === false) return;

        const hasMaterialStock = await ensureServiceMaterialsAvailability({
          service,
          materialRows: normalizedMaterialRows,
          serviceUnits: quantity,
          materialContext: {
            sourceLabel: isLaminationService ? 'Plastificacion directa' : 'Presentacion fisica',
          },
        });
        if (!hasMaterialStock) return;

        const selectedMaterialRows = normalizeServiceMaterialRowsForCart([
          ...normalizedMaterialRows,
          ...(Array.isArray(resolvedPhysicalExtraRows) ? resolvedPhysicalExtraRows : []),
        ]);

        const firstConfiguredMaterial = selectedMaterialRows[0] || null;

        const resolvedUnitPriceUsd = agreedPricing
          ? Number(agreedPricing.unitPriceUsd || 0)
          : resolveServiceUnitPriceUsd(service, {
              unit_price_usd: service.price_usd,
            }, {
              preferBsReference: isLaminationService,
            });

        if (!(resolvedUnitPriceUsd > 0)) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'warning',
              title: 'Precio no disponible',
              text: service.price_on_request
                ? 'Debes indicar un precio acordado para este servicio.'
                : 'Este servicio no tiene tasa disponible para facturar.',
              heightAuto: false,
            });
          }
          return;
        }

        const keyParts = [];
        if (agreedPricing?.priceSignature) keyParts.push(String(agreedPricing.priceSignature));
        if (deliveryPresentation) keyParts.push(`delivery-${deliveryPresentation}`);
        if (firstConfiguredMaterial?.surchargeId) keyParts.push(`print-material-${firstConfiguredMaterial.surchargeId}`);
        const materialSetToken = materialRowsSignatureToken(selectedMaterialRows);
        if (materialSetToken) keyParts.push(materialSetToken);
        const key = buildKey('service', serviceId, keyParts.join('|'));
        const existing = cart.get(key) || {
          itemType: 'service',
          serviceId: String(serviceId),
          delivery_presentation: deliveryPresentation,
          selected_print_material_surcharge_id: firstConfiguredMaterial?.surchargeId || null,
          selected_print_material_label: firstConfiguredMaterial?.label || null,
          selected_print_material_product_id: firstConfiguredMaterial?.productId || null,
          selected_print_material_rows: toServiceMaterialRowsPayload(selectedMaterialRows),
          quantity: 0,
          unit_price_usd: resolvedUnitPriceUsd,
          unit_price_base_amount: agreedPricing?.invoiceUnitAmount || null,
          unit_price_base_currency: agreedPricing?.invoiceCurrencyCode || null,
          agreed_price_display: agreedPricing?.priceDisplay || null,
          agreed_reference_name: agreedPricing?.referenceName || null,
          agreed_reference_amount: agreedPricing?.referenceAmount || null,
          agreed_reference_symbol: agreedPricing?.referenceSymbol || null,
          price_signature: agreedPricing?.priceSignature || null,
          consumable_decisions: [],
        };

        if (!Array.isArray(existing.consumable_decisions)) existing.consumable_decisions = [];
        existing.delivery_presentation = deliveryPresentation;
        existing.selected_print_material_surcharge_id = firstConfiguredMaterial?.surchargeId || existing.selected_print_material_surcharge_id;
        existing.selected_print_material_label = firstConfiguredMaterial?.label || existing.selected_print_material_label;
        existing.selected_print_material_product_id = firstConfiguredMaterial?.productId || existing.selected_print_material_product_id;
        existing.selected_print_material_rows = selectedMaterialRows.length > 0
          ? toServiceMaterialRowsPayload(selectedMaterialRows)
          : (existing.selected_print_material_rows || []);
        existing.unit_price_usd = resolvedUnitPriceUsd;
        if (agreedPricing) {
          existing.unit_price_base_amount = agreedPricing.invoiceUnitAmount;
          existing.unit_price_base_currency = agreedPricing.invoiceCurrencyCode;
          existing.agreed_price_display = agreedPricing.priceDisplay;
          existing.agreed_reference_name = agreedPricing.referenceName;
          existing.agreed_reference_amount = agreedPricing.referenceAmount;
          existing.agreed_reference_symbol = agreedPricing.referenceSymbol;
          existing.price_signature = agreedPricing.priceSignature || existing.price_signature;
        } else {
          const usesBolivarReference = serviceUsesBolivarReference(service);
          const fixedPriceBs = Number(service?.price_bs);
          const resolvedUnitPriceBaseAmount = resolveServiceUnitPriceBaseAmount(service, {
            preferBsReference: isLaminationService,
          });

          if (usesBolivarReference && Number.isFinite(fixedPriceBs) && fixedPriceBs > 0) {
            existing.unit_price_base_amount = roundTo(fixedPriceBs, 2);
            existing.unit_price_base_currency = 'VES';
          } else {
            existing.unit_price_base_amount = resolvedUnitPriceBaseAmount > 0 ? resolvedUnitPriceBaseAmount : existing.unit_price_base_amount;
            existing.unit_price_base_currency = baseCurrency === 'ves' ? 'VES' : 'USD';
          }

          existing.agreed_price_display = null;
          existing.agreed_reference_name = null;
          existing.agreed_reference_amount = null;
          existing.agreed_reference_symbol = null;
          existing.price_signature = existing.price_signature || null;
        }
        existing.quantity += quantity;
        cart.set(key, existing);
        renderCart();
      };

      const serviceUsesCostDebit = (service) => {
        if (!service) return false;

        return Boolean(service.cost_enabled);
      };

      const serviceSkipsCheckoutPrompts = (service) => {
        if (!service) return false;

        return Boolean(service.has_manager_or_variable_expense);
      };

      const promptRecargaService = async (service) => {
        if (!window.Swal) return null;

        const payallAccount = findPayallAccount();
        if (!payallAccount) {
          await window.Swal.fire({
            icon: 'warning',
            title: 'Cuenta Payall no encontrada',
            text: 'No existe una cuenta Payall. Accion que debe realizar el administrador.',
            heightAuto: false,
          });
          return null;
        }

        const minAmount = Number(service.recarga_min_amount || 0);
        const multipleAmount = Number(service.recarga_multiple_amount || 0);
        const profitPercent = Number(service.recarga_profit_percent || 0);
        const availableBalance = roundTo(Number(payallAccount.balance || 0) - recargaReservedInCart(), 2);

        const amountInputId = `recarga-amount-${service.id}`;
        const badgeId = `recarga-badge-${service.id}`;
        const totalId = `recarga-total-${service.id}`;

        const imageHtml = service.system_service_image_url
          ? `<img src="${escapeHtml(service.system_service_image_url)}" alt="${escapeHtml(service.system_name || 'Recarga')}" class="h-full w-full object-cover">`
          : `<div class="flex h-full w-full items-center justify-center text-slate-300"><i data-lucide="smartphone" class="h-8 w-8"></i></div>`;
        const recargaImageHtml = service.recarga_image_url
          ? `<img src="${escapeHtml(service.recarga_image_url)}" alt="${escapeHtml(service.name || 'Recarga')}" class="h-full w-full object-contain">`
          : '';

        const modalHtml = `
          <div class="space-y-3 text-left">
            ${recargaImageHtml
              ? `<div class="flex justify-center">
                  <div class="h-40 w-64 overflow-hidden">${recargaImageHtml}</div>
                </div>`
              : ''}
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Monto a recargar</p>
              <input id="${amountInputId}" type="text" inputmode="decimal" autocomplete="off"
                class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500"
                placeholder="Bs 0,00" data-money-mask="true" data-money-symbol="Bs">
              <div id="${badgeId}" class="mt-2 inline-flex items-center rounded-lg bg-rose-100 px-2.5 py-1 text-xs font-semibold text-rose-700 ring-1 ring-rose-200">
                Ingresa un monto valido.
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="h-16 w-24 overflow-hidden bg-slate-100">
                  ${imageHtml}
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Saldo Payall</p>
                  <p class="text-lg font-extrabold text-slate-800">${formatMoney(availableBalance, 'Bs ')}</p>
                </div>
              </div>
              <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-right">
                <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Monto total a cobrar</p>
                <p id="${totalId}" class="text-lg font-extrabold text-emerald-700">Bs 0,00</p>
              </div>
            </div>
          </div>
        `;

        const updateRecargaPreview = (dialog) => {
          const amountInput = dialog.querySelector(`#${amountInputId}`);
          const badgeEl = dialog.querySelector(`#${badgeId}`);
          const totalEl = dialog.querySelector(`#${totalId}`);
          if (!amountInput || !badgeEl || !totalEl) return;

          const baseAmount = roundTo(parseMoneyInput(amountInput), 2);
          const totalAmount = roundTo(baseAmount * (1 + profitPercent / 100), 2);
          totalEl.textContent = formatMoney(totalAmount, 'Bs ');

          let message = '';
          let valid = true;

          if (!(baseAmount > 0)) {
            valid = false;
            message = 'Ingresa un monto valido.';
          } else if (minAmount > 0 && baseAmount < minAmount) {
            valid = false;
            message = `El monto minimo es ${formatMoney(minAmount, 'Bs ')}.`;
          } else if (multipleAmount > 0 && (baseAmount % multipleAmount) > 0.01) {
            valid = false;
            message = `Debe ser multiplo de ${formatMoney(multipleAmount, 'Bs ')}.`;
          } else if (baseAmount > availableBalance) {
            valid = false;
            message = 'Saldo Payall insuficiente.';
          } else {
            message = 'Monto valido.';
          }

          badgeEl.textContent = message;
          badgeEl.classList.toggle('bg-emerald-100', valid);
          badgeEl.classList.toggle('text-emerald-700', valid);
          badgeEl.classList.toggle('ring-emerald-200', valid);
          badgeEl.classList.toggle('bg-rose-100', !valid);
          badgeEl.classList.toggle('text-rose-700', !valid);
          badgeEl.classList.toggle('ring-rose-200', !valid);

          return { baseAmount, totalAmount, valid };
        };

        const result = await window.Swal.fire({
          title: `Recarga ${escapeHtml(service.name || service.sale_display_name || 'Servicio')}`,
          html: modalHtml,
          showCancelButton: true,
          confirmButtonText: 'Agregar',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
          didOpen: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return;
            initMoneyMasks(dialog);
            if (window.lucide?.createIcons) window.lucide.createIcons();
            const amountInput = dialog.querySelector(`#${amountInputId}`);
            if (amountInput) {
              amountInput.addEventListener('input', () => updateRecargaPreview(dialog));
              updateRecargaPreview(dialog);
            }
          },
          preConfirm: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return null;

            const preview = updateRecargaPreview(dialog);
            if (!preview || !preview.valid) {
              window.Swal.showValidationMessage('Revisa el monto de recarga.');
              return null;
            }

            if (!(bcvRate > 0)) {
              window.Swal.showValidationMessage('No hay tasa BCV disponible para calcular la recarga.');
              return null;
            }

            return preview;
          },
        });

        if (!result.isConfirmed) return null;

        const baseAmount = roundTo(result.value.baseAmount, 2);
        const totalAmount = roundTo(result.value.totalAmount, 2);
        const unitPriceUsd = roundTo(totalAmount / bcvRate, 6);
        const unitPriceBaseAmount = baseCurrency === 'ves'
          ? totalAmount
          : roundTo(totalAmount / bcvRate, 2);
        const unitPriceBaseCurrency = baseCurrency === 'ves' ? 'VES' : 'USD';

        return {
          baseAmount,
          totalAmount,
          profitPercent,
          unitPriceUsd,
          unitPriceBaseAmount,
          unitPriceBaseCurrency,
          priceSignature: `recarga:${baseAmount.toFixed(2)}:${profitPercent.toFixed(2)}`,
        };
      };

      const promptServicePriceOnRequest = async (service) => {
        if (!window.Swal) return null;

        const referenceName = normalizeServiceReferenceName(service);
        const referenceSymbol = resolveServiceReferenceSymbol(service, referenceName);
        const invoiceCurrencyCode = currentBaseCurrencyCode();
        const invoiceLabel = invoiceCurrencyCode === 'VES' ? 'Bs' : 'USD';
        const amountInputId = `ventas-agree-amount-${service.id}`;
        const quantityInputId = `ventas-agree-quantity-${service.id}`;
        const previewId = `ventas-agree-preview-${service.id}`;

        const modalHtml = `
          <div class="space-y-3 text-left">
            <p class="text-sm text-slate-500">${escapeHtml(service.name || 'Servicio')}</p>
            <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700">
              <p>Moneda base del servicio: <strong>${escapeHtml(referenceName)}</strong></p>
              <p>Factura actual en: <strong>${invoiceLabel}</strong></p>
            </div>
            <div class="grid gap-2 sm:grid-cols-2">
              <label class="space-y-1 text-xs font-semibold uppercase tracking-wide text-slate-500">
                <span>Monto (${escapeHtml(referenceSymbol)})</span>
                <input id="${amountInputId}" type="text" inputmode="decimal" autocomplete="off"
                  class="w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                  placeholder="${escapeHtml(referenceSymbol)} 0,00" data-money-mask="true" data-money-symbol="${escapeHtml(referenceSymbol)}">
              </label>
              <label class="space-y-1 text-xs font-semibold uppercase tracking-wide text-slate-500">
                <span>Cantidad</span>
                <input id="${quantityInputId}" type="number" min="1" step="1" inputmode="numeric"
                  class="w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                  value="1">
              </label>
            </div>
            <p id="${previewId}" class="text-xs text-slate-500"></p>
          </div>
        `;

        const updatePreview = (dialog) => {
          const amountInput = dialog.querySelector(`#${amountInputId}`);
          const quantityInput = dialog.querySelector(`#${quantityInputId}`);
          const previewEl = dialog.querySelector(`#${previewId}`);
          if (!amountInput || !quantityInput || !previewEl) return;

          const rawAmount = parseMoneyInput(amountInput);
          const rawQuantity = Number.parseInt(String(quantityInput.value || '').replace(/\D/g, ''), 10);
          if (!(Number.isFinite(rawAmount) && rawAmount > 0) || !(Number.isInteger(rawQuantity) && rawQuantity > 0)) {
            previewEl.textContent = 'Ingresa monto y cantidad para ver el total estimado.';
            return;
          }

          const computed = computeOnRequestServiceAmounts({
            service,
            referenceAmount: rawAmount,
          });
          if (computed.error) {
            previewEl.textContent = computed.error;
            return;
          }

          const lineTotal = roundTo(computed.invoiceUnitAmount * rawQuantity, 2);
          previewEl.textContent = `Se agregara ${rawQuantity} x ${computed.priceDisplay} = ${formatCurrencyValue(lineTotal, computed.invoiceCurrencyCode)}`;
        };

        const result = await window.Swal.fire({
          title: 'Precio a convenir',
          html: modalHtml,
          showCancelButton: true,
          confirmButtonText: 'Agregar',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
          didOpen: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return;

            const amountInput = dialog.querySelector(`#${amountInputId}`);
            const quantityInput = dialog.querySelector(`#${quantityInputId}`);
            initMoneyMasks(dialog);

            if (amountInput) amountInput.addEventListener('input', () => updatePreview(dialog));
            if (quantityInput) {
              quantityInput.addEventListener('input', () => updatePreview(dialog));
              quantityInput.addEventListener('blur', () => {
                const parsed = Number.parseInt(String(quantityInput.value || '').replace(/\D/g, ''), 10);
                quantityInput.value = Number.isInteger(parsed) && parsed > 0 ? String(parsed) : '1';
                updatePreview(dialog);
              });
            }

            updatePreview(dialog);
          },
          preConfirm: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return null;

            const amountInput = dialog.querySelector(`#${amountInputId}`);
            const quantityInput = dialog.querySelector(`#${quantityInputId}`);

            const numeric = parseMoneyInput(amountInput);
            if (!Number.isFinite(numeric) || numeric <= 0) {
              window.Swal.showValidationMessage('Indica un precio valido mayor a 0.');
              return null;
            }

            const quantity = Number.parseInt(String(quantityInput?.value || '').replace(/\D/g, ''), 10);
            if (!Number.isInteger(quantity) || quantity <= 0) {
              window.Swal.showValidationMessage('Indica una cantidad valida mayor a 0.');
              return null;
            }

            const computed = computeOnRequestServiceAmounts({
              service,
              referenceAmount: numeric,
            });

            if (computed.error) {
              window.Swal.showValidationMessage(computed.error);
              return null;
            }

            return {
              ...computed,
              quantity,
            };
          },
        });

        if (!result.isConfirmed) return null;
        return result.value || null;
      };

      const promptConsumableDeliveryForItem = async (item, service) => {
        const rows = (Array.isArray(service?.consumable_costs) ? service.consumable_costs : [])
          .filter((row) => row?.breakdown_in_invoice === true);

        if (rows.length === 0) {
          item.consumable_decisions = [];
          return true;
        }

        const existingByExpenseId = new Map(
          (Array.isArray(item.consumable_decisions) ? item.consumable_decisions : [])
            .map((row) => [String(row.service_product_expense_id || ''), row])
        );

        if (!window.Swal) {
          item.consumable_decisions = rows.map((row) => ({
            service_product_expense_id: String(row.expense_id || ''),
            delivered: existingByExpenseId.get(String(row.expense_id || ''))?.delivered !== false,
            product_variation_id: row.variation_id,
          }));
          return true;
        }

        const title = service?.name ? `Entrega de consumibles (${service.name})` : 'Entrega de consumibles';

        const html = rows.map((row, index) => {
          const expenseId = String(row.expense_id || '');
          const deliveredDefault = existingByExpenseId.get(expenseId)?.delivered !== false;
          const structureName = escapeHtml(String(row.structure_name || 'Sin estructura'));
          const productName = escapeHtml(String(row.product_name || 'Producto'));
          const variationName = escapeHtml(String(row.variation_name || 'Variacion'));
          const quantityValue = roundTo((Number(item.quantity || 0) || 0) * (Number(row.quantity || 0) || 0), 2);

          return `
            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3" data-consumable-row="${escapeHtml(expenseId)}">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="text-xs font-semibold text-slate-500">${structureName}</p>
                  <p class="text-sm font-semibold text-slate-800">${productName} (${variationName})</p>
                  <p class="text-xs text-slate-500">Cantidad esperada: ${formatNumber(quantityValue, 2)}</p>
                </div>
                <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100" title="Omitir" data-consumable-omit="${escapeHtml(expenseId)}">x</button>
              </div>
              <label class="mt-2 inline-flex items-center gap-2 text-xs font-semibold text-slate-700">
                <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-emerald-600" data-consumable-delivered="${escapeHtml(expenseId)}" ${deliveredDefault ? 'checked' : ''}>
                Entregado
              </label>
            </div>
          `;
        }).join('');

        const result = await window.Swal.fire({
          title,
          html: `<div class="space-y-2 text-left">${html}</div>`,
          showCancelButton: true,
          confirmButtonText: 'Guardar decision',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
          didOpen: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return;

            dialog.querySelectorAll('[data-consumable-omit]').forEach((button) => {
              button.addEventListener('click', () => {
                const expenseId = button.dataset.consumableOmit;
                const checkbox = dialog.querySelector(`[data-consumable-delivered="${expenseId}"]`);
                if (!checkbox) return;
                checkbox.checked = false;
              });
            });
          },
          preConfirm: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return null;

            return rows.map((row) => {
              const expenseId = String(row.expense_id || '');
              const delivered = Boolean(dialog.querySelector(`[data-consumable-delivered="${expenseId}"]`)?.checked);

              return {
                service_product_expense_id: expenseId,
                delivered,
                product_variation_id: row.variation_id,
              };
            });
          },
        });

        if (!result.isConfirmed) return false;

        item.consumable_decisions = Array.isArray(result.value) ? result.value : [];
        return true;
      };

      const ensureServiceCheckoutDecisions = async () => {
        const serviceEntries = Array.from(cart.entries()).filter(([, item]) => item.itemType === 'service');

        for (const [key, item] of serviceEntries) {
          const service = servicesById.get(String(item.serviceId));
          if (!serviceUsesCostDebit(service)) continue;

          if (serviceSkipsCheckoutPrompts(service)) {
            item.consumable_decisions = [];
            cart.set(key, item);
            continue;
          }

          const consumableReady = await promptConsumableDeliveryForItem(item, service);
          if (!consumableReady) return false;

          cart.set(key, item);
        }

        return true;
      };

      const ensureServicePartiesForCheckout = async () => {
        const serviceEntries = Array.from(cart.entries()).filter(([, item]) => item.itemType === 'service');
        const rowsByServiceId = new Map();

        serviceEntries.forEach(([, item]) => {
          const service = servicesById.get(String(item.serviceId));
          if (!serviceUsesCostDebit(service)) return;

          const serviceId = String(item.serviceId || '').trim();
          if (!serviceId) return;

          const row = rowsByServiceId.get(serviceId) || {
            serviceId,
            serviceName: String(service?.name || service?.sale_display_name || `Servicio #${serviceId}`),
            beneficiary: '',
            responsible: '',
          };

          const beneficiary = String(item.service_beneficiary_name || '').trim();
          const responsible = String(item.service_responsible_name || '').trim();
          if (!row.beneficiary && beneficiary) row.beneficiary = beneficiary;
          if (!row.responsible && responsible) row.responsible = responsible;

          rowsByServiceId.set(serviceId, row);
        });

        if (rowsByServiceId.size === 0) return true;

        const rowsHtml = Array.from(rowsByServiceId.values()).map((row) => {
          const sid = escapeHtml(row.serviceId);
          const sname = escapeHtml(row.serviceName);
          const beneficiaryValue = escapeHtml(String(row.beneficiary || ''));
          const responsibleValue = escapeHtml(String(row.responsible || ''));

          return `
            <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 space-y-2">
              <p class="text-sm font-semibold text-slate-800">${sname}</p>
              <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Beneficiario del servicio</label>
              <input type="text" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" data-service-beneficiary="${sid}" value="${beneficiaryValue}" placeholder="Nombre del beneficiario" autocomplete="off">
              <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Responsable del servicio (opcional)</label>
              <input type="text" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" data-service-responsible="${sid}" value="${responsibleValue}" placeholder="Nombre del responsable" autocomplete="off">
            </div>
          `;
        }).join('');

        const result = await window.Swal.fire({
          title: 'Datos del servicio',
          html: `<div class="space-y-3 text-left">${rowsHtml}</div>`,
          showCancelButton: true,
          confirmButtonText: 'Guardar y continuar',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
          preConfirm: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return null;

            const collected = {};

            for (const row of rowsByServiceId.values()) {
              const sid = String(row.serviceId || '').trim();
              const beneficiary = String(dialog.querySelector(`[data-service-beneficiary="${sid}"]`)?.value || '').trim();
              const responsible = String(dialog.querySelector(`[data-service-responsible="${sid}"]`)?.value || '').trim();

              if (!beneficiary) {
                window.Swal.showValidationMessage(`Debes indicar el beneficiario del servicio: ${row.serviceName}.`);
                return null;
              }

              collected[sid] = { beneficiary, responsible };
            }

            return collected;
          },
        });

        if (!result.isConfirmed) return false;

        const collected = result.value || {};
        serviceEntries.forEach(([key, item]) => {
          const sid = String(item.serviceId || '').trim();
          const values = collected[sid];
          if (!values) return;

          item.service_beneficiary_name = String(values.beneficiary || '').trim();
          item.service_responsible_name = String(values.responsible || '').trim();
          cart.set(key, item);
        });

        return true;
      };

      const updateQuantity = (key, delta) => {
        const item = cart.get(key);
        if (!item) return;

        const itemType = item.itemType || 'product';
        if (itemType === 'product') {
          const product = productsById.get(String(item.productId));
          if (!product) return;

          if (delta > 0) {
            const available = getAvailableForVariation(product, item.variationId);
            if (available <= 0) {
              if (window.Swal) {
                window.Swal.fire({
                  icon: 'warning',
                  title: 'Stock insuficiente',
                  text: 'No hay unidades disponibles para esta variacion.',
                  heightAuto: false,
                });
              }
              return;
            }
          }
        }

        item.quantity = Math.max(0, Number(item.quantity) + delta);
        if (item.quantity <= 0) {
          cart.delete(key);
        } else {
          cart.set(key, item);
        }
        renderCart();
      };

      const promptAddProduct = (productId) => {
        const product = productsById.get(String(productId));
        if (!product) return;

        const variations = product.variations && product.variations.length > 0
          ? product.variations
          : [{ id: null, name: 'Unica', available: Number(product.available_total) || 0 }];

        const availableEntries = sortVariationSelectionEntries(variations.map((variation) => {
          const available = getAvailableForVariation(product, variation.id);
          return {
            id: variation.id,
            name: variation.name,
            available: available,
          };
        }));

        const hasStock = availableEntries.some((entry) => entry.available > 0);
        if (!hasStock) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'warning',
              title: 'Sin stock',
              text: 'No hay unidades disponibles para este producto.',
              heightAuto: false,
            });
          }
          return;
        }

        const optionsHtml = availableEntries
          .map((entry) => {
            const disabled = entry.available <= 0;
            const valueAttr = entry.id === null ? '' : entry.id;
            const rowClass = disabled
              ? 'border-rose-200 bg-rose-50/80 cursor-not-allowed'
              : 'border-slate-200 bg-white hover:bg-slate-50';
            const titleClass = disabled ? 'text-rose-700' : 'text-slate-700';
            const metaClass = disabled ? 'text-rose-600' : 'text-slate-500';
            const badgeClass = disabled
              ? 'bg-rose-100 text-rose-700 ring-1 ring-rose-200'
              : 'bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200';
            const controlButtonClass = disabled
              ? 'border-rose-200 bg-rose-100 text-rose-400 cursor-not-allowed'
              : 'border-slate-200 text-slate-500 hover:bg-slate-50';
            const inputClass = disabled
              ? 'border-rose-200 bg-rose-100 text-rose-500'
              : 'border-slate-200 bg-white text-slate-700';
            return `
              <div class="flex items-center justify-between gap-3 rounded-lg border px-3 py-2 ${rowClass}" data-variation-row data-variation-id="${valueAttr}" data-variation-name="${escapeHtml(entry.name)}" data-variation-available="${entry.available}">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="text-sm font-semibold truncate ${titleClass}" data-variation-name-label>${escapeHtml(entry.name)}</p>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold ${badgeClass}" data-variation-status-badge>${disabled ? 'Sin stock' : 'Disponible'}</span>
                  </div>
                  <p class="text-xs ${metaClass}" data-variation-meta>Disp: <span data-variation-available-label>${formatNumber(entry.available, 0)}</span></p>
                </div>
                <div class="grid grid-cols-[1.75rem_2.5rem_1.75rem] items-center gap-2">
                  <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-lg border ${controlButtonClass}" data-qty-action="decrease" ${disabled ? 'disabled' : ''}>-</button>
                  <input type="text" inputmode="numeric" pattern="[0-9]*" value="0" ${disabled ? 'disabled' : ''}
                    class="w-10 rounded-lg border px-1 py-1 text-center text-sm font-semibold ${inputClass}" data-variation-qty>
                  <button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-lg border ${controlButtonClass}" data-qty-action="increase" ${disabled ? 'disabled' : ''}>+</button>
                </div>
              </div>
            `;
          })
          .join('');

        const modalHtml = `
          <div class="space-y-3 text-left" data-variation-modal-product-id="${product.id}">
            <div class="rounded-xl border border-sky-200 bg-gradient-to-r from-sky-50 via-cyan-50 to-white px-3 py-2">
              <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-sky-700">Producto seleccionado</p>
              <p class="mt-1 text-base font-extrabold leading-tight text-slate-800">${escapeHtml(product.name)}</p>
            </div>
            <p class="text-xs text-slate-400">Agrega cantidades por variacion para incluir varias en una sola vez.</p>
            <div class="space-y-2" data-variation-modal-list>${optionsHtml}</div>
          </div>
        `;

        window.Swal.fire({
          title: 'Selecciona variacion',
          html: modalHtml,
          showCancelButton: true,
          confirmButtonText: 'Agregar',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
          didOpen: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return;

            const updateAvailableLabel = (row, available, selected) => {
              const label = row.querySelector('[data-variation-available-label]');
              if (!label) return;

              const remaining = Math.max(0, available - selected);
              label.textContent = formatNumber(remaining, 0);
            };

            const getRowAvailable = (row) => {
              return Number.parseInt(row.dataset.variationAvailable || '0', 10) || 0;
            };

            const normalizeQty = (row, input) => {
              const available = getRowAvailable(row);
              const raw = String(input.value || '').replace(/\D/g, '');
              const parsed = Number.parseInt(raw || '0', 10) || 0;
              const safe = Math.min(Math.max(parsed, 0), available);
              input.value = safe > 0 ? String(safe) : '0';
              updateAvailableLabel(row, available, safe);
              return safe;
            };

            dialog.querySelectorAll('[data-variation-row]').forEach((row) => {
              const available = getRowAvailable(row);
              const qtyInput = row.querySelector('[data-variation-qty]');
              if (!qtyInput) return;

              applyVariationRowAvailabilityState(row, available);
              normalizeQty(row, qtyInput);

              row.querySelectorAll('[data-qty-action]').forEach((button) => {
                button.addEventListener('click', () => {
                  if (button.disabled) return;
                  const rowAvailable = getRowAvailable(row);
                  const current = normalizeQty(row, qtyInput);
                  const delta = button.dataset.qtyAction === 'increase' ? 1 : -1;
                  const next = Math.min(Math.max(current + delta, 0), rowAvailable);
                  qtyInput.value = String(next);
                  normalizeQty(row, qtyInput);
                });
              });

              qtyInput.addEventListener('input', () => {
                normalizeQty(row, qtyInput);
              });

              qtyInput.addEventListener('blur', () => {
                normalizeQty(row, qtyInput);
              });
            });

            sortVariationSelectionRows(dialog.querySelector('[data-variation-modal-list]'));
          },
          preConfirm: () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return null;

            const liveProduct = productsById.get(String(productId)) || product;

            const selections = [];
            let invalid = false;
            dialog.querySelectorAll('[data-variation-row]').forEach((row) => {
              const variationId = row.dataset.variationId || null;
              const variationName = row.dataset.variationName || 'Unica';
              const qtyInput = row.querySelector('[data-variation-qty]');
              const quantity = Number.parseInt(qtyInput?.value || '0', 10) || 0;
              if (quantity <= 0) return;

              const available = getAvailableForVariation(liveProduct, variationId);
              if (quantity > available) {
                window.Swal.showValidationMessage(`Disponible para ${variationName}: ${formatNumber(available, 0)}`);
                invalid = true;
                return;
              }

              selections.push({ variationId: normalizeVariationId(variationId), quantity });
            });

            if (invalid) return null;

            if (selections.length === 0) {
              window.Swal.showValidationMessage('Agrega al menos una variacion con cantidad.');
              return null;
            }

            return selections;
          },
        }).then((result) => {
          if (!result.isConfirmed) return;
          const payload = result.value || [];
          payload.forEach((entry) => {
            addToCart(productId, entry.variationId, entry.quantity);
          });
        });
      };

      const buildVentaPayload = (payments, change, creditSale = null, forcedBaseCurrency = null, checkoutDiscount = null, casheaSale = null) => {
        const selectedBaseCurrency = String(forcedBaseCurrency || getSelectedBaseCurrency() || '').toLowerCase() === 'ves' ? 'ves' : 'usd';
        applyBaseCurrencySelection(selectedBaseCurrency, { syncInputs: true, syncCart: true, render: false });
        const currentTotals = calculateCartTotals();
        const items = Array.from(cart.entries()).map(([cartKey, item]) => {
          if (item.itemType === 'service') {
            const service = servicesById.get(String(item.serviceId));
            const discountPercent = service?.printing_type_service
              ? resolvePrintVolumeDiscountPercent(service)
              : 0;
            let unitPriceUsd = item.unit_price_usd;

            if (service?.printing_type_service && discountPercent > 0) {
              const baseUnitBs = Number(item.selected_print_unit_price_bs);
              if (Number.isFinite(baseUnitBs) && baseUnitBs > 0 && bcvRate > 0) {
                const discountedBs = roundTo(baseUnitBs * (1 - discountPercent / 100), 2);
                unitPriceUsd = roundTo(discountedBs / bcvRate, 6);
              }
            }

            const baseSnapshot = resolveServiceBaseSnapshotForCurrency({
              ...item,
              unit_price_usd: unitPriceUsd,
            }, service, selectedBaseCurrency);

            const signatureFromKey = String(cartKey || '').split('::')[1] || '';
            const signatureTokens = signatureFromKey && signatureFromKey !== 'none'
              ? String(signatureFromKey).split('|').filter(Boolean)
              : [];

            const deliveryFromKey = signatureTokens
              .find((token) => token.startsWith('delivery-'))
              ?.replace('delivery-', '') || null;

            const materialFromKey = signatureTokens
              .find((token) => token.startsWith('print-material-'))
              ?.replace('print-material-', '') || null;

            const coverageFromKey = signatureTokens
              .find((token) => token.startsWith('print-coverage-'))
              ?.replace('print-coverage-', '') || null;

            const normalizedSignature = signatureTokens
              .filter((token) =>
                !token.startsWith('delivery-')
                && !token.startsWith('print-material-')
                && !token.startsWith('print-coverage-')
                && !token.startsWith('print-unit-bs-')
              )
              .join('|') || (item.price_signature || null);

            const deliveryPresentation = String(item.delivery_presentation || deliveryFromKey || '').trim().toLowerCase() || null;

            return {
              item_type: 'service',
              service_id: item.serviceId,
              service_beneficiary_name: String(item.service_beneficiary_name || '').trim(),
              service_responsible_name: String(item.service_responsible_name || '').trim(),
              delivery_presentation: deliveryPresentation,
              selected_print_coverage_id: String(item.selected_print_coverage_id || coverageFromKey || '').trim() || null,
              selected_print_coverage_percent: String(item.selected_print_coverage_percent || '').trim() || null,
              selected_print_price_bs: item.selected_print_price_bs,
              selected_print_surcharge_percent: item.selected_print_surcharge_percent,
              selected_print_unit_price_bs: item.selected_print_unit_price_bs,
              printing_discount_percent: discountPercent,
              selected_print_material_surcharge_id: String(item.selected_print_material_surcharge_id || materialFromKey || '').trim() || null,
              selected_print_material_product_id: String(item.selected_print_material_product_id || '').trim() || null,
              selected_print_material_label: String(item.selected_print_material_label || '').trim() || null,
              selected_print_material_rows: toServiceMaterialRowsPayload(item.selected_print_material_rows),
              quantity: item.quantity,
              unit_price_usd: baseSnapshot.unitPriceUsd,
              unit_price_base_amount: baseSnapshot.unitPriceBaseAmount,
              unit_price_base_currency: baseSnapshot.unitPriceBaseCurrency,
              agreed_price_display: item.agreed_price_display,
              agreed_reference_name: item.agreed_reference_name,
              agreed_reference_amount: item.agreed_reference_amount,
              agreed_reference_symbol: item.agreed_reference_symbol,
              recarga_base_amount: item.recarga_base_amount,
              recarga_total_amount: item.recarga_total_amount,
              recarga_profit_percent: item.recarga_profit_percent,
              price_signature: normalizedSignature,
              consumable_decisions: Array.isArray(item.consumable_decisions) ? item.consumable_decisions : [],
            };
          }

          return {
            item_type: 'product',
            product_id: item.productId,
            variation_id: item.variationId,
            quantity: item.quantity,
          };
        });

        const payload = {
          draft_id: activeDraftId,
          vat_mode: getVatMode(),
          vat_rate: vatRate,
          tasa_dolar: bcvRate,
          base_currency: selectedBaseCurrency === 'ves' ? 'VES' : 'USD',
          cliente_id: selectedClient ? selectedClient.id : null,
          totals: {
            taxable_subtotal_base: currentTotals.taxableSubtotalBase,
            exento_subtotal_base: currentTotals.exentoSubtotalBase,
            vat_base: currentTotals.vatBase,
            total_base: currentTotals.totalBase,
          },
          items: items,
          payments: payments || [],
        };

        const changeEntries = Array.isArray(change) ? change : (change ? [change] : []);
        if (changeEntries.length > 0) payload.change = changeEntries;

        if (creditSale && creditSale.enabled) {
          payload.credit_sale = {
            enabled: true,
            due_on: String(creditSale.due_on || '').trim(),
          };
        }

        if (checkoutDiscount && checkoutDiscount.enabled) {
          payload.checkout_discount = {
            enabled: true,
            amount: checkoutDiscount.amount,
            reason: String(checkoutDiscount.reason || '').trim(),
          };
        }

        if (casheaSale && casheaSale.enabled) {
          payload.cashea = {
            enabled: true,
            account_id: casheaSale.account_id,
            initial_usd: casheaSale.initial_usd,
            min_purchase_usd: casheaSale.min_purchase_usd,
            installments: Array.isArray(casheaSale.installments) ? casheaSale.installments : [],
          };
        }

        return payload;
      };

      const submitVenta = async (payments, change, creditSale = null, forcedBaseCurrency = null, checkoutDiscount = null, casheaSale = null) => {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (!csrfToken) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Token CSRF no disponible',
              text: 'Recarga la pagina e intenta de nuevo.',
              heightAuto: false,
            });
          }
          return;
        }

        const payload = buildVentaPayload(payments, change, creditSale, forcedBaseCurrency, checkoutDiscount, casheaSale);

        if (window.Swal) {
          window.Swal.fire({
            title: 'Procesando venta',
            text: 'Guardando la venta, espera...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => window.Swal.showLoading(),
            heightAuto: false,
          });
        }

        try {
          const response = await fetch('/ventas', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
            },
            body: JSON.stringify({ venta: payload }),
          });

          let data = {};
          try {
            data = await response.json();
          } catch (error) {
            data = {};
          }

          if (!response.ok) {
            const requestError = new Error(data.error || 'No se pudo registrar la venta.');
            requestError.payload = data;
            throw requestError;
          }

          if (Array.isArray(data.products)) {
            syncProductsMap(data.products);
          }

          drafts = Array.isArray(data.drafts) ? data.drafts : drafts;
          if (draftSyncTimeout) {
            clearTimeout(draftSyncTimeout);
            draftSyncTimeout = null;
          }
          draftSyncedFingerprint = null;
          activeDraftId = null;
          activeDraftCreatedById = null;
          activeDraftVisibility = null;
          applySyncedReservationSnapshot(new Map());
          cart.clear();
          setSelectedClient(null);
          renderDraftTags();
          renderCart();

          if (window.Swal) {
            const saleShowUrl = `/ventas/${encodeURIComponent(String(data.id || ''))}`;
            const successTitle = isCustomerPosMode ? 'Pedido registrado' : 'Venta registrada';
            const successText = isCustomerPosMode
              ? 'El pedido fue realizado con exito. Debe ser aprobado por el encargado y tendra 24 horas para culminarlo. Sus productos han sido reservados.'
              : 'La venta fue registrada correctamente.';
            const successConfirmText = isCustomerPosMode ? 'Ver pedido' : 'Ver venta';
            const result = await window.Swal.fire({
              icon: 'success',
              title: successTitle,
              text: successText,
              showCancelButton: true,
              confirmButtonText: successConfirmText,
              cancelButtonText: 'Cerrar',
              reverseButtons: true,
              heightAuto: false,
            });

            if (result.isConfirmed && data.id) {
              window.location.href = saleShowUrl;
            }
          }
        } catch (error) {
          const duplicatePayment = error?.payload?.duplicate_payment;
          if (duplicatePayment && window.Swal) {
            const accountName = escapeHtml(String(duplicatePayment.account_name || 'Cuenta bancaria'));
            const amountNumber = Number(duplicatePayment.amount);
            const currencyCode = String(duplicatePayment.currency || '').trim();
            const currencySymbol = String(duplicatePayment.currency_symbol || '').trim();
            const amountLabel = Number.isFinite(amountNumber)
              ? `${currencySymbol || currencyCode} ${amountNumber.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
              : `${escapeHtml(String(duplicatePayment.amount || '-'))} ${escapeHtml(currencyCode)}`;
            const paymentDate = escapeHtml(String(duplicatePayment.payment_date || '-'));
            const saleId = String(duplicatePayment.venta_id || '').trim();
            const saleUrl = String(duplicatePayment.venta_url || '').trim();
            const saleLinkHtml = saleUrl
              ? `<a href="${escapeHtml(saleUrl)}" class="inline-flex items-center justify-center rounded-lg border border-sky-300 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100">Ir a la venta ${saleId ? `#${escapeHtml(saleId)}` : ''}</a>`
              : '';

            window.Swal.fire({
              icon: 'error',
              title: 'Pago bancario duplicado',
              html: `
                <div class="space-y-2 text-left text-sm text-slate-600">
                  <p>Ya existe un pago registrado con los mismos datos:</p>
                  <p><strong>Cuenta:</strong> ${accountName}</p>
                  <p><strong>Monto:</strong> ${amountLabel}</p>
                  <p><strong>Fecha:</strong> ${paymentDate}</p>
                  ${saleLinkHtml}
                </div>
              `,
              heightAuto: false,
            });
            return;
          }

          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Error al registrar',
              text: error.message,
              heightAuto: false,
            });
          }
        }
      };

      const cashExchangeButton = document.getElementById('ventas-cash-exchange-button');
      if (cashExchangeButton && !cashExchangeButton.dataset.boundCashExchange) {
        cashExchangeButton.dataset.boundCashExchange = 'true';
        cashExchangeButton.addEventListener('click', async () => {
          const allowed = await ensureCashExchangeAllowed();
          if (!allowed) return;
          openCashExchangeModal();
        });
      }

      const productGrid = document.getElementById('ventas-product-grid');
      if (productGrid) {
        productGrid.addEventListener('click', (event) => {
          const addButton = event.target.closest('.ventas-add-button');
          const card = event.target.closest('.ventas-product-card');
          const productId = addButton?.dataset.productId || card?.dataset.productId;
          if (!productId) return;
          if (!window.Swal) {
            addToCart(productId, null, 1);
            return;
          }
          promptAddProduct(productId);
        });
      }

      const serviceGrid = document.getElementById('ventas-service-grid');
      if (serviceGrid) {
        serviceGrid.addEventListener('click', async (event) => {
          const addButton = event.target.closest('.ventas-add-service');
          const card = event.target.closest('.ventas-service-card');
          const serviceId = addButton?.dataset.serviceId || card?.dataset.serviceId;
          if (!serviceId) return;

          const service = servicesById.get(String(serviceId));
          if (!service) return;

          if (card?.dataset.serviceDisabled === 'true') {
            if (window.Swal) {
              window.Swal.fire({
                icon: 'warning',
                title: 'Precio no disponible',
                text: 'Este servicio no tiene tasa disponible para facturar.',
                heightAuto: false,
              });
            }
            return;
          }

          if (isRecargaService(service)) {
            const recarga = await promptRecargaService(service);
            if (!recarga) return;

            const keyParts = [recarga.priceSignature];
            const key = buildKey('service', serviceId, keyParts.join('|'));
            const existing = cart.get(key) || {
              itemType: 'service',
              serviceId: String(serviceId),
              quantity: 0,
              unit_price_usd: recarga.unitPriceUsd,
              unit_price_base_amount: recarga.unitPriceBaseAmount,
              unit_price_base_currency: recarga.unitPriceBaseCurrency,
              recarga_base_amount: recarga.baseAmount,
              recarga_total_amount: recarga.totalAmount,
              recarga_profit_percent: recarga.profitPercent,
              price_signature: recarga.priceSignature,
              consumable_decisions: [],
            };

            existing.quantity += 1;
            cart.set(key, existing);
            renderCart();
            return;
          }

          if (service.printing_type_service) {
            await addServiceToCart(serviceId, 1);
            return;
          }

          if (service.price_on_request) {
            const agreedPricing = await promptServicePriceOnRequest(service);
            if (!agreedPricing) return;
            await addServiceToCart(serviceId, agreedPricing.quantity, { agreedPricing });
            return;
          }

          await addServiceToCart(serviceId, 1);
        });
      }

      const cartList = document.getElementById('ventas-cart-list');
      if (cartList) {
        cartList.addEventListener('click', (event) => {
          const button = event.target.closest('button[data-cart-action]');
          if (!button) return;

          const action = button.dataset.cartAction;
          const key = button.dataset.cartKey;
          if (!key) return;

          if (action === 'increase') updateQuantity(key, 1);
          if (action === 'decrease') updateQuantity(key, -1);
          if (action === 'remove') {
            cart.delete(key);
            renderCart();
          }
        });
      }

      const safeRecalculateForVatChange = (nextMode = null) => {
        try {
          if (nextMode) {
            setVatMode(nextMode, { render: true });
          } else {
            renderCart();
          }
        } catch (_error) {
          // Fallback: at least refresh totals panel if cart rendering fails unexpectedly.
          renderTotals();
        }
      };

      root.querySelectorAll('input[name="ventas-vat-mode"]').forEach((radio) => {
        radio.addEventListener('change', () => {
          safeRecalculateForVatChange(radio.value);
        });
      });

      // Delegated VAT handler keeps recalculation working even if radio nodes are recreated.
      root.addEventListener('change', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.matches('input[name="ventas-vat-mode"]')) return;
        safeRecalculateForVatChange(target.value);
      });

      root.addEventListener('input', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.matches('input[name="ventas-vat-mode"]')) return;
        safeRecalculateForVatChange(target.value);
      });

      root.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const directRadio = target.closest('input[name="ventas-vat-mode"]');
        if (directRadio) {
          safeRecalculateForVatChange(directRadio.value);
          return;
        }

        const label = target.closest('label');
        if (!label) return;
        const nestedRadio = label.querySelector('input[name="ventas-vat-mode"]');
        if (!nestedRadio) return;
        safeRecalculateForVatChange(nestedRadio.value);
      });

      root.addEventListener('change', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.matches('input[name="ventas-base-currency"]')) return;
        if (target.disabled) return;
        applyBaseCurrencySelection(target.value);
      });

      root.addEventListener('input', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.matches('input[name="ventas-base-currency"]')) return;
        if (target.disabled) return;
        applyBaseCurrencySelection(target.value);
      });

      root.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const radio = target.matches('input[name="ventas-base-currency"]')
          ? target
          : target.closest('label')?.querySelector('input[name="ventas-base-currency"]');
        if (!radio || radio.disabled) return;
        applyBaseCurrencySelection(radio.value);
      });

      const payButton = document.getElementById('ventas-pay-button');
      if (payButton) {
        payButton.addEventListener('click', async () => {
          if (!isCustomerPosMode) {
            await fetchActiveCashierStatus().catch(() => null);
          }

          const isActiveCashierUser = activeCashierId > 0 && currentUserId > 0 && activeCashierId === currentUserId;
          const hasDifferentActiveCashier = activeCashierId > 0 && currentUserId > 0 && activeCashierId !== currentUserId;

          if (!isCustomerPosMode && hasDifferentActiveCashier) {
            if (window.Swal) {
              const cashierRole = activeCashierRoleLabel || 'Cajero activo';
              const cashierName = activeCashierName || 'Personal asignado';
              const result = await window.Swal.fire({
                icon: 'warning',
                title: 'Cobro restringido',
                html: `
                  <p class="text-sm text-slate-600">Quien puede realizar el cobro es <strong>${escapeHtml(cashierName)}</strong> (${escapeHtml(cashierRole)}).</p>
                  <p class="mt-2 text-sm text-slate-600">Indique si la venta esta lista para cobrar.</p>
                `,
                showCancelButton: true,
                confirmButtonText: 'Si, marcar lista',
                cancelButtonText: 'No',
                heightAuto: false,
              });

              if (result.isConfirmed) {
                const markedReady = await persistDraft({
                  clearAfterSave: true,
                  silent: true,
                  draftVisibility: 'visible',
                  draftCheckoutStatus: 'ready',
                });

                if (markedReady) {
                  window.Swal.fire({
                    icon: 'success',
                    title: 'Venta lista para cobro',
                    text: 'El borrador se marco como listo para cobrar para el cajero activo.',
                    heightAuto: false,
                  });
                } else {
                  window.Swal.fire({
                    icon: 'error',
                    title: 'No se pudo marcar',
                    text: 'Agrega productos al panel y vuelve a intentarlo.',
                    heightAuto: false,
                  });
                }
              }
            }
            return;
          }

          if (!isCustomerPosMode && !isActiveCashierUser && !canChargeSale) {
            if (window.Swal) {
              const cashierRole = activeCashierRoleLabel || 'Sin cargo asignado';
              const cashierName = activeCashierName || 'Sin cajero activo';
              window.Swal.fire({
                icon: 'warning',
                title: 'Cobro no autorizado',
                html: `
                  <p class="text-sm text-slate-600">El cajero autorizado para realizar el cobro es <strong>${escapeHtml(cashierRole)} - ${escapeHtml(cashierName)}</strong>.</p>
                  <p class="mt-2 text-sm text-slate-600">Solo el encargado o administrador pueden cobrar ventas.</p>
                `,
                heightAuto: false,
              });
            }
            return;
          }

          const checkoutBaseCurrency = getSelectedBaseCurrency();
          applyBaseCurrencySelection(checkoutBaseCurrency, { syncInputs: true, syncCart: true, render: false });
          if (!isCustomerPosMode && !hasOpenCashShift) {
            if (window.Swal) {
              window.Swal.fire({
                icon: 'warning',
                title: 'Turno no iniciado',
                text: 'Debes abrir un turno antes de poder facturar.',
                heightAuto: false,
              });
            }
            return;
          }

          if (cart.size === 0) {
            if (window.Swal) {
              window.Swal.fire({
                icon: 'info',
                title: 'Orden vacia',
                text: 'Agrega productos o servicios antes de cobrar.',
                heightAuto: false,
              });
            }
            return;
          }

          if (isCustomerPosMode) {
            const checkoutDecisionsReady = await ensureServiceCheckoutDecisions();
            if (!checkoutDecisionsReady) return;

            const servicePartiesReady = await ensureServicePartiesForCheckout();
            if (!servicePartiesReady) return;

            submitVenta([], [], null, checkoutBaseCurrency, null, null);
            return;
          }

          const vatMode = getVatMode();
          const totals = calculateCartTotals();
          const subtotalBase = totals.taxableSubtotalBase;
          const exentoBase = totals.exentoSubtotalBase;
          const vatBase = totals.vatBase;
          const totalBase = totals.totalBase;

          if (!window.Swal) {
            return;
          }

          if (accounts.length === 0) {
            window.Swal.fire({
              icon: 'info',
              title: 'Sin cuentas disponibles',
              text: 'Registra al menos una cuenta para cobrar.',
              heightAuto: false,
            });
            return;
          }

          const baseCurrencyCode = baseCurrency === 'ves' ? 'VES' : 'USD';
          const allPaymentAccounts = accounts.filter((account) => !normalizeServiceName(account?.name).includes('payall'));
          const totalUsd = convertAmount(totalBase, baseCurrencyCode, 'USD');
          const casheaAccount = allPaymentAccounts.find((account) => String(account.account_type || '').toLowerCase() === 'cashea');
          const casheaMinPurchaseUsd = Number(casheaAccount?.cashea_min_purchase_usd || 0);
          const casheaInstallmentsCount = (() => {
            if (!casheaAccount) return 0;
            const lineMode = String(casheaAccount.cashea_line_mode || '').toLowerCase();
            if (lineMode === 'principal') return 3;
            const rawCount = Number(casheaAccount.cashea_cotidiana_installments || 1);
            return Number.isFinite(rawCount) && rawCount > 0 ? Math.round(rawCount) : 1;
          })();
          const canOfferCashea = casheaAccount
            && Number.isFinite(totalUsd)
            && totalUsd > 0
            && totalUsd >= casheaMinPurchaseUsd
            && casheaMinPurchaseUsd > 0;

          let selectedCasheaContext = null;
          if (canOfferCashea) {
            const casheaImageUrl = String(casheaAccount?.payment_method_image_url || '').trim() || "<%= asset_path('cashea.png') %>";
            const now = new Date();
            const formatDateLabel = (date) => `${String(date.getDate()).padStart(2, '0')}-${String(date.getMonth() + 1).padStart(2, '0')}-${date.getFullYear()}`;
            const addDays = (baseDate, days) => {
              const date = new Date(baseDate.getFullYear(), baseDate.getMonth(), baseDate.getDate());
              date.setDate(date.getDate() + days);
              return date;
            };
            const normalizeCasheaDueDate = (rawValue) => {
              const normalized = String(rawValue || '').trim();
              if (!normalized) return null;

              const isoMatch = normalized.match(/^(\d{4})-(\d{2})-(\d{2})$/);
              if (isoMatch) {
                const year = Number(isoMatch[1]);
                const month = Number(isoMatch[2]);
                const day = Number(isoMatch[3]);
                const parsedDate = new Date(year, month - 1, day);
                if (
                  parsedDate.getFullYear() !== year
                  || parsedDate.getMonth() !== month - 1
                  || parsedDate.getDate() !== day
                ) {
                  return null;
                }
                return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
              }

              const displayMatch = normalized.match(/^(\d{2})-(\d{2})-(\d{4})$/);
              if (displayMatch) {
                const day = Number(displayMatch[1]);
                const month = Number(displayMatch[2]);
                const year = Number(displayMatch[3]);
                const parsedDate = new Date(year, month - 1, day);
                if (
                  parsedDate.getFullYear() !== year
                  || parsedDate.getMonth() !== month - 1
                  || parsedDate.getDate() !== day
                ) {
                  return null;
                }
                return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
              }

              return null;
            };

            const casheaQuestion = await window.Swal.fire({
              title: 'Compra elegible para Cashea',
              html: `
                <div class="overflow-hidden rounded-2xl border border-cyan-200 bg-gradient-to-br from-cyan-50 via-white to-sky-50 shadow-md">
                  <img src="${casheaImageUrl}" alt="Banner Cashea" class="block w-full h-auto" />
                  <div class="space-y-2 px-4 py-4 text-left">
                    <p class="text-base font-extrabold text-slate-800">Esta compra califica para pagar con Cashea.</p>
                    <p class="text-sm text-slate-600">Puede proponerselo al cliente en caso de no haberlo hecho.</p>
                    <div class="grid gap-2 sm:grid-cols-2 pt-1">
                      <div class="rounded-xl border border-sky-200 bg-white px-3 py-2">
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Compra minima Cashea</p>
                        <p class="text-sm font-extrabold text-sky-700">$ ${formatNumber(casheaMinPurchaseUsd, 2)}</p>
                      </div>
                      <div class="rounded-xl border border-emerald-200 bg-white px-3 py-2">
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Total de esta venta</p>
                        <p class="text-sm font-extrabold text-emerald-700">$ ${formatNumber(totalUsd, 2)}</p>
                      </div>
                    </div>
                    <p class="pt-1 text-sm font-semibold text-slate-700">¿Deseas procesar esta venta con Cashea?</p>
                  </div>
                </div>
              `,
              showCancelButton: true,
              confirmButtonText: 'Si, usar Cashea',
              cancelButtonText: 'No',
              reverseButtons: true,
              buttonsStyling: false,
              customClass: {
                popup: 'rounded-3xl border border-sky-200 shadow-xl',
                title: 'text-2xl font-extrabold text-slate-800',
                actions: 'w-full flex flex-wrap items-center justify-end gap-2 mt-5 px-4 pb-4',
                confirmButton: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-500',
                cancelButton: 'inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50',
              },
              heightAuto: false,
            });

            if (casheaQuestion.isConfirmed) {
              if (!selectedClient?.id) {
                await window.Swal.fire({
                  icon: 'warning',
                  title: 'Cliente requerido para Cashea',
                  text: 'Debes seleccionar un cliente antes de procesar la venta con Cashea.',
                  confirmButtonText: 'Entendido',
                  heightAuto: false,
                });
                return;
              }

              if (String(selectedClient?.phone || '').trim().length === 0) {
                await window.Swal.fire({
                  icon: 'warning',
                  title: 'Telefono requerido',
                  text: 'El cliente debe tener telefono para registrar cuotas Cashea.',
                  confirmButtonText: 'Entendido',
                  heightAuto: false,
                });
                return;
              }

              const installmentsRowsHtml = Array.from({ length: casheaInstallmentsCount }).map((_, index) => {
                const suggestedDueDate = addDays(now, 14 * (index + 1));
                const suggestedDueDateLabel = formatDateLabel(suggestedDueDate);
                return `
                <div class="grid gap-2 rounded-xl border border-slate-200 bg-slate-50/70 p-2 sm:grid-cols-2" data-cashea-installment-row="${index + 1}">
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Cuota ${index + 1} monto (USD)</label>
                    <input type="text" inputmode="decimal" autocomplete="off" data-money-mask="true" data-money-symbol="$" data-cashea-installment-amount="${index + 1}" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700" placeholder="$ 0,00" />
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Vencimiento cuota ${index + 1}</label>
                    <input type="text" autocomplete="off" data-cashea-installment-due="${index + 1}" class="js-materialize-datepicker materialize-datepicker-input w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700" placeholder="dd-mm-aaaa" value="${suggestedDueDateLabel}" />
                  </div>
                </div>
              `;
              }).join('');

              const askInitialResult = await window.Swal.fire({
                title: 'Inicial Cashea',
                html: `
                  <div class="space-y-3 text-left">
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">
                      <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Monto inicial (USD)</label>
                      <input id="cashea-initial-usd" type="text" inputmode="decimal" autocomplete="off" data-money-mask="true" data-money-symbol="$" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700" placeholder="$ 0,00" />
                      <p id="cashea-initial-bs" class="mt-1 text-xs font-semibold text-slate-500">Equivalente Bs: ${formatMoney(0, 'Bs')}</p>
                      <p id="cashea-financed-usd" class="mt-1 text-xs font-semibold text-slate-500">Saldo financiado estimado: $ ${formatNumber(totalUsd, 2)}</p>
                    </div>
                    <div class="space-y-2">
                      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Configurar cuotas Cashea (${casheaInstallmentsCount})</p>
                      ${installmentsRowsHtml}
                    </div>
                  </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Continuar al cobro',
                cancelButtonText: 'Cancelar',
                focusConfirm: false,
                heightAuto: false,
                didOpen: () => {
                  const dialog = window.Swal.getHtmlContainer();
                  if (!dialog) return;

                  initMoneyMasks(dialog);
                  if (typeof window.initializeMaterializeDatepickers === 'function') {
                    window.initializeMaterializeDatepickers(dialog);
                  }

                  const usdInput = dialog.querySelector('#cashea-initial-usd');
                  const bsLabel = dialog.querySelector('#cashea-initial-bs');
                  const financedLabel = dialog.querySelector('#cashea-financed-usd');
                  const installmentAmountInputs = Array.from(dialog.querySelectorAll('[data-cashea-installment-amount]'));

                  const updateInstallmentSuggestion = () => {
                    const initialUsd = roundTo(parseMoneyInput(usdInput), 2);
                    const financedUsd = roundTo(Math.max(totalUsd - initialUsd, 0), 2);
                    const count = installmentAmountInputs.length;
                    if (count <= 0) return;

                    if (financedLabel) {
                      financedLabel.textContent = `Saldo financiado estimado: $ ${formatNumber(financedUsd, 2)}`;
                    }

                    const baseAmount = roundTo(financedUsd / count, 2);
                    let running = 0;
                    installmentAmountInputs.forEach((input, index) => {
                      const amount = index === count - 1
                        ? roundTo(financedUsd - running, 2)
                        : baseAmount;
                      running = roundTo(running + amount, 2);
                      setMoneyInputValue(input, amount, '$');
                    });
                  };

                  const updateBs = () => {
                    const usdValue = parseMoneyInput(usdInput);
                    const bsValue = bcvRate > 0 ? roundTo(usdValue * bcvRate, 2) : 0;
                    bsLabel.textContent = `Equivalente Bs: ${formatMoney(bsValue, 'Bs')}`;
                    updateInstallmentSuggestion();
                  };

                  usdInput?.addEventListener('input', updateBs);
                  usdInput?.addEventListener('blur', updateBs);
                  updateBs();
                },
                preConfirm: () => {
                  const dialog = window.Swal.getHtmlContainer();
                  const usdInput = dialog?.querySelector('#cashea-initial-usd');
                  const initialUsd = roundTo(parseMoneyInput(usdInput), 2);

                  if (!initialUsd || initialUsd <= 0) {
                    window.Swal.showValidationMessage('Debes indicar un monto inicial mayor a 0.');
                    return null;
                  }

                  if (!Number.isFinite(totalUsd) || totalUsd <= 0) {
                    window.Swal.showValidationMessage('No se pudo calcular el total en USD para Cashea.');
                    return null;
                  }

                  if (initialUsd > totalUsd) {
                    window.Swal.showValidationMessage(`El inicial no puede superar el total de la venta ($ ${formatNumber(totalUsd, 2)}).`);
                    return null;
                  }

                  const financedUsd = roundTo(Math.max(totalUsd - initialUsd, 0), 2);
                  const installments = [];
                  const rows = Array.from(dialog.querySelectorAll('[data-cashea-installment-row]'));

                  if (financedUsd > 0 && rows.length === 0) {
                    window.Swal.showValidationMessage('Debes configurar las cuotas Cashea antes de continuar.');
                    return null;
                  }

                  let installmentsTotal = 0;
                  for (const row of rows) {
                    const amountInput = row.querySelector('[data-cashea-installment-amount]');
                    const dueInput = row.querySelector('[data-cashea-installment-due]');
                    const installmentAmount = roundTo(parseMoneyInput(amountInput), 2);
                    const dueOnIso = normalizeCasheaDueDate(dueInput?.value);

                    if (financedUsd > 0 && installmentAmount <= 0) {
                      window.Swal.showValidationMessage('Cada cuota Cashea debe tener un monto mayor a 0.');
                      return null;
                    }

                    if (financedUsd > 0 && !dueOnIso) {
                      window.Swal.showValidationMessage('Cada cuota Cashea debe tener una fecha de vencimiento valida.');
                      return null;
                    }

                    if (financedUsd > 0) {
                      installments.push({ amount_usd: installmentAmount, due_on: dueOnIso });
                      installmentsTotal = roundTo(installmentsTotal + installmentAmount, 2);
                    }
                  }

                  if (financedUsd > 0 && Math.abs(installmentsTotal - financedUsd) > 0.01) {
                    window.Swal.showValidationMessage(`La suma de cuotas ($ ${formatNumber(installmentsTotal, 2)}) debe ser igual al saldo financiado ($ ${formatNumber(financedUsd, 2)}).`);
                    return null;
                  }

                  return { initialUsd, installments };
                },
              });

              if (!askInitialResult.isConfirmed) return;

              selectedCasheaContext = {
                enabled: true,
                account_id: casheaAccount.id,
                initial_usd: askInitialResult.value.initialUsd,
                min_purchase_usd: casheaMinPurchaseUsd,
                installments: askInitialResult.value.installments || [],
              };
            }
          }

          const paymentAccounts = allPaymentAccounts.filter((account) => String(account.account_type || '').toLowerCase() !== 'cashea');
          const orderedAccounts = orderAccountsForPaymentModal(paymentAccounts);
          const specialAccounts = orderedAccounts.filter((account) => isSpecialAccount(account));
          const bankAccounts = orderedAccounts.filter((account) => account.is_bank);
          const cashAccounts = orderedAccounts.filter((account) => {
            const type = accountTypeKey(account);
            return !account.is_bank && !isSpecialAccount(account) && type === 'cash_box';
          });
          const typedOtherAccounts = orderedAccounts.filter((account) => {
            const type = accountTypeKey(account);
            return !account.is_bank && !isSpecialAccount(account) && type !== 'cash_box';
          });

          const primaryBankAccount = bankAccounts.find((account) => account.is_primary);
          if (bankAccounts.length > 0 && !primaryBankAccount) {
            window.Swal.fire({
              icon: 'warning',
              title: 'Cuenta bancaria principal requerida',
              text: 'No hay cuentas bancarias establecidas como principal para este negocio, por favor establezca una.',
              heightAuto: false,
            });
            return;
          }

          const padDatePart = (value) => String(value).padStart(2, '0');

          const formatDisplayDate = (date) => {
            if (!(date instanceof Date)) return '';
            return `${padDatePart(date.getDate())}-${padDatePart(date.getMonth() + 1)}-${date.getFullYear()}`;
          };

          const formatIsoDate = (date) => {
            if (!(date instanceof Date)) return '';
            return `${date.getFullYear()}-${padDatePart(date.getMonth() + 1)}-${padDatePart(date.getDate())}`;
          };

          const parsePaymentDateInput = (rawValue) => {
            const normalized = String(rawValue || '').trim();
            if (!normalized) return null;

            const isoMatch = normalized.match(/^(\d{4})-(\d{2})-(\d{2})$/);
            if (isoMatch) {
              const year = Number(isoMatch[1]);
              const month = Number(isoMatch[2]);
              const day = Number(isoMatch[3]);
              const parsedDate = new Date(year, month - 1, day);

              if (
                parsedDate.getFullYear() !== year ||
                parsedDate.getMonth() !== month - 1 ||
                parsedDate.getDate() !== day
              ) {
                return null;
              }

              return parsedDate;
            }

            const displayMatch = normalized.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);
            if (!displayMatch) return null;

            const day = Number(displayMatch[1]);
            const month = Number(displayMatch[2]);
            const year = Number(displayMatch[3]);
            const parsedDate = new Date(year, month - 1, day);

            if (
              parsedDate.getFullYear() !== year ||
              parsedDate.getMonth() !== month - 1 ||
              parsedDate.getDate() !== day
            ) {
              return null;
            }

            return parsedDate;
          };

          const normalizePaymentDateInput = (rawValue) => {
            const parsedDate = parsePaymentDateInput(rawValue);
            if (!parsedDate) return null;

            return {
              date: parsedDate,
              display: formatDisplayDate(parsedDate),
              iso: formatIsoDate(parsedDate),
            };
          };

          const todayPaymentDate = formatDisplayDate(new Date());
          const baseMoneySymbol = baseCurrencyCode === 'VES' ? 'Bs' : '$';

          const capturePaymentModalState = (dialog) => {
            if (!dialog) return null;

            const payments = Array.from(dialog.querySelectorAll('[data-pay-row]')).map((row) => {
              const accountId = row.dataset.payRow;
              return {
                accountId: String(accountId),
                checked: Boolean(row.querySelector(`[data-pay-check="${accountId}"]`)?.checked),
                amount: row.querySelector(`[data-pay-input="${accountId}"]`)?.value || '',
                method: row.querySelector(`[data-pay-bank-method="${accountId}"]`)?.value || '',
                reference: row.querySelector(`[data-pay-reference="${accountId}"]`)?.value || '',
                paymentDate: row.querySelector(`[data-pay-date="${accountId}"]`)?.value || '',
              };
            });

            const changeToggle = dialog.querySelector('[data-change-toggle]');
            const creditToggle = dialog.querySelector('[data-credit-toggle]');
            const creditDueOnInput = dialog.querySelector('[data-credit-due-on]');
            const discountToggle = dialog.querySelector('[data-discount-toggle]');
            const discountAmountInput = dialog.querySelector('[data-discount-amount]');
            const discountReasonSelect = dialog.querySelector('[data-discount-reason]');
            const change = Array.from(dialog.querySelectorAll('[data-change-row]')).map((row) => {
              const accountId = row.dataset.changeRow;
              return {
                accountId: String(accountId),
