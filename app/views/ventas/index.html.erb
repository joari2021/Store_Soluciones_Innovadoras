<% bcv_rate = (@tasa_dolar_bcv || 0).to_d %>
<% product_categories = @product_categories || [] %>
<% service_systems = @service_systems || [] %>
<div id="ventas-pos-root" class="space-y-8" data-bcv-rate="<%= @tasa_dolar_bcv.to_s %>" data-open-shift="<%= @open_cash_shift.present? %>" data-open-shift-id="<%= @open_cash_shift&.id %>" data-products-next-page="<%= @products_next_page %>" data-services-next-page="<%= @services_next_page %>" data-products-catalog-url="<%= catalog_products_ventas_path %>" data-services-catalog-url="<%= catalog_services_ventas_path %>" data-can-charge-sale="<%= @can_charge_sale ? 'true' : 'false' %>" data-can-view-all-drafts="<%= @can_view_all_drafts ? 'true' : 'false' %>" data-current-user-id="<%= Current.user&.id %>" data-active-cashier-id="<%= @active_cashier&.id %>" data-active-cashier-name="<%= @active_cashier&.display_name.to_s %>" data-active-cashier-role-label="<%= @active_cashier&.role_label.to_s %>">
  <script>
    (() => {
      const initVentasOpenShiftCTA = () => {
        const trigger = document.getElementById('ventas-open-cash-shift-trigger');
        if (!trigger || trigger.dataset.boundOpenModal === 'true') return;

        trigger.dataset.boundOpenModal = 'true';

        const escapeHtml = (value) => String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');

        const formatAmount = (value, symbol) => {
          const parsed = Number(value || 0);
          const amount = Number.isFinite(parsed)
            ? parsed.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
            : '0,00';
          return `${symbol || ''} ${amount}`.trim();
        };

        const formatDateLabel = (rawDate) => {
          const text = String(rawDate || '').trim();
          if (!text) return 'Sin fecha';

          const matchIso = text.match(/^(\d{4})-(\d{2})-(\d{2})/);
          if (matchIso) return `${matchIso[3]}-${matchIso[2]}-${matchIso[1]}`;

          const parsed = new Date(text);
          if (Number.isNaN(parsed.getTime())) return text;

          const day = String(parsed.getDate()).padStart(2, '0');
          const month = String(parsed.getMonth() + 1).padStart(2, '0');
          const year = String(parsed.getFullYear());
          return `${day}-${month}-${year}`;
        };

        let openingBalances = [];
        try {
          openingBalances = JSON.parse(String(trigger.dataset.openingBalances || '[]'));
        } catch (_error) {
          openingBalances = [];
        }
        if (!Array.isArray(openingBalances)) openingBalances = [];

        const lastClosedShiftUrl = String(trigger.dataset.lastClosedShiftUrl || '').trim();

        const requestOpeningBalancesConfirmation = async () => {
          const rowsHtml = openingBalances.map((row) => {
            const label = escapeHtml(String(row?.label || ''));
            const symbol = escapeHtml(String(row?.currency_symbol || ''));
            const amount = escapeHtml(formatAmount(row?.balance, symbol));
            return `
              <tr>
                <td class="px-3 py-2 text-sm font-semibold text-slate-700">${label}</td>
                <td class="px-3 py-2 text-right text-sm font-bold text-slate-800">${amount}</td>
              </tr>
            `;
          }).join('');

          if (window.Swal) {
            const result = await window.Swal.fire({
              title: 'Verifica saldos antes de abrir turno',
              html: `
                <div class="text-left">
                  <div class="overflow-hidden rounded-xl border border-slate-200">
                    <table class="min-w-full bg-white">
                      <tbody class="divide-y divide-slate-100">${rowsHtml}</tbody>
                    </table>
                  </div>
                  <p class="mt-3 text-xs text-slate-600">Rectifica los saldos que son los indicados antes de continuar si vez alguna diferenccia comunicarse con el encargado que cerro el turno anterior.</p>
                </div>
              `,
              confirmButtonText: 'Si, confirmo que son los montos correctos',
              showCancelButton: true,
              cancelButtonText: 'Cancelar',
              showDenyButton: Boolean(lastClosedShiftUrl),
              denyButtonText: 'Ver ultimo turno',
              heightAuto: false,
            });

            if (result.isDenied && lastClosedShiftUrl) {
              window.location.href = lastClosedShiftUrl;
              return false;
            }

            return Boolean(result.isConfirmed);
          }

          return window.confirm('Rectifica los saldos antes de continuar y confirma solo si son correctos.');
        };

        const buildRatesHtml = (snapshot) => {
          const safeSnapshot = snapshot && typeof snapshot === 'object' ? snapshot : {};
          const bcvRates = Array.isArray(safeSnapshot.bcv_rates) ? safeSnapshot.bcv_rates : [];
          const otherRates = Array.isArray(safeSnapshot.other_rates) ? safeSnapshot.other_rates : [];

          const bcvSection = bcvRates.length > 0
            ? `
              <div class="mt-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-left">
                <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Tasas BCV activas</p>
                <ul class="mt-2 space-y-1 text-xs text-slate-700">
                  ${bcvRates.map((rate) => {
                    const label = escapeHtml(rate.description || 'Tasa BCV');
                    const amount = escapeHtml(formatAmount(rate.value, rate.symbol || ''));
                    const referenceDate = escapeHtml(formatDateLabel(rate.fecha_referencia));
                    return `<li><strong>${label}:</strong> ${amount} <span class="text-slate-500">(ref. ${referenceDate})</span></li>`;
                  }).join('')}
                </ul>
              </div>
            `
            : '';

          const otherSection = otherRates.length > 0
            ? `
              <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-3 text-left">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Otras tasas</p>
                <ul class="mt-2 max-h-44 space-y-1 overflow-y-auto pr-1 text-xs text-slate-700">
                  ${otherRates.map((rate) => {
                    const label = escapeHtml(rate.description || 'Tasa');
                    const amount = escapeHtml(formatAmount(rate.value, rate.symbol || ''));
                    const updatedDate = escapeHtml(formatDateLabel(rate.updated_at));
                    return `<li><strong>${label}:</strong> ${amount} <span class="text-slate-500">(act. ${updatedDate})</span></li>`;
                  }).join('')}
                </ul>
              </div>
            `
            : '';

          return `${bcvSection}${otherSection}`;
        };

        const extractShiftIdFromUrl = (url) => {
          const match = String(url || '').match(/\/cash_shifts\/(\d+)/);
          return match ? match[1] : '';
        };

        const promoteOpenShiftCTA = (shiftUrl, shiftIdValue = '') => {
          if (!shiftUrl || !trigger) return;

          const shiftId = String(shiftIdValue || extractShiftIdFromUrl(shiftUrl)).trim();
          const link = document.createElement('a');
          link.href = shiftUrl;
          link.className = 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-emerald-100';
          link.innerHTML = `<i data-lucide="clock-3" class="h-4 w-4"></i> ${shiftId ? `Turno #${escapeHtml(shiftId)} abierto` : 'Turno abierto'}`;

          trigger.replaceWith(link);
          if (window.lucide?.createIcons) {
            window.lucide.createIcons();
          }
        };

        const openShift = async () => {
          const balancesConfirmed = await requestOpeningBalancesConfirmation();
          if (!balancesConfirmed) return;

          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
          if (!csrfToken) {
            if (window.Swal) {
              window.Swal.fire({
                icon: 'error',
                title: 'Token CSRF no disponible',
                text: 'Recarga la pagina e intenta de nuevo.',
                heightAuto: false,
              });
            }
            return;
          }

          if (window.Swal) {
            window.Swal.fire({
              title: 'Actualizando tasas BCV',
              html: '<p class="text-sm text-slate-600">Espere un momento, se estan actualizando las tasas.</p>',
              allowOutsideClick: false,
              allowEscapeKey: false,
              showConfirmButton: false,
              heightAuto: false,
              didOpen: () => {
                window.Swal.showLoading();
              },
            });
          } else if (!window.confirm('Se actualizaran las tasas BCV y luego se abrira el turno. Deseas continuar?')) {
            return;
          }

          try {
            const response = await fetch(trigger.dataset.createUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
                'X-CSRF-Token': csrfToken,
              },
              credentials: 'same-origin',
              body: JSON.stringify({}),
            });

            const data = await response.json().catch(() => ({}));
            const cashShiftUrl = String(data.cash_shift_url || '').trim();
            const cashShiftId = String(data.cash_shift_id || '').trim();

            if (!response.ok || !data.success) {
              const existingOpenShift = /ya existe un turno abierto/i.test(String(data.error || ''));
              if (existingOpenShift) {
                if (window.Swal) {
                  const existingResult = await window.Swal.fire({
                    icon: 'info',
                    title: 'Ya hay un turno abierto',
                    text: 'Puedes seguir facturando o abrir el detalle del turno activo.',
                    confirmButtonText: 'Ver turno',
                    showCancelButton: true,
                    cancelButtonText: 'Cerrar',
                    heightAuto: false,
                  });

                  if (existingResult.isConfirmed && cashShiftUrl) {
                    window.location.href = cashShiftUrl;
                    return;
                  }

                  if (cashShiftUrl) {
                    promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
                  }
                  return;
                }

                if (window.confirm('Ya hay un turno abierto. Deseas ver su detalle?')) {
                  if (cashShiftUrl) {
                    window.location.href = cashShiftUrl;
                  }
                  return;
                }

                if (cashShiftUrl) {
                  promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
                }
                return;
              }

              throw new Error(String(data.error || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.'));
            }

            const scraperStatus = String(data.scraper_status || '').trim();
            const resultText = scraperStatus === 'up_to_date'
              ? 'Las tasas ya estan actualizadas y el turno se abrio correctamente.'
              : 'Las tasas han sido actualizadas y el turno se abrio correctamente.';
            const ratesHtml = buildRatesHtml(data.rates_snapshot);

            if (window.Swal) {
              const result = await window.Swal.fire({
                icon: 'success',
                title: 'Turno abierto',
                html: `<p class="text-sm text-slate-600">${escapeHtml(resultText)}</p>${ratesHtml}`,
                confirmButtonText: 'Ver turno',
                showCancelButton: true,
                cancelButtonText: 'Cerrar',
                heightAuto: false,
              });

              if (result.isConfirmed && cashShiftUrl) {
                window.location.href = cashShiftUrl;
                return;
              }

              if (cashShiftUrl) {
                promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
              }
              return;
            }

            if (window.confirm(`${resultText}\n\nDeseas ver el turno abierto ahora?`)) {
              if (cashShiftUrl) {
                window.location.href = cashShiftUrl;
              }
              return;
            }

            if (cashShiftUrl) {
              promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
            }
          } catch (error) {
            if (window.Swal) {
              await window.Swal.fire({
                icon: 'error',
                title: 'No se pudo abrir el turno',
                text: error.message || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.',
                heightAuto: false,
              });
            } else {
              window.alert(error.message || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.');
            }
          }
        };

        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          openShift();
        });
      };

      document.addEventListener('turbo:load', initVentasOpenShiftCTA);
      document.addEventListener('DOMContentLoaded', initVentasOpenShiftCTA);
    })();
  </script>
  <script type="application/json" id="ventas-products-data">
    <%= raw ERB::Util.json_escape(@products_payload.to_json) %>
  </script>
  <script type="application/json" id="ventas-accounts-data">
    <%= raw ERB::Util.json_escape(@accounts_payload.to_json) %>
  </script>
  <script type="application/json" id="ventas-cash-boxes-data">
    <%= raw ERB::Util.json_escape(@cash_box_accounts_payload.to_json) %>
  </script>
  <script type="application/json" id="ventas-drafts-data">
    <%= raw ERB::Util.json_escape(@drafts_payload.to_json) %>
  </script>
  <script type="application/json" id="ventas-services-data">
    <%= raw ERB::Util.json_escape(@services_payload.to_json) %>
  </script>
  <section id="tab-ventas" class="fade-in">
    <div class="space-y-6 h-full">
      <div class="rounded-3xl border border-slate-200 bg-white/95 p-4 shadow-sm sm:p-5">
        <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
          <div class="w-full max-w-xl">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Explorador de venta</p>
            <div class="relative mt-2 flex-1">
              <input id="ventas-item-search" type="text" placeholder="Buscar productos o servicios" class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 px-4 py-3 pr-11 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:bg-white focus:ring-sky-500">
              <button id="ventas-item-search-clear" type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 h-7 w-7 rounded-full bg-slate-100 p-0 text-center leading-none text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-700" aria-label="Limpiar busqueda">
                <i data-lucide="x" class="pointer-events-none absolute left-[54%] top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2"></i>
              </button>
            </div>
          </div>
          <div class="flex flex-col gap-3 xl:items-end">
            <div class="flex flex-wrap items-center gap-2">
              <button id="ventas-cash-exchange-button" type="button" class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 shadow-sm transition-colors hover:bg-emerald-100">
                <i data-lucide="repeat" class="h-4 w-4"></i>
                Pasarela de cambios
              </button>
              <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 p-1.5 shadow-inner shadow-slate-100">
                <button type="button" data-ventas-tab="products" class="ventas-tab rounded-full border border-sky-600 bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-sky-200">Productos</button>
                <button type="button" data-ventas-tab="services" class="ventas-tab rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600">Servicios</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="ventas-product-panel" class="space-y-4 rounded-3xl border border-slate-200 bg-white/95 p-4 shadow-sm sm:p-5">
        <% if @productos.any? %>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Cat&aacute;logo de productos</p>
              <h2 class="mt-1 text-lg font-bold text-slate-800">Selecciona productos para sumarlos a la orden</h2>
            </div>
            <span class="inline-flex items-center gap-2 rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700 ring-1 ring-sky-100">
              <i data-lucide="boxes" class="h-3.5 w-3.5"></i>
              <%= @productos_total_count %> disponibles
            </span>
          </div>
          <% if product_categories.any? %>
            <div class="rounded-2xl border border-cyan-100 bg-cyan-50/60 p-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Categorias activas</p>
              <div class="mt-2 flex flex-wrap gap-2">
                <button type="button" data-product-category-filter="" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-sky-600 bg-sky-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">
                  <span>Todas</span>
                  <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-white/20 px-1.5 py-0.5 text-[11px] font-bold text-white"><%= @productos_total_count %></span>
                </button>
                <% product_categories.each do |nombre_categoria, cantidad_items| %>
                  <button type="button" data-product-category-filter="<%= nombre_categoria %>" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-cyan-200 bg-white px-3 py-1 text-xs font-semibold text-cyan-700 ring-1 ring-cyan-200 transition-colors hover:bg-cyan-50">
                    <span class="max-w-[10rem] truncate"><%= nombre_categoria %></span>
                    <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-cyan-100 px-1.5 py-0.5 text-[11px] font-bold text-cyan-700"><%= cantidad_items %></span>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
          <div id="ventas-product-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4">
            <%= render partial: 'ventas/catalog_product_card', collection: @productos, as: :producto, locals: { products_payload_by_id: @products_payload_by_id, bcv_rate: bcv_rate } %>
          </div>
          <div id="ventas-products-no-results" class="hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50/80 p-5 text-center">
            <p class="text-sm font-semibold text-slate-700">No se encontro ese producto registrado.</p>
            <p class="mt-1 text-xs text-slate-500">Prueba con otro nombre o revisa la ortografia.</p>
          </div>
          <div id="ventas-products-infinite-sentinel" class="mt-4 flex justify-center <%= @products_next_page.present? ? '' : 'hidden' %>">
            <div class="inline-flex items-center gap-2 rounded-2xl border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 shadow-sm">
              <span class="inline-block h-2.5 w-2.5 animate-pulse rounded-full bg-sky-400"></span>
              Cargando m&aacute;s productos...
            </div>
          </div>
        <% else %>
          <div class="rounded-3xl border border-dashed border-sky-200 bg-gradient-to-br from-white to-sky-50 p-10 text-center shadow-sm">
            <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-100 text-sky-600">
              <i data-lucide="package" class="h-6 w-6"></i>
            </div>
            <h3 class="text-base font-semibold text-slate-700">No hay productos disponibles</h3>
            <p class="mt-1 text-sm text-slate-500">Agrega productos para comenzar a vender.</p>
          </div>
        <% end %>
      </div>
      <div id="ventas-service-panel" class="space-y-4 hidden rounded-3xl border border-slate-200 bg-white/95 p-4 shadow-sm sm:p-5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Cat&aacute;logo de servicios</p>
            <h2 class="mt-1 text-lg font-bold text-slate-800">Activa servicios y precios especiales desde el mismo POS</h2>
          </div>
          <span class="inline-flex items-center gap-2 rounded-full bg-cyan-50 px-3 py-1 text-xs font-semibold text-cyan-700 ring-1 ring-cyan-100">
            <i data-lucide="briefcase-business" class="h-3.5 w-3.5"></i>
            <%= @services_total_count %> disponibles
          </span>
        </div>
        <% if service_systems.any? %>
          <div class="rounded-2xl border border-cyan-100 bg-cyan-50/60 p-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Sistemas de servicios</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <button type="button" data-service-system-filter="" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-sky-600 bg-sky-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">
                <span>Todos</span>
                <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-white/20 px-1.5 py-0.5 text-[11px] font-bold text-white"><%= @services_total_count %></span>
              </button>
              <% service_systems.each do |nombre_sistema, cantidad_items| %>
                <button type="button" data-service-system-filter="<%= nombre_sistema %>" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-cyan-200 bg-white px-3 py-1 text-xs font-semibold text-cyan-700 ring-1 ring-cyan-200 transition-colors hover:bg-cyan-50">
                  <span class="max-w-[10rem] truncate"><%= nombre_sistema %></span>
                  <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-cyan-100 px-1.5 py-0.5 text-[11px] font-bold text-cyan-700"><%= cantidad_items %></span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
        <div id="ventas-service-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-4">
          <% if @services_preloaded %>
            <% if @services.any? %>
              <%= render partial: 'ventas/catalog_service_card', collection: @services, as: :service, locals: { services_payload_by_id: @services_payload_by_id, bcv_rate: bcv_rate, unidad_vi: @unidad_VI } %>
            <% else %>
              <div class="col-span-full rounded-3xl border border-dashed border-cyan-200 bg-gradient-to-br from-white to-cyan-50 p-10 text-center shadow-sm">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-600">
                  <i data-lucide="briefcase" class="h-6 w-6"></i>
                </div>
                <h3 class="text-base font-semibold text-slate-700">No hay servicios disponibles</h3>
                <p class="mt-1 text-sm text-slate-500">Registra servicios para facturarlos desde ventas.</p>
              </div>
            <% end %>
          <% else %>
            <div class="col-span-full rounded-3xl border border-cyan-100 bg-cyan-50/60 p-10 text-center shadow-sm" data-services-placeholder>
              <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-600">
                <i data-lucide="loader-2" class="h-6 w-6 animate-spin"></i>
              </div>
              <h3 class="text-base font-semibold text-slate-700">Cargando servicios...</h3>
              <p class="mt-1 text-sm text-slate-500">Preparando el cat&aacute;logo para mostrarlo.</p>
            </div>
          <% end %>
        </div>
        <div id="ventas-services-no-results" class="hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50/80 p-5 text-center">
          <p class="text-sm font-semibold text-slate-700">No se encontro ese servicio registrado.</p>
          <p class="mt-1 text-xs text-slate-500">Prueba con otro nombre o revisa la ortografia.</p>
        </div>
        <div id="ventas-services-infinite-sentinel" class="mt-4 flex justify-center <%= @services_next_page.present? ? '' : 'hidden' %>">
          <div class="inline-flex items-center gap-2 rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-2 text-sm font-semibold text-cyan-700 shadow-sm">
