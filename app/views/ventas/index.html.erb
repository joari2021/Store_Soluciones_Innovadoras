        <button id="ventas-pay-button" type="button" class="ventas-theme-pay-button mt-5 flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-slate-900 to-sky-700 px-4 py-4 font-bold text-white shadow-xl shadow-sky-200 transition-all hover:from-slate-800 hover:to-sky-600 active:scale-[0.98]">
