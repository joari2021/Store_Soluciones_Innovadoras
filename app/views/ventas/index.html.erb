      const vatRate = 0.16;
      const paymentTolerance = 0.01;
      let selectedClient = null;
      let activeDraftId = null;
      let activeDraftCreatedById = null;
      let activeDraftVisibility = null;
      let activeDraftCheckoutStatus = null;
      let draftListFilter = 'pending';
