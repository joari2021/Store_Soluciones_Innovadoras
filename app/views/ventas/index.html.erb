                    `;

                  list.appendChild(item);
                  initMoneyMasks(item);
                  if (typeof window.initializeMaterializeDatepickers === 'function') {
                    window.initializeMaterializeDatepickers(item);
                  }

                  const amountInput = item.querySelector('[data-pay-multi-amount]');
                  const methodSelect = item.querySelector('[data-pay-multi-method]');
                  const dateInput = item.querySelector('[data-pay-multi-date]');
                  const referenceInput = item.querySelector('[data-pay-multi-reference]');
                  const removeButton = item.querySelector('[data-pay-multi-remove]');

                  amountInput?.addEventListener('input', updateRemaining);
                  methodSelect?.addEventListener('change', updateRemaining);
                  dateInput?.addEventListener('change', () => {
                    const normalized = normalizePaymentDateInput(dateInput.value);
                    dateInput.value = normalized ? normalized.display : '';
                    updateRemaining();
                  });
                  referenceInput?.addEventListener('input', updateRemaining);
                  removeButton?.addEventListener('click', () => {
                    item.remove();
                    updateRemaining();
                  });

                  if (entry) {
                    if (typeof entry.amount === 'string' && amountInput) amountInput.value = entry.amount;
                    if (typeof entry.method === 'string' && methodSelect) methodSelect.value = entry.method;
                    if (typeof entry.paymentDate === 'string' && dateInput) {
                      const normalized = normalizePaymentDateInput(entry.paymentDate);
                      dateInput.value = normalized ? normalized.display : '';
                    }
                    if (typeof entry.reference === 'string' && referenceInput) referenceInput.value = entry.reference;
                  }
                };

                const changeSection = dialog.querySelector('#ventas-change-section');
                const changeToggle = dialog.querySelector('[data-change-toggle]');
                const changeRowsContainer = dialog.querySelector('[data-change-rows]');
                const changeHintEl = dialog.querySelector('[data-change-hint]');
                const creditToggle = dialog.querySelector('[data-credit-toggle]');
                const creditFields = dialog.querySelector('[data-credit-fields]');
                const creditDueOnInput = dialog.querySelector('[data-credit-due-on]');
                const discountToggle = dialog.querySelector('[data-discount-toggle]');
                const discountFields = dialog.querySelector('[data-discount-fields]');
                const discountAmountInput = dialog.querySelector('[data-discount-amount]');
                const discountReasonSelect = dialog.querySelector('[data-discount-reason]');

                const syncMethodSelectTone = (select) => {
                  if (!select) return;

                  if (select.disabled) {
                    select.classList.add('text-slate-400');
                    select.classList.remove('text-slate-700');
                    select.style.color = '#94a3b8';
                    return;
                  }

                  const isPlaceholderSelected = String(select.value || '').trim() === '';

                  select.classList.toggle('text-slate-400', isPlaceholderSelected);
                  select.classList.toggle('text-slate-700', !isPlaceholderSelected);
                  select.style.color = isPlaceholderSelected ? '#94a3b8' : '#334155';
                };

                const syncPaymentRowMethodTone = (row) => {
                  if (!row) return;

                  const accountId = row.dataset.payRow;
                  if (!accountId) return;

                  const methodSelect = row.querySelector(`[data-pay-bank-method="${accountId}"]`);
                  const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                  if (!methodSelect || !checkbox) return;

                  const hasMethod = String(methodSelect.value || '').trim().length > 0;
                  const shouldToneDown = checkbox.checked && !hasMethod;

                  row.querySelectorAll('[data-pay-account-label]').forEach((el) => {
                    el.classList.toggle('is-muted', shouldToneDown);
                  });
                };

                const setPaymentAccordionState = (row, open) => {
                  if (!row) return;
                  row.classList.toggle('is-open', open);
                  const content = row.querySelector('[data-pay-content]');
                  if (!content) return;
                  if (open) {
                    content.style.maxHeight = `${content.scrollHeight}px`;
                  } else {
                    content.style.maxHeight = '0px';
                  }
                };

                const setChangeAccordionState = (row, open) => {
                  if (!row) return;
                  row.classList.toggle('is-open', open);
                  const content = row.querySelector('[data-change-content]');
                  if (!content) return;
                  if (open) {
                    content.style.maxHeight = `${content.scrollHeight}px`;
                  } else {
                    content.style.maxHeight = '0px';
                  }
                };

                const setRowVisualState = (row, enabled, tone = 'sky') => {
                  if (!row) return;

                  row.classList.toggle('ventas-payment-row-active', enabled);
                  row.classList.toggle('ventas-payment-row-inactive', !enabled);

                  if (tone === 'amber') {
                    row.classList.toggle('border-amber-300', enabled);
                    row.classList.toggle('bg-amber-50', enabled);
                    row.classList.toggle('ring-1', enabled);
                    row.classList.toggle('ring-amber-200', enabled);
                    row.classList.remove('border-sky-300', 'bg-sky-50', 'ring-sky-200');
                  } else {
                    row.classList.toggle('border-sky-300', enabled);
                    row.classList.toggle('bg-sky-50', enabled);
                    row.classList.toggle('ring-1', enabled);
                    row.classList.toggle('ring-sky-200', enabled);
                    row.classList.remove('border-amber-300', 'bg-amber-50', 'ring-amber-200');
                  }
                };

                const setFieldEnabledState = (field, enabled, tone = 'sky') => {
                  if (!field) return;

                  const isPayDateField = field.matches('input[data-pay-date]');

                  field.disabled = !enabled;
                  if (!enabled) field.value = '';
                  if (!enabled) field.blur();
                  if (enabled && isPayDateField && String(field.value || '').trim() === '') {
                    field.value = todayPaymentDate;
                  }

                  field.classList.remove(
                    'border-sky-300',
                    'border-amber-300',
                    'border-transparent',
                    'ring-2',
                    'ring-sky-100',
                    'ring-amber-100',
                    'bg-white',
                    'ventas-payment-modal-field-active',
                    'ventas-payment-modal-field-active-sky',
                    'ventas-payment-modal-field-active-amber',
                    'ventas-payment-modal-field-disabled',
                  );

                  if (enabled) {
                    field.classList.add('bg-white', 'ventas-payment-modal-field-active');
                    if (tone === 'amber') {
                      field.classList.add('ventas-payment-modal-field-active-amber');
                    } else {
                      field.classList.add('ventas-payment-modal-field-active-sky');
                    }
                  } else {
                    field.classList.add('border-transparent', 'ventas-payment-modal-field-disabled');
                  }
                };

                const setBankFieldsEnabled = (container, enabled, tone) => {
                  if (!container) return;
                  container.querySelectorAll('select, input').forEach((field) => {
                    setFieldEnabledState(field, enabled, tone);
                    if (field.matches('select[data-bank-method-select]')) {
                      syncMethodSelectTone(field);
                    }
                  });
                };

                const toggleChangeSection = (visible) => {
                  if (!changeSection) return;
                  changeSection.classList.toggle('hidden', !visible);
                };

                const resetChangeRow = (row) => {
                  const accountId = row.dataset.changeRow;
                  const checkbox = row.querySelector(`[data-change-check="${accountId}"]`);
                  const input = row.querySelector(`[data-change-input="${accountId}"]`);
                  const bankFields = row.querySelector(`[data-change-bank-fields="${accountId}"]`);
                  const equivalentEl = row.querySelector(`[data-change-equivalent="${accountId}"]`);

                  if (checkbox) checkbox.checked = false;
                  setFieldEnabledState(input, false, 'amber');
                  setBankFieldsEnabled(bankFields, false, 'amber');
                  setRowVisualState(row, false, 'amber');
                  setChangeAccordionState(row, false);
                  if (equivalentEl) equivalentEl.textContent = '';
                };

                const setChangeRowsEnabled = (enabled) => {
                  if (!changeRowsContainer) return;
                  changeRowsContainer.classList.toggle('hidden', !enabled);
                  if (!enabled) {
                    changeRowsContainer.querySelectorAll('[data-change-row]').forEach((row) => {
                      resetChangeRow(row);
                    });
                  }
                };

                const setCreditFieldsEnabled = (enabled) => {
                  if (creditFields) {
                    creditFields.classList.toggle('hidden', !enabled);
                  }

                  if (creditDueOnInput) {
                    setFieldEnabledState(creditDueOnInput, enabled, 'sky');
                  }
                };

                const setDiscountFieldsEnabled = (enabled) => {
                  if (discountFields) {
                    discountFields.classList.toggle('opacity-70', !enabled);
                  }

                  if (discountAmountInput) {
                    setFieldEnabledState(discountAmountInput, enabled, 'sky');
                  }

                  if (discountReasonSelect) {
                    setFieldEnabledState(discountReasonSelect, enabled, 'sky');
                  }
                };


                const updateRemaining = () => {
                let paidBase = 0;
                let paidAlt = 0;
                const altCurrencyCode = baseCurrencyCode === 'USD' ? 'VES' : 'USD';
                const altAvailable = bcvRate > 0;
                  const discountEnabled = Boolean(discountToggle?.checked);
                  const discountAmount = discountEnabled ? parseMoneyInput(discountAmountInput) : 0;
                  const sanitizedDiscountBase = Math.min(Math.max(discountAmount, 0), totalBase);
                  const effectiveTotalBase = roundTo(Math.max(totalBase - sanitizedDiscountBase, 0), 2);
                dialog.querySelectorAll('[data-pay-row]').forEach((row) => {
                  const accountId = row.dataset.payRow;
                  const account = accountsById.get(String(accountId));
                  if (!account) return;

                  const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                  const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                  const equivalentEl = row.querySelector(`[data-pay-equivalent="${accountId}"]`);
                  const amount = parseMoneyInput(input);

                  if (!checkbox?.checked || amount <= 0) {
                    if (equivalentEl) equivalentEl.textContent = '';
                    return;
                  }

                  const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                  if (baseAmount === null) {
                    if (equivalentEl) {
                      equivalentEl.textContent = 'Sin tasa de conversion';
                      equivalentEl.classList.add('text-red-500');
                    }
                    return;
                  }

                  if (equivalentEl) {
                    equivalentEl.textContent = `Equiv: ${formatBaseMoney(baseAmount)}`;
                    equivalentEl.classList.remove('text-red-500');
                  }
                  paidBase += baseAmount;

                  if (altAvailable) {
                    const altAmount = convertAmount(amount, account.currency, altCurrencyCode);
                    if (altAmount !== null) {
                      paidAlt += altAmount;
                    }
                  }

                  row.querySelectorAll(`[data-pay-multi-entry="${accountId}"]`).forEach((entry) => {
                    const extraAmount = parseMoneyInput(entry.querySelector('[data-pay-multi-amount]'));
                    if (extraAmount <= 0) return;

                    const extraBaseAmount = convertAmount(extraAmount, account.currency, baseCurrencyCode);
                    if (extraBaseAmount === null) return;
                    paidBase += extraBaseAmount;

                    if (altAvailable) {
                      const extraAltAmount = convertAmount(extraAmount, account.currency, altCurrencyCode);
                      if (extraAltAmount !== null) paidAlt += extraAltAmount;
                    }
                  });
                });

                let remaining = roundTo(effectiveTotalBase - paidBase, 2);
                if (Math.abs(remaining) <= paymentTolerance) remaining = 0;

                let remainingAlt = null;
                if (altAvailable) {
                  const totalAlt = convertAmount(effectiveTotalBase, baseCurrencyCode, altCurrencyCode);
                  if (totalAlt !== null) {
                    remainingAlt = roundTo(totalAlt - paidAlt, 2);
                  }
                }

                const remainingEl = popup?.querySelector('#ventas-pay-remaining');
                const remainingAltEl = popup?.querySelector('#ventas-pay-remaining-alt');
                if (!remainingEl) return;

                const remainingAbs = Math.abs(remaining);
                const remainingAltAbs = remainingAlt !== null ? Math.abs(remainingAlt) : 0;
                const altTolerance = 0.02;

                const changeDueBase = remaining < -paymentTolerance ? remainingAbs : 0;
                const changeDueAlt = remainingAlt !== null && remainingAlt < -altTolerance ? remainingAltAbs : 0;
                const shouldShowChange = changeDueBase > 0 || changeDueAlt > 0;

                let assignedChangeBase = 0;
                let assignedChangeAlt = 0;
                if (changeToggle?.checked) {
                  dialog.querySelectorAll('[data-change-row]').forEach((row) => {
                    const accountId = row.dataset.changeRow;
                    const account = accountsById.get(String(accountId));
                    if (!account) return;

                    const checkbox = row.querySelector(`[data-change-check="${accountId}"]`);
                    const input = row.querySelector(`[data-change-input="${accountId}"]`);
                    const equivalentEl = row.querySelector(`[data-change-equivalent="${accountId}"]`);
                    const amount = parseMoneyInput(input);

                    if (!checkbox?.checked || amount <= 0) {
                      if (equivalentEl) equivalentEl.textContent = '';
                      return;
                    }

                    const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                    if (baseAmount === null) {
                      if (equivalentEl) {
                        equivalentEl.textContent = 'Sin tasa de conversion';
                        equivalentEl.classList.add('text-red-500');
                      }
                      return;
                    }

                    assignedChangeBase += baseAmount;
                    if (altAvailable) {
                      const altAmount = convertAmount(amount, account.currency, altCurrencyCode);
                      if (altAmount !== null) assignedChangeAlt += altAmount;
                    }

                    if (equivalentEl) {
                      equivalentEl.textContent = `Equiv: ${formatBaseMoney(baseAmount)}`;
                      equivalentEl.classList.remove('text-red-500');
                    }
                  });
                }

                let remainingDisplay = roundTo(remaining + assignedChangeBase, 2);
                if (Math.abs(remainingDisplay) <= paymentTolerance) remainingDisplay = 0;

                let remainingAltDisplay = null;
                if (remainingAlt !== null) {
                  remainingAltDisplay = roundTo(remainingAlt + assignedChangeAlt, 2);
                  if (Math.abs(remainingAltDisplay) <= altTolerance) remainingAltDisplay = 0;
                }

                const remainingDisplayAbs = Math.abs(remainingDisplay);
                const remainingAltDisplayAbs = remainingAltDisplay !== null ? Math.abs(remainingAltDisplay) : 0;
                const changePendingBase = remainingDisplay < -paymentTolerance ? remainingDisplayAbs : 0;
                const changePendingAlt = remainingAltDisplay !== null && remainingAltDisplay < -altTolerance ? remainingAltDisplayAbs : 0;

                if (changeSection) {
                  toggleChangeSection(shouldShowChange);
                  if (!shouldShowChange) {
                    if (changeToggle) changeToggle.checked = false;
                    setChangeRowsEnabled(false);
                  }
                }

                if (changeHintEl) {
                  if (shouldShowChange) {
                    const hints = [];
                    if (changePendingBase > 0) hints.push(formatBaseMoney(changePendingBase));
                    if (changePendingAlt > 0 && altAvailable) hints.push(formatCurrencyValue(changePendingAlt, altCurrencyCode));
                    changeHintEl.textContent = hints.length ? `Sugerido: ${hints.join(' · ')}` : '';
                  } else {
                    changeHintEl.textContent = '';
                  }
                }

                if (remainingDisplay > paymentTolerance) {
                  remainingEl.textContent = `Faltan ${formatBaseMoney(remainingDisplay)}`;
                  remainingEl.classList.remove('text-emerald-600');
                  remainingEl.classList.add('text-amber-600');
                } else if (remainingDisplay < -paymentTolerance) {
                  remainingEl.textContent = `Vuelto ${formatBaseMoney(remainingDisplayAbs)}`;
                  remainingEl.classList.remove('text-amber-600');
                  remainingEl.classList.add('text-emerald-600');
                } else {
                  remainingEl.textContent = 'Completo';
                  remainingEl.classList.remove('text-amber-600');
                  remainingEl.classList.add('text-emerald-600');
                }

                if (remainingAltEl) {
                  if (!altAvailable || remainingAltDisplay === null) {
                    remainingAltEl.textContent = '--';
                  } else if (remainingAltDisplay > altTolerance) {
                    remainingAltEl.textContent = `Faltan ${formatCurrencyValue(remainingAltDisplayAbs, altCurrencyCode)}`;
                  } else if (remainingAltDisplay < -altTolerance) {
                    remainingAltEl.textContent = `Vuelto ${formatCurrencyValue(remainingAltDisplayAbs, altCurrencyCode)}`;
                  } else {
                    remainingAltEl.textContent = formatCurrencyValue(0, altCurrencyCode);
                  }
                }
              };

                const toggleBankButton = dialog.querySelector('[data-toggle-bank-accounts]');
                const extraBankRows = Array.from(dialog.querySelectorAll('[data-bank-extra="true"]'));
                let expanded = Boolean(initialState?.showExtraBankAccounts);

                const resetExtraBankRow = (row) => {
                  const accountId = row.dataset.payRow;
                  const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                  const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                  const bankFields = row.querySelector(`[data-pay-bank-fields="${accountId}"]`);
                  const equivalentEl = row.querySelector(`[data-pay-equivalent="${accountId}"]`);

                  if (checkbox) checkbox.checked = false;
                  setFieldEnabledState(input, false, 'sky');
                  setBankFieldsEnabled(bankFields, false, 'sky');
                  setRowVisualState(row, false, 'sky');
                  if (equivalentEl) equivalentEl.textContent = '';
                  syncPaymentRowMethodTone(row);
                };

                if (toggleBankButton && extraBankRows.length > 0) {
                  const syncExtraBankRows = (resetWhenHidden = true) => {
                    extraBankRows.forEach((row) => {
                      row.classList.toggle('hidden', !expanded);
                      if (!expanded && resetWhenHidden) resetExtraBankRow(row);
                    });
                    toggleBankButton.textContent = expanded ? 'Ocultar cuentas' : 'Ver mas cuentas';
                  };

                  toggleBankButton.addEventListener('click', () => {
                    expanded = !expanded;
                    syncExtraBankRows();
                    updateRemaining();
                  });

                  syncExtraBankRows(!initialState || !expanded);
                }

                if (changeToggle) {
                  changeToggle.addEventListener('change', () => {
                    setChangeRowsEnabled(changeToggle.checked);
                    updateRemaining();
                  });
                }

                if (creditToggle) {
                  creditToggle.addEventListener('change', () => {
                    setCreditFieldsEnabled(creditToggle.checked);
                    updateRemaining();
                  });
                }

                if (discountToggle) {
                  discountToggle.addEventListener('change', () => {
                    setDiscountFieldsEnabled(discountToggle.checked);
                    updateRemaining();
                  });
                }

                if (discountAmountInput) {
                  discountAmountInput.addEventListener('input', updateRemaining);
                }

                if (discountReasonSelect) {
                  discountReasonSelect.addEventListener('change', updateRemaining);
                }

                const rowHasPaymentData = (row) => {
                  if (!row) return false;
                  const accountId = row.dataset.payRow;
                  if (!accountId) return false;

                  const amountInput = row.querySelector(`[data-pay-input="${accountId}"]`);
                  return parseMoneyInput(amountInput) > 0;
                };

                const closeOtherPaymentRows = (currentRow) => {
                  dialog.querySelectorAll('[data-pay-row]').forEach((row) => {
                    if (row === currentRow) return;
                    if (rowHasPaymentData(row)) return;

                    const accountId = row.dataset.payRow;
                    const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                    if (checkbox?.checked) {
                      checkbox.checked = false;
                      checkbox.dispatchEvent(new Event('change'));
                      return;
                    }

                    setPaymentAccordionState(row, false);
                    setRowVisualState(row, false, 'sky');
                  });
                };

                const rowHasChangeData = (row) => {
                  if (!row) return false;
                  const accountId = row.dataset.changeRow;
                  if (!accountId) return false;

                  const amountInput = row.querySelector(`[data-change-input="${accountId}"]`);
                  return parseMoneyInput(amountInput) > 0;
                };

                const closeOtherChangeRows = (currentRow) => {
                  dialog.querySelectorAll('[data-change-row]').forEach((row) => {
                    if (row === currentRow) return;
                    if (rowHasChangeData(row)) return;

                    const accountId = row.dataset.changeRow;
                    const checkbox = row.querySelector(`[data-change-check="${accountId}"]`);
                    if (checkbox?.checked) {
                      checkbox.checked = false;
                      checkbox.dispatchEvent(new Event('change'));
                      return;
                    }

                    setChangeAccordionState(row, false);
                    setRowVisualState(row, false, 'amber');
                  });
                };

                dialog.querySelectorAll('[data-pay-check]').forEach((checkbox) => {
                  checkbox.addEventListener('change', () => {
                    const accountId = checkbox.dataset.payCheck;
                    const row = dialog.querySelector(`[data-pay-row="${accountId}"]`);
                    const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                    const bankFields = row.querySelector(`[data-pay-bank-fields="${accountId}"]`);
                    if (!input) return;

                    setFieldEnabledState(input, checkbox.checked, 'sky');
                    setBankFieldsEnabled(bankFields, checkbox.checked, 'sky');

                    setRowVisualState(row, checkbox.checked, 'sky');
                    setPaymentAccordionState(row, checkbox.checked);
                    syncPaymentRowMethodTone(row);
                    updateRemaining();
                  });
                });

                dialog.querySelectorAll('[data-pay-toggle]').forEach((button) => {
                  button.addEventListener('click', () => {
                    const accountId = button.dataset.payToggle;
                    const row = dialog.querySelector(`[data-pay-row="${accountId}"]`);
                    const checkbox = row?.querySelector(`[data-pay-check="${accountId}"]`);
                    if (!row || !checkbox) return;

                    const isOpen = row.classList.contains('is-open');
                    if (isOpen) {
                      if (rowHasPaymentData(row)) return;
                      if (checkbox.checked) {
                        checkbox.checked = false;
                        checkbox.dispatchEvent(new Event('change'));
                      } else {
                        setPaymentAccordionState(row, false);
                        setRowVisualState(row, false, 'sky');
                      }
                      return;
                    }

                    closeOtherPaymentRows(row);
                    if (!checkbox.checked) {
                      checkbox.checked = true;
                      checkbox.dispatchEvent(new Event('change'));
                    } else {
                      setPaymentAccordionState(row, true);
                    }
                  });
                });

                dialog.querySelectorAll('[data-pay-method-image]').forEach((image) => {
                  image.addEventListener('load', () => {
                    const row = image.closest('[data-pay-row]');
                    if (!row || !row.classList.contains('is-open')) return;
                    setPaymentAccordionState(row, true);
                  });
                });
                dialog.querySelectorAll('[data-change-input]').forEach((input) => {
                  input.addEventListener('input', updateRemaining);
                });

                dialog.querySelectorAll('[data-change-bank-method]').forEach((select) => {
                  syncMethodSelectTone(select);
                  select.addEventListener('change', () => {
                    syncMethodSelectTone(select);
                    updateRemaining();
                  });
                });

                dialog.querySelectorAll('[data-change-reference]').forEach((input) => {
                  input.addEventListener('input', updateRemaining);
                });

                dialog.querySelectorAll('[data-change-check]').forEach((checkbox) => {
                  checkbox.addEventListener('change', () => {
                    const accountId = checkbox.dataset.changeCheck;
                    const row = dialog.querySelector(`[data-change-row="${accountId}"]`);
                    const input = dialog.querySelector(`[data-change-input="${accountId}"]`);
                    const bankFields = dialog.querySelector(`[data-change-bank-fields="${accountId}"]`);
                    if (!input) return;

                    setFieldEnabledState(input, checkbox.checked, 'amber');
                    setBankFieldsEnabled(bankFields, checkbox.checked, 'amber');
                    setRowVisualState(row, checkbox.checked, 'amber');
                    setChangeAccordionState(row, checkbox.checked);
                    updateRemaining();
                  });
                });

                dialog.querySelectorAll('[data-change-toggle]').forEach((button) => {
                  button.addEventListener('click', () => {
                    const accountId = button.dataset.changeToggle;
                    const row = dialog.querySelector(`[data-change-row="${accountId}"]`);
                    const checkbox = row?.querySelector(`[data-change-check="${accountId}"]`);
                    if (!row || !checkbox) return;

                    const isOpen = row.classList.contains('is-open');
                    if (isOpen) {
                      if (rowHasChangeData(row)) return;
                      if (checkbox.checked) {
                        checkbox.checked = false;
                        checkbox.dispatchEvent(new Event('change'));
                      } else {
                        setChangeAccordionState(row, false);
                        setRowVisualState(row, false, 'amber');
                      }
                      return;
                    }

                    closeOtherChangeRows(row);
                    if (!checkbox.checked) {
                      checkbox.checked = true;
                      checkbox.dispatchEvent(new Event('change'));
                    } else {
