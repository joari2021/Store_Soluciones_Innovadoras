                dialog.querySelectorAll('[data-change-row]').forEach((row) => {
                  const accountId = row.dataset.changeRow;
                  if (!accountId) return;

                  const checkbox = row.querySelector(`[data-change-check="${accountId}"]`);
                  const input = row.querySelector(`[data-change-input="${accountId}"]`);
                  const bankFields = row.querySelector(`[data-change-bank-fields="${accountId}"]`);

                  setFieldEnabledState(input, Boolean(checkbox?.checked), 'amber');
                  setBankFieldsEnabled(bankFields, Boolean(checkbox?.checked), 'amber');
                  setRowVisualState(row, Boolean(checkbox?.checked), 'amber');
                  setChangeAccordionState(row, Boolean(checkbox?.checked));
                });

                setCreditFieldsEnabled(Boolean(creditToggle?.checked));
                setDiscountFieldsEnabled(Boolean(discountToggle?.checked));
                if (typeof window.initializeMaterializeDatepickers === 'function') {
                  window.initializeMaterializeDatepickers(dialog);
                }

                if (initialState) {
                  (initialState.payments || []).forEach((entry) => {
                    const accountId = String(entry.accountId || '');
                    const checkbox = dialog.querySelector(`[data-pay-check="${accountId}"]`);
                    if (!checkbox) return;

                    checkbox.checked = Boolean(entry.checked);
                    checkbox.dispatchEvent(new Event('change'));

                    const input = dialog.querySelector(`[data-pay-input="${accountId}"]`);
                    if (input && typeof entry.amount === 'string') {
                      input.value = entry.amount;
                      input.dispatchEvent(new Event('input'));
                    }

                    const methodSelect = dialog.querySelector(`[data-pay-bank-method="${accountId}"]`);
                    if (methodSelect && typeof entry.method === 'string') {
                      methodSelect.value = entry.method;
                      syncMethodSelectTone(methodSelect);
                      const row = dialog.querySelector(`[data-pay-row="${accountId}"]`);
                      syncPaymentRowMethodTone(row);
                    }

                    const paymentDateInput = dialog.querySelector(`[data-pay-date="${accountId}"]`);
                    if (paymentDateInput && typeof entry.paymentDate === 'string') {
                      const normalizedDate = normalizePaymentDateInput(entry.paymentDate);
                      paymentDateInput.value = normalizedDate ? normalizedDate.display : '';
                    }

                    const referenceInput = dialog.querySelector(`[data-pay-reference="${accountId}"]`);
                    if (referenceInput && typeof entry.reference === 'string') {
                      referenceInput.value = entry.reference;
                    }
                  });

                  dialog.querySelectorAll('[data-pay-row]').forEach((row) => {
                    syncPaymentRowMethodTone(row);
                  });

                  if (changeToggle && initialState.changeEnabled) {
                    changeToggle.checked = true;
                    changeToggle.dispatchEvent(new Event('change'));
                  }

                  if (creditToggle) {
                    creditToggle.checked = Boolean(initialState.creditEnabled);
                    setCreditFieldsEnabled(creditToggle.checked);
                  }

                  if (creditDueOnInput && typeof initialState.creditDueOn === 'string') {
                    const normalizedCreditDueOn = normalizePaymentDateInput(initialState.creditDueOn);
                    creditDueOnInput.value = normalizedCreditDueOn ? normalizedCreditDueOn.display : '';
                  }

                  if (discountToggle) {
                    discountToggle.checked = Boolean(initialState.discountEnabled);
                    setDiscountFieldsEnabled(discountToggle.checked);
                  }

                  if (discountAmountInput && typeof initialState.discountAmount === 'string') {
                    discountAmountInput.value = initialState.discountAmount;
                  }

                  if (discountReasonSelect && typeof initialState.discountReason === 'string') {
                    discountReasonSelect.value = initialState.discountReason;
                  }

                  (initialState.change || []).forEach((entry) => {
                    const accountId = String(entry.accountId || '');
                    const checkbox = dialog.querySelector(`[data-change-check="${accountId}"]`);
                    if (!checkbox) return;

                    checkbox.checked = Boolean(entry.checked);
                    checkbox.dispatchEvent(new Event('change'));

                    const input = dialog.querySelector(`[data-change-input="${accountId}"]`);
                    if (input && typeof entry.amount === 'string') {
                      input.value = entry.amount;
                      input.dispatchEvent(new Event('input'));
                    }

                    const methodSelect = dialog.querySelector(`[data-change-bank-method="${accountId}"]`);
                    if (methodSelect && typeof entry.method === 'string') {
                      methodSelect.value = entry.method;
                      syncMethodSelectTone(methodSelect);
                    }

                    const referenceInput = dialog.querySelector(`[data-change-reference="${accountId}"]`);
                    if (referenceInput && typeof entry.reference === 'string') {
                      referenceInput.value = entry.reference;
                    }
                  });

                  (initialState.extraPayments || []).forEach((entry) => {
                    const accountId = String(entry.accountId || '');
                    const row = dialog.querySelector(`[data-pay-row="${accountId}"]`);
                    if (!row) return;

                    const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                    if (checkbox && !checkbox.checked) {
                      checkbox.checked = true;
                      checkbox.dispatchEvent(new Event('change'));
                    }

                    addMultiPaymentEntry(row, entry);
                  });

                } else {
                  setCreditFieldsEnabled(false);
                  setDiscountFieldsEnabled(false);
                }

                updateRemaining();
              },
              preConfirm: () => {
                const dialog = window.Swal.getHtmlContainer();
                if (!dialog) return null;

                const modalState = capturePaymentModalState(dialog);
                const creditToggle = dialog.querySelector('[data-credit-toggle]');
                const creditDueOnInput = dialog.querySelector('[data-credit-due-on]');
                const casheaEnabled = Boolean(selectedCasheaContext?.enabled);
                const creditEnabled = casheaEnabled ? false : Boolean(creditToggle?.checked);
                const creditDueOn = String(creditDueOnInput?.value || '').trim();
                const normalizedCreditDueOn = creditDueOn ? normalizePaymentDateInput(creditDueOn) : null;
                const discountToggle = dialog.querySelector('[data-discount-toggle]');
                const discountAmountInput = dialog.querySelector('[data-discount-amount]');
                const discountReasonSelect = dialog.querySelector('[data-discount-reason]');
                const discountEnabled = casheaEnabled ? false : Boolean(discountToggle?.checked);
                const rawDiscountAmount = parseMoneyInput(discountAmountInput);
                const sanitizedDiscountBase = discountEnabled
                  ? roundTo(Math.min(Math.max(rawDiscountAmount, 0), modalTotalBase), 2)
                  : 0;
                const discountReason = String(discountReasonSelect?.value || '').trim();
                let paidBase = 0;
                const payments = [];
                let missingMethod = false;
                let missingConversion = false;
                let missingReference = false;
                let missingPaymentDate = false;

                const resolveMethodForAccount = (account, bankMethod = '') => {
                  if (!account) return '';
                  if (account.account_type === 'bank_account') return bankMethod || '';
                  if (account.account_type === 'cash_box') return 'cash';
                  if (account.account_type === 'card') return 'card';
                  if (account.account_type === 'pos') return 'pos';
                  if (account.account_type === 'biopago') return 'biopago';
                  if (account.account_type === 'cashea') return 'cashea';
                  if (account.account_type === 'digital_wallet') return 'wallet';
                  if (account.account_type === 'crypto_wallet') return 'crypto';
                  return 'cash';
                };

                dialog.querySelectorAll('[data-pay-row]').forEach((row) => {
                  const accountId = row.dataset.payRow;
                  const account = accountsById.get(String(accountId));
                  if (!account) return;

                  const checkbox = row.querySelector(`[data-pay-check="${accountId}"]`);
                  if (!checkbox?.checked) return;

                  const input = row.querySelector(`[data-pay-input="${accountId}"]`);
                  const amount = parseMoneyInput(input);
                  if (amount <= 0) return;

                  let method = resolveMethodForAccount(account);
                  let reference = '';
                  let paymentDate = '';
                  if (account.account_type === 'bank_account') {
                    const methodSelect = row.querySelector(`[data-pay-bank-method="${accountId}"]`);
                    method = methodSelect?.value || '';
                    if (!method) missingMethod = true;

                    const paymentDateInput = row.querySelector(`[data-pay-date="${accountId}"]`);
                    const paymentDateValue = String(paymentDateInput?.value || '').trim();
                    const normalizedPaymentDate = normalizePaymentDateInput(paymentDateValue);
                    if (!normalizedPaymentDate) missingPaymentDate = true;
                    paymentDate = normalizedPaymentDate?.iso || '';

                    const referenceInput = row.querySelector(`[data-pay-reference="${accountId}"]`);
                    const referenceValue = referenceInput?.value || '';
                    if (!/^\d{4}$/.test(referenceValue)) missingReference = true;
                    reference = referenceValue.trim();
                  }

                  const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                  if (baseAmount === null) {
                    missingConversion = true;
                    return;
                  }

                  payments.push({
                    account_id: accountId,
                    method: method,
                    amount: amount,
                    currency: account.currency,
                    reference: reference,
                    payment_date: paymentDate,
                  });

                  paidBase += baseAmount;

                  row.querySelectorAll(`[data-pay-multi-entry="${accountId}"]`).forEach((entry) => {
                    const extraAmount = parseMoneyInput(entry.querySelector('[data-pay-multi-amount]'));
                    if (extraAmount <= 0) return;

                    const methodValue = String(entry.querySelector('[data-pay-multi-method]')?.value || '').trim();
                    const referenceValue = String(entry.querySelector('[data-pay-multi-reference]')?.value || '').trim();
                    const paymentDateValue = String(entry.querySelector('[data-pay-multi-date]')?.value || '').trim();
                    const normalizedPaymentDate = normalizePaymentDateInput(paymentDateValue);
                    const methodForEntry = account.account_type === 'bank_account'
                      ? methodValue
                      : resolveMethodForAccount(account);

                    if (account.account_type === 'bank_account') {
                      if (!methodForEntry) missingMethod = true;
                      if (!/^\d{4}$/.test(referenceValue)) missingReference = true;
                      if (!normalizedPaymentDate) missingPaymentDate = true;
                    }

                    const extraBaseAmount = convertAmount(extraAmount, account.currency, baseCurrencyCode);
                    if (extraBaseAmount === null) {
                      missingConversion = true;
                      return;
                    }

                    payments.push({
                      account_id: accountId,
                      method: methodForEntry,
                      amount: extraAmount,
                      currency: account.currency,
                      reference: referenceValue,
                      payment_date: normalizedPaymentDate?.iso || '',
                    });

                    paidBase += extraBaseAmount;
                  });
                });

                if (missingMethod) {
                  window.Swal.showValidationMessage('Selecciona el metodo de pago para cuentas bancarias.');
                  return null;
                }

                if (missingReference) {
                  window.Swal.showValidationMessage('La referencia debe tener 4 digitos.');
                  return null;
                }

                if (missingPaymentDate) {
                  window.Swal.showValidationMessage('Debes indicar la fecha del pago para cuentas bancarias.');
                  return null;
                }

                if (missingConversion) {
                  window.Swal.showValidationMessage('Hay pagos sin tasa de conversion disponible.');
                  return null;
                }

                if (creditEnabled && !selectedClient?.id) {
                  window.Swal.showValidationMessage('Debes seleccionar un cliente para registrar saldo en deuda por cobrar.');
                  return null;
                }

                if (creditEnabled && String(selectedClient?.phone || '').trim().length === 0) {
                  window.Swal.showValidationMessage('El cliente registrado no posee numero de telefono, ese dato es obligatorio.');
                  return null;
                }

                if (casheaEnabled && !selectedClient?.id) {
                  window.Swal.showValidationMessage('Debes seleccionar un cliente para procesar una venta con Cashea.');
                  return null;
                }

                if (casheaEnabled && String(selectedClient?.phone || '').trim().length === 0) {
                  window.Swal.showValidationMessage('El cliente debe tener telefono para registrar cuotas Cashea.');
                  return null;
                }

                if (creditEnabled && creditDueOn && !normalizedCreditDueOn) {
                  window.Swal.showValidationMessage('La fecha de vencimiento del credito es invalida.');
                  return null;
                }

                if (discountEnabled && sanitizedDiscountBase <= 0) {
                  window.Swal.showValidationMessage('Indica un monto de descuento mayor a cero.');
                  return null;
                }

                if (discountEnabled && sanitizedDiscountBase > modalTotalBase) {
                  window.Swal.showValidationMessage('El descuento no puede superar el total de la venta.');
                  return null;
                }

                if (discountEnabled && !discountReason) {
                  window.Swal.showValidationMessage('Selecciona el motivo del descuento.');
                  return null;
                }

                const effectiveTotalBase = roundTo(Math.max(modalTotalBase - sanitizedDiscountBase, 0), 2);
                let remaining = roundTo(effectiveTotalBase - paidBase, 2);
                if (Math.abs(remaining) <= paymentTolerance) remaining = 0;
                const creditCoversPendingBalance = creditEnabled && remaining > paymentTolerance;

                if (payments.length === 0 && !creditCoversPendingBalance) {
                  window.Swal.showValidationMessage('Registra al menos un pago.');
                  return null;
                }

                if (remaining > paymentTolerance && !creditCoversPendingBalance) {
                  window.Swal.showValidationMessage(`Falta por cancelar ${formatBaseMoney(remaining)}`);
                  return null;
                }

                const suggestedChangeBase = remaining < -paymentTolerance ? Math.abs(remaining) : 0;
                const changeToggle = dialog.querySelector('[data-change-toggle]');
                const changeEntries = [];
                let missingChangeMethod = false;
                let missingChangeReference = false;
                let missingChangeConversion = false;

                if (changeToggle?.checked) {
                  dialog.querySelectorAll('[data-change-row]').forEach((row) => {
                    const accountId = row.dataset.changeRow;
                    const account = accountsById.get(String(accountId));
                    if (!account) return;

                    const checkbox = row.querySelector(`[data-change-check="${accountId}"]`);
                    if (!checkbox?.checked) return;

                    const input = row.querySelector(`[data-change-input="${accountId}"]`);
                    const amount = parseMoneyInput(input);
                    if (amount <= 0) return;

                    let method = 'cash';
                    if (account.account_type === 'bank_account') {
                      const methodSelect = row.querySelector(`[data-change-bank-method="${accountId}"]`);
                      method = methodSelect?.value || '';
                      if (!method) missingChangeMethod = true;
                      const referenceInput = row.querySelector(`[data-change-reference="${accountId}"]`);
                      const referenceValue = referenceInput?.value || '';
                      if (!/^\d{4}$/.test(referenceValue)) missingChangeReference = true;
                    } else if (account.account_type === 'cash_box') {
                      method = 'cash';
                    } else if (account.account_type === 'card') {
                      method = 'card';
                    } else if (account.account_type === 'pos') {
                      method = 'pos';
                    } else if (account.account_type === 'biopago') {
                      method = 'biopago';
                    } else if (account.account_type === 'cashea') {
                      method = 'cashea';
                    } else if (account.account_type === 'digital_wallet') {
                      method = 'wallet';
                    } else if (account.account_type === 'crypto_wallet') {
                      method = 'crypto';
                    }

                    const baseAmount = convertAmount(amount, account.currency, baseCurrencyCode);
                    if (baseAmount === null) {
                      missingChangeConversion = true;
                      return;
                    }

                    const referenceInput = row.querySelector(`[data-change-reference="${accountId}"]`);
                    const reference = referenceInput?.value || '';

                    changeEntries.push({
                      account_id: accountId,
                      method: method,
                      amount: amount,
                      currency: account.currency,
                      reference: reference.trim(),
                    });
                  });

                  if (missingChangeMethod) {
                    window.Swal.showValidationMessage('Selecciona el metodo del vuelto para cuentas bancarias.');
                    return null;
                  }

                  if (missingChangeReference) {
                    window.Swal.showValidationMessage('La referencia del vuelto debe tener 4 digitos.');
                    return null;
                  }

                  if (missingChangeConversion) {
                    window.Swal.showValidationMessage('Hay vueltos sin tasa de conversion disponible.');
                    return null;
                  }

                  if (changeEntries.length === 0) {
                    window.Swal.showValidationMessage('Registra al menos un monto de vuelto o desactiva la opcion.');
                    return null;
                  }
                }

                return {
                  payments,
                  change: changeEntries,
                  credit_sale: {
                    enabled: creditCoversPendingBalance,
                    due_on: creditCoversPendingBalance ? (normalizedCreditDueOn?.iso || '') : '',
                  },
                  cashea: {
                    enabled: casheaEnabled,
                    account_id: casheaEnabled ? selectedCasheaContext.account_id : null,
                    initial_usd: casheaEnabled ? selectedCasheaContext.initial_usd : 0,
                    min_purchase_usd: casheaEnabled ? selectedCasheaContext.min_purchase_usd : 0,
                    installments: casheaEnabled ? (selectedCasheaContext.installments || []) : [],
                  },
                  checkout_discount: {
                    enabled: discountEnabled && sanitizedDiscountBase > 0,
                    amount: sanitizedDiscountBase,
                    reason: discountReason,
                  },
                  totalBase: effectiveTotalBase,
                  suggestedChangeBase,
                  hasPendingSuggestedChange: suggestedChangeBase > paymentTolerance && changeEntries.length === 0,
                  modalState,
                };
              },
            }).then(async (result) => {
              if (!result.isConfirmed) return;

              const payload = result.value || {};
              if (payload.hasPendingSuggestedChange && window.Swal) {
                const changeConfirmation = await window.Swal.fire({
                  icon: 'warning',
                  title: 'Vuelto sugerido sin registrar',
                  html: `<p class="text-sm text-slate-600">Se detecto un vuelto sugerido de <strong>${formatBaseMoney(payload.suggestedChangeBase || 0)}</strong>. ¿Deseas continuar sin registrarlo?</p>`,
                  showCancelButton: true,
                  confirmButtonText: 'Continuar sin vuelto',
                  cancelButtonText: 'Volver al cobro',
                  buttonsStyling: false,
                  customClass: {
                    popup: 'rounded-2xl border border-amber-200 shadow-xl',
                    title: 'text-lg font-extrabold text-slate-800',
                    actions: 'w-full flex flex-wrap items-center justify-end gap-2 mt-5',
                    confirmButton: 'inline-flex items-center justify-center rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-amber-500',
                    cancelButton: 'inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50',
                  },
                  heightAuto: false,
                });

                if (!changeConfirmation.isConfirmed) {
                  openPaymentModal(payload.modalState || null);
                  return;
                }
              }

              if (payload.checkout_discount?.enabled && window.Swal) {
                const discountAmount = Number(payload.checkout_discount.amount || 0);
                const discountConfirmation = await window.Swal.fire({
                  icon: 'warning',
                  title: 'Confirmar venta con descuento',
                  html: `
                    <div class="space-y-2 text-left text-sm text-slate-600">
                      <p>Se aplicara un descuento de <strong>${formatBaseMoney(discountAmount)}</strong> en esta venta.</p>
                      <p>Motivo: <strong>${escapeHtml(String(payload.checkout_discount.reason || '').replaceAll('_', ' '))}</strong>.</p>
                      <p class="text-amber-700 font-semibold">Esta venta sera revisada por el administrador, quien determinara si el descuento aplicado fue conveniente.</p>
                      <p class="text-amber-700">Si no corresponde, el monto descontado podra ser cargado como deuda al usuario que facturo la venta.</p>
                    </div>
                  `,
                  showCancelButton: true,
                  confirmButtonText: 'Si, registrar venta',
                  cancelButtonText: 'Volver al cobro',
                  buttonsStyling: false,
                  customClass: {
                    popup: 'rounded-2xl border border-amber-200 shadow-xl',
                    title: 'text-lg font-extrabold text-slate-800',
                    actions: 'w-full flex flex-wrap items-center justify-end gap-2 mt-5',
                    confirmButton: 'inline-flex items-center justify-center rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-amber-500',
                    cancelButton: 'inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50',
                  },
                  heightAuto: false,
                });

                if (!discountConfirmation.isConfirmed) {
                  openPaymentModal(payload.modalState || null);
                  return;
                }
              }

              const checkoutDecisionsReady = await ensureServiceCheckoutDecisions();
              if (!checkoutDecisionsReady) {
                openPaymentModal(payload.modalState || null);
                return;
              }

              const servicePartiesReady = await ensureServicePartiesForCheckout();
              if (!servicePartiesReady) {
                openPaymentModal(payload.modalState || null);
                return;
              }

              submitVenta(
                payload.payments || [],
                payload.change || [],
                payload.credit_sale || null,
                checkoutBaseCurrency,
                payload.checkout_discount || null,
                payload.cashea || null
              );
            });
          };

          openPaymentModal();
        });
      }

      const clientSearchInput = document.getElementById('ventas-client-search');
      const clientResults = document.getElementById('ventas-client-results');
      const clientList = document.getElementById('ventas-client-list');
      const clientAddButton = document.getElementById('ventas-client-add');
      const clientSelected = document.getElementById('ventas-client-selected');
      const clientName = document.getElementById('ventas-client-name');
      const clientEmpty = document.getElementById('ventas-client-empty');
      const clientBenefitsBadge = document.getElementById('ventas-client-benefits-badge');
      const clientClear = document.getElementById('ventas-client-clear');
      let clientSearchTimeout = null;

      const setSelectedClient = (client) => {
        selectedClient = client ? {
          ...client,
          benefits: normalizeClientBenefits(client.benefits || {}),
        } : null;
        if (client && clientSearchInput) {
          clientSearchInput.value = '';
        }
        if (clientSelected && clientName && clientEmpty) {
          if (client) {
            clientName.textContent = `${client.name} (${client.document || 'N/A'})`;
            clientSelected.classList.remove('hidden');
            clientSelected.classList.add('flex');
            clientEmpty.classList.add('hidden');
            if (clientBenefitsBadge) {
              clientBenefitsBadge.classList.toggle('hidden', !clientHasBenefits(selectedClient));
            }
          } else {
            clientName.textContent = '';
            clientSelected.classList.add('hidden');
            clientSelected.classList.remove('flex');
            clientEmpty.classList.remove('hidden');
            if (clientBenefitsBadge) {
              clientBenefitsBadge.classList.add('hidden');
            }
          }
        }

        renderCart();
        queueActiveDraftSync();
      };

      const hideClientResults = () => {
        if (clientResults) {
          clientResults.classList.add('hidden');
        }
      };

      const parseClientBenefits = (rawValue) => {
        if (rawValue && typeof rawValue === 'object') return normalizeClientBenefits(rawValue);
        const serialized = String(rawValue || '').trim();
        if (!serialized) return normalizeClientBenefits({});
        try {
          return normalizeClientBenefits(JSON.parse(serialized));
        } catch (_error) {
          return normalizeClientBenefits({});
        }
      };

      const renderClientResults = (clients) => {
        if (!clientList || !clientResults) return;
        if (!clients || clients.length === 0) {
          clientList.innerHTML = '<p class="px-3 py-2 text-sm text-slate-500">Sin coincidencias</p>';
          clientResults.classList.remove('hidden');
          return;
        }

        const rows = clients
          .map((client) => {
            const benefitsJson = escapeHtml(JSON.stringify(client.benefits || {}));
            return `
              <button type="button" class="flex w-full items-center justify-between gap-2 px-3 py-2 text-left text-sm hover:bg-slate-50" data-client-id="${client.id}" data-client-name="${escapeHtml(client.name)}" data-client-doc="${escapeHtml(client.document || '')}" data-client-phone="${escapeHtml(client.phone || '')}" data-client-has-benefits="${client.has_benefits ? '1' : '0'}" data-client-benefits="${benefitsJson}">
                <span>${escapeHtml(client.name)}</span>
                <span class="text-xs text-slate-400">${escapeHtml(client.document || '')}</span>
              </button>
            `;
          })
          .join('');

        clientList.innerHTML = rows;
        clientResults.classList.remove('hidden');
      };

      const searchClients = async (query) => {
        if (!query || query.length < 1) {
          hideClientResults();
          return;
        }

        try {
          const response = await fetch(`/clientes/search?q=${encodeURIComponent(query)}`);
          const data = await response.json();
          renderClientResults(data.clients || []);
        } catch (error) {
          renderClientResults([]);
        }
      };

      const parseJsonResponseOrThrow = async (response, fallbackMessage) => {
        const contentType = String(response.headers.get('content-type') || '').toLowerCase();

        if (contentType.includes('application/json')) {
          return response.json();
        }

        const responseText = await response.text();
        if (responseText.includes('<!DOCTYPE') || responseText.includes('<html')) {
          throw new Error(fallbackMessage || 'El servidor devolvio una respuesta inesperada.');
        }

        throw new Error(responseText.trim() || fallbackMessage || 'El servidor devolvio una respuesta invalida.');
      };

      const openClientModal = (presetName) => {
        if (!window.Swal) return;

        const modalHtml = `
          <div class="space-y-4 text-left">
            <div class="rounded-2xl border border-cyan-200/70 bg-white/80 p-3 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Datos de identidad</p>
              <div class="mt-2 grid grid-cols-3 gap-2">
                <select id="cliente-document-type" class="ventas-client-modal-field rounded-xl border bg-white px-3 py-2 text-sm text-slate-700 placeholder:text-slate-400">
                  <option value="">Tipo</option>
                  <option value="V">V</option>
                  <option value="E">E</option>
                  <option value="J">J</option>
                  <option value="G">G</option>
                </select>
                <input id="cliente-document-number" type="text" class="ventas-client-modal-field col-span-2 rounded-xl border bg-white px-3 py-2 text-sm text-slate-700 placeholder:text-slate-400" placeholder="Numero de documento">
              </div>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Nombre o razon social</label>
              <input id="cliente-name" type="text" class="ventas-client-modal-field w-full rounded-xl border bg-white px-3 py-2 text-sm text-slate-700 placeholder:text-slate-400" placeholder="Ej: Maria Perez" value="${escapeHtml(presetName || '')}">
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div class="space-y-2">
                <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Telefono</label>
                <input id="cliente-phone" type="text" class="ventas-client-modal-field w-full rounded-xl border bg-white px-3 py-2 text-sm text-slate-700 placeholder:text-slate-400" placeholder="Ej: 04141234567">
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Direccion</label>
                <textarea id="cliente-address" rows="2" class="ventas-client-modal-field w-full rounded-xl border bg-white px-3 py-2 text-sm text-slate-700 placeholder:text-slate-400" placeholder="Direccion"></textarea>
              </div>
            </div>
          </div>
        `;

        window.Swal.fire({
          title: 'Nuevo cliente',
          html: modalHtml,
          showCancelButton: true,
          confirmButtonText: 'Guardar',
          cancelButtonText: 'Cancelar',
          showLoaderOnConfirm: true,
          allowOutsideClick: false,
          allowEscapeKey: () => !window.Swal.isLoading(),
          buttonsStyling: false,
          customClass: {
            popup: 'ventas-client-modal',
            confirmButton: 'ventas-client-modal-confirm cursor-pointer',
            cancelButton: 'ventas-client-modal-cancel cursor-pointer',
          },
          focusConfirm: false,
          heightAuto: false,
          preConfirm: async () => {
            const dialog = window.Swal.getHtmlContainer();
            if (!dialog) return null;

            const documentType = dialog.querySelector('#cliente-document-type')?.value || '';
            const documentNumber = dialog.querySelector('#cliente-document-number')?.value || '';
            const name = dialog.querySelector('#cliente-name')?.value || '';
            const phone = dialog.querySelector('#cliente-phone')?.value || '';
            const address = dialog.querySelector('#cliente-address')?.value || '';

            if (!documentType) {
              window.Swal.showValidationMessage('Selecciona el prefijo de identidad.');
              return null;
            }

            if (!name.trim()) {
              window.Swal.showValidationMessage('El nombre es obligatorio.');
              return null;
            }

            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
            if (!csrfToken) {
              window.Swal.showValidationMessage('Token CSRF no disponible.');
              return null;
            }

            const response = await fetch('/clientes', {
              method: 'POST',
              headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken,
              },
              credentials: 'same-origin',
              body: JSON.stringify({
                cliente: {
                  document_type: documentType,
                  document_number: documentNumber,
                  name: name.trim(),
                  phone: phone.trim(),
                  address: address.trim(),
                },
              }),
            });

            try {
              const data = await parseJsonResponseOrThrow(response, 'No se pudo guardar el cliente correctamente.');
              if (!response.ok) {
                window.Swal.showValidationMessage(data.error || 'No se pudo guardar el cliente.');
                return null;
              }

              return data;
            } catch (error) {
              window.Swal.showValidationMessage(error.message || 'No se pudo guardar el cliente.');
              return null;
            }
          },
        }).then((result) => {
          if (!result.isConfirmed) return;
          const client = result.value;
          if (!client) return;
          setSelectedClient(client);
          hideClientResults();
        });
      };

      const syncProductsMap = (nextProducts) => {
        if (!Array.isArray(nextProducts)) return;

        products = nextProducts;
        productsById.clear();
        products.forEach((product) => {
          productsById.set(String(product.id), product);
        });

        updateAvailabilityUI();
      };

      const resetWorkingSale = () => {
        if (draftSyncTimeout) {
          clearTimeout(draftSyncTimeout);
          draftSyncTimeout = null;
        }

        cart.clear();
        activeDraftId = null;
        activeDraftCreatedById = null;
        activeDraftVisibility = null;
        activeDraftCheckoutStatus = null;
        draftSyncedFingerprint = null;
        applySyncedReservationSnapshot(new Map());
        setSelectedClient(null);
        setBaseCurrencySelection('VES');
        setVatModeSelection('none');
        renderDraftTags();
        renderCart();
      };

      const buildDraftFingerprint = () => {
        const payload = buildVentaPayload([], []);
        return JSON.stringify({
          draft_id: payload.draft_id || null,
          base_currency: payload.base_currency || 'USD',
          vat_mode: payload.vat_mode || 'none',
          cliente_id: payload.cliente_id || null,
          draft_checkout_status: normalizeDraftCheckoutStatus(activeDraftCheckoutStatus, 'pending'),
          items: Array.isArray(payload.items) ? payload.items : [],
        });
      };

      const destroyDraft = async (draftId, { silent = false } = {}) => {
        const safeId = String(draftId || '').trim();
        if (!safeId) return false;

        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (!csrfToken) {
          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Token CSRF no disponible',
              text: 'Recarga la pagina e intenta de nuevo.',
              heightAuto: false,
            });
          }
          return false;
        }

        try {
          const response = await fetch(`/ventas/drafts/${encodeURIComponent(safeId)}`, {
            method: 'DELETE',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
            },
          });

          let data = {};
          try {
            data = await response.json();
          } catch (error) {
            data = {};
          }

          if (!response.ok) {
            throw new Error(data.error || 'No se pudo eliminar el borrador.');
          }

          if (Array.isArray(data.products)) {
            syncProductsMap(data.products);
          }

          drafts = Array.isArray(data.drafts) ? data.drafts : drafts;
          const deletingActiveDraft = activeDraftId && String(activeDraftId) === safeId;
          if (deletingActiveDraft) {
            activeDraftId = null;
            activeDraftCreatedById = null;
            activeDraftVisibility = null;
            activeDraftCheckoutStatus = null;
            applySyncedReservationSnapshot(new Map());
          }

          draftSyncedFingerprint = null;
          renderDraftTags();

          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'success',
              title: 'Borrador eliminado',
              text: 'El borrador vacio fue eliminado y se restablecio su stock.',
              heightAuto: false,
            });
          }

          return true;
        } catch (error) {
          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'No se pudo eliminar',
              text: error.message,
              heightAuto: false,
            });
          }
          return false;
        }
      };

      const persistDraft = async ({ clearAfterSave = true, silent = false, draftVisibility = null, draftCheckoutStatus = null } = {}) => {
        if (cart.size === 0) {
          if (draftLoadInProgress && !clearAfterSave) {
            return false;
          }

          if (activeDraftId && !clearAfterSave) {
            const removed = await destroyDraft(activeDraftId, { silent: true });
            if (removed) {
              resetWorkingSale();
            }
            return removed;
          }

          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'info',
              title: 'Orden vacia',
              text: 'Agrega al menos un producto o servicio para guardar el borrador.',
              heightAuto: false,
            });
          }
          return false;
        }

        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (!csrfToken) {
          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Token CSRF no disponible',
              text: 'Recarga la pagina e intenta de nuevo.',
              heightAuto: false,
            });
          }
          return false;
        }

        const requestFingerprint = buildDraftFingerprint();
        const requestReservationSnapshot = buildProductReservationSnapshot();
        const payload = buildVentaPayload([], []);
        const creatingDraftFromAutoSync = !activeDraftId && !clearAfterSave;
        const effectiveDraftVisibility = draftVisibility || (activeDraftVisibility === 'visible' ? 'visible' : (clearAfterSave ? 'visible' : 'hidden'));
        const requestedCheckoutStatus = creatingDraftFromAutoSync
          ? 'pending'
          : draftCheckoutStatus;
        const effectiveDraftCheckoutStatus = normalizeDraftCheckoutStatus(
          requestedCheckoutStatus,
          activeDraftCheckoutStatus || 'pending'
        );
        payload.draft_visibility = effectiveDraftVisibility;
        payload.draft_checkout_status = effectiveDraftCheckoutStatus;
        payload.draft_created_by_id = activeDraftCreatedById;
        const endpoint = activeDraftId ? `/ventas/drafts/${activeDraftId}` : '/ventas/save_draft';
        const method = activeDraftId ? 'PATCH' : 'POST';

        try {
          const response = await fetch(endpoint, {
            method,
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
            },
            body: JSON.stringify({ venta: payload }),
          });

          let data = {};
          try {
            data = await response.json();
          } catch (error) {
            data = {};
          }

          if (!response.ok) {
            throw new Error(data.error || 'No se pudo guardar el borrador.');
          }

          if (Array.isArray(data.products)) {
            syncProductsMap(data.products);
          }

          drafts = Array.isArray(data.drafts) ? data.drafts : drafts;

          if (clearAfterSave) {
            resetWorkingSale();
          } else if (data.draft?.id) {
            activeDraftId = String(data.draft.id);
            activeDraftCreatedById = Number(data.draft.created_by_id || activeDraftCreatedById || currentUserId || 0) || null;
            const responseVisibility = String(data.draft.visibility || effectiveDraftVisibility || 'visible').toLowerCase();
            activeDraftVisibility = responseVisibility === 'hidden' ? 'hidden' : 'visible';
            activeDraftCheckoutStatus = normalizeDraftCheckoutStatus(
              data.draft.checkout_status,
              effectiveDraftCheckoutStatus
            );

            if (creatingDraftFromAutoSync) {
              draftListFilter = 'pending';
            }

            draftSyncedFingerprint = requestFingerprint;
            applySyncedReservationSnapshot(requestReservationSnapshot);
            renderDraftTags();
            renderCart();

            if (buildDraftFingerprint() !== draftSyncedFingerprint) {
              queueActiveDraftSync();
            }
          }

          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'success',
              title: 'Borrador guardado',
              text: clearAfterSave
                ? 'La factura en proceso fue guardada y el panel se limpio para una nueva orden.'
                : 'Borrador actualizado correctamente.',
              heightAuto: false,
            });
          }

          return true;
        } catch (error) {
          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'No se pudo guardar',
              text: error.message,
              heightAuto: false,
            });
          }

          return false;
        }
      };

      const closeActiveDraftPreservingState = async () => {
        if (!activeDraftId) return true;

        const syncVisibility = activeDraftVisibility === 'hidden' ? 'hidden' : 'visible';
        const syncCheckoutStatus = normalizeDraftCheckoutStatus(activeDraftCheckoutStatus, 'pending');
        const synced = await persistDraft({
          clearAfterSave: false,
          silent: true,
          draftVisibility: syncVisibility,
          draftCheckoutStatus: syncCheckoutStatus,
        });

        if (!synced) {
          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'No se pudo cerrar el borrador',
              text: 'Intenta nuevamente para conservar los cambios del borrador activo.',
              heightAuto: false,
            });
          }
          return false;
        }

        resetWorkingSale();
        return true;
      };

      const queueActiveDraftSync = () => {
        const hasItems = cart.size > 0;
        const hasActiveDraft = Boolean(activeDraftId);
        if (!hasItems && !activeDraftId) {
          if (draftSyncTimeout) {
            clearTimeout(draftSyncTimeout);
            draftSyncTimeout = null;
          }
          draftSyncedFingerprint = null;
          return;
        }

        if (!hasItems) {
          if (!hasActiveDraft) {
            if (draftSyncTimeout) {
              clearTimeout(draftSyncTimeout);
              draftSyncTimeout = null;
            }
            return;
          }
        }

        const currentFingerprint = buildDraftFingerprint();
        if (currentFingerprint === draftSyncedFingerprint) {
          if (draftSyncTimeout) {
            clearTimeout(draftSyncTimeout);
            draftSyncTimeout = null;
          }
          return;
        }

        if (draftSyncInProgress) return;

        if (draftSyncTimeout) clearTimeout(draftSyncTimeout);
        draftSyncTimeout = setTimeout(async () => {
          draftSyncTimeout = null;
          if (draftSyncInProgress) return;
          if (cart.size === 0 && !activeDraftId) return;

          const latestFingerprint = buildDraftFingerprint();
          if (activeDraftId && latestFingerprint === draftSyncedFingerprint) return;

          draftSyncInProgress = true;
          const syncVisibility = activeDraftVisibility === 'visible' ? 'visible' : 'hidden';
          const syncCheckoutStatus = normalizeDraftCheckoutStatus(activeDraftCheckoutStatus, 'pending');
          const synced = await persistDraft({
            clearAfterSave: false,
            silent: true,
            draftVisibility: syncVisibility,
            draftCheckoutStatus: syncCheckoutStatus,
          });
          draftSyncInProgress = false;

          if (synced) {
            const fingerprintAfterSync = buildDraftFingerprint();
            if (fingerprintAfterSync !== draftSyncedFingerprint) {
              queueActiveDraftSync();
            }
          }
        }, 120);
      };

      const clearWorkingSale = async ({ silent = false } = {}) => {
        const hadItems = cart.size > 0;
        const hadDraft = Boolean(activeDraftId);

        if (!hadItems && !hadDraft) {
          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'info',
              title: 'Panel vacio',
              text: 'No hay items cargados para vaciar.',
              heightAuto: false,
            });
          }
          return false;
        }

        if (hadDraft) {
          const removed = await destroyDraft(activeDraftId, { silent: true });
          if (!removed) {
            if (!silent && window.Swal) {
              window.Swal.fire({
                icon: 'error',
                title: 'No se pudo vaciar',
                text: 'No se pudo eliminar el borrador asociado para restablecer stock.',
                heightAuto: false,
              });
            }
            return false;
          }
        }

        resetWorkingSale();

        if (!silent && window.Swal) {
          window.Swal.fire({
            icon: 'success',
            title: 'Panel vaciado',
            text: hadDraft
              ? 'Se limpio el panel y se elimino el borrador activo, restableciendo su stock reservado.'
              : 'Se limpio el panel actual y se liberaron las reservas locales.',
            heightAuto: false,
          });
        }

        return true;
      };

      const promptClearWorkingSale = async () => {
        if (cart.size === 0 && !activeDraftId) {
          await clearWorkingSale();
          return;
        }

        if (!window.Swal) {
          await clearWorkingSale();
          return;
        }

        const result = await window.Swal.fire({
          icon: 'warning',
          title: 'Vaciar panel',
          text: activeDraftId
            ? 'Esta accion eliminara el borrador activo y restablecera stock reservado. ¿Continuar?'
            : 'Esta accion limpiara todos los items del panel actual. ¿Continuar?',
          showCancelButton: true,
          confirmButtonText: 'Si, vaciar',
          cancelButtonText: 'Cancelar',
          heightAuto: false,
        });

        if (!result.isConfirmed) return;
        await clearWorkingSale();
      };

      const refreshLiveProducts = async ({ silent = true } = {}) => {
        if (liveProductsSyncInFlight) return;
        if (!document.body.contains(root)) return;

        liveProductsSyncInFlight = true;
        try {
          const response = await fetch('/ventas/products_snapshot', {
            headers: { 'Accept': 'application/json' },
          });

          let data = {};
          try {
            data = await response.json();
          } catch (error) {
            data = {};
          }

          if (!response.ok) {
            throw new Error(data.error || 'No se pudo sincronizar stock en vivo.');
          }

          if (Array.isArray(data.products)) {
            syncProductsMap(data.products);
          }

          if (Array.isArray(data.drafts)) {
            drafts = data.drafts;
            renderDraftTags();
          }

          if (Object.prototype.hasOwnProperty.call(data, 'active_cashier')) {
            applyActiveCashierState(data.active_cashier || null, {
              canChargeSale: data.can_charge_sale === true,
              canViewAllDrafts: data.can_view_all_drafts === true,
            });
          } else if (Object.prototype.hasOwnProperty.call(data, 'can_charge_sale')) {
            canChargeSale = data.can_charge_sale === true;
            root.dataset.canChargeSale = canChargeSale ? 'true' : 'false';
            if (Object.prototype.hasOwnProperty.call(data, 'can_view_all_drafts')) {
              canViewAllDrafts = data.can_view_all_drafts === true;
              root.dataset.canViewAllDrafts = canViewAllDrafts ? 'true' : 'false';
            }
          }
        } catch (error) {
          if (!silent && window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'Sincronizacion pendiente',
              text: error.message,
              heightAuto: false,
            });
          }
        } finally {
          liveProductsSyncInFlight = false;
        }
      };

      const startLiveProductsSync = () => {
        if (liveProductsSyncInterval) {
          clearInterval(liveProductsSyncInterval);
        }

        liveProductsSyncInterval = setInterval(() => {
          if (document.hidden) return;
          refreshLiveProducts({ silent: true });
        }, 4500);
      };

      const buildHttpErrorMessage = ({ fallbackMessage, response, data = null, extraDetails = [] }) => {
        const apiMessage = String(data?.error || data?.message || '').trim();
        const statusCode = Number(response?.status) || 0;
        const statusText = String(response?.statusText || '').trim();
        const statusLabel = statusCode > 0
          ? `HTTP ${statusCode}${statusText ? ` ${statusText}` : ''}`
          : '';
        const details = [
          apiMessage,
          statusLabel,
          ...extraDetails.filter((detail) => String(detail || '').trim().length > 0),
        ].filter((detail, index, array) => detail && array.indexOf(detail) === index);

        if (details.length === 0) return fallbackMessage;
        return `${fallbackMessage} Detalle: ${details.join(' | ')}`;
      };

      const buildDraftLoadErrorMessage = ({ draftId, stage, error }) => {
        const safeDraftId = String(draftId || '').trim() || 'sin-id';
        const stageLabel = String(stage || '').trim() || 'carga del borrador';
        const rawMessage = String(error?.message || '').trim() || 'Error no especificado.';
        return `Fallo en ${stageLabel} del borrador #${safeDraftId}. ${rawMessage}`;
      };

      const fetchServicesSnapshot = async (serviceIds) => {
        const ids = Array.from(new Set(serviceIds.map((value) => String(value).trim()).filter(Boolean)));
        if (ids.length === 0) return;

        const response = await fetch(`/ventas/services_snapshot?ids=${encodeURIComponent(ids.join(','))}`, {
          headers: {
            Accept: 'application/json',
          },
          credentials: 'same-origin',
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(buildHttpErrorMessage({
            fallbackMessage: 'No se pudieron cargar los servicios requeridos por el borrador.',
            response,
            data,
            extraDetails: [`servicios: ${ids.join(', ')}`],
          }));
        }

        upsertServicesCollection(data.services || []);

        const unresolvedIds = ids.filter((id) => !servicesById.has(id));
        if (unresolvedIds.length > 0) {
          throw new Error(`El servidor respondio, pero no devolvio todos los servicios del borrador. Faltan IDs: ${unresolvedIds.join(', ')}`);
        }
      };

      const ensureServicesForDraft = async (draft) => {
        const stateItems = Array.isArray(draft?.state?.items) ? draft.state.items : [];
        const serviceIds = stateItems
          .filter((entry) => String(entry.item_type || '').toLowerCase() === 'service' || entry.service_id)
          .map((entry) => String(entry.service_id || '').trim())
          .filter(Boolean);

        const missingIds = serviceIds.filter((id) => !servicesById.has(id));
        if (missingIds.length === 0) return;

        await fetchServicesSnapshot(missingIds);

        const stillMissingIds = missingIds.filter((id) => !servicesById.has(id));
        if (stillMissingIds.length > 0) {
          throw new Error(`No se pudieron resolver los servicios del borrador. IDs faltantes: ${stillMissingIds.join(', ')}`);
        }
      };

      const hydrateDraftCart = (draft) => {
        const state = draft?.state || {};
        const stateItems = Array.isArray(state.items) ? state.items : [];

        cart.clear();

        stateItems.forEach((entry) => {
          const itemType = String(entry.item_type || '').toLowerCase();
          const quantity = Number(entry.quantity) || 0;
          if (!(quantity > 0)) return;

          if (itemType === 'service' || entry.service_id) {
            const serviceId = String(entry.service_id || '').trim();
            if (!serviceId) return;

            const service = servicesById.get(serviceId);
            if (!service) return;

            const deliveryPresentation = String(entry.delivery_presentation || '').trim().toLowerCase();
            const selectedPrintMaterialId = String(entry.selected_print_material_surcharge_id || '').trim();
            const selectedPrintMaterialProductId = String(entry.selected_print_material_product_id || '').trim();
            const selectedPrintMaterialLabel = String(entry.selected_print_material_label || '').trim();
            const selectedPrintMaterialRows = normalizeServiceMaterialRowsForCart(entry.selected_print_material_rows);
            const selectedPrintCoverageId = String(entry.selected_print_coverage_id || '').trim();
            const selectedPrintCoveragePercent = String(entry.selected_print_coverage_percent || '').trim();
            const selectedPrintPriceBs = Number(entry.selected_print_price_bs);
            const selectedPrintSurchargePercent = Number(entry.selected_print_surcharge_percent);
            const selectedPrintUnitPriceBs = Number(entry.selected_print_unit_price_bs);
            const recargaBaseAmount = Number(entry.recarga_base_amount);
            const recargaTotalAmount = Number(entry.recarga_total_amount);
            const recargaProfitPercent = Number(entry.recarga_profit_percent);
            let signature = String(entry.price_signature || '').trim();
            const baseAmount = Number(entry.unit_price_base_amount);
            const baseCurrencyCode = normalizeCurrencyCode(entry.unit_price_base_currency);
            if (!signature && Number.isFinite(baseAmount) && baseAmount > 0 && baseCurrencyCode) {
              signature = `${baseCurrencyCode}:${roundTo(baseAmount, 2).toFixed(2)}`;
            }

            const signatureWithDelivery = [
              signature || null,
              deliveryPresentation ? `delivery-${deliveryPresentation}` : null,
              selectedPrintCoverageId ? `print-coverage-${selectedPrintCoverageId}` : null,
              selectedPrintMaterialId ? `print-material-${selectedPrintMaterialId}` : null,
              materialRowsSignatureToken(selectedPrintMaterialRows)
            ]
              .filter(Boolean)
              .join('|') || null;

            const key = buildKey('service', serviceId, signatureWithDelivery);
            const consumableDecisions = Array.isArray(entry.consumable_decisions) ? entry.consumable_decisions : [];
            const existing = cart.get(key) || {
              itemType: 'service',
              serviceId,
              service_beneficiary_name: String(entry.service_beneficiary_name || '').trim() || null,
              service_responsible_name: String(entry.service_responsible_name || '').trim() || null,
              delivery_presentation: deliveryPresentation || null,
              selected_print_coverage_id: selectedPrintCoverageId || null,
              selected_print_coverage_percent: selectedPrintCoveragePercent || null,
              selected_print_price_bs: Number.isFinite(selectedPrintPriceBs) ? roundTo(selectedPrintPriceBs, 2) : null,
              selected_print_surcharge_percent: Number.isFinite(selectedPrintSurchargePercent) ? roundTo(selectedPrintSurchargePercent, 4) : null,
              selected_print_unit_price_bs: Number.isFinite(selectedPrintUnitPriceBs) ? roundTo(selectedPrintUnitPriceBs, 2) : null,
              selected_print_material_surcharge_id: selectedPrintMaterialId || null,
              selected_print_material_product_id: selectedPrintMaterialProductId || null,
              selected_print_material_label: selectedPrintMaterialLabel || null,
              selected_print_material_rows: toServiceMaterialRowsPayload(selectedPrintMaterialRows),
              quantity: 0,
              unit_price_usd: Number(entry.unit_price_usd) || Number(service.price_usd) || 0,
              unit_price_base_amount: Number.isFinite(baseAmount) ? roundTo(baseAmount, 2) : null,
              unit_price_base_currency: baseCurrencyCode || null,
              agreed_price_display: entry.agreed_price_display || null,
              agreed_reference_name: entry.agreed_reference_name || null,
              agreed_reference_amount: Number(entry.agreed_reference_amount) || null,
              agreed_reference_symbol: entry.agreed_reference_symbol || null,
              recarga_base_amount: Number.isFinite(recargaBaseAmount) ? roundTo(recargaBaseAmount, 2) : null,
              recarga_total_amount: Number.isFinite(recargaTotalAmount) ? roundTo(recargaTotalAmount, 2) : null,
              recarga_profit_percent: Number.isFinite(recargaProfitPercent) ? roundTo(recargaProfitPercent, 4) : null,
              price_signature: signature || null,
              consumable_decisions: consumableDecisions,
            };

            existing.quantity += quantity;
            existing.delivery_presentation = deliveryPresentation || existing.delivery_presentation;
            existing.selected_print_coverage_id = selectedPrintCoverageId || existing.selected_print_coverage_id;
            existing.selected_print_coverage_percent = selectedPrintCoveragePercent || existing.selected_print_coverage_percent;
            existing.service_beneficiary_name = String(entry.service_beneficiary_name || existing.service_beneficiary_name || '').trim() || null;
            existing.service_responsible_name = String(entry.service_responsible_name || existing.service_responsible_name || '').trim() || null;
            existing.selected_print_price_bs = Number.isFinite(selectedPrintPriceBs)
              ? roundTo(selectedPrintPriceBs, 2)
              : existing.selected_print_price_bs;
            existing.selected_print_surcharge_percent = Number.isFinite(selectedPrintSurchargePercent)
              ? roundTo(selectedPrintSurchargePercent, 4)
              : existing.selected_print_surcharge_percent;
            existing.selected_print_unit_price_bs = Number.isFinite(selectedPrintUnitPriceBs)
              ? roundTo(selectedPrintUnitPriceBs, 2)
              : existing.selected_print_unit_price_bs;
            existing.selected_print_material_surcharge_id = selectedPrintMaterialId || existing.selected_print_material_surcharge_id;
            existing.selected_print_material_product_id = selectedPrintMaterialProductId || existing.selected_print_material_product_id;
            existing.selected_print_material_label = selectedPrintMaterialLabel || existing.selected_print_material_label;
            existing.selected_print_material_rows = selectedPrintMaterialRows.length > 0
              ? toServiceMaterialRowsPayload(selectedPrintMaterialRows)
              : (existing.selected_print_material_rows || []);
            existing.unit_price_usd = Number(entry.unit_price_usd) || existing.unit_price_usd;
            existing.unit_price_base_amount = Number.isFinite(baseAmount) ? roundTo(baseAmount, 2) : existing.unit_price_base_amount;
            existing.unit_price_base_currency = baseCurrencyCode || existing.unit_price_base_currency;
            existing.agreed_price_display = entry.agreed_price_display || existing.agreed_price_display;
            existing.agreed_reference_name = entry.agreed_reference_name || existing.agreed_reference_name;
            existing.agreed_reference_amount = Number(entry.agreed_reference_amount) || existing.agreed_reference_amount;
            existing.agreed_reference_symbol = entry.agreed_reference_symbol || existing.agreed_reference_symbol;
            existing.recarga_base_amount = Number.isFinite(recargaBaseAmount)
              ? roundTo(recargaBaseAmount, 2)
              : existing.recarga_base_amount;
            existing.recarga_total_amount = Number.isFinite(recargaTotalAmount)
              ? roundTo(recargaTotalAmount, 2)
              : existing.recarga_total_amount;
            existing.recarga_profit_percent = Number.isFinite(recargaProfitPercent)
              ? roundTo(recargaProfitPercent, 4)
              : existing.recarga_profit_percent;
            existing.price_signature = signature || existing.price_signature;
            existing.consumable_decisions = consumableDecisions.length > 0 ? consumableDecisions : (existing.consumable_decisions || []);

            cart.set(key, existing);
            return;
          }

          const productId = String(entry.product_id || '').trim();
          if (!productId || !productsById.has(productId)) return;

          const variationId = normalizeVariationId(entry.variation_id);
          const key = buildKey('product', productId, variationId);
          const existing = cart.get(key) || {
            itemType: 'product',
            productId,
            variationId,
            quantity: 0,
          };

          existing.quantity += quantity;
          cart.set(key, existing);
        });
      };

      const loadDraft = async (draftId) => {
        const safeId = String(draftId || '').trim();
        if (!safeId) return;

        const previousDraftId = activeDraftId;
        const previousDraftCreatedById = activeDraftCreatedById;
        const previousDraftVisibility = activeDraftVisibility;
        const previousDraftCheckoutStatus = activeDraftCheckoutStatus;
        draftLoadInProgress = true;
        let failedStage = 'solicitud del borrador';

        try {
          const response = await fetch(`/ventas/drafts/${encodeURIComponent(safeId)}`, {
            headers: {
              Accept: 'application/json',
            },
            credentials: 'same-origin',
          });
          const data = await response.json().catch(() => ({}));

          if (Array.isArray(data.products)) {
            syncProductsMap(data.products);
          }

          drafts = Array.isArray(data.drafts) ? data.drafts : drafts;

          if (!response.ok) {
            throw new Error(buildHttpErrorMessage({
              fallbackMessage: 'No se pudo obtener el borrador desde el servidor.',
              response,
              data,
              extraDetails: [`borrador: ${safeId}`],
            }));
          }

          const draft = data.draft || null;
          if (!draft) throw new Error('Borrador no disponible.');

          const draftBaseCurrency = draft?.state?.base_currency || 'USD';
          const draftVatMode = draft?.state?.vat_mode || 'none';

          failedStage = 'resolucion de servicios';
          await ensureServicesForDraft(draft);

          failedStage = 'hidratacion del carrito';
          hydrateDraftCart(draft);

          activeDraftId = String(draft.id || safeId);
          activeDraftCreatedById = Number(draft.created_by_id || 0) || null;
          activeDraftVisibility = String(draft.visibility || 'visible').toLowerCase() === 'hidden' ? 'hidden' : 'visible';
          activeDraftCheckoutStatus = normalizeDraftCheckoutStatus(draft.checkout_status, 'pending');
          failedStage = 'aplicacion de configuracion';
          setBaseCurrencySelection(draftBaseCurrency);
          setVatModeSelection(draftVatMode, { render: false });

          const draftClient = draft.client;
          if (draftClient && draftClient.id) {
            setSelectedClient({
              id: draftClient.id,
              name: draftClient.name,
              document: draftClient.document,
              phone: draftClient.phone || '',
              benefits: parseClientBenefits(draftClient.benefits || {}),
            });
          } else {
            setSelectedClient(null);
          }

          draftSyncedFingerprint = buildDraftFingerprint();
          applySyncedReservationSnapshot(buildProductReservationSnapshot());
          renderDraftTags();
          failedStage = 'render del panel';
          renderCart();

          if (window.Swal) {
            window.Swal.fire({
              icon: 'success',
              title: 'Borrador cargado',
              text: 'Se cargo la factura en proceso seleccionada.',
              heightAuto: false,
            });
          }
        } catch (error) {
          activeDraftId = previousDraftId;
          activeDraftCreatedById = previousDraftCreatedById;
          activeDraftVisibility = previousDraftVisibility;
          activeDraftCheckoutStatus = previousDraftCheckoutStatus;
          const detailedMessage = buildDraftLoadErrorMessage({ draftId: safeId, stage: failedStage, error });
          console.error('Error cargando borrador', {
            draftId: safeId,
            stage: failedStage,
            error,
          });
          if (window.Swal) {
            window.Swal.fire({
              icon: 'error',
              title: 'No se pudo cargar',
              text: detailedMessage,
              heightAuto: false,
            });
          }
        } finally {
          draftLoadInProgress = false;
        }
      };

      if (saveDraftButton) {
        saveDraftButton.addEventListener('click', () => {
          persistDraft({ clearAfterSave: true, draftVisibility: 'visible' });
        });
      }

      if (draftsReadyFilterButton) {
        draftsReadyFilterButton.addEventListener('click', async () => {
          const activeStatus = normalizeDraftCheckoutStatus(activeDraftCheckoutStatus, 'pending');
          if (activeDraftId && activeStatus !== 'ready') {
            const closed = await closeActiveDraftPreservingState();
            if (!closed) return;
          }
          draftListFilter = 'ready';
          renderDraftTags();
        });
      }

      if (draftsPendingFilterButton) {
        draftsPendingFilterButton.addEventListener('click', async () => {
          const activeStatus = normalizeDraftCheckoutStatus(activeDraftCheckoutStatus, 'pending');
          if (activeDraftId && activeStatus !== 'pending') {
            const closed = await closeActiveDraftPreservingState();
            if (!closed) return;
          }
          draftListFilter = 'pending';
          renderDraftTags();
        });
      }

      if (clearPanelButton) {
        clearPanelButton.addEventListener('click', () => {
          promptClearWorkingSale();
        });
      }

      if (draftsListEl) {
        draftsListEl.addEventListener('click', (event) => {
          const button = event.target.closest('button[data-draft-id]');
          if (!button) return;
          loadDraft(button.dataset.draftId);
        });
      }

      if (clientSearchInput) {
        clientSearchInput.addEventListener('input', () => {
          const query = clientSearchInput.value.trim();
          if (clientSearchTimeout) clearTimeout(clientSearchTimeout);
          clientSearchTimeout = setTimeout(() => searchClients(query), 250);
        });

        clientSearchInput.addEventListener('focus', () => {
          const query = clientSearchInput.value.trim();
          if (query.length > 0) searchClients(query);
        });
      }

      if (clientAddButton) {
        clientAddButton.addEventListener('click', () => {
          const presetName = clientSearchInput ? clientSearchInput.value.trim() : '';
          openClientModal(presetName);
        });
      }

      if (clientList) {
        clientList.addEventListener('click', (event) => {
          const button = event.target.closest('button[data-client-id]');
          if (!button) return;
          setSelectedClient({
            id: button.dataset.clientId,
            name: button.dataset.clientName,
            document: button.dataset.clientDoc,
            phone: button.dataset.clientPhone || '',
            benefits: parseClientBenefits(button.dataset.clientBenefits),
          });
          hideClientResults();
        });
      }

      if (clientClear) {
        clientClear.addEventListener('click', () => {
          setSelectedClient(null);
        });
      }

      document.addEventListener('click', (event) => {
        if (!clientResults || clientResults.classList.contains('hidden')) return;
        if (clientResults.contains(event.target)) return;
        if (clientSearchInput && clientSearchInput.contains(event.target)) return;
        hideClientResults();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) return;
        refreshLiveProducts({ silent: true });
      });

      setSelectedClient(null);
      renderDraftTags();
      renderCart();
      updateAvailabilityUI();
      startLiveProductsSync();
      refreshLiveProducts({ silent: true });
    };

    if (!window.ventasPosInitHooked) {
      document.addEventListener('DOMContentLoaded', initVentasPOS);
      document.addEventListener('turbo:load', initVentasPOS);
      window.ventasPosInitHooked = true;
    }

    // Run immediately in case the script is evaluated after DOM is already ready.
    initVentasPOS();
  })();
</script>
