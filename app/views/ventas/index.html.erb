<% bcv_rate = (@tasa_dolar_bcv || 0).to_d %>
<% product_categories = @productos.each_with_object(Hash.new(0)) do |producto, counts|
                        categoria_nombre = producto.categoria&.nombre.to_s.strip
                        next if categoria_nombre.blank?

                        counts[categoria_nombre] += 1
                      end.sort_by { |nombre, _cantidad| nombre.downcase } %>
<% visible_services = @services.select do |service|
                       payload = @services_payload_by_id[service.id] || {}
                       price_usd_value = payload[:price_usd].present? ? payload[:price_usd].to_d : nil
                       price_on_request = payload[:price_on_request] == true

                       service.available? && (price_on_request || price_usd_value&.positive?)
                     end %>
<% service_systems = visible_services.each_with_object(Hash.new(0)) do |service, counts|
                       system_name = service.system_service&.name.to_s.strip
                       next if system_name.blank?

                       counts[system_name] += 1
                     end.sort_by { |nombre, _cantidad| nombre.downcase } %>
<% can_manage_cash_shifts = can_manage_action?(:manage_cash_shifts) %>
<div id="ventas-pos-root" class="space-y-8" data-bcv-rate="<%= @tasa_dolar_bcv.to_s %>" data-open-shift="<%= @open_cash_shift.present? %>" data-open-shift-id="<%= @open_cash_shift&.id %>">
  <div class="ventas-theme-hero relative overflow-hidden rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="ventas-theme-hero-orb-primary absolute -top-16 right-0 h-48 w-48 rounded-full bg-cyan-200/30 blur-3xl"></div>
    <div class="ventas-theme-hero-orb-secondary absolute bottom-0 left-1/3 h-32 w-32 rounded-full bg-sky-200/30 blur-2xl"></div>
    <div class="relative flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
      <div class="max-w-2xl">
        <span class="ventas-theme-hero-kicker inline-flex items-center gap-2 rounded-full border border-sky-200 bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-sky-700 shadow-sm backdrop-blur">
          <i data-lucide="scan-line" class="h-3.5 w-3.5"></i>
          POS activo
        </span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-800 md:text-4xl">Ventas</h1>
        <p class="mt-2 max-w-xl text-sm leading-6 text-slate-600 md:text-base">Construye la orden, alterna entre productos y servicios y cierra el cobro con una interfaz m&aacute;s clara, viva y consistente con la paleta del sistema.</p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:flex-row sm:flex-wrap xl:w-auto xl:justify-end">
        <% if @open_cash_shift.present? %>
          <%= link_to cash_shift_path(@open_cash_shift), class: "inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-emerald-100" do %>
            <i data-lucide="clock-3" class="h-4 w-4"></i>
            Turno #<%= @open_cash_shift.id %> abierto
          <% end %>
        <% elsif can_manage_cash_shifts %>
          <button type="button"
                  id="ventas-open-cash-shift-trigger"
                  data-create-url="<%= cash_shifts_path %>"
                  class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-amber-100">
            <i data-lucide="play" class="h-4 w-4"></i>
            Abrir turno para facturar
          </button>
        <% else %>
          <span class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-slate-100 px-4 py-3 text-xs font-semibold text-slate-600">
            Espera al encargado para abrir turno
          </span>
        <% end %>
        <%= link_to historial_ventas_path, class: "inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-slate-900 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-200 transition-all hover:-translate-y-0.5 hover:bg-slate-800" do %>
          <i data-lucide="list" class="h-4 w-4"></i>
          Historial
        <% end %>
      </div>
    </div>
  </div>
  <script>
    (() => {
      const initVentasOpenShiftCTA = () => {
        const trigger = document.getElementById('ventas-open-cash-shift-trigger');
        if (!trigger || trigger.dataset.boundOpenModal === 'true') return;

        trigger.dataset.boundOpenModal = 'true';

        const escapeHtml = (value) => String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');

        const formatAmount = (value, symbol) => {
          const parsed = Number(value || 0);
          const amount = Number.isFinite(parsed)
            ? parsed.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
            : '0,00';
          return `${symbol || ''} ${amount}`.trim();
        };

        const formatDateLabel = (rawDate) => {
          const text = String(rawDate || '').trim();
          if (!text) return 'Sin fecha';

          const matchIso = text.match(/^(\d{4})-(\d{2})-(\d{2})/);
          if (matchIso) return `${matchIso[3]}-${matchIso[2]}-${matchIso[1]}`;

          const parsed = new Date(text);
          if (Number.isNaN(parsed.getTime())) return text;

          const day = String(parsed.getDate()).padStart(2, '0');
          const month = String(parsed.getMonth() + 1).padStart(2, '0');
          const year = String(parsed.getFullYear());
          return `${day}-${month}-${year}`;
        };

        const buildRatesHtml = (snapshot) => {
          const safeSnapshot = snapshot && typeof snapshot === 'object' ? snapshot : {};
          const bcvRates = Array.isArray(safeSnapshot.bcv_rates) ? safeSnapshot.bcv_rates : [];
          const otherRates = Array.isArray(safeSnapshot.other_rates) ? safeSnapshot.other_rates : [];

          const bcvSection = bcvRates.length > 0
            ? `
              <div class="mt-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-left">
                <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Tasas BCV activas</p>
                <ul class="mt-2 space-y-1 text-xs text-slate-700">
                  ${bcvRates.map((rate) => {
                    const label = escapeHtml(rate.description || 'Tasa BCV');
                    const amount = escapeHtml(formatAmount(rate.value, rate.symbol || ''));
                    const referenceDate = escapeHtml(formatDateLabel(rate.fecha_referencia));
                    return `<li><strong>${label}:</strong> ${amount} <span class="text-slate-500">(ref. ${referenceDate})</span></li>`;
                  }).join('')}
                </ul>
              </div>
            `
            : '';

          const otherSection = otherRates.length > 0
            ? `
              <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-3 text-left">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Otras tasas</p>
                <ul class="mt-2 max-h-44 space-y-1 overflow-y-auto pr-1 text-xs text-slate-700">
                  ${otherRates.map((rate) => {
                    const label = escapeHtml(rate.description || 'Tasa');
                    const amount = escapeHtml(formatAmount(rate.value, rate.symbol || ''));
                    const updatedDate = escapeHtml(formatDateLabel(rate.updated_at));
                    return `<li><strong>${label}:</strong> ${amount} <span class="text-slate-500">(act. ${updatedDate})</span></li>`;
                  }).join('')}
                </ul>
              </div>
            `
            : '';

          return `${bcvSection}${otherSection}`;
        };

        const extractShiftIdFromUrl = (url) => {
          const match = String(url || '').match(/\/cash_shifts\/(\d+)/);
          return match ? match[1] : '';
        };

        const promoteOpenShiftCTA = (shiftUrl, shiftIdValue = '') => {
          if (!shiftUrl || !trigger) return;

          const shiftId = String(shiftIdValue || extractShiftIdFromUrl(shiftUrl)).trim();
          const link = document.createElement('a');
          link.href = shiftUrl;
          link.className = 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-emerald-100';
          link.innerHTML = `<i data-lucide="clock-3" class="h-4 w-4"></i> ${shiftId ? `Turno #${escapeHtml(shiftId)} abierto` : 'Turno abierto'}`;

          trigger.replaceWith(link);
          if (window.lucide?.createIcons) {
            window.lucide.createIcons();
          }
        };

        const openShift = async () => {
          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
          if (!csrfToken) {
            if (window.Swal) {
              window.Swal.fire({
                icon: 'error',
                title: 'Token CSRF no disponible',
                text: 'Recarga la pagina e intenta de nuevo.',
                heightAuto: false,
              });
            }
            return;
          }

          if (window.Swal) {
            window.Swal.fire({
              title: 'Actualizando tasas BCV',
              html: '<p class="text-sm text-slate-600">Espere un momento, se estan actualizando las tasas.</p>',
              allowOutsideClick: false,
              allowEscapeKey: false,
              showConfirmButton: false,
              heightAuto: false,
              didOpen: () => {
                window.Swal.showLoading();
              },
            });
          } else if (!window.confirm('Se actualizaran las tasas BCV y luego se abrira el turno. Deseas continuar?')) {
            return;
          }

          try {
            const response = await fetch(trigger.dataset.createUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
                'X-CSRF-Token': csrfToken,
              },
              credentials: 'same-origin',
              body: JSON.stringify({}),
            });

            const data = await response.json().catch(() => ({}));
            const cashShiftUrl = String(data.cash_shift_url || '').trim();
            const cashShiftId = String(data.cash_shift_id || '').trim();

            if (!response.ok || !data.success) {
              const existingOpenShift = /ya existe un turno abierto/i.test(String(data.error || ''));
              if (existingOpenShift) {
                if (window.Swal) {
                  const existingResult = await window.Swal.fire({
                    icon: 'info',
                    title: 'Ya hay un turno abierto',
                    text: 'Puedes seguir facturando o abrir el detalle del turno activo.',
                    confirmButtonText: 'Ver turno',
                    showCancelButton: true,
                    cancelButtonText: 'Cerrar',
                    heightAuto: false,
                  });

                  if (existingResult.isConfirmed && cashShiftUrl) {
                    window.location.href = cashShiftUrl;
                    return;
                  }

                  if (cashShiftUrl) {
                    promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
                  }
                  return;
                }

                if (window.confirm('Ya hay un turno abierto. Deseas ver su detalle?')) {
                  if (cashShiftUrl) {
                    window.location.href = cashShiftUrl;
                  }
                  return;
                }

                if (cashShiftUrl) {
                  promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
                }
                return;
              }

              throw new Error(String(data.error || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.'));
            }

            const scraperStatus = String(data.scraper_status || '').trim();
            const resultText = scraperStatus === 'up_to_date'
              ? 'Las tasas ya estan actualizadas y el turno se abrio correctamente.'
              : 'Las tasas han sido actualizadas y el turno se abrio correctamente.';
            const ratesHtml = buildRatesHtml(data.rates_snapshot);

            if (window.Swal) {
              const result = await window.Swal.fire({
                icon: 'success',
                title: 'Turno abierto',
                html: `<p class="text-sm text-slate-600">${escapeHtml(resultText)}</p>${ratesHtml}`,
                confirmButtonText: 'Ver turno',
                showCancelButton: true,
                cancelButtonText: 'Cerrar',
                heightAuto: false,
              });

              if (result.isConfirmed && cashShiftUrl) {
                window.location.href = cashShiftUrl;
                return;
              }

              if (cashShiftUrl) {
                promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
              }
              return;
            }

            if (window.confirm(`${resultText}\n\nDeseas ver el turno abierto ahora?`)) {
              if (cashShiftUrl) {
                window.location.href = cashShiftUrl;
              }
              return;
            }

            if (cashShiftUrl) {
              promoteOpenShiftCTA(cashShiftUrl, cashShiftId);
            }
          } catch (error) {
            if (window.Swal) {
              await window.Swal.fire({
                icon: 'error',
                title: 'No se pudo abrir el turno',
                text: error.message || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.',
                heightAuto: false,
              });
            } else {
              window.alert(error.message || 'No se pudo actualizar correctamente alguna tasa BCV. Intente de nuevo o comuniquese con el administrador.');
            }
          }
        };

        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          openShift();
        });
      };

      document.addEventListener('turbo:load', initVentasOpenShiftCTA);
      document.addEventListener('DOMContentLoaded', initVentasOpenShiftCTA);
    })();
  </script>
  <script type="application/json" id="ventas-products-data">
    <%= raw ERB::Util.json_escape(@products_payload.to_json) %>
  </script>
  <script type="application/json" id="ventas-accounts-data">
    <%= raw ERB::Util.json_escape(@accounts_payload.to_json) %>
  </script>
  <script type="application/json" id="ventas-drafts-data">
    <%= raw ERB::Util.json_escape(@drafts_payload.to_json) %>
  </script>
  <script type="application/json" id="ventas-services-data">
    <%= raw ERB::Util.json_escape(@services_payload.to_json) %>
  </script>
  <section id="tab-ventas" class="fade-in">
    <div class="flex flex-col lg:flex-row gap-6 h-full">
      <div class="lg:w-2/3 space-y-6">
        <div class="rounded-3xl border border-slate-200 bg-white/95 p-4 shadow-sm sm:p-5">
          <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
            <div class="w-full max-w-xl">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Explorador de venta</p>
              <div class="relative mt-2 flex-1">
                <input id="ventas-item-search" type="text" placeholder="Buscar productos o servicios" class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 px-4 py-3 pr-11 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:bg-white focus:ring-sky-500">
                <button id="ventas-item-search-clear" type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 inline-flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-700" aria-label="Limpiar busqueda">
                  <i data-lucide="x" class="h-4 w-4"></i>
                </button>
              </div>
            </div>
            <div class="flex flex-col gap-3 xl:items-end">
              <p class="text-xs text-slate-500">Filtra r&aacute;pido y cambia entre cat&aacute;logos sin perder el contexto de la orden.</p>
              <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 p-1.5 shadow-inner shadow-slate-100">
                <button type="button" data-ventas-tab="products" class="ventas-tab rounded-full border border-sky-600 bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-sky-200">Productos</button>
                <button type="button" data-ventas-tab="services" class="ventas-tab rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600">Servicios</button>
              </div>
            </div>
          </div>
        </div>
        <div id="ventas-product-panel" class="space-y-4 rounded-3xl border border-slate-200 bg-white/95 p-4 shadow-sm sm:p-5">
          <% if @productos.any? %>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Cat&aacute;logo de productos</p>
                <h2 class="mt-1 text-lg font-bold text-slate-800">Selecciona productos para sumarlos a la orden</h2>
              </div>
              <span class="inline-flex items-center gap-2 rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700 ring-1 ring-sky-100">
                <i data-lucide="boxes" class="h-3.5 w-3.5"></i>
                <%= @productos.size %> disponibles
              </span>
            </div>
            <% if product_categories.any? %>
              <div class="rounded-2xl border border-cyan-100 bg-cyan-50/60 p-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Categorias activas</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  <button type="button" data-product-category-filter="" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-sky-600 bg-sky-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">
                    <span>Todas</span>
                    <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-white/20 px-1.5 py-0.5 text-[11px] font-bold text-white"><%= @productos.size %></span>
                  </button>
                  <% product_categories.each do |nombre_categoria, cantidad_items| %>
                    <button type="button" data-product-category-filter="<%= nombre_categoria %>" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-cyan-200 bg-white px-3 py-1 text-xs font-semibold text-cyan-700 ring-1 ring-cyan-200 transition-colors hover:bg-cyan-50">
                      <span class="max-w-[10rem] truncate"><%= nombre_categoria %></span>
                      <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-cyan-100 px-1.5 py-0.5 text-[11px] font-bold text-cyan-700"><%= cantidad_items %></span>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
            <div id="ventas-product-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4">
              <% @productos.each do |producto| %>
                <% payload = @products_payload_by_id[producto.id] || {} %>
                <% available_total = payload[:available_total].to_d %>
                <% price_usd_value = payload[:price_usd].present? ? payload[:price_usd].to_d : producto.precio_venta_usd.to_d %>
                <% price_bs = bcv_rate.positive? ? (price_usd_value * bcv_rate) : nil %>
                <% variations = producto.product_variations.sort_by(&:id) %>
                <% variation_names = variations.map(&:description) %>
                <% variation_rows = Array(payload[:variations]) %>
                <% available_variation_rows = variation_rows.select { |row| (row[:available] || row['available']).to_d.positive? } %>
                <% available_variation_names = available_variation_rows.map { |row| (row[:name] || row['name']).to_s.strip }.reject(&:blank?) %>
                <% visible_variations = available_variation_names.first(3) %>
                <% extra_count = [available_variation_names.size - visible_variations.size, 0].max %>
                <% product_query = ([producto.descripcion] + variation_names).join(' ').downcase %>
                <% stock_badge_class = if available_total <= 0
                                         'bg-rose-100 text-rose-700 ring-1 ring-rose-200'
                                       elsif available_total < 6
                                         'bg-amber-100 text-amber-700 ring-1 ring-amber-200'
                                       else
                                         'bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200'
                                       end %>
                <% product_card_class = if available_total <= 0
                                          'border-rose-200'
                                        elsif available_total < 6
                                          'border-amber-200'
                                        else
                                          'border-sky-100'
                                        end %>
                <article class="ventas-product-card glass-card group relative overflow-hidden rounded-3xl border <%= product_card_class %> bg-white/95 p-3 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-100/60 active:scale-[0.98] <%= available_total.positive? ? 'cursor-pointer' : 'cursor-not-allowed' %>" data-product-id="<%= producto.id %>" data-product-query="<%= product_query %>" data-product-category="<%= producto.categoria&.nombre.to_s %>">
                  <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-r from-sky-100/70 via-cyan-50/60 to-white/0"></div>
                  <div class="relative">
                    <div class="flex items-start justify-between gap-2">
                      <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-semibold <%= stock_badge_class %>">
                        <i data-lucide="activity" class="h-3 w-3"></i>
                        Disp: <span data-product-stock="<%= producto.id %>"><%= format_quantity(available_total, precision: 0) %></span>
                      </span>
                      <span class="rounded-full bg-slate-900/5 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-slate-500" data-product-variation-count="<%= producto.id %>">
                        <%= available_variation_names.size %> var.
                      </span>
                    </div>
                    <div class="relative mt-3 aspect-square overflow-hidden rounded-2xl border border-white/80 bg-slate-50 flex items-center justify-center text-slate-300 transition-transform group-hover:scale-[1.02]">
                      <% if producto.foto.attached? %>
                        <%= image_tag producto.foto, class: 'h-full w-full object-cover', alt: producto.descripcion.to_s %>
                      <% else %>
                        <i data-lucide="package" class="w-12 h-12"></i>
                      <% end %>
                      <div class="pointer-events-none absolute inset-0 <%= available_total.positive? ? 'hidden' : 'flex' %> items-center justify-center overflow-hidden rounded-2xl" data-out-of-stock>
                        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/65 via-rose-900/55 to-orange-700/45 backdrop-blur-[2px]"></div>
                        <div class="absolute left-1/2 top-[14%] z-10 -translate-x-1/2 rounded-full bg-rose-500/95 px-6 py-1.5 text-center text-[10px] font-extrabold uppercase tracking-[0.2em] text-white shadow-lg shadow-rose-900/45 ring-1 ring-white/25 animate-pulse">
                          Agotado
                        </div>
                        <div class="relative z-10 flex h-full w-full flex-col items-center justify-center gap-1.5 text-center text-white">
                          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/20 ring-1 ring-white/40">
                            <i data-lucide="ban" class="h-5 w-5"></i>
                          </span>
                          <p class="text-[11px] font-extrabold uppercase tracking-[0.18em]">Sin stock</p>
                          <p class="text-[10px] font-medium text-white/85">Proximamente disponible</p>
                        </div>
                      </div>
                    </div>
                    <div class="px-1 pt-3">
                      <h3 class="font-bold text-slate-800 text-sm truncate"><%= producto.descripcion.to_s %></h3>
                      <div class="mt-2 flex flex-wrap gap-1 min-h-[1.5rem]" data-product-variations="<%= producto.id %>">
                        <% if visible_variations.any? %>
                          <% visible_variations.each do |variation_name| %>
                            <span class="max-w-[5.5rem] truncate rounded-full bg-cyan-50 px-2 py-0.5 text-[10px] font-semibold text-cyan-700 ring-1 ring-cyan-100">
                              <%= variation_name %>
                            </span>
                          <% end %>
                          <% if extra_count.positive? %>
                            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600 ring-1 ring-slate-200">+<%= extra_count %></span>
                          <% end %>
