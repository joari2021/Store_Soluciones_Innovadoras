<% draft = @draft %>
<% draft_items = @draft_items || [] %>
<div class="space-y-6 fade-in">
  <div class="relative overflow-hidden rounded-3xl border border-cyan-100 bg-gradient-to-r from-cyan-50 via-white to-sky-50 p-5 shadow-sm md:p-6">
    <div class="absolute -top-16 right-0 h-48 w-48 rounded-full bg-cyan-200/30 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 h-32 w-32 rounded-full bg-sky-200/30 blur-2xl"></div>
    <div class="relative flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-cyan-700 shadow-sm backdrop-blur">
          <i data-lucide="file-text" class="h-3.5 w-3.5"></i>
          Detalle de borrador
        </span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-800 md:text-4xl">Borrador #<%= draft.id %></h1>
        <p class="mt-2 max-w-xl text-sm leading-6 text-slate-600 md:text-base">Solo consulta y eliminación. Este detalle no permite edición directa.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to borradores_ventas_path, class: "inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50 md:w-auto" do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Volver a borradores
        <% end %>
        <%= button_to destroy_borrador_venta_path(draft), method: :delete, form: { data: { turbo_confirm: '¿Seguro que deseas eliminar este borrador?' } }, class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-rose-600 px-5 py-3 font-medium text-white shadow-sm transition-colors hover:bg-rose-500 md:w-auto' do %>
          <i data-lucide="trash-2" class="h-4 w-4"></i>
          Eliminar borrador
        <% end %>
      </div>
    </div>
    <div class="relative mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Cliente</p>
        <p class="mt-2 text-lg font-bold text-slate-800"><%= draft.cliente_display_name %></p>
      </div>
      <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Items</p>
        <p class="mt-2 text-2xl font-extrabold text-slate-800"><%= draft_items.size %></p>
      </div>
      <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Moneda base</p>
        <p class="mt-2 text-2xl font-extrabold text-slate-800"><%= draft.base_currency %></p>
      </div>
      <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Actualizado</p>
        <p class="mt-2 text-lg font-bold text-slate-800"><%= draft.updated_at.strftime('%d/%m/%Y %H:%M') %></p>
      </div>
    </div>
  </div>
  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-sky-100 bg-sky-50/70 px-6 py-4">
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-600">Items del borrador</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm text-slate-700">
        <thead class="border-b border-sky-100 bg-sky-50/40 text-xs font-bold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-4">Descripcion</th>
            <th class="px-6 py-4">Variacion</th>
            <th class="px-6 py-4 text-right">Cantidad</th>
            <th class="px-6 py-4 text-right">Unitario USD</th>
            <th class="px-6 py-4 text-right">Subtotal USD</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% draft_items.each do |item| %>
            <tr class="transition-all duration-150 hover:bg-slate-50/70">
              <td class="px-6 py-4">
                <p class="font-semibold text-slate-800"><%= item.product_name.presence || item.producto&.descripcion || 'Item' %></p>
              </td>
              <td class="px-6 py-4 text-slate-600"><%= item.variation_name.presence || item.product_variation&.description || '-' %></td>
              <td class="px-6 py-4 text-right font-semibold text-slate-700"><%= format_quantity(item.quantity, precision: 2) %></td>
              <td class="px-6 py-4 text-right text-slate-700"><%= format_money(item.unit_price_usd.to_d, unit: '$') %></td>
              <td class="px-6 py-4 text-right font-semibold text-slate-800"><%= format_money(item.subtotal_usd.to_d, unit: '$') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
