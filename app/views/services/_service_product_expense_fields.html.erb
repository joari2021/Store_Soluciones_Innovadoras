<div class="rounded-xl border border-slate-200 bg-white p-3" data-nested-row data-nested-persisted="<%= f.object.persisted? %>">
  <%= f.hidden_field :_destroy, data: { destroy_input: true } %>
  <%= f.select :producto_id,
               products_options_for_select(
                 products: products,
                 bcv_rate: bcv_rate,
                 selected_id: f.object.producto_id
               ),
               { include_blank: "Selecciona producto" },
               class: "hidden",
               data: { product_select: true } %>
  <div class="grid gap-3 md:grid-cols-6">
    <div class="md:col-span-2">
      <% selected_product_name = f.object.producto&.descripcion.to_s.strip %>
      <%= f.label :producto_id, "Producto de consumo", class: "block text-xs font-semibold uppercase tracking-wide text-slate-500" %>
      <div class="relative mt-1">
        <input type="search"
               class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500"
               placeholder="Buscar producto"
               autocomplete="off"
               value="<%= selected_product_name %>"
               data-product-search>
        <div class="absolute z-30 mt-2 hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg" data-product-results></div>
      </div>
      <p class="mt-2 text-xs text-slate-500" data-product-selected-label>
        <%= selected_product_name.present? ? "Seleccionado: #{selected_product_name}" : "Sin producto seleccionado" %>
      </p>
    </div>
    <div class="md:col-span-2">
      <% selected_variation_name = f.object.product_variation&.description.to_s.strip %>
      <%= f.label :product_variation_id, "Variacion", class: "block text-xs font-semibold uppercase tracking-wide text-slate-500" %>
      <%= f.select :product_variation_id,
                   product_variation_options_for_select(
                     product: f.object.producto,
                     selected_id: f.object.product_variation_id
                   ),
                   { include_blank: "Selecciona variacion" },
                   class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                   data: { product_variation_select: true } %>
      <p class="mt-1 text-xs text-slate-500" data-product-variation-hint>
        <%= selected_variation_name.present? ? "Variacion seleccionada: #{selected_variation_name}" : "Selecciona un producto para ver variaciones." %>
      </p>
    </div>
    <div>
      <%= f.label :quantity, "Cantidad", class: "block text-xs font-semibold uppercase tracking-wide text-slate-500" %>
      <%= f.number_field :quantity,
                         step: "0.01",
                         min: "0.01",
                         value: plain_decimal_input_value(f.object.quantity, default: 1),
                         class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                         data: { product_qty: true, disable_number_steppers: true } %>
    </div>
    <div>
      <p class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Subtotal</p>
      <p class="mt-2 text-sm font-semibold text-slate-700" data-line-total-usd>$ 0,00</p>
      <p class="text-xs text-slate-500" data-line-total-bs>Bs 0,00</p>
    </div>
  </div>
  <div class="mt-3 flex justify-end">
    <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100" data-remove-nested-row>
      Eliminar
    </button>
  </div>
</div>
