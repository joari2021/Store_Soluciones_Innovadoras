<div class="field_service_manager rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
  <% latest_reference_costs = TasaCambio.latest_by_description(excluding: ['Unidad VI']) %>
  <div class="grid gap-3 md:grid-cols-3">
    <div>
      <%= m.label :manager_id, "Manager", class: "block text-sm font-medium text-slate-700" %>
      <%= m.collection_select :manager_id, Manager.all.order(:name), :id, :name, {}, { class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" } %>
    </div>
    <div>
      <%= m.label :reference_cost, "Tasa dolar del costo", class: "block text-sm font-medium text-slate-700" %>
      <%= m.select :reference_cost,
        options_for_select(
          latest_reference_costs.map { |tasa| [tasa.description, tasa.description] },
          m.object.reference_cost
        ),
        {},
        class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
        data: { action: "change->form-services#updateCostLabel", reference_cost: true } %>
    </div>
    <div>
      <%= m.label :cost, "Costo", class: "block text-sm font-medium text-slate-700", data: { cost_label: true } %>
      <%= m.number_field :cost, step: "0.01", min: "0", class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500", data: { action: "input->form-services#updateCostLabel", cost_input: true } %>
    </div>
  </div>
  <div class="mt-3 flex items-center justify-between">
    <%= m.hidden_field :_destroy %>
    <span class="text-xs text-slate-400">Marca si deseas eliminar este gestor.</span>
    <%= link_to "Eliminar", '#', class: "remove_fields_service_manager inline-flex items-center gap-2 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100" %>
  </div>
</div>
