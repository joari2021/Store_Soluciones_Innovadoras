<% tasa_dolar = @tasa_dolar_bcv.is_a?(Numeric) ? @tasa_dolar_bcv.to_d : nil %>
<% unidad_vi = @unidad_VI.is_a?(Numeric) ? @unidad_VI.to_d : nil %>
<div class="services-modal-content space-y-6 text-slate-700">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <% primary_price_label = service_primary_price_label(service, tasa_dolar: tasa_dolar, unidad_vi: unidad_vi) %>
    <% reference_price_label = service_reference_price_label(service, tasa_dolar: tasa_dolar, unidad_vi: unidad_vi) %>
    <% price_reference_name = service_reference_name(service) %>
    <div class="services-price-card flex-1">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Precio</p>
      <div class="mt-2 flex flex-wrap items-baseline gap-2 text-slate-800" data-service-price>
        <% if service.to_agree? %>
          <span class="text-2xl font-extrabold text-amber-600">A convenir</span>
          <span class="text-sm text-slate-500">Se define durante la factura</span>
        <% elsif primary_price_label.present? %>
          <span class="text-2xl font-extrabold"><%= primary_price_label %></span>
          <% if reference_price_label.present? %>
            <span class="text-sm text-slate-500">(<%= reference_price_label %>)</span>
          <% end %>
        <% else %>
          <span class="text-sm text-amber-600">Precio no disponible</span>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-slate-500">Modo: <%= service.to_agree? ? 'A convenir' : 'Precio fijo' %></p>
      <% unless service.to_agree? %>
        <p class="text-xs text-slate-500">Referencia: <%= price_reference_name.presence || '-' %></p>
      <% end %>
    </div>
    <button type="button" class="services-copy-btn" id="copy-service-modal" data-service-copy>
      <i data-lucide="copy" class="h-4 w-4"></i>
      Copiar informacion
    </button>
  </div>
  <% if service.cost && service.service_expense_structures.any? %>
    <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Costos asociados</p>
        <p class="text-sm text-slate-500">Estructuras de gastos vinculadas al servicio.</p>
      </div>
      <div class="mt-3 space-y-2">
        <% service.service_expense_structures.each do |structure| %>
          <% structure_usd = structure.total_usd(tasa_dolar: tasa_dolar, unidad_vi: unidad_vi) %>
          <% structure_bs = structure.total_bs(tasa_dolar: tasa_dolar, unidad_vi: unidad_vi) %>
          <div class="space-y-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2">
            <p class="truncate text-sm font-semibold text-slate-700"><%= structure.description %></p>
            <div class="flex items-center justify-between gap-2 text-sm">
              <span class="text-slate-500">$ BCV</span>
              <span class="font-semibold text-slate-700"><%= format_money(structure_usd, unit: "$ ") %></span>
            </div>
            <div class="flex items-center justify-between gap-2 text-sm">
              <span class="text-slate-500">Bs</span>
              <span class="font-semibold text-slate-700"><%= format_money(structure_bs, unit: "Bs ") %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="grid gap-4 md:grid-cols-2">
    <% if service.physical_requirements.present? %>
      <div class="services-section-card services-section--warning" data-service-section data-title="📄 REQUISITOS FISICOS">
        <p class="services-section-title">Requisitos fisicos</p>
        <div class="services-section-body" data-service-text><%= simple_format(service.physical_requirements) %></div>
      </div>
    <% end %>
    <% if service.digital_requirements.present? %>
      <div class="services-section-card services-section--warning" data-service-section data-title="📷 REQUISITOS DIGITALES (FOTOS O ESCANEOS)">
        <p class="services-section-title">Requisitos digitales</p>
        <div class="services-section-body" data-service-text><%= simple_format(service.digital_requirements) %></div>
      </div>
    <% end %>
    <% if service.required_data.present? %>
      <div class="services-section-card services-section--info" id="required-data-card" data-service-section data-title="📝 DATOS REQUERIDOS" data-format="required-data">
        <p class="services-section-title">Datos requeridos</p>
        <div class="services-section-body" data-service-text><%= simple_format(service.required_data) %></div>
      </div>
    <% end %>
    <% if service.delivery_time.present? %>
      <div class="services-section-card services-section--neutral" data-service-section data-title="⏰ TIEMPO DE ENTREGA" data-format="inline">
        <p class="services-section-title">Tiempo de entrega</p>
        <div class="services-section-body" data-service-text><%= simple_format(service.delivery_time) %></div>
      </div>
    <% end %>
    <% if service.delivery_content.present? %>
      <div class="services-section-card services-section--success" data-service-section data-title="📬 EL CLIENTE RECIBIRA">
        <p class="services-section-title">El cliente recibira</p>
        <div class="services-section-body" data-service-text><%= simple_format(service.delivery_content) %></div>
      </div>
    <% end %>
    <% if service.note.present? %>
      <div class="services-section-card services-section--danger" data-service-section data-title="⚠️ NOTA" data-format="inline">
        <p class="services-section-title">Nota</p>
        <div class="services-section-body" data-service-text><%= simple_format(service.note) %></div>
      </div>
    <% end %>
    <% if service.personal_steps.present? %>
      <div class="services-section-card services-section--info" data-service-section data-title="👤 PASOS A SEGUIR (SOLO PERSONAL)" data-copy="false" data-no-copy="true" id="personal-steps-card">
        <p class="services-section-title">Pasos a seguir (solo personal)</p>
        <div class="services-section-body" data-service-text><%= simple_format(service.personal_steps) %></div>
      </div>
    <% end %>
  </div>
</div>