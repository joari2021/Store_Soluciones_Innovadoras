<%= render "services/styles" %>
<div class="services-scope space-y-6">
  <div class="services-hero relative overflow-hidden rounded-3xl border border-slate-200 bg-white/80 p-6 shadow-sm">
    <div class="services-hero-glow services-hero-glow--one"></div>
    <div class="services-hero-glow services-hero-glow--two"></div>
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="services-kicker">Nuevo registro</p>
        <h1 class="text-3xl font-extrabold text-slate-900">Nuevo servicio</h1>
        <p class="mt-1 text-sm text-slate-500">Completa la informacion para publicar el servicio en el catalogo.</p>
      </div>
      <%= link_to services_path, class: "services-secondary-btn" do %>
        Volver
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form", service: @service %>
  </div>
</div>
