<% persisted_structure = f.object.id.present? %>
<% structure_title = f.object.description.to_s.strip.presence || "Estructura sin descripcion" %>
<div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-4 shadow-sm"
     style="align-self: start;"
     data-structure-item
     data-structure-persisted="<%= persisted_structure %>">
  <%= f.hidden_field :_destroy, data: { destroy_input: true } %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estructura de costos</p>
      <p class="truncate text-sm font-bold text-slate-800" data-structure-summary-title><%= structure_title %></p>
    </div>
    <div class="text-right">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total estructura</p>
      <p class="text-sm font-bold text-slate-800" data-structure-total-usd>$ 0,00</p>
      <p class="text-xs text-slate-500" data-structure-total-bs>Bs 0,00</p>
      <label class="mt-2 inline-flex cursor-pointer items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-2 py-1 text-[11px] font-semibold text-emerald-700">
        <%= f.check_box :active_for_sales,
                        class: "h-3.5 w-3.5 cursor-pointer rounded border-emerald-300 text-emerald-600 focus:ring-emerald-500",
                        data: { structure_active_toggle: true } %>
        Activa en ventas (solo una)
      </label>
    </div>
  </div>
  <div class="mt-3 flex justify-end gap-2">
    <button type="button" class="inline-flex items-center justify-center rounded-xl bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200" data-open-structure-modal>
      <%= persisted_structure ? "Editar" : "Completar" %>
    </button>
    <button type="button" class="inline-flex items-center justify-center rounded-xl bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100" data-remove-structure>
      Eliminar estructura
    </button>
  </div>
  <div class="fixed inset-0 z-50 hidden items-center justify-center p-4" data-structure-modal>
    <div class="absolute inset-0 bg-slate-900/60" data-close-structure-modal></div>
    <div class="relative z-10 w-full max-w-5xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Estructura de gastos</p>
          <h3 class="text-lg font-bold text-slate-800"><%= persisted_structure ? "Editar estructura" : "Nueva estructura" %></h3>
        </div>
        <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-500 hover:bg-slate-50" data-close-structure-modal>
          <i data-lucide="x" class="h-4 w-4 not-italic">x</i>
        </button>
      </div>
      <div class="max-h-[80vh] overflow-y-auto p-5" data-structure-body>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 bg-white p-3">
            <%= f.label :description, "Descripcion de la estructura", class: "block text-xs font-semibold uppercase tracking-wide text-slate-500" %>
            <%= f.text_field :description,
                         class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                         placeholder: "Ej: Tramite principal con arancel y gestor",
                         data: { structure_description: true } %>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-3">
            <div class="mb-3 flex items-center justify-between gap-2">
              <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Gestores y contrataciones</h4>
              <button type="button" class="inline-flex items-center rounded-lg bg-sky-100 px-2.5 py-1 text-xs font-semibold text-sky-700 hover:bg-sky-200" data-add-nested-row="manager_expense">
                Agregar gestor
              </button>
            </div>
            <div class="space-y-2" data-nested-container="manager_expense">
              <%= f.fields_for :service_manager_expenses do |manager_fields| %>
                <%= render "service_manager_expense_fields",
                           f: manager_fields,
                           managers: managers,
                           expense_currency_rows: expense_currency_rows %>
              <% end %>
            </div>
            <template data-nested-template="manager_expense" data-placeholder="NEW_MANAGER_EXPENSE">
              <%= f.fields_for :service_manager_expenses, ServiceManagerExpense.new, child_index: "NEW_MANAGER_EXPENSE" do |manager_fields| %>
                <%= render "service_manager_expense_fields",
                           f: manager_fields,
                           managers: managers,
                           expense_currency_rows: expense_currency_rows %>
              <% end %>
            </template>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-3">
            <div class="mb-3 flex items-center justify-between gap-2">
              <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Gastos variables</h4>
              <button type="button" class="inline-flex items-center rounded-lg bg-sky-100 px-2.5 py-1 text-xs font-semibold text-sky-700 hover:bg-sky-200" data-add-nested-row="variable_expense">
                Agregar gasto
              </button>
            </div>
            <div class="space-y-2" data-nested-container="variable_expense">
              <%= f.fields_for :service_variable_expenses do |variable_fields| %>
                <%= render "service_variable_expense_fields",
                           f: variable_fields,
                           expense_currency_rows: expense_currency_rows %>
              <% end %>
            </div>
            <template data-nested-template="variable_expense" data-placeholder="NEW_VARIABLE_EXPENSE">
              <%= f.fields_for :service_variable_expenses, ServiceVariableExpense.new, child_index: "NEW_VARIABLE_EXPENSE" do |variable_fields| %>
                <%= render "service_variable_expense_fields",
                           f: variable_fields,
                           expense_currency_rows: expense_currency_rows %>
              <% end %>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
