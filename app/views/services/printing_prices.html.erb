<div class="space-y-6">
  <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="absolute -right-12 -top-12 h-36 w-36 rounded-full bg-cyan-200/30 blur-2xl"></div>
    <div class="absolute -bottom-16 left-8 h-40 w-40 rounded-full bg-emerald-200/25 blur-3xl"></div>
    <div class="relative flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-400">Gestion centralizada</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">Precios de Impresiones</h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-600">Configura en una sola pantalla coberturas y recargos por material para cada servicio de impresion. Cada tarjeta guarda sus cambios de forma independiente.</p>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to services_path,
                    class: 'inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Volver a servicios
        <% end %>
      </div>
    </div>
  </div>
  <% if @printing_services.blank? %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <p class="text-base font-semibold text-slate-700">No hay servicios de impresion para configurar.</p>
      <p class="mt-2 text-sm text-slate-500">Asocia un servicio al system service "impresion" y aparecera aqui automaticamente.</p>
    </div>
  <% else %>
    <div class="grid gap-4 xl:grid-cols-2">
      <% @printing_services.each do |service| %>
        <%= form_with model: service,
                      url: update_printing_prices_service_path(service),
                      method: :patch,
                      local: true,
                      class: 'rounded-2xl border border-slate-200 bg-white p-4 shadow-sm',
                      id: "service-print-card-#{service.id}",
                      data: { printing_card: true } do |form| %>
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-cyan-600">Servicio de impresion</p>
              <h2 class="mt-1 text-lg font-extrabold text-slate-900"><%= service.description %></h2>
              <p class="mt-1 text-xs text-slate-500"><%= service.system_service&.name.to_s %></p>
            </div>
            <button type="submit"
                  data-print-save-button
                  disabled
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">
              <i data-lucide="save" class="h-3.5 w-3.5"></i>
              Guardar
            </button>
          </div>
          <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-3">
            <div class="mb-3">
              <%= form.label :print_sale_description, 'Descripcion para venta/factura', class: 'block text-xs font-semibold uppercase tracking-wide text-slate-500' %>
              <%= form.text_field :print_sale_description,
                                  autocomplete: 'off',
                                  maxlength: 160,
                                  placeholder: 'Ej: Impresion a color',
                                  class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700' %>
              <p class="mt-1 text-xs text-slate-500">Este texto se mostrara en el panel de cobro y en la factura/show de ventas.</p>
            </div>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">Coberturas</p>
                <p class="mt-1 text-xs text-slate-500">Define porcentaje y precio base en Bs.</p>
              </div>
              <button type="button"
                      class="inline-flex items-center gap-1 rounded-lg bg-cyan-100 px-2.5 py-1.5 text-xs font-semibold text-cyan-700 hover:bg-cyan-200"
                      data-add-print-coverage-row>
                Agregar
              </button>
            </div>
            <div class="mt-3 space-y-2" data-print-coverage-container>
              <% sorted_coverage_prices = service.service_print_coverage_prices.sort_by { |row| [row.price_bs.to_d, row.coverage_percent.to_d, row.id.to_i] } %>
              <%= form.fields_for :service_print_coverage_prices, sorted_coverage_prices do |coverage_fields| %>
                <div class="grid gap-2 rounded-xl border border-slate-200 bg-white p-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]" data-print-coverage-row>
                  <%= coverage_fields.hidden_field :id %>
                  <%= coverage_fields.hidden_field :_destroy, value: '0', data: { destroy_input: true } %>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Cobertura (%)</label>
                    <%= coverage_fields.text_field :coverage_percent,
                                                   autocomplete: 'off',
                                                   inputmode: 'decimal',
                                                   class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                                                   data: { money_mask: true, money_symbol: '%' },
                                                   value: (coverage_fields.object.coverage_percent.present? ? format_money(coverage_fields.object.coverage_percent, unit: '%') : '') %>
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Precio (Bs)</label>
                    <%= coverage_fields.text_field :price_bs,
                                                   autocomplete: 'off',
                                                   class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                                                   data: { money_mask: true, money_symbol: 'Bs' } %>
                  </div>
                  <button type="button"
                          class="self-center inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100"
                          data-remove-print-coverage-row
                          title="Eliminar cobertura"
                          aria-label="Eliminar cobertura">
                    <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                  </button>
                </div>
              <% end %>
            </div>
            <template data-print-coverage-template data-placeholder="NEW_PRINT_COVERAGE">
              <%= form.fields_for :service_print_coverage_prices, ServicePrintCoveragePrice.new, child_index: 'NEW_PRINT_COVERAGE' do |coverage_fields| %>
                <div class="grid gap-2 rounded-xl border border-slate-200 bg-white p-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]" data-print-coverage-row>
                  <%= coverage_fields.hidden_field :id %>
                  <%= coverage_fields.hidden_field :_destroy, value: '0', data: { destroy_input: true } %>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Cobertura (%)</label>
                    <%= coverage_fields.text_field :coverage_percent,
                                                   autocomplete: 'off',
                                                   inputmode: 'decimal',
                                                   class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                                                   data: { money_mask: true, money_symbol: '%' } %>
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Precio (Bs)</label>
                    <%= coverage_fields.text_field :price_bs,
                                                   autocomplete: 'off',
                                                   class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                                                   data: { money_mask: true, money_symbol: 'Bs' } %>
                  </div>
                  <button type="button"
                          class="self-center inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100"
                          data-remove-print-coverage-row
                          title="Eliminar cobertura"
                          aria-label="Eliminar cobertura">
                    <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                  </button>
                </div>
              <% end %>
            </template>
          </div>
          <div class="mt-3 rounded-2xl border border-sky-200 bg-sky-50/70 p-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-sky-700">Descuentos por volumen</p>
                <p class="mt-1 text-xs text-slate-600">Aplica descuentos segun la cantidad total del servicio en la orden.</p>
              </div>
              <button type="button"
                      class="inline-flex items-center gap-1 rounded-full border border-sky-300 bg-white px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-sky-700 shadow-sm hover:bg-sky-100"
                      data-add-print-volume-discount-row>
                + Descuento
              </button>
            </div>
            <div class="mt-3 space-y-2" data-print-volume-discount-container>
              <% sorted_volume_discounts = service.service_print_volume_discounts.sort_by { |row| [row.min_quantity.to_i, row.discount_percent.to_d, row.id.to_i] } %>
              <%= form.fields_for :service_print_volume_discounts, sorted_volume_discounts do |discount_fields| %>
                <div class="grid gap-2 rounded-xl border border-slate-200 bg-white p-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]" data-print-volume-discount-row>
                  <%= discount_fields.hidden_field :id %>
                  <%= discount_fields.hidden_field :_destroy, value: '0', data: { destroy_input: true } %>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Cantidad minima</label>
                    <%= discount_fields.number_field :min_quantity,
                                                     min: 1,
                                                     step: 1,
                                                     class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                                                     inputmode: 'numeric' %>
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Descuento (%)</label>
                    <%= discount_fields.text_field :discount_percent,
                                                   autocomplete: 'off',
                                                   inputmode: 'decimal',
                                                   class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                                                   data: { money_mask: true, money_symbol: '%' },
                                                   value: (discount_fields.object.discount_percent.present? ? format_money(discount_fields.object.discount_percent, unit: '%') : '') %>
                  </div>
                  <button type="button"
                          class="self-center inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100"
                          data-remove-print-volume-discount-row
                          title="Eliminar descuento"
                          aria-label="Eliminar descuento">
                    <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                  </button>
                </div>
              <% end %>
            </div>
            <template data-print-volume-discount-template data-placeholder="NEW_PRINT_VOLUME_DISCOUNT">
              <%= form.fields_for :service_print_volume_discounts, ServicePrintVolumeDiscount.new, child_index: 'NEW_PRINT_VOLUME_DISCOUNT' do |discount_fields| %>
                <div class="grid gap-2 rounded-xl border border-slate-200 bg-white p-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]" data-print-volume-discount-row>
                  <%= discount_fields.hidden_field :id %>
                  <%= discount_fields.hidden_field :_destroy, value: '0', data: { destroy_input: true } %>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Cantidad minima</label>
                    <%= discount_fields.number_field :min_quantity,
                                                     min: 1,
                                                     step: 1,
                                                     class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                                                     inputmode: 'numeric' %>
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Descuento (%)</label>
                    <%= discount_fields.text_field :discount_percent,
                                                   autocomplete: 'off',
                                                   inputmode: 'decimal',
                                                   class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                                                   data: { money_mask: true, money_symbol: '%' } %>
                  </div>
                  <button type="button"
                          class="self-center inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100"
                          data-remove-print-volume-discount-row
                          title="Eliminar descuento"
                          aria-label="Eliminar descuento">
                    <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                  </button>
                </div>
              <% end %>
            </template>
          </div>
          <div class="mt-3 rounded-2xl border border-emerald-200 bg-emerald-50/40 p-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700">Materiales con recargo</p>
                <p class="mt-1 text-xs text-slate-600">Busca un material y define su recargo adicional.</p>
              </div>
              <button type="button"
                      class="inline-flex items-center gap-1 rounded-lg bg-emerald-100 px-2.5 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-200"
                      data-add-print-material-surcharge-row>
                Agregar
              </button>
            </div>
            <div class="mt-3 space-y-2" data-print-material-surcharge-container>
              <% sorted_material_surcharges = service.service_print_material_surcharges.sort_by { |row| [row.created_at || Time.at(0), row.id.to_i] } %>
              <%= form.fields_for :service_print_material_surcharges, sorted_material_surcharges do |material_fields| %>
                <%= render 'service_print_material_surcharge_fields',
                           f: material_fields,
                           products: @products_for_expenses,
                           bcv_rate: @service_expenses_bcv_rate %>
              <% end %>
            </div>
            <template data-print-material-template data-placeholder="NEW_PRINT_MATERIAL_SURCHARGE">
              <%= form.fields_for :service_print_material_surcharges, ServicePrintMaterialSurcharge.new, child_index: 'NEW_PRINT_MATERIAL_SURCHARGE' do |material_fields| %>
                <%= render 'service_print_material_surcharge_fields',
                           f: material_fields,
                           products: @products_for_expenses,
                           bcv_rate: @service_expenses_bcv_rate %>
              <% end %>
            </template>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
<script>
  (() => {
    const ignoredSnapshotKeys = new Set(['authenticity_token', '_method', 'commit']);

    const refreshLucideIcons = (scope) => {
      if (!window.lucide || typeof window.lucide.createIcons !== 'function') return;
      window.lucide.createIcons({ attrs: { 'stroke-width': 2 } });
    };

    const buildFormSnapshot = (form) => {
      if (!form) return '[]';

      const entries = [];
      const data = new FormData(form);
      data.forEach((value, key) => {
        if (ignoredSnapshotKeys.has(String(key))) return;
        entries.push([String(key), String(value)]);
      });

      entries.sort((a, b) => {
        if (a[0] === b[0]) return a[1].localeCompare(b[1]);
        return a[0].localeCompare(b[0]);
      });

      return JSON.stringify(entries);
    };

    const setSaveButtonEnabled = (button, enabled) => {
      if (!button) return;

      button.disabled = !enabled;
      button.classList.toggle('opacity-55', !enabled);
      button.classList.toggle('cursor-not-allowed', !enabled);
      button.classList.toggle('hover:bg-slate-800', enabled);
    };

    const normalizeText = (value) => String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

    const bindProductSearchRow = (row) => {
      if (!row || row.dataset.productSearchBound === 'true') return;
      row.dataset.productSearchBound = 'true';

      const searchInput = row.querySelector('[data-product-search]');
      const resultsContainer = row.querySelector('[data-product-results]');
      const selectInput = row.querySelector('[data-product-select]');
      const selectedLabel = row.querySelector('[data-product-selected-label]');
      if (!searchInput || !resultsContainer || !selectInput || !selectedLabel) return;

      const options = Array.from(selectInput.options)
        .filter((option) => String(option.value || '').trim().length > 0)
        .map((option) => ({
          value: String(option.value),
          text: String(option.textContent || '').trim()
        }));

      const closeResults = () => {
        resultsContainer.classList.add('hidden');
        resultsContainer.innerHTML = '';
      };

      const setSelection = (entry) => {
        if (!entry) return;
        selectInput.value = entry.value;
        searchInput.value = entry.text;
        selectedLabel.textContent = `Seleccionado: ${entry.text}`;
        closeResults();
        row.closest('form[data-printing-card]')?.dispatchEvent(new Event('change', { bubbles: true }));
      };

      const renderResults = (query) => {
        const normalizedQuery = normalizeText(query);
        if (!normalizedQuery) {
          closeResults();
          return;
        }

        const matches = options
          .filter((entry) => normalizeText(entry.text).includes(normalizedQuery))
          .slice(0, 8);

        if (matches.length === 0) {
          resultsContainer.innerHTML = '<p class="px-3 py-2 text-xs text-slate-500">Sin coincidencias</p>';
          resultsContainer.classList.remove('hidden');
          return;
        }

        resultsContainer.innerHTML = matches.map((entry) => {
          const safeText = entry.text.replace(/</g, '&lt;').replace(/>/g, '&gt;');
          return `<button type="button" class="block w-full border-b border-slate-100 px-3 py-2 text-left text-sm text-slate-700 hover:bg-slate-50" data-product-result-value="${entry.value}">${safeText}</button>`;
        }).join('');

        resultsContainer.classList.remove('hidden');
      };

      resultsContainer.addEventListener('click', (event) => {
        const button = event.target.closest('[data-product-result-value]');
        if (!button) return;

        const selected = options.find((entry) => entry.value === String(button.dataset.productResultValue || ''));
        setSelection(selected);
      });

      searchInput.addEventListener('input', () => {
        const currentValue = searchInput.value;
        if (!currentValue.trim()) {
          selectInput.value = '';
          selectedLabel.textContent = 'Sin material seleccionado';
          closeResults();
          row.closest('form[data-printing-card]')?.dispatchEvent(new Event('change', { bubbles: true }));
          return;
        }
        renderResults(currentValue);
      });

      searchInput.addEventListener('focus', () => {
        if (String(searchInput.value || '').trim().length > 0) {
          renderResults(searchInput.value);
        }
      });

      document.addEventListener('click', (event) => {
        if (row.contains(event.target)) return;
        closeResults();
      });

      const selectedOption = options.find((entry) => entry.value === String(selectInput.value || ''));
      if (selectedOption) {
        searchInput.value = selectedOption.text;
        selectedLabel.textContent = `Seleccionado: ${selectedOption.text}`;
      }
    };

    const bindProductSearch = (scope) => {
      scope.querySelectorAll('[data-print-material-surcharge-row]').forEach((row) => {
        bindProductSearchRow(row);
      });
    };

    const ensureCoverageRow = (card) => {
      const container = card.querySelector('[data-print-coverage-container]');
      const template = card.querySelector('template[data-print-coverage-template]');
      if (!container || !template) return;

      const visibleRows = Array.from(container.querySelectorAll('[data-print-coverage-row]'))
        .filter((row) => row.style.display !== 'none');
      if (visibleRows.length > 0) return;

      const placeholder = template.dataset.placeholder;
      const token = `${Date.now()}${Math.floor(Math.random() * 1000)}`;
      const html = (template.innerHTML || '').split(placeholder).join(token);
      container.insertAdjacentHTML('beforeend', html);
      window.MoneyInputMask?.init(container);
    };

    const bindCard = (card) => {
      if (!card || card.dataset.printingCardBound === 'true') return;
      card.dataset.printingCardBound = 'true';

      const saveButton = card.querySelector('[data-print-save-button]');
      let initialSnapshot = '[]';

      const syncCardDirtyState = () => {
        const currentSnapshot = buildFormSnapshot(card);
        setSaveButtonEnabled(saveButton, currentSnapshot !== initialSnapshot);
      };

      const coverageContainer = card.querySelector('[data-print-coverage-container]');
      const coverageTemplate = card.querySelector('template[data-print-coverage-template]');
      const addCoverageButton = card.querySelector('[data-add-print-coverage-row]');

      const materialContainer = card.querySelector('[data-print-material-surcharge-container]');
      const materialTemplate = card.querySelector('template[data-print-material-template]');
      const addMaterialButton = card.querySelector('[data-add-print-material-surcharge-row]');

      const discountContainer = card.querySelector('[data-print-volume-discount-container]');
      const discountTemplate = card.querySelector('template[data-print-volume-discount-template]');
      const addDiscountButton = card.querySelector('[data-add-print-volume-discount-row]');

      addCoverageButton?.addEventListener('click', () => {
        if (!coverageContainer || !coverageTemplate) return;

        const placeholder = coverageTemplate.dataset.placeholder;
        const token = `${Date.now()}${Math.floor(Math.random() * 1000)}`;
        const html = (coverageTemplate.innerHTML || '').split(placeholder).join(token);
        coverageContainer.insertAdjacentHTML('beforeend', html);
        window.MoneyInputMask?.init(coverageContainer);
        syncCardDirtyState();
      });

      coverageContainer?.addEventListener('click', (event) => {
        const removeButton = event.target.closest('[data-remove-print-coverage-row]');
        if (!removeButton) return;

        const row = removeButton.closest('[data-print-coverage-row]');
        if (!row) return;

        const destroyInput = row.querySelector('input[data-destroy-input="true"]');
        const idInput = row.querySelector('input[type="hidden"][name$="[id]"]');
        const persisted = idInput && String(idInput.value || '').trim().length > 0;

        if (persisted && destroyInput) {
          destroyInput.value = '1';
          row.style.display = 'none';
        } else {
          row.remove();
        }

        ensureCoverageRow(card);
        syncCardDirtyState();
      });

      addMaterialButton?.addEventListener('click', () => {
        if (!materialContainer || !materialTemplate) return;

        const placeholder = materialTemplate.dataset.placeholder;
        const token = `${Date.now()}${Math.floor(Math.random() * 1000)}`;
        const html = (materialTemplate.innerHTML || '').split(placeholder).join(token);
        materialContainer.insertAdjacentHTML('beforeend', html);
        window.MoneyInputMask?.init(materialContainer);
        bindProductSearch(materialContainer);
        refreshLucideIcons(materialContainer);
        syncCardDirtyState();
      });

      addDiscountButton?.addEventListener('click', () => {
        if (!discountContainer || !discountTemplate) return;

        const placeholder = discountTemplate.dataset.placeholder;
        const token = `${Date.now()}${Math.floor(Math.random() * 1000)}`;
        const html = (discountTemplate.innerHTML || '').split(placeholder).join(token);
        discountContainer.insertAdjacentHTML('beforeend', html);
        window.MoneyInputMask?.init(discountContainer);
        refreshLucideIcons(discountContainer);
        syncCardDirtyState();
      });

      materialContainer?.addEventListener('click', (event) => {
        const removeButton = event.target.closest('[data-remove-print-material-surcharge-row]');
        if (!removeButton) return;

        const row = removeButton.closest('[data-print-material-surcharge-row]');
        if (!row) return;

        const destroyInput = row.querySelector('input[data-destroy-input="true"]');
        const idInput = row.querySelector('input[type="hidden"][name$="[id]"]');
        const persisted = idInput && String(idInput.value || '').trim().length > 0;

        if (persisted && destroyInput) {
          destroyInput.value = '1';
          row.style.display = 'none';
        } else {
          row.remove();
        }

        syncCardDirtyState();
      });

      discountContainer?.addEventListener('click', (event) => {
        const removeButton = event.target.closest('[data-remove-print-volume-discount-row]');
        if (!removeButton) return;

        const row = removeButton.closest('[data-print-volume-discount-row]');
        if (!row) return;

        const destroyInput = row.querySelector('input[data-destroy-input="true"]');
        const idInput = row.querySelector('input[type="hidden"][name$="[id]"]');
        const persisted = idInput && String(idInput.value || '').trim().length > 0;

        if (persisted && destroyInput) {
          destroyInput.value = '1';
          row.style.display = 'none';
        } else {
          row.remove();
        }

        syncCardDirtyState();
      });

      ensureCoverageRow(card);
      bindProductSearch(card);
      window.MoneyInputMask?.init(card);
      refreshLucideIcons(card);

      card.addEventListener('input', syncCardDirtyState);
      card.addEventListener('change', syncCardDirtyState);
      card.addEventListener('submit', () => {
        setSaveButtonEnabled(saveButton, false);
      });

      initialSnapshot = buildFormSnapshot(card);
      syncCardDirtyState();
    };

    const initialize = () => {
      document.querySelectorAll('[data-printing-card]').forEach((card) => {
        bindCard(card);
      });
    };

    document.addEventListener('DOMContentLoaded', initialize);
    document.addEventListener('turbo:load', initialize);
  })();
</script>
