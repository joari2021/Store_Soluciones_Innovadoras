<div class="services-scope space-y-6">
  <div class="services-hero relative overflow-hidden rounded-3xl border border-slate-200 bg-white/80 p-6 shadow-sm">
    <div class="services-hero-glow services-hero-glow--one"></div>
    <div class="services-hero-glow services-hero-glow--two"></div>
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="services-kicker">Control de servicios vendidos</p>
        <h1 class="services-title text-3xl font-extrabold text-slate-900 md:text-4xl">Servicios vendidos y estado de costos</h1>
        <p class="mt-1 text-sm text-slate-500">Listado consolidado de servicios directos y anidados vendidos, con estado de costo y filtros avanzados.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to services_path, class: "inline-flex cursor-pointer items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Volver a servicios
        <% end %>
      </div>
    </div>
  </div>
  <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-6">
    <div class="rounded-2xl border border-slate-200 bg-slate-50/90 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Servicios listados</p>
      <p class="mt-2 text-2xl font-extrabold text-slate-800"><%= @pending_cost_total_rows %></p>
      <p class="mt-1 text-xs text-slate-500">Directos y anidados segun filtros.</p>
    </div>
    <div class="rounded-2xl border border-indigo-200 bg-indigo-50/80 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Cantidad total listada</p>
      <p class="mt-2 text-2xl font-extrabold text-indigo-800"><%= format_quantity(@pending_cost_total_quantity, precision: 2) %></p>
      <p class="mt-1 text-xs text-indigo-700">Suma de cantidades de servicios filtrados.</p>
    </div>
    <div class="rounded-2xl border border-rose-200 bg-rose-50/80 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-rose-700">Con deuda</p>
      <p class="mt-2 text-2xl font-extrabold text-rose-800"><%= @pending_cost_pending_count %></p>
      <p class="mt-1 text-xs text-rose-700">Costo pendiente por pagar.</p>
    </div>
    <div class="rounded-2xl border border-amber-200 bg-amber-50/80 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Parciales</p>
      <p class="mt-2 text-2xl font-extrabold text-amber-800"><%= @pending_cost_partial_count %></p>
      <p class="mt-1 text-xs text-amber-700">Costo con pagos incompletos.</p>
    </div>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/80 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Pagados</p>
      <p class="mt-2 text-2xl font-extrabold text-emerald-800"><%= @pending_cost_paid_count %></p>
      <p class="mt-1 text-xs text-emerald-700">Costo cubierto completamente.</p>
    </div>
    <div class="rounded-2xl border border-cyan-200 bg-cyan-50/80 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Sin costo</p>
      <p class="mt-2 text-2xl font-extrabold text-cyan-800"><%= @pending_cost_no_cost_count %></p>
      <p class="mt-1 text-xs text-cyan-700">Servicios sin estructura activa.</p>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: pending_costs_services_path, method: :get, local: true, class: "space-y-3" do %>
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-6">
        <div class="xl:col-span-2">
          <%= label_tag :query_text, "Nombre / venta", class: "block text-[11px] font-semibold uppercase tracking-wide text-slate-500" %>
          <%= text_field_tag :query_text, @pending_cost_filters[:query_text], placeholder: "Servicio, anidado o #venta", class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div>
          <%= label_tag :fecha_desde, "Desde", class: "block text-[11px] font-semibold uppercase tracking-wide text-slate-500" %>
          <%= text_field_tag :fecha_desde,
                             @pending_cost_filters[:fecha_desde]&.strftime("%d-%m-%Y"),
                             placeholder: "dd-mm-aaaa",
                             class: "js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div>
          <%= label_tag :fecha_hasta, "Hasta", class: "block text-[11px] font-semibold uppercase tracking-wide text-slate-500" %>
          <%= text_field_tag :fecha_hasta,
                             @pending_cost_filters[:fecha_hasta]&.strftime("%d-%m-%Y"),
                             placeholder: "dd-mm-aaaa",
                             class: "js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div>
          <%= label_tag :system_service_id, "Sistema", class: "block text-[11px] font-semibold uppercase tracking-wide text-slate-500" %>
          <%= select_tag :system_service_id,
                         options_for_select(@pending_cost_system_services.map { |system| [system.name, system.id] }, @pending_cost_filters[:system_service_id]),
                         include_blank: "Todos",
                         class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div>
          <%= label_tag :cost_status, "Estado costo", class: "block text-[11px] font-semibold uppercase tracking-wide text-slate-500" %>
          <%= select_tag :cost_status,
                         options_for_select([
                           ["Todos", "all"],
                           ["Con deuda o parciales", "with_debt_or_partial"],
                           ["Solo con deuda", "pending"],
                           ["Solo parciales", "partial"],
                           ["Solo pagados", "paid"],
                           ["Sin costo", "no_cost"]
                         ], @pending_cost_filters[:cost_status]),
                         class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" %>
        </div>
      </div>
      <div class="grid gap-3 md:grid-cols-[minmax(0,260px)_1fr] md:items-end">
        <div>
          <%= label_tag :manager_id, "Gestor asociado", class: "block text-[11px] font-semibold uppercase tracking-wide text-slate-500" %>
          <%= select_tag :manager_id,
                         options_for_select(@pending_cost_managers.map { |manager| [manager.name, manager.id] }, @pending_cost_filters[:manager_id]),
                         include_blank: "Todos",
                         class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div class="flex flex-wrap gap-2 md:justify-end">
          <%= link_to pending_costs_services_path, class: "inline-flex cursor-pointer items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50" do %>
            Limpiar filtros
          <% end %>
          <button type="submit" class="inline-flex cursor-pointer items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
            Filtrar
          </button>
        </div>
      </div>
    <% end %>
  </div>
  <div class="rounded-2xl border border-cyan-200 bg-cyan-50/80 p-4 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Saldo pendiente total del resultado</p>
    <p class="mt-2 text-2xl font-extrabold text-cyan-800"><%= format_money(@pending_cost_pending_total, unit: "$ ") %></p>
    <p class="mt-1 text-xs text-cyan-700">Suma de pendientes de costo para las filas filtradas.</p>
  </div>
  <% if @pending_cost_rows.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-slate-700">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-4 py-3 text-left font-bold">Fecha</th>
              <th class="px-4 py-3 text-left font-bold">Venta</th>
              <th class="px-4 py-3 text-left font-bold">Servicio</th>
              <th class="px-4 py-3 text-left font-bold">Sistema</th>
              <th class="px-4 py-3 text-center font-bold">Cantidad</th>
              <th class="px-4 py-3 text-right font-bold">Precio venta (USD)</th>
              <th class="px-4 py-3 text-center font-bold">Estado costo</th>
              <th class="px-4 py-3 text-right font-bold">Accion</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @pending_cost_rows.each do |row| %>
              <% sale_badge_label = if row[:printing_sale]
                                      'Impresion'
                                    elsif row[:nested_sale]
                                      'Anidado'
                                    else
                                      'Directo'
                                    end %>
              <% nested_badge_class = if row[:printing_sale]
                                        "bg-cyan-100 text-cyan-700 ring-cyan-200"
                                      elsif row[:nested_sale]
                                        "bg-violet-100 text-violet-700 ring-violet-200"
                                      else
                                        "bg-sky-100 text-sky-700 ring-sky-200"
                                      end %>
              <tr class="hover:bg-slate-50/60">
                <td class="px-4 py-3 whitespace-nowrap text-xs text-slate-600">
                  <%= row[:sold_at]&.in_time_zone("America/Caracas")&.strftime("%d/%m/%Y %H:%M") || "--" %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <%= link_to "##{row[:sale_id]}", venta_path(row[:sale_id]), class: "font-semibold text-cyan-700 hover:text-cyan-800", data: { turbo_frame: "_top" } %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-col gap-1">
                    <span class="font-semibold text-slate-800"><%= row[:service_name] %></span>
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ring-1 <%= nested_badge_class %>"><%= sale_badge_label %></span>
                      <% if (row[:nested_sale] || row[:printing_sale]) && row[:parent_service_name].present? %>
                        <% parent_system_name = row[:parent_service_system_name].to_s.strip %>
                        <% parent_context_label = if parent_system_name.present?
                                                    "#{row[:parent_service_name]} (#{parent_system_name})"
                                                  else
                                                    row[:parent_service_name]
                                                  end %>
                        <span class="text-[11px] text-slate-500">Desde: <span class="font-semibold text-slate-600"><%= parent_context_label %></span></span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-xs text-slate-600"><%= row[:service_system_name].presence || "--" %></td>
                <td class="px-4 py-3 text-center font-semibold text-slate-700"><%= format_quantity(row[:quantity], precision: 2) %></td>
                <td class="px-4 py-3 text-right font-semibold text-slate-800"><%= format_money(row[:sale_unit_price_usd], unit: "$ ") %></td>
                <td class="px-4 py-3 text-center">
                  <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 <%= row[:cost_status_class] %>"><%= row[:cost_status_label] %></span>
                </td>
                <td class="px-4 py-3 text-right">
                  <% if row[:detail_debt_id].present? %>
                    <%= link_to pending_cost_detail_services_path(debt_id: row[:detail_debt_id]), class: "inline-flex cursor-pointer items-center gap-1 rounded-lg border border-cyan-200 bg-cyan-50 px-3 py-1.5 text-xs font-semibold text-cyan-700 hover:bg-cyan-100" do %>
                      <i data-lucide="eye" class="h-3.5 w-3.5"></i>
                      Ver detalle
                    <% end %>
                  <% else %>
                    <%= link_to venta_path(row[:sale_id]), class: "inline-flex cursor-pointer items-center gap-1 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
                      <i data-lucide="external-link" class="h-3.5 w-3.5"></i>
                      Ver venta
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if defined?(@pagy) && @pagy.present? && @pagy.pages > 1 %>
        <div class="border-t border-slate-200 bg-slate-50 px-4 py-3">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
        <i data-lucide="search-x" class="h-6 w-6"></i>
      </div>
      <h3 class="text-base font-semibold text-slate-700">Sin servicios para los filtros aplicados</h3>
      <p class="mt-1 text-sm text-slate-500">Ajusta el rango de fechas, gestor o sistema para ampliar la busqueda.</p>
    </div>
  <% end %>
</div>
<%= render "services/styles" %>
