<div class="services-scope space-y-6">
  <div class="services-hero relative overflow-hidden rounded-3xl border border-slate-200 bg-white/80 p-6 shadow-sm">
    <div class="services-hero-glow services-hero-glow--one"></div>
    <div class="services-hero-glow services-hero-glow--two"></div>
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="services-kicker">Control de costos</p>
        <h1 class="services-title text-3xl font-extrabold text-slate-900 md:text-4xl">Costos pendientes de servicios</h1>
        <p class="mt-1 text-sm text-slate-500">Deudas por pagar generadas automaticamente al facturar servicios con descuento de costo y stock.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to services_path, class: "inline-flex cursor-pointer items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Volver a servicios
        <% end %>
      </div>
    </div>
  </div>
  <div class="grid gap-3 md:grid-cols-2">
    <div class="rounded-2xl border border-rose-200 bg-rose-50/80 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-rose-700">Pendientes activos</p>
      <p class="mt-2 text-2xl font-extrabold text-rose-800"><%= @pending_cost_count %></p>
      <p class="mt-1 text-xs text-rose-700">Deudas por pagar con saldo pendiente.</p>
    </div>
    <div class="rounded-2xl border border-cyan-200 bg-cyan-50/80 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Saldo total pendiente</p>
      <p class="mt-2 text-2xl font-extrabold text-cyan-800"><%= format_money(@pending_cost_total, unit: '$ ') %></p>
      <p class="mt-1 text-xs text-cyan-700">Monto consolidado en USD BCV.</p>
    </div>
  </div>
  <% if @pending_cost_rows.any? %>
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-wide text-slate-500">Resumen por registro</h2>
        <span class="text-xs text-slate-500"><%= @pending_cost_rows.size %> registro(s)</span>
      </div>
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        <% @pending_cost_rows.each do |row| %>
          <% debt = row[:debt] %>
          <% service_name = debt.service&.description.to_s.strip.presence || debt.display_name %>
          <% status_key = row[:status].to_s %>
          <% status_label = status_key == 'paid' ? 'Pagado' : (status_key == 'partial' ? 'Parcial' : 'Pendiente') %>
          <% status_class = status_key == 'paid' ? 'bg-emerald-100 text-emerald-700 ring-emerald-200' : (status_key == 'partial' ? 'bg-amber-100 text-amber-700 ring-amber-200' : 'bg-rose-100 text-rose-700 ring-rose-200') %>
          <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" data-pending-cost-summary-card="true">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="truncate text-sm font-bold text-slate-800"><%= service_name %></p>
                <p class="mt-1 text-xs text-slate-500">Registro #<%= debt.id %></p>
              </div>
              <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 <%= status_class %>"><%= status_label %></span>
            </div>
            <div class="mt-3 space-y-1.5 text-xs text-slate-600">
              <p>Total: <span class="font-semibold text-slate-700"><%= format_money(row[:total_usd], unit: '$ ') %></span></p>
              <p>Pagado: <span class="font-semibold text-emerald-700"><%= format_money(row[:paid_usd], unit: '$ ') %></span></p>
              <p>Pendiente: <span class="font-semibold text-rose-700"><%= format_money(row[:pending_usd], unit: '$ ') %></span></p>
            </div>
            <div class="mt-3">
              <%= link_to pending_cost_detail_services_path(debt_id: debt.id), class: 'inline-flex cursor-pointer items-center gap-1 rounded-lg border border-cyan-200 bg-cyan-50 px-3 py-1.5 text-xs font-semibold text-cyan-700 hover:bg-cyan-100' do %>
                <i data-lucide="eye" class="h-3.5 w-3.5"></i>
                Ver detalle
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
        <i data-lucide="check" class="h-6 w-6"></i>
      </div>
      <h3 class="text-base font-semibold text-slate-700">Sin costos pendientes</h3>
      <p class="mt-1 text-sm text-slate-500">No hay deudas pendientes por costos de servicios automaticos.</p>
    </div>
  <% end %>
</div>
<%= render 'services/styles' %>
