<div class="space-y-6">
  <div class="relative overflow-hidden rounded-3xl border border-emerald-200 bg-white p-6 shadow-sm">
    <div class="absolute -right-12 -top-12 h-36 w-36 rounded-full bg-emerald-200/30 blur-2xl"></div>
    <div class="absolute -bottom-16 left-8 h-40 w-40 rounded-full bg-teal-200/25 blur-3xl"></div>
    <div class="relative flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-400">Gestion centralizada</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">Parametros de recargas</h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-600">Configura montos minimos, multiplos y porcentaje de ganancia por cada servicio de recargas.</p>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to services_path,
                    class: 'inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Volver a servicios
        <% end %>
      </div>
    </div>
  </div>
  <% if @recarga_services.blank? %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <p class="text-base font-semibold text-slate-700">No hay servicios de recargas para configurar.</p>
      <p class="mt-2 text-sm text-slate-500">Asocia un servicio al system service que incluya "recarga" para mostrarlo aqui.</p>
    </div>
  <% else %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <% @recarga_services.each do |service| %>
        <% system_service = service.system_service %>
        <%= form_with model: service,
                      url: update_recarga_parameters_services_path(service),
                      method: :patch,
                      local: true,
                      class: 'group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-3 shadow-sm',
                      id: "recarga-service-card-#{service.id}" do |form| %>
          <div class="aspect-[16/10] overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
            <% if service.recarga_image.attached? %>
              <%= image_tag service.recarga_image, class: 'h-full w-full object-cover', alt: service.description %>
            <% elsif system_service&.image&.attached? %>
              <%= image_tag system_service.image, class: 'h-full w-full object-cover', alt: system_service.name %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center text-slate-300">
                <i data-lucide="image-off" class="h-8 w-8"></i>
              </div>
            <% end %>
          </div>
          <div class="mt-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600">System Service Recargas</p>
              <h2 class="mt-1 truncate text-lg font-extrabold text-slate-900"><%= service.description %></h2>
              <p class="mt-1 text-xs text-slate-500"><%= system_service&.name.to_s %></p>
            </div>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">
              <i data-lucide="save" class="h-3.5 w-3.5"></i>
              Guardar
            </button>
          </div>
          <div class="mt-4 space-y-3">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Imagen (opcional)</label>
              <%= form.file_field :recarga_image,
                                  direct_upload: true,
                                  class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-emerald-500 focus:ring-emerald-500' %>
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Monto minimo (Bs)</label>
              <%= form.text_field :recarga_min_amount,
                                  autocomplete: 'off',
                                  inputmode: 'decimal',
                                  class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-emerald-500 focus:ring-emerald-500',
                                  data: { money_mask: true, money_symbol: 'Bs' },
                                  value: (service.recarga_min_amount.present? ? format_money(service.recarga_min_amount, unit: 'Bs') : '') %>
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Multiplo (Bs)</label>
              <%= form.text_field :recarga_multiple_amount,
                                  autocomplete: 'off',
                                  inputmode: 'decimal',
                                  class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-emerald-500 focus:ring-emerald-500',
                                  data: { money_mask: true, money_symbol: 'Bs' },
                                  value: (service.recarga_multiple_amount.present? ? format_money(service.recarga_multiple_amount, unit: 'Bs') : '') %>
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">% ganancia</label>
              <%= form.text_field :recarga_profit_percent,
                                  autocomplete: 'off',
                                  inputmode: 'decimal',
                                  class: 'mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-emerald-500 focus:ring-emerald-500',
                                  data: { money_mask: true, money_symbol: '%' },
                                  value: (service.recarga_profit_percent.present? ? format_money(service.recarga_profit_percent, unit: '%') : '') %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
