<div class="fondo-opaco position-relative" style="width: 100%; border: 1px solid black;">
  <h1>Servicios</h1>
  <% if Current.user&.admin? %>
    <div><%= link_to 'Nuevo Servicio', new_service_path, class: "btn btn-primary" %></div>
  <% end %>
  <%= render "shared/campo_buscar", url: services_path, busqueda: "Servicios" %>
  <div class="position-absolute top-0 end-0 bg-primary text-white p-2">
    <span>Tasa Dolar BCV: <strong><%= number_to_currency(@tasa_dolar_bcv, unit: "Bs ") %></strong></span>
  </div>
  <%= turbo_frame_tag "services-#{@pagy.page}" do%>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xxl-6 g-4 mt-2" id="services-container">
      <% @services.each do |service| %>
        <div class="col">
          <div class="card h-100 shadow-sm text-black">
            <div class="card-header d-flex justify-content-end">
              <% if Current.user&.personal? && service.available? %>
                <button type="button"
                      class="btn btn-outline-info btn-sm view-service"
                      data-service-id="<%= service.id %>"
                      data-service-description="<%= service.description %> (<%= service.system_service.name%>)"
                      data-bs-toggle="modal"
                      data-bs-target="#serviceModal"
                      title="Ver detalles">
                  <i class="fas fa-eye"></i>
                </button>
              <% end %>
              <% if Current.user&.admin? %>
                <%= link_to edit_service_path(service), class: "btn btn-primary btn-sm mx-2", data: { turbo_frame: "_top" } do %>
                  <i class="fas fa-edit"></i>
                <% end %>
                <%= link_to service_path(service), class: "btn btn-danger btn-sm", data: { turbo_method: :delete, confirm: "Estas Seguro?" } do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              <% end %>
            </div>
            <div class="image-container position-relative">
              <% if service.system_service&.image.attached? %>
                <%= image_tag service.system_service.image, class: "card-img-top", alt: service.system_service.name %>
              <% else %>
                <%= image_tag "default_image.jpeg", class: "card-img-top", alt: "Imagen por defecto" %>
              <% end %>
              <% if service.system_service.present? %>
                <span class="position-absolute bottom-0 end-0 m-2 badge rounded-pill bg-info text-dark shadow">
                  <%= service.system_service.name %>
                </span>
              <% end %>
              <% unless service.available? %>
                <%= image_tag "no-disponible.png", class: "overlay-no-disponible", alt: "No disponible" %>
              <% end %>
            </div>
            <div class="card-body">
              <% if Current.user&.admin? %>
                <p class="card-text mb-1">
                  <p class="text-center fw-bold">Costo</p>
                  <% if service.cost %>
                    <% service.service_managers.each do |service_manager| %>
                      <div class="d-flex justify-content-between">
                        <span><%= service_manager.manager.name %></span>
                        <strong class="text-danger"><%= number_to_currency((service_manager.cost * TasaCambio.find_by(description: service_manager.reference_cost)&.valor.to_f) / @tasa_dolar_bcv, unit: "$") %></strong>
                      </div>
                    <% end %>
                  <% else %>
                    <span class="text-muted">Sin costo</span>
                  <% end %>
                </p>
                <hr>
              <%end%>
              <span class="d-block text-start">Precio</span>
              <% if service.currency_base_price == "$" %>
                <strong class="d-block text-end">
                  <%= number_to_currency(service.sale_price, unit: "$ ") %>
                  <% if @tasa_dolar_bcv.present? %>
                    (<%= number_to_currency(service.sale_price * @tasa_dolar_bcv, unit: "Bs ") %>)
                  <% else %>
                    <span class="text-danger">(Tasa no disponible)</span>
                  <% end %>
                </strong>
              <% elsif service.currency_base_price == "Bs" %>
                <strong class="d-block text-end">
                  <% if @unidad_VI.present? %>
                    <%= number_to_currency(service.value_units * @unidad_VI, unit: "Bs ") %>
                  <% else %>
                    <span class="text-danger">Tasa no disponible</span>
                  <% end %>
                </strong>
              <% else %>
                <span class="text-muted">Sin referencia</span>
              <% end %>
              <hr class="text-primary" style="height: 3px;">
              <h6 class="card-title text-primary fw-bold"><%= service.description %></h6>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <%= turbo_frame_tag "services-#{@pagy.next}", src: pagy_url_for(@pagy, @pagy.next), loading: :lazy if @pagy.next %>
  <%end%>
</div>
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true" data-controller="modal-service">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-primary fw-bold" id="serviceModalLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body position-relative" id="service-modal-body" data-modal-service-target="modalBody" style="max-height: 60vh; overflow-y: auto;">
        <!-- Aquí se cargará el contenido dinámicamente -->
      </div>
    </div>
  </div>
</div>
<style>
  .image-container {
    position: relative;
    width: 100%;
    padding-top: 50%; /* Relación de aspecto 130% */
    overflow: hidden;
  }

  .image-container img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Asegura que la imagen se ajuste al contenedor */
  }
  .image-container img.overlay-no-disponible {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none; /* Permite hacer clic en la imagen de abajo */
    object-fit: contain;
    z-index: 2;
  }
</style>
