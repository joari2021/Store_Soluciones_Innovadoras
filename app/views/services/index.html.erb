<div class="services-scope space-y-6"
  data-active-query-text="<%= @active_query_text %>"
  data-active-system-filter="<%= @active_system_filter %>"
  data-active-status-filter="<%= @active_status_filter %>">
  <div class="services-hero relative overflow-hidden rounded-3xl border border-slate-200 bg-white/80 p-6 shadow-sm">
    <div class="services-hero-glow services-hero-glow--one"></div>
    <div class="services-hero-glow services-hero-glow--two"></div>
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="services-kicker">Catalogo activo</p>
        <h1 class="services-title text-3xl font-extrabold text-slate-900 md:text-4xl">Servicios</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if current_user_admin? %>
          <% if Rails.env.development? %>
          <% end %>
          <%= link_to printing_prices_services_path, class: "inline-flex items-center gap-2 rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-2 text-sm font-semibold text-cyan-700 shadow-sm transition-colors hover:bg-cyan-100", data: { turbo_frame: "_top" } do %>
            <i data-lucide="printer" class="h-4 w-4"></i>
            Precios de Impresiones
          <% end %>
          <%= link_to recarga_parameters_services_path, class: "inline-flex items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 shadow-sm transition-colors hover:bg-emerald-100", data: { turbo_frame: "_top" } do %>
            <i data-lucide="smartphone" class="h-4 w-4"></i>
            Parametros de recargas
          <% end %>
          <%= link_to pending_costs_services_path, class: "inline-flex items-center gap-2 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 shadow-sm transition-colors hover:bg-rose-100", data: { turbo_frame: "_top" } do %>
            <i data-lucide="wallet" class="h-4 w-4"></i>
            Servicios Vendidos
          <% end %>
          <%= link_to new_service_path, class: "inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-slate-200 transition-all hover:bg-slate-800 active:scale-95", data: { turbo_frame: "_top" } do %>
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nuevo servicio
          <% end %>
          <%= link_to system_services_path, class: "inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
            <i data-lucide="layers" class="h-4 w-4"></i>
            System services
          <% end %>
          <%= link_to managers_path, class: "inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
            <i data-lucide="users" class="h-4 w-4"></i>
            Gestores
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="services-search">
    <div class="relative w-full lg:w-[24rem] xl:w-[28rem]">
      <i data-lucide="search" class="services-search-icon"></i>
      <input id="service-search-input" type="text" placeholder="Buscar servicios..." class="services-search-input" value="<%= @active_query_text %>">
      <button type="button" id="service-search-clear" class="services-clear-btn hidden" aria-label="Limpiar busqueda">
        <i data-lucide="x" class="h-3.5 w-3.5"></i>
      </button>
    </div>
  </div>
  <% if @service_systems.any? %>
    <div class="rounded-2xl border border-cyan-100 bg-cyan-50/60 p-3">
      <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Sistemas de servicios</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <button type="button" data-service-system-filter="" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-sky-600 bg-sky-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">
          <span>Todos</span>
          <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-white/20 px-1.5 py-0.5 text-[11px] font-bold text-white"><%= @services_total_count %></span>
        </button>
        <% @service_systems.each do |nombre_sistema, cantidad_items| %>
          <button type="button" data-service-system-filter="<%= nombre_sistema %>" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-cyan-200 bg-white px-3 py-1 text-xs font-semibold text-cyan-700 ring-1 ring-cyan-200 transition-colors hover:bg-cyan-50">
            <span class="max-w-[10rem] truncate"><%= nombre_sistema %></span>
            <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-cyan-100 px-1.5 py-0.5 text-[11px] font-bold text-cyan-700"><%= cantidad_items %></span>
          </button>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="rounded-2xl border border-slate-200 bg-white p-3">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estatus del servicio</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <button type="button" data-service-status-filter="all" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-sky-600 bg-sky-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">
        <span>Todos</span>
        <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-white/20 px-1.5 py-0.5 text-[11px] font-bold text-white"><%= @services_total_count %></span>
      </button>
      <button type="button" data-service-status-filter="available" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-emerald-200 bg-white px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200 transition-colors hover:bg-emerald-50">
        <span>Disponible</span>
        <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-emerald-100 px-1.5 py-0.5 text-[11px] font-bold text-emerald-700"><%= @service_status_counts[:available] %></span>
      </button>
      <button type="button" data-service-status-filter="unavailable" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200 transition-colors hover:bg-slate-50">
        <span>No disponible</span>
        <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-slate-100 px-1.5 py-0.5 text-[11px] font-bold text-slate-700"><%= @service_status_counts[:unavailable] %></span>
      </button>
      <button type="button" data-service-status-filter="caution" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-amber-200 bg-white px-3 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200 transition-colors hover:bg-amber-50">
        <span>Con precaucion</span>
        <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-amber-100 px-1.5 py-0.5 text-[11px] font-bold text-amber-700"><%= @service_status_counts[:caution] %></span>
      </button>
      <% if Current.user&.admin? %>
        <button type="button" data-service-status-filter="restricted" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-rose-200 bg-white px-3 py-1 text-xs font-semibold text-rose-700 ring-1 ring-rose-200 transition-colors hover:bg-rose-50">
          <span>Restringido</span>
          <span class="inline-flex min-w-[1.2rem] items-center justify-center rounded-full bg-rose-100 px-1.5 py-0.5 text-[11px] font-bold text-rose-700"><%= @service_status_counts[:restricted] %></span>
        </button>
      <% end %>
    </div>
  </div>
  <% if @services.any? || @pagy.page.to_i > 1 %>
    <div class="services-cards-grid grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
      <%= turbo_frame_tag "services-#{@pagy.page}", class: "contents" do %>
        <% @services.each_with_index do |service, index| %>
          <% system_name = service.system_service&.name || "Sistema" %>
          <% tasa_dolar = @tasa_dolar_bcv.is_a?(Numeric) ? @tasa_dolar_bcv.to_d : nil %>
          <% unidad_vi = @unidad_VI.is_a?(Numeric) ? @unidad_VI.to_d : nil %>
          <% service_query = [service.description, system_name].map { |val| val.to_s }.join(' ').downcase %>
          <article class="services-card group flex h-full flex-col rounded-2xl p-3 shadow-sm"
                   data-service-query="<%= service_query %>"
                   data-service-system="<%= system_name %>"
                   data-service-available="<%= service.available? %>"
                   data-service-caution="<%= service.caution_service? %>"
                   data-service-restricted="<%= service.restricted_service? %>"
                   style="animation-delay: <%= (index % 6) * 0.05 %>s;">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= system_name %></p>
                <div class="mt-1 flex flex-wrap gap-1">
                  <% if service.caution_service? %>
                    <span class="rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-700">Con precaucion</span>
                  <% end %>
                  <% if service.restricted_service? %>
                    <span class="rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-rose-700">Restringido</span>
                  <% end %>
                </div>
              </div>
              <span class="services-status <%= service.available? ? 'services-status--ok' : 'services-status--off' %>">
                <%= service.available? ? 'Disponible' : 'No disponible' %>
              </span>
            </div>
            <div class="relative mt-3 aspect-[16/10] overflow-hidden rounded-xl bg-slate-100">
              <% if service.system_service&.recarga_system? && service.recarga_image&.attached? %>
                <%= image_tag service.recarga_image, class: "h-full w-full object-cover transition duration-500 group-hover:scale-105", alt: service.description %>
              <% elsif service.system_service&.image&.attached? %>
                <%= image_tag service.system_service.image, class: "h-full w-full object-cover transition duration-500 group-hover:scale-105", alt: service.system_service.name %>
              <% else %>
                <div class="flex h-full items-center justify-center text-slate-300">
                  <i data-lucide="image-off" class="h-10 w-10"></i>
                </div>
              <% end %>
              <% unless service.available? %>
                <div class="absolute inset-0 flex items-center justify-center bg-slate-900/60 text-xs font-semibold uppercase tracking-widest text-white">
                  No disponible
                </div>
              <% end %>
              <span class="services-pill absolute bottom-2 left-2"><%= system_name %></span>
            </div>
            <h3 class="services-card-title mt-3 text-base font-bold text-slate-800"><%= service.description %></h3>
            <div class="services-card-pricing mt-3 flex items-end justify-between gap-3">
              <div class="services-card-price">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Precio</p>
                <% if service.to_agree? %>
                  <p class="text-lg font-extrabold text-amber-600">A convenir</p>
                  <p class="text-xs text-slate-500">Se define al facturar</p>
                <% else %>
                  <% unit_price_usd = service.unit_price_usd(tasa_dolar: tasa_dolar, unidad_vi: unidad_vi) %>
                  <% unit_price_bs = service.unit_price_bs(tasa_dolar: tasa_dolar, unidad_vi: unidad_vi) %>
                  <% if unit_price_usd.present? %>
                    <p class="text-lg font-extrabold text-slate-800"><%= format_money(unit_price_usd, unit: "$ ") %></p>
                    <% if unit_price_bs.present? %>
                      <p class="text-xs text-slate-500"><%= format_money(unit_price_bs, unit: "Bs ") %></p>
                    <% end %>
                  <% elsif unit_price_bs.present? %>
                    <p class="text-lg font-extrabold text-slate-800"><%= format_money(unit_price_bs, unit: "Bs ") %></p>
                  <% else %>
                    <p class="text-xs text-amber-600">Precio no disponible</p>
                  <% end %>
                <% end %>
              </div>
              <div class="services-card-actions flex items-center gap-2">
                <% can_open_show_modal = Current.user&.admin? || service.available? %>
                <% if can_open_show_modal %>
                  <button type="button"
                          class="services-icon-btn view-service cursor-pointer"
                          data-service-id="<%= service.id %>"
                          data-service-description="<%= service.description.upcase %> (<%= system_name.upcase %>)"
                          data-service-caution="<%= service.caution_notice_for?(Current.user) %>"
                          data-user-admin="<%= Current.user&.admin? %>"
                          title="Ver detalles">
                    <i data-lucide="eye" class="h-4 w-4"></i>
                  </button>
                <% end %>
                <% if Current.user&.admin? %>
                  <%= link_to edit_service_path(service), class: "services-icon-btn services-icon-btn--accent", title: "Editar", data: { turbo_frame: "_top" } do %>
                    <i data-lucide="pencil" class="h-4 w-4"></i>
                  <% end %>
                  <%= link_to service_path(service), class: "services-icon-btn services-icon-btn--danger", data: { turbo_method: :delete, swal_delete: "service" }, title: "Eliminar" do %>
                    <i data-lucide="trash" class="h-4 w-4"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
            <% if Current.user&.admin? %>
              <div class="services-card-costs mt-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-2 text-[11px] text-slate-600">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Costos</p>
                <% active_cost_structure = service.active_expense_structures_for_sales.first %>
                <% if service.cost && active_cost_structure.present? %>
                  <% structure_usd = active_cost_structure.total_usd(tasa_dolar: tasa_dolar, unidad_vi: unidad_vi) %>
                  <% structure_bs = active_cost_structure.total_bs(tasa_dolar: tasa_dolar, unidad_vi: unidad_vi) %>
                  <div class="services-card-costs-list mt-2">
                    <div class="space-y-1.5 py-1.5">
                      <p class="truncate font-semibold text-slate-700"><%= active_cost_structure.description %></p>
                      <div class="flex items-center justify-between gap-2 text-[11px]">
                        <span class="text-slate-500">$ BCV</span>
                        <span class="font-semibold text-slate-700"><%= format_money(structure_usd, unit: "$ ") %></span>
                      </div>
                      <div class="flex items-center justify-between gap-2 text-[11px]">
                        <span class="text-slate-500">Bs</span>
                        <span class="font-semibold text-slate-700"><%= format_money(structure_bs, unit: "Bs ") %></span>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <p class="mt-2 text-slate-400">Sin costos.</p>
                <% end %>
              </div>
            <% end %>
          </article>
        <% end %>
        <% if @pagy.next %>
          <%= turbo_frame_tag "services-#{@pagy.next}", src: pagy_url_for(@pagy, @pagy.next), loading: :lazy, class: "col-span-full" do %>
            <div class="flex items-center justify-center gap-3 py-6 text-sm text-slate-500">
              <span class="h-5 w-5 animate-spin rounded-full border-2 border-slate-200 border-t-slate-500"></span>
              Cargando mas servicios...
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
        <i data-lucide="sparkles" class="h-6 w-6"></i>
      </div>
      <h3 class="text-base font-semibold text-slate-700">No hay servicios registrados</h3>
      <p class="mt-1 text-sm text-slate-500">Crea tu primer servicio para empezar a vender.</p>
    </div>
  <% end %>
</div>
<div id="serviceModal" class="services-modal fixed inset-0 z-50 hidden items-center justify-center p-4" aria-hidden="true" data-controller="modal-service">
  <div class="services-modal-backdrop absolute inset-0" data-modal-service-close></div>
  <div class="services-modal-panel relative w-full max-w-5xl overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl">
    <div class="flex items-start justify-between gap-4 border-b border-slate-100 bg-white/90 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Detalle del servicio</p>
        <h2 id="serviceModalLabel" data-modal-service-target="modalTitle" class="mt-2 text-xl font-extrabold text-slate-800"></h2>
      </div>
      <button type="button" class="services-modal-close" data-modal-service-close aria-label="Cerrar">
        <i data-lucide="x" class="h-4 w-4"></i>
      </button>
    </div>
    <div id="service-modal-body" class="max-h-[70vh] overflow-y-auto px-6 pb-6 pt-5" data-modal-service-target="modalBody"></div>
  </div>
</div>
<script>
  document.addEventListener("turbo:load", () => {
    const scope = document.querySelector(".services-scope");
    const searchInput = document.getElementById("service-search-input");
    const clearButton = document.getElementById("service-search-clear");
    const serviceSystemButtons = Array.from(document.querySelectorAll("[data-service-system-filter]"));
    const serviceStatusButtons = Array.from(document.querySelectorAll("[data-service-status-filter]"));
    if (!scope || !searchInput || !clearButton) return;
    if (searchInput.dataset.bound === "true") return;
    searchInput.dataset.bound = "true";

    let activeQuery = String(scope.dataset.activeQueryText || "").trim();
    let activeSystem = String(scope.dataset.activeSystemFilter || "").trim();
    let activeStatus = String(scope.dataset.activeStatusFilter || "all").trim() || "all";

    const normalizeSearchValue = (value) => {
      return String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    };

    const applySearch = () => {
      const query = normalizeSearchValue(activeQuery);
      const systemFilter = normalizeSearchValue(activeSystem);
      const statusFilter = normalizeSearchValue(activeStatus);

      clearButton.classList.toggle("hidden", query.length === 0);

      document.querySelectorAll('[data-service-query]').forEach((card) => {
        const cardQuery = normalizeSearchValue(card.dataset.serviceQuery || '');
        const cardSystem = normalizeSearchValue(card.dataset.serviceSystem || '');
        const matchesQuery = query.length === 0 || cardQuery.includes(query);
        const matchesSystem = systemFilter.length === 0 || cardSystem === systemFilter;

        let matchesStatus = true;
        if (statusFilter === 'available') {
          matchesStatus = String(card.dataset.serviceAvailable) === 'true';
        } else if (statusFilter === 'unavailable') {
          matchesStatus = String(card.dataset.serviceAvailable) === 'false';
        } else if (statusFilter === 'caution') {
          matchesStatus = String(card.dataset.serviceCaution) === 'true';
        } else if (statusFilter === 'restricted') {
          matchesStatus = String(card.dataset.serviceRestricted) === 'true';
        }

        card.classList.toggle('hidden', !(matchesQuery && matchesSystem && matchesStatus));
      });
    };

    const updateClearButton = () => {
      clearButton.classList.toggle("hidden", String(activeQuery || '').trim().length === 0);
    };

    const updateServiceSystemFilterStyles = () => {
      serviceSystemButtons.forEach((button) => {
        const systemValue = String(button.dataset.serviceSystemFilter || "").trim();
        const isActive = systemValue === activeSystem;

        button.classList.toggle("bg-sky-600", isActive);
        button.classList.toggle("text-white", isActive);
        button.classList.toggle("border-sky-600", isActive);
        button.classList.toggle("shadow-sm", isActive);
        button.classList.toggle("hover:bg-sky-700", isActive);
        button.classList.toggle("hover:text-white", isActive);

        button.classList.toggle("bg-white", !isActive);
        button.classList.toggle("text-cyan-700", !isActive);
        button.classList.toggle("border-cyan-200", !isActive);
        button.classList.toggle("ring-1", !isActive);
        button.classList.toggle("ring-cyan-200", !isActive);
        button.classList.toggle("hover:bg-cyan-50", !isActive);
        button.classList.toggle("hover:text-cyan-700", !isActive);
      });
    };

    const updateServiceStatusFilterStyles = () => {
      serviceStatusButtons.forEach((button) => {
        const statusValue = String(button.dataset.serviceStatusFilter || "all").trim();
        const isActive = statusValue === activeStatus;

        button.classList.toggle("bg-sky-600", isActive);
        button.classList.toggle("text-white", isActive);
        button.classList.toggle("border-sky-600", isActive);
        button.classList.toggle("shadow-sm", isActive);
        button.classList.toggle("hover:bg-sky-700", isActive);

        button.classList.toggle("bg-white", !isActive);
        button.classList.toggle("text-slate-700", !isActive);
        button.classList.toggle("border-slate-200", !isActive);
        button.classList.toggle("ring-1", !isActive);
        button.classList.toggle("ring-slate-200", !isActive);
        button.classList.toggle("hover:bg-slate-50", !isActive);
      });
    };

    searchInput.addEventListener("input", () => {
      activeQuery = String(searchInput.value || "").trim();
      applySearch();
    });

    clearButton.addEventListener("click", () => {
      searchInput.value = "";
      activeQuery = "";
      updateClearButton();
      searchInput.focus();
      applySearch();
    });

    serviceSystemButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeSystem = String(button.dataset.serviceSystemFilter || "").trim();
        updateServiceSystemFilterStyles();
        applySearch();
      });
    });

    serviceStatusButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeStatus = String(button.dataset.serviceStatusFilter || "all").trim();
        updateServiceStatusFilterStyles();
        applySearch();
      });
    });

    if (!document.body.dataset.servicesFramesBound) {
      document.body.dataset.servicesFramesBound = "true";
      document.addEventListener("turbo:frame-load", (event) => {
        const frame = event?.target;
        const frameId = String(frame?.id || "");
        if (!frameId.startsWith("services-")) return;

        frame.classList.remove("col-span-full");
        frame.classList.add("contents");
        applySearch();
      });
    }

    updateServiceSystemFilterStyles();
    updateServiceStatusFilterStyles();
    updateClearButton();
    applySearch();
  });
</script>
<%= render "services/styles" %>
