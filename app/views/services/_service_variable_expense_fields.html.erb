<% reference = expense_reference_for_form(f.object, rows: expense_currency_rows) %>
<% reference_symbol = currency_symbol_for_reference(reference, rows: expense_currency_rows, fallback: "$") %>
<% reference_amount = expense_reference_amount_for_form(f.object, reference: reference) %>
<div class="rounded-xl border border-slate-200 bg-white p-3" data-nested-row data-money-pair>
  <%= f.hidden_field :_destroy, data: { destroy_input: true } %>
  <%= f.hidden_field :amount_usd,
                     value: f.object.amount_usd.to_d,
                     data: { money_role: "usd" } %>
  <%= f.hidden_field :amount_bs,
                     value: f.object.amount_bs.to_d,
                     data: { money_role: "bs" } %>
  <div class="grid gap-3 md:grid-cols-5">
    <div class="md:col-span-2">
      <%= f.label :description, "Descripcion", class: "block text-xs font-semibold uppercase tracking-wide text-slate-500" %>
      <%= f.text_field :description,
                       class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                       placeholder: "Ej: Arancel, timbre fiscal" %>
    </div>
    <div>
      <%= f.label :currency_reference, "Divisa", class: "block text-xs font-semibold uppercase tracking-wide text-slate-500" %>
      <%= f.select :currency_reference,
                   currency_reference_options_for_select(rows: expense_currency_rows, selected: reference),
                   { selected: reference },
                   class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                   data: { expense_currency_select: true } %>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500" data-expense-reference-label>
        Monto <%= reference %>
      </label>
      <%= f.text_field :amount_reference,
                       value: format_money(reference_amount, unit: reference_symbol),
                       class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                       autocomplete: "off",
                       data: {
                         money_mask: true,
                         money_symbol: reference_symbol,
                         expense_reference_amount: true
                       } %>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Equivalente $ BCV</label>
      <input type="text"
             value="<%= format_money(f.object.amount_usd, unit: "$") %>"
             class="mt-1 block w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 shadow-sm"
             readonly
             tabindex="-1"
             data-expense-usd-display
             data-money-mask="true"
             data-money-symbol="$"
             autocomplete="off">
    </div>
  </div>
  <div class="mt-3 flex justify-end">
    <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100" data-remove-nested-row>
      Eliminar
    </button>
  </div>
</div>
