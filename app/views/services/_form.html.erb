              customServiceImageToggle.disabled = isRecargaSystem;
              customServiceImageSection.classList.toggle('opacity-70', isRecargaSystem);

              const showPanel = !isRecargaSystem && customServiceImageToggle.checked;
              if (customServiceImagePanel) {
                customServiceImagePanel.classList.toggle('hidden', !showPanel);
