                  </label>
                  <div class="mt-2 hidden" data-print-page-lamination-wrapper>
                    <select class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" data-print-page-lamination-service>
                      <option value="">Selecciona servicio</option>
                      ${laminationServicesPayload.map((service) => `<option value="${String(service?.id || '')}">${String(service?.name || '')}</option>`).join('')}
                    </select>
                  </div>
                </div>
                <button type="button" class="self-center justify-self-end inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100" data-remove-print-page title="Quitar pagina" aria-label="Quitar pagina"><i data-lucide="trash-2" class="h-3.5 w-3.5"></i></button>
              `;
              printPagesContainer.appendChild(row);

              const rowTypeSelect = row.querySelector('[data-print-page-type]');
              if (rowTypeSelect && defaultTypeId) rowTypeSelect.value = defaultTypeId;
              setPageRowMaterialOptions(row, rowTypeSelect?.value || '', { keepCurrent: false });

              const rowMaterialSelect = row.querySelector('[data-print-page-material]');
              if (rowMaterialSelect && defaultMaterialId) rowMaterialSelect.value = defaultMaterialId;
              refreshPageLaminationVisibility(row);

              window.MoneyInputMask?.init(row);
              if (window.lucide?.createIcons) window.lucide.createIcons({ attrs: { 'stroke-width': 2 } });
              renumberPrintPages();
              syncPrintPagesHidden();
              recalculatePrintCost();
            };

            addPrintCoverageButton?.addEventListener('click', () => {
              if (!printCoverageContainer || !printCoverageTemplate) return;

              const placeholder = printCoverageTemplate.dataset.placeholder;
              const token = `${Date.now()}${Math.floor(Math.random() * 1000)}`;
              const html = (printCoverageTemplate.innerHTML || '').split(placeholder).join(token);
              printCoverageContainer.insertAdjacentHTML('beforeend', html);
              window.MoneyInputMask?.init(printCoverageContainer);
