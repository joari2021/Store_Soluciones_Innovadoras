<div class="fondo-opaco position-relative" style="width: 100%; border: 1px solid black;">
  <%= form_with(model: @service, local: true, data: { controller: "form-services", tasa_bcv: @tasa_dolar_bcv, tasas: @tasas.to_json }, id: "form-services") do |form| %>
    <% if @service.errors.any? %>
      <div class="alert alert-danger">
        <h4>Errores:</h4>
        <ul>
          <% @service.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="row">
      <div class="col-md-3 mb-2">
        <div class="form-check form-switch mt-4">
          <%= form.label :available, "Servicio disponible", class: "form-check-label", for: "available" %>
          <%= form.check_box :available, class: "form-check-input", id: "available" %>
        </div>
      </div>
      <hr>
      <div class="col-md-3 mb-2">
        <%= form.label :system_service_id, "System Service", class:"form-label" %>
        <%= form.collection_select :system_service_id, SystemService.order(:name), :id, :name, { include_blank: "Selecciona Un Sistema" }, class: "form-control" %>
      </div>
      <div class="col-md-3 mb-2">
        <%= form.label :description, "Descripcion", class:"form-label" %>
        <%= form.text_field :description, class: "form-control" %>
      </div>
      <div class="col-md-3 mb-2">
        <%= form.label :currency_base_price, "Referencia del Precio", class:"form-label" %>
        <%= form.select :currency_base_price, [["Bs", "Bs"], ["$", "$"]], { include_blank: "Selecciona una opción" }, class: "form-control", data: { action: "change->form-services#toggleFields" } %>
      </div>
      <div class="col-md-3 mb-2" id="value-units-field">
        <%= form.label :value_units, "Unidades de Valor", class:"form-label" %>
        <%= form.number_field :value_units, step: 0.01, class: "form-control" %>
      </div>
      <div class="col-md-3 mb-2" id="sale-price-field" style="display: none;">
        <%= form.label :sale_price, "Precio", class:"form-label" %>
        <%= form.number_field :sale_price, step: 0.01, class: "form-control" %>
      </div>
      <hr class="my-2">
      <div class="col-md-3 mb-2">
        <%= form.label :physical_requirements, "Requisitos Fisicos", class:"form-label" %>
        <%= form.text_area :physical_requirements, class: "form-control" %>
      </div>
      <div class="col-md-3 mb-2">
        <%= form.label :digital_requirements, "Requisitos Digitales (Fotos o Escaneos)", class:"form-label" %>
        <%= form.text_area :digital_requirements, class:"form-control" %>
      </div>
      <div class="col-md-3 mb-2">
        <%= form.label :required_data, "Datos Requeridos", class:"form-label" %>
        <%= form.text_area :required_data, class:"form-control" %>
      </div>
      <div class="col-md-3 mb-2">
        <%= form.label :personal_steps, "Pasos a Seguir (Solo Personal Autorizado)", class:"form-label" %>
        <%= form.text_area :personal_steps, class:"form-control" %>
      </div>
      <div class="col-md-3 mb-2">
        <%= form.label :note, "Nota", class:"form-label" %>
        <%= form.text_area :note, class:"form-control" %>
      </div>
      <div class="col-md-3 mb-2">
        <%= form.label :delivery_content, "Contenido de Entrega", class:"form-label" %>
        <%= form.text_area :delivery_content, class:"form-control" %>
      </div>
      <div class="col-md-3 mb-2">
        <%= form.label :delivery_time, "Tiempo de Entrega", class:"form-label" %>
        <%= form.text_field :delivery_time, class:"form-control" %>
      </div>
      <div class="col-md-3 my-4 ms-3 form-check">
        <%= form.check_box :cost, class: "form-check-input", id: "cost", data: { action: "change->form-services#toggleManagers" } %>
        <%= form.label :cost, "Tiene Costo", class: "form-check-label", for: "cost" %>
      </div>
      <div id="service_managers" style="display: none;">
        <%= form.fields_for :service_managers do |m| %>
          <% unless m.object.new_record? %>
            <%= render "service_manager_fields", m: m %>
          <% end %>
        <% end %>
      </div>
      <div id="add-manager-link" class="mb-3" style="display: none;">
        <%= link_to_add_service_managers "Añadir Gestor", form, :service_managers %>
      </div>
      <hr>
      <div class="">
        <%= form.submit "Actualizar", class: "btn btn-primary" %>
        <%= link_to 'Volver', services_path, class: "btn btn-secondary ms-2" %>
      </div>
    </div>
  <% end %>
</div>
<script>
  // Ajusta todos los textarea automáticamente al escribir
  document.addEventListener("input", function(e) {
    if (e.target.tagName.toLowerCase() === "textarea") {
      e.target.style.height = "auto";
      e.target.style.height = (e.target.scrollHeight) + "px";
    }
  });

  // Ajusta todos los textarea automáticamente al cargar la página o al navegar con Turbo
  function autoResizeTextareas() {
    document.querySelectorAll("textarea").forEach(function(textarea) {
      textarea.style.height = "auto";
      textarea.style.height = (textarea.scrollHeight) + "px";
    });
  }

  document.addEventListener("DOMContentLoaded", autoResizeTextareas);
  document.addEventListener("turbo:load", autoResizeTextareas);
</script>
