      <script type="application/json" id="service-print-type-services-data">
        <%= raw ERB::Util.json_escape((@print_type_services_payload || []).to_json) %>
      </script>
      <script type="application/json" id="service-lamination-services-data">
        <%= raw ERB::Util.json_escape((@lamination_services_payload || []).to_json) %>
      </script>
      <script type="application/json" id="service-rcv-system-ids-data">
        <%= raw ERB::Util.json_escape((@rcv_system_service_ids || []).to_json) %>
      </script>
      <script type="application/json" id="service-rcv-shared-template-data">
        <%= raw ERB::Util.json_escape((@rcv_shared_template || {}).to_json) %>
      </script>
      <script>
        (() => {
          if (window.servicesResizeTextareasBound) return;
          window.servicesResizeTextareasBound = true;

          const resizeTextareas = (scope) => {
            scope.querySelectorAll("textarea").forEach((textarea) => {
              textarea.style.height = "auto";
              textarea.style.height = `${textarea.scrollHeight}px`;
            });
          };

          const handleInput = (event) => {
            const textarea = event.target.closest("#form-services textarea");
            if (!textarea) return;
            textarea.style.height = "auto";
            textarea.style.height = `${textarea.scrollHeight}px`;
          };

          const handleLoad = () => {
            const form = document.getElementById("form-services");
            if (!form) return;
            const systemServiceSelect = form.querySelector('#service_system_service_id');

            resizeTextareas(form);

            const cautionFlag = form.querySelector('[data-caution-flag="true"]');
            const restrictedFlag = form.querySelector('[data-restricted-flag="true"]');
            const statusExtraCards = Array.from(form.querySelectorAll('[data-status-extra-card="true"]'));
            const statusExtraInputs = [
              cautionFlag,
              restrictedFlag
            ].filter(Boolean);

            const normalizedText = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

            const selectedSystemLabel = () => {
              if (!systemServiceSelect) return '';

              const selectedOption = systemServiceSelect.options[systemServiceSelect.selectedIndex];
              return normalizedText(selectedOption?.textContent || '');
            };

            const isPrintingSystemServiceSelected = () => {
              const label = selectedSystemLabel();
              return /impres/.test(label);
            };

            const isLaminationSystemServiceSelected = () => {
              const label = selectedSystemLabel();
              return /plast/.test(label);
            };

            const isBindingSystemServiceSelected = () => {
              const label = selectedSystemLabel();
              return /encuadern/.test(label);
            };

            const isRecargaSystemServiceSelected = () => {
              const label = selectedSystemLabel();
              return /recarga/.test(label);
            };

            const isRcvSystemServiceSelected = () => {
              if (!systemServiceSelect) return false;

              const selectedId = Number.parseInt(String(systemServiceSelect.value || '').trim(), 10);
              if (Number.isInteger(selectedId) && rcvSystemServiceIds.includes(selectedId)) {
                return true;
              }

              const label = selectedSystemLabel();
              return /\brcv\b/.test(label);
            };

            const fieldIsBlank = (field) => {
              if (!field) return true;
              if (field.type === 'checkbox') return false;
              return String(field.value || '').trim().length === 0;
            };

            const toBoolean = (value) => {
              if (value === true || value === false) return value;
              const normalized = String(value || '').trim().toLowerCase();
              return ['1', 'true', 't', 'yes', 'si', 'on'].includes(normalized);
            };

            const applyRcvSharedTemplate = ({ force = false } = {}) => {
              if (!isCreateForm) return;
              if (!isRcvSystemServiceSelected()) return;
              if (!rcvSharedTemplate || Object.keys(rcvSharedTemplate).length === 0) return;

              Object.entries(rcvSharedFields).forEach(([attribute, fieldId]) => {
                const field = form.querySelector(`#${fieldId}`);
                if (!field) return;

                const templateValue = rcvSharedTemplate[attribute];
                if (field.type === 'checkbox') {
                  field.checked = toBoolean(templateValue);
                  return;
                }

                if (!force && !fieldIsBlank(field)) return;
                field.value = templateValue == null ? '' : String(templateValue);
              });

              resizeTextareas(form);
            };

            const refreshStatusVisibility = () => {
              const printingSelected = isPrintingSystemServiceSelected();

              statusExtraCards.forEach((card) => {
                card.classList.toggle('hidden', printingSelected);
              });

              statusExtraInputs.forEach((input) => {
                input.disabled = printingSelected;
                if (printingSelected) input.checked = false;
              });
            };

            if (form.dataset.statusBound === "true") return;
            form.dataset.statusBound = "true";

            if (cautionFlag && restrictedFlag) {
              cautionFlag.addEventListener("change", () => {
                if (!cautionFlag.checked) return;
                restrictedFlag.checked = false;
              });

              restrictedFlag.addEventListener("change", () => {
                if (!restrictedFlag.checked) return;
                cautionFlag.checked = false;
              });
            }

            if (form.dataset.printingConfigBound === "true") return;
            form.dataset.printingConfigBound = "true";

            const deliverySection = form.querySelector('[data-delivery-section]');
            const requirementsSection = form.querySelector('[data-requirements-section]');
            const deliveryMetadataSection = form.querySelector('[data-delivery-metadata-section]');
            const printCoverageSection = form.querySelector('[data-print-coverage-section]');
            const laminationMaterialSection = form.querySelector('[data-lamination-material-section]');
            const printingOnlySections = Array.from(form.querySelectorAll('[data-printing-only-section]'));
            const addPrintCoverageButton = form.querySelector('[data-add-print-coverage-row]');
            const printCoverageContainer = form.querySelector('[data-print-coverage-container]');
            const printCoverageTemplate = form.querySelector('#service-print-coverage-template');
            const addPrintMaterialSurchargeButton = form.querySelector('[data-add-print-material-surcharge-row]');
            const printMaterialSurchargeContainer = form.querySelector('[data-print-material-surcharge-container]');
            const printMaterialSurchargeTemplate = form.querySelector('#service-print-material-surcharge-template');
            const addLaminationMaterialButton = form.querySelector('[data-add-lamination-material-row]');
            const laminationMaterialContainer = form.querySelector('[data-lamination-material-container]');
            const laminationMaterialTemplate = form.querySelector('#service-lamination-material-template');

            const physicalToggle = form.querySelector('[data-delivery-physical-toggle="true"]');
            const digitalToggle = form.querySelector('[data-delivery-digital-toggle="true"]');
            const physicalPanel = form.querySelector('[data-delivery-physical-panel]');
            const printPagesContainer = form.querySelector('[data-print-pages-container]');
            const addPrintPageButton = form.querySelector('[data-add-print-page]');
            const printPagesHidden = form.querySelector('[data-print-pages-hidden="true"]');
            const printCostBsElement = form.querySelector('[data-print-cost-bs]');
            const physicalExtraProductsSection = form.querySelector('[data-physical-extra-products-section]');
            const physicalExtraProductsContainer = form.querySelector('[data-physical-extra-products-container]');
            const addPhysicalExtraProductButton = form.querySelector('[data-add-physical-extra-product-row]');
            const physicalExtraProductsHidden = form.querySelector('[data-physical-extra-products-hidden="true"]');
            const customServiceImageSection = form.querySelector('[data-custom-service-image-section]');
            const customServiceImageToggle = form.querySelector('[data-custom-service-image-toggle="true"]');
            const customServiceImagePanel = form.querySelector('[data-custom-service-image-panel]');
            const customServiceImageInput = form.querySelector('[data-custom-service-image-input="true"]');
            const customServiceImageRecargaNote = form.querySelector('[data-custom-service-image-recarga-note]');

            const printTypesPayload = (() => {
              try {
                const payloadEl = document.getElementById('service-print-type-services-data');
                return JSON.parse(payloadEl?.textContent || '[]');
              } catch (_error) {
                return [];
              }
            })();

            const laminationServicesPayload = (() => {
              try {
                const payloadEl = document.getElementById('service-lamination-services-data');
                return JSON.parse(payloadEl?.textContent || '[]');
              } catch (_error) {
                return [];
              }
            })();

            const rcvSystemServiceIds = (() => {
              try {
                const payloadEl = document.getElementById('service-rcv-system-ids-data');
                return JSON.parse(payloadEl?.textContent || '[]')
                  .map((value) => Number.parseInt(String(value || '').trim(), 10))
                  .filter((value) => Number.isInteger(value) && value > 0);
              } catch (_error) {
                return [];
              }
            })();

            const rcvSharedTemplate = (() => {
              try {
                const payloadEl = document.getElementById('service-rcv-shared-template-data');
                const parsed = JSON.parse(payloadEl?.textContent || '{}');
                return parsed && typeof parsed === 'object' ? parsed : {};
              } catch (_error) {
                return {};
              }
            })();

            const rcvSharedFields = {
              physical_requirements: 'service_physical_requirements',
              digital_requirements: 'service_digital_requirements',
              required_data: 'service_required_data',
              personal_steps: 'service_personal_steps',
              note: 'service_note',
              delivery_content: 'service_delivery_content',
              delivery_time: 'service_delivery_time',
              delivery_physical_enabled: 'service_delivery_physical_enabled',
              delivery_digital_enabled: 'service_delivery_digital_enabled',
              warn_digital_only_delivery_in_sales: 'service_warn_digital_only_delivery_in_sales'
            };

            const isCreateForm = String(form.dataset.newRecord || '').toLowerCase() === 'true';

            const physicalExtraProductOptionsHtml = `<option value="">Selecciona producto</option><%= j(products_options_for_select(products: @products_for_expenses, bcv_rate: @service_expenses_bcv_rate, selected_id: nil).to_s) %>`;

            const parseProductVariationsFromOption = (option) => {
              if (!option) return [];

              try {
                const raw = option.dataset.variations;
                const parsed = JSON.parse(raw || '[]');
                if (!Array.isArray(parsed)) return [];

                return parsed
                  .map((row) => ({
                    id: Number.parseInt(String(row?.id || '').trim(), 10),
                    description: String(row?.description || '').trim(),
                  }))
                  .filter((row) => Number.isInteger(row.id) && row.id > 0);
              } catch (_error) {
                return [];
              }
            };

            const buildVariationOptionsHtml = (variations, selectedId = '') => {
              const safeSelectedId = String(selectedId || '').trim();

              const rows = ['<option value="">Selecciona variacion</option>']
                .concat((Array.isArray(variations) ? variations : []).map((variation) => {
                  const optionId = String(variation?.id || '').trim();
                  const optionLabel = String(variation?.description || '').trim() || 'Variacion';
                  const selectedAttr = optionId && optionId === safeSelectedId ? ' selected' : '';

                  return `<option value="${optionId}"${selectedAttr}>${optionLabel}</option>`;
                }));

              return rows.join('');
            };

            const syncPhysicalExtraVariationOptions = (row, { keepCurrent = true } = {}) => {
              if (!row) return;

              const productSelect = row.querySelector('[data-product-select]');
              const variationSelect = row.querySelector('[data-physical-extra-variation]');
              if (!productSelect || !variationSelect) return;

              const selectedProductId = String(productSelect.value || '').trim();
              const hasPreviousProduct = Object.prototype.hasOwnProperty.call(row.dataset, 'physicalExtraPreviousProductId');
              const previousProductId = hasPreviousProduct
                ? String(row.dataset.physicalExtraPreviousProductId || '').trim()
                : selectedProductId;
              const selectedProductOption = productSelect.options[productSelect.selectedIndex] || null;
              const variations = parseProductVariationsFromOption(selectedProductOption);
              const currentVariationValue = String(variationSelect.value || '').trim();
              const productChanged = hasPreviousProduct && previousProductId !== selectedProductId;
              const selectedVariationId = keepCurrent && !productChanged ? currentVariationValue : '';

              variationSelect.innerHTML = buildVariationOptionsHtml(variations, selectedVariationId);
              variationSelect.disabled = variations.length === 0;

              if (selectedVariationId) {
                const canKeep = variations.some((variation) => String(variation.id) === currentVariationValue);
                if (!canKeep) variationSelect.value = '';
              }

              row.dataset.physicalExtraPreviousProductId = selectedProductId;
            };

            const parseMaskedMoney = (input) => {
              if (!input) return 0;
              if (window.MoneyInputMask?.parseValue) return Number(window.MoneyInputMask.parseValue(input) || 0);

              const cleaned = String(input.value || '').replace(/\s/g, '').replace(/[^\d.,-]/g, '');
              if (!cleaned) return 0;
              const normalized = cleaned.includes(',') ? cleaned.replace(/\./g, '').replace(',', '.') : cleaned;
              const parsed = Number.parseFloat(normalized);
              return Number.isFinite(parsed) ? parsed : 0;
            };

            const parsePrintCoverageValue = (input) => {
              const raw = parseMaskedMoney(input);
              if (!Number.isFinite(raw)) return 0;
              const clamped = Math.min(Math.max(raw, 0), 100);
              return Number(clamped.toFixed(2));
            };

            const formatMoneyValue = (value, symbol) => {
              if (window.MoneyInputMask?.formatMoney) {
                return window.MoneyInputMask.formatMoney(Number(value || 0), symbol || 'Bs');
              }

              const safeValue = Number.isFinite(Number(value)) ? Number(value) : 0;
              return `${symbol || 'Bs'} ${safeValue.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            };

            const setSectionDisabled = (section, disabled) => {
