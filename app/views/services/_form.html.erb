              row.setAttribute('data-print-page-row', '');
              row.innerHTML = `
                <div class="self-center text-xs font-semibold text-slate-600" data-print-page-label>Pagina</div>
                <div>
                  <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Tipo de impresion</label>
                  <select class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" data-print-page-type>
                    <option value="">Selecciona tipo</option>
                    ${printTypesPayload
                      .filter((row) => String(row?.id || '').trim() !== String(form.dataset.serviceId || '').trim())
                      .map((row) => `<option value="${String(row.id || '')}">${String(row.name || '')}</option>`)
                      .join('')}
                  </select>
                </div>
                <div>
                  <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Material</label>
                  <select class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" data-print-page-material>
                    <option value="">Selecciona material</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Cobertura (%)</label>
                  <input type="text" inputmode="decimal" class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" data-print-page-coverage data-money-mask="true" data-money-symbol="%" value="%1,00">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Costo pagina (Bs)</label>
                  <input type="text" readonly class="mt-1 block w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-700" data-print-page-cost-bs value="Bs 0,00">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Plastificacion</label>
                  <label class="mt-1 inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700">
                    <input type="checkbox" class="h-4 w-4 cursor-pointer rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" data-print-page-lamination-enabled>
