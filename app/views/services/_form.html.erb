            const refreshPrintCoverageVisibility = () => {
              const printingSelected = isPrintingSystemServiceSelected();
              const laminationSelected = isLaminationSystemServiceSelected();
              const bindingSelected = isBindingSystemServiceSelected();
              const excludePresentations = printingSelected || laminationSelected;
              const excludeRequirementsAndDeliveryMetadata = printingSelected || laminationSelected || bindingSelected;

              if (requirementsSection) {
                requirementsSection.classList.toggle('hidden', excludeRequirementsAndDeliveryMetadata);
                requirementsSection.style.display = excludeRequirementsAndDeliveryMetadata ? 'none' : '';
                setSectionDisabled(requirementsSection, excludeRequirementsAndDeliveryMetadata);
              }

              if (deliveryMetadataSection) {
                deliveryMetadataSection.classList.toggle('hidden', excludeRequirementsAndDeliveryMetadata);
                deliveryMetadataSection.style.display = excludeRequirementsAndDeliveryMetadata ? 'none' : '';
                setSectionDisabled(deliveryMetadataSection, excludeRequirementsAndDeliveryMetadata);
              }

              if (deliverySection) {
                deliverySection.classList.toggle('hidden', excludePresentations);
                setSectionDisabled(deliverySection, excludePresentations);
              }

              if (printCoverageSection) {
                printCoverageSection.classList.toggle('hidden', !printingSelected);
                setSectionDisabled(printCoverageSection, !printingSelected);
              }

              if (laminationMaterialSection) {
                laminationMaterialSection.classList.toggle('hidden', !laminationSelected);
                setSectionDisabled(laminationMaterialSection, !laminationSelected);
              }

              printingOnlySections.forEach((section) => {
                section.classList.toggle('hidden', !printingSelected);
              });

              if (excludePresentations) {
                if (physicalToggle) physicalToggle.checked = false;
                if (digitalToggle) digitalToggle.checked = false;
              }

              refreshPhysicalPanel();
              refreshCustomServiceImageVisibility();
