            const renumberPrintPages = () => {
              if (!printPagesContainer) return;
              printPagesContainer.querySelectorAll('[data-print-page-row]').forEach((row, index) => {
                const label = row.querySelector('[data-print-page-label]');
                if (label) label.textContent = `Pagina ${index + 1}`;
                row.dataset.pageNumber = String(index + 1);
              });
            };

            const syncPrintPagesHidden = () => {
              if (!printPagesContainer || !printPagesHidden) return;

              const rows = Array.from(printPagesContainer.querySelectorAll('[data-print-page-row]')).map((row, index) => {
                const printTypeInput = row.querySelector('[data-print-page-type]');
                const materialInput = row.querySelector('[data-print-page-material]');
                const coverageInput = row.querySelector('[data-print-page-coverage]');
                const laminationEnabledInput = row.querySelector('[data-print-page-lamination-enabled]');
                const laminationServiceInput = row.querySelector('[data-print-page-lamination-service]');
                const coverage = parsePrintCoverageValue(coverageInput);
                const printTypeServiceId = Number.parseInt(String(printTypeInput?.value || '').trim(), 10);
                const materialSurchargeId = Number.parseInt(String(materialInput?.value || '').trim(), 10);
                const laminationEnabled = Boolean(laminationEnabledInput?.checked);
                const laminationServiceId = Number.parseInt(String(laminationServiceInput?.value || '').trim(), 10);

                return {
                  page_number: index + 1,
                  print_type_service_id: Number.isInteger(printTypeServiceId) && printTypeServiceId > 0 ? printTypeServiceId : null,
                  material_surcharge_id: Number.isInteger(materialSurchargeId) && materialSurchargeId > 0 ? materialSurchargeId : null,
                  coverage_percent: Number.isFinite(coverage) && coverage > 0 ? Number(coverage.toFixed(2)) : 0,
                  includes_lamination: laminationEnabled,
                  lamination_service_id: laminationEnabled && Number.isInteger(laminationServiceId) && laminationServiceId > 0 ? laminationServiceId : null
                };
              }).filter((row) => row.coverage_percent > 0 && row.print_type_service_id && row.material_surcharge_id);

              printPagesHidden.value = JSON.stringify(rows);
            };

            const refreshPageLaminationVisibility = (row) => {
              if (!row) return;

              const toggle = row.querySelector('[data-print-page-lamination-enabled]');
              const wrapper = row.querySelector('[data-print-page-lamination-wrapper]');
              const select = row.querySelector('[data-print-page-lamination-service]');
              const enabled = Boolean(toggle?.checked);

              if (wrapper) wrapper.classList.toggle('hidden', !enabled);
              if (select) {
                select.disabled = !enabled;
                if (!enabled) select.value = '';
              }
            };

            const printTypePayloadById = (serviceId) => {
              const selectedId = String(serviceId || '').trim();
              if (!selectedId) return null;

              return printTypesPayload.find((row) => String(row.id) === selectedId) || null;
            };

            const setPageRowMaterialOptions = (row, printTypeServiceId, { keepCurrent = true } = {}) => {
              if (!row) return;

              const materialSelect = row.querySelector('[data-print-page-material]');
              if (!materialSelect) return;

              const currentValue = String(materialSelect.value || '').trim();
              const typePayload = printTypePayloadById(printTypeServiceId);
              const materialOptions = Array.isArray(typePayload?.material_options) ? typePayload.material_options : [];

              const optionRows = ['<option value="">Selecciona material</option>']
                .concat(materialOptions.map((material) => {
                  const optionValue = String(material?.id || '').trim();
                  const optionLabel = String(material?.label || '').trim();
                  return `<option value="${optionValue}">${optionLabel}</option>`;
                }));

              materialSelect.innerHTML = optionRows.join('');

              if (keepCurrent && materialOptions.some((material) => String(material?.id || '').trim() === currentValue)) {
                materialSelect.value = currentValue;
                return;
              }

              materialSelect.value = '';
            };

            const resolvePriceForCoverage = (coverage, prices) => {
              const normalizedCoverage = Number(coverage || 0);
              if (!(normalizedCoverage > 0)) return 0;

              const sorted = Array.isArray(prices)
                ? prices
                    .map((row) => ({
                      coverage_percent: Number(row.coverage_percent || 0),
                      price_bs: Number(row.price_bs || 0)
                    }))
                    .filter((row) => row.coverage_percent > 0 && row.price_bs >= 0)
                    .sort((a, b) => a.coverage_percent - b.coverage_percent)
                : [];

              if (sorted.length === 0) return 0;
              const match = sorted.find((row) => row.coverage_percent >= normalizedCoverage) || sorted[sorted.length - 1];
              return Number(match.price_bs || 0);
            };

            const recalculatePrintCost = () => {
              let totalBs = 0;
              if (printPagesContainer) {
                printPagesContainer.querySelectorAll('[data-print-page-row]').forEach((row) => {
                  const typeInput = row.querySelector('[data-print-page-type]');
                  const coverageInput = row.querySelector('[data-print-page-coverage]');
                  const pageCostInput = row.querySelector('[data-print-page-cost-bs]');
                  const selectedType = printTypePayloadById(typeInput?.value || '');
                  const prices = selectedType?.coverage_prices || [];
                  const coverage = parsePrintCoverageValue(coverageInput);
                  if (!(Number.isFinite(coverage) && coverage > 0) || prices.length === 0) {
                    if (pageCostInput) pageCostInput.value = 'Bs 0,00';
                    return;
                  }

                  const pageCostBs = resolvePriceForCoverage(coverage, prices);
                  totalBs += pageCostBs;

                  if (pageCostInput) {
                    pageCostInput.value = window.MoneyInputMask?.formatMoney
                      ? window.MoneyInputMask.formatMoney(pageCostBs, 'Bs')
                      : `Bs ${Number(pageCostBs || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                  }
                });
              }

              if (printCostBsElement) {
                printCostBsElement.textContent = formatMoneyValue(totalBs, 'Bs') || 'Bs 0,00';
              }
            };

            const parsePhysicalExtraQuantity = (input) => {
              const rawValue = String(input?.value || '').trim().replace(',', '.');
              const parsed = Number.parseFloat(rawValue);
              if (!Number.isFinite(parsed) || parsed <= 0) return 0;

              return Number(parsed.toFixed(2));
            };

            const syncPhysicalExtraProductsHidden = () => {
              if (!physicalExtraProductsContainer || !physicalExtraProductsHidden) return;

              const duplicateErrorMessage = 'No puedes repetir el mismo producto con la misma variacion.';
              const seenRowByPair = new Map();
              physicalExtraProductsContainer
                .querySelectorAll('[data-physical-extra-variation]')
                .forEach((variationSelect) => {
                  variationSelect.setCustomValidity('');
                });

              const rows = Array.from(physicalExtraProductsContainer.querySelectorAll('[data-physical-extra-product-row]'))
                .map((row) => {
                  const productSelect = row.querySelector('[data-product-select]');
                  const variationSelect = row.querySelector('[data-physical-extra-variation]');
                  const quantityInput = row.querySelector('[data-physical-extra-quantity]');
                  const breakdownInput = row.querySelector('[data-physical-extra-breakdown]');
                  const productId = Number.parseInt(String(productSelect?.value || '').trim(), 10);
                  const variationId = Number.parseInt(String(variationSelect?.value || '').trim(), 10);
                  const quantity = parsePhysicalExtraQuantity(quantityInput);
                  if (!(Number.isInteger(productId) && productId > 0 && Number.isInteger(variationId) && variationId > 0 && quantity > 0)) return null;

                  const pairKey = `${productId}:${variationId}`;
                  const firstMatch = seenRowByPair.get(pairKey);
                  if (firstMatch) {
                    variationSelect?.setCustomValidity(duplicateErrorMessage);
                    firstMatch?.setCustomValidity(duplicateErrorMessage);
                  } else {
                    seenRowByPair.set(pairKey, variationSelect);
                  }

                  return {
                    product_id: productId,
                    variation_id: variationId,
                    quantity,
                    breakdown_in_invoice: Boolean(breakdownInput?.checked),
                  };
                })
                .filter(Boolean);

              physicalExtraProductsHidden.value = JSON.stringify(rows);
            };

            const addPhysicalExtraProductRow = () => {
              if (!physicalExtraProductsContainer) return;

              const row = document.createElement('div');
              row.className = 'relative rounded-xl border border-slate-200 bg-white p-3 pr-12';
              row.setAttribute('data-physical-extra-product-row', '');
              row.setAttribute('data-nested-row', '');
              row.innerHTML = `
                <select class="hidden" data-product-select>
                  ${physicalExtraProductOptionsHtml}
                </select>
                <div class="grid gap-3 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_120px_220px] md:items-start">
                  <div>
                    <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Producto</label>
                    <div class="relative mt-1">
                      <input type="search"
                             class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500"
                             placeholder="Buscar producto"
                             autocomplete="off"
                             data-product-search>
                      <div class="absolute z-30 mt-2 hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg" data-product-results></div>
                    </div>
                    <p class="mt-2 text-xs text-slate-500" data-product-selected-label>Sin producto seleccionado</p>
                  </div>
                  <div>
                    <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Variacion</label>
                    <select class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500"
                            data-physical-extra-variation
                            disabled>
                      <option value="">Selecciona variacion</option>
                    </select>
                    <p class="mt-1 text-xs text-slate-500">Se descuenta stock de la variacion elegida.</p>
                  </div>
                  <div>
                    <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Cantidad</label>
                    <input type="number"
                           min="0.01"
                           step="0.01"
                           value="1"
                           class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500"
                           data-physical-extra-quantity>
                    <p class="mt-1 text-xs text-slate-500">Por unidad del servicio.</p>
                  </div>
                  <div>
                    <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Factura</label>
                    <label class="mt-1 inline-flex cursor-pointer items-center gap-2 rounded-lg border border-cyan-200 bg-cyan-50 px-3 py-2 text-xs font-semibold text-cyan-700">
                      <input type="checkbox"
                             class="h-4 w-4 cursor-pointer rounded border-cyan-300 text-cyan-600 focus:ring-cyan-500"
                             data-physical-extra-breakdown>
                      Desglosar en factura
                    </label>
                  </div>
                </div>
                <button type="button"
                        class="absolute right-3 top-3 inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100"
                        data-remove-physical-extra-product-row>
                  <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                </button>
              `;

              physicalExtraProductsContainer.appendChild(row);
              syncPhysicalExtraVariationOptions(row, { keepCurrent: false });
              if (window.lucide?.createIcons) window.lucide.createIcons({ attrs: { 'stroke-width': 2 } });
              syncPhysicalExtraProductsHidden();
