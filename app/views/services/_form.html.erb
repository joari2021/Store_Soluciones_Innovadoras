            printCoverageContainer?.addEventListener('click', (event) => {
              const removeButton = event.target.closest('[data-remove-print-coverage-row]');
              if (!removeButton) return;

              const row = removeButton.closest('[data-print-coverage-row]');
              if (!row) return;

              const destroyInput = row.querySelector('input[data-destroy-input="true"]');
              const idInput = row.querySelector('input[type="hidden"][name$="[id]"]');
              const persisted = idInput && String(idInput.value || '').trim().length > 0;

              if (persisted && destroyInput) {
                destroyInput.value = '1';
                row.style.display = 'none';
              } else {
                row.remove();
              }

              ensureAtLeastOneCoverageRow();
            });

            printMaterialSurchargeContainer?.addEventListener('click', (event) => {
              const removeButton = event.target.closest('[data-remove-print-material-surcharge-row]');
              if (!removeButton) return;

              const row = removeButton.closest('[data-print-material-surcharge-row]');
              if (!row) return;

              const destroyInput = row.querySelector('input[data-destroy-input="true"]');
              const idInput = row.querySelector('input[type="hidden"][name$="[id]"]');
              const persisted = idInput && String(idInput.value || '').trim().length > 0;

              if (persisted && destroyInput) {
                destroyInput.value = '1';
                row.style.display = 'none';
              } else {
                row.remove();
              }
            });

            laminationMaterialContainer?.addEventListener('click', (event) => {
              const removeButton = event.target.closest('[data-remove-lamination-material-row]');
              if (!removeButton) return;

              const row = removeButton.closest('[data-lamination-material-row]');
              if (!row) return;

              const destroyInput = row.querySelector('input[data-destroy-input="true"]');
              const idInput = row.querySelector('input[type="hidden"][name$="[id]"]');
              const persisted = idInput && String(idInput.value || '').trim().length > 0;

              if (persisted && destroyInput) {
                destroyInput.value = '1';
                row.style.display = 'none';
              } else {
                row.remove();
              }
            });

            addPrintPageButton?.addEventListener('click', () => {
              addPrintPage();
            });

            addPhysicalExtraProductButton?.addEventListener('click', () => {
              addPhysicalExtraProductRow();
            });

            printPagesContainer?.addEventListener('click', (event) => {
              const removeButton = event.target.closest('[data-remove-print-page]');
              if (!removeButton) return;

              const row = removeButton.closest('[data-print-page-row]');
              if (!row) return;

              const rows = printPagesContainer.querySelectorAll('[data-print-page-row]');
              if (rows.length <= 1) return;

              row.remove();
              renumberPrintPages();
              syncPrintPagesHidden();
              recalculatePrintCost();
            });

            printPagesContainer?.addEventListener('input', (event) => {
              if (!event.target.matches('[data-print-page-coverage]')) return;
              syncPrintPagesHidden();
              recalculatePrintCost();
            });

            printPagesContainer?.addEventListener('change', (event) => {
              const target = event.target;

              if (target.matches('[data-print-page-type]')) {
                const row = target.closest('[data-print-page-row]');
                setPageRowMaterialOptions(row, target.value, { keepCurrent: false });
                syncPrintPagesHidden();
                recalculatePrintCost();
                return;
              }

              if (target.matches('[data-print-page-material]')) {
                syncPrintPagesHidden();
                recalculatePrintCost();
                return;
              }

              if (target.matches('[data-print-page-lamination-enabled]')) {
                const row = target.closest('[data-print-page-row]');
                refreshPageLaminationVisibility(row);
                syncPrintPagesHidden();
                return;
              }

              if (target.matches('[data-print-page-lamination-service]')) {
                syncPrintPagesHidden();
              }
            });

            physicalExtraProductsContainer?.addEventListener('click', (event) => {
              const removeButton = event.target.closest('[data-remove-physical-extra-product-row]');
              if (!removeButton) return;

              const row = removeButton.closest('[data-physical-extra-product-row]');
              if (!row) return;

              row.remove();
              syncPhysicalExtraProductsHidden();
            });

            physicalExtraProductsContainer?.addEventListener('input', (event) => {
              if (!event.target.matches('[data-physical-extra-quantity], [data-product-search]')) return;
              syncPhysicalExtraProductsHidden();
            });

            physicalExtraProductsContainer?.addEventListener('change', (event) => {
              if (!event.target.matches('[data-product-select], [data-physical-extra-breakdown], [data-physical-extra-quantity], [data-physical-extra-variation]')) return;

              if (event.target.matches('[data-product-select]')) {
                const row = event.target.closest('[data-physical-extra-product-row]');
                syncPhysicalExtraVariationOptions(row, { keepCurrent: false });
              }

              syncPhysicalExtraProductsHidden();
            });

            physicalToggle?.addEventListener('change', () => {
              refreshPhysicalPanel();
            });

            customServiceImageToggle?.addEventListener('change', () => {
              refreshCustomServiceImageVisibility();
            });

            systemServiceSelect?.addEventListener('change', () => {
              refreshStatusVisibility();
              refreshPrintCoverageVisibility();
              refreshCustomServiceImageVisibility();
              applyRcvSharedTemplate({ force: true });
            });

            window.MoneyInputMask?.init(form);
            refreshStatusVisibility();
            refreshPrintCoverageVisibility();
            refreshCustomServiceImageVisibility();
            applyRcvSharedTemplate();
            refreshPhysicalPanel();
            if (printPagesContainer) {
              printPagesContainer.querySelectorAll('[data-print-page-row]').forEach((row) => {
                const rowTypeSelect = row.querySelector('[data-print-page-type]');
                setPageRowMaterialOptions(row, rowTypeSelect?.value || '', { keepCurrent: true });
                refreshPageLaminationVisibility(row);
              });
            }
            if (physicalExtraProductsContainer) {
              physicalExtraProductsContainer.querySelectorAll('[data-physical-extra-product-row]').forEach((row) => {
                syncPhysicalExtraVariationOptions(row, { keepCurrent: true });
              });
            }
            syncPrintPagesHidden();
            recalculatePrintCost();
            syncPhysicalExtraProductsHidden();
          };

          document.addEventListener("input", handleInput);
          document.addEventListener("DOMContentLoaded", handleLoad);
          document.addEventListener("turbo:load", handleLoad);
        })();
      </script>
