<%= form_with(model: @service, local: true, data: { controller: "form-services", bcv_rate: @service_expenses_bcv_rate, new_record: form.object.new_record? }, id: "form-services", class: "space-y-6") do |form| %>
  <% if @service.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-bold">No se pudo guardar el servicio</h4>
        <span class="text-xs font-medium"><%= pluralize(@service.errors.count, 'error') %></span>
      </div>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% @service.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Estatus del servicio</p>
      <p class="mt-1 text-sm text-slate-500">Configura disponibilidad y visibilidad segun el nivel de acceso.</p>
    </div>
    <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
      <label class="inline-flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <%= form.check_box :available, class: "mt-0.5 h-4 w-4 cursor-pointer rounded border-slate-300 text-emerald-600 focus:ring-emerald-500", id: "service-available" %>
        <span>
          <span class="block font-semibold">Servicio disponible</span>
          <span class="mt-0.5 block text-xs text-slate-500">Si esta desactivado, solo el administrador podra ver detalles.</span>
        </span>
      </label>
      <label class="inline-flex cursor-pointer items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800" data-status-extra-card="true">
        <%= form.check_box :caution_service,
                           class: "mt-0.5 h-4 w-4 cursor-pointer rounded border-amber-300 text-amber-600 focus:ring-amber-500",
                           id: "service-caution-service",
                           data: { caution_flag: true } %>
        <span>
          <span class="block font-semibold">Servicio con precaucion</span>
          <span class="mt-0.5 block text-xs text-amber-700">El personal estandar y encargado pueden verlo, pero al abrir detalles veran una advertencia.</span>
        </span>
      </label>
      <label class="inline-flex cursor-pointer items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800" data-status-extra-card="true">
        <%= form.check_box :restricted_service,
                           class: "mt-0.5 h-4 w-4 cursor-pointer rounded border-rose-300 text-rose-600 focus:ring-rose-500",
                           id: "service-restricted-service",
                           data: { restricted_flag: true } %>
        <span>
          <span class="block font-semibold">Servicio restringido</span>
          <span class="mt-0.5 block text-xs text-rose-700">Solo el administrador puede verlo y acceder a su detalle.</span>
        </span>
      </label>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Datos generales</p>
    <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <div>
        <%= form.label :system_service_id, "Sistema", class: "block text-sm font-medium text-slate-700" %>
        <%= form.collection_select :system_service_id, SystemService.order(:name), :id, :name, { include_blank: "Selecciona un sistema" }, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
      <div>
        <%= form.label :description, "Descripcion", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :description, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
      <div>
        <%= form.label :pricing_mode, "Tipo de precio", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :pricing_mode,
                        options_for_select([["Precio fijo", "fixed"], ["Precio a convenir", "to_agree"]], form.object.pricing_mode.presence || "fixed"),
                        {},
                        class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                        data: { pricing_mode_select: true } %>
      </div>
    </div>
    <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50/70 p-4" data-custom-service-image-section>
      <label class="inline-flex cursor-pointer items-start gap-3 text-sm text-slate-700">
        <%= form.check_box :use_custom_image_for_display,
                           class: "mt-0.5 h-4 w-4 cursor-pointer rounded border-slate-300 text-cyan-600 focus:ring-cyan-500",
                           data: { custom_service_image_toggle: true } %>
        <span>
          <span class="block font-semibold">Usar imagen especifica para este servicio</span>
          <span class="mt-0.5 block text-xs text-slate-500">Si esta desactivado, se mostrara la imagen del system service asociado.</span>
        </span>
      </label>
      <div class="mt-3 <%= form.object.use_custom_image_for_display? ? '' : 'hidden' %>" data-custom-service-image-panel>
        <%= form.label :custom_display_image, "Imagen del servicio", class: "block text-sm font-medium text-slate-700" %>
        <%= form.file_field :custom_display_image,
                            accept: 'image/*',
                            class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                            data: { custom_service_image_input: true } %>
        <% if form.object.custom_display_image&.attached? %>
          <p class="mt-2 text-xs text-slate-500">Imagen actual configurada para este servicio.</p>
          <%= image_tag form.object.custom_display_image, class: "mt-2 h-24 w-24 rounded-xl border border-slate-200 object-cover", alt: form.object.description.to_s %>
        <% end %>
      </div>
      <p class="mt-2 hidden text-xs font-semibold text-amber-700" data-custom-service-image-recarga-note>
        Para servicios de recarga se utiliza la imagen configurada en Parametros de recargas.
      </p>
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <% fixed_reference = form.object.currency_base_price.to_s.strip.presence || "Dolar BCV" %>
      <% fixed_reference = "Dolar BCV" if fixed_reference == "$" %>
      <% fixed_symbol = currency_symbol_for_reference(fixed_reference, rows: @service_price_currency_rows, fallback: "$") %>
      <% fixed_plain_input = (fixed_reference == "Unidad VI") %>
      <% fixed_sale_price_value = if form.object.sale_price.present?
                                    fixed_plain_input ? plain_decimal_input_value(form.object.sale_price) : format_money(form.object.sale_price, unit: fixed_symbol)
                                  else
                                    ""
                                  end %>
      <div id="service-currency-base-field">
        <%= form.label :currency_base_price, "Moneda base de calculo", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :currency_base_price,
                        currency_reference_options_for_select(rows: @service_price_currency_rows, selected: fixed_reference),
                        { include_blank: "Selecciona una opcion" },
                        class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                        data: { fixed_currency_select: true } %>
        <p class="mt-1 text-xs text-slate-500" data-fixed-currency-help>
          <%= form.object.fixed? ? "Define la moneda de referencia del precio fijo." : "Esta moneda se usara para pedir el precio a convenir en ventas." %>
        </p>
      </div>
      <div id="service-sale-price-field" class="<%= form.object.fixed? ? '' : 'hidden' %>">
        <label class="block text-sm font-medium text-slate-700" data-fixed-amount-label>Monto (<%= fixed_reference %>)</label>
        <%= form.text_field :sale_price,
                            value: fixed_sale_price_value,
                            type: (fixed_plain_input ? "number" : "text"),
                            step: (fixed_plain_input ? "0.01" : nil),
                            min: (fixed_plain_input ? "0.01" : nil),
                            inputmode: (fixed_plain_input ? "decimal" : nil),
                            autocomplete: "off",
                            class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500",
                            data: {
                              money_mask: !fixed_plain_input,
                              money_symbol: fixed_symbol,
                              fixed_sale_price: true,
                              plain_decimal: fixed_plain_input,
                              disable_number_steppers: fixed_plain_input
                            } %>
      </div>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" data-requirements-section>
    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Requisitos y datos</p>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div>
        <%= form.label :physical_requirements, "Requisitos fisicos", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :physical_requirements, rows: 3, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
      <div>
        <%= form.label :digital_requirements, "Requisitos digitales (fotos o escaneos)", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :digital_requirements, rows: 3, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
      <div>
        <%= form.label :required_data, "Datos requeridos", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :required_data, rows: 3, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
      <div>
        <%= form.label :personal_steps, "Pasos a seguir (solo personal autorizado)", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :personal_steps, rows: 3, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
      <div>
        <%= form.label :note, "Nota", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :note, rows: 3, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Entrega</p>
    <div class="mt-4 grid gap-4 md:grid-cols-2" data-delivery-metadata-section>
      <div>
        <%= form.label :delivery_content, "Contenido de entrega", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :delivery_content, rows: 3, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
      <div>
        <%= form.label :delivery_time, "Tiempo de entrega", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :delivery_time, class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
    </div>
  </div>
  <% current_print_pages = @service.respond_to?(:normalized_print_delivery_pages) ? @service.normalized_print_delivery_pages : [] %>
  <% current_print_pages = [{ 'page_number' => 1, 'coverage_percent' => 1.0 }] if current_print_pages.blank? %>
  <% supports_print_delivery_extra_products = @service.class.column_names.include?('print_delivery_extra_products') %>
  <% current_delivery_extra_products = supports_print_delivery_extra_products && @service.respond_to?(:normalized_print_delivery_extra_products) ? @service.normalized_print_delivery_extra_products : [] %>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" data-delivery-section>
    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Presentaciones</p>
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      <label class="inline-flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <%= form.check_box :delivery_physical_enabled,
                           class: "mt-0.5 h-4 w-4 cursor-pointer rounded border-slate-300 text-cyan-600 focus:ring-cyan-500",
                           data: { delivery_physical_toggle: true } %>
        <span>
          <span class="block font-semibold">Presentacion fisica</span>
          <span class="mt-0.5 block text-xs text-slate-500">Permite configurar tipo de impresion, paginas y cobertura de color.</span>
        </span>
      </label>
      <label class="inline-flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <%= form.check_box :delivery_digital_enabled,
                           class: "mt-0.5 h-4 w-4 cursor-pointer rounded border-slate-300 text-sky-600 focus:ring-sky-500",
                           data: { delivery_digital_toggle: true } %>
        <span>
          <span class="block font-semibold">Presentacion digital</span>
          <span class="mt-0.5 block text-xs text-slate-500">Disponible para entrega por medios digitales.</span>
        </span>
      </label>
    </div>
    <div class="mt-3 rounded-xl border border-amber-200 bg-amber-50/60 px-4 py-3">
      <label class="inline-flex cursor-pointer items-start gap-3 text-sm text-amber-800">
        <%= form.check_box :warn_digital_only_delivery_in_sales,
                           class: "mt-0.5 h-4 w-4 cursor-pointer rounded border-amber-300 text-amber-600 focus:ring-amber-500" %>
        <span>
          <span class="block font-semibold">Mostrar advertencia en ventas (solo entrega digital)</span>
          <span class="mt-0.5 block text-xs text-amber-700">Si esta activa y el servicio solo permite entrega digital, se mostrara un aviso al agregarlo al panel de cobro.</span>
        </span>
      </label>
    </div>
    <div class="mt-4 rounded-2xl border border-cyan-200 bg-cyan-50/70 p-4" data-delivery-physical-panel>
      <div class="flex justify-end">
        <div class="w-full md:max-w-xs">
          <p class="text-sm font-medium text-slate-700">Costo de la impresion (Bs)</p>
          <div class="mt-1 rounded-xl border border-slate-200 bg-slate-100 px-3 py-2">
            <p class="text-sm font-semibold text-slate-700" data-print-cost-bs>
              <%= format_money(@service.resolved_printing_cost_bs, unit: 'Bs') rescue 'Bs 0,00' %>
            </p>
          </div>
        </div>
      </div>
      <div class="mt-4">
        <div class="mb-2 flex justify-end">
          <button type="button"
                  class="inline-flex items-center gap-2 rounded-xl bg-cyan-100 px-3 py-2 text-xs font-semibold text-cyan-700 hover:bg-cyan-200"
                  data-add-print-page>
            Agregar pagina
          </button>
        </div>
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Paginas y cobertura de color</p>
        </div>
        <div class="mt-3 space-y-2" data-print-pages-container>
          <% current_print_pages.each_with_index do |page_row, index| %>
            <% page_number = page_row['page_number'].to_i.positive? ? page_row['page_number'].to_i : (index + 1) %>
            <% coverage_percent = page_row['coverage_percent'].to_d.round(2) %>
            <% selected_type_id = page_row['print_type_service_id'].to_i.positive? ? page_row['print_type_service_id'].to_i : @service.print_delivery_service_id %>
            <% type_service = @print_type_services.find { |svc| svc.id == selected_type_id } %>
            <% selected_material_id = page_row['material_surcharge_id'].to_i.positive? ? page_row['material_surcharge_id'].to_i : @service.print_delivery_material_surcharge_id %>
            <% includes_lamination = ActiveModel::Type::Boolean.new.cast(page_row['includes_lamination']) %>
            <% selected_lamination_service_id = page_row['lamination_service_id'].to_i.positive? ? page_row['lamination_service_id'].to_i : nil %>
            <% material_options_for_page = if type_service.present?
                                             type_service.service_print_material_surcharges
                                                         .sort_by { |row| [row.created_at || Time.at(0), row.id.to_i] }
                                                         .map { |row| [row.display_label.to_s, row.id] }
                                           else
                                             []
                                           end %>
            <div class="grid gap-3 rounded-xl border border-cyan-200 bg-white px-3 py-3 md:grid-cols-[auto_minmax(0,1.1fr)_minmax(0,1fr)_minmax(0,0.8fr)_minmax(0,0.7fr)_minmax(0,1fr)_auto] md:items-end" data-print-page-row>
              <div class="self-center text-xs font-semibold text-slate-600" data-print-page-label>Pagina <%= page_number %></div>
              <div>
                <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Tipo de impresion</label>
                <select class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"
                        data-print-page-type>
                  <option value="">Selecciona tipo</option>
                  <% @print_type_services.reject { |svc| svc.id == @service.id }.each do |svc| %>
                    <option value="<%= svc.id %>" <%= 'selected' if svc.id == selected_type_id %>><%= svc.description %></option>
                    <% end %>
                  </select>
                </div>
                <div>
                  <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Material</label>
                  <select class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"
                        data-print-page-material>
                    <option value="">Selecciona material</option>
                    <% material_options_for_page.each do |label, id| %>
                      <option value="<%= id %>" <%= 'selected' if id == selected_material_id %>><%= label %></option>
                      <% end %>
                    </select>
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Cobertura (%)</label>
                    <input type="text"
                       inputmode="decimal"
                       class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"
                       data-print-page-coverage
                       data-money-mask="true"
                       data-money-symbol="%"
                       value="<%= format_money(coverage_percent, unit: '%') %>">
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Costo pagina (Bs)</label>
                    <input type="text"
                       readonly
                       class="mt-1 block w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-700"
                       data-print-page-cost-bs
                       value="Bs 0,00">
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wide text-slate-500">Plastificacion</label>
                    <label class="mt-1 inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700">
                      <input type="checkbox"
                         class="h-4 w-4 cursor-pointer rounded border-slate-300 text-cyan-600 focus:ring-cyan-500"
                             data-print-page-lamination-enabled
                             <%= 'checked' if includes_lamination %>>
                      Incluye servicio
                    </label>
                    <div class="mt-2 <%= includes_lamination ? '' : 'hidden' %>" data-print-page-lamination-wrapper>
                      <select class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"
                              data-print-page-lamination-service>
                        <option value="">Selecciona servicio</option>
                        <% @lamination_services.each do |lamination_service| %>
                          <option value="<%= lamination_service.id %>" <%= 'selected' if lamination_service.id == selected_lamination_service_id %>><%= lamination_service.description %></option>
                          <% end %>
                        </select>
                      </div>
                    </div>
                    <button type="button"
                      class="self-center justify-self-end inline-flex h-8 w-8 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100"
                      data-remove-print-page
                      title="Quitar pagina"
                      aria-label="Quitar pagina">
                      <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                    </button>
                  </div>
                <% end %>
              </div>
            </div>
            <%= form.hidden_field :print_delivery_pages,
                            value: current_print_pages.to_json,
                            data: { print_pages_hidden: true } %>
            <p class="mt-3 text-xs text-slate-500" data-print-pages-hint>Se tomara el precio por cobertura igual o mayor mas cercano para cada pagina.</p>
            <% if supports_print_delivery_extra_products %>
              <div class="mt-5 rounded-2xl border border-cyan-200 bg-white/90 p-4" data-physical-extra-products-section>
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-cyan-700">Productos adicionales por entrega fisica</p>
                    <p class="mt-1 text-sm text-slate-600">Se incluyen por cada unidad del servicio con presentacion fisica. No dependen de cada pagina de impresion.</p>
                  </div>
                  <button type="button"
                          class="inline-flex items-center gap-2 rounded-xl bg-cyan-100 px-3 py-2 text-xs font-semibold text-cyan-700 hover:bg-cyan-200"
                          data-add-physical-extra-product-row>
                    Agregar producto
                  </button>
                </div>
                <div class="mt-3 space-y-2" data-physical-extra-products-container>
                  <% current_delivery_extra_products.each do |row| %>
                    <% selected_product_id = row['product_id'].to_i %>
                    <% selected_variation_id = row['variation_id'].to_i.positive? ? row['variation_id'].to_i : nil %>
                    <% selected_quantity = row['quantity'].to_d.positive? ? row['quantity'].to_d : 1.to_d %>
                    <% selected_breakdown = ActiveModel::Type::Boolean.new.cast(row['breakdown_in_invoice']) %>
                    <% selected_product = @products_for_expenses.find { |product| product.id == selected_product_id } %>
                    <% selected_product_name = selected_product&.descripcion.to_s.strip %>
                    <div class="relative rounded-xl border border-slate-200 bg-white p-3 pr-12" data-physical-extra-product-row data-nested-row>
                      <select class="hidden" data-product-select>
                        <option value="">Selecciona producto</option>
                        <%= raw products_options_for_select(
                          products: @products_for_expenses,
                          bcv_rate: @service_expenses_bcv_rate,
