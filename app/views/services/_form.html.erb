            const ensureAtLeastOneCoverageRow = () => {
              if (!printCoverageContainer || !printCoverageTemplate) return;
              const rows = printCoverageContainer.querySelectorAll('[data-print-coverage-row]');
              if (rows.length > 0) return;

              const placeholder = printCoverageTemplate.dataset.placeholder;
              const token = `${Date.now()}${Math.floor(Math.random() * 1000)}`;
              const html = (printCoverageTemplate.innerHTML || '').split(placeholder).join(token);
              printCoverageContainer.insertAdjacentHTML('beforeend', html);
              window.MoneyInputMask?.init(printCoverageContainer);
            };

            const addPrintMaterialSurchargeRow = () => {
              if (!printMaterialSurchargeContainer || !printMaterialSurchargeTemplate) return;

              const placeholder = printMaterialSurchargeTemplate.dataset.placeholder;
              const token = `${Date.now()}${Math.floor(Math.random() * 1000)}`;
              const html = (printMaterialSurchargeTemplate.innerHTML || '').split(placeholder).join(token);
              printMaterialSurchargeContainer.insertAdjacentHTML('beforeend', html);
              window.MoneyInputMask?.init(printMaterialSurchargeContainer);
            };

            const addLaminationMaterialRow = () => {
              if (!laminationMaterialContainer || !laminationMaterialTemplate) return;

              const placeholder = laminationMaterialTemplate.dataset.placeholder;
              const token = `${Date.now()}${Math.floor(Math.random() * 1000)}`;
              const html = (laminationMaterialTemplate.innerHTML || '').split(placeholder).join(token);
              laminationMaterialContainer.insertAdjacentHTML('beforeend', html);
              window.MoneyInputMask?.init(laminationMaterialContainer);
