            const refreshPhysicalPanel = () => {
              if (!physicalToggle || !physicalPanel) return;

              const enabled = Boolean(physicalToggle.checked) && !isPrintingSystemServiceSelected();
              physicalPanel.classList.toggle('hidden', !enabled);

              physicalPanel.querySelectorAll('select, input, button').forEach((field) => {
                if (field === physicalToggle) return;
                field.disabled = !enabled;
              });

              if (enabled) {
                renumberPrintPages();
                syncPrintPagesHidden();
                recalculatePrintCost();
                syncPhysicalExtraProductsHidden();
              }
            };

            const addPrintPage = () => {
              if (!printPagesContainer) return;

              const firstRow = printPagesContainer.querySelector('[data-print-page-row]');
              const defaultTypeId = String(firstRow?.querySelector('[data-print-page-type]')?.value || '').trim();
              const defaultMaterialId = String(firstRow?.querySelector('[data-print-page-material]')?.value || '').trim();

