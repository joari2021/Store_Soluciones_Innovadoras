<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-sky-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Editar hora del movimiento</h1>
        <p class="mt-1 text-sm text-slate-500">Solo se actualizara la hora para ayudarte a ordenar el historial.</p>
      </div>
      <%= link_to account_path(@account, movement_id: @movement.id),
                  class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 md:w-auto' do %>
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Volver al historial
      <% end %>
    </div>
  </div>

  <div class="mx-auto w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="grid gap-3 md:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Fecha actual</p>
        <p class="mt-1 text-sm font-semibold text-slate-800"><%= @movement_date.strftime('%d-%m-%Y') %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Movimiento</p>
        <p class="mt-1 text-sm font-semibold text-slate-800">#<%= @movement.id %> · <%= @movement.movement_kind_label %></p>
      </div>
    </div>

    <%= form_with url: update_movement_time_account_path(@account, movement_id: @movement.id), method: :patch, local: true, class: 'mt-5 space-y-4' do %>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Hora</label>
        <input type="time"
               name="movement_time"
               value="<%= @movement_time_value %>"
               step="60"
               class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"
               required>
        <p class="mt-1 text-xs text-slate-500">Se mantiene la misma fecha y solo cambia la hora.</p>
      </div>

      <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
        <%= link_to 'Cancelar', account_path(@account, movement_id: @movement.id),
                    class: 'rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
        <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Guardar hora</button>
      </div>
    <% end %>
  </div>
</div>
