<%= form_with model: account, local: true, html: { id: 'account-form' } do |f| %>
  <% if account.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-bold">No se pudo guardar la cuenta</h4>
        <span class="text-xs font-medium"><%= pluralize(account.errors.count, 'error') %></span>
      </div>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% account.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% type_icons_json = Account::ACCOUNT_TYPES.transform_values { |data| data[:icon] }.to_json %>
  <% type_labels_json = Account::ACCOUNT_TYPES.transform_values { |data| data[:label] }.to_json %>
  <% currency_icons_json = Account::CURRENCIES.transform_values { |data| data[:icon] }.to_json %>
  <% currency_labels_json = Account::CURRENCIES.transform_values { |data| data[:label] }.to_json %>
  <% currency_symbols_json = Account::CURRENCIES.transform_values { |data| data[:symbol] }.to_json %>
  <% theme_cards_json = Account::COLOR_THEMES.transform_values { |data| data[:card] }.to_json %>
  <% theme_tags_json = Account::COLOR_THEMES.transform_values { |data| data[:tag] }.to_json %>
  <div
    id="account-preview"
    data-type-icons="<%= ERB::Util.json_escape(type_icons_json) %>"
    data-type-labels="<%= ERB::Util.json_escape(type_labels_json) %>"
    data-currency-icons="<%= ERB::Util.json_escape(currency_icons_json) %>"
    data-currency-labels="<%= ERB::Util.json_escape(currency_labels_json) %>"
    data-currency-symbols="<%= ERB::Util.json_escape(currency_symbols_json) %>"
    data-theme-cards="<%= ERB::Util.json_escape(theme_cards_json) %>"
    data-theme-tags="<%= ERB::Util.json_escape(theme_tags_json) %>"
    class="mb-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
    <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Vista previa</p>
    <div id="account-preview-card" class="mt-3 rounded-xl border p-3 transition-colors <%= account.theme_config[:card] %>">
      <div class="flex flex-wrap items-center gap-2">
        <div id="account-preview-type-badge" class="inline-flex items-center gap-2 rounded-lg px-2.5 py-1 text-sm font-semibold <%= account.theme_config[:tag] %>">
          <i id="account-preview-type-icon" data-lucide="<%= account.account_type_icon %>" class="h-4 w-4"></i>
          <span id="account-preview-type-label"><%= account.account_type_label %></span>
        </div>
        <div id="account-preview-currency-badge" class="inline-flex items-center gap-2 rounded-lg px-2.5 py-1 text-sm font-semibold <%= account.theme_config[:tag] %>">
          <i id="account-preview-currency-icon" data-lucide="<%= account.currency_icon %>" class="h-4 w-4"></i>
          <span id="account-preview-currency-label"><%= account.currency_label %></span>
          <span id="account-preview-currency-symbol" class="rounded bg-white/70 px-2 py-0.5 text-xs font-bold"><%= account.currency_symbol %></span>
        </div>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div class="col-span-2 md:col-span-1">
      <%= f.label :name, 'Nombre de la cuenta', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_field :name, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: Caja Principal, Banco Mercantil, Wallet Binance' %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :account_type, 'Tipo de cuenta', class: 'block text-sm font-medium text-slate-700' %>
      <% if account.settlement_enabled? %>
        <div class="mt-1 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">
          <%= account.account_type_label %>
        </div>
        <%= f.hidden_field :account_type %>
      <% else %>
        <%= f.select :account_type,
                     options_for_select(Account.account_type_options, account.account_type),
                     {},
                     class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      <% end %>
    </div>
    <% cash_role_visible = account.account_type == 'cash_box' %>
    <div id="cash-role-field" class="col-span-2 md:col-span-1" style="<%= 'display: none;' unless cash_role_visible %>">
      <%= f.label :cash_role, 'Rol de caja', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.select :cash_role,
                   options_for_select(Account::CASH_ROLES.map { |key, label| [label, key] }, account.cash_role),
                   { include_blank: 'Selecciona un rol' },
                   class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      <p class="mt-1 text-xs text-slate-500">Solo aplica para cuentas tipo Caja.</p>
    </div>
    <% cashea_visible = account.account_type == 'cashea' %>
    <div id="cashea-config-field" class="col-span-2" style="<%= 'display: none;' unless cashea_visible %>">
      <div class="rounded-xl border border-amber-200 bg-amber-50/50 p-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-700">Configuracion Cashea</p>
        <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
          <div>
            <%= f.label :cashea_line_mode, 'Linea asignada', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.select :cashea_line_mode,
                         options_for_select(Account::CASHEA_LINE_MODES.map { |key, label| [label, key] }, account.cashea_line_mode),
                         {},
                         class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                         data: { cashea_line_mode: true } %>
          </div>
          <div>
            <%= f.label :cashea_cotidiana_installments, 'Cuotas (linea cotidiana)', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.number_field :cashea_cotidiana_installments,
                               min: 1,
                               max: 24,
                               step: 1,
                               class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                               data: { cashea_cotidiana_installments: true } %>
            <p class="mt-1 text-xs text-slate-500">Para linea principal se usa fijo inicial + 3 cuotas.</p>
          </div>
          <div>
            <%= f.label :cashea_min_purchase_usd, 'Compra minima USD', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.hidden_field :cashea_min_purchase_usd, data: { cashea_min_purchase_hidden: true } %>
            <input
              type="text"
              inputmode="decimal"
              autocomplete="off"
              data-money-mask="true"
              data-money-symbol="$"
              data-cashea-min-purchase-masked="true"
              value="<%= number_with_precision(account.cashea_min_purchase_usd.to_d, precision: 2, delimiter: '.', separator: ',') %>"
              placeholder="$ 0,00"
              class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500"
            />
            <p class="mt-1 text-xs text-slate-500">Monto minimo para habilitar linea cotidiana.</p>
          </div>
          <div data-cashea-principal-min-wrapper="true">
            <%= f.label :cashea_principal_min_purchase_usd, 'Compra minima linea principal (USD)', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.hidden_field :cashea_principal_min_purchase_usd, data: { cashea_principal_min_purchase_hidden: true } %>
            <input
              type="text"
              inputmode="decimal"
              autocomplete="off"
              data-money-mask="true"
              data-money-symbol="$"
              data-cashea-principal-min-purchase-masked="true"
              value="<%= number_with_precision(account.cashea_principal_min_purchase_usd.to_d, precision: 2, delimiter: '.', separator: ',') %>"
              placeholder="$ 0,00"
              class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500"
            />
            <p class="mt-1 text-xs text-slate-500">Monto minimo para habilitar linea principal.</p>
          </div>
          <div>
            <%= f.label :cashea_commission_percent, 'Comision sobre el total (%)', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.number_field :cashea_commission_percent,
                               min: 0,
                               max: 100,
                               step: 0.01,
                               class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                               placeholder: '0.00' %>
            <p class="mt-1 text-xs text-slate-500">Por defecto es 0%. Se aplica a la línea principal si la orden incluye productos de categorías asociadas a línea cotidiana.</p>
          </div>
          <div class="md:col-span-2">
            <p class="block text-sm font-medium text-slate-700">Porcentaje de inicial permitido por nivel</p>
            <p class="mt-1 text-xs text-slate-500">Estos valores quedan disponibles para consulta rápida desde el header.</p>
            <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3">
              <% 1.upto(6) do |level| %>
                <% attribute = "cashea_level_#{level}_initial_percent" %>
                <div>
                  <%= f.label attribute, "Nivel #{level}", class: 'block text-sm font-medium text-slate-700' %>
                  <div class="relative mt-1">
                    <%= f.hidden_field attribute, data: { cashea_level_hidden: true } %>
                    <input type="text"
                           inputmode="decimal"
                           autocomplete="off"
                           data-money-mask="true"
                           data-money-symbol="%"
                           data-money-decimals="2"
                           data-cashea-level-masked="true"
                           data-cashea-level-hidden-id="<%= "account_#{attribute}" %>"
                           value="<%= number_with_precision(account.public_send(attribute).to_d, precision: 2, delimiter: '.', separator: ',') %>"
                           placeholder="% 0,00"
                           class="block w-full rounded-md border border-slate-300 pr-8 shadow-sm focus:border-amber-500 focus:ring-amber-500" />
                  </div>
                </div>
              <% end %>
            </div>
          </div>
          <div class="md:col-span-2">
            <p class="block text-sm font-medium text-slate-700">Métodos de pago permitidos para cobrar inicial con Cashea</p>
            <p class="mt-1 text-xs text-slate-500">Desmarca los métodos que no deseas que aparezcan disponibles al cobrar el inicial de una venta con Cashea.</p>
            <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
              <label class="inline-flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/70 p-3 text-sm text-slate-700 hover:bg-slate-50 cursor-pointer">
                <%= f.check_box :cashea_allow_pos, class: 'h-4 w-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500' %>
                <div>
                  <span class="font-semibold block text-slate-800">Punto de venta (POS)</span>
                  <span class="text-xs text-slate-500">Permitir cobrar inicial por Punto de Venta</span>
                </div>
              </label>
              <label class="inline-flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/70 p-3 text-sm text-slate-700 hover:bg-slate-50 cursor-pointer">
                <%= f.check_box :cashea_allow_biopago, class: 'h-4 w-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500' %>
                <div>
                  <span class="font-semibold block text-slate-800">Biopago</span>
                  <span class="text-xs text-slate-500">Permitir cobrar inicial por Biopago</span>
                </div>
              </label>
            </div>
          </div>
          <div class="md:col-span-2" data-cashea-cotidiana-categories-wrapper="true">
            <p class="block text-sm font-medium text-slate-700">Categorias asociadas a linea cotidiana</p>
            <p class="mt-1 text-xs text-slate-500">Si un producto de estas categorias está en la compra y se usa línea principal, se aplicará el porcentaje de comisión configurado.</p>
            <div class="mt-2 max-h-44 overflow-auto rounded-lg border border-slate-200 bg-white p-2">
              <% selected_cotidiana_categories = account.cashea_cotidiana_only_category_ids %>
              <% if @cashea_categories.present? %>
                <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
                  <% @cashea_categories.each do |categoria| %>
                    <label class="inline-flex items-center gap-2 rounded-md border border-slate-200 px-2 py-1 text-sm text-slate-700">
                      <%= check_box_tag 'account[cashea_cotidiana_category_ids][]', categoria.id, selected_cotidiana_categories.include?(categoria.id), class: 'rounded border-slate-300 text-amber-600 focus:ring-amber-500' %>
                      <span><%= categoria.nombre %></span>
                    </label>
                  <% end %>
                </div>
              <% else %>
                <p class="text-xs text-slate-500">No hay categorias registradas en este negocio.</p>
              <% end %>
              <%= hidden_field_tag 'account[cashea_cotidiana_category_ids][]', '' %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :currency, 'Moneda', class: 'block text-sm font-medium text-slate-700' %>
      <% if account.settlement_enabled? %>
        <div class="mt-1 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">
          <%= account.currency_label %>
        </div>
        <%= f.hidden_field :currency %>
      <% else %>
        <%= f.select :currency,
                     options_for_select(Account.currency_options, account.currency),
                     {},
                     class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      <% end %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :balance, 'Saldo', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.number_field :balance,
                         step: 0.01,
                         class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                         placeholder: 'Ej: 1500.00' %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :theme_color, 'Color de la cuenta', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.select :theme_color,
                   options_for_select(Account.theme_color_options, account.theme_color),
                   {},
                   class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
    </div>
    <% if account.settlement_enabled? %>
      <div class="col-span-2 md:col-span-1">
        <%= f.label :settlement_account_id, 'Cuenta bancaria asignada', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :settlement_account_id,
                     options_from_collection_for_select(@bank_accounts_ves, :id, :name, account.settlement_account_id),
                     { include_blank: 'Selecciona una cuenta' },
                     class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        <p class="mt-1 text-xs text-slate-500">Solo cuentas bancarias en Bs.</p>
      </div>
    <% end %>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :logo, 'Logo Mediano', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.file_field :logo, accept: 'image/*', class: 'mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200' %>
      <p class="mt-1 text-xs text-slate-500">Se muestra como imagen de fondo en las tarjetas del index de cuentas.</p>
      <% if account.settlement_enabled? %>
        <p class="mt-1 text-xs text-slate-400">En cuentas especiales puedes reemplazar la imagen predefinida si lo deseas.</p>
      <% end %>
      <% if account.logo.attached? %>
        <div class="mt-2 inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-2 py-2">
          <%= image_tag account.logo, class: 'h-12 w-20 rounded-lg border border-slate-200 object-cover', alt: "Imagen de #{account.name} para cuentas" %>
          <span class="text-xs font-medium text-slate-600">Imagen actual</span>
        </div>
      <% end %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :small_logo, 'Imagen Logo Pequeño', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.file_field :small_logo, accept: 'image/*', class: 'mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200' %>
      <p class="mt-1 text-xs text-slate-500">Puedes usarla como version compacta del logo para vistas pequenas.</p>
      <% if account.small_logo.attached? %>
        <div class="mt-2 inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-2 py-2">
          <%= image_tag account.small_logo, class: 'h-12 w-12 rounded-lg border border-slate-200 object-cover', alt: "Logo pequeño de #{account.name}" %>
          <span class="text-xs font-medium text-slate-600">Imagen actual</span>
        </div>
      <% end %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :payment_method_image, 'Imagen Banner', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.file_field :payment_method_image, accept: 'image/*', class: 'mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200' %>
      <p class="mt-1 text-xs text-slate-500">Se muestra en el modal de metodos de pago de ventas.</p>
      <% if account.payment_method_image.attached? %>
        <div class="mt-2 inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-2 py-2">
          <%= image_tag account.payment_method_image, class: 'h-12 w-20 rounded-lg border border-slate-200 object-cover', alt: "Imagen de #{account.name} para metodos de pago" %>
          <span class="text-xs font-medium text-slate-600">Imagen actual</span>
        </div>
      <% end %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <label class="mt-7 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700">
        <%= f.check_box :active, class: 'rounded border-slate-300 text-sky-600 focus:ring-sky-500' %>
        Cuenta activa
      </label>
    </div>
    <div class="col-span-2">
      <%= f.label :notes, 'Notas', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_area :notes, rows: 3, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Notas opcionales de uso de esta cuenta.' %>
    </div>
  </div>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
    <%= link_to 'Volver', accounts_path, class: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-300 cursor-pointer' %>
    <%= f.submit account.persisted? ? 'Actualizar cuenta' : 'Guardar cuenta', class: 'inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 cursor-pointer' %>
  </div>
<% end %>
<script>
  (() => {
    const initAccountFormPreview = () => {
      const form = document.getElementById('account-form');
      const preview = document.getElementById('account-preview');
      if (!form || !preview) return;
      if (form.dataset.previewBound === 'true') return;
      form.dataset.previewBound = 'true';

      const typeSelect = form.querySelector('#account_account_type');
      const currencySelect = form.querySelector('#account_currency');
      const colorSelect = form.querySelector('#account_theme_color');
      const previewCard = document.getElementById('account-preview-card');
      const cashRoleField = document.getElementById('cash-role-field');
      const cashRoleSelect = form.querySelector('#account_cash_role');
      const casheaConfigField = document.getElementById('cashea-config-field');
      const casheaLineModeSelect = form.querySelector('[data-cashea-line-mode="true"]');
      const casheaCoutasInput = form.querySelector('[data-cashea-cotidiana-installments="true"]');
      const casheaMinPurchaseHidden = form.querySelector('[data-cashea-min-purchase-hidden="true"]');
      const casheaMinPurchaseMasked = form.querySelector('[data-cashea-min-purchase-masked="true"]');
      const casheaPrincipalMinPurchaseHidden = form.querySelector('[data-cashea-principal-min-purchase-hidden="true"]');
      const casheaPrincipalMinPurchaseMasked = form.querySelector('[data-cashea-principal-min-purchase-masked="true"]');
      const casheaLevelMaskedInputs = Array.from(form.querySelectorAll('[data-cashea-level-masked="true"]'));
      const casheaPrincipalMinWrapper = form.querySelector('[data-cashea-principal-min-wrapper="true"]');
      const casheaCotidianaCategoriesWrapper = form.querySelector('[data-cashea-cotidiana-categories-wrapper="true"]');
      const typeBadge = document.getElementById('account-preview-type-badge');
      const currencyBadge = document.getElementById('account-preview-currency-badge');
      const typeIconEl = document.getElementById('account-preview-type-icon');
      const typeLabelEl = document.getElementById('account-preview-type-label');
      const currencyIconEl = document.getElementById('account-preview-currency-icon');
      const currencyLabelEl = document.getElementById('account-preview-currency-label');
      const currencySymbolEl = document.getElementById('account-preview-currency-symbol');

      if (!typeSelect || !currencySelect || !colorSelect || !previewCard || !typeBadge || !currencyBadge || !typeIconEl || !typeLabelEl || !currencyIconEl || !currencyLabelEl || !currencySymbolEl) return;

      const typeIcons = JSON.parse(preview.dataset.typeIcons || '{}');
      const typeLabels = JSON.parse(preview.dataset.typeLabels || '{}');
      const currencyIcons = JSON.parse(preview.dataset.currencyIcons || '{}');
      const currencyLabels = JSON.parse(preview.dataset.currencyLabels || '{}');
      const currencySymbols = JSON.parse(preview.dataset.currencySymbols || '{}');
      const themeCards = JSON.parse(preview.dataset.themeCards || '{}');
      const themeTags = JSON.parse(preview.dataset.themeTags || '{}');

      const cardBaseClasses = 'mt-3 rounded-xl border p-3 transition-colors';
      const badgeBaseClasses = 'inline-flex items-center gap-2 rounded-lg px-2.5 py-1 text-sm font-semibold';

      const refreshCashRole = () => {
        if (!cashRoleField || !typeSelect) return;
        const isCashBox = typeSelect.value === 'cash_box';
        cashRoleField.style.display = isCashBox ? '' : 'none';
        if (!isCashBox && cashRoleSelect) {
          cashRoleSelect.value = '';
        }
      };

      const refreshCasheaConfig = () => {
        if (!casheaConfigField || !typeSelect) return;

        const isCashea = typeSelect.value === 'cashea';
        casheaConfigField.style.display = isCashea ? '' : 'none';

        if (!isCashea) return;
        if (!casheaLineModeSelect || !casheaCoutasInput) return;

        const lineMode = casheaLineModeSelect.value;
        const isPrincipal = lineMode === 'principal';
        const supportsCotidiana = lineMode === 'cotidiana' || lineMode === 'both';
        const supportsPrincipal = lineMode === 'principal' || lineMode === 'both';
        casheaCoutasInput.readOnly = isPrincipal;
        if (isPrincipal) casheaCoutasInput.value = '3';

        if (casheaPrincipalMinWrapper) {
          casheaPrincipalMinWrapper.style.display = supportsPrincipal ? '' : 'none';
        }
        if (casheaCotidianaCategoriesWrapper) {
          casheaCotidianaCategoriesWrapper.style.display = supportsCotidiana ? '' : 'none';
        }
      };

      const parseMoney = (value) => {
        const sanitized = String(value || '').replace(/[^\d,.-]/g, '').replace(',', '.');
        const parsed = Number.parseFloat(sanitized);
        return Number.isFinite(parsed) ? parsed : 0;
      };

      const syncCasheaMinPurchase = () => {
        if (!casheaMinPurchaseHidden || !casheaMinPurchaseMasked) return;
        const parsed = parseMoney(casheaMinPurchaseMasked.value);
        casheaMinPurchaseHidden.value = parsed > 0 ? parsed.toFixed(2) : '0';
      };

      const syncCasheaPrincipalMinPurchase = () => {
        if (!casheaPrincipalMinPurchaseHidden || !casheaPrincipalMinPurchaseMasked) return;
        const parsed = parseMoney(casheaPrincipalMinPurchaseMasked.value);
        casheaPrincipalMinPurchaseHidden.value = parsed > 0 ? parsed.toFixed(2) : '0';
      };

      const syncCasheaLevel = (maskedInput) => {
        const hiddenId = maskedInput?.dataset?.casheaLevelHiddenId;
        const hiddenInput = hiddenId ? document.getElementById(hiddenId) : null;
        if (!hiddenInput) return;

        const parsed = window.MoneyInputMask?.parseValue
          ? window.MoneyInputMask.parseValue(maskedInput)
          : parseMoney(maskedInput.value);
        hiddenInput.value = Math.min(Math.max(parsed, 0), 100).toFixed(2);
      };

      const refreshPreview = () => {
        const selectedType = typeSelect.value;
        const selectedCurrency = currencySelect.value;
        const selectedColor = colorSelect.value;

        typeIconEl.setAttribute('data-lucide', typeIcons[selectedType] || 'wallet');
        typeLabelEl.textContent = typeLabels[selectedType] || 'Cuenta';

        currencyIconEl.setAttribute('data-lucide', currencyIcons[selectedCurrency] || 'coins');
        currencyLabelEl.textContent = currencyLabels[selectedCurrency] || selectedCurrency;
        currencySymbolEl.textContent = currencySymbols[selectedCurrency] || selectedCurrency;

        previewCard.className = `${cardBaseClasses} ${themeCards[selectedColor] || themeCards.sky || ''}`;
        typeBadge.className = `${badgeBaseClasses} ${themeTags[selectedColor] || themeTags.sky || ''}`;
        currencyBadge.className = `${badgeBaseClasses} ${themeTags[selectedColor] || themeTags.sky || ''}`;

        if (window.lucide && typeof window.lucide.createIcons === 'function') {
          window.lucide.createIcons();
        }
      };

      typeSelect.addEventListener('change', refreshPreview);
      typeSelect.addEventListener('change', refreshCashRole);
      typeSelect.addEventListener('change', refreshCasheaConfig);
      if (casheaLineModeSelect) {
        casheaLineModeSelect.addEventListener('change', refreshCasheaConfig);
      }
      if (casheaMinPurchaseMasked) {
        casheaMinPurchaseMasked.addEventListener('input', syncCasheaMinPurchase);
        casheaMinPurchaseMasked.addEventListener('blur', syncCasheaMinPurchase);
      }
      if (casheaPrincipalMinPurchaseMasked) {
        casheaPrincipalMinPurchaseMasked.addEventListener('input', syncCasheaPrincipalMinPurchase);
        casheaPrincipalMinPurchaseMasked.addEventListener('blur', syncCasheaPrincipalMinPurchase);
      }
      casheaLevelMaskedInputs.forEach((input) => {
        input.addEventListener('input', () => syncCasheaLevel(input));
        input.addEventListener('blur', () => syncCasheaLevel(input));
      });
      form.addEventListener('submit', () => {
        syncCasheaMinPurchase();
        syncCasheaPrincipalMinPurchase();
        casheaLevelMaskedInputs.forEach(syncCasheaLevel);
      });
      currencySelect.addEventListener('change', refreshPreview);
      colorSelect.addEventListener('change', refreshPreview);
      refreshPreview();
      refreshCashRole();
      refreshCasheaConfig();
      syncCasheaMinPurchase();
      syncCasheaPrincipalMinPurchase();
    };

    if (!window.__accountFormPreviewListenersBound) {
      window.__accountFormPreviewListenersBound = true;
      document.addEventListener('turbo:load', initAccountFormPreview);
      document.addEventListener('DOMContentLoaded', initAccountFormPreview);
    }
  })();
</script>
