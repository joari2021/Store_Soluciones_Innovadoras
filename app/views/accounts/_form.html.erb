<%= form_with model: account, local: true, html: { id: 'account-form' } do |f| %>
  <% if account.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-bold">No se pudo guardar la cuenta</h4>
        <span class="text-xs font-medium"><%= pluralize(account.errors.count, 'error') %></span>
      </div>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% account.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% type_icons_json = Account::ACCOUNT_TYPES.transform_values { |data| data[:icon] }.to_json %>
  <% type_labels_json = Account::ACCOUNT_TYPES.transform_values { |data| data[:label] }.to_json %>
  <% currency_icons_json = Account::CURRENCIES.transform_values { |data| data[:icon] }.to_json %>
  <% currency_labels_json = Account::CURRENCIES.transform_values { |data| data[:label] }.to_json %>
  <% currency_symbols_json = Account::CURRENCIES.transform_values { |data| data[:symbol] }.to_json %>
  <% theme_cards_json = Account::COLOR_THEMES.transform_values { |data| data[:card] }.to_json %>
  <% theme_tags_json = Account::COLOR_THEMES.transform_values { |data| data[:tag] }.to_json %>
  <div
    id="account-preview"
    data-type-icons="<%= ERB::Util.json_escape(type_icons_json) %>"
    data-type-labels="<%= ERB::Util.json_escape(type_labels_json) %>"
    data-currency-icons="<%= ERB::Util.json_escape(currency_icons_json) %>"
    data-currency-labels="<%= ERB::Util.json_escape(currency_labels_json) %>"
    data-currency-symbols="<%= ERB::Util.json_escape(currency_symbols_json) %>"
    data-theme-cards="<%= ERB::Util.json_escape(theme_cards_json) %>"
    data-theme-tags="<%= ERB::Util.json_escape(theme_tags_json) %>"
    class="mb-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
    <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Vista previa</p>
    <div id="account-preview-card" class="mt-3 rounded-xl border p-3 transition-colors <%= account.theme_config[:card] %>">
      <div class="flex flex-wrap items-center gap-2">
        <div id="account-preview-type-badge" class="inline-flex items-center gap-2 rounded-lg px-2.5 py-1 text-sm font-semibold <%= account.theme_config[:tag] %>">
          <i id="account-preview-type-icon" data-lucide="<%= account.account_type_icon %>" class="h-4 w-4"></i>
          <span id="account-preview-type-label"><%= account.account_type_label %></span>
        </div>
        <div id="account-preview-currency-badge" class="inline-flex items-center gap-2 rounded-lg px-2.5 py-1 text-sm font-semibold <%= account.theme_config[:tag] %>">
          <i id="account-preview-currency-icon" data-lucide="<%= account.currency_icon %>" class="h-4 w-4"></i>
          <span id="account-preview-currency-label"><%= account.currency_label %></span>
          <span id="account-preview-currency-symbol" class="rounded bg-white/70 px-2 py-0.5 text-xs font-bold"><%= account.currency_symbol %></span>
        </div>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div class="col-span-2 md:col-span-1">
      <%= f.label :name, 'Nombre de la cuenta', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_field :name, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Ej: Caja Principal, Banco Mercantil, Wallet Binance' %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :account_type, 'Tipo de cuenta', class: 'block text-sm font-medium text-slate-700' %>
      <% if account.settlement_enabled? %>
        <div class="mt-1 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">
          <%= account.account_type_label %>
        </div>
        <%= f.hidden_field :account_type %>
      <% else %>
        <%= f.select :account_type,
                     options_for_select(Account.account_type_options, account.account_type),
                     {},
                     class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      <% end %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :currency, 'Moneda', class: 'block text-sm font-medium text-slate-700' %>
      <% if account.settlement_enabled? %>
        <div class="mt-1 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">
          <%= account.currency_label %>
        </div>
        <%= f.hidden_field :currency %>
      <% else %>
        <%= f.select :currency,
                     options_for_select(Account.currency_options, account.currency),
                     {},
                     class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
      <% end %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :balance, 'Saldo', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.number_field :balance,
                         step: 0.01,
                         class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500',
                         placeholder: 'Ej: 1500.00' %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :theme_color, 'Color de la cuenta', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.select :theme_color,
                   options_for_select(Account.theme_color_options, account.theme_color),
                   {},
                   class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
    </div>
    <% if account.settlement_enabled? %>
      <div class="col-span-2 md:col-span-1">
        <%= f.label :settlement_account_id, 'Cuenta bancaria asignada', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :settlement_account_id,
                     options_from_collection_for_select(@bank_accounts_ves, :id, :name, account.settlement_account_id),
                     { include_blank: 'Selecciona una cuenta' },
                     class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        <p class="mt-1 text-xs text-slate-500">Solo cuentas bancarias en Bs.</p>
      </div>
    <% end %>
    <div class="col-span-2 md:col-span-1">
      <label class="mt-7 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700">
        <%= f.check_box :active, class: 'rounded border-slate-300 text-sky-600 focus:ring-sky-500' %>
        Cuenta activa
      </label>
    </div>
    <div class="col-span-2">
      <%= f.label :notes, 'Notas', class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_area :notes, rows: 3, class: 'mt-1 block w-full rounded-md border border-slate-300 shadow-sm focus:border-sky-500 focus:ring-sky-500', placeholder: 'Notas opcionales de uso de esta cuenta.' %>
    </div>
  </div>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
    <%= link_to 'Volver', accounts_path, class: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-300 cursor-pointer' %>
    <%= f.submit account.persisted? ? 'Actualizar cuenta' : 'Guardar cuenta', class: 'inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 cursor-pointer' %>
  </div>
<% end %>
<script>
  const initAccountFormPreview = () => {
    const form = document.getElementById('account-form');
    const preview = document.getElementById('account-preview');
    if (!form || !preview) return;
    if (form.dataset.previewBound === 'true') return;
    form.dataset.previewBound = 'true';

    const typeSelect = form.querySelector('#account_account_type');
    const currencySelect = form.querySelector('#account_currency');
    const colorSelect = form.querySelector('#account_theme_color');
    const previewCard = document.getElementById('account-preview-card');
    const typeBadge = document.getElementById('account-preview-type-badge');
    const currencyBadge = document.getElementById('account-preview-currency-badge');
    const typeIconEl = document.getElementById('account-preview-type-icon');
    const typeLabelEl = document.getElementById('account-preview-type-label');
    const currencyIconEl = document.getElementById('account-preview-currency-icon');
    const currencyLabelEl = document.getElementById('account-preview-currency-label');
    const currencySymbolEl = document.getElementById('account-preview-currency-symbol');

    if (!typeSelect || !currencySelect || !colorSelect || !previewCard || !typeBadge || !currencyBadge || !typeIconEl || !typeLabelEl || !currencyIconEl || !currencyLabelEl || !currencySymbolEl) return;

    const typeIcons = JSON.parse(preview.dataset.typeIcons || '{}');
    const typeLabels = JSON.parse(preview.dataset.typeLabels || '{}');
    const currencyIcons = JSON.parse(preview.dataset.currencyIcons || '{}');
    const currencyLabels = JSON.parse(preview.dataset.currencyLabels || '{}');
    const currencySymbols = JSON.parse(preview.dataset.currencySymbols || '{}');
    const themeCards = JSON.parse(preview.dataset.themeCards || '{}');
    const themeTags = JSON.parse(preview.dataset.themeTags || '{}');

    const cardBaseClasses = 'mt-3 rounded-xl border p-3 transition-colors';
    const badgeBaseClasses = 'inline-flex items-center gap-2 rounded-lg px-2.5 py-1 text-sm font-semibold';

    const refreshPreview = () => {
      const selectedType = typeSelect.value;
      const selectedCurrency = currencySelect.value;
      const selectedColor = colorSelect.value;

      typeIconEl.setAttribute('data-lucide', typeIcons[selectedType] || 'wallet');
      typeLabelEl.textContent = typeLabels[selectedType] || 'Cuenta';

      currencyIconEl.setAttribute('data-lucide', currencyIcons[selectedCurrency] || 'coins');
      currencyLabelEl.textContent = currencyLabels[selectedCurrency] || selectedCurrency;
      currencySymbolEl.textContent = currencySymbols[selectedCurrency] || selectedCurrency;

      previewCard.className = `${cardBaseClasses} ${themeCards[selectedColor] || themeCards.sky || ''}`;
      typeBadge.className = `${badgeBaseClasses} ${themeTags[selectedColor] || themeTags.sky || ''}`;
      currencyBadge.className = `${badgeBaseClasses} ${themeTags[selectedColor] || themeTags.sky || ''}`;

      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        window.lucide.createIcons();
      }
    };

    typeSelect.addEventListener('change', refreshPreview);
    currencySelect.addEventListener('change', refreshPreview);
    colorSelect.addEventListener('change', refreshPreview);
    refreshPreview();
  };

  document.addEventListener('turbo:load', initAccountFormPreview);
  document.addEventListener('DOMContentLoaded', initAccountFormPreview);
</script>
