<div class="space-y-6 fade-in">
  <div class="rounded-3xl border border-amber-100 bg-gradient-to-r from-amber-50 via-white to-orange-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Editar movimiento manual</h1>
        <p class="mt-1 text-sm text-slate-500">Actualiza datos de un movimiento registrado manualmente.</p>
      </div>
      <%= link_to account_path(@account, movement_id: @movement.id),
                  class: 'inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 md:w-auto' do %>
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Volver al historial
      <% end %>
    </div>
  </div>
  <div class="mx-auto w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <%= form_with url: update_movement_account_path(@account, movement_id: @movement.id), method: :patch, local: true, class: 'space-y-4' do %>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Concepto</label>
        <input type="text" name="concept" value="<%= @movement_concept %>" class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" required>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Tipo</label>
        <select name="movement_kind" class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" required>
          <option value="expense" <%= 'selected' if @movement.movement_kind == 'expense' %>>Debito (egreso)</option>
          <option value="income" <%= 'selected' if @movement.movement_kind == 'income' %>>Credito (ingreso)</option>
        </select>
      </div>

      <div class="grid gap-3 md:grid-cols-2">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Monto</label>
          <input type="text" name="amount" value="<%= number_with_precision(@movement.amount.to_d, precision: 2, separator: ',', delimiter: '.') %>" class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" data-money-mask="true" data-money-symbol="<%= @account.currency_symbol %>" inputmode="decimal" autocomplete="off" required>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Fecha</label>
            <%= text_field_tag :payment_date,
                             (@movement_date || Date.current).strftime('%d-%m-%Y'),
                             autocomplete: 'off',
                             placeholder: 'dd-mm-aaaa',
                             class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700',
                             required: true %>
          </div>
        </div>
        <% if @account.account_type == 'bank_account' %>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Referencia</label>
            <input type="text" name="reference" value="<%= @movement.reference.to_s %>" inputmode="numeric" maxlength="4" minlength="4" pattern="[0-9]{4}" title="La referencia debe tener exactamente 4 digitos" class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" placeholder="4 digitos" required>
          </div>
        <% end %>
        <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
          <%= link_to 'Cancelar', account_path(@account, movement_id: @movement.id),
                    class: 'rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
          <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Guardar cambios</button>
        </div>
      <% end %>
    </div>
  </div>
