<div class="space-y-6">
  <% movement_query_params = @movement_query_params || {} %>
  <% theme = @account.theme_config %>
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800"><%= @account.name %></h1>
        <p class="mt-1 text-sm text-slate-500">Historial de movimientos de la cuenta.</p>
      </div>
      <div class="flex items-center gap-2">
        <% unless Account::SPECIAL_ACCOUNT_TYPES.include?(@account.account_type) %>
          <button id="account-payment-open" type="button" class="inline-flex items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-2.5 text-sm font-semibold text-emerald-700 shadow-sm transition-colors hover:bg-emerald-100">
            Registrar pago
          </button>
        <% end %>
        <%= link_to 'Editar', edit_account_path(@account), class: 'inline-flex items-center justify-center rounded-xl bg-amber-500 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-300' %>
        <%= link_to 'Volver', accounts_path, class: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-300' %>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class="rounded-2xl border p-4 shadow-sm <%= theme[:card] %>">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Tipo de cuenta</p>
      <div class="col-md-6 d-flex align-items-end">
        <div class="form-check mt-2">
          <input class="form-check-input"
                           type="checkbox"
                           value="1"
                           id="registerPaymentIncludeCommission"
                           name="include_commission">
          <label class="form-check-label" for="registerPaymentIncludeCommission">
            Incluir comision
          </label>
        </div>
      </div>
      <div class="col-md-6 d-none" id="registerPaymentCommissionGroup">
        <label class="form-label" for="registerPaymentCommissionAmount">Monto comision</label>
        <div class="input-group">
          <span class="input-group-text">$</span>
          <input type="text"
                           class="form-control"
                           id="registerPaymentCommissionAmount"
                           name="commission_amount"
                           inputmode="decimal"
                           data-money-mask="true"
                           data-money-symbol="$"
                           data-money-decimals="2"
                           data-money-max-integers="11"
                           autocomplete="off">
        </div>
      </div>
      <div class="mt-2 inline-flex items-center gap-2 rounded-lg px-3 py-1.5 <%= theme[:tag] %>">
        <i data-lucide="<%= @account.account_type_icon %>" class="h-4 w-4"></i>
        <span class="text-sm font-semibold"><%= @account.account_type_label %></span>
      </div>
    </div>
    <div class="rounded-2xl border p-4 shadow-sm <%= theme[:card] %>">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Moneda</p>
      <div class="mt-2 inline-flex items-center gap-2 rounded-lg px-3 py-1.5 <%= theme[:tag] %>">
        <i data-lucide="<%= @account.currency_icon %>" class="h-4 w-4"></i>
        <span class="text-sm font-semibold"><%= @account.currency_label %></span>
        <span class="rounded bg-white/70 px-2 py-0.5 text-xs font-bold"><%= @account.currency_symbol %></span>
      </div>
    </div>
    <% if @account.settlement_enabled? %>
      <div class="rounded-2xl border p-4 shadow-sm <%= theme[:card] %>">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Cuenta asignada</p>
        <p class="mt-2 text-sm font-semibold text-slate-800">
          <%= @account.settlement_account&.name || 'Sin asignar' %>
        </p>
        <p class="mt-1 text-xs text-slate-500">Solo cuentas bancarias en Bs.</p>
      </div>
    <% end %>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:col-span-2">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Saldo</p>
      <p class="mt-2 text-2xl font-extrabold tracking-tight text-slate-800"><%= format_money(@account.balance, unit: @account.currency_symbol) %></p>
      <% if @account.currency == 'VES' && @bcv_rate.present? && @bcv_rate.to_d.positive? %>
        <% usd_equivalent = @account.balance.to_d / @bcv_rate.to_d %>
        <p class="mt-1 text-xs text-slate-500">Aprox. <%= format_money(usd_equivalent, unit: '$') %> (BCV)</p>
      <% end %>
      <p class="mt-4 text-xs font-bold uppercase tracking-wider text-slate-400">Estado</p>
      <span class="mt-2 inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-semibold <%= @account.active? ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600' %>">
        <%= @account.active? ? 'Activa' : 'Inactiva' %>
      </span>
      <p class="mt-4 text-xs font-bold uppercase tracking-wider text-slate-400">Notas</p>
      <p class="mt-2 text-sm text-slate-700"><%= @account.notes.presence || '-' %></p>
    </div>
  </div>
  <% if @account.settlement_enabled? %>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-slate-800">Cierres y liquidaciones</h2>
          <p class="mt-1 text-sm text-slate-500">Agrupa movimientos del turno y permite procesar el cierre real despues.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <% if @processed_settlements_count.to_i.positive? %>
            <%= link_to 'Cierres procesados', account_account_settlements_path(@account),
                        class: 'inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 cursor-pointer' %>
          <% end %>
          <% if @account.account_type == 'biopago' %>
            <%= button_to 'Cerrar dia pendiente de Biopago',
                          account_account_settlements_path(@account),
                          method: :post,
                          disabled: !@biopago_can_close_pending_day,
                          class: "inline-flex items-center justify-center rounded-xl px-4 py-2.5 text-sm font-semibold shadow-sm transition-colors #{!@biopago_can_close_pending_day ? 'cursor-not-allowed border border-slate-200 bg-slate-100 text-slate-400' : 'cursor-pointer bg-sky-600 text-white hover:bg-sky-700'}" %>
            <% if @biopago_pending_day_to_close.present? %>
              <span class="inline-flex items-center rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-700">
                Siguiente cierre: <%= @biopago_pending_day_to_close.strftime('%d/%m/%Y') %>
              </span>
            <% else %>
              <span class="inline-flex items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600">
                Sin dias anteriores pendientes por cerrar
              </span>
            <% end %>
          <% else %>
            <span class="inline-flex items-center rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-700">
              Cierre automatico desde Cierre de turno
            </span>
          <% end %>
        </div>
      </div>
      <div class="mt-4 grid gap-3 md:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Movimientos pendientes</p>
          <p class="mt-1 text-lg font-bold text-slate-800"><%= @pending_movements_count || 0 %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total pendiente</p>
          <p class="mt-1 text-lg font-bold text-slate-800"><%= format_money(@pending_movements_total || 0, unit: @account.currency_symbol) %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
          const registerPaymentCommissionAmount = document.getElementById('registerPaymentCommissionAmount');
          const registerPaymentIncludeCommission = document.getElementById('registerPaymentIncludeCommission');
          registerPaymentCommissionAmount?.addEventListener('input', syncRemaining);
          registerPaymentIncludeCommission?.addEventListener('change', () => {
          syncCommissionVisibility();
          syncRemaining();
          });
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Periodo</p>
          <p class="mt-1 text-sm font-semibold text-slate-700">
            <% if @pending_period_start && @pending_period_end %>
              <%= l(@pending_period_start.in_time_zone('Caracas'), format: :short) rescue @pending_period_start.strftime('%d/%m/%Y %H:%M') %>
              -
              <%= l(@pending_period_end.in_time_zone('Caracas'), format: :short) rescue @pending_period_end.strftime('%d/%m/%Y %H:%M') %>
            <% else %>
              Sin movimientos
            <% end %>
          </p>
        </div>
        <% if @account.account_type == 'biopago' %>
          <div class="rounded-xl border border-cyan-200 bg-cyan-50 p-3 text-cyan-800">
            <p class="text-xs font-semibold uppercase tracking-wider text-cyan-700">Cierre diario Biopago</p>
            <p class="mt-2 text-sm font-semibold">
              Monto del proximo cierre:
              <%= format_money(@biopago_pending_day_total || 0, unit: @account.currency_symbol) %>
            </p>
          </div>
        <% end %>
      </div>
      <% if @account.settlement_account_required? && @account.settlement_account.blank? %>
        <p class="mt-3 text-sm text-amber-600">Asigna una cuenta bancaria en Bs para habilitar los cierres.</p>
      <% end %>
      <% if @account_settlements.present? %>
        <div class="mt-5 space-y-3">
          <% @account_settlements.each do |settlement| %>
            <div class="rounded-xl border border-slate-200 bg-white p-4">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="text-sm font-semibold text-slate-800">Cierre #<%= settlement.id %></p>
                  <p class="text-xs text-slate-500">
                    <% if settlement.period_start_at && settlement.period_end_at %>
                      <%= l(settlement.period_start_at.in_time_zone('Caracas'), format: :short) rescue settlement.period_start_at.strftime('%d/%m/%Y %H:%M') %>
                      -
                      <%= l(settlement.period_end_at.in_time_zone('Caracas'), format: :short) rescue settlement.period_end_at.strftime('%d/%m/%Y %H:%M') %>
                    <% else %>
                      Cerrado: <%= l(settlement.closed_at.in_time_zone('Caracas'), format: :short) rescue settlement.closed_at.strftime('%d/%m/%Y %H:%M') %>
                    <% end %>
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-xs text-slate-500">Total del cierre</p>
                  <p class="text-sm font-bold text-slate-800"><%= format_money(settlement.total_amount, unit: @account.currency_symbol) %></p>
                </div>
              </div>
              <div class="mt-3 grid gap-3 md:grid-cols-4">
                <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                  <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Movimientos</p>
                  <p class="mt-1 text-sm font-bold text-slate-800"><%= settlement.movements_count || 0 %></p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 md:col-span-2">
                  <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Cuenta de liquidacion</p>
                  <p class="mt-1 text-sm font-semibold text-slate-700"><%= settlement.settlement_account&.name || @account.settlement_account&.name || 'Sin asignar' %></p>
                </div>
                <div class="rounded-lg border border-amber-100 bg-amber-50 p-3">
                  <p class="text-xs font-semibold uppercase tracking-wider text-amber-600">Estado</p>
                  <p class="mt-1 text-sm font-bold text-amber-700">Pendiente</p>
                </div>
              </div>
              <div class="mt-4 flex justify-end gap-2">
                <%= link_to 'Ver movimientos', account_account_settlement_path(@account, settlement),
                            class: 'inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 cursor-pointer' %>
                <%= link_to 'Procesar cierre', account_account_settlement_path(@account, settlement),
                            class: 'inline-flex items-center justify-center rounded-xl bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-700 cursor-pointer' %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 text-sm text-slate-500">No hay cierres pendientes por procesar.</p>
      <% end %>
    </div>
  <% end %>
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4">
      <h2 class="text-lg font-semibold text-slate-800">
        <%= @account.settlement_enabled? ? 'Movimientos pendientes' : 'Historial de movimientos' %>
      </h2>
      <p class="mt-1 text-sm text-slate-500">
        <%= @account.settlement_enabled? ? 'Solo movimientos sin cierre asociado.' : 'Ordenado desde el más reciente al más antiguo.' %>
      </p>
      <%= form_with url: account_path(@account), method: :get, local: true, class: 'mt-4 grid gap-3 md:grid-cols-[minmax(0,12rem)_minmax(0,12rem)_auto] md:items-end' do %>
        <div>
          <label for="account_movement_filter_from" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Desde</label>
          <%= text_field_tag :fecha_desde,
                             @selected_fecha_desde_value,
                             id: 'account_movement_filter_from',
                             autocomplete: 'off',
                             placeholder: 'dd-mm-aaaa',
                             class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <div>
          <label for="account_movement_filter_to" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Hasta</label>
          <%= text_field_tag :fecha_hasta,
                             @selected_fecha_hasta_value,
                             id: 'account_movement_filter_to',
                             autocomplete: 'off',
                             placeholder: 'dd-mm-aaaa',
                             class: 'js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500' %>
        </div>
        <div class="flex items-center justify-start gap-2 md:self-end">
          <button type="submit" class="inline-flex cursor-pointer items-center justify-center w-fit rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800">
            Filtrar
          </button>
          <%= link_to account_path(@account), class: 'inline-flex cursor-pointer items-center justify-center w-fit rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50' do %>
            Limpiar
          <% end %>
        </div>
      <% end %>
    </div>
    <% if @account_movements.any? %>
      <%= turbo_frame_tag "account-movements-#{@pagy.page}", class: 'contents' do %>
        <ul class="divide-y divide-slate-100">
          <% @account_movements.each do |movement| %>
            <% signed_amount = movement.signed_amount %>
            <% amount_positive = signed_amount >= 0 %>
            <% highlighted_movement = @highlight_movement_id.present? && movement.id == @highlight_movement_id %>
            <li class="px-5 py-4 <%= highlighted_movement ? 'bg-amber-50 ring-1 ring-inset ring-amber-200' : '' %>">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <% movement_source_link = account_movement_source_link_data(movement) %>
                  <p class="text-sm font-semibold text-slate-800"><%= movement.movement_kind_label %></p>
                  <p class="text-xs text-slate-500">
                    <%= l(movement.occurred_at.in_time_zone('Caracas'), format: :short) rescue movement.occurred_at.strftime('%d/%m/%Y %H:%M') %>
                  </p>
                  <% if movement.payment_method.present? %>
                    <p class="mt-1 text-xs text-slate-500">Metodo: <span class="font-semibold text-slate-700"><%= movement.payment_method_label %></span></p>
                  <% end %>
                  <p class="mt-1 text-sm text-slate-600"><%= account_movement_display_description(movement) %></p>
                  <% if movement_source_link.present? %>
                    <p class="mt-2">
                      <%= link_to movement_source_link[:label],
                                  movement_source_link[:path],
                                  class: 'inline-flex cursor-pointer items-center rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 shadow-sm transition-colors hover:bg-sky-100 hover:text-sky-800',
                                  data: { turbo_frame: '_top' } %>
                    </p>
                  <% end %>
                </div>
                <div class="text-right">
                  <span class="text-sm font-bold <%= amount_positive ? 'text-emerald-600' : 'text-red-600' %>">
                    <%= amount_positive ? '+' : '-' %><%= format_money(signed_amount.abs, unit: @account.currency_symbol) %>
                  </span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
        <% if @pagy.next %>
          <%= turbo_frame_tag "account-movements-#{@pagy.next}", src: account_path(@account, movement_query_params.merge(page: @pagy.next)), loading: :lazy do %>
            <div class="flex items-center justify-center gap-3 px-5 py-6 text-sm text-slate-500">
              <span class="h-5 w-5 animate-spin rounded-full border-2 border-slate-200 border-t-slate-500"></span>
              Cargando más movimientos...
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <div class="px-5 py-8 text-center text-sm text-slate-500">
        <%= @account.settlement_enabled? ? 'No hay movimientos pendientes para esta cuenta.' : 'No hay movimientos registrados para esta cuenta.' %>
      </div>
    <% end %>
  </div>
</div>
<% unless Account::SPECIAL_ACCOUNT_TYPES.include?(@account.account_type) %>
  <div id="account-payment-modal"
       class="fixed inset-0 z-[120] hidden items-center justify-center bg-slate-900/45 p-4"
       data-available="<%= @account.balance.to_d.to_f %>"
       data-currency-symbol="<%= @account.currency_symbol %>">
    <div class="w-full max-w-lg overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
        <div>
          <h3 class="text-base font-bold text-slate-800">Registrar pago</h3>
          <p class="text-xs text-slate-500">Registra un egreso directo desde la cuenta.</p>
        </div>
        <button type="button" class="rounded-lg bg-slate-100 px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-200" data-payment-close="true">Cerrar</button>
      </div>
      <form action="<%= register_payment_account_path(@account) %>" method="post" class="space-y-4 px-5 py-4">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Concepto</label>
          <input type="text" name="concept" class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" placeholder="Ej: Pago de proveedor" data-payment-concept required>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Monto</label>
            <input type="text" name="amount" class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" placeholder="0,00" data-payment-amount data-money-mask="true" data-money-symbol="<%= @account.currency_symbol %>" inputmode="decimal" autocomplete="off" required>
            <p class="mt-1 text-[11px] text-slate-500" data-payment-available>Disponible: <%= format_money(@account.balance, unit: @account.currency_symbol) %></p>
            <p class="mt-1 text-[11px] font-semibold text-rose-600 hidden" data-payment-error>Saldo insuficiente para este pago.</p>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Fecha</label>
            <input type="text" name="payment_date" autocomplete="off" placeholder="dd-mm-aaaa"
                   class="js-materialize-datepicker materialize-datepicker-input mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"
                   data-payment-date required>
            <p class="mt-1 text-[11px] text-slate-500" data-payment-remaining>Saldo restante: -</p>
          </div>
        </div>
        <div class="space-y-3">
          <label class="inline-flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" name="include_commission" value="1" class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-500" data-payment-include-commission>
            Incluir comision
          </label>
          <div class="hidden" data-payment-commission-wrapper>
            <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Monto comision</label>
            <input type="text" name="commission_amount" class="mt-1 block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" placeholder="0,00" data-payment-commission-amount data-money-mask="true" data-money-symbol="<%= @account.currency_symbol %>" inputmode="decimal" autocomplete="off">
          </div>
        </div>
        <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
          <button type="button" class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" data-payment-close="true">Cancelar</button>
          <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" data-payment-submit>Registrar pago</button>
        </div>
      </form>
    </div>
  </div>
  <script>
    (() => {
      const modal = document.getElementById('account-payment-modal');
      const openButton = document.getElementById('account-payment-open');
      if (!modal || !openButton) return;

      const available = Number(modal.dataset.available || 0) || 0;
      const currencySymbol = String(modal.dataset.currencySymbol || '$').trim() || '$';
      const amountInput = modal.querySelector('[data-payment-amount]');
      const conceptInput = modal.querySelector('[data-payment-concept]');
      const dateInput = modal.querySelector('[data-payment-date]');
      const includeCommissionInput = modal.querySelector('[data-payment-include-commission]');
      const commissionWrapper = modal.querySelector('[data-payment-commission-wrapper]');
      const commissionAmountInput = modal.querySelector('[data-payment-commission-amount]');
      const errorEl = modal.querySelector('[data-payment-error]');
      const remainingEl = modal.querySelector('[data-payment-remaining]');
      const submitButton = modal.querySelector('[data-payment-submit]');

      const parseAmount = (input) => {
        if (!input) return 0;
        if (window.MoneyInputMask?.parseValue) return Number(window.MoneyInputMask.parseValue(input) || 0);
        const raw = String(input.value || '').replace(/\s/g, '').replace(/[^\d.,-]/g, '');
        const normalized = raw.includes(',') ? raw.replace(/\./g, '').replace(',', '.') : raw;
        const parsed = Number.parseFloat(normalized);
        return Number.isFinite(parsed) ? parsed : 0;
      };

      const formatAmount = (value) => {
        const amount = Number.isFinite(value) ? value : 0;
        return `${currencySymbol} ${amount.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      };

      const pad = (value) => String(value).padStart(2, '0');
      const defaultDateLabel = () => {
        const now = new Date();
        return `${pad(now.getDate())}-${pad(now.getMonth() + 1)}-${now.getFullYear()}`;
      };

      const commissionEnabled = () => Boolean(includeCommissionInput?.checked);

      const syncCommissionUI = () => {
        const enabled = commissionEnabled();
        if (commissionWrapper) commissionWrapper.classList.toggle('hidden', !enabled);
        if (!enabled && commissionAmountInput) commissionAmountInput.value = '';
      };

      const syncRemaining = () => {
        const amount = parseAmount(amountInput);
        const commission = commissionEnabled() ? parseAmount(commissionAmountInput) : 0;
        const total = amount + commission;
        const remaining = available - total;
        const hasError = total > 0 && remaining < 0;
        const commissionOk = !commissionEnabled() || commission > 0;
        if (errorEl) errorEl.classList.toggle('hidden', !hasError);
        if (remainingEl) {
          const label = total > 0 ? formatAmount(Math.max(remaining, 0)) : '-';
          remainingEl.textContent = `Saldo restante: ${label}`;
        }
        if (submitButton) {
          const conceptOk = String(conceptInput?.value || '').trim().length > 0;
          const dateOk = String(dateInput?.value || '').trim().length > 0;
          submitButton.disabled = hasError || amount <= 0 || !commissionOk || !conceptOk || !dateOk;
          submitButton.classList.toggle('opacity-60', submitButton.disabled);
          submitButton.classList.toggle('cursor-not-allowed', submitButton.disabled);
        }
      };

      const openModal = () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        if (window.MoneyInputMask?.init) window.MoneyInputMask.init(modal);
        if (window.initializeMaterializeDatepickers) window.initializeMaterializeDatepickers(modal);
        if (dateInput && !dateInput.value) dateInput.value = defaultDateLabel();
        if (includeCommissionInput) includeCommissionInput.checked = false;
        if (commissionAmountInput) commissionAmountInput.value = '';
        syncCommissionUI();
        syncRemaining();
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      openButton.addEventListener('click', openModal);
      modal.querySelectorAll('[data-payment-close="true"]').forEach((button) => {
        button.addEventListener('click', closeModal);
      });

      if (amountInput) amountInput.addEventListener('input', syncRemaining);
      if (commissionAmountInput) commissionAmountInput.addEventListener('input', syncRemaining);
      if (includeCommissionInput) {
        includeCommissionInput.addEventListener('change', () => {
          syncCommissionUI();
          syncRemaining();
        });
      }
      if (conceptInput) conceptInput.addEventListener('input', syncRemaining);
      if (dateInput) dateInput.addEventListener('change', syncRemaining);
      modal.addEventListener('click', (event) => {
        if (event.target === modal) closeModal();
      });
    })();
  </script>
<% end %>
