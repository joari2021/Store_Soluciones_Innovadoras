<section class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Descuentos programados</h1>
        <p class="mt-1 text-sm text-slate-500">Configura reglas por cantidad para productos y servicios con monto fijo o porcentaje.</p>
      </div>
      <%= link_to ventas_path,
                  class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50' do %>
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Volver a ventas
      <% end %>
    </div>
  </div>
  <div class="grid gap-6 xl:grid-cols-[minmax(0,29rem)_minmax(0,1fr)]">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">Crear descuento</h2>
      <div class="mt-4">
        <%= render 'form', discount_schedule: @discount_schedule, products: @products, services: @services, submit_label: 'Guardar descuento' %>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">Reglas registradas</h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= @discount_schedules.size %></span>
      </div>
      <% if @discount_schedules.any? %>
        <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
          <table class="min-w-full text-left text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-4 py-3">Regla</th>
                <th class="px-4 py-3">Cantidad</th>
                <th class="px-4 py-3">Descuento</th>
                <th class="px-4 py-3">Estado</th>
                <th class="px-4 py-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @discount_schedules.each do |rule| %>
                <% discount_value = rule.discount_value.to_d %>
                <% discount_display = if rule.discount_mode_percent?
                    "#{number_with_precision(discount_value, precision: 2, strip_insignificant_zeros: true)} %"
                  else
                    fixed_symbol = if rule.applies_to_services?
                        @service_discount_symbols[rule.service_ids.first.to_i].presence || '$'
                      else
                        '$'
                      end
                    "Precio fijo #{format_money(discount_value, unit: "#{fixed_symbol} ")}"
                  end %>
                <tr class="hover:bg-slate-50/80">
                  <td class="px-4 py-3">
                    <p class="font-semibold text-slate-800"><%= rule.name %></p>
                    <p class="text-xs text-slate-500">
                      <%= rule.applies_to.humanize %>
                      · Productos: <%= rule.product_ids.size %>
                      · Servicios: <%= rule.service_ids.size %>
                    </p>
                    <% if rule.starts_on.present? || rule.ends_on.present? %>
                      <p class="mt-1 text-xs text-slate-500">
                        Vigencia: <%= rule.starts_on&.strftime('%d/%m/%Y') || 'Sin inicio' %> - <%= rule.ends_on&.strftime('%d/%m/%Y') || 'Sin fin' %>
                      </p>
                    <% end %>
                  </td>
                  <td class="px-4 py-3"><%= rule.quantity_rule_label %></td>
                  <td class="px-4 py-3"><%= discount_display %></td>
                  <td class="px-4 py-3">
                    <span class="mt-1 inline-flex rounded-full px-2 py-0.5 text-[10px] font-bold <%= rule.active? ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
                      <%= rule.active? ? 'Activa' : 'Inactiva' %>
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex justify-end gap-2">
                      <%= link_to edit_discount_schedule_path(rule),
                                  class: 'inline-flex cursor-pointer items-center justify-center rounded-lg bg-sky-50 p-2 text-sky-600 transition-colors hover:bg-sky-100',
                                  title: 'Editar',
                                  aria: { label: 'Editar descuento programado' } do %>
                        <i data-lucide="pencil" class="h-4 w-4"></i>
                      <% end %>
                      <%= button_to discount_schedule_path(rule),
                                    method: :delete,
                                    class: 'inline-flex cursor-pointer items-center justify-center rounded-lg bg-rose-50 p-2 text-rose-600 transition-colors hover:bg-rose-100',
                                    form: { data: { turbo_confirm: 'Esta regla sera eliminada. Continuar?' } },
                                    title: 'Eliminar',
                                    aria: { label: 'Eliminar descuento programado' } do %>
                        <i data-lucide="trash-2" class="h-4 w-4"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center">
          <p class="text-sm text-slate-600">Aun no hay reglas de descuento programadas.</p>
        </div>
      <% end %>
    </div>
  </div>
</section>