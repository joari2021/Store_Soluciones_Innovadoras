<section class="space-y-6 fade-in">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Categorias</h1>
        <p class="mt-1 text-sm text-slate-500">Organiza tus productos y luego filtra rapido por categoria desde el index.</p>
      </div>
      <%= link_to productos_path,
                  class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50' do %>
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Volver a productos
      <% end %>
    </div>
  </div>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)]">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">Crear categoria</h2>
      <div class="mt-4">
        <%= render 'form', categoria: @categoria, submit_label: 'Guardar categoria' %>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">Categorias registradas</h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= @categorias.size %></span>
      </div>
      <% if @categorias.any? %>
        <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
          <table class="min-w-full text-left text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-4 py-3">Nombre</th>
                <th class="px-4 py-3 text-right">Productos</th>
                <th class="px-4 py-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @categorias.each do |categoria| %>
                <tr class="hover:bg-slate-50/80">
                  <td class="px-4 py-3 font-semibold text-slate-800"><%= categoria.nombre %></td>
                  <td class="px-4 py-3 text-right">
                    <span class="inline-flex items-center rounded-full bg-cyan-100 px-2.5 py-1 text-xs font-bold text-cyan-700"><%= @product_counts_by_categoria_id[categoria.id].to_i %></span>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex justify-end gap-2">
                      <%= link_to edit_categoria_path(categoria), class: 'inline-flex cursor-pointer items-center justify-center rounded-lg bg-sky-50 p-2 text-sky-600 transition-colors hover:bg-sky-100', title: 'Editar', aria: { label: 'Editar categoria' } do %>
                        <i data-lucide="pencil" class="h-4 w-4"></i>
                      <% end %>
                      <%= button_to categoria_path(categoria), method: :delete, class: 'inline-flex cursor-pointer items-center justify-center rounded-lg bg-rose-50 p-2 text-rose-600 transition-colors hover:bg-rose-100', form: { data: { turbo_confirm: 'Esta categoria sera eliminada solo si no tiene productos asociados. Continuar?' } }, title: 'Eliminar', aria: { label: 'Eliminar categoria' } do %>
                        <i data-lucide="trash-2" class="h-4 w-4"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center">
          <p class="text-sm text-slate-600">Aun no hay categorias. Crea la primera para asignarla en productos.</p>
        </div>
      <% end %>
    </div>
  </div>
</section>
