<div class="space-y-6">
  <% customer_debt_view = current_user_customer_mode? %>
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800">Deudas</h1>
        <p class="mt-1 text-sm text-slate-500"><%= customer_debt_view ? 'Consulta unicamente las deudas asociadas a tu usuario.' : 'Controla cuentas por cobrar y por pagar en un solo lugar.' %></p>
      </div>
      <% unless customer_debt_view %>
        <button type="button" class="w-full md:w-auto bg-slate-900 text-white px-6 py-3 rounded-2xl inline-flex items-center justify-center gap-2 hover:bg-slate-800 transition-all shadow-lg shadow-slate-200 active:scale-95 font-medium" data-prepare-group-open="true">
          <i data-lucide="plus" class="h-5 w-5"></i>
          Nueva deuda
        </button>
      <% end %>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: debts_path, method: :get, local: true, class: "flex flex-col gap-3 lg:flex-row lg:items-center" do |form| %>
      <div class="relative w-full lg:w-[24rem] xl:w-[28rem]">
        <span class="pointer-events-none absolute inset-y-0 left-3 inline-flex items-center text-slate-400">
          <i data-lucide="search" class="h-4 w-4"></i>
        </span>
        <%= form.text_field :q,
                value: @search_query,
                placeholder: customer_debt_view ? "Buscar mis deudas" : "Buscar por cliente o acreedor",
                            class: "w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3 text-sm text-slate-700 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= form.submit "Buscar", class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800" %>
        <% if @search_query.present? %>
          <%= link_to debts_path, class: "inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
            Limpiar
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if @search_query.present? %>
      <p class="mt-2 text-xs text-slate-500">
        <span class="font-semibold text-slate-700"><%= @search_pending_count %></span>
        pendientes para "<span class="font-semibold text-slate-700"><%= @search_query %></span>"
        <% if @search_paid_count.positive? %>
          <span class="text-slate-400">(<%= @search_paid_count %> pagadas ocultas)</span>
        <% end %>
      </p>
    <% end %>
  </div>
  <div class="grid gap-4 xl:grid-cols-2">
    <% if current_user_admin? %>
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 shadow-sm" data-debt-reveal="true">
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">Resumen por cobrar</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-emerald-200 bg-white p-3">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700">Total por cobrar $ (BCV)</p>
            <p class="mt-2 text-lg font-bold text-emerald-700">
              <span data-debt-mask data-real-value="<%= h(number_to_currency(@receivable_total_usd_bcv, unit: "$ ")) %>">*******</span>
              <button type="button" data-debt-mask-toggle class="ml-2 inline-flex items-center justify-center rounded-full p-1 text-emerald-700 hover:bg-emerald-100" aria-label="Alternar mostrar monto por cobrar">
                <i data-lucide="eye" class="h-4 w-4"></i>
                <i data-lucide="eye-off" class="h-4 w-4 hidden"></i>
              </button>
            </p>
            <p class="mt-1 text-xs text-emerald-700/80"><%= @receivable_count %> registros activos.</p>
          </div>
          <div class="rounded-xl border border-emerald-200 bg-white p-3">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700">Vencimiento mas proximo/pasado</p>
            <p class="mt-2 text-lg font-bold text-slate-800"><%= @receivable_next_due_on ? @receivable_next_due_on.strftime("%d/%m/%Y") : "Sin fecha" %></p>
            <p class="mt-1 text-xs <%= @receivable_overdue_count.positive? ? 'text-rose-600' : 'text-slate-500' %>">
              <%= @receivable_overdue_count.positive? ? "#{@receivable_overdue_count} vencidas" : "Sin vencidas" %>
            </p>
          </div>
        </div>
      </div>
    <% end %>
    <% if current_user_admin? %>
      <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-4 shadow-sm" data-debt-reveal="true">
        <p class="text-right text-xs font-semibold uppercase tracking-wider text-amber-700">Resumen por pagar</p>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:justify-end">
          <div class="rounded-xl border border-amber-200 bg-white p-3 sm:min-w-[220px] sm:text-right">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-700">Vencimiento mas proximo/pasado</p>
            <p class="mt-2 text-lg font-bold text-slate-800"><%= @payable_next_due_on ? @payable_next_due_on.strftime("%d/%m/%Y") : "Sin fecha" %></p>
            <p class="mt-1 text-xs <%= @payable_overdue_count.positive? ? 'text-rose-600' : 'text-slate-500' %>">
              <%= @payable_overdue_count.positive? ? "#{@payable_overdue_count} vencidas" : "Sin vencidas" %>
            </p>
          </div>
          <div class="rounded-xl border border-amber-200 bg-white p-3 sm:min-w-[220px] sm:text-right">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-700">Total deuda por pagar $ (BCV)</p>
            <p class="mt-2 text-lg font-bold text-amber-700">
              <span data-debt-mask data-real-value="<%= h(number_to_currency(@payable_total_usd_bcv, unit: "$ ")) %>">*******</span>
              <button type="button" data-debt-mask-toggle class="ml-2 inline-flex items-center justify-center rounded-full p-1 text-amber-700 hover:bg-amber-100" aria-label="Alternar mostrar monto por pagar">
                <i data-lucide="eye" class="h-4 w-4"></i>
                <i data-lucide="eye-off" class="h-4 w-4 hidden"></i>
              </button>
            </p>
            <p class="mt-1 text-xs text-amber-700/80"><%= @payable_count %> registros activos.</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <% if @has_any_debts %>
    <div class="grid gap-6 xl:grid-cols-2">
      <section class="rounded-3xl border border-emerald-200 bg-gradient-to-b from-emerald-50/70 to-white p-4 shadow-sm md:p-5" data-debt-reveal="true">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600">Cartera Activa</p>
            <h2 class="text-xl font-extrabold tracking-tight text-slate-800">Deudas por cobrar</h2>
            <p class="mt-1 text-xs text-slate-500">Montos pendientes de clientes.</p>
          </div>
          <div class="text-right">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Registros</p>
            <p class="text-2xl font-extrabold text-emerald-600"><%= @receivable_count %></p>
            <p class="text-xs <%= @receivable_overdue_count.positive? ? 'text-rose-600' : 'text-slate-500' %>">
              <%= @receivable_overdue_count.positive? ? "#{@receivable_overdue_count} vencidas" : "Sin vencidas" %>
            </p>
            <p class="mt-1 text-[11px] font-semibold text-emerald-700">Vencidas $ (BCV): <%= number_to_currency(@receivable_overdue_total_usd_bcv, unit: "$ ") %></p>
          </div>
        </div>

        <% if @receivable_debts.any? %>
          <div class="grid gap-4">
            <% @receivable_groups.each do |cliente, debts| %>
              <% grouped_by_currency = debts.group_by { |debt| debt.card_currency.to_s.upcase } %>
              <% grouped_by_currency.each do |currency, debts_in_currency| %>
                <% is_usdt = currency.to_s.upcase == 'USDT' %>
                <% is_cashea_cliente = current_user_admin? && cliente&.name.to_s.strip.casecmp('cashea').zero? %>
                <% cashea_bg_style = is_cashea_cliente && @cashea_banner_url.present? ? "background-image: url('#{h(@cashea_banner_url)}'); background-size: cover; background-position: center;" : nil %>
                <% overdue_badges = overdue_badges_for_group(debts_in_currency) %>
                <% group_key = [cliente.present? ? cliente.id : 'none', currency.to_s.upcase] %>
                <% totals = @receivable_group_totals[group_key] || { display_total: 0.to_d, display_symbol: '$', badge_label: 'USD $', ves_total: 0.to_d } %>
                <% grouped_debts_count = debts_in_currency.sum { |debt| debt.respond_to?(:card_debts_count) ? debt.card_debts_count.to_i : 1 } %>

                <article class="rounded-2xl border <%= is_cashea_cliente ? 'border-cyan-300 bg-white/90' : 'border-cyan-200 bg-cyan-50/50' %> p-4 shadow-sm" data-debt-reveal="true" style="<%= cashea_bg_style %>">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-xs font-semibold uppercase tracking-wider text-cyan-700">Cliente</p>
                      <h3 class="truncate text-sm font-bold text-slate-800"><%= cliente&.name.presence || 'Sin cliente' %></h3>
                      <span class="mt-1 inline-block rounded px-2 py-0.5 text-xs font-semibold <%= is_usdt ? 'bg-yellow-100 text-yellow-700' : 'bg-sky-100 text-sky-700' %>"><%= totals[:badge_label] %></span>
                      <div class="mt-1 flex flex-wrap gap-1.5">
                        <% overdue_badges[:past_due].each_with_index do |(due_on, due_count), index| %>
                          <% label = due_count == 1 ? '1 vencida' : "#{due_count} vencidas" %>
                          <% suffix = index.zero? ? "desde #{due_on.strftime('%d/%m/%Y')}" : due_on.strftime('%d/%m/%Y') %>
                          <span class="inline-block rounded bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700"><%= "#{label} #{suffix}" %></span>
                        <% end %>
                        <% if overdue_badges[:due_today_count].positive? %>
                          <% today_label = overdue_badges[:due_today_count] == 1 ? '1 vence hoy' : "#{overdue_badges[:due_today_count]} vencen hoy" %>
                          <span class="inline-block rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700"><%= today_label %></span>
                        <% end %>
                      </div>
                    </div>
                    <div class="text-right">
                      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Deudas</p>
                      <p class="text-base font-bold text-emerald-700"><%= grouped_debts_count %></p>
                      <p class="text-[11px] text-slate-500">Total: <%= totals[:display_symbol] %><%= number_with_precision(totals[:display_total], precision: 2, delimiter: ',', separator: '.') %></p>
                    </div>
                  </div>
                  <div class="mt-3 grid gap-3">
                    <% debts_in_currency.each do |debt| %>
                      <%= render "debt_card", debt: debt %>
                    <% end %>
                  </div>
                </article>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-2xl border border-dashed border-emerald-300 bg-white/80 p-8 text-center" data-debt-reveal="true">
            <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
              <i data-lucide="hand-coins" class="h-5 w-5"></i>
            </div>
            <p class="text-sm font-semibold text-slate-700">No hay deudas por cobrar pendientes</p>
            <p class="mt-1 text-xs text-slate-500">Las cuentas por cobrar apareceran aqui.</p>
          </div>
        <% end %>

        <% if @receivable_paid_count.positive? %>
          <button
            type="button"
            class="mt-3 inline-flex cursor-pointer items-center gap-2 rounded-xl border border-emerald-200 bg-white px-3 py-2 text-xs font-semibold text-emerald-700 hover:bg-emerald-50"
            data-debt-paid-toggle="receivable"
            data-debt-paid-url="<%= paid_debts_debts_path(section: 'receivable') %>"
            data-debt-paid-count="<%= @receivable_paid_count %>"
          >
            <span data-debt-paid-label>Mostrar deudas pagadas (<%= @receivable_paid_count %>)</span>
          </button>
          <div class="mt-3 hidden space-y-3" data-debt-paid-list="receivable" data-debt-paid-loaded="false">
            <div class="rounded-2xl border border-dashed border-emerald-200 bg-white px-4 py-6 text-center text-sm text-emerald-700" data-debt-paid-loading="receivable">
              Cargando deudas pagadas...
            </div>
          </div>
        <% end %>
      </section>

      <% if current_user_admin? %>
        <section class="rounded-3xl border border-amber-200 bg-gradient-to-b from-amber-50/70 to-white p-4 shadow-sm md:p-5" data-debt-reveal="true">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-widest text-amber-600">Compromisos</p>
              <h2 class="text-xl font-extrabold tracking-tight text-slate-800">Deudas por pagar</h2>
              <p class="mt-1 text-xs text-slate-500">Obligaciones pendientes con proveedores.</p>
            </div>
            <div class="text-right">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Registros</p>
              <p class="text-2xl font-extrabold text-amber-600"><%= @payable_count %></p>
              <p class="text-xs <%= @payable_overdue_count.positive? ? 'text-rose-600' : 'text-slate-500' %>">
                <%= @payable_overdue_count.positive? ? "#{@payable_overdue_count} vencidas" : "Sin vencidas" %>
              </p>
              <p class="mt-1 text-[11px] font-semibold text-amber-700">Vencidas $ (BCV): <%= number_to_currency(@payable_overdue_total_usd_bcv, unit: "$ ") %></p>
            </div>
          </div>

          <% if @payable_debts.any? %>
            <div class="grid gap-4">
              <% @payable_groups.each do |counterparty_name, debts| %>
                <% grouped_currencies = debts.map(&:currency).uniq %>
                <% overdue_badges = overdue_badges_for_group(debts) %>
                <article class="rounded-2xl border border-amber-200 bg-white/90 p-4 shadow-sm" data-debt-reveal="true">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-xs font-semibold uppercase tracking-wider text-amber-600">Acreedor</p>
                      <h3 class="truncate text-sm font-bold text-slate-800"><%= counterparty_name.presence || 'Sin acreedor' %></h3>
                      <div class="mt-1 flex flex-wrap gap-1.5">
                        <% overdue_badges[:past_due].each_with_index do |(due_on, due_count), index| %>
                          <% label = due_count == 1 ? '1 vencida' : "#{due_count} vencidas" %>
                          <% suffix = index.zero? ? "desde #{due_on.strftime('%d/%m/%Y')}" : due_on.strftime('%d/%m/%Y') %>
                          <span class="inline-block rounded bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700"><%= "#{label} #{suffix}" %></span>
                        <% end %>
                        <% if overdue_badges[:due_today_count].positive? %>
                          <% today_label = overdue_badges[:due_today_count] == 1 ? '1 vence hoy' : "#{overdue_badges[:due_today_count]} vencen hoy" %>
                          <span class="inline-block rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700"><%= today_label %></span>
                        <% end %>
                      </div>
                    </div>
                    <div class="text-right">
                      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Deudas</p>
                      <p class="text-base font-bold text-amber-600"><%= debts.count %></p>
                      <p class="text-[11px] text-slate-500">Monedas: <%= grouped_currencies.join(', ') %></p>
                    </div>
                  </div>
                  <div class="mt-3 grid gap-3">
                    <% debts.each do |debt| %>
                      <%= render "debt_card", debt: debt %>
                    <% end %>
                  </div>
                </article>
              <% end %>
            </div>
          <% else %>
            <div class="rounded-2xl border border-dashed border-amber-300 bg-white/80 p-8 text-center" data-debt-reveal="true">
              <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-amber-100 text-amber-600">
                <i data-lucide="credit-card" class="h-5 w-5"></i>
              </div>
              <p class="text-sm font-semibold text-slate-700">No hay deudas por pagar pendientes</p>
              <p class="mt-1 text-xs text-slate-500">Los pagos pendientes apareceran aqui.</p>
            </div>
          <% end %>

          <% if @payable_paid_count.positive? %>
            <button
              type="button"
              class="mt-3 inline-flex cursor-pointer items-center gap-2 rounded-xl border border-amber-200 bg-white px-3 py-2 text-xs font-semibold text-amber-700 hover:bg-amber-50"
              data-debt-paid-toggle="payable"
              data-debt-paid-url="<%= paid_debts_debts_path(section: 'payable') %>"
              data-debt-paid-count="<%= @payable_paid_count %>"
            >
              <span data-debt-paid-label>Mostrar deudas pagadas (<%= @payable_paid_count %>)</span>
            </button>
            <div class="mt-3 hidden space-y-3" data-debt-paid-list="payable" data-debt-paid-loaded="false">
              <div class="rounded-2xl border border-dashed border-amber-200 bg-white px-4 py-6 text-center text-sm text-amber-700" data-debt-paid-loading="payable">
                Cargando deudas pagadas...
              </div>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm" data-debt-reveal="true">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
        <i data-lucide="hand-coins" class="h-6 w-6"></i>
      </div>
      <h3 class="text-base font-semibold text-slate-700">
        <%= @search_query.present? ? "No hay deudas para esa busqueda" : "No hay deudas registradas" %>
      </h3>
      <p class="mt-1 text-sm text-slate-500">
        <%= @search_query.present? ? "Prueba con otro nombre de deudor." : "Crea tu primera deuda para controlar saldos." %>
      </p>
    </div>
  <% end %>
                  <% unless customer_debt_view %>
                    <div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4" data-prepare-group-modal="true">
                      <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-5 shadow-lg">
                        <button type="button" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700" data-prepare-group-close="true">&times;</button>
                        <div class="mb-4">
                          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Nueva deuda</p>
                          <h3 class="text-lg font-bold text-slate-800">Selecciona tipo y datos base</h3>
                          <p class="mt-1 text-xs text-slate-500">Para deudas por cobrar te enviaremos al grupo activo del cliente. Para deudas por pagar abriremos el formulario con campo acreedor.</p>
                        </div>
                        <%= form_with url: prepare_group_debts_path, method: :get, local: true, class: "space-y-4", data: { prepare_group_form: true } do %>
                          <div>
                            <label class="block text-xs font-semibold text-slate-500">Tipo</label>
                            <select name="debt_kind" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-sm" data-prepare-group-kind="true" required>
                              <option value="receivable">Por cobrar</option>
                              <option value="payable">Por pagar</option>
                            </select>
                          </div>
                          <div data-prepare-group-client-field="true">
                            <label class="block text-xs font-semibold text-slate-500">Cliente</label>
                            <select name="cliente_id" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-sm" required>
                              <option value="">Selecciona un cliente</option>
                              <% @group_setup_clientes.each do |cliente| %>
                                <option value="<%= cliente.id %>"><%= cliente.name %></option>
                              <% end %>
                            </select>
                          </div>
                          <div data-prepare-group-currency-field="true">
                            <label class="block text-xs font-semibold text-slate-500">Moneda</label>
                            <select name="currency" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-sm" required>
                              <% @group_setup_currency_options.each do |currency| %>
                                <option value="<%= currency %>" <%= 'selected' if currency.to_s.upcase == 'USD' %>><%= currency %></option>
                                <% end %>
                              </select>
                            </div>
                            <div class="flex items-center gap-2 pt-1">
                              <button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                                Continuar
                              </button>
                              <button type="button" class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" data-prepare-group-close="true">
                                Cancelar
                              </button>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                    <script>
                      (function () {
                        const initDebtIndexTransition = () => {
                          const nodes = Array.from(document.querySelectorAll("[data-debt-reveal='true']"));
                          if (nodes.length === 0) return;

                          nodes.forEach((node, index) => {
                            node.classList.add("transition-all", "duration-500");
                            node.classList.add("opacity-0", "translate-y-3");
                            node.style.transitionTimingFunction = "cubic-bezier(0.22, 1, 0.36, 1)";
                            node.style.transitionDelay = `${Math.min(index * 40, 360)}ms`;
                          });

                          requestAnimationFrame(() => {
                            requestAnimationFrame(() => {
                              nodes.forEach((node) => {
                                node.classList.remove("opacity-0", "translate-y-3");
                                node.classList.add("opacity-100", "translate-y-0");
                              });
                            });
                          });
                        };

                        const initPaidDebtToggles = () => {
                          const buttons = Array.from(document.querySelectorAll("[data-debt-paid-toggle]"));
                          if (buttons.length === 0) return;

                          buttons.forEach((button) => {
                            if (button.dataset.boundToggle === "true") return;
                            button.dataset.boundToggle = "true";

                            button.addEventListener("click", async () => {
                              const section = button.dataset.debtPaidToggle;
                              const list = document.querySelector(`[data-debt-paid-list='${section}']`);
                              const label = button.querySelector("[data-debt-paid-label]");
                              if (!list || !label) return;

                              const countLabel = button.dataset.debtPaidCount ? ` (${button.dataset.debtPaidCount})` : "";
                              const setButtonLabel = (expanded) => {
                                label.textContent = expanded
                                  ? `Ocultar deudas pagadas${countLabel}`
                                  : `Mostrar deudas pagadas${countLabel}`;
                              };

                              if (list.dataset.debtPaidLoaded === "true") {
                                const isHidden = list.classList.contains("hidden");
                                list.classList.toggle("hidden", !isHidden);
                                setButtonLabel(isHidden);
                                return;
                              }

                              list.classList.remove("hidden");
                              list.dataset.debtPaidLoaded = "loading";
                              list.innerHTML = `
                                <div class="rounded-2xl border border-dashed border-slate-200 bg-white px-4 py-6 text-center text-sm text-slate-500">
                                  Cargando deudas pagadas...
                                </div>
                              `;

                              button.disabled = true;
                              button.classList.add("opacity-70", "cursor-progress");

                              try {
                                const response = await fetch(button.dataset.debtPaidUrl, {
                                  headers: {
                                    Accept: "application/json",
                                    "X-Requested-With": "XMLHttpRequest",
                                  },
                                  credentials: "same-origin",
                                });

                                const data = await response.json().catch(() => ({}));
                                if (!response.ok) {
                                  throw new Error(data.error || "No se pudieron cargar las deudas pagadas.");
                                }

                                list.innerHTML = data.html || `
                                  <div class="rounded-2xl border border-dashed border-slate-200 bg-white px-4 py-6 text-center text-sm text-slate-500">
                                    No hay deudas pagadas para mostrar.
                                  </div>
                                `;
                                list.dataset.debtPaidLoaded = "true";
                                setButtonLabel(true);
                              } catch (error) {
                                list.dataset.debtPaidLoaded = "false";
                                list.innerHTML = `
                                  <div class="rounded-2xl border border-dashed border-rose-200 bg-white px-4 py-6 text-center text-sm text-rose-600">
                                    ${String(error?.message || "No se pudieron cargar las deudas pagadas.")}
                                  </div>
                                `;
                              } finally {
                                button.disabled = false;
                                button.classList.remove("opacity-70", "cursor-progress");
                              }
                            });
                          });
                        };

                        const initPrepareGroupModal = () => {
                          const modal = document.querySelector("[data-prepare-group-modal='true']");
                          if (!modal || modal.dataset.boundPrepareGroupModal === "true") return;

                          modal.dataset.boundPrepareGroupModal = "true";

                          const openButtons = document.querySelectorAll("[data-prepare-group-open='true']");
                          const closeButtons = modal.querySelectorAll("[data-prepare-group-close='true']");
                          const form = modal.querySelector("[data-prepare-group-form='true']");
                          const debtKindSelect = modal.querySelector("[data-prepare-group-kind='true']");
                          const clientField = modal.querySelector("[data-prepare-group-client-field='true']");
                          const currencyField = modal.querySelector("[data-prepare-group-currency-field='true']");
                          const clientSelect = clientField?.querySelector("select[name='cliente_id']");
                          const currencySelect = currencyField?.querySelector("select[name='currency']");

                          const updatePrepareGroupFields = () => {
                            const debtKind = String(debtKindSelect?.value || "receivable");
                            const receivable = debtKind === "receivable";

                            if (clientField) clientField.classList.toggle("hidden", !receivable);
                            if (currencyField) currencyField.classList.toggle("hidden", !receivable);

                            if (clientSelect) {
                              clientSelect.disabled = !receivable;
                              clientSelect.required = receivable;
                              if (!receivable) clientSelect.value = "";
                            }

                            if (currencySelect) {
                              currencySelect.disabled = !receivable;
                              currencySelect.required = receivable;
                            }
                          };

                          const openModal = () => {
                            modal.classList.remove("hidden");
                            modal.classList.add("flex");
                          };

                          const closeModal = () => {
                            modal.classList.add("hidden");
                            modal.classList.remove("flex");
                          };

                          openButtons.forEach((button) => {
                            button.addEventListener("click", openModal);
                          });

                          closeButtons.forEach((button) => {
                            button.addEventListener("click", closeModal);
                          });

                          debtKindSelect?.addEventListener("change", updatePrepareGroupFields);

                          form?.addEventListener("submit", (event) => {
                            const debtKind = String(debtKindSelect?.value || "receivable");
                            if (debtKind !== "payable") return;

                            event.preventDefault();
                            window.location.href = "<%= new_debt_path(debt_kind: 'payable') %>";
                          });

                          modal.addEventListener("click", (event) => {
                            if (event.target === modal) closeModal();
                          });

                          updatePrepareGroupFields();
                        };

                        if (window.__debtIndexTransitionBound !== true) {
                          document.addEventListener("turbo:load", initDebtIndexTransition);
                          document.addEventListener("turbo:render", initDebtIndexTransition);
                          document.addEventListener("turbo:load", initPaidDebtToggles);
                          document.addEventListener("turbo:render", initPaidDebtToggles);
                          document.addEventListener("turbo:load", initPrepareGroupModal);
                          document.addEventListener("turbo:render", initPrepareGroupModal);
                          window.__debtIndexTransitionBound = true;
                        }

                        initDebtIndexTransition();
                        initPaidDebtToggles();
                        initPrepareGroupModal();
                      })();
                    </script>
