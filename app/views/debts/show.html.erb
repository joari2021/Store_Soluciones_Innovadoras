<% action_label = @debt.receivable? ? "Registrar cobro" : "Registrar pago" %>
<div class="space-y-6">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Detalle</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl"><%= @debt.counterparty_display_name %></h1>
        <p class="mt-1 text-sm text-slate-500"><%= @grouped_debts.size %> deudas asociadas en este registro.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to new_debt_debt_payment_path(@debt), class: "inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800", data: { turbo_frame: "_top" } do %>
          <i data-lucide="credit-card" class="h-4 w-4"></i>
          <%= action_label %>
        <% end %>
        <% if can_manage_action?(:edit_debt) %>
          <%= link_to edit_debt_path(@debt), class: "inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
            <i data-lucide="pencil" class="h-4 w-4"></i>
            Editar
          <% end %>
        <% end %>
        <%= link_to debts_path, class: "inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" do %>
          Volver
        <% end %>
      </div>
    </div>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Informacion</p>
      <dl class="mt-4 grid gap-3 text-sm text-slate-600">
        <div class="flex items-center justify-between">
          <dt>Tipo</dt>
          <dd class="font-semibold text-slate-800"><%= @debt.debt_kind_label %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt><%= @debt.counterparty_label %></dt>
          <dd class="font-semibold text-slate-800"><%= @debt.counterparty_display_name %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Deudas asociadas</dt>
          <dd class="font-semibold text-slate-800"><%= @grouped_debts.size %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Vencidas</dt>
          <dd class="font-semibold text-slate-800"><%= @show_overdue_count %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Primera emision</dt>
          <dd class="font-semibold text-slate-800"><%= @grouped_debts.map(&:issued_on).compact.min&.strftime("%d/%m/%Y") || "-" %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Ultimo pago</dt>
          <dd class="font-semibold text-slate-800"><%= @show_last_payment_at ? @show_last_payment_at.strftime("%d/%m/%Y") : "Sin pagos" %></dd>
        </div>
      </dl>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Montos reales $ (BCV)</p>
      <dl class="mt-4 grid gap-3 text-sm text-slate-600">
        <div class="flex items-center justify-between">
          <dt>Monto total real</dt>
          <dd class="font-semibold text-slate-800"><%= number_to_currency(@show_total_amount_usd_bcv, unit: "$ ") %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Pagado real</dt>
          <dd class="font-semibold text-slate-800"><%= number_to_currency(@show_total_paid_usd_bcv, unit: "$ ") %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt>Saldo real</dt>
          <% if @show_total_balance_usd_bcv.negative? %>
            <dd class="font-semibold text-emerald-700">Excedente pagado: <%= number_to_currency(@show_total_balance_usd_bcv.abs, unit: "$ ") %></dd>
          <% else %>
            <dd class="font-semibold text-slate-800"><%= number_to_currency(@show_total_balance_usd_bcv, unit: "$ ") %></dd>
          <% end %>
        </div>
      </dl>
    </div>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Deudas asociadas</p>
      <span class="text-xs font-semibold text-slate-500"><%= @show_debt_rows.size %> deudas</span>
    </div>
    <% if @show_debt_rows.any? %>
      <% grouped_by_currency = @show_debt_rows.group_by { |row| row[:debt].currency } %>
      <% grouped_by_currency.each do |currency, rows| %>
        <% is_usdt = currency.to_s.upcase == 'USDT' %>
        <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-bold text-slate-700">Moneda: <%= currency %></span>
            <% if is_usdt %>
              <span class="inline-block rounded bg-yellow-100 px-2 py-0.5 text-xs font-semibold text-yellow-700">USDT</span>
            <% end %>
          </div>
          <table class="min-w-full text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-4 py-3 text-left">Emision</th>
                <th class="px-4 py-3 text-left">Descripcion</th>
                <th class="px-4 py-3 text-right">Monto original</th>
                <th class="px-4 py-3 text-right">Pagado real $ (BCV)</th>
                <th class="px-4 py-3 text-right">Saldo real $ (BCV)</th>
                <th class="px-4 py-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% rows.each do |row| %>
                <% debt = row[:debt] %>
                <% debt_symbol = Account::CURRENCIES.dig(debt.currency, :symbol) || debt.currency %>
                <% source_link = debt_source_link_data(debt) %>
                <tr>
                  <td class="px-4 py-3"><%= debt.issued_on ? debt.issued_on.strftime("%d/%m/%Y") : "-" %></td>
                  <td class="px-4 py-3">
                    <p><%= debt_display_description(debt.description) %></p>
                    <% if source_link.present? %>
                      <p class="mt-1">
                        <%= link_to source_link[:label], source_link[:path], class: 'inline-flex cursor-pointer items-center rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 shadow-sm transition-colors hover:bg-sky-100 hover:text-sky-800', data: { turbo_frame: '_top' } %>
                      </p>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-right"><%= number_to_currency(debt.amount, unit: "#{debt_symbol} ") %></td>
                  <td class="px-4 py-3 text-right"><%= number_to_currency(row[:paid_usd_bcv], unit: "$ ") %></td>
                  <td class="px-4 py-3 text-right"><%= number_to_currency(row[:balance_usd_bcv], unit: "$ ") %></td>
                  <td class="px-4 py-3 text-right">
                    <%= link_to edit_debt_path(debt), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
                      <i data-lucide="pencil" class="h-4 w-4"></i>
                      Editar
                    <% end %>
                    <%= link_to new_debt_debt_payment_path(debt), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-800", data: { turbo_frame: "_top" } do %>
                      <i data-lucide="credit-card" class="h-4 w-4"></i>
                      Registrar cobro
                    <% end %>
                    <% if can_manage_action?(:destroy_debt) %>
                      <%= link_to debt_path(debt), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100", data: { turbo_method: :delete, swal_delete: "debt" } do %>
                        <i data-lucide="trash" class="h-4 w-4"></i>
                        Eliminar
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% else %>
      <p class="mt-4 text-sm text-slate-500">No hay deudas asociadas.</p>
    <% end %>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Pagos registrados</p>
      <span class="text-xs font-semibold text-slate-500"><%= @payments.count %> pagos</span>
    </div>
    <% if @show_payment_rows.any? %>
      <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
        <table class="min-w-full text-sm text-slate-700">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-4 py-3 text-left">Fecha</th>
              <th class="px-4 py-3 text-left">Deuda</th>
              <th class="px-4 py-3 text-left">Cuenta</th>
              <th class="px-4 py-3 text-left">Moneda pago</th>
              <th class="px-4 py-3 text-left">Metodo</th>
              <th class="px-4 py-3 text-left">Referencia</th>
              <th class="px-4 py-3 text-right">Monto pago</th>
              <th class="px-4 py-3 text-right">Equivalente $ (BCV)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @show_payment_rows.each do |row| %>
              <% payment = row[:payment] %>
              <% payment_symbol = Account::CURRENCIES.dig(payment.currency, :symbol) || payment.currency %>
              <tr>
                <td class="px-4 py-3"><%= payment.occurred_at.strftime("%d/%m/%Y") %></td>
                <td class="px-4 py-3"><%= row[:debt_label] %></td>
                <td class="px-4 py-3"><%= payment.account.name %></td>
                <td class="px-4 py-3"><%= payment.currency %></td>
                <td class="px-4 py-3"><%= payment.payment_method_label.presence || '-' %></td>
                <td class="px-4 py-3"><%= payment.reference.presence || '-' %></td>
                <td class="px-4 py-3 text-right"><%= number_to_currency(payment.amount, unit: "#{payment_symbol} ") %></td>
                <td class="px-4 py-3 text-right"><%= number_to_currency(row[:equivalent_usd_bcv], unit: "$ ") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-slate-500">Aun no hay pagos registrados.</p>
    <% end %>
  </div>
</div>
