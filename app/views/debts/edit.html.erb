<div class="space-y-6" data-controller="venta-modal">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-r from-sky-50 via-white to-cyan-50 p-5 shadow-sm md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Edicion de registro</p>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-800 md:text-3xl">Editar deuda</h1>
        <p class="mt-1 text-sm text-slate-500">Define el titular y agrega una o varias deudas con sus montos y fechas.</p>
      </div>
      <%= link_to debts_path, class: "inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50" do %>
        Volver
      <% end %>
    </div>
  </div>
  <%= form_with model: @debt, url: debt_path(@debt), method: :patch, local: true, class: "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4", data: { debt_edit_form: true, debt_edit_next_index: @debt_entries_form.size, debt_edit_default_currency: @debt.currency } do |form| %>
    <%= hidden_field_tag "debt[debt_kind]", @debt.debt_kind %>
    <%= hidden_field_tag "debt[cliente_id]", @debt.cliente_id %>
    <h2 class="text-lg font-bold">Editar deudas asociadas</h2>
    <% grouped_by_currency = @debt_entries_form.group_by { |entry| entry[:currency] } %>
    <% running_index = -1 %>
    <% grouped_by_currency.each do |currency, entries| %>
      <% is_usdt = currency.to_s.upcase == 'USDT' %>
      <div class="mb-2 rounded-xl border p-4 <%= is_usdt ? 'border-yellow-200 bg-yellow-50/60' : 'border-emerald-200 bg-emerald-50/60' %>">
        <div class="mb-3 flex items-center gap-2">
          <span class="font-bold text-slate-700">Moneda: <%= currency %></span>
          <% if is_usdt %>
            <span class="inline-block rounded bg-yellow-100 px-2 py-0.5 text-xs font-semibold text-yellow-700">USDT</span>
          <% end %>
        </div>
        <div data-debt-edit-currency-body="<%= currency %>">
          <% entries.each do |entry| %>
            <% running_index += 1 %>
            <% sale_entry = entry[:venta_id].present? %>
            <div class="mb-4 rounded-xl border border-slate-200 bg-white p-3" data-debt-edit-row="true">
              <input type="hidden" name="debt_entries[<%= running_index %>][debt_id]" value="<%= entry[:debt_id] %>" />
              <input type="hidden" name="debt_entries[<%= running_index %>][venta_id]" value="<%= entry[:venta_id] %>" />
              <div class="mb-2 flex items-center justify-between gap-2">
                <span class="text-xs font-semibold uppercase tracking-wide <%= sale_entry ? 'text-sky-700' : 'text-slate-500' %>">
                  <%= sale_entry ? 'Deuda de venta (solo lectura)' : 'Deuda manual (editable)' %>
                </span>
                <% unless sale_entry %>
                  <button type="button" class="rounded-lg border border-rose-200 bg-rose-50 px-2 py-1 text-xs font-semibold text-rose-600 hover:bg-rose-100" data-debt-edit-remove-row="true">
                    Eliminar
                  </button>
                <% end %>
              </div>
              <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <div>
                  <label class="block text-xs font-semibold text-slate-500">Descripción</label>
                  <% if sale_entry %>
                    <div class="mt-1 flex items-center gap-2">
                      <button type="button" class="inline-flex items-center gap-2 rounded bg-sky-100 px-3 py-2 text-xs font-semibold text-sky-700 hover:bg-sky-200" data-action="click->venta-modal#open" data-venta-id="<%= entry[:venta_id] %>">
                        <i data-lucide="eye" class="h-4 w-4"></i>
                        Ver venta
                      </button>
                    </div>
                    <input type="hidden" name="debt_entries[<%= running_index %>][description]" value="<%= entry[:description] %>" />
                  <% else %>
                    <input type="text" name="debt_entries[<%= running_index %>][description]" value="<%= entry[:description] %>" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-sm" />
                  <% end %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-500">Monto (<%= currency %>)</label>
                  <input type="number" step="0.01" name="debt_entries[<%= running_index %>][amount]" value="<%= entry[:amount] %>" class="mt-1 block w-full rounded border px-3 py-2 text-sm <%= sale_entry ? 'border-slate-200 bg-slate-100 text-slate-600' : 'border-slate-300' %>" <%= sale_entry ? 'readonly' : '' %> />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-500">Emisión</label>
                  <input type="text" name="debt_entries[<%= running_index %>][issued_on]" value="<%= entry[:issued_on] %>" class="mt-1 block w-full rounded border px-3 py-2 text-sm <%= sale_entry ? 'border-slate-200 bg-slate-100 text-slate-600' : 'border-slate-300' %>" <%= sale_entry ? 'readonly' : '' %> placeholder="dd-mm-aaaa" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-500">Vencimiento</label>
                  <input type="text" name="debt_entries[<%= running_index %>][due_on]" value="<%= entry[:due_on] %>" class="mt-1 block w-full rounded border px-3 py-2 text-sm <%= sale_entry ? 'border-slate-200 bg-slate-100 text-slate-600' : 'border-slate-300' %>" <%= sale_entry ? 'readonly' : '' %> placeholder="dd-mm-aaaa" />
                </div>
              </div>
              <input type="hidden" name="debt_entries[<%= running_index %>][currency]" value="<%= currency %>" />
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="pt-1">
      <button type="button" class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" data-debt-edit-add-row="true">
        Añadir otra deuda
      </button>
    </div>
    <div class="flex items-center gap-3 pt-2">
      <%= form.submit "Guardar cambios", class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800" %>
      <%= link_to "Cancelar", debts_path, class: "inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
    </div>
  <% end %>
  <script>
    (() => {
      const form = document.querySelector("[data-debt-edit-form='true']");
      if (!form || form.dataset.rowsBound === "true") return;
      form.dataset.rowsBound = "true";

      const addButton = form.querySelector("[data-debt-edit-add-row='true']");
      const defaultCurrency = form.dataset.debtEditDefaultCurrency || "USD";
      let nextIndex = Number.parseInt(form.dataset.debtEditNextIndex || "0", 10) || 0;

      form.addEventListener("click", (event) => {
        const removeButton = event.target.closest("[data-debt-edit-remove-row='true']");
        if (removeButton) {
          const row = removeButton.closest("[data-debt-edit-row='true']");
          if (row) row.remove();
        }
      });

      if (addButton) {
        addButton.addEventListener("click", () => {
          const currencyBody = form.querySelector(`[data-debt-edit-currency-body='${defaultCurrency}']`) || form.querySelector("[data-debt-edit-currency-body]");
          if (!currencyBody) return;

          const today = new Date();
          const dd = String(today.getDate()).padStart(2, "0");
          const mm = String(today.getMonth() + 1).padStart(2, "0");
          const yyyy = String(today.getFullYear());
          const issuedOn = `${dd}-${mm}-${yyyy}`;

          const wrapper = document.createElement("div");
          wrapper.className = "mb-4 rounded-xl border border-slate-200 bg-white p-3";
          wrapper.setAttribute("data-debt-edit-row", "true");
          wrapper.innerHTML = `
            <input type="hidden" name="debt_entries[${nextIndex}][debt_id]" value="" />
            <input type="hidden" name="debt_entries[${nextIndex}][venta_id]" value="" />
            <div class="mb-2 flex items-center justify-between gap-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Deuda manual (editable)</span>
              <button type="button" class="rounded-lg border border-rose-200 bg-rose-50 px-2 py-1 text-xs font-semibold text-rose-600 hover:bg-rose-100" data-debt-edit-remove-row="true">Eliminar</button>
            </div>
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
              <div>
                <label class="block text-xs font-semibold text-slate-500">Descripción</label>
                <input type="text" name="debt_entries[${nextIndex}][description]" value="" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-sm" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-500">Monto (${defaultCurrency})</label>
                <input type="number" step="0.01" name="debt_entries[${nextIndex}][amount]" value="" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-sm" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-500">Emisión</label>
                <input type="text" name="debt_entries[${nextIndex}][issued_on]" value="${issuedOn}" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-sm" placeholder="dd-mm-aaaa" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-500">Vencimiento</label>
                <input type="text" name="debt_entries[${nextIndex}][due_on]" value="" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-sm" placeholder="dd-mm-aaaa" />
              </div>
            </div>
            <input type="hidden" name="debt_entries[${nextIndex}][currency]" value="${defaultCurrency}" />
          `;

          currencyBody.appendChild(wrapper);
          nextIndex += 1;
          form.dataset.debtEditNextIndex = String(nextIndex);
        });
      }
    })();
  </script>
  <!-- Modal único para resumen de venta -->
  <div id="venta-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40" data-venta-modal-target="modal">
    <div class="bg-white rounded-2xl shadow-lg max-w-lg w-full p-6 relative">
      <button class="absolute top-2 right-2 text-slate-400 hover:text-slate-700" data-action="click->venta-modal#close">&times;</button>
      <div data-venta-modal-target="content">
        <!-- Aquí se cargará el resumen de la venta -->
      </div>
    </div>
  </div>
</div>
