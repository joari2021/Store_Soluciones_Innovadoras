<% currency_symbol = Account::CURRENCIES.dig(debt.card_currency, :symbol) || debt.card_currency %>
<% card_monetary_label = debt.card_currency == 'USD' ? 'USD BCV' : debt.card_currency %>
<% status_label = debt.status_label %>
<% action_label = debt.receivable? ? "Registrar cobro" : "Registrar pago" %>
<% source_link = debt_source_link_data(debt) %>
<% badge_class = case status_label
   when "Pagada" then "bg-emerald-100 text-emerald-700"
   when "Vencida" then "bg-rose-100 text-rose-700"
   when "Parcial" then "bg-amber-100 text-amber-700"
   else "bg-slate-100 text-slate-700"
end %>
<article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-md" data-debt-reveal="true">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= debt.debt_kind_label %></p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= debt_display_description(debt.card_description_summary) %></p>
    </div>
    <span class="rounded-full px-2.5 py-1 text-[11px] font-semibold <%= badge_class %>">
      <%= status_label %>
    </span>
  </div>
  <div class="mt-4 grid grid-cols-2 gap-3 text-xs text-slate-500">
    <div>
      <p class="uppercase tracking-wider">Monto (<%= card_monetary_label %>)</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= number_to_currency(debt.card_total_amount, unit: "#{currency_symbol} ") %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Saldo (<%= card_monetary_label %>)</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= number_to_currency(debt.card_total_balance, unit: "#{currency_symbol} ") %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Emision</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= debt.issued_on ? debt.issued_on.strftime("%d/%m/%Y") : "-" %></p>
    </div>
    <div>
      <p class="uppercase tracking-wider">Vence</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= debt.due_on ? debt.due_on.strftime("%d/%m/%Y") : "Sin fecha" %></p>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <%= link_to new_debt_debt_payment_path(debt), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-800", data: { turbo_frame: "_top" } do %>
      <i data-lucide="credit-card" class="h-4 w-4"></i>
      <%= action_label %>
    <% end %>
    <%= link_to debt_path(debt), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
      <i data-lucide="eye" class="h-4 w-4"></i>
      Ver
    <% end %>
    <% if source_link.present? %>
      <%= link_to source_link[:path], class: "inline-flex cursor-pointer items-center gap-2 rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-700 hover:bg-sky-100", data: { turbo_frame: "_top" } do %>
        <i data-lucide="arrow-up-right" class="h-4 w-4"></i>
        <%= source_link[:label] %>
      <% end %>
    <% end %>
    <% if can_manage_action?(:edit_debt) %>
      <%= link_to edit_debt_path(debt), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
        <i data-lucide="pencil" class="h-4 w-4"></i>
        Editar
      <% end %>
    <% end %>
    <% if can_manage_action?(:destroy_debt) %>
      <%= link_to debt_path(debt), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100", data: { turbo_method: :delete, swal_delete: "debt" } do %>
        <i data-lucide="trash" class="h-4 w-4"></i>
        Eliminar
      <% end %>
    <% end %>
  </div>
</article>
