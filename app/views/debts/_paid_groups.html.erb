<% section_is_receivable = section.to_s == 'receivable' %>
<% title_label = section_is_receivable ? 'Cliente' : 'Acreedor' %>
<% section_card_class = section_is_receivable ? 'border-emerald-200 bg-white/90' : 'border-cyan-200 bg-cyan-50/50' %>
<% section_badge_class = section_is_receivable ? 'bg-sky-100 text-sky-700' : 'bg-yellow-100 text-yellow-700' %>
<% section_state_class = section_is_receivable ? 'text-emerald-700' : 'text-cyan-700' %>
<% if groups.present? %>
  <div class="grid gap-3">
    <% groups.each do |counterparty_name, debts| %>
      <% debts.each do |debt| %>
        <% currency = debt.currency.to_s.upcase %>
        <% is_usdt = currency == 'USDT' %>
        <% rate_reference = CurrencyConverter.reference_for_currency(currency) %>
        <% rate_symbol = TasaCambio.latest_for(rate_reference)&.symbol.to_s.strip.presence %>
        <% fallback_symbol = Account::CURRENCIES.dig(currency, :symbol) || currency %>
        <% display_symbol = rate_symbol.presence || fallback_symbol %>
        <% badge_name = rate_reference.presence || currency %>
        <% display_total = debt.card_total_balance.to_d %>
        <% ves_conversion = CurrencyConverter.convert(amount: display_total, from_currency: currency == 'USD' ? 'USD' : currency, to_currency: 'VES') %>
        <% totals = { display_total: display_total, display_symbol: display_symbol, badge_label: "#{badge_name} #{display_symbol}", ves_total: ves_conversion&.dig(:amount).to_d.round(2) } %>
        <article class="rounded-2xl border <%= section_card_class %> p-4 shadow-sm" data-debt-reveal="true">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider <%= section_is_receivable ? 'text-emerald-600' : 'text-cyan-700' %>"><%= title_label %></p>
              <h3 class="truncate text-sm font-bold text-slate-800"><%= counterparty_name.presence || (section_is_receivable ? 'Sin cliente' : 'Sin acreedor') %></h3>
              <span class="inline-block mt-1 rounded px-2 py-0.5 text-xs font-semibold <%= section_badge_class %>"><%= totals[:badge_label] %></span>
            </div>
            <div class="text-right">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Estado</p>
              <p class="text-base font-bold <%= section_state_class %>">Pagado</p>
              <p class="text-[11px] text-slate-500">Moneda: <%= currency %></p>
              <p class="text-[11px] text-slate-500">Actualizado: <%= debt.card_last_activity_at&.in_time_zone('America/Caracas')&.strftime('%d/%m/%Y %H:%M') || '-' %></p>
            </div>
          </div>
          <div class="mt-3 rounded-xl border <%= section_is_receivable ? 'border-emerald-200 bg-emerald-100/60' : 'border-cyan-200 bg-cyan-100/60' %> p-3 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
            <div>
              <span class="block text-xs font-semibold <%= section_is_receivable ? 'text-emerald-800' : 'text-cyan-800' %>">Saldo total</span>
              <span class="block text-lg font-bold <%= section_is_receivable ? 'text-emerald-900' : 'text-cyan-900' %>"><%= totals[:display_symbol] %> <%= number_with_precision(totals[:display_total], precision: 2, delimiter: '.', separator: ',') %> | Bs <%= number_with_precision(totals[:ves_total], precision: 2, delimiter: '.', separator: ',') %></span>
            </div>
            <div class="flex flex-wrap gap-2 mt-2 md:mt-0">
              <% show_group_params = {
                group_currency: currency,
                group_cliente_id: debt.cliente_id.present? ? debt.cliente_id : 'none',
                only_active: 0,
                group_token: debt.try(:group_token)
              } %>
              <%= link_to debt_path(debt, show_group_params), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-800", data: { turbo_frame: "_top" } do %>
                <i data-lucide="list" class="h-4 w-4"></i>
                Ver deudas
              <% end %>
              <% if current_user_admin? %>
                <% hidden_group_key = collapsed_group_keys[debt.id] %>
                <%= link_to hide_paid_group_debts_path(group_key: hidden_group_key), class: "inline-flex cursor-pointer items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100", title: "Ocultar de pagadas", aria: { label: "Ocultar de pagadas" }, data: { turbo_method: :delete, swal_delete: "debt_paid_group_hide" } do %>
                  <i data-lucide="trash" class="h-4 w-4"></i>
                <% end %>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">
    No hay deudas pagadas para mostrar.
  </div>
<% end %>
