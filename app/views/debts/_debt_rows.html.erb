<% weekly_summaries = {} %>
<% if weekly_summary_enabled %>
  <% rows.each do |weekly_row| %>
    <% weekly_debt = weekly_row[:debt] %>
    <% weekly_date = weekly_debt.issued_on || weekly_debt.created_at&.to_date || Date.current %>
    <% week_start = weekly_date.beginning_of_week(:monday) %>
    <% week_end = week_start + 6.days %>
    <% week_key = "#{week_start.iso8601}_#{week_end.iso8601}" %>
    <% weekly_summaries[week_key] ||= {
         week_start: week_start,
         week_end: week_end,
         debt_total_usd_bcv: 0.to_d,
         sales_total_usd_bcv: 0.to_d,
         sales_total_cotidiana_usd_bcv: 0.to_d,
         sales_total_principal_with_commission_usd_bcv: 0.to_d,
         financed_total_cotidiana_usd_bcv: 0.to_d,
         financed_total_principal_usd_bcv: 0.to_d,
         sale_ids: {}
       } %>
    <% weekly_summaries[week_key][:debt_total_usd_bcv] += weekly_row[:amount_usd_bcv].to_d %>
    <% source_sale_line = weekly_row[:source_sale_line].to_s %>
    <% if source_sale_line == 'cotidiana' %>
      <% weekly_summaries[week_key][:financed_total_cotidiana_usd_bcv] += weekly_row[:amount_usd_bcv].to_d %>
    <% elsif source_sale_line == 'principal' %>
      <% weekly_summaries[week_key][:financed_total_principal_usd_bcv] += weekly_row[:amount_usd_bcv].to_d %>
    <% end %>
    <% source_sale_id = weekly_row[:source_sale_id] %>
    <% if source_sale_id.present? && !weekly_summaries[week_key][:sale_ids].key?(source_sale_id) %>
      <% weekly_summaries[week_key][:sale_ids][source_sale_id] = true %>
      <% weekly_summaries[week_key][:sales_total_usd_bcv] += weekly_row[:source_sale_total_usd_bcv].to_d %>
      <% if source_sale_line == 'cotidiana' %>
        <% weekly_summaries[week_key][:sales_total_cotidiana_usd_bcv] += weekly_row[:source_sale_total_usd_bcv].to_d %>
      <% elsif source_sale_line == 'principal' %>
        <% weekly_summaries[week_key][:sales_total_principal_with_commission_usd_bcv] += weekly_row[:source_sale_total_with_commission_usd_bcv].to_d %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<% rows.each_with_index do |row, row_index| %>
  <% debt = row[:debt] %>
  <% debt_symbol = Account::CURRENCIES.dig(debt.currency, :symbol) || debt.currency %>
  <% conversion_date = debt.issued_on || debt.created_at&.to_date || Date.current %>
  <% amount_usd = CurrencyConverter.convert(amount: debt.amount.to_d, from_currency: debt.currency, to_currency: 'USD', on_date: conversion_date)&.dig(:amount).to_d %>
  <% amount_ves = CurrencyConverter.convert(amount: debt.amount.to_d, from_currency: debt.currency, to_currency: 'VES', on_date: conversion_date)&.dig(:amount).to_d %>
  <% source_link = debt_source_link_data(debt) %>
  <% sale_id = debt_source_sale_id(debt) %>
  <tr data-debt-row-id="<%= debt.id %>">
    <td class="px-4 py-3"><%= debt.issued_on ? debt.issued_on.strftime("%d/%m/%Y") : "-" %></td>
    <td class="px-4 py-3"><%= debt.due_on ? debt.due_on.strftime("%d/%m/%Y") : "-" %></td>
    <td class="px-4 py-3">
      <p><%= debt_display_description_with_source_link(debt.description) %></p>
      <% if row[:loan_enabled] && row[:loan_account_name].present? && row[:loan_amount].to_d.positive? %>
        <% loan_currency = row[:loan_account_currency].to_s.upcase.presence || debt.currency.to_s.upcase %>
        <% loan_symbol = Account::CURRENCIES.dig(loan_currency, :symbol) || loan_currency %>
        <p class="mt-1 text-xs font-semibold text-slate-600">
          Prestamo desde <span class="text-slate-800"><%= row[:loan_account_name] %></span>:
          <span class="text-slate-800"><%= number_to_currency(row[:loan_amount].to_d, unit: "#{loan_symbol} ") %></span>
        </p>
      <% end %>
      <% if sale_id.present? %>
        <p class="mt-1">
          <button type="button" class="inline-flex cursor-pointer items-center rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 shadow-sm transition-colors hover:bg-sky-100 hover:text-sky-800" data-action="click->venta-modal#open" data-venta-id="<%= sale_id %>">
            Ver venta #<%= sale_id %>
          </button>
        </p>
      <% elsif source_link.present? %>
        <p class="mt-1">
          <%= link_to source_link[:label], source_link[:path], class: 'inline-flex cursor-pointer items-center rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 shadow-sm transition-colors hover:bg-sky-100 hover:text-sky-800', data: { turbo_frame: '_top' } %>
        </p>
      <% end %>
    </td>
    <td class="px-4 py-3"><%= row[:loan_reference].to_s.strip.presence || '-' %></td>
    <% if is_usdt %>
      <td class="px-4 py-3 text-right"><%= number_to_currency(debt.amount.to_d, unit: "#{debt_symbol} ") %></td>
      <td class="px-4 py-3 text-right"><%= number_to_currency(row[:paid_usd_bcv].to_d, unit: "#{debt_symbol} ") %></td>
      <td class="px-4 py-3 text-right font-semibold"><%= number_to_currency(row[:balance_usd_bcv].to_d, unit: "#{debt_symbol} ") %></td>
    <% else %>
      <td class="px-4 py-3 text-right"><%= number_to_currency(amount_usd, unit: "$ ") %></td>
      <td class="px-4 py-3 text-right"><%= number_to_currency(row[:paid_usd_bcv], unit: "$ ") %></td>
      <td class="px-4 py-3 text-right font-semibold"><%= number_to_currency(row[:balance_usd_bcv], unit: "$ ") %></td>
      <td class="px-4 py-3 text-right"><%= number_to_currency(amount_ves, unit: "Bs ") %></td>
    <% end %>
    <% status_class = case row[:status]
                      when 'Pagada' then 'bg-emerald-100 text-emerald-700'
                      when 'Parcial' then 'bg-amber-100 text-amber-700'
                      else 'bg-slate-100 text-slate-700'
                      end %>
    <td class="px-4 py-3 text-center">
      <span class="inline-flex rounded-full px-2.5 py-1 text-[11px] font-semibold <%= status_class %>"><%= row[:status] %></span>
    </td>
    <td class="px-4 py-3 text-right">
      <% if sale_id.present? %>
        <button
          type="button"
          class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white p-2 text-slate-600 hover:bg-slate-50"
          title="Informacion"
          aria-label="Informacion"
          data-sale-debt-info="true"
        >
          <i data-lucide="info" class="h-4 w-4"></i>
        </button>
      <% elsif customer_debt_view %>
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-[10px] font-semibold text-slate-400 ring-1 ring-slate-200">Lectura</span>
      <% else %>
        <% debt_entry = {
             debt_id: debt.id,
             description: debt.description.to_s,
             amount: (row[:loan_enabled] && row[:loan_amount].to_d.positive?) ? row[:loan_amount].to_d : debt.amount.to_d,
             currency: debt.currency.to_s.upcase,
             issued_on: debt.issued_on&.strftime('%d-%m-%Y'),
             due_on: debt.due_on&.strftime('%d-%m-%Y'),
             loan_enabled: row[:loan_enabled],
             loan_account_id: row[:loan_account_id],
             loan_reference: row[:loan_reference].to_s,
             amount_input_currency: (row[:loan_enabled] && row[:loan_account_currency].present?) ? row[:loan_account_currency].to_s.upcase : debt.currency.to_s.upcase
           } %>
        <button
          type="button"
          class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white p-2 text-slate-700 hover:bg-slate-50"
          title="Editar"
          aria-label="Editar"
          data-add-debt-edit="true"
          data-edit-debt-id="<%= debt_entry[:debt_id] %>"
          data-edit-description="<%= debt_entry[:description] %>"
          data-edit-amount="<%= debt_entry[:amount].to_s('F') %>"
          data-edit-currency="<%= debt_entry[:currency] %>"
          data-edit-issued-on="<%= debt_entry[:issued_on] %>"
          data-edit-due-on="<%= debt_entry[:due_on] %>"
          data-edit-loan-enabled="<%= debt_entry[:loan_enabled] ? '1' : '0' %>"
          data-edit-loan-account-id="<%= debt_entry[:loan_account_id] %>"
          data-edit-loan-reference="<%= debt_entry[:loan_reference] %>"
          data-edit-amount-input-currency="<%= debt_entry[:amount_input_currency] %>"
        >
          <i data-lucide="pencil" class="h-4 w-4"></i>
        </button>
        <% if can_manage_action?(:destroy_debt) %>
          <button
            type="button"
            class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-red-200 bg-red-50 p-2 text-red-600 hover:bg-red-100"
            title="Eliminar"
            aria-label="Eliminar"
            data-debt-delete-link="true"
            data-debt-delete-id="<%= debt.id %>"
            data-debt-delete-url="<%= debt_path(
              debt,
              group_currency: params[:group_currency],
              group_cliente_id: params[:group_cliente_id],
              only_active: params[:only_active],
              group_token: params[:group_token]
            ) %>"
          >
            <i data-lucide="trash" class="h-4 w-4"></i>
          </button>
        <% end %>
      <% end %>
    </td>
  </tr>
  <% if weekly_summary_enabled %>
    <% current_date = debt.issued_on || debt.created_at&.to_date || Date.current %>
    <% current_week_start = current_date.beginning_of_week(:monday) %>
    <% current_week_end = current_week_start + 6.days %>
    <% current_week_key = "#{current_week_start.iso8601}_#{current_week_end.iso8601}" %>
    <% next_row = rows[row_index + 1] %>
    <% next_date = next_row&.dig(:debt)&.issued_on || next_row&.dig(:debt)&.created_at&.to_date %>
    <% next_week_key = if next_date.present?
                         next_week_start = next_date.beginning_of_week(:monday)
                         "#{next_week_start.iso8601}_#{(next_week_start + 6.days).iso8601}"
                       end %>
    <% week_boundary = next_week_key != current_week_key %>
    <% if week_boundary %>
      <% summary = weekly_summaries[current_week_key] || {} %>
      <% ventas_cotidiana = summary[:sales_total_cotidiana_usd_bcv].to_d.round(2) %>
      <% ventas_principal = summary[:sales_total_principal_with_commission_usd_bcv].to_d.round(2) %>
      <% financiado_cotidiana = summary[:financed_total_cotidiana_usd_bcv].to_d.round(2) %>
      <% financiado_principal = summary[:financed_total_principal_usd_bcv].to_d.round(2) %>
      <% servicio_base = ((ventas_principal * 0.04) + (ventas_cotidiana * 0.03)).round(2) %>
      <% servicio_tecnologico = (servicio_base * 1.16).round(2) %>
      <% comision_financiamiento = ((financiado_principal * 0.05) + (financiado_cotidiana * 0.02)).round(2) %>
      <% week_label = "#{summary[:week_start]&.strftime('%d/%m/%Y')} al #{summary[:week_end]&.strftime('%d/%m/%Y')}" %>
      <tr class="bg-slate-50/70" data-weekly-summary-row="true">
        <td colspan="3" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-600">
          Semana <%= summary[:week_start]&.strftime('%d/%m/%Y') %> al <%= summary[:week_end]&.strftime('%d/%m/%Y') %>
        </td>
        <td colspan="<%= is_usdt ? 6 : 7 %>" class="px-4 py-3 text-xs font-semibold text-slate-700">
          <div class="flex flex-wrap items-center justify-end gap-3">
            <div>
              Monto Total en Ventas: <%= number_to_currency(summary[:sales_total_usd_bcv].to_d, unit: '$ ') %>
              <span class="mx-2 text-slate-300">|</span>
              Monto Total Deuda: <%= number_to_currency(summary[:debt_total_usd_bcv].to_d, unit: '$ ') %>
            </div>
            <button
              type="button"
              class="inline-flex items-center rounded-lg border border-cyan-200 bg-cyan-50 px-2.5 py-1 text-[11px] font-semibold text-cyan-700 transition-colors hover:bg-cyan-100"
              data-cashea-week-stats-open="true"
              data-cashea-week-label="<%= week_label %>"
              data-total-ventas-cotidiana="<%= ventas_cotidiana.to_s('F') %>"
              data-total-ventas-principal="<%= ventas_principal.to_s('F') %>"
              data-servicio-tecnologico="<%= servicio_tecnologico.to_s('F') %>"
              data-total-financiado-cotidiana="<%= financiado_cotidiana.to_s('F') %>"
              data-total-financiado-principal="<%= financiado_principal.to_s('F') %>"
              data-comision-financiamiento="<%= comision_financiamiento.to_s('F') %>"
            >
              Datos Estadisticos de Cashea
            </button>
          </div>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
